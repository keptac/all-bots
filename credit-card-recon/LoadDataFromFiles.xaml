        <ui:InvokeCode ContinueOnError="{x:Null}" Code="string[] prefixes = new[] { &quot;TT2P2T0&quot;, &quot;TT2L2&quot;, &quot;TT2H4T0&quot; };&#xA;&#xA;foreach (var prefix in prefixes)&#xA;{&#xA;    var files = Directory.GetFiles(masterCardServerFilePath, prefix + &quot;*&quot;)&#xA;                         .Select(path =&gt; new FileInfo(path))&#xA;                         .OrderByDescending(f =&gt;&#xA;                         {&#xA;                             string nameWithoutExt = Path.GetFileNameWithoutExtension(f.Name);&#xA;                             string[] parts = nameWithoutExt.Split('.');&#xA;                             if (parts.Length &gt;= 2)&#xA;                             {&#xA;                                 string datePart = parts[1];&#xA;                                 if (DateTime.TryParseExact(datePart, &quot;dd-MM-yy-HH-mm-ss&quot;,&#xA;                                         System.Globalization.CultureInfo.InvariantCulture,&#xA;                                         System.Globalization.DateTimeStyles.None,&#xA;                                         out DateTime parsedDate))&#xA;                                 {&#xA;                                     return parsedDate;&#xA;                                 }&#xA;                             }&#xA;                             return DateTime.MinValue;&#xA;                         })&#xA;                         .Take(2)&#xA;                         .ToList();&#xA;&#xA;    if (files.Count &lt; 2)&#xA;    {&#xA;        Console.WriteLine($&quot;⚠️ Less than 2 files found for prefix {prefix}, skipping...&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    var largestFile = files.OrderByDescending(f =&gt; f.Length).First();&#xA;    var smallestFile = files.OrderBy(f =&gt; f.Length).First();&#xA;&#xA;    string newLargestName = largestFile.Name + &quot;.xlsx&quot;;&#xA;    string newSmallestName = smallestFile.Name + &quot;.xlsx&quot;;&#xA;&#xA;    string prepaidTarget = Path.Combine(prepaidCardFinalPath, newLargestName);&#xA;    string creditTarget = Path.Combine(creditCardFinalPath, newSmallestName);&#xA;&#xA;    // Ensure destination directories exist&#xA;    Directory.CreateDirectory(prepaidCardFinalPath);&#xA;    Directory.CreateDirectory(creditCardFinalPath);&#xA;&#xA;    // Copy files&#xA;    File.Copy(largestFile.FullName, prepaidTarget, true);&#xA;    Console.WriteLine($&quot;✅ Copied {largestFile.Name} ({largestFile.Length} bytes) to prepaidCardFinalPath as {newLargestName}&quot;);&#xA;&#xA;    File.Copy(smallestFile.FullName, creditTarget, true);&#xA;    Console.WriteLine($&quot;✅ Copied {smallestFile.Name} ({smallestFile.Length} bytes) to creditCardFinalPath as {newSmallestName}&quot;);&#xA;}&#xA;" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="388,188" sap2010:WorkflowViewState.IdRef="InvokeCode_54" Language="CSharp">

              <ui:InvokeCode ContinueOnError="{x:Null}" Code="&#xA;                // Parse the fromDate into a DateTime object&#xA;if (!DateTime.TryParseExact(fromDate, &quot;dd-MM-yyyy&quot;, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime parsedToDate))&#xA;{&#xA;    throw new ArgumentException(&quot;Invalid fromDate format. Expected format: dd-MM-yyyy&quot;);&#xA;}&#xA;&#xA;// Identify rows to remove using LINQ&#xA;var rowsToRemove = dtGlStatement.AsEnumerable()&#xA;    .Where(row =&gt;&#xA;    {&#xA;        if (DateTime.TryParse(row.Field&lt;string&gt;(&quot;Value Date&quot;), out DateTime valueDate))&#xA;        {&#xA;            if (valueDate &lt; parsedToDate)&#xA;            {&#xA;                var debit = decimal.TryParse(row.Field&lt;string&gt;(&quot;Debit&quot;), out var d) ? d : 0;&#xA;                var credit = decimal.TryParse(row.Field&lt;string&gt;(&quot;Credit&quot;), out var c) ? c : 0;&#xA;&#xA;                return debit &gt;= 0 &amp;&amp; credit &gt;= 0; // Only remove if not a reversal&#xA;            }&#xA;        }&#xA;        return false;&#xA;    })&#xA;    .ToList();&#xA;&#xA;// Remove rows&#xA;Console.WriteLine($&quot;Total rows to remove: {rowsToRemove.Count}&quot;);&#xA;foreach (var row in rowsToRemove)&#xA;{&#xA;    dtGlStatement.Rows.Remove(row);&#xA;}&#xA;Console.WriteLine($&quot;Rows removed successfully. Total rows removed: {rowsToRemove.Count}&quot;);&#xA;" DisplayName="Remove Transactions B4 fromDate Value Date" sap:VirtualizedContainerService.HintSize="434,57.333333333333336" sap2010:WorkflowViewState.IdRef="InvokeCode_40" Language="CSharp">

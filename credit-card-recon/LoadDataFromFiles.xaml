          <ui:DatabaseConnect DisplayName="Connect to Database" sap:VirtualizedContainerService.HintSize="558,92" sap2010:WorkflowViewState.IdRef="DatabaseConnect_2" ProviderName="Microsoft.Data.SqlClient" DatabaseConnection="{x:Null}" ConnectionString="[DatabaseConnectionString]" />
          <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Required namespaces: using System.Data; using System.Data.SqlClient;&#xD;&#xA;DateTime parsedFromDate = DateTime.ParseExact(fromDate, &quot;dd-MM-yyyy&quot;, System.Globalization.CultureInfo.InvariantCulture);&#xD;&#xA;DateTime parsedToDate = DateTime.ParseExact(toDate, &quot;dd-MM-yyyy&quot;, System.Globalization.CultureInfo.InvariantCulture);&#xD;&#xA;string fromDateFinal = parsedFromDate.ToString(&quot;yyyy-MM-dd&quot;);&#xD;&#xA;string toDateFinal = parsedToDate.ToString(&quot;yyyy-MM-dd&quot;);&#xD;&#xA;&#xD;&#xA;// Step 1: Fetch raw CBS GL statement data&#xD;&#xA;string query = $@&quot;&#xD;&#xA;SELECT * &#xD;&#xA;FROM OPENQUERY(cbs, '&#xD;&#xA;SELECT&#xD;&#xA;    ZZ.BKG_DATE,&#xD;&#xA;    ZZ.VALUE_DATE,&#xD;&#xA;    ZZ.TRN_REF_NO,&#xD;&#xA;    ZZ.NARRATION,&#xD;&#xA;    ZZ.XREF,&#xD;&#xA;    ZZ.INSTR_NO,&#xD;&#xA;    ZZ.DEBIT,&#xD;&#xA;    ZZ.CREDIT,&#xD;&#xA;    ZZ.BALANCE&#xD;&#xA;FROM (&#xD;&#xA;    SELECT&#xD;&#xA;        0 AS ROW_NUM,&#xD;&#xA;        BB.CUST_AC_NO,&#xD;&#xA;        TO_DATE(''{fromDateFinal}'') AS BKG_DATE,&#xD;&#xA;        NULL AS VALUE_DATE,&#xD;&#xA;        NULL AS TRN_REF_NO,&#xD;&#xA;        NULL AS TRN_BR_NAME,&#xD;&#xA;        NULL AS TRN_MAKER,&#xD;&#xA;        NULL AS TRN_CHECKER,&#xD;&#xA;        NULL AS TRN_CODE,&#xD;&#xA;        NULL AS TRN_DESC,&#xD;&#xA;        ''OPENING BALANCE'' AS NARRATION,&#xD;&#xA;        NULL AS INSTR_NO,&#xD;&#xA;        0 AS DEBIT,&#xD;&#xA;        0 AS CREDIT,&#xD;&#xA;        NVL(BB.BALANCE, 0) AS BALANCE,&#xD;&#xA;        NULL AS AUTH_STAT,&#xD;&#xA;        NULL AS DRCR_IND,&#xD;&#xA;        NULL AS XREF&#xD;&#xA;    FROM DUAL,&#xD;&#xA;        (&#xD;&#xA;            SELECT GL_CODE AS CUST_AC_NO, SUM(CR_BAL_LCY - DR_BAL_LCY) BALANCE&#xD;&#xA;            FROM fcubs.GLTB_GL_BAL &#xD;&#xA;            WHERE LEAF = ''Y''&#xD;&#xA;              AND FIN_YEAR = (SELECT CURRENT_CYCLE FROM fcubs.STTM_BRANCH WHERE BRANCH_CODE = ''101'')&#xD;&#xA;              AND PERIOD_CODE = (SELECT CURRENT_PERIOD FROM fcubs.STTM_BRANCH WHERE BRANCH_CODE = ''101'')&#xD;&#xA;              AND GL_CODE = ''{glCode}''&#xD;&#xA;            GROUP BY GL_CODE&#xD;&#xA;        ) BB&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT&#xD;&#xA;        ROW_NUMBER() OVER(PARTITION BY A.AC_NO ORDER BY A.AC_ENTRY_SR_NO) AS ROW_NUM,&#xD;&#xA;        A.AC_NO AS CUST_AC_NO,&#xD;&#xA;        A.TRN_DT AS BKG_DATE,&#xD;&#xA;        A.VALUE_DT AS VALUE_DATE,&#xD;&#xA;        A.TRN_REF_NO,&#xD;&#xA;        BR.BRANCH_NAME AS TRN_BR_NAME,&#xD;&#xA;        (SELECT USER_ID || ''-'' || USER_NAME FROM fcubs.SMTB_USER SU WHERE SU.USER_ID = A.USER_ID) AS TRN_MAKER,&#xD;&#xA;        (SELECT USER_ID || ''-'' || USER_NAME FROM fcubs.SMTB_USER SU WHERE SU.USER_ID = A.AUTH_ID) AS TRN_CHECKER,&#xD;&#xA;        A.TRN_CODE,&#xD;&#xA;        TC.TRN_DESC || ''-'' AS TRN_DESC,&#xD;&#xA;        fcubs.obipks_stmt_narration(''A'', A.MODULE, A.TRN_REF_NO, A.TRN_CODE) AS NARRATION,&#xD;&#xA;        A.INSTRUMENT_CODE AS INSTR_NO,&#xD;&#xA;        DECODE(A.DRCR_IND, ''D'', DECODE(A.AC_CCY, ''TZS'', A.LCY_AMOUNT, A.FCY_AMOUNT), 0) AS DEBIT,&#xD;&#xA;        DECODE(A.DRCR_IND, ''C'', DECODE(A.AC_CCY, ''TZS'', A.LCY_AMOUNT, A.FCY_AMOUNT), 0) AS CREDIT,&#xD;&#xA;        DECODE(A.DRCR_IND, ''D'', DECODE(A.AC_CCY, ''TZS'', -A.LCY_AMOUNT, -A.FCY_AMOUNT),&#xD;&#xA;                         DECODE(A.AC_CCY, ''TZS'', A.LCY_AMOUNT, A.FCY_AMOUNT)) AS BALANCE,&#xD;&#xA;        DECODE(A.AUTH_STAT, ''A'', NULL, ''*'') AS AUTH_STAT,&#xD;&#xA;        A.DRCR_IND,&#xD;&#xA;        NVL(A.EXTERNAL_REF_NO, XREF) AS XREF&#xD;&#xA;    FROM fcubs.ACVW_ALL_AC_ENTRIES A&#xD;&#xA;    JOIN fcubs.STTM_TRN_CODE TC ON A.TRN_CODE = TC.TRN_CODE&#xD;&#xA;    JOIN fcubs.STTM_BRANCH BR ON SUBSTR(A.TRN_REF_NO, 1, 3) = BR.BRANCH_CODE&#xD;&#xA;    LEFT JOIN fcubs.DETB_RTL_TELLER RT ON A.TRN_REF_NO = RT.TRN_REF_NO&#xD;&#xA;    WHERE A.AC_NO = ''{glCode}''&#xD;&#xA;      AND A.TRN_DT BETWEEN ''{fromDateFinal}'' AND ''{toDateFinal}''&#xD;&#xA;      AND A.TRN_CODE &lt;&gt; ''321''&#xD;&#xA;      AND NVL(A.DONT_SHOWIN_STMT, ''N'') = ''N''&#xD;&#xA;) ZZ')&quot;;&#xD;&#xA;&#xD;&#xA;var dtRaw = new DataTable();&#xD;&#xA;using (var conn = new SqlConnection(connectionString))&#xD;&#xA;using (var cmd = new SqlCommand(query, conn))&#xD;&#xA;using (var adapter = new SqlDataAdapter(cmd))&#xD;&#xA;{&#xD;&#xA;    conn.Open();&#xD;&#xA;    adapter.Fill(dtRaw);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Step 2: Map to final dtGlStatement&#xD;&#xA;var dt = new DataTable();&#xD;&#xA;dt.Columns.AddRange(new[]&#xD;&#xA;{&#xD;&#xA;    new DataColumn(&quot;Booking Date&quot;),&#xD;&#xA;    new DataColumn(&quot;Value Date&quot;),&#xD;&#xA;    new DataColumn(&quot;Transaction Ref No:&quot;),&#xD;&#xA;    new DataColumn(&quot;Narration&quot;),&#xD;&#xA;    new DataColumn(&quot;Related Account&quot;),&#xD;&#xA;    new DataColumn(&quot;Instr No&quot;),&#xD;&#xA;    new DataColumn(&quot;Debit&quot;),&#xD;&#xA;    new DataColumn(&quot;Credit&quot;),&#xD;&#xA;    new DataColumn(&quot;Balance&quot;)&#xD;&#xA;});&#xD;&#xA;&#xD;&#xA;HashSet&lt;string&gt; trnRefsToUpdate = new HashSet&lt;string&gt;();&#xD;&#xA;foreach (DataRow row in dtRaw.Rows)&#xD;&#xA;{&#xD;&#xA;    var newRow = dt.NewRow();&#xD;&#xA;    newRow[&quot;Booking Date&quot;] = row[&quot;BKG_DATE&quot;];&#xD;&#xA;    newRow[&quot;Value Date&quot;] = row[&quot;VALUE_DATE&quot;];&#xD;&#xA;    string trnRef = row[&quot;TRN_REF_NO&quot;]?.ToString();&#xD;&#xA;    string narration = row[&quot;NARRATION&quot;]?.ToString() ?? &quot;&quot;;&#xD;&#xA;    newRow[&quot;Transaction Ref No:&quot;] = trnRef;&#xD;&#xA;    newRow[&quot;Narration&quot;] = narration;&#xD;&#xA;    newRow[&quot;Related Account&quot;] = row[&quot;XREF&quot;];&#xD;&#xA;    newRow[&quot;Instr No&quot;] = row[&quot;INSTR_NO&quot;];&#xD;&#xA;    newRow[&quot;Debit&quot;] = row[&quot;DEBIT&quot;];&#xD;&#xA;    newRow[&quot;Credit&quot;] = row[&quot;CREDIT&quot;];&#xD;&#xA;    newRow[&quot;Balance&quot;] = row[&quot;BALANCE&quot;];&#xD;&#xA;    dt.Rows.Add(newRow);&#xD;&#xA;&#xD;&#xA;    if (!(narration.Contains(&quot;XXXXXX&quot;) || narration.Contains(&quot;000000&quot;) || narration.Contains(&quot;*****&quot;)))&#xD;&#xA;    {&#xD;&#xA;        if (!string.IsNullOrWhiteSpace(trnRef))&#xD;&#xA;            trnRefsToUpdate.Add(trnRef);&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Step 3: Fetch clean narratives from DETB_RTL_TELLER&#xD;&#xA;var refNarrationMap = new Dictionary&lt;string, string&gt;();&#xD;&#xA;if (trnRefsToUpdate.Count &gt; 0)&#xD;&#xA;{&#xD;&#xA;    string inClause = string.Join(&quot;,&quot;, trnRefsToUpdate.Select(r =&gt; $&quot;''{r}''&quot;));&#xD;&#xA;    string tellerQuery = $@&quot;&#xD;&#xA;    SELECT * FROM OPENQUERY(cbsuat, '&#xD;&#xA;        SELECT TRN_REF_NO, NARRATIVE&#xD;&#xA;        FROM fcubs.DETB_RTL_TELLER&#xD;&#xA;        WHERE TRN_REF_NO IN ({inClause})&#xD;&#xA;    ')&quot;;&#xD;&#xA;&#xD;&#xA;    using (var conn = new SqlConnection(connectionString))&#xD;&#xA;    using (var cmd = new SqlCommand(tellerQuery, conn))&#xD;&#xA;    using (var adapter = new SqlDataAdapter(cmd))&#xD;&#xA;    {&#xD;&#xA;        var dtNarr = new DataTable();&#xD;&#xA;        conn.Open();&#xD;&#xA;        adapter.Fill(dtNarr);&#xD;&#xA;&#xD;&#xA;        foreach (DataRow row in dtNarr.Rows)&#xD;&#xA;        {&#xD;&#xA;            string refNo = row[&quot;TRN_REF_NO&quot;]?.ToString();&#xD;&#xA;            string narrative = row[&quot;NARRATIVE&quot;]?.ToString();&#xD;&#xA;            if (!string.IsNullOrEmpty(refNo) &amp;&amp; !string.IsNullOrEmpty(narrative))&#xD;&#xA;                refNarrationMap[refNo] = narrative;&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Step 4: Update dt with cleaned narration&#xD;&#xA;foreach (DataRow row in dt.Rows)&#xD;&#xA;{&#xD;&#xA;    string refNo = row[&quot;Transaction Ref No:&quot;].ToString();&#xD;&#xA;    if (refNarrationMap.ContainsKey(refNo))&#xD;&#xA;        row[&quot;Narration&quot;] = refNarrationMap[refNo];&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Final output&#xD;&#xA;dtGlStatement = dt;&#xD;&#xA;" DisplayName="dtGlStatement" sap:VirtualizedContainerService.HintSize="558,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_37" Language="CSharp">

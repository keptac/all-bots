              <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Helper methods&#xA;string FormatAmount(string input)&#xA;{&#xA;    return decimal.TryParse(input, out decimal amount)&#xA;        ? amount.ToString(&quot;0.00&quot;)&#xA;        : &quot;0.00&quot;;&#xA;}&#xA;&#xA;string CleanAndTrim(string input)&#xA;{&#xA;    // Remove all non-alphanumeric characters&#xA;    return Regex.Replace(input ?? &quot;&quot;, @&quot;[^a-zA-Z0-9]&quot;, &quot;&quot;);&#xA;}&#xA;&#xA;// Ensure &quot;Search Key&quot; column exists&#xA;if (!dtGlStatement.Columns.Contains(&quot;Search Key&quot;))&#xA;    dtGlStatement.Columns.Add(&quot;Search Key&quot;, typeof(string));&#xA;&#xA;// Update Search Key for each row&#xA;foreach (DataRow row in dtGlStatement.Rows)&#xA;{&#xA;    string pan = row[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string rrn = row[&quot;RRN&quot;]?.ToString() ?? &quot;&quot;;&#xA;&#xA;    string amount = !string.IsNullOrWhiteSpace(row[&quot;Debit&quot;]?.ToString()) &amp;&amp; row[&quot;Debit&quot;].ToString() != &quot;0&quot;&#xA;        ? FormatAmount(row[&quot;Debit&quot;].ToString())&#xA;        : FormatAmount(row[&quot;Credit&quot;].ToString());&#xA;&#xA;    string rawKey = pan + rrn + amount;&#xA;    row[&quot;Search Key&quot;] = CleanAndTrim(rawKey);&#xA;}&#xA;" DisplayName="UPDATE Search Key" sap:VirtualizedContainerService.HintSize="419.2,188" sap2010:WorkflowViewState.IdRef="InvokeCode_48" Language="CSharp">

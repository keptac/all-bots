=========&quot;);&#xA;Console.WriteLine($&quot;🔵 Total Rows Before Processing:  {totalBefore}&quot;);&#xA;Console.WriteLine($&quot;🟢 Total Rows Matched (moved out): {totalMatched}&quot;);&#xA;Console.WriteLine($&quot;🟡 Total Rows Remaining After:    {totalAfter}&quot;);&#xA;Console.WriteLine($&quot;✅ Row Check: {totalBefore} == {totalAfter} + {totalMatched} → {(totalBefore == (totalAfter + totalMatched) ? &quot;PASS&quot; : &quot;FAIL&quot;)}&quot;);&#xA;Console.WriteLine();&#xA;Console.WriteLine($&quot;🔵 Debit Total Before: {debitBefore:0.00}&quot;);&#xA;Console.WriteLine($&quot;🟢 Debit Matched:      {debitMatched:0.00}&quot;);&#xA;Console.WriteLine($&quot;🟡 Debit Remaining:    {debitAfter:0.00}&quot;);&#xA;Console.WriteLine($&quot;✅ Debit Check: {debitBefore:0.00} == {debitMatched:0.00} + {debitAfter:0.00} → {(debitBefore == debitMatched + debitAfter ? &quot;PASS&quot; : &quot;FAIL&quot;)}&quot;);&#xA;Console.WriteLine();&#xA;Console.WriteLine($&quot;🔵 Credit Total Before: {creditBefore:0.00}&quot;);&#xA;Console.WriteLine($&quot;🟢 Credit Matched:      {creditMatched:0.00}&quot;);&#xA;Console.WriteLine($&quot;🟡 Credit Remaining:    {creditAfter:0.00}&quot;);&#xA;Console.WriteLine($&quot;✅ Credit Check: {creditBefore:0.00} == {creditMatched:0.00} + {creditAfter:0.00} → {(creditBefore == creditMatched + creditAfter ? &quot;PASS&quot; : &quot;FAIL&quot;)}&quot;);&#xA;Console.WriteLine();&#xA;Console.WriteLine($&quot;🔵 Matched Debit Sum:  {debitMatched:0.00}&quot;);&#xA;Console.WriteLine($&quot;🔵 Matched Credit Sum: {creditMatched:0.00}&quot;);&#xA;Console.WriteLine($&quot;✅ Matched Debit == Credit: {(debitMatched == creditMatched ? &quot;PASS&quot; : &quot;FAIL&quot;)}&quot;);&#xA;Console.WriteLine(&quot;===============================================&quot;);&#xA;" DisplayName="SELF MATCHING" sap:VirtualizedContainerService.HintSize="1564,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_93" Language="CSharp">

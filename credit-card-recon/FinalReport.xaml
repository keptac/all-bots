ecommendedAction = row.Table.Columns.Contains(&quot;Recommended Action&quot;) ? row[&quot;Recommended Action&quot;]?.ToString() : null;&#xA;    string actionOwner = row.Table.Columns.Contains(&quot;Action Owner&quot;) ? row[&quot;Action Owner&quot;]?.ToString() : null;&#xA;&#xA;    // Check for date range in narration using regex&#xA;    bool hasDateRange = System.Text.RegularExpressions.Regex.IsMatch(&#xA;        narration,&#xA;        @&quot;\b(for|from)\s?\d{6}(\s?(to|_)\s?\d{6})\b&quot;,&#xA;        System.Text.RegularExpressions.RegexOptions.IgnoreCase&#xA;    );&#xA;&#xA;    if (hasDateRange)&#xA;    {&#xA;        newRow[&quot;Root Cause&quot;] = &quot;Manually posted income not matching with income from CMS&quot;;&#xA;        newRow[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        newRow[&quot;Recommended Action&quot;] = &quot;Reverse the wrong amount and post the correct one&quot;;&#xA;        newRow[&quot;Action Owner&quot;] = &quot;Card Finance&quot;;&#xA;    }&#xA;    else&#xA;    {&#xA;        newRow[&quot;Root Cause&quot;] = string.IsNullOrWhiteSpace(rootCause) ? &quot;No corresponding debit for the refunded amount&quot; : rootCause;&#xA;        newRow[&quot;Root Cause Category&quot;] = string.IsNullOrWhiteSpace(rootCauseCategory) ? &quot;Process&quot; : rootCauseCategory;&#xA;        newRow[&quot;Recommended Action&quot;] = string.IsNullOrWhiteSpace(recommendedAction) ? &quot;Advise on the refund&quot; : recommendedAction;&#xA;        newRow[&quot;Action Owner&quot;] = string.IsNullOrWhiteSpace(actionOwner) ? &quot;Card Settlement/Stephen Jilala&quot; : actionOwner;&#xA;    }&#xA;&#xA;    // Add to output&#xA;    dtHistoricalReconTransactionsReport.Rows.Add(newRow);&#xA;    rowsToDelete.Add(row);&#xA;}&#xA;&#xA;// Remove processed rows from dtGlStatementRefund and log&#xA;foreach (var row in rowsToDelete)&#xA;{&#xA;    string txnRef = row[&quot;Transaction Ref No:&quot;]?.ToString()?.Trim();&#xA;    Console.WriteLine($&quot;Removed fr
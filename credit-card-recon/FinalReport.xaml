edit_61_90;&#xA;    grand_90_plus_Debit += debit_90_plus;&#xA;    grand_90_plus_Credit += credit_90_plus;&#xA;}&#xA;&#xA;// Total row&#xA;decimal netTotal = grandTotalCredit - grandTotalDebit;&#xA;string netTotalColor = netTotal &gt;= 0 ? &quot;#28a745&quot; : &quot;#dc3545&quot;;&#xA;&#xA;html.AppendLine(&quot;&lt;tr style='font-weight:bold;background-color:#f2f2f2;'&gt;&quot;);&#xA;html.AppendLine(&quot;&lt;td colspan='2'&gt;TOTAL&lt;/td&gt;&quot;);&#xA;html.AppendLine($&quot;&lt;td style='text-align:right;'&gt;{grandTotalDebit:N2}&lt;/td&gt;&quot;);&#xA;html.AppendLine($&quot;&lt;td style='text-align:right;'&gt;{grandTotalCredit:N2}&lt;/td&gt;&quot;);&#xA;html.AppendLine($&quot;&lt;td style='text-align:right;color:{netTotalColor};'&gt;&lt;strong&gt;{netTotal:N2}&lt;/strong&gt;&lt;/td&gt;&quot;);&#xA;html.AppendLine($&quot;&lt;td style='text-align:right;background-color:#d4edda'&gt;{grand_4_30_Debit:N2}&lt;/td&gt;&quot;);&#xA;html.AppendLine($&quot;&lt;td style='text-align:right;background-color:#d4edda'&gt;{grand_4_30_Credit:N2}&lt;/td&gt;&quot;);&#xA;html.AppendLine($&quot;&lt;td style='text-align:right;background-color:#ffe5b4'&gt;{grand_31_60_Debit:N2}&lt;/td&gt;&quot;);&#xA;html.AppendLine($&quot;&lt;td style='text-align:right;background-color:#ffe5b4'&gt;{grand_31_60_Credit:N2}&lt;/td&gt;&quot;);&#xA;html.AppendLine($&quot;&lt;td style='text-align:right;background-color:#f8d7da'&gt;{grand_61_90_Debit:N2}&lt;/td&gt;&quot;);&#xA;html.AppendLine($&quot;&lt;td style='text-align:right;background-color:#f8d7da'&gt;{grand_61_90_Credit:N2}&lt;/td&gt;&quot;);&#xA;html.AppendLine($&quot;&lt;td style='text-align:right;background-color:#f8d7da'&gt;{grand_90_plus_Debit:N2}&lt;/td&gt;&quot;);&#xA;html.AppendLine($&quot;&lt;td style='text-align:right;background-color:#f8d7da'&gt;{grand_90_plus_Credit:N2}&lt;/td&gt;&quot;);&#xA;html.AppendLine(&quot;&lt;/tr&gt;&quot;);&#xA;&#xA;html.AppendLine(&quot;&lt;/tbody&gt;&lt;/table&gt;&quot;);&#xA;html.AppendLine(&quot;&lt;/body&gt;&lt;/html&gt;&quot;);&#xA;&#xA;emailHtmlSummary = html.ToString();&#xA;emailSubject = $&quot;CARD RCC SUMMARY - TZS | {reconDateParsed:dd-MMM-yyyy}&quot;;&#xA;emailBody = emailHtmlSummary;&#xA;&#xA;// === Helper Methods ===&#xA;DateTime? TryExtractDate(object input)&#xA;{&#xA;    if (input is DateTime dt) return dt;&#xA;    if (double.TryParse(input?.ToString(), out double serial))&#xA;    {&#xA;        try { return DateTime.FromOADate(serial); } catch { return null; }&#xA;    }&#xA;    if (DateTime.TryParse(input?.ToString(), out DateTime parsed)) return parsed;&#xA;    return null;&#xA;}&#xA;&#xA;decimal ParseDecimal(object input)&#xA;{&#xA;    string raw = input?.ToString()?.Trim()&#xA;        .Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;)&#xA;        .Replace(&quot;,&quot;, &quot;&quot;)&#xA;        .Replace(&quot;Cr&quot;, &quot;&quot;, StringComparison.OrdinalIgnoreCase)&#xA;        .Replace(&quot;Dr&quot;, &quot;&quot;, StringComparison.OrdinalIgnoreCase);&#xA;&#xA;    return decimal.TryParse(raw, NumberStyles.Any, CultureInfo.InvariantCulture, out var result) ? result : 0m;&#xA;}&#xA;" DisplayName="RCC SUMMARY" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_120" Language="CSharp">

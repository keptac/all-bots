        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Initialize lastSNO to the last SNO value from dtHistoricalReconTransactionsReport&#xA;int lastSNO = dtHistoricalReconTransactionsReport.AsEnumerable()&#xA;    .Where(row =&gt; row[&quot;SNO&quot;] != DBNull.Value &amp;&amp; int.TryParse(row[&quot;SNO&quot;].ToString(), out _))&#xA;    .Select(row =&gt; Convert.ToInt32(row[&quot;SNO&quot;]))&#xA;    .DefaultIfEmpty(0)&#xA;    .Max();&#xA;&#xA;// Filter only rows where MATCH is false or null from dtCCDD&#xA;var rowsToMove = dtCCDD.AsEnumerable()&#xA;    .Where(row =&gt; row[&quot;MATCH&quot;] == DBNull.Value || !(bool)row[&quot;MATCH&quot;])&#xA;    .ToList();&#xA;&#xA;// Define date formats and culture&#xA;var formats = new[] { &quot;dd-MM-yyyy&quot;, &quot;dd/MM/yyyy&quot;, &quot;yyyy-MM-dd&quot; };&#xA;var culture = System.Globalization.CultureInfo.InvariantCulture;&#xA;&#xA;// Move all filtered rows to dtHistoricalReconTransactionsReport&#xA;foreach (DataRow row in rowsToMove)&#xA;{&#xA;    DataRow newRow = dtHistoricalReconTransactionsReport.NewRow();&#xA;    int reportRowNumber = dtHistoricalReconTransactionsReport.Rows.Count + 2;&#xA;&#xA;    newRow[&quot;SNO&quot;] = ++lastSNO;&#xA;    newRow[&quot;Branch code&quot;] = &quot;101&quot;;&#xA;    newRow[&quot;GL_Code&quot;] = &quot;121080016&quot;;&#xA;    newRow[&quot;GL Description&quot;] = &quot;Rec- MasterCard Credit Card&quot;;&#xA;&#xA;    // Convert and format the dates&#xA;    if (DateTime.TryParseExact(row[&quot;Value Date&quot;].ToString(), formats, culture, System.Globalization.DateTimeStyles.None, out DateTime valueDate))&#xA;        newRow[&quot;Value Date&quot;] = valueDate.ToString(&quot;dd-MMM-yyyy&quot;);&#xA;    else&#xA;        newRow[&quot;Value Date&quot;] = row[&quot;Value Date&quot;];&#xA;&#xA;    if (DateTime.TryParseExact(row[&quot;Booking Date&quot;].ToString(), formats, culture, System.Globalization.DateTimeStyles.None, out DateTime bookingDate))&#xA;        newRow[&quot;Booking
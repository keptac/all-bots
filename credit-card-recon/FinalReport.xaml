        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Initialize lastSNO to the last SNO value from dtHistoricalReconTransactionsReport&#xD;&#xA;int lastSNO = dtHistoricalReconTransactionsReport.AsEnumerable()&#xD;&#xA;    .Where(row =&gt; row[&quot;SNO&quot;] != DBNull.Value &amp;&amp; int.TryParse(row[&quot;SNO&quot;].ToString(), out _))&#xD;&#xA;    .Select(row =&gt; Convert.ToInt32(row[&quot;SNO&quot;]))&#xD;&#xA;    .DefaultIfEmpty(0)&#xD;&#xA;    .Max();&#xD;&#xA;&#xD;&#xA;// Filter only rows where MATCH is false or null from dtCCSP&#xD;&#xA;var rowsToMove = dtCCSP.AsEnumerable()&#xD;&#xA;    .Where(row =&gt; row[&quot;MATCH&quot;] == DBNull.Value || !(bool)row[&quot;MATCH&quot;])&#xD;&#xA;    .ToList();&#xD;&#xA;&#xD;&#xA;// Define date formats and culture&#xD;&#xA;var formats = new[] { &quot;dd-MM-yyyy&quot;, &quot;dd/MM/yyyy&quot;, &quot;yyyy-MM-dd&quot; };&#xD;&#xA;var culture = System.Globalization.CultureInfo.InvariantCulture;&#xD;&#xA;&#xD;&#xA;// Calculate reconDate&#xD;&#xA;DateTime reconDateParsed = DateTime.Parse(toDate, culture).AddDays(-1);&#xD;&#xA;&#xD;&#xA;// Move all filtered rows to dtHistoricalReconTransactionsReport&#xD;&#xA;foreach (DataRow row in rowsToMove)&#xD;&#xA;{&#xD;&#xA;    DataRow newRow = dtHistoricalReconTransactionsReport.NewRow();&#xD;&#xA;    int reportRowNumber = dtHistoricalReconTransactionsReport.Rows.Count + 2;&#xD;&#xA;&#xD;&#xA;    newRow[&quot;SNO&quot;] = ++lastSNO;&#xD;&#xA;    newRow[&quot;Branch code&quot;] = &quot;101&quot;;&#xD;&#xA;    newRow[&quot;GL_Code&quot;] = &quot;121080016&quot;;&#xD;&#xA;    newRow[&quot;GL Description&quot;] = &quot;Rec- MasterCard Credit Card&quot;;&#xD;&#xA;&#xD;&#xA;    // Convert and format the dates&#xD;&#xA;    string valueDateStr = row[&quot;Value Date&quot;]?.ToString();&#xD;&#xA;    string bookingDateStr = row[&quot;Booking Date&quot;]?.ToString();&#xD;&#xA;&#xD;&#xA;    DateTime valueDateParsed = DateTime.TryParseExact(valueDateStr, formats, culture, System.Globalization.DateTimeStyles.None, out var vdt) ? vdt : DateTime.MinValue;&#xD;&#xA;    DateTime bookingDateParsed = DateTime.TryParseExact(bookingDateStr, formats, culture, System.Globalization.DateTimeStyles.None, out var bdt) ? bdt : DateTime.MinValue;&#xD;&#xA;&#xD;&#xA;    newRow[&quot;Value Date&quot;] = valueDateParsed != DateTime.MinValue ? valueDateParsed.ToString(&quot;dd-MMM-yyyy&quot;) : valueDateStr;&#xD;&#xA;    newRow[&quot;Booking Date&quot;] = bookingDateParsed != DateTime.MinValue ? bookingDateParsed.ToString(&quot;dd-MMM-yyyy&quot;) : bookingDateStr;&#xD;&#xA;&#xD;&#xA;    // Map fields&#xD;&#xA;    newRow[&quot;Transaction Ref No:&quot;] = row[&quot;Transaction Ref No:&quot;];&#xD;&#xA;    newRow[&quot;Narration&quot;] = row[&quot;Narration&quot;];&#xD;&#xA;&#xD;&#xA;    decimal ParseAmount(object v, string colName)&#xD;&#xA;    {&#xD;&#xA;        if (v == null || v == DBNull.Value) return 0m;&#xD;&#xA;        var s = v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;);&#xD;&#xA;        if (string.IsNullOrEmpty(s)) return 0m;&#xD;&#xA;        if (decimal.TryParse(s, out var d)) return d;&#xD;&#xA;        Console.WriteLine($&quot;⚠️ Could not parse {colName} value '{v}' for Transaction Ref No: {row[&quot;Transaction Ref No:&quot;]} — defaulted to 0.&quot;);&#xD;&#xA;        return 0m;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    newRow[&quot;Debit&quot;] = ParseAmount(row[&quot;Debit&quot;], &quot;Debit&quot;);&#xD;&#xA;    newRow[&quot;Credit&quot;] = ParseAmount(row[&quot;Credit&quot;], &quot;Credit&quot;);&#xD;&#xA;&#xD;&#xA;    string transactionRefNo = row[&quot;Transaction Ref No:&quot;].ToString();&#xD;&#xA;    string narration = row[&quot;Narration&quot;].ToString();&#xD;&#xA;&#xD;&#xA;    // Root cause logic&#xD;&#xA;    if (transactionRefNo.StartsWith(&quot;BK1&quot;) &amp;&amp;&#xD;&#xA;        narration.Contains(&quot;Journal Posting-Miscellaneous  -  - MANUAL DEDUCTION&quot;
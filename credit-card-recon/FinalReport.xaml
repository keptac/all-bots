        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Helpers ===&#xA;&#xA;void EnsureColumnExists(DataTable table, string columnName, Type type)&#xA;{&#xA;    if (!table.Columns.Contains(columnName))&#xA;        table.Columns.Add(columnName, type);&#xA;}&#xA;&#xA;decimal ParseDecimal(object value)&#xA;{&#xA;    if (value == null || value == DBNull.Value) return 0m;&#xA;    decimal.TryParse(value.ToString(), out decimal result);&#xA;    return Math.Round(result, 2);&#xA;}&#xA;&#xA;decimal SumColumn(DataTable table, string columnName)&#xA;{&#xA;    return Math.Round(&#xA;        table.AsEnumerable()&#xA;            .Where(r =&gt; !r.IsNull(columnName))&#xA;            .Sum(r =&gt; ParseDecimal(r[columnName])),&#xA;        2&#xA;    );&#xA;}&#xA;&#xA;// === Setup ===&#xA;&#xA;// Ensure Search Key column&#xA;EnsureColumnExists(dtHistoricalReconTransactionsReport, &quot;Search Key&quot;, typeof(string));&#xA;&#xA;// Save totals BEFORE processing&#xA;int totalBefore = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;decimal debitBefore = SumColumn(dtHistoricalReconTransactionsReport, &quot;Debit&quot;);&#xA;decimal creditBefore = SumColumn(dtHistoricalReconTransactionsReport, &quot;Credit&quot;);&#xA;&#xA;// Group rows by trimmed Search Key&#xA;var keyGroups = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;(StringComparer.OrdinalIgnoreCase);&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string rawKey = row[&quot;Search Key&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string trimmedKey = rawKey.Replace(&quot; &quot;, &quot;&quot;);&#xA;&#xA;    if (string.IsNullOrEmpty(trimmedKey)) continue;&#xA;&#xA;    if (!keyGroups.ContainsKey(trimmedKey))&#xA;        keyGroups[trimmedKey] = new List&lt;DataRow&gt;();&#xA;&#xA;    keyGroups[trimmedKey].Add(row);&#xA;}&#xA;&#xA;// Collect matched rows for removal&#xA;var rowsToRemove = new List&lt;DataRow&gt;();&#xA;&#xA;foreach (var kvp in keyGroups)&#xA;{&#xA;    var rows = kvp.
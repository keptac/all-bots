otCause&#xA;        : &quot;Late posted transaction&quot;;&#xA;&#xA;    newRow[&quot;Root Cause Category&quot;] = !string.IsNullOrWhiteSpace(rootCauseCategory)&#xA;        ? rootCauseCategory&#xA;        : &quot;System&quot;;&#xA;&#xA;    newRow[&quot;Recommended Action&quot;] = !string.IsNullOrWhiteSpace(recommendedAction)&#xA;        ? recommendedAction&#xA;        : &quot;Check if updates CMS on the following date&quot;;&#xA;&#xA;    newRow[&quot;Action Owner&quot;] = !string.IsNullOrWhiteSpace(actionOwner)&#xA;        ? actionOwner&#xA;        : &quot;Card Reconciliation&quot;;&#xA;&#xA;    // Override conditionally if CWPR or CRDP and ValueDate &gt;= reconDateParsed&#xA;    string transactionRefNo = row[&quot;Transaction Ref No:&quot;]?.ToString() ?? &quot;&quot;;&#xA;    if ((transactionRefNo.Contains(&quot;CWPR&quot;) || transactionRefNo.Contains(&quot;CRDP&quot;)) &amp;&amp; valueDateParsed &gt;= reconDateParsed)&#xA;    {&#xA;        newRow[&quot;Root Cause Category&quot;] = &quot;Process&quot;; // Only override this one&#xA;        // The others remain as-is unless defaulted above&#xA;    }&#xA;&#xA;    // Add to target table&#xA;    dtHistoricalReconTransactionsReport.Rows.Add(newRow);&#xA;}&#xA;&#xA;// Log counts&#xA;Console.WriteLine(&quot;Final dtGlStatementLatePostedTxn count: &quot; + dtGlStatementLatePostedTxn.Rows.Count);&#xA;Console.WriteLine(&quot;Final dtHistoricalReconTransactionsReport count: &quot; + dtHistoricalReconTransactionsReport.Rows.Count);&#xA;" DisplayName="copy dtGlStatementLatePostedTxn items to dtHisto" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_21" Language="CSharp">

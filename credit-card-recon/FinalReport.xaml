        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Helpers ===&#xA;&#xA;void EnsureColumn(DataTable table, string columnName, Type type)&#xA;{&#xA;    if (!table.Columns.Contains(columnName))&#xA;        table.Columns.Add(columnName, type);&#xA;}&#xA;&#xA;void CopyRowToMatched(DataRow sourceRow, DataTable matchedTable)&#xA;{&#xA;    var newRow = matchedTable.NewRow();&#xA;    foreach (DataColumn col in matchedTable.Columns)&#xA;    {&#xA;        if (sourceRow.Table.Columns.Contains(col.ColumnName))&#xA;        {&#xA;            newRow[col.ColumnName] = sourceRow[col.ColumnName];&#xA;        }&#xA;    }&#xA;    newRow[&quot;MATCH&quot;] = true;&#xA;    newRow[&quot;GROUP_MATCHED&quot;] = true;&#xA;    matchedTable.Rows.Add(newRow);&#xA;}&#xA;&#xA;// === Ensure MATCH and GROUP_MATCHED columns exist ===&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;MATCH&quot;, typeof(bool));&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;GROUP_MATCHED&quot;, typeof(bool));&#xA;EnsureColumn(dtHistoricalReconTransactionsReportMatched, &quot;MATCH&quot;, typeof(bool));&#xA;EnsureColumn(dtHistoricalReconTransactionsReportMatched, &quot;GROUP_MATCHED&quot;, typeof(bool));&#xA;&#xA;// === Manual Grouping ===&#xA;var groupedDict = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;();&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    if (!string.IsNullOrEmpty(row[&quot;C_PAN&quot;].ToString()) &amp;&amp;&#xA;        !string.IsNullOrEmpty(row[&quot;RRN&quot;].ToString()) &amp;&amp;&#xA;        !string.IsNullOrEmpty(row[&quot;STAN&quot;].ToString()))&#xA;    {&#xA;        string key = row[&quot;C_PAN&quot;].ToString() + &quot;|&quot; + row[&quot;RRN&quot;].ToString() + &quot;|&quot; + row[&quot;STAN&quot;].ToString();&#xA;        if (!groupedDict.ContainsKey(key))&#xA;            groupedDict[key] = new List&lt;DataRow&gt;();&#xA;        groupedDict[key].Add(row);&#xA;    }&#xA;}&#xA;&#xA;var rowsToRemove = new List&lt;DataRow&gt;();&#xA;decimal tolerance = 0.05m; // Allowed small difference&#xA;int groupsMatched = 0;&#xA;int groupsNotMatched = 0;&#xA;&#xA;&#xA;&#xA;// === Processing Groups ===&#xA;foreach (var kvp in groupedDict)&#xA;{&#xA;    string[] parts = kvp.Key.Split('|');&#xA;    string cpan = parts[0];&#xA;    string rrn = parts[1];&#xA;    string stan = parts[2];&#xA;&#xA;    var groupRows = kvp.Value;&#xA;&#xA;    decimal totalDebits = 0;&#xA;    decimal totalCredits = 0;&#xA;&#xA;    foreach (var row in groupRows)&#xA;    {&#xA;        decimal debit = 0;&#xA;        decimal credit = 0;&#xA;        decimal.TryParse(row[&quot;Debit&quot;]?.ToString(), out debit);&#xA;        decimal.TryParse(row[&quot;Credit&quot;]?.ToString(), out credit);&#xA;&#xA;        totalDebits += Math.Round(debit, 2);&#xA;        totalCredits += Math.Round(credit, 2);&#xA;    }&#xA;&#xA;    decimal difference = Math.Abs(totalDebits - totalCredits);&#xA;&#xA;    if (difference &lt;= tolerance &amp;&amp; totalDebits != 0 &amp;&amp; totalCredits != 0)&#xA;    {&#xA;        // ✅ Matched&#xA;        foreach (var row in groupRows)&#xA;        {&#xA;            row[&quot;MATCH&quot;] = true;&#xA;            row[&quot;GROUP_MATCHED&quot;] = true;&#xA;            CopyRowToMatched(row, dtHistoricalReconTransactionsReportMatched);&#xA;            rowsToRemove.Add(row);&#xA;        }&#xA;&#xA;        // === Add to grant totals ===&#xA;        grantTotalDebits += totalDebits;&#xA;        grantTotalCredits += totalCredits;&#xA;&#xA;        groupsMatched++;&#xA;    }&#xA;    else&#xA;    {&#xA;        // ❌ Not matched&#xA;        groupsNotMatched++;&#xA;    }&#xA;}&#xA;&#xA;// === Remove matched rows ===&#xA;foreach (var row in rowsToRemove)&#xA;{&#xA;    dtHistoricalReconTransactionsReport.Rows.Remove(row);&#xA;}&#xA;&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;dtHistoricalReconTransactionsReportMatched.AcceptChanges();&#xA;exchangeGainOrLoss = grantTotalDebits - grantTotalCredits;&#xA;// ==
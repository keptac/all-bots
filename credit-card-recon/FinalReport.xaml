        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Helper: Clean narration&#xA;string CleanText(string input)&#xA;{&#xA;    if (string.IsNullOrEmpty(input)) return string.Empty;&#xA;    return Regex.Replace(input, @&quot;[^a-zA-Z0-9\s]&quot;, &quot;&quot;).Trim().ToUpper();&#xA;}&#xA;&#xA;// === Helper: Parse dates&#xA;bool TryParseValueDate(object rawValue, out DateTime result)&#xA;{&#xA;    string[] formats = { &quot;dd-MMM-yyyy&quot;, &quot;MM/dd/yyyy&quot;, &quot;M/d/yyyy&quot;, &quot;MM/dd/yyyy HH:mm:ss&quot; };&#xA;    string s = rawValue?.ToString();&#xA;    return DateTime.TryParseExact(s, formats, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out result)&#xA;        || DateTime.TryParse(s, out result);&#xA;}&#xA;&#xA;// === Setup&#xA;var invCulture = System.Globalization.CultureInfo.InvariantCulture;&#xA;string[] reconDateFormats = { &quot;dd-MM-yyyy&quot;, &quot;dd-MMM-yyyy&quot;, &quot;d-MMM-yyyy&quot;, &quot;d-MM-yyyy&quot; };&#xA;string[] latePostPatterns = { &quot;CWPR&quot;, &quot;CRDP&quot;, &quot;CCDD&quot;, &quot;CCSP&quot;, &quot;CRAT&quot;, &quot;AGT1&quot;, &quot;AGT2&quot;, &quot;AGT3&quot; };&#xA;Regex dateRangeRegex = new Regex(@&quot;\b(?:for|from)\s+\d{6}\s+(to|-)\s+\d{6}\b&quot;, RegexOptions.IgnoreCase);&#xA;&#xA;// === Parse recon date&#xA;DateTime reconDateParsed;&#xA;if (!DateTime.TryParseExact(reconDate, reconDateFormats, invCulture, DateTimeStyles.None, out reconDateParsed))&#xA;    throw new Exception($&quot;❌ Could not parse reconDate: '{reconDate}'&quot;);&#xA;&#xA;// === Ensure required columns&#xA;string[] requiredCols = {&#xA;    &quot;Root Cause&quot;, &quot;Root Cause Category&quot;, &quot;Recommended Action&quot;, &quot;Action Owner&quot;,&#xA;    &quot;IsLatePosted&quot;, &quot;Aging&quot;, &quot;Aging Group&quot;, &quot;BOT Classification&quot;&#xA;};&#xA;&#xA;foreach (var col in requiredCols)&#xA;{&#xA;    if (!dtGlStatement.Columns.Contains(col))&#xA;    {&#xA;        dtGlStatement.Columns.Add(col, col == &quot;IsLatePosted&quot; ? typeof(bool) : typeof(string));&#xA;    }&#xA;    else if (col == &quot;IsLatePosted&quot; &amp;&amp; dtGlStatement.Columns[col].DataType != typeof(bool))&#xA;    {&#xA;        throw new Exception(&quot;❌ Column 'IsLatePosted' exists but is not of type bool.&quot;);&#xA;    }&#xA;}&#xA;&#xA;int manualMatchedCount = 0;&#xA;int latePostedCount = 0;&#xA;int dateRangeMatchedCount = 0;&#xA;&#xA;foreach (DataRow row in dtGlStatement.Rows)&#xA;{&#xA;    string rawNarration = row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string cleanNarration = CleanText(rawNarration);&#xA;    string refNo = row[&quot;Transaction Ref No:&quot;]?.ToString()?.ToUpperInvariant() ?? &quot;&quot;;&#xA;&#xA;    // === Format and parse value/booking dates&#xA;    DateTime valueDt, bookingDt;&#xA;    if (TryParseValueDate(row[&quot;Value Date&quot;], out valueDt))&#xA;        row[&quot;Value Date&quot;] = valueDt.ToString(&quot;dd-MMM-yyyy&quot;, invCulture);&#xA;    if (TryParseValueDate(row[&quot;Booking Date&quot;], out bookingDt))&#xA;        row[&quot;Booking Date&quot;] = bookingDt.ToString(&quot;dd-MMM-yyyy&quot;, invCulture);&#xA;&#xA;    // === Re-parse value date for logic&#xA;    DateTime.TryParseExact(row[&quot;Value Date&quot;]?.ToString(), &quot;dd-MMM-yyyy&quot;, invCulture, DateTimeStyles.None, out valueDt);&#xA;    DateTime dayBeforeRecon = reconDateParsed.AddDays(-1);&#xA;&#xA;    // === Default values&#xA;&#x9;        string rootCause = &quot;Unmatched manual entry&quot;;&#xA;       string category = &quot;Process&quot;;&#xA;       string action = &quot;To be manually matched&quot;;&#xA;       string owner = &quot;Card Reconciliation&quot;;&#xA;&#xA;    // === Flag IsLatePosted (only if not manual)&#xA;    bool isManual = cleanNarration.StartsWith(&quot;JOURNAL POSTING&quot;);&#xA;    row[&quot;IsLatePosted&quot;] = (valueDt == reconDateParsed || valueDt == dayBeforeRecon) &amp;&amp; !isManual;&#xA;&#xA;    // === Highest priority: Narration contains date range&#xA;    if (dateRangeRegex.IsMatch(rawNarration))&#xA;    {&#xA;        rootCause = &quot;Manually posted income not matching with income from CMS&quot;;&#xA;        category = &quot;People&quot;;&#xA;        action = &quot;Reverse the wrong amount and post the correct one&quot;;&#xA;        owner = &quot;Card Finance&quot;;&#xA;        row[&quot;IsLatePosted&quot;] = false; // explicitly unset late-post flag&#xA;        dateRangeMatchedCount++;&#xA;    }&#xA;    // === Second: Manual entry&#xA;    else if (isManual)&#xA;    {&#xA;        rootCause = &quot;Unmatched manual entry&quot;;&#xA;        category = &quot;Process&quot;;&#xA;        action = &quot;To be manually matched&quot;;&#xA;        owner = &quot;Card Reconciliation&quot;;&#xA;        manualMatchedCount++;&#xA;    }&#xA;    // === Third: Late-post override&#xA;    else if (latePostPatterns.Any(p =&gt; refNo.Contains(p)) &amp;&amp; valueDt != DateTime.MinValue)&#xA;    {&#xA;        DateTime start = reconDateParsed.AddDays(-2);&#xA;        DateTime end = reconDateParsed.AddDays(2);&#xA;        if (valueDt &gt;= start &amp;&amp; valueDt &lt;= end)&#xA;        {&#xA;            rootCause = &quot;Late posted transaction&quot;;&#xA;            category = &quot;System&quot;;&#xA;            action = &quot;Check if updates CMS on the following date&quot;;&#xA;            owner = &quot;Card Reconciliation&quot;;&#xA;            latePostedCount++;&#xA;        }&#xA;    }&#xA;&#xA;    // === Final assignment&#xA;    row[&quot;Root Cause&quot;] = rootCause;&#xA;    row[&quot;Root Cause Category&quot;] = category;&#xA;    row[&quot;Recommended Action&quot;] = action;&#xA;    row[&quot;Action Owner&quot;] = owner;&#xA;&#xA;    // === Formula columns (assumes G = value date col, H = report date)&#xA;    int excelRow = dtGlStatement.Rows.IndexOf(row) + 2;&#xA;    row[&quot;Aging&quot;] = $&quot;=$H$6-G{excelRow}&quot;;&#xA;    row[&quot;Aging Group&quot;] = $&quot;=IF(L{excelRow}&lt;4,\&quot;0-3 Days\&quot;,IF(L{excelRow}&lt;31,\&quot;4-30 Days\&quot;,IF(L{excelRow}&lt;61,\&quot;31-60 Days\&quot;,IF(L{excelRow}&lt;=90,\&quot;61-90 Days\&quot;,IF(L{excelRow}&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;    row[&quot;BOT Classification&quot;] = $&quot;=IF(J{excelRow}&gt;0,IF(L{excelRow}&lt;30,\&quot;Normal\&quot;,IF(L{excelRow}&lt;60,\&quot;Especially Mentioned\&quot;,IF(L{excelRow}&lt;90,\&quot;Substandard\&quot;,IF(L{excelRow}&lt;=180,\&quot;Doubtful\&quot;,IF(L{excelRow}&gt;180,\&quot;Loss\&quot;,\&quot;0\&quot;))))),\&quot;Not Applicable\&quot;)&quot;;&#xA;}&#xA;&#xA;// === Summary output&#xA;Console.WriteLine($&quot;✅ dtGlStatement enrichment complete.&quot;);&#xA;Console.WriteLine($&quot;🧾 Manual entries updated: {manualMatchedCount}&quot;);&#xA;Console.WriteLine($&quot;🕒 Late-posted transactions flagged: {latePostedCount}&quot;);&#xA;Console.WriteLine($&quot;📆 Narration date-range override applied: {dateRangeMatchedCount}&quot;);&#xA;&#xA;// === Copy remaining dtGlStatement rows into dtHistoricalReconTransactionsReport (this used to be a no-op) ===&#xA;decimal ParseAmountForGl(object v)&#xA;{&#xA;    if (v == null || v == DBNull.Value) return 0m;&#xA;    var s = v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;);&#xA;    return decimal.TryParse(s, out var d) ? d : 0m;&#xA;}&#xA;&#xA;int lastSNO = dtHistoricalReconTransactionsReport.AsEnumerable()&#xA;    .Where(r =&gt; r[&quot;SNO&quot;] != DBNull.Value &amp;&amp; int.TryParse(r[&quot;SNO&quot;].ToString(), out _))&#xA;    .Select(r =&gt; Convert.ToInt32(r[&quot;SNO&quot;]))&#xA;    .DefaultIfEmpty(0)&#xA;    .Max();&#xA;&#xA;var glRowsToMerge = dtGlStatement.Rows.Cast&lt;DataRow&gt;().ToList();&#xA;&#xA;foreach (var row in glRowsToMerge)&#xA;{&#xA;    DataRow newRow = dtHistoricalReconTransactionsReport.NewRow();&#xA;    int reportRowNumber = dtHistoricalReconTransactionsReport.Rows.Count + 2;&#xA;&#xA;    newRow[&quot;SNO&quot;] = ++lastSNO;&#xA;    newRow[&quot;Branch code&quot;] = &quot;101&quot;;&#xA;    newRow[&quot;GL_Code&quot;] = &quot;121080016&quot;;&#xA;    newRow[&quot;GL Description&quot;] = &quot;Rec- MasterCard Credit Card&quot;;&#xA;    newRow[&quot;Value Date&quot;] = row[&quot;Value Date&quot;];&#xA;    newRow[&quot;Booking Date&quot;] = row[&quot;Booking Date&quot;];&#xA;    newRow[&quot;Transaction Ref No:&quot;] = row[&quot;Transaction Ref No:&quot;];&#xA;    newRow[&quot;Narration&quot;] = row[&quot;Narration&quot;];&#xA;    newRow[&quot;Debit&quot;] = ParseAmountForGl(row[&quot;Debit&quot;]);&#xA;    newRow[&quot;Credit&quot;] = ParseAmountForGl(row[&quot;Credit&quot;]);&#xA;&#xA;    newRow[&quot;Aging&quot;] = $&quot;=$H$6-G{reportRowNumber}&quot;;&#xA;    newRow[&quot;Aging Group&quot;] = $&quot;=IF(L{reportRowNumber}&lt;4,\&quot;0-3 Days\&quot;,IF(L{reportRowNumber}&lt;31,\&quot;4-30 Days\&quot;,IF(L{reportRowNumber}&lt;61,\&quot;31-60 Days\&quot;,IF(L{reportRowNumber}&lt;=90,\&quot;61-90 Days\&quot;,IF(L{reportRowNumber}&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;    newRow[&quot;BOT Classification&quot;] = $&quot;=IF(J{reportRowNumber}&gt;0,IF(L{reportRowNumber}&lt;30,\&quot;Normal\&quot;,IF(L{reportRowNumber}&lt;60,\&quot;Especially Mentioned\&quot;,IF(L{reportRowNumber}&lt;90,\&quot;Substandard\&quot;,IF(L{reportRowNumber}&lt;=180,\&quot;Doubtful\&quot;,IF(L{reportRowNumber}&gt;180,\&quot;Loss\&quot;,\&quot;0\&quot;))))),\&quot;Not Applicable\&quot;)&quot;;&#xA;&#xA;    newRow[&quot;Root Cause&quot;] = row[&quot;Root Cause&quot;];&#xA;    newRow[&quot;Root Cause Category&quot;] = row[&quot;Root Cause Category&quot;];&#xA;    newRow[&quot;Recommended Action&quot;] = row[&quot;Recommended Action&quot;];&#xA;    newRow[&quot;Action Owner&quot;] = row[&quot;Action Owner&quot;];&#xA;&#xA;    dtHistoricalReconTransactionsReport.Rows.Add(newRow);&#xA;    dtGlStatement.Rows.Remove(row);&#xA;}&#xA;&#xA;dtGlStatement.AcceptChanges();&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;&#xA;Console.WriteLine($&quot;✅ Copied {glRowsToMerge.Count} remaining dtGlStatement rows into dtHistoricalReconTransactionsReport.&quot;);&#xA;" DisplayName="copy match=false dtGlStatement items to dtHisto" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_107" Language="CSharp">

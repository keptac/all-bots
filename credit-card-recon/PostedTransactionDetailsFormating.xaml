        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === 1. Ensure MATCH column exists ===&#xA;void EnsureMatchColumn(DataTable table)&#xA;{&#xA;    if (!table.Columns.Contains(&quot;MATCH&quot;))&#xA;    {&#xA;        table.Columns.Add(&quot;MATCH&quot;, typeof(bool));&#xA;    }&#xA;}&#xA;&#xA;EnsureMatchColumn(dtPostedTransactionDetails);&#xA;EnsureMatchColumn(dtPostedTransactionDetailsRev);&#xA;&#xA;// === 2. Helper to Copy Row ===&#xA;void CopyRow(DataRow source, DataRow target, DataTable targetTable)&#xA;{&#xA;    foreach (DataColumn col in targetTable.Columns)&#xA;    {&#xA;        if (source.Table.Columns.Contains(col.ColumnName))&#xA;        {&#xA;            target[col.ColumnName] = source[col.ColumnName];&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === 3. Strict Matching Logic: C_PAN + Device + Opposite Transaction Type + Opposite Billing Amount + Reversal ===&#xA;var rowsToRemoveAfterMatching = new List&lt;DataRow&gt;();&#xA;&#xA;for (int i = 0; i &lt; dtPostedTransactionDetails.Rows.Count; i++)&#xA;{&#xA;    var row1 = dtPostedTransactionDetails.Rows[i];&#xA;&#xA;    string cpan1 = row1[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string device1 = row1[&quot;Device Number&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string reversal1 = row1.Table.Columns.Contains(&quot;Reversal&quot;) ? (row1[&quot;Reversal&quot;]?.ToString().ToUpper() ?? &quot;&quot;) : &quot;&quot;;&#xA;    string transactionType1 = row1.Table.Columns.Contains(&quot;Transaction Type&quot;) ? (row1[&quot;Transaction Type&quot;]?.ToString().ToUpper() ?? &quot;&quot;) : &quot;&quot;;&#xA;    decimal billingAmount1 = 0;&#xA;    decimal.TryParse(row1[&quot;Billing Amount&quot;]?.ToString(), out billingAmount1);&#xA;&#xA;    if (string.IsNullOrEmpty(cpan1)) continue;&#xA;    if (row1[&quot;MATCH&quot;] != DBNull.Value &amp;&amp; Convert.ToBoolean(row1[&quot;MATCH&quot;])) continue; // already matched&#xA;&#xA;    bool matched = false;&#xA;&#xA;    for (int j = 0; j &lt; dtPostedTransactionDetails.Rows.Count; j++)&#xA;    {&#xA;        if (i == j) continue;&#xA;&#xA;        var row2 = dtPostedTransactionDetails.Rows[j];&#xA;&#xA;        string cpan2 = row2[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xA;        string device2 = row2[&quot;Device Number&quot;]?.ToString() ?? &quot;&quot;;&#xA;        string reversal2 = row2.Table.Columns.Contains(&quot;Reversal&quot;) ? (row2[&quot;Reversal&quot;]?.ToString().ToUpper() ?? &quot;&quot;) : &quot;&quot;;&#xA;        string transactionType2 = row2.Table.Columns.Contains(&quot;Transaction Type&quot;) ? (row2[&quot;Transaction Type&quot;]?.ToString().ToUpper() ?? &quot;&quot;) : &quot;&quot;;&#xA;        decimal billingAmount2 = 0;&#xA;        decimal.TryParse(row2[&quot;Billing Amount&quot;]?.ToString(), out billingAmount2);&#xA;&#xA;        if (string.IsNullOrEmpty(cpan2)) continue;&#xA;        if (row2[&quot;MATCH&quot;] != DBNull.Value &amp;&amp; Convert.ToBoolean(row2[&quot;MATCH&quot;])) continue; // already matched&#xA;&#xA;        bool strictMatch =&#xA;            cpan1 == cpan2 &amp;&amp;&#xA;            device1 == device2 &amp;&amp;&#xA;            transactionType1 != transactionType2 &amp;&amp; // Opposite Transaction Type (CR &lt;&gt; DR)&#xA;            Math.Round(billingAmount1, 2) == -Math.Round(billingAmount2, 2) &amp;&amp;&#xA;            reversal1 != reversal2; // One is YES, one is NO&#xA;&#xA;        if (strictMatch)&#xA;        {&#xA;            // Mark both rows as matched&#xA;            row1[&quot;MATCH&quot;] = true;&#xA;            row2[&quot;MATCH&quot;] = true;&#xA;            matched = true;&#xA;&#xA;            // === 🔥 LOG the matched pair ===&#xA;            // Console.WriteLine(&quot;✅ Matched Reversal Pair:&quot;);&#xA;            // Console.WriteLine($&quot;   -&gt; Original: {row1[&quot;Transaction Code&quot;]} | Amount: {billingAmount1} | Reversal: {reversal1} | Type: {transactionType1}&quot;);&#xA;            // Console.WriteLine($&quot;   -&gt; Reversal: {row2[&quot;Transaction Code&quot;]} | Amount: {billingAmount2} | Reversal: {reversal2} | Type: {transactionType2}&quot;);&#xA;            // Console.WriteLine($&quot;   -&gt; C_PAN: {cpan1} | Device: {device1}&quot;);&#xA;            // Console.WriteLine(&quot;&quot;);&#xA;&#xA;            break;&#xA;        }&#xA;    }&#xA;&#xA;    if (matched)&#xA;    {&#xA;        rowsToRemoveAfterMatching.Add(row1);&#xA;    }&#xA;}&#xA;&#xA;// === 4. Move matched + REV reversals to dtPostedTransactionDetailsRev ===&#xA;var rowsToRemoveFinal = new List&lt;DataRow&gt;();&#xA;&#xA;foreach (var row in dtPostedTransactionDetails.AsEnumerable().ToList())&#xA;{&#xA;    bool isMatched = row.Table.Columns.Contains(&quot;MATCH&quot;) &amp;&amp; row[&quot;MATCH&quot;] != DBNull.Value &amp;&amp; Convert.ToBoolean(row[&quot;MATCH&quot;]);&#xA;    string transCode = row[&quot;Transaction Code&quot;]?.ToString().ToUpper() ?? &quot;&quot;;&#xA;&#xA;    bool containsRev = transCode.Contains(&quot;REV&quot;);&#xA;&#xA;    if (isMatched || containsRev)&#xA;    {&#xA;        var newRow = dtPostedTransactionDetailsRev.NewRow();&#xA;        CopyRow(row, newRow, dtPostedTransactionDetailsRev);&#xA;&#xA;        // Set MATCH TRUE/FALSE&#xA;        newRow[&quot;MATCH&quot;] = isMatched;&#xA;&#xA;        dtPostedTransactionDetailsRev.Rows.Add(newRow);&#xA;&#xA;        // Remove from source&#xA;        rowsToRemoveFinal.Add(row);&#xA;    }&#xA;}&#xA;&#xA;// Remove all moved rows&#xA;foreach (var row in rowsToRemoveFinal.Distinct().ToList())&#xA;{&#xA;    dtPostedTransactionDetails.Rows.Remove(row);&#xA;}&#xA;&#xA;// Accept Changes&#xA;dtPostedTransactionDetails.AcceptChanges();&#xA;dtPostedTransactionDetailsRev.AcceptChanges();&#xA;&#xA;// === 5. Print Final Summary ===&#xA;int matchedCount = dtPostedTransactionDetailsRev.AsEnumerable()&#xA;    .Count(r =&gt; r[&quot;MATCH&quot;] != DBNull.Value &amp;&amp; Convert.ToBoolean(r[&quot;MATCH&quot;]));&#xA;&#xA;int unmatchedCount = dtPostedTransactionDetailsRev.AsEnumerable()&#xA;    .Count(r =&gt; r[&quot;MATCH&quot;] != DBNull.Value &amp;&amp; !Convert.ToBoolean(r[&quot;MATCH&quot;]));&#xA;&#xA;Console.WriteLine(&quot;=============================================&quot;);&#xA;Console.WriteLine($&quot;✅ Stage 1 Strict Matching Complete:&quot;);&#xA;Console.WriteLine($&quot;✅ Total Matched Reversals (MATCH=TRUE): {matchedCount}&quot;);&#xA;Console.WriteLine($&quot;✅ Total Unmatched Reversals (MATCH=FALSE): {unmatchedCount}&quot;);&#xA;Console.WriteLine($&quot;✅ Remaining rows in dtPostedTransactionDetails: {dtPostedTransactionDetails.Rows.Count}&quot;);&#xA;Console.WriteLine(&quot;=============================================&quot;);&#xA;" DisplayName="Remove Auto REV" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_14" Language="CSharp">

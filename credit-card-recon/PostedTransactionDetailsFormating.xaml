ng(0, Math.Min(23, arn.Length));&#xA;&#xA;            return cleanArn.Equals(microfilmReferenceNumber, StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;                   row[&quot;Billing Amount&quot;].ToString() == billingAmount;&#xA;        });&#xA;&#xA;    if (matchingRows.Any())&#xA;    {&#xA;        postedRow[&quot;ARN FOUND&quot;] = &quot;TRUE&quot;;&#xA;&#xA;        foreach (var matchingTransactionRow in matchingRows)&#xA;        {&#xA;            // Update postedRow with TraceAuditNumber and ReferenceNumber from dtTransactionReport&#xA;            string traceAuditNumber = matchingTransactionRow[&quot;Trace Audit Number&quot;]?.ToString() ?? &quot;&quot;;&#xA;            string referenceNumber = matchingTransactionRow[&quot;Reference Number&quot;]?.ToString() ?? &quot;&quot;;&#xA;            postedRow[&quot;TraceAuditNumber&quot;] = traceAuditNumber;&#xA;            postedRow[&quot;ReferenceNumber&quot;] = referenceNumber;&#xA;        }&#xA;    }&#xA;    else&#xA;    {&#xA;        postedRow[&quot;ARN FOUND&quot;] = &quot;FALSE&quot;;&#xA;        //Console.WriteLine($&quot;No matching transaction found for ARN: {microfilmReferenceNumber}, Billing Amount: {billingAmount}&quot;);&#xA;    }&#xA;}&#xA;" DisplayName="Search Microfilm Reference Number" sap:VirtualizedContainerService.HintSize="449.6,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="CSharp">

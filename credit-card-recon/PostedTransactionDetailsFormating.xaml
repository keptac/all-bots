t;CR&quot;},&#xA;    {&quot;REFUND&quot;, &quot;CR&quot;},&#xA;&#x9;    {&quot;REFUND REV&quot;, &quot;DR&quot;},&#xA;    {&quot;SERVICE TAX/TAX ON INCOME&quot;, &quot;DR&quot;},&#xA;    {&quot;SERVICE TAX/TAX ON INCOME REV&quot;, &quot;CR&quot;},&#xA;    {&quot;TRANSACTION FEES&quot;, &quot;DR&quot;},&#xA;&#x9;    {&quot;TRANSACTION FEES REV&quot;, &quot;CR&quot;},&#xA;    {&quot;UNIQUE TXN&quot;, &quot;DR&quot;},&#xA;&#x9;    {&quot;UNIQUE TXN REV&quot;, &quot;CR&quot;},&#xA;    {&quot;AUTO PAYMENT - THANK YOU&quot;, &quot;CR&quot;},&#xA;    {&quot;AUTO PAYMENT REV&quot;, &quot;DR&quot;}&#xA;};&#xA;&#xA;// Step 3: Set Transaction Type based on Transaction Code&#xA;foreach (System.Data.DataRow row in dtPostedTransactionDetails.Rows)&#xA;{&#xA;    string transactionCode = row[&quot;Transaction Code&quot;].ToString().Trim();&#xA;&#xA;    if (transactionCodeTypeMapping.ContainsKey(transactionCode))&#xA;    {&#xA;        row[&quot;Transaction Type&quot;] = transactionCodeTypeMapping[transactionCode];&#xA;    }&#xA;    else&#xA;    {&#xA;        row[&quot;Transaction Type&quot;] = &quot;&quot;; // If not found, leave it blank&#xA;    }&#xA;}&#xA;&#xA;// Step 4: Negate Billing Amounts where Transaction Type = CR&#xA;foreach (System.Data.DataRow row in dtPostedTransactionDetails.Rows)&#xA;{&#xA;    string transactionType = row[&quot;Transaction Type&quot;].ToString().Trim().ToUpper();&#xA;&#xA;    if (transactionType == &quot;CR&quot;)&#xA;    {&#xA;        if (decimal.TryParse(row[&quot;Billing Amount&quot;].ToString(), out decimal billingAmount))&#xA;        {&#xA;            row[&quot;Billing Amount&quot;] = -Math.Abs(billingAmount); // Force it to be negative&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// Step 5: Save changes (optional)&#xA;dtPostedTransactionDetails.AcceptChanges();&#xA;" DisplayName="NEGATE DR/CR IN PTD" sap:VirtualizedContainerService.HintSize="449.6,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_4" Language="CSharp">

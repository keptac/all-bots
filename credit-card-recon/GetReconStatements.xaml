lls[r, c].Value;&#xA;        dr[c - 2] = val;&#xA;        if (val != null &amp;&amp; !string.IsNullOrWhiteSpace(val.ToString()))&#xA;            hasAny = true;&#xA;    }&#xA;&#xA;    if (hasAny)&#xA;    {&#xA;        dt.Rows.Add(dr);&#xA;        loaded++;&#xA;    }&#xA;}&#xA;&#xA;// — 5) Add formatted columns —&#xA;dt.Columns.Add(&quot;Booking Date (Formatted)&quot;, typeof(string));&#xA;dt.Columns.Add(&quot;Value Date (Formatted)&quot;, typeof(string));&#xA;dt.Columns.Add(&quot;Debit_Final&quot;, typeof(decimal));&#xA;dt.Columns.Add(&quot;Credit_Final&quot;, typeof(decimal));&#xA;&#xA;// — 6) Parse and format values —&#xA;foreach (DataRow row in dt.Rows)&#xA;{&#xA;    row[&quot;Booking Date (Formatted)&quot;] = TryParseDate(row[&quot;Booking Date&quot;]);&#xA;    row[&quot;Value Date (Formatted)&quot;] = TryParseDate(row[&quot;Value Date&quot;]);&#xA;    row[&quot;Debit_Final&quot;] = TryParseDecimal(row[&quot;Debit&quot;]);&#xA;    row[&quot;Credit_Final&quot;] = TryParseDecimal(row[&quot;Credit&quot;]);&#xA;}&#xA;&#xA;// — 7) Replace original columns with formatted versions —&#xA;if (dt.Columns.Contains(&quot;Booking Date&quot;)) dt.Columns.Remove(&quot;Booking Date&quot;);&#xA;if (dt.Columns.Contains(&quot;Value Date&quot;)) dt.Columns.Remove(&quot;Value Date&quot;);&#xA;dt.Columns[&quot;Booking Date (Formatted)&quot;].ColumnName = &quot;Booking Date&quot;;&#xA;dt.Columns[&quot;Value Date (Formatted)&quot;].ColumnName = &quot;Value Date&quot;;&#xA;&#xA;if (dt.Columns.Contains(&quot;Debit&quot;)) dt.Columns.Remove(&quot;Debit&quot;);&#xA;if (dt.Columns.Contains(&quot;Credit&quot;)) dt.Columns.Remove(&quot;Credit&quot;);&#xA;dt.Columns[&quot;Debit_Final&quot;].ColumnName = &quot;Debit&quot;;&#xA;dt.Columns[&quot;Credit_Final&quot;].ColumnName = &quot;Credit&quot;;&#xA;&#xA;// — 8) Assign outputs —&#xA;dtHistoricalReconTransactionsReport = dt;&#xA;lastReconDate = lastReconDate;&#xA;adjustedCBSBalance = adjustedCBSBalance;&#xA;&#xA;// — 9) Summary —&#xA;Console.Writ
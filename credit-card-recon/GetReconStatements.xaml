          <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Temporary list to store rows marked for deletion ===&#xA;var rowsToDelete = new List&lt;DataRow&gt;();&#xA;int removedRowsCount = 0; // Counter for removed rows&#xA;&#xA;// === First pass: Identify rows to move and delete ===&#xA;foreach (DataRow row in dtGlStatement.AsEnumerable().ToList())&#xA;{&#xA;    string txnRef = row.Field&lt;string&gt;(&quot;Transaction Ref No:&quot;)?.Trim() ?? string.Empty;&#xA;&#xA;    // Parse Debit and Credit safely&#xA;    decimal debitAmount = 0;&#xA;    decimal creditAmount = 0;&#xA;&#xA;    if (!Convert.IsDBNull(row[&quot;Debit&quot;]))&#xA;        decimal.TryParse(row[&quot;Debit&quot;].ToString(), out debitAmount);&#xA;&#xA;    if (!Convert.IsDBNull(row[&quot;Credit&quot;]))&#xA;        decimal.TryParse(row[&quot;Credit&quot;].ToString(), out creditAmount);&#xA;&#xA;    // Skip rows with both Debit and Credit zero&#xA;    if (debitAmount == 0 &amp;&amp; creditAmount == 0)&#xA;        continue;&#xA;&#xA;    // Look for matching reversal: same Transaction Ref, opposite amount&#xA;    var matchingReversals = dtGlStatement.AsEnumerable().Where(r =&gt;&#xA;        !Convert.IsDBNull(r[&quot;Transaction Ref No:&quot;]) &amp;&amp;&#xA;        (r.Field&lt;string&gt;(&quot;Transaction Ref No:&quot;)?.Trim() ?? string.Empty) == txnRef &amp;&amp;&#xA;        !object.ReferenceEquals(r, row) &amp;&amp; // Avoid matching with itself&#xA;        (&#xA;            (decimal.TryParse(r[&quot;Debit&quot;].ToString(), out decimal matchDebit) &amp;&amp; matchDebit == -debitAmount &amp;&amp; decimal.TryParse(r[&quot;Credit&quot;].ToString(), out decimal matchCredit1) &amp;&amp; matchCredit1 == 0) ||&#xA;            (decimal.TryParse(r[&quot;Credit&quot;].ToString(), out decimal matchCredit2) &amp;&amp; matchCredit2 == -creditAmount &amp;&amp; decimal.TryParse(r[&quot;Debit&quot;].ToString(), out decimal matchDebit2) &amp;&amp; matchDebit2 == 0)&#xA;        )&#xA;    ).ToList();&#xA;&#xA;    if (matchingReversals.Any())&#xA;    {&#xA;        // Add the original row to dtReversalsGl if not already there&#xA;        if (!dtReversalsGl.AsEnumerable().Any(r =&gt;&#xA;            (r.Field&lt;string&gt;(&quot;Transaction Ref No:&quot;)?.Trim() ?? string.Empty) == txnRef &amp;&amp;&#xA;            decimal.TryParse(r[&quot;Debit&quot;].ToString(), out decimal checkDebit) &amp;&amp; checkDebit == debitAmount &amp;&amp;&#xA;            decimal.TryParse(r[&quot;Credit&quot;].ToString(), out decimal checkCredit) &amp;&amp; checkCredit == creditAmount))&#xA;        {&#xA;            dtReversalsGl.ImportRow(row);&#xA;        }&#xA;&#xA;        // Add matching reversal rows&#xA;        foreach (var reversalRow in matchingReversals)&#xA;        {&#xA;            if (!dtReversalsGl.AsEnumerable().Any(r =&gt;&#xA;                (r.Field&lt;string&gt;(&quot;Transaction Ref No:&quot;)?.Trim() ?? string.Empty) == (reversalRow.Field&lt;string&gt;(&quot;Transaction Ref No:&quot;)?.Trim() ?? string.Empty) &amp;&amp;&#xA;                decimal.TryParse(r[&quot;Debit&quot;].ToString(), out decimal checkReversalDebit) &amp;&amp; decimal.TryParse(reversalRow[&quot;Debit&quot;].ToString(), out decimal revDebit) &amp;&amp; checkReversalDebit == revDebit &amp;&amp;&#xA;                decimal.TryParse(r[&quot;Credit&quot;].ToString(), out decimal checkReversalCredit) &amp;&amp; decimal.TryParse(reversalRow[&quot;Credit&quot;].ToString(), out decimal revCredit) &amp;&amp; checkReversalCredit == revCredit))&#xA;            {&#xA;                dtReversalsGl.ImportRow(reversalRow);&#xA;            }&#xA;&#xA;            if (!rowsToDelete.Contains(reversalRow))&#xA;                rowsToDelete.Add(reversalRow);&#xA;        }&#xA;&#xA;        if (!rowsToDelete.Contains(row))&#xA;            rowsToDelete.Add(row);&#xA;    }&#xA;}&#xA;&#xA;// === Second pass: Remove the rows safely ===&#xA;foreach (var rowToDelete in rowsToDelete)&#xA;{&#xA;    try&#xA;    {&#xA;        dtGlStatement.
        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === CONFIGURATION ===&#xD;&#xA;bool enableLogging = true;&#xD;&#xA;void Log(string msg)&#xD;&#xA;{&#xD;&#xA;    if (enableLogging)&#xD;&#xA;        Console.WriteLine(msg);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// === Helper: Safe Date Parser ===&#xD;&#xA;DateTime SafeParseBookingDate(object bookingDateValue, string rowSource, int rowNumber)&#xD;&#xA;{&#xD;&#xA;    if (bookingDateValue == null || bookingDateValue == DBNull.Value)&#xD;&#xA;        throw new Exception($&quot;❌ [{rowSource}][Row {rowNumber}] Booking Date is empty/null.&quot;);&#xD;&#xA;&#xD;&#xA;    if (bookingDateValue is DateTime dtValue)&#xD;&#xA;        return dtValue;&#xD;&#xA;&#xD;&#xA;    var dateString = bookingDateValue.ToString().Trim();&#xD;&#xA;&#xD;&#xA;    if (string.IsNullOrEmpty(dateString))&#xD;&#xA;        throw new Exception($&quot;❌ [{rowSource}][Row {rowNumber}] Booking Date is empty/null.&quot;);&#xD;&#xA;&#xD;&#xA;    DateTime parsedDate;&#xD;&#xA;&#xD;&#xA;    string[] formats = { &quot;d-MMM-yy&quot;, &quot;d-MMM-yyyy&quot;, &quot;dd/MM/yyyy&quot;, &quot;MM/dd/yyyy&quot;, &quot;d/M/yyyy&quot;, &quot;dd-MMM-yy&quot;, &quot;d-MM-yy&quot; };&#xD;&#xA;&#xD;&#xA;    if (DateTime.TryParseExact(dateString, formats, null, System.Globalization.DateTimeStyles.None, out parsedDate))&#xD;&#xA;        return parsedDate;&#xD;&#xA;&#xD;&#xA;    if (DateTime.TryParse(dateString, out parsedDate))&#xD;&#xA;        return parsedDate;&#xD;&#xA;&#xD;&#xA;    throw new Exception($&quot;❌ [{rowSource}][Row {rowNumber}] Booking Date '{dateString}' does not match any known formats.&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// === Mapping rules ===&#xD;&#xA;var mappingRules = new List&lt;(string Narration, string Contains)&gt;&#xD;&#xA;{&#xD;&#xA;    (&quot;CASH WITHDRAW&quot;, &quot;CASH WITHDRAW&quot;),&#xD;&#xA;    (&quot;CARD FEE&quot;, &quot;CARD FEE&quot;),&#xD;&#xA;    (&quot;INTEREST CHARGES&quot;, &quot;INTEREST CHARGES&quot;),&#xD;&#xA;    (&quot;LATE PAYMENT FEE&quot;, &quot;LATE PAYMENT FEE&quot;),&#xD;&#xA;    (&quot;OVERLIMIT FEE&quot;, &quot;OVERLIMIT FEE&quot;),&#xD;&#xA;    (&quot;SERVICE TAX/TAX ON INCOME&quot;, &quot;SERVICE TAX/TAX ON INCOME&quot;),&#xD;&#xA;    (&quot;TRANSACTION FEES&quot;, &quot;TRANSACTION FEES&quot;),&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;Log(&quot;&gt;&gt;&gt; Starting Matching Process...&quot;);&#xD;&#xA;&#xD;&#xA;// Collect rows to delete after processing&#xD;&#xA;var glRowsToDelete = new List&lt;DataRow&gt;();&#xD;&#xA;var histRowsToDelete = new List&lt;DataRow&gt;();&#xD;&#xA;&#xD;&#xA;// Regex for date range extraction&#xD;&#xA;var dateRangeRegex = new System.Text.RegularExpressions.Regex(@&quot;(\d{6})\s*(?:[Tt][Oo]|-|\/)?\s*(\d{6})&quot;);&#xD;&#xA;&#xD;&#xA;// === Step 1: Filter GL rows starting with &quot;1011&quot;&#xD;&#xA;var filteredRows = dtGlStatement.AsEnumerable()&#xD;&#xA;    .Where(r =&gt; r[&quot;Transaction Ref No:&quot;].ToString().StartsWith(&quot;1011&quot;))&#xD;&#xA;    .ToList();&#xD;&#xA;&#xD;&#xA;Log($&quot;&gt;&gt;&gt; Found {filteredRows.Count} GL rows starting with 1011.&quot;);&#xD;&#xA;&#xD;&#xA;foreach (var glRow in filteredRows)&#xD;&#xA;{&#xD;&#xA;    string narration = glRow[&quot;Narration&quot;]?.ToString()?.Trim().ToUpper() ?? &quot;&quot;;&#xD;&#xA;    DateTime glBookingDate = SafeParseBookingDate(glRow[&quot;Booking Date&quot;], &quot;GL&quot;, dtGlStatement.Rows.IndexOf(glRow) + 1);&#xD;&#xA;&#xD;&#xA;    Log($&quot;\n--- Processing GL Row ---&quot;);&#xD;&#xA;    Log($&quot;Transaction Ref: {glRow[&quot;Transaction Ref No:&quot;]}&quot;);&#xD;&#xA;    Log($&quot;Narration: {narration}&quot;);&#xD;&#xA;&#xD;&#xA;    // Mapping → Changed to .Contains&#xD;&#xA;    string searchKeyword = null;&#xD;&#xA;    foreach (var rule in mappingRules)&#xD;&#xA;    {&#xD;&#xA;        if (narration.Contains(rule.Narration))&#xD;&#xA;        {&#xD;&#xA;            searchKeyword = rule.Contains;&#xD;&#xA;            Log($&quot;Mapped to keyword: {searchKeyword}&quot;);&#xD;&#xA;            break;&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    if (searchKeyword == null)&#xD;&#xA;    {&#xD;&#xA;        Log(&quot;❌ No mapping rule found. Skipping row.&quot;);&#xD;&#xA;        continue;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // Extract FROM and TO dates using improved regex&#xD;&#xA;    var match = dateRangeRegex.Match(narration);&#xD;&#xA;    if (!match.Success)&#xD;&#xA;    {&#xD;&#xA;        Log(&quot;❌ No valid FROM-TO date found in narration. Skipping row.&quot;);&#xD;&#xA;        continue;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    string fromDateText = match.Groups[1].Value;&#xD;&#xA;    string toDateText = match.Groups[2].Value;&#xD;&#xA;&#xD;&#xA;    DateTime fromDate = DateTime.ParseExact(fromDateText, &quot;ddMMyy&quot;, null);&#xD;&#xA;    DateTime toDate = DateTime.ParseExact(toDateText, &quot;ddMMyy&quot;, null);&#xD;&#xA;&#xD;&#xA;    Log($&quot;Date Range: {fromDate.ToShortDateString()} to {toDate.ToShortDateString()}&quot;);&#xD;&#xA;&#xD;&#xA;    // Prepare Historical rows with booking date&#xD;&#xA;    var historicalWithRowNumbers = new List&lt;(DataRow Row, int RowNumber, string Narration, DateTime BookingDate)&gt;();&#xD;&#xA;&#xD;&#xA;    for (int histIndex = 0; histIndex &lt; dtHistoricalReconTransactionsReport.Rows.Count; histIndex++)&#xD;&#xA;    {&#xD;&#xA;        var histRow = dtHistoricalReconTransactionsReport.Rows[histIndex];&#xD;&#xA;        var narrationHist = histRow[&quot;Narration&quot;]?.ToString()?.Trim().ToUpper() ?? &quot;&quot;;&#xD;&#xA;        var bookingDateHist = SafeParseBookingDate(histRow[&quot;Booking Date&quot;], &quot;Historical&quot;, histIndex + 1);&#xD;&#xA;&#xD;&#xA;        historicalWithRowNumbers.Add((histRow, histIndex + 1, narrationHist, bookingDateHist));&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // Match&#xD;&#xA;    var matchedHistRows = historicalWithRowNumbers&#xD;&#xA;        .Where(h =&gt; h.Narration.Contains(searchKeyword) &amp;&amp; h.BookingDate &gt;= fromDate &amp;&amp; h.BookingDate &lt;= toDate)&#xD;&#xA;        .Select(h =&gt; h.Row)&#xD;&#xA;        .ToList();&#xD;&#xA;&#xD;&#xA;    Log($&quot;Found {matchedHistRows.Count} historical rows matching criteria.&quot;);&#xD;&#xA;&#xD;&#xA;    if (matchedHistRows.Count == 0)&#xD;&#xA;    {&#xD;&#xA;        Log(&quot;❌ No historical matches. Skipping row.&quot;);&#xD;&#xA;        continue;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // Calculate total matched amount&#xD;&#xA;    decimal totalMatchedAmount = matchedHistRows.Sum(r =&gt;&#xD;&#xA;    {&#xD;&#xA;        decimal debit = 0m, credit = 0m;&#xD;&#xA;        decimal.TryParse(r[&quot;Debit&quot;]?.ToString()?.Replace(&quot;,&quot;, &quot;&quot;), out debit);&#xD;&#xA;        decimal.TryParse(r[&quot;Credit&quot;]?.ToString()?.Replace(&quot;,&quot;, &quot;&quot;), out credit);&#xD;&#xA;        return debit != 0 ? debit : credit;&#xD;&#xA;    });&#xD;&#xA;&#xD;&#xA;    decimal glDebit = decimal.TryParse(glRow[&quot;Debit&quot;]?.ToString()?.Replace(&quot;,&quot;, &quot;&quot;), out var debitAmount) ? debitAmount : 0m;&#xD;&#xA;&#xD;&#xA;    Log($&quot;GL Debit: {glDebit}&quot;);&#xD;&#xA;    Log($&quot;Historical Total: {totalMatchedAmount}&quot;);&#xD;&#xA;&#xD;&#xA;    if (glDebit == totalMatchedAmount)&#xD;&#xA;    {&#xD;&#xA;        Log(&quot;✅ EXACT MATCH - Moving to matched tables.&quot;);&#xD;&#xA;&#xD;&#xA;        var newGlRow = dtGlStatementMatched.NewRow();&#xD;&#xA;        foreach (DataColumn col in dtGlStatement.Columns)&#xD;&#xA;            newGlRow[col.ColumnName] = glRow[col.ColumnName];&#xD;&#xA;&#xD;&#xA;        newGlRow[&quot;MATCH&quot;] = true;&#xD;&#xA;        dtGlStatementMatched.Rows.Add(newGlRow);&#xD;&#xA;        glRowsToDelete.Add(glRow);&#xD;&#xA;&#xD;&#xA;        foreach (var histRow in matchedHistRows)&#xD;&#xA;        {&#xD;&#xA;            var newHistRow = dtHistoricalReconTransactionsReportMatched.NewRow();&#xD;&#xA;            foreach (DataColumn col in dtHistoricalReconTransactionsReport.Columns)&#xD;&#xA;                newHistRow[col.ColumnName] = histRow[col.ColumnName];&#xD;&#xA;&#xD;&#xA;            newHistRow[&quot;MATCH&quot;] = true;&#xD;&#xA;            dtHistoricalReconTransactionsReportMatched.Rows.Add(newHistRow);&#xD;&#xA;            histRowsToDelete.Add(histRow);&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;    else&#xD;&#xA;    {&#xD;&#xA;        Log(&quot;❌ Amount does not match exactly. Not moving.&quot;);&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// === Remove matched rows ===&#xD;&#xA;foreach (var row in glRowsToDelete)&#xD;&#xA;    dtGlStatement.Rows.Remove(row);&#xD;&#xA;&#xD;&#xA;foreach (var row in histRowsToDelete)&#xD;&#xA;    dtHistoricalReconTransactionsReport.Rows.Remove(row);&#xD;&#xA;&#xD;&#xA;Log(&quot;\n&gt;&gt;&gt; Matching Process Completed.&quot;);&#xD;&#xA;" DisplayName="dtGlStatement VS dtHistoricalReconTransactionsReport" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_108" Language="CSharp">

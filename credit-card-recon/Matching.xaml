dTransactionDetails.Rows.Remove(row);&#xA;    }&#xA;&#xA;    Console.WriteLine($&quot;✅ Match Phase 1: Balanced match (D={debitTotal}, C={creditTotal}). Rows moved: {matchedGL.Count + matchedPosted.Count}&quot;);&#xA;}&#xA;else&#xA;{&#xA;    Console.WriteLine($&quot;⚠️ Match Phase 1 skipped: Debit ({debitTotal}) ≠ Credit ({creditTotal})&quot;);&#xA;}&#xA;&#xA;// Step 5–7: Match remaining rows where MATCH = false&#xA;var remainingGL = dtGlStatement.AsEnumerable()&#xA;    .Where(row =&gt; row[&quot;MATCH&quot;] != DBNull.Value &amp;&amp; Convert.ToBoolean(row[&quot;MATCH&quot;]) == false)&#xA;    .ToList();&#xA;&#xA;var remainingPosted = dtPostedTransactionDetails.AsEnumerable()&#xA;    .Where(row =&gt; row[&quot;MATCH&quot;] != DBNull.Value &amp;&amp; Convert.ToBoolean(row[&quot;MATCH&quot;]) == false)&#xA;    .ToList();&#xA;&#xA;var remainingPostedKeys = new HashSet&lt;string&gt;(&#xA;    remainingPosted.Select(r =&gt; r[&quot;Search Key&quot;].ToString())&#xA;);&#xA;&#xA;var matchedRemainingGL = remainingGL&#xA;    .Where(row =&gt; remainingPostedKeys.Contains(row[&quot;Search Key&quot;].ToString()))&#xA;    .ToList();&#xA;&#xA;var remainingMatchedKeys = new HashSet&lt;string&gt;(&#xA;    matchedRemainingGL.Select(r =&gt; r[&quot;Search Key&quot;].ToString())&#xA;);&#xA;&#xA;var matchedRemainingPosted = remainingPosted&#xA;    .Where(row =&gt; remainingMatchedKeys.Contains(row[&quot;Search Key&quot;].ToString()))&#xA;    .ToList();&#xA;&#xA;// Step 8: Balance check for second phase&#xA;debitTotal = 0;&#xA;creditTotal = 0;&#xA;&#xA;foreach (var row in matchedRemainingGL.Concat(matchedRemainingPosted))&#xA;{&#xA;    if (decimal.TryParse(row[&quot;Debit&quot;]?.ToString(), out decimal debit))&#xA;        debitTotal += debit;&#xA;&#xA;    if (decimal.TryParse(row[&quot;Credit&quot;]?.ToString(), out decimal credit))&#xA;        creditTotal += credit;&#xA;}&#xA;&#xA;if (Math.Round(debitTotal, 2) == Math.Round(creditTotal, 2))&#xA;{&#xA;    foreach (var row in matchedRemainingGL)&#xA;    {&#xA;        dtGlStatementMatched.ImportRow(row);&#xA;        dtGlStatement.Rows.Remove(row);&#xA;    }&#xA;&#xA;    foreach (var row in matchedRemainingPosted)&#xA;    {&#xA;        dtPostedTransactionDetailsMatched.ImportRow(row);&#xA;        dtPostedTransactionDetails.Rows.Remove(row);&#xA;    }&#xA;&#xA;    Console.WriteLine($&quot;✅ Match Phase 2: Balanced match (D={debitTotal}, C={creditTotal}). Rows moved: {matchedRemainingGL.Count + matchedRemainingPosted.Count}&quot;);&#xA;}&#xA;else&#xA;{&#xA;    Console.WriteLine($&quot;⚠️ Match Phase 2 skipped: Debit ({debitTotal}) ≠ Credit ({creditTotal})&quot;);&#xA;}&#xA;" DisplayName="GL  VS PTD" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_14" Language="CSharp">

        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Helper method to clean and trim&#xA;string CleanAndTrim(string input)&#xA;{&#xA;    // Allow letters, numbers, dot and negative sign&#xA;    return Regex.Replace(input ?? &quot;&quot;, &quot;[^a-zA-Z0-9\\.-]&quot;, &quot;&quot;).Trim();&#xA;}&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    // === Clean Credit ===&#xA;    if (row[&quot;Credit&quot;] != null &amp;&amp; row[&quot;Credit&quot;].ToString().Trim() == &quot;-&quot;)&#xA;    {&#xA;        row[&quot;Credit&quot;] = &quot;0.00&quot;;&#xA;    }&#xA;&#xA;    // === Clean Debit ===&#xA;    if (row[&quot;Debit&quot;] != null &amp;&amp; row[&quot;Debit&quot;].ToString().Trim() == &quot;-&quot;)&#xA;    {&#xA;        row[&quot;Debit&quot;] = &quot;0.00&quot;;&#xA;    }&#xA;&#xA;    // === Generate Search Key ===&#xA;&#xA;    string pan = row[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string rrn = row[&quot;RRN&quot;]?.ToString() ?? &quot;&quot;;&#xA;&#xA;    // You will receive DebitFormatted and CreditFormatted as arguments from FormatAmount invoke code&#xA;    string debitFormatted = row[&quot;Debit&quot;]?.ToString() ?? &quot;0.00&quot;;&#xA;    string creditFormatted = row[&quot;Credit&quot;]?.ToString() ?? &quot;0.00&quot;;&#xA;&#xA;    string amount = debitFormatted != &quot;0.00&quot;&#xA;        ? debitFormatted&#xA;        : creditFormatted;&#xA;&#xA;    string searchKey = CleanAndTrim(pan + rrn + amount);&#xA;&#xA;    row[&quot;Search Key&quot;] = searchKey;&#xA;}&#xA;" DisplayName="UPDATE Search Key" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_102" Language="CSharp">

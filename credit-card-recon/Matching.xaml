        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Inputs: dtHistoricalReconTransactionsReport (DataTable)&#xA;// Outputs: dtHistoricalReconTransactionsReportMatched (DataTable)&#xA;&#xA;// === Helpers ===&#xA;&#xA;void EnsureColumnExists(DataTable table, string columnName, Type type)&#xA;{&#xA;    if (!table.Columns.Contains(columnName))&#xA;        table.Columns.Add(columnName, type);&#xA;}&#xA;&#xA;DataTable CloneStructure(DataTable original)&#xA;{&#xA;    return original.Clone();&#xA;}&#xA;&#xA;decimal ParseDecimal(object value)&#xA;{&#xA;    if (value == null || value == DBNull.Value) return 0m;&#xA;    decimal.TryParse(value.ToString(), out decimal result);&#xA;    return Math.Round(result, 2);&#xA;}&#xA;&#xA;decimal SumColumn(DataTable table, string columnName)&#xA;{&#xA;    return Math.Round(&#xA;        table.AsEnumerable()&#xA;            .Where(r =&gt; !r.IsNull(columnName))&#xA;            .Sum(r =&gt; ParseDecimal(r[columnName])), &#xA;        2&#xA;    );&#xA;}&#xA;&#xA;// === Setup ===&#xA;&#xA;// Ensure Search Key column&#xA;EnsureColumnExists(dtHistoricalReconTransactionsReport, &quot;Search Key&quot;, typeof(string));&#xA;&#xA;// Save totals BEFORE processing&#xA;int totalBefore = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;decimal debitBefore = SumColumn(dtHistoricalReconTransactionsReport, &quot;Debit&quot;);&#xA;decimal creditBefore = SumColumn(dtHistoricalReconTransactionsReport, &quot;Credit&quot;);&#xA;&#xA;// Prepare Matched table&#xA;dtHistoricalReconTransactionsReportMatched = CloneStructure(dtHistoricalReconTransactionsReport);&#xA;&#xA;// Group rows by trimmed Search Key&#xA;var keyGroups = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;(StringComparer.OrdinalIgnoreCase);&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string rawKey = row[&quot;Search Key&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string trimmedKey = rawKey.Replace(&quot; &quot;, &quot;&quot;);&#xA;&#xA;    if (string.IsNullOrEmpty(trimmedKey)) continue;&#xA;&#xA;    if (!keyGroups.ContainsKey(trimmedKey))&#xA;        keyGroups[trimmedKey] = new List&lt;DataRow&gt;();&#xA;&#xA;    keyGroups[trimmedKey].Add(row);&#xA;}&#xA;&#xA;// Collect rows to move&#xA;var rowsToRemove = new List&lt;DataRow&gt;();&#xA;&#xA;foreach (var kvp in keyGroups)&#xA;{&#xA;    var rows = kvp.Value;&#xA;    if (rows.Count &lt; 2) continue; // Need at least 2 rows&#xA;&#xA;    var row1 = rows[0];&#xA;    var row2 = rows[1];&#xA;&#xA;    decimal debit1 = ParseDecimal(row1[&quot;Debit&quot;]);&#xA;    decimal credit1 = ParseDecimal(row1[&quot;Credit&quot;]);&#xA;    decimal debit2 = ParseDecimal(row2[&quot;Debit&quot;]);&#xA;    decimal credit2 = ParseDecimal(row2[&quot;Credit&quot;]);&#xA;&#xA;    decimal amount1 = debit1 != 0 ? debit1 : -credit1;&#xA;    decimal amount2 = debit2 != 0 ? debit2 : -credit2;&#xA;&#xA;    decimal sum = Math.Round(amount1 + amount2, 2);&#xA;&#xA;    if (sum == 0m) // Strict exact match&#xA;    {&#xA;        dtHistoricalReconTransactionsReportMatched.ImportRow(row1);&#xA;        dtHistoricalReconTransactionsReportMatched.ImportRow(row2);&#xA;        rowsToRemove.Add(row1);&#xA;        rowsToRemove.Add(row2);&#xA;&#xA;        Console.WriteLine($&quot;✅ Exact Matched Pair -&gt; SearchKey: {kvp.Key}, Amount1: {amount1:0.00}, Amount2: {amount2:0.00}&quot;);&#xA;    }&#xA;}&#xA;&#xA;// Remove matched rows from original&#xA;foreach (var row in rowsToRemove)&#xA;{&#xA;    dtHistoricalReconTransactionsReport.Rows.Remove(row);&#xA;}&#xA;&#xA;// Finalize changes&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;dtHistoricalReconTransactionsReportMatched.AcceptChanges();&#xA;&#xA;// === Final Audit Logging ===&#xA;&#xA;int totalMatched = dtHistoricalReconTransactionsReportMatched.Rows.Count;&#xA;int totalAfter = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;&#xA;// Sum totals AFTER processing&#xA;decimal debitAfter = SumColumn(dtHistoricalReconTransactionsReport, &qu
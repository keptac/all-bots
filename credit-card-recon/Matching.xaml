        <ui:InvokeCode ContinueOnError="{x:Null}" Code="int correctionCount = 0;&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    object creditObj = row[&quot;Credit&quot;];&#xA;    if (creditObj != DBNull.Value)&#xA;    {&#xA;        string creditStr = creditObj.ToString();&#xA;        if (decimal.TryParse(creditStr, out decimal creditAmount) &amp;&amp; creditAmount &lt; 0)&#xA;        {&#xA;            row[&quot;Debit&quot;] = Math.Abs(creditAmount);&#xA;            row[&quot;Credit&quot;] = 0.00m;&#xA;            correctionCount++;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;Console.WriteLine($&quot;✅ Corrected {correctionCount} negative credit rows.&quot;);&#xA;" DisplayName="negative Credit == Debit" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_109" Language="CSharp">

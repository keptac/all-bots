        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Step 1: Filter dtGlStatement for &quot;CWPR with Amount On the CREDIT side ITS a cash back &quot; in Transaction Ref No:&#xA;// We match it aganaist FUND TRANSFER&#xA;// We use CPAN and AMOUNT only&#xA;&#xA;// === Helpers ===&#xA;&#xA;// Ensure a column exists in a DataTable&#xA;void EnsureColumn(DataTable table, string columnName, Type type)&#xA;{&#xA;    if (!table.Columns.Contains(columnName))&#xA;        table.Columns.Add(columnName, type);&#xA;}&#xA;&#xA;// Clean non-alphanumeric characters from a string&#xA;string CleanCPANAmount(string input)&#xA;{&#xA;    return Regex.Replace(input ?? &quot;&quot;, &quot;[^a-zA-Z0-9]&quot;, &quot;&quot;);&#xA;}&#xA;&#xA;// Get formatted 2-decimal billing amount from Debit/Credit&#xA;string GetFormattedBillingAmount(DataRow row, string debitCol, string creditCol)&#xA;{&#xA;    decimal amount = 0;&#xA;&#xA;    if (row.Table.Columns.Contains(debitCol) &amp;&amp;&#xA;        row[debitCol] != DBNull.Value &amp;&amp;&#xA;        decimal.TryParse(row[debitCol].ToString(), out decimal debit) &amp;&amp; debit != 0)&#xA;    {&#xA;        amount = debit;&#xA;    }&#xA;    else if (row.Table.Columns.Contains(creditCol) &amp;&amp;&#xA;             row[creditCol] != DBNull.Value &amp;&amp;&#xA;             decimal.TryParse(row[creditCol].ToString(), out decimal credit) &amp;&amp; credit != 0)&#xA;    {&#xA;        amount = credit;&#xA;    }&#xA;&#xA;    return amount.ToString(&quot;F2&quot;);&#xA;}&#xA;&#xA;// Format billing amount from &quot;Billing Amount&quot; column&#xA;string GetFormattedBillingAmountFromBillingAmount(DataRow row)&#xA;{&#xA;    if (decimal.TryParse(row[&quot;Billing Amount&quot;]?.ToString(), out decimal billingAmount))&#xA;        return billingAmount.ToString(&quot;F2&quot;);&#xA;&#xA;    return &quot;0.00&quot;;&#xA;}&#xA;&#xA;// === Ensure C_PAN_AMOUNT exists ===&#xA;EnsureColumn(dtGlStatement, &quot;C_PAN_AMOUNT&quot;, typeof(string));&#xA;EnsureColumn(dtPostedTransactionDetails, &quot;C_PAN_AMOUNT&quot;, typeof(string));&#xA;&#xA;// === Filter Data ===&#xA;&#xA;// GL Filter: where Transaction Ref No: contains CWPR and Credit &gt; 0&#xA;var glFiltered = dtGlStatement.AsEnumerable()&#xA;    .Where(row =&gt;&#xA;    {&#xA;        var transactionRefNo = row[&quot;Transaction Ref No:&quot;].ToString();&#xA;        var creditValueString = row[&quot;Credit&quot;]?.ToString();&#xA;&#xA;        return (transactionRefNo.Contains(&quot;CWPR&quot;) || transactionRefNo.Contains(&quot;PPCC&quot;)) &amp;&amp;&#xA;               decimal.TryParse(creditValueString, out var credit) &amp;&amp;&#xA;               credit != 0;&#xA;    })&#xA;    .ToList();&#xA;&#xA;// POSTED Filter: FUND TRANSFER&#xA;var postedFiltered = dtPostedTransactionDetails.AsEnumerable()&#xA;    .Where(row =&gt; row[&quot;Transaction Code&quot;].ToString().Equals(&quot;FUND TRANSFER&quot;, StringComparison.OrdinalIgnoreCase))&#xA;    .ToList();&#xA;&#xA;// === GL: Generate C_PAN_AMOUNT ===&#xA;foreach (var row in glFiltered)&#xA;{&#xA;    string cpan = row[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string amount = GetFormattedBillingAmount(row, &quot;Debit&quot;, &quot;Credit&quot;);&#xA;    row[&quot;C_PAN_AMOUNT&quot;] = CleanCPANAmount(cpan + amount);&#xA;}&#xA;&#xA;// === POSTED: Generate C_PAN_AMOUNT using Billing Amount ===&#xA;foreach (var row in postedFiltered)&#xA;{&#xA;    string cpan = row[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string amount = GetFormattedBillingAmountFromBillingAmount(row);&#xA;    row[&quot;C_PAN_AMOUNT&quot;] = CleanCPANAmount(cpan + amount);&#xA;}&#xA;&#xA;// === Match Logic ===&#xA;var postedKeys = new HashSet&lt;string&gt;(&#xA;    postedFiltered.Select(r =&gt; r[&quot;C_PAN_AMOUNT&quot;].ToString())&#xA;);&#xA;&#xA;var matchedGL = glFiltered&#xA;    .Where(row =&gt; postedKeys.Contains(row[&quot;C_PAN_AMOUNT&quot;].ToString()))&#xA;    .ToList();&#xA;&#xA;var matchedKeys = new HashSet&lt;string&gt;(&#xA;    matchedGL.Select(r =&gt; r[&quot;C_PAN_AMOUNT&quot;].ToString())&#xA;);&#xA;&#xA;var matchedPosted = postedFiltered&#xA;    .Where(row =&gt; matchedKeys.Contains(row[&quot;C_PAN_AMOUNT&quot;].ToString()))&#xA;    .ToList();&#xA;&#xA;// === Move matched rows ===&#xA;foreach (var row in matchedGL)&#xA;{&#xA;    dtGlStatementMatched.ImportRow(row);&#xA;    dtGlStatement.Rows.Remove(row);&#xA;}&#xA;&#xA;foreach (var row in matchedPosted)&#xA;{&#xA;    dtPostedTransactionDetailsMatched.ImportRow(row);&#xA;    dtPostedTransactionDetails.Rows.Remove(row);&#xA;}&#xA;&#xA;dtGlStatement.AcceptChanges();&#xA;dtPostedTransactionDetails.AcceptChanges();&#xA;&#xA;" DisplayName="CWPR, PPCC (Amount on CR ) vs FUND TRANSFER Asscociation = 31-API Private Network1" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_49" Language="CSharp">

        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Helpers ===&#xA;&#xA;void EnsureColumn(DataTable table, string columnName, Type type)&#xA;{&#xA;    if (!table.Columns.Contains(columnName))&#xA;        table.Columns.Add(columnName, type);&#xA;}&#xA;&#xA;string CleanString(string input)&#xA;{&#xA;    return Regex.Replace(input?.Trim() ?? &quot;&quot;, &quot;[^a-zA-Z0-9]&quot;, &quot;&quot;);&#xA;}&#xA;&#xA;decimal GetDebitCreditAmount(DataRow row)&#xA;{&#xA;    if (row.Table.Columns.Contains(&quot;Debit&quot;) &amp;&amp;&#xA;        row[&quot;Debit&quot;] != DBNull.Value &amp;&amp;&#xA;        decimal.TryParse(row[&quot;Debit&quot;]?.ToString(), out var debit) &amp;&amp;&#xA;        debit != 0)&#xA;        return Math.Round(Math.Abs(debit), 2);&#xA;&#xA;    if (row.Table.Columns.Contains(&quot;Credit&quot;) &amp;&amp;&#xA;        row[&quot;Credit&quot;] != DBNull.Value &amp;&amp;&#xA;        decimal.TryParse(row[&quot;Credit&quot;]?.ToString(), out var credit) &amp;&amp;&#xA;        credit != 0)&#xA;        return Math.Round(Math.Abs(credit), 2);&#xA;&#xA;    return 0.00m;&#xA;}&#xA;&#xA;decimal GetBillingAmount(DataRow row)&#xA;{&#xA;    if (row.Table.Columns.Contains(&quot;Billing Amount&quot;) &amp;&amp;&#xA;        decimal.TryParse(row[&quot;Billing Amount&quot;]?.ToString(), out var billingAmount))&#xA;        return Math.Round(Math.Abs(billingAmount), 2);&#xA;&#xA;    return 0.00m;&#xA;}&#xA;&#xA;// === Prepare Columns ===&#xA;&#xA;EnsureColumn(dtGlStatement, &quot;C_PAN_AMOUNT&quot;, typeof(string));&#xA;EnsureColumn(dtPostedTransactionDetails, &quot;C_PAN_AMOUNT&quot;, typeof(string));&#xA;&#xA;// === Compute C_PAN_AMOUNT ===&#xA;&#xA;foreach (DataRow row in dtGlStatement.AsEnumerable())&#xA;{&#xA;    string cpan = (row[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;).Trim();&#xA;    decimal amount = GetDebitCreditAmount(row);&#xA;    row[&quot;C_PAN_AMOUNT&quot;] = CleanString(cpan + amount.ToString(&quot;F2&quot;));&#xA;}&#xA;&#xA;foreach (DataRow row in dtPostedTransactionDetails.AsEnumerable())&#xA;{&#xA;    string cpan = (row[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;).Trim();&#xA;    decimal amount = GetBillingAmount(row);&#xA;    row[&quot;C_PAN_AMOUNT&quot;] = CleanString(cpan + amount.ToString(&quot;F2&quot;));&#xA;}&#xA;&#xA;// === Filter Relevant Rows ===&#xA;&#xA;var glFiltered = dtGlStatement.AsEnumerable()&#xA;    .Where(r =&gt;&#xA;    {&#xA;        string txnRef = r[&quot;Transaction Ref No:&quot;]?.ToString().ToUpper() ?? &quot;&quot;;&#xA;&#xA;        if (txnRef.Contains(&quot;CWPR&quot;) || txnRef.Contains(&quot;PPCC&quot;))&#xA;        {&#xA;            if (r.Table.Columns.Contains(&quot;Credit&quot;) &amp;&amp; r[&quot;Credit&quot;] != DBNull.Value)&#xA;            {&#xA;                if (decimal.TryParse(r[&quot;Credit&quot;].ToString(), out decimal credit))&#xA;                    return credit != 0;&#xA;            }&#xA;            return false; // CWPR/PPCC but no valid non-zero credit&#xA;        }&#xA;&#xA;        // For AGT1, AGT2, CRDP, CCSR — allow without credit check&#xA;        return txnRef.Contains(&quot;AGT1&quot;) || txnRef.Contains(&quot;AGT2&quot;) || txnRef.Contains(&quot;CRDP&quot;) || txnRef.Contains(&quot;CCSR&quot;);&#xA;    })&#xA;    .ToList();&#xA;&#xA;var postedFiltered = dtPostedTransactionDetails.AsEnumerable()&#xA;    .Where(r =&gt; r[&quot;Transaction Code&quot;]?.ToString().Equals(&quot;FUND TRANSFER&quot;, StringComparison.OrdinalIgnoreCase) == true)&#xA;    .ToList();&#xA;&#xA;// === Logs Before Matching ===&#xA;&#xA;Console.WriteLine(&quot;\n=== Summary Before Matching ===&quot;);&#xA;Console.WriteLine($&quot;Total GL rows (after filter): {glFiltered.Count}&quot;);&#xA;Console.WriteLine($&quot;Total Posted rows (after filter): {postedFiltered.Count}\n&quot;);&#xA;&#xA;// === Perform Strict 1-to-1 Matching ===&#xA;&#xA;var matchedPairs = new List&lt;(DataRow GLRow, DataRow PostedRow)&gt;();&#xA;var usedPostedRows = new HashSet&lt;DataRow&gt;();&#xA;&#xA;foreach (var gl in glFiltered)&#xA;{&#xA;    var match = postedFiltered.FirstOrDefault(posted =&gt;&#xA;        !usedPostedRows.Contains(posted) &amp;&amp;&#xA;        gl[&quot;C_PAN_AMOUNT&quot;].ToString() == posted[&quot;C_PAN_AMOUNT&quot;].ToString());&#xA;&#xA;    if (match != null)&#xA;    {&#xA;        matchedPairs.Add((gl, match));&#xA;        usedPostedRows.Add(match);&#xA;    }&#xA;}&#xA;&#xA;// === Log Matches ===&#xA;&#xA;Console.WriteLine(&quot;\n=== Matched Summary ===&quot;);&#xA;Console.WriteLine($&quot;Total Matched Pairs: {matchedPairs.Count}\n&quot;);&#xA;&#xA;foreach (var match in matchedPairs)&#xA;{&#xA;    Console.WriteLine($&quot;Matched: GL Ref: {match.GLRow[&quot;Transaction Ref No:&quot;]}, Posted C_PAN: {match.PostedRow[&quot;C_PAN&quot;]}, Amount: {GetDebitCreditAmount(match.GLRow):F2}&quot;);&#xA;}&#xA;&#xA;// === Clone and Move Matched Rows ===&#xA;&#xA;var glRowsToRemove = matchedPairs.Select(m =&gt; m.GLRow).Distinct().ToList();&#xA;var postedRowsToRemove = matchedPairs.Select(m =&gt; m.PostedRow).Distinct().ToList();&#xA;&#xA;// Clone before removal&#xA;foreach (var row in glRowsToRemove)&#xA;{&#xA;    DataRow newRow = dtGlStatementMatched.NewRow();&#xA;    newRow.ItemArray = row.ItemArray.Clone() as object[];&#xA;    dtGlStatementMatched.Rows.Add(newRow);&#xA;}&#xA;&#xA;foreach (var row in postedRowsToRemove)&#xA;{&#xA;    DataRow newRow = dtPostedTransactionDetailsMatched.NewRow();&#xA;    newRow.ItemArray = row.ItemArray.Clone() as object[];&#xA;    dtPostedTransactionDetailsMatched.Rows.Add(newRow);&#xA;}&#xA;&#xA;// Remove original rows safely&#xA;foreach (var row in glRowsToRemove)&#xA;    dtGlStatement.Rows.Remove(row);&#xA;&#xA;foreach (var row in postedRowsToRemove)&#xA;    dtPostedTransactionDetails.Rows.Remove(row);&#xA;&#xA;// Accept changes&#xA;dtGlStatement.AcceptChanges();&#xA;dtPostedTransactionDetails.AcceptChanges();&#xA;&#xA;// === Logs After Matching ===&#xA;&#xA;Console.WriteLine(&quot;\n=== Summary After Matching ===&quot;);&#xA;Console.WriteLine($&quot;Remaining GL rows: {dtGlStatement.Rows.Count}&quot;);&#xA;Console.WriteLine($&quot;Remaining Posted rows: {dtPostedTransactionDetails.Rows.Count}&quot;);&#xA;Console.WriteLine($&quot;Moved to Matched GL: {glRowsToRemove.Count}&quot;);&#xA;Console.WriteLine($&quot;Moved to Matched Posted: {postedRowsToRemove.Count}\n&quot;);&#xA;&#xA;Console.WriteLine(&quot;✅ Matching Completed Successfully.&quot;);&#xA;" DisplayName="AGT1, AGT2, CRDP, CCSR VS FUND TRANSFER" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_26" Language="CSharp">

        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ——— Helpers ———&#xA;void EnsureColumnExists(DataTable table, string columnName, Type columnType)&#xA;{&#xA;    if (!table.Columns.Contains(columnName))&#xA;        table.Columns.Add(columnName, columnType);&#xA;}&#xA;&#xA;void AddRequiredColumns(DataTable table)&#xA;{&#xA;    var cols = new[] {&#xA;        &quot;C_PAN&quot;, &quot;Search Key&quot;, &quot;Terminal ID&quot;, &quot;Trace Audit Number&quot;,&#xA;        &quot;Reference Number&quot;, &quot;Authorization Number&quot;, &quot;C_NARRATION&quot;, &quot;Narration&quot;,&#xA;        &quot;Transaction Ref No:&quot;, &quot;Debit&quot;, &quot;Credit&quot;, &quot;Balance&quot;,&#xA;        &quot;Related Account&quot;, &quot;Instr No&quot;, &quot;Booking Date&quot;, &quot;Value Date&quot;,&#xA;        &quot;STAN&quot;, &quot;RRN&quot;, &quot;EXTRACTED_TERMINAL_ID&quot;, &quot;AUTHORIZATION_NUMBER&quot;&#xA;    };&#xA;    foreach (var c in cols)&#xA;        EnsureColumnExists(table, c, typeof(string));&#xA;}&#xA;&#xA;string NormalizeMaskedCardNumber(string narration)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(narration)) return &quot;&quot;;&#xA;&#xA;    var binMatch = Regex.Match(narration, @&quot;\b(537985|536830|518236)([*xX0]{6})(\d{4})\b&quot;);&#xA;&#xA;    if (binMatch.Success)&#xA;    {&#xA;        string bin = binMatch.Groups[1].Value;&#xA;        string suffix = binMatch.Groups[3].Value;&#xA;        return Regex.Replace(narration, $@&quot;\b{bin}([*xX0]{{6}}){suffix}\b&quot;, $&quot;{bin}XXXXXX{suffix}&quot;);&#xA;    }&#xA;&#xA;    return narration;&#xA;}&#xA;&#xA;string ExtractC_PANFromNarration(string text)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(text)) return &quot;&quot;;&#xA;&#xA;    var m = Regex.Match(text, @&quot;\b(\d{6})[Xx*]{6}(\d{4})\b&quot;);&#xA;    if (m.Success)&#xA;        return $&quot;{m.Groups[1].Value}XXXXXX{m.Groups[2].Value}&quot;;&#xA;&#xA;    m = Regex.Match(text, @&quot;\b\d{16}\b&quot;);&#xA;    if (m.Success)&#xA;    {&#xA;        var pan = m.Value;&#xA;        return pan.Substring(0, 6) + &quot;XXXXXX&quot; + pan.Substring(12, 4);&#xA;    }&#xA;&#xA;    return &quot;&quot;;&#xA;}&#xA;&#xA;string ExtractCNarration(string text)&#xA;{&#xA;    var m = Regex.Match(text, @&quot;(\d{6}XXXXXX\d{4}.*)&quot;);&#xA;    return m.Success ? m.Groups[1].Value : text;&#xA;}&#xA;&#xA;&#xA;(string stan, string rrn, string termId, string auth) ExtractTransactionFields(string narration)&#xA;{&#xA;    var m = Regex.Match(narration, @&quot;(\d{6})[Xx*]{6}(\d{4})\s*-\s*(\w{6})\s*-\s*(\w{1,12})\s*-\s*([A-Za-z0-9]+)&quot;);&#xA;    if (m.Success)&#xA;    {&#xA;        string stan = m.Groups[3].Value;&#xA;        string rrn = m.Groups[4].Value.PadLeft(12, '0');&#xA;        string terminalId = m.Groups[5].Value;&#xA;        return (stan, rrn, terminalId, terminalId);&#xA;    }&#xA;&#xA;    var shortAuth = Regex.Match(narration, @&quot;(\d{6})[Xx*]{6}(\d{4})\s*-\s*(\w{6})\s*Auth:\s*(\w+)&quot;, RegexOptions.IgnoreCase);&#xA;    if (shortAuth.Success)&#xA;        return (shortAuth.Groups[3].Value, &quot;000000000000&quot;, &quot;&quot;, shortAuth.Groups[4].Value);&#xA;&#xA;    var authOnly = Regex.Match(narration, @&quot;Auth:\s*(\w+)&quot;, RegexOptions.IgnoreCase);&#xA;    if (authOnly.Success)&#xA;        return (&quot;&quot;, &quot;000000000000&quot;, &quot;&quot;, authOnly.Groups[1].Value);&#xA;&#xA;    return (&quot;&quot;, &quot;000000000000&quot;, &quot;&quot;, &quot;&quot;);&#xA;}&#xA;&#xA;string CleanAndTrim(string input)&#xA;{&#xA;    return Regex.Replace(input ?? &quot;&quot;, @&quot;\s|[^\u0020-\u007E]&quot;, &quot;&quot;);&#xA;}&#xA;&#xA;string FormatAmount(string amount)&#xA;{&#xA;    if (decimal.TryParse(amount, out decimal val))&#xA;        return val.ToString(&quot;0.00&quot;);&#xA;    return &quot;0.00&quot;;&#xA;}&#xA;&#xA;// ——— Processing ———&#xA;AddRequiredColumns(dtHistoricalReconTransactionsReport);&#xA;&#xA;int totalBefore = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;int proc = 0;&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    var raw = row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;;&#xA;    var norm = NormalizeMaskedCardNumber(raw);&#xA;&#xA;    var pan = ExtractC_PANFromNarration(norm);&#xA;    row[&quot;C_PAN&quot;] = string.IsNullOrEmpty(pan) ? &quot;MISSING_PAN&quot; : pan;&#xA;    row[&quot;C_NARRATION&quot;] = ExtractCNarration(norm);&#xA;&#xA;    var (stan, rrn, termId, auth) = ExtractTransactionFields(norm);&#xA;    rrn = string.IsNullOrEmpty(rrn) ? &quot;000000000000&quot; : rrn.PadLeft(12, '0');&#xA;&#xA;    row[&quot;STAN&quot;] = stan;&#xA;    row[&quot;RRN&quot;] = rrn;&#xA;    row[&quot;EXTRACTED_TERMINAL_ID&quot;] = termId;&#xA;    row[&quot;AUTHORIZATION_NUMBER&quot;] = auth;&#xA;&#xA;    row[&quot;Trace Audit Number&quot;] = stan;&#xA;    row[&quot;Reference Number&quot;] = rrn;&#xA;    row[&quot;Terminal ID&quot;] = termId;&#xA;    row[&quot;Authorization Number&quot;] = auth;&#xA;&#xA;    string amount = !string.IsNullOrWhiteSpace(row[&quot;Debit&quot;]?.ToString()) &amp;&amp; row[&quot;Debit&quot;].ToString() != &quot;0&quot;&#xA;        ? FormatAmount(row[&quot;Debit&quot;].ToString())&#xA;        : FormatAmount(row[&quot;Credit&quot;].ToString());&#xA;&#xA;    string searchKey = CleanAndTrim(pan + rrn + amount);&#xA;    row[&quot;Search Key&quot;] = searchKey;&#xA;&#xA;    proc++;&#xA;}&#xA;&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;&#xA;int missingPanCount = dtHistoricalReconTransactionsReport.AsEnumerable().Count(r =&gt; r[&quot;C_PAN&quot;].ToString() == &quot;MISSING_PAN&quot;);&#xA;&#xA;Console.WriteLine($&quot;✅ Total input rows:       {totalBefore}&quot;);&#xA;Console.WriteLine($&quot;✅ Successfully processed: {proc}&quot;);&#xA;Console.WriteLine($&quot;❌ Rows with MISSING_PAN:  {missingPanCount}&quot;);&#xA;" DisplayName="Extract C_PAN, STAN, RRN, TERMINAL ID" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_100" Language="CSharp">

        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Helpers ===&#xA;&#xA;// Ensure a column exists in a DataTable&#xA;void EnsureColumn(DataTable table, string columnName, Type type)&#xA;{&#xA;    if (!table.Columns.Contains(columnName))&#xA;        table.Columns.Add(columnName, type);&#xA;}&#xA;&#xA;// Clean non-alphanumeric characters from a string&#xA;string CleanCPANAmount(string input)&#xA;{&#xA;    return Regex.Replace(input ?? &quot;&quot;, &quot;[^a-zA-Z0-9]&quot;, &quot;&quot;);&#xA;}&#xA;&#xA;// Get formatted 2-decimal billing amount from Debit/Credit using Math.Abs&#xA;string GetFormattedBillingAmount(DataRow row, string debitCol, string creditCol)&#xA;{&#xA;    decimal amount = 0;&#xA;&#xA;    if (row.Table.Columns.Contains(debitCol) &amp;&amp;&#xA;        row[debitCol] != DBNull.Value &amp;&amp;&#xA;        decimal.TryParse(row[debitCol].ToString(), out decimal debit) &amp;&amp; debit != 0)&#xA;    {&#xA;        amount = Math.Abs(debit);&#xA;    }&#xA;    else if (row.Table.Columns.Contains(creditCol) &amp;&amp;&#xA;             row[creditCol] != DBNull.Value &amp;&amp;&#xA;             decimal.TryParse(row[creditCol].ToString(), out decimal credit) &amp;&amp; credit != 0)&#xA;    {&#xA;        amount = Math.Abs(credit);&#xA;    }&#xA;&#xA;    return amount.ToString(&quot;F2&quot;);&#xA;}&#xA;&#xA;// Format billing amount from &quot;Billing Amount&quot; column with Math.Abs&#xA;string GetFormattedBillingAmountFromBillingAmount(DataRow row)&#xA;{&#xA;    if (decimal.TryParse(row[&quot;Billing Amount&quot;]?.ToString(), out decimal billingAmount))&#xA;        return Math.Abs(billingAmount).ToString(&quot;F2&quot;);&#xA;&#xA;    return &quot;0.00&quot;;&#xA;}&#xA;&#xA;// === Ensure C_PAN_AMOUNT column exists ===&#xA;EnsureColumn(dtGlStatementRefund, &quot;C_PAN_AMOUNT&quot;, typeof(string));&#xA;EnsureColumn(dtPostedTransactionDetails, &quot;C_PAN_AMOUNT&quot;, typeof(string));&#xA;&#xA;// === Filter Data ===&#xA;&#xA;// GL Filter: All rows (could filter BK-related if needed)&#xA;var glFiltered = dtGlStatementRefund.AsEnumerable().ToList();&#xA;&#xA;// POSTED Filter: Transaction Code = &quot;REFUND&quot;&#xA;var postedFiltered = dtPostedTransactionDetails.AsEnumerable()&#xA;    .Where(row =&gt; row[&quot;Transaction Code&quot;].ToString().Equals(&quot;REFUND&quot;, StringComparison.OrdinalIgnoreCase))&#xA;    .ToList();&#xA;&#xA;// === GL: Generate C_PAN_AMOUNT (C_PAN + Formatted Amount) ===&#xA;foreach (var row in glFiltered)&#xA;{&#xA;    string cpan = row[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string amount = GetFormattedBillingAmount(row, &quot;Debit&quot;, &quot;Credit&quot;);&#xA;    row[&quot;C_PAN_AMOUNT&quot;] = CleanCPANAmount(cpan + amount);&#xA;}&#xA;&#xA;// === POSTED: Generate C_PAN_AMOUNT (C_PAN + Billing Amount) ===&#xA;foreach (var row in postedFiltered)&#xA;{&#xA;    string cpan = row[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string amount = GetFormattedBillingAmountFromBillingAmount(row);&#xA;    row[&quot;C_PAN_AMOUNT&quot;] = CleanCPANAmount(cpan + amount);&#xA;}&#xA;&#xA;// === Strict 1-to-1 Matching ===&#xA;&#xA;var matchedPairs = new List&lt;(DataRow GLRow, DataRow PostedRow)&gt;();&#xA;var usedPostedRows = new HashSet&lt;DataRow&gt;();&#xA;&#xA;foreach (var glRow in glFiltered)&#xA;{&#xA;    string glKey = glRow[&quot;C_PAN_AMOUNT&quot;].ToString();&#xA;&#xA;    var match = postedFiltered.FirstOrDefault(postedRow =&gt;&#xA;        !usedPostedRows.Contains(postedRow) &amp;&amp;&#xA;        postedRow[&quot;C_PAN_AMOUNT&quot;].ToString() == glKey);&#xA;&#xA;    if (match != null)&#xA;    {&#xA;        matchedPairs.Add((glRow, match));&#xA;        usedPostedRows.Add(match);&#xA;    }&#xA;}&#xA;&#xA;// === Move matched rows to matched tables ===&#xA;foreach (var pair in matchedPairs)&#xA;{&#xA;    dtGlStatementMatched.ImportRow(pair.GLRow);&#xA;    dtPostedTransactionDetailsMatched.ImportRow(pair.PostedRow);&#xA;&#xA;    dtGlStatementRefund.Rows.Remove(pair.GLRow);&#xA;    dtPostedTransactionDetails.Rows.Remove(pair.PostedRow);&#xA;}&#xA;&#xA;// Accept changes after moving rows&#xA;dtGlStatementRefund.AcceptChanges();&#xA;dtPostedTransactionDetails.AcceptChanges();&#xA;&#xA;// === Log ===&#xA;Console.WriteLine($&quot;✅ Strict 1-to-1 matched pairs: {matchedPairs.Count}&quot;);&#xA;Console.WriteLine($&quot;Remaining GL rows: {dtGlStatementRefund.Rows.Count}&quot;);&#xA;Console.WriteLine($&quot;Remaining Posted rows: {dtPostedTransactionDetails.Rows.Count}&quot;);&#xA;" DisplayName="dtGlStatementRefund VS REFUND PTD" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_25" Language="CSharp">

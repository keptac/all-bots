oreCase))&#xA;    .ToList();&#xA;&#xA;// === GL: Generate C_PAN_AMOUNT (C_PAN + Formatted Amount) ===&#xA;foreach (var row in glFiltered)&#xA;{&#xA;    string cpan = row[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string amount = GetFormattedBillingAmount(row, &quot;Debit&quot;, &quot;Credit&quot;);&#xA;    row[&quot;C_PAN_AMOUNT&quot;] = CleanCPANAmount(cpan + amount);&#xA;}&#xA;&#xA;// === POSTED: Generate C_PAN_AMOUNT (C_PAN + Billing Amount) ===&#xA;foreach (var row in historicalFiltered)&#xA;{&#xA;    string cpan = row[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string amount = GetFormattedBillingAmount(row, &quot;Debit&quot;, &quot;Credit&quot;);&#xA;    row[&quot;C_PAN_AMOUNT&quot;] = CleanCPANAmount(cpan + amount);&#xA;}&#xA;&#xA;// === Strict 1-to-1 Matching ===&#xA;&#xA;var matchedPairs = new List&lt;(DataRow GLRow, DataRow PostedRow)&gt;();&#xA;var usedPostedRows = new HashSet&lt;DataRow&gt;();&#xA;&#xA;foreach (var glRow in glFiltered)&#xA;{&#xA;    string glKey = glRow[&quot;C_PAN_AMOUNT&quot;].ToString();&#xA;&#xA;    var match = historicalFiltered.FirstOrDefault(postedRow =&gt;&#xA;        !usedPostedRows.Contains(postedRow) &amp;&amp;&#xA;        postedRow[&quot;C_PAN_AMOUNT&quot;].ToString() == glKey);&#xA;&#xA;    if (match != null)&#xA;    {&#xA;        matchedPairs.Add((glRow, match));&#xA;        usedPostedRows.Add(match);&#xA;    }&#xA;}&#xA;&#xA;// === Move matched rows to matched tables ===&#xA;// === Move matched rows to matched tables with logging ===&#xA;foreach (var pair in matchedPairs)&#xA;{&#xA;    string glKey = pair.GLRow[&quot;C_PAN_AMOUNT&quot;]?.ToString();&#xA;    string postedKey = pair.PostedRow[&quot;C_PAN_AMOUNT&quot;]?.ToString();&#xA;    string glTxn = pair.GLRow[&quot;Transaction Ref No:&quot;]?.ToString();&#xA;    string postedTxn = pair.PostedRow[&quot;Transaction Ref No:&quot;]?.ToString();&#xA;&#xA;    // Console.WriteLine($&quot;✔ Matched C_PAN_AMOUNT: GL = {glKey} (TxnRef: {glTxn}) ↔ HIST = {postedKey} (TxnRef: {postedTxn})&quot;);&#xA;&#xA;    dtGlStatementMatched.ImportRow(pair.GLRow);&#xA;    dtHistoricalReconTransactionsReportMatched.ImportRow(pair.PostedRow);&#xA;&#xA;    dtGlStatementRefund.Rows.Remove(pair.GLRow);&#xA;    dtHistoricalReconTransactionsReport.Rows.Remove(pair.PostedRow);&#xA;}&#xA;&#xA;&#xA;// Accept changes after moving rows&#xA;dtGlStatementRefund.AcceptChanges();&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;&#xA;// === Log ===&#xA;Console.WriteLine($&quot;✅ Strict 1-to-1 matched pairs: {matchedPairs.Count}&quot;);&#xA;Console.WriteLine($&quot;Remaining GL rows: {dtGlStatementRefund.Rows.Count}&quot;);&#xA;Console.WriteLine($&quot;Remaining HISTORICAL rows: {dtHistoricalReconTransactionsReport.Rows.Count}&quot;);&#xA;" DisplayName="dtGlStatementRefund VS REFUND startsWith Refund HIST" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_50" Language="CSharp">

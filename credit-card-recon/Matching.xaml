        <ui:InvokeCode ContinueOnError="{x:Null}" Code="&#xA;// Helper to normalize and extract a PAN from a narration string&#xA;string ExtractPan(string text)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(text))&#xA;    {&#xA;        Console.WriteLine(&quot;❌ Input text is empty or null.&quot;);&#xA;        return &quot;MISSING_PAN&quot;;&#xA;    }&#xA;&#xA;    Console.WriteLine($&quot;🔍 Processing narration: {text}&quot;);&#xA;&#xA;    // Normalize common masked patterns&#xA;    text = text.Replace(&quot;******&quot;, &quot;XXXXXX&quot;)&#xA;               .Replace(&quot;xxxxxx&quot;, &quot;XXXXXX&quot;)&#xA;               .Replace(&quot;000000&quot;, &quot;XXXXXX&quot;);&#xA;&#xA;    // Match BillNumber segment&#xA;    var billMatch = Regex.Match(text, @&quot;Bill\s*Number\s*:\s*([^\s]+)&quot;, RegexOptions.IgnoreCase);&#xA;    if (billMatch.Success)&#xA;    {&#xA;        string rawSegment = billMatch.Groups[1].Value;&#xA;        Console.WriteLine($&quot;✅ Found BillNumber segment: {rawSegment}&quot;);&#xA;&#xA;        // Split by '!' and scan each part&#xA;        var parts = rawSegment.Split('!', StringSplitOptions.RemoveEmptyEntries);&#xA;        foreach (var part in parts)&#xA;        {&#xA;            // 1. Check for valid masked PAN: 6 digits + XXXXXX + 4 digits&#xA;            var masked = Regex.Match(part, @&quot;^(\d{6})[Xx*]{6}(\d{4})$&quot;);&#xA;            if (masked.Success)&#xA;            {&#xA;                string maskedPan = $&quot;{masked.Groups[1].Value}XXXXXX{masked.Groups[2].Value}&quot;;&#xA;                Console.WriteLine($&quot;✅ Found masked PAN: {maskedPan}&quot;);&#xA;                return maskedPan;&#xA;            }&#xA;&#xA;            // 2. Attempt to repair malformed masked PAN: 5 digits + XXXXXX + 5 digits&#xA;            var brokenMasked = Regex.Match(part, @&quot;^(\d{5})[Xx*]{6}(\d{5})$&quot;);&#xA;            if (brokenMasked.Success)&#xA;            {&#xA;                string fixedPan = $&quot;{brokenMasked.Groups[1].Value}0XXXXXX{brokenMasked.Groups[2].Value.Substring(1, 4)}&quot;;&#xA;                Console.WriteLine($&quot;♻️ Fixed broken masked PAN to: {fixedPan}&quot;);&#xA;                return fixedPan;&#xA;            }&#xA;&#xA;            // 3. Raw 16-digit PAN&#xA;            var digits = Regex.Replace(part, @&quot;\D&quot;, &quot;&quot;);&#xA;            if (digits.Length == 16)&#xA;            {&#xA;                string formatted = digits.Substring(0, 6) + &quot;XXXXXX&quot; + digits.Substring(12, 4);&#xA;                Console.WriteLine($&quot;✅ Found raw PAN: {formatted}&quot;);&#xA;                return formatted;&#xA;            }&#xA;&#xA;            Console.WriteLine($&quot;⚠️ Skipped part '{part}' — not valid masked or raw PAN.&quot;);&#xA;        }&#xA;&#xA;        Console.WriteLine(&quot;❌ No valid PAN found in BillNumber parts.&quot;);&#xA;    }&#xA;    else&#xA;    {&#xA;        Console.WriteLine(&quot;❌ BillNumber pattern not matched.&quot;);&#xA;    }&#xA;&#xA;    return &quot;MISSING_PAN&quot;;&#xA;}&#xA;&#xA;&#xA;&#xA;// Count how many rows still need a PAN&#xA;int CountMissing(DataTable tbl) =&gt;&#xA;    tbl.AsEnumerable()&#xA;       .Count(r =&gt; {&#xA;           var p = r[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xA;           return string.IsNullOrWhiteSpace(p) || p == &quot;MISSING_PAN&quot;;&#xA;       });&#xA;&#xA;// --- Main logic ---&#xA;int before = CountMissing(dtHistoricalReconTransactionsReport);&#xA;int processed = 0;&#xA;int missingPanCount = 0;&#xA;&#xA;Console.WriteLine($&quot;ℹ️ Initial rows needing PAN: {before}&quot;);&#xA;&#xA;// Filter rows where C_PAN is &quot;MISSING_PAN&quot;&#xA;var rowsToProcess = dtHistoricalReconTransactionsReport.AsEnumerable()&#xA;                                  .Where(r =&gt; r[&quot;C_PAN&quot;]?.ToString() == &quot;MISSING_PAN&quot;);&#xA;&#xA;foreach (DataRow row in rowsToProcess)&#xA;{&#xA;    var narration = row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;;&#xA;    Console.WriteLine($&quot;🔄 Row #{processed + 1} — Original Narration: {narration}&quot;);&#xA;&#xA;    var pan = ExtractPan(narration);&#xA;&#xA;    if (!string.IsNullOrEmpty(pan) &amp;&amp; pan != &quot;MISSING_PAN&quot;)&#xA;    {&#xA;        row[&quot;C_PAN&quot;] = pan;&#xA;        Console.WriteLine($&quot;✅ C_PAN updated to: {pan}&quot;);&#xA;    }&#xA;    else&#xA;    {&#xA;        Console.WriteLine(&quot;❌ Could not extract valid PAN.&quot;);&#xA;        missingPanCount++;&#xA;    }&#xA;&#xA;    processed++;&#xA;}&#xA;&#xA;// Commit changes&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;&#xA;// Output how many rows were updated&#xA;updatedCount = processed - missingPanCount;&#xA;&#xA;Console.WriteLine($&quot;✅ Total processed: {processed}&quot;);&#xA;Console.WriteLine($&quot;✅ Updated: {updatedCount}&quot;);&#xA;Console.WriteLine($&quot;❌ Still missing PAN: {missingPanCount}&quot;);&#xA;" DisplayName="Extract C_PAN for BillNumber:" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_99" Language="CSharp">

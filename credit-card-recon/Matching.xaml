      <ui:InvokeCode ContinueOnError="{x:Null}" Code="void EnsureColumns(DataTable table, string tableName, string sourceValue = &quot;&quot;)&#xA;{&#xA;    if (table == null)&#xA;    {&#xA;        Console.WriteLine($&quot;Error: The DataTable {tableName} is null.&quot;);&#xA;        throw new ArgumentNullException($&quot;{tableName} is null&quot;);&#xA;    }&#xA;&#xA;    // Columns with specific types and default values&#xA;    var columnsToEnsure = new Dictionary&lt;string, (Type type, object defaultValue)&gt;&#xA;    {&#xA;        { &quot;MATCH&quot;, (typeof(bool), false) },&#xA;        { &quot;GROUP_MATCHED&quot;, (typeof(bool), false) },&#xA;        { &quot;usonus&quot;, (typeof(bool), false) },&#xA;        { &quot;source&quot;, (typeof(string), string.Empty) },&#xA;        { &quot;C_PAN_AMOUNT&quot;, (typeof(string), string.Empty) },&#xA;        { &quot;C_PAN_AUTHORIZATION_NUMBER&quot;, (typeof(string), string.Empty) },&#xA;        { &quot;RRN_GROUP&quot;, (typeof(string), string.Empty) }&#xA;    };&#xA;&#xA;    foreach (var col in columnsToEnsure)&#xA;    {&#xA;        if (!table.Columns.Contains(col.Key))&#xA;        {&#xA;            table.Columns.Add(col.Key, col.Value.type);&#xA;            table.Columns[col.Key].DefaultValue = col.Value.defaultValue;&#xA;        }&#xA;    }&#xA;&#xA;    // Reconciliation report-specific columns (all treated as strings)&#xA;    string[] reportColumns = new[]&#xA;    {&#xA;        &quot;Narration&quot;, &quot;Aging&quot;, &quot;Aging Group&quot;, &quot;BOT Classification&quot;,&#xA;        &quot;Root Cause&quot;, &quot;Root Cause Category&quot;, &quot;Recommended Action&quot;, &quot;Action Owner&quot;,&#xA;        &quot;SNO&quot;, &quot;Branch code&quot;, &quot;GL_Code&quot;, &quot;GL Description&quot;,&#xA;        &quot;Booking Date&quot;, &quot;Value Date&quot;, &quot;Transaction Ref No:&quot;&#xA;    };&#xA;&#xA;    foreach (var columnName in reportColumns)&#xA;    {&#xA;        if (!table.Columns.Contains(columnName))&#xA;        {&#xA;            table.Columns.Add(columnName, typeof(string));&#xA;            table.Columns[columnName].DefaultValue = string.Empty;&#xA;        }&#xA;    }&#xA;&#xA;    // Set the &quot;source&quot; column value for existing rows, if provided&#xA;    if (!string.IsNullOrEmpty(sourceValue) &amp;&amp; table.Columns.Contains(&quot;source&quot;))&#xA;    {&#xA;        foreach (DataRow row in table.Rows)&#xA;        {&#xA;            row[&quot;source&quot;] = sourceValue;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;&#xA;EnsureColumns(dtGlStatement, &quot;dtGlStatement&quot;, &quot;GL&quot;);&#xA;EnsureColumns(dtPostedTransactionDetails, &quot;dtPostedTransactionDetails&quot;, &quot;CMS&quot;);&#xA;EnsureColumns(dtHistoricalReconTransactionsReport, &quot;dtHistoricalReconTransactionsReport&quot;, &quot;HIST&quot;);&#xA;&#xA;dtGlStatementMatched = dtGlStatement.Clone();&#xA;dtGlStatementLatePostedTxn = dtGlStatement.Clone();&#xA;dtHistoricalReconTransactionsReportMatched = dtHistoricalReconTransactionsReport.Clone();&#xA;&#xA;Console.WriteLine($&quot;INITIAL dtPostedTransactionDetails Row Count: {dtPostedTransactionDetails?.Rows.Count ?? 0}&quot;);&#xA;Console.WriteLine($&quot;INITIAL dtGlStatement Row Count: {dtGlStatement?.Rows.Count ?? 0}&quot;);&#xA;Console.WriteLine($&quot;INITIAL dtHistoricalReconTransactionsReport Row Count: {dtHistoricalReconTransactionsReport?.Rows.Count ?? 0}&quot;);&#xA;" DisplayName="Add Column MATCH to all datatables" sap:VirtualizedContainerService.HintSize="478.4,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_3" Language="CSharp">

 amount = credit;&#xA;            return amount;&#xA;        }), 2),&#xA;        Rows = g.ToList()&#xA;    })&#xA;    .ToList();&#xA;&#xA;// --- Debug Log: Print Grouped Totals ---&#xA;Console.WriteLine(&quot;=== AutoPayment Groups ===&quot;);&#xA;foreach (var g in autoPaymentGroups)&#xA;    Console.WriteLine($&quot;Auto Date: {g.Date:dd-MM-yyyy}, Total: {g.Total:N2}&quot;);&#xA;&#xA;Console.WriteLine(&quot;=== CCDD Groups ===&quot;);&#xA;foreach (var g in ccddGroups)&#xA;    Console.WriteLine($&quot;CCDD Date: {g.Date:dd-MM-yyyy}, Total: {g.Total:N2}&quot;);&#xA;&#xA;// --- Match groups by absolute total match (ignore sign), compare to 2 decimal places ---&#xA;var matchedGroups = new List&lt;(List&lt;DataRow&gt; autoRows, List&lt;DataRow&gt; ccddRows, decimal amount)&gt;();&#xA;&#xA;foreach (var autoGroup in autoPaymentGroups)&#xA;{&#xA;    var match = ccddGroups.FirstOrDefault(ccdd =&gt;&#xA;        Math.Abs(ccdd.Total) == Math.Abs(autoGroup.Total)); // ✅ OPTION 1&#xA;&#xA;    if (match != null)&#xA;    {&#xA;        matchedGroups.Add((autoGroup.Rows, match.Rows, autoGroup.Total));&#xA;        ccddGroups.Remove(match); // Prevent duplicate matches&#xA;    }&#xA;}&#xA;&#xA;// --- Move matched grouped rows ---&#xA;foreach (var match in matchedGroups)&#xA;{&#xA;    foreach (var row in match.autoRows)&#xA;    {&#xA;        dtPostedTransactionDetailsMatched.ImportRow(row);&#xA;        dtAutoPaymentThankYou.Rows.Remove(row);&#xA;    }&#xA;&#xA;    foreach (var row in match.ccddRows)&#xA;    {&#xA;        dtGlStatementMatched.ImportRow(row);&#xA;        dtCCDD.Rows.Remove(row);&#xA;    }&#xA;}&#xA;&#xA;// --- Accept Changes ---&#xA;dtAutoPaymentThankYou.AcceptChanges();&#xA;dtCCDD.AcceptChanges();&#xA;dtPostedTransactionDetailsMatched.AcceptChanges();&#xA;dtGlStatementMatched.AcceptChanges();&#xA;&#xA;// --- Final Result Log ---&#xA;decimal totalMatchedAuto = Math.Round(matchedGroups.Sum(g =&gt; g.amount), 2);&#xA;decimal totalMatchedCCDD = Math.Round(matchedGroups.Sum(g =&gt; g.amount), 2); // same&#xA;&#xA;int totalAutoRows = matchedGroups.Sum(g =&gt; g.autoRows.Count);&#xA;int totalCCDDRows = matchedGroups.Sum(g =&gt; g.ccddRows.Count);&#xA;&#xA;Console.WriteLine($&quot;✅ Moved {totalAutoRows} rows from dtAutoPaymentThankYou totaling: {totalMatchedAuto:N2}&quot;);&#xA;Console.WriteLine($&quot;✅ Moved {totalCCDDRows} rows from dtCCDD totaling: {totalMatchedCCDD:N2}&quot;);&#xA;&#xA;if (totalMatchedAuto == totalMatchedCCDD)&#xA;{&#xA;    Console.WriteLine(&quot;✅ Grouped totals match perfectly!&quot;);&#xA;}&#xA;else&#xA;{&#xA;    Console.WriteLine($&quot;⚠️ Grouped totals mismatch: AutoPayment = {totalMatchedAuto:N2}, CCDD = {totalMatchedCCDD:N2}&quot;);&#xA;}&#xA;" DisplayName="PTD AUTO PAYMENT - THANK YOU VS CCDD, CCAR" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_45" Language="CSharp">

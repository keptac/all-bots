              <ui:InvokeCode ContinueOnError="{x:Null}" Code="For Each row As DataRow In dtPostedTransactionDetails.Rows&#xA;    ' Check if Merchant column is null or empty&#xA;    If IsDBNull(row(&quot;Merchant&quot;)) OrElse String.IsNullOrWhiteSpace(row(&quot;Merchant&quot;).ToString()) Then&#xA;        Continue For ' Skip this row&#xA;    End If&#xA;&#xA;    ' Extract Merchant value&#xA;    Dim merchant As String = row(&quot;Merchant&quot;).ToString()&#xA;&#xA;    ' Pattern to extract card number (C_PAN), handling ******, 000000, XXXXXX&#xA;    Dim cardNumberPattern As String = &quot;\b\d{6}(?:\*{6}|0{6}|X{6})\d{4}\b&quot;&#xA;    Dim cardNumberMatch As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(merchant, cardNumberPattern)&#xA;&#xA;    ' If card number extraction is successful&#xA;    If cardNumberMatch.Success Then&#xA;        ' Replace masked portion with XXXXXX&#xA;        Dim newC_PAN As String = System.Text.RegularExpressions.Regex.Replace(cardNumberMatch.Value, &quot;(?:\*{6}|0{6}|X{6})&quot;, &quot;XXXXXX&quot;)&#xA;&#xA;        ' Check if C_PAN is already set and only update if it's different&#xA;        Dim existingC_PAN As String = If(IsDBNull(row(&quot;C_PAN&quot;)), &quot;&quot;, row(&quot;C_PAN&quot;).ToString())&#xA;&#xA;        If String.IsNullOrEmpty(existingC_PAN) OrElse existingC_PAN &lt;&gt; newC_PAN Then&#xA;            row(&quot;C_PAN&quot;) = newC_PAN ' Update C_PAN&#xA;&#xA;            ' Optional: Log the new C_PAN value&#xA;            Console.WriteLine($&quot;New C_PAN: {newC_PAN}&quot;)&#xA;        End If&#xA;&#xA;        ' Generate Search Key&#xA;        Dim billingAmount As String = row(&quot;Billing Amount&quot;).ToString()&#xA;&#xA;        ' Ensure Billing Amount is to 2 decimal places&#xA;        Dim billingAmountFormatted As String = String.Format(&quot;{0:F2}&quot;, Convert.ToDecimal(billingAmount))&#xA;&#xA;        ' Create the raw Search Key&#xA;        Dim rawSearchKey As String = $&quot;{row(&quot;C_PAN&quot;)}-{billingAmountFormatted}&quot;&#xA;&#xA;        ' Make Search Key alphanumeric-only&#xA;        Dim alphanumericSearchKey As String = System.Text.RegularExpressions.Regex.Replace(rawSearchKey, &quot;[^a-zA-Z0-9]&quot;, &quot;&quot;)&#xA;&#xA;        ' Update Search Key&#xA;        row(&quot;Search Key&quot;) = alphanumericSearchKey&#xA;&#xA;        ' Optional: Log the new Search Key value&#xA;        Console.WriteLine($&quot;New Search Key: {alphanumericSearchKey}&quot;)&#xA;    Else&#xA;        ' Skip rows without a valid card pattern&#xA;        Continue For&#xA;    End If&#xA;Next&#xA;" DisplayName="update C_PAN" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_17">

        <ui:InvokeCode ContinueOnError="{x:Null}" Code="int initialRowCount = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;int processedRowCount = 0;&#xA;&#xA;// Filter rows with C_PAN == &quot;MISSING_PAN&quot;&#xA;var missingPanRows = dtHistoricalReconTransactionsReport.AsEnumerable()&#xA;    .Where(row =&gt; row.Field&lt;string&gt;(&quot;C_PAN&quot;) == &quot;MISSING_PAN&quot;)&#xA;    .ToList();  // Ensure single enumeration&#xA;&#xA;for (int i = 0; i &lt; missingPanRows.Count; i++)&#xA;{&#xA;    DataRow row = missingPanRows[i];&#xA;&#xA;    try&#xA;    {&#xA;        string narration = row.Field&lt;string&gt;(&quot;Narration&quot;)?.Trim() ?? string.Empty;&#xA;        string cleanedNarration = narration.Replace(&quot; &quot;, &quot;&quot;).Replace(&quot;-&quot;, &quot;&quot;);&#xA;&#xA;        // Console.WriteLine($&quot;Original Narration: {narration}, Cleaned Narration: {cleanedNarration}&quot;);&#xA;&#xA;        // Try to extract card starting with &quot;53&quot; and has at least 16 digits after it&#xA;        int startPosition = cleanedNarration.IndexOf(&quot;53&quot;);&#xA;        if (startPosition &gt;= 0 &amp;&amp; cleanedNarration.Length &gt;= startPosition + 16)&#xA;        {&#xA;            string first6 = cleanedNarration.Substring(startPosition, 6);&#xA;            string last4 = cleanedNarration.Substring(startPosition + 12, 4); // Last 4 of 16-digit&#xA;&#xA;            string cPan = $&quot;{first6}XXXXXX{last4}&quot;;&#xA;            row[&quot;C_PAN&quot;] = cPan;&#xA;&#xA;            // Console.WriteLine($&quot;Special case handled: C_PAN = {cPan}&quot;);&#xA;            processedRowCount++;&#xA;        }&#xA;        else&#xA;        {&#xA;            Console.WriteLine(startPosition == -1 &#xA;                ? &quot;Cleaned narration does not contain '53'.&quot; &#xA;                : &quot;Not enough characters to extract full card digits.&quot;);&#xA;        }&#xA;    }&#xA;    catch (Exception ex)&#xA;    {&#xA;        Console.WriteLine($&quot;Error processing row: {ex.Message}&quot;);&#xA;    }&#xA;}&#xA;&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;&#xA;// Summary&#xA;Console.WriteLine(&quot;Special case processing completed, changes saved.&quot;);&#xA;Console.WriteLine($&quot;Total rows before: {initialRowCount}&quot;);&#xA;Console.WriteLine($&quot;Total rows processed for C_PAN update: {processedRowCount}&quot;);&#xA;Console.WriteLine($&quot;Total rows after: {dtHistoricalReconTransactionsReport.Rows.Count}&quot;);&#xA;" DisplayName="C_PAN for special cases" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_101" Language="CSharp">

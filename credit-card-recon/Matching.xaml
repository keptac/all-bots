Match || creditMatch);&#xA;    });&#xA;&#xA;    if (matchingGl != null &amp;&amp; !rowsToDeleteHistorical.Contains(hisRow) &amp;&amp; !rowsToDeleteGl.Contains(matchingGl))&#xA;    {&#xA;        decimal.TryParse(matchingGl[&quot;Debit&quot;]?.ToString(), out decimal debitGl);&#xA;        decimal.TryParse(matchingGl[&quot;Credit&quot;]?.ToString(), out decimal creditGl);&#xA;&#xA;        if (debitHis + debitGl == 0 &amp;&amp; creditHis + creditGl == 0)&#xA;        {&#xA;            dtReversalsGl.ImportRow(hisRow);&#xA;            dtReversalsGl.ImportRow(matchingGl);&#xA;&#xA;            rowsToDeleteHistorical.Add(hisRow);&#xA;            rowsToDeleteGl.Add(matchingGl);&#xA;&#xA;            LogMatch(&quot;HIST→GL&quot;, txnRef, debitHis, creditHis, debitGl, creditGl);&#xA;            matchedPairCount++;&#xA;            totalMatchedDebit += debitHis + debitGl;&#xA;            totalMatchedCredit += creditHis + creditGl;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Third pass: Safely delete marked rows ===&#xA;foreach (var row in rowsToDeleteGl)&#xA;{&#xA;    try&#xA;    {&#xA;        dtGlStatement.Rows.Remove(row);&#xA;        removedRowsCount++;&#xA;    }&#xA;    catch (Exception ex)&#xA;    {&#xA;        Console.WriteLine($&quot;❌ Error removing from dtGlStatement: {ex.Message}&quot;);&#xA;    }&#xA;}&#xA;&#xA;foreach (var row in rowsToDeleteHistorical)&#xA;{&#xA;    try&#xA;    {&#xA;        dtHistoricalReconTransactionsReport.Rows.Remove(row);&#xA;        removedRowsCount++;&#xA;    }&#xA;    catch (Exception ex)&#xA;    {&#xA;        Console.WriteLine($&quot;❌ Error removing from dtHistoricalReconTransactionsReport: {ex.Message}&quot;);&#xA;    }&#xA;}&#xA;&#xA;// === Final log ===&#xA;Console.WriteLine($&quot;✅ Total Matched Pairs: {matchedPairCount}&quot;);&#xA;Console.WriteLine($&quot;✅ Total Rows Removed: {removedRowsCount}&quot;);&#xA;Console.WriteLine($&quot;✅ Total Matched Debit: {totalMatchedDebit}&quot;);&#xA;Console.WriteLine($&quot;✅ Total Matched Credit
    <TryCatch sap2010:Annotation.AnnotationText="A mail problem is logged rather than thrown, so the job result still reflects the update." DisplayName="Email the update result" sap:VirtualizedContainerService.HintSize="460,340" sap2010:WorkflowViewState.IdRef="TryCatch_1">

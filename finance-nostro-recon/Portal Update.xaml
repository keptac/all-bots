      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception" sap:VirtualizedContainerService.HintSize="400,23.2" sap2010:WorkflowViewState.IdRef="Catch`1_1">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="mailEx" />
            </ActivityAction.Argument>
            <ui:LogMessage DisplayName="Log mail failure" sap:VirtualizedContainerService.HintSize="380,110" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Warn" Message="[&quot;Could not send the portal update email: &quot; + mailEx.Message]" />
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>
    <If Condition="[updateExit = 1]" DisplayName="Fail the job if the update failed" sap:VirtualizedContainerService.HintSize="460,200" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Throw DisplayName="Throw update failure" Exception="[New Exception(&quot;Portal update failed.&quot; + Environment.NewLine + updateLog)]" sap:VirtualizedContainerService.HintSize="400,92" sap2010:WorkflowViewState.IdRef="Throw_1" />
      </If.Then>
    </If>
  </Sequence>

  <Sequence sap2010:Annotation.AnnotationText="Runs only when Main's PORTAL_UPDATE is True, instead of the reconciliation. Copies portal.html and api.aspx from this package to the live portal through PORTAL_SHARE (never web.config), keeps the old files as .bak, then checks the live page." DisplayName="Portal Update" sap:VirtualizedContainerService.HintSize="500,700" sap2010:WorkflowViewState.IdRef="Sequence_1">

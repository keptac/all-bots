      <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim fmts As String() = {&quot;yyyy-MM-dd&quot;, &quot;dd-MMM-yyyy&quot;, &quot;dd/MM/yyyy&quot;, &quot;yyyyMMdd&quot;}&#xA;Dim inv As System.Globalization.CultureInfo = System.Globalization.CultureInfo.InvariantCulture&#xA;&#xA;' End of the window: in_StatementDate, or the previous day when it is blank.&#xA;' A run on day D reconciles value date D-1 - overnight statements for yesterday&#xA;' are what arrive for today's run, which is why the recon produced on 20-Oct is&#xA;' labelled 19-Oct.&#xA;Dim endDate As DateTime&#xA;If String.IsNullOrWhiteSpace(in_StatementDate) Then&#xA;    endDate = DateTime.Today.AddDays(-1)&#xA;ElseIf Not DateTime.TryParseExact(in_StatementDate.Trim(), fmts, inv, System.Globalization.DateTimeStyles.None, endDate) Then&#xA;    Throw New ArgumentException(&quot;in_StatementDate is not a recognised date (expected yyyy-MM-dd, dd-MMM-yyyy, dd/MM/yyyy or yyyyMMdd): &quot; &amp; in_StatementDate)&#xA;End If&#xA;endDate = endDate.Date&#xA;&#xA;' Start of the window: in_StartDate when given, otherwise the single end day.&#xA;Dim startDate As DateTime = endDate&#xA;If Not String.IsNullOrWhiteSpace(in_StartDate) Then&#xA;    If Not DateTime.TryParseExact(in_StartDate.Trim(), fmts, inv, System.Globalization.DateTimeStyles.None, startDate) Then&#xA;        Throw New ArgumentException(&quot;in_StartDate is not a recognised date (expected yyyy-MM-dd, dd-MMM-yyyy, dd/MM/yyyy or yyyyMMdd): &quot; &amp; in_StartDate)&#xA;    End If&#xA;    startDate = startDate.Date&#xA;    If startDate &gt; endDate Then&#xA;        Throw New ArgumentException(&quot;in_StartDate (&quot; &amp; startDate.ToString(&quot;dd-MMM-yyyy&quot;, inv) &amp; &quot;) is after the end of the window (&quot; &amp; endDate.ToString(&quot;dd-MMM-yyyy&quot;, inv) &amp; &quot;).&quot;)&#xA;    End If&#xA;End If&#xA;&#xA;' Statements for value date D land on D+1: the 20-Oct files arrive on the 21st,&#xA;' the 21-Oct files on the 22nd. So a file's timestamp is one lag behind its value&#xA;' date and has to be shifted before it is compared to the window. A date written&#xA;' into the path is already the value date and needs no shift.&#xA;Dim lag As Integer = in_ArrivalLagDays&#xA;If lag &lt; 0 OrElse lag &gt; 10 Then&#xA;    Throw New ArgumentException(&quot;in_ArrivalLagDays must be between 0 and 10, got &quot; &amp; lag.ToString())&#xA;End If&#xA;&#xA;Dim spanDays As Integer = CInt((endDate - startDate).TotalDays) + 1&#xA;If spanDays &gt; 400 Then&#xA;    Throw New ArgumentException(&quot;Requested window is &quot; &amp; spanDays.ToString() &amp; &quot; days; refusing to stage more than 400 days at once.&quot;)&#xA;End If&#xA;&#xA;' Filename date tokens for every day in the window, so a statement written&#xA;' outside its own value date is still picked up.&#xA;Dim tokenFmts As String() = {&quot;yyyyMMdd&quot;, &quot;yyyy-MM-dd&quot;, &quot;dd-MM-yyyy&quot;, &quot;ddMMyyyy&quot;, &quot;dd-MMM-yyyy&quot;, &quot;ddMMMyyyy&quot;, &quot;dd.MM.yyyy&quot;}&#xA;Dim tokens As New HashSet(Of String)()&#xA;Dim d As DateTime = startDate&#xA;While d &lt;= endDate&#xA;    For Each t As String In tokenFmts&#xA;        tokens.Add(d.ToString(t, inv).ToUpperInvariant())&#xA;    Next&#xA;    d = d.AddDays(1)&#xA;End While&#xA;&#xA;Dim shares As New List(Of KeyValuePair(Of String, String))()&#xA;shares.Add(New KeyValuePair(Of String, String)(&quot;SWIFT&quot;, in_SwiftPath))&#xA;shares.Add(New KeyValuePair(Of String, String)(&quot;SWIFTDETAIL&quot;, in_SwiftDetailPath))&#xA;shares.Add(New KeyValuePair(Of String, String)(&quot;SWIFTMX&quot;, in_SwiftMxPath))&#xA;shares.Add(New KeyValuePair(Of String, String)(&quot;CBS&quot;, in_CbsPath))&#xA;&#xA;' ---------------------------------------------------------------- archive ---&#xA;'  The shares only ever hold the latest batch: each day's files replace the&#xA;'  previous day's.  So before anything is staged, everything on each share is&#xA;'  COPIED into ARCHIVE_PATH\&lt;share&gt;, and staging then reads from the archive.&#xA;'  A day whose files have since vanished from the share can still be re-run&#xA;'  with STATEMENT_DATE, and pages that arrive a day late are kept.&#xA;'&#xA;'  The shares are only ever read - nothing here moves, renames or deletes a&#xA;'  file on them.  The archive is never cleared:&#xA;'    - a file already archived with the same size and timestamp is skipped;&#xA;'    - a file that changed on the share under the same name is kept as an&#xA;'      extra version, name~v2.ext, ~v3 ..., never overwriting the earlier one;&#xA;'    - created and modified times are copied from the share, because staging&#xA;'      picks a day's files by those times and a plain copy would stamp them&#xA;'      with today.&#xA;'  ARCHIVE_PATH blank switches the archive off and stages from the shares.&#xA;' ----------------------------------------------------------------------------&#xA;Dim Overlaps = Function(a As String, b As String) As Boolean&#xA;                   Dim p1 As String = a.TrimEnd(&quot;\&quot;c) &amp; &quot;\&quot;&#xA;                   Dim p2 As String = b.TrimEnd(&quot;\&quot;c) &amp; &quot;\&quot;&#xA;                   Return p1.StartsWith(p2, StringComparison.OrdinalIgnoreCase) OrElse p2.StartsWith(p1, StringComparison.OrdinalIgnoreCase)&#xA;               End Function&#xA;Dim SameAs = Function(p As String, other As FileInfo) As Boolean&#xA;                 If Not File.Exists(p) Then Return False&#xA;                 Dim mine As New FileInfo(p)&#xA;                 Return mine.Length = other.Length AndAlso mine.LastWriteTimeUtc = other.LastWriteTimeUtc&#xA;             End Function&#xA;Dim versionRx As New System.Text.RegularExpressions.Regex(&quot;~v\d+(?=\.[^.\\]*$|$)&quot;)&#xA;&#xA;Dim archiveRoot As String = If(in_ArchivePath, &quot;&quot;).Trim().TrimEnd(&quot;\&quot;c)&#xA;If archiveRoot.Length &gt; 0 Then&#xA;    archiveRoot = Path.GetFullPath(archiveRoot)&#xA;    For Each kv As KeyValuePair(Of String, String) In shares&#xA;        Dim s As String = If(kv.Value, &quot;&quot;).Trim()&#xA;        If s.Length &gt; 0 AndAlso Overlaps(archiveRoot, Path.GetFullPath(s)) Then&#xA;            Throw New ArgumentException(&quot;ARCHIVE_PATH (&quot; &amp; archiveRoot &amp; &quot;) overlaps the &quot; &amp; kv.Key &amp; &quot; share (&quot; &amp; s &amp; &quot;). The archive must be a separate folder of our own.&quot;)&#xA;        End If&#xA;    Next&#xA;    If Overlaps(archiveRoot, Path.GetFullPath(in_LocalRoot)) Then&#xA;        Throw New ArgumentException(&quot;ARCHIVE_PATH (&quot; &amp; archiveRoot &amp; &quot;) overlaps LOCAL_STAGING_PATH (&quot; &amp; in_LocalRoot &amp; &quot;), which is cleared on every run.&quot;)&#xA;    End If&#xA;End If&#xA;&#xA;Dim locals As New Dictionary(Of String, String)()&#xA;Dim counts As New Dictionary(Of String, Integer)()&#xA;Dim seenCounts As New Dictionary(Of String, Integer)()&#xA;Dim sb As New System.Text.StringBuilder()&#xA;sb.AppendLine(If(archiveRoot.Length &gt; 0, &quot;Archive: &quot; &amp; archiveRoot, &quot;Archive: OFF (ARCHIVE_PATH is blank) - staging straight from the shares&quot;))&#xA;&#xA;For Each kv As KeyValuePair(Of String, String) In shares&#xA;    Dim name As String = kv.Key&#xA;    Dim src As String = If(kv.Value, &quot;&quot;).Trim().TrimEnd(&quot;\&quot;c)&#xA;    Dim dest As String = Path.Combine(in_LocalRoot, name)&#xA;&#xA;    locals(name) = dest&#xA;    counts(name) = 0&#xA;    seenCounts(name) = 0&#xA;&#xA;    ' Clear the whole tree, not just its top level: the recon reads these folders&#xA;    ' recursively (ForEachFileX IncludeSubDirectories, SearchOption.AllDirectories),&#xA;    ' so a stale file in a subfolder would be reconciled a second time.&#xA;    If Directory.Exists(dest) Then&#xA;        Try&#xA;            Directory.Delete(dest, True)&#xA;        Catch ex As Exception&#xA;            sb.AppendLine(name &amp; &quot;: could not clear &quot; &amp; dest &amp; &quot; - &quot; &amp; ex.Message)&#xA;        End Try&#xA;    End If&#xA;    Directory.CreateDirectory(dest)&#xA;&#xA;    ' Recurse: the share groups files in subfolders and every consumer of these&#xA;    ' paths descends into them, so staging has to as well.&#xA;    Dim shareFull As String = &quot;&quot;&#xA;    Dim shareFiles As String() = New String() {}&#xA;    If src.Length = 0 OrElse Not Directory.Exists(src) Then&#xA;        sb.AppendLine(name &amp; &quot;: source folder not available -&gt; &quot; &amp; src)&#xA;    Else&#xA;        Try&#xA;            shareFull = Path.GetFullPath(src)&#xA;            shareFiles = Directory.GetFiles(shareFull, &quot;*&quot;, SearchOption.AllDirectories)&#xA;        Catch ex As Exception&#xA;            sb.AppendLine(name &amp; &quot;: could not list &quot; &amp; src &amp; &quot; - &quot; &amp; ex.Message)&#xA;            shareFull = &quot;&quot;&#xA;        End Try&#xA;    End If&#xA;    ' What is on the share NOW drives the &quot;files present but none dated&quot; checks&#xA;    ' below, exactly as before the archive existed.&#xA;    seenCounts(name) = shareFiles.Length&#xA;&#xA;    Dim stageFrom As String = shareFull&#xA;    If archiveRoot.Length &gt; 0 Then&#xA;        Dim arch As String = Path.Combine(archiveRoot, name)&#xA;        Try&#xA;            Directory.CreateDirectory(arch)&#xA;            Dim added As Integer = 0&#xA;            Dim versions As Integer = 0&#xA;            Dim same As Integer = 0&#xA;            For Each f As String In shareFiles&#xA;                Try&#xA;                    Dim fi As New FileInfo(f)&#xA;                    Dim target As String = Path.Combine(arch, f.Substring(shareFull.Length).TrimStart(&quot;\&quot;c))&#xA;                    If SameAs(target, fi) Then&#xA;                        same += 1&#xA;                        Continue For&#xA;                    End If&#xA;                    Dim outPath As String = target&#xA;                    If File.Exists(target) Then&#xA;                        ' Same name, different content: keep both.&#xA;                        Dim v As Integer = 2&#xA;                        Dim already As Boolean = False&#xA;                        Do&#xA;                            outPath = Path.Combine(Path.GetDirectoryName(target), Path.GetFileNameWithoutExtension(target) &amp; &quot;~v&quot; &amp; v.ToString() &amp; Path.GetExtension(target))&#xA;                            If Not File.Exists(outPath) Then Exit Do&#xA;                            If SameAs(outPath, fi) Then&#xA;                                already = True&#xA;                                Exit Do&#xA;                            End If&#xA;                            v += 1&#xA;                        Loop&#xA;                        If already Then&#xA;                            same += 1&#xA;                            Continue For&#xA;                        End If&#xA;                        versions += 1&#xA;                    Else&#xA;                        added += 1&#xA;                    End If&#xA;                    Directory.CreateDirectory(Path.GetDirectoryName(outPath))&#xA;                    File.Copy(f, outPath, False)&#xA;                    File.SetCreationTimeUtc(outPath, fi.CreationTimeUtc)&#xA;                    File.SetLastWriteTimeUtc(outPath, fi.LastWriteTimeUtc)&#xA;                Catch ex As Exception&#xA;                    sb.AppendLine(name &amp; &quot;: could not archive &quot; &amp; Path.GetFileName(f) &amp; &quot; - &quot; &amp; ex.Message)&#xA;                End Try&#xA;            Next&#xA;            sb.AppendLine(name &amp; &quot;: archived &quot; &amp; added.ToString() &amp; &quot; new, &quot; &amp; versions.ToString() &amp; &quot; changed (kept as new versions), &quot; &amp; same.ToString() &amp; &quot; already archived&quot;)&#xA;            stageFrom = arch&#xA;        Catch ex As Exception&#xA;            sb.AppendLine(name &amp; &quot;: ARCHIVE FAILED - &quot; &amp; ex.Message &amp; &quot; - staging straight from the share instead&quot;)&#xA;        End Try&#xA;    End If&#xA;&#xA;    If stageFrom.Length = 0 Then Continue For&#xA;&#xA;    ' Newest first, so the sample below shows what arrived most recently and,&#xA;    ' when the archive holds several versions of one file, the newest wins.&#xA;    Dim candidates As List(Of FileInfo) = Directory.GetFiles(stageFrom, &quot;*&quot;, SearchOption.AllDirectories) _&#xA;        .Select(Function(p) New FileInfo(p)).OrderByDescending(Function(z) z.LastWriteTimeUtc).ToList()&#xA;    Dim picked As New Dictionary(Of String, KeyValuePair(Of FileInfo, String))(StringComparer.OrdinalIgnoreCase)&#xA;    Dim samples As New List(Of String)()&#xA;    For Each fi As FileInfo In candidates&#xA;        Dim rel As String = fi.FullName.Substring(stageFrom.Length).TrimStart(&quot;\&quot;c)&#xA;&#xA;        ' Either timestamp can carry the statement date: a file copied onto the&#xA;        ' share keeps its original LastWriteTime, while one written in place does&#xA;        ' not, so neither alone is reliable.&#xA;        Dim wrote As DateTime = fi.LastWriteTime.Date.AddDays(-lag)&#xA;        Dim made As DateTime = fi.CreationTime.Date.AddDays(-lag)&#xA;        Dim takeIt As Boolean = (wrote &gt;= startDate AndAlso wrote &lt;= endDate) OrElse (made &gt;= startDate AndAlso made &lt;= endDate)&#xA;        If Not takeIt Then&#xA;            ' Test the whole relative path, not just the file name: the share may&#xA;            ' date the folder rather than the file.&#xA;            Dim upper As String = rel.ToUpperInvariant()&#xA;            For Each tok As String In tokens&#xA;                If upper.Contains(tok) Then&#xA;                    takeIt = True&#xA;                    Exit For&#xA;                End If&#xA;            Next&#xA;        End If&#xA;        If samples.Count &lt; 5 Then&#xA;            samples.Add(rel &amp; &quot;  [written &quot; &amp; fi.LastWriteTime.ToString(&quot;dd-MMM-yyyy HH:mm&quot;, inv) &amp; &quot; -&gt; value date &quot; &amp; wrote.ToString(&quot;dd-MMM-yyyy&quot;, inv) &amp; &quot;, created &quot; &amp; fi.CreationTime.ToString(&quot;dd-MMM-yyyy HH:mm&quot;, inv) &amp; &quot; -&gt; &quot; &amp; made.ToString(&quot;dd-MMM-yyyy&quot;, inv) &amp; &quot;]&quot;)&#xA;        End If&#xA;        If takeIt Then&#xA;            ' One version of a file per value date - a statement re-sent under the&#xA;            ' same name must not be reconciled twice.&#xA;            Dim baseRel As String = versionRx.Replace(rel, &quot;&quot;)&#xA;            Dim key As String = baseRel &amp; &quot;|&quot; &amp; wrote.ToString(&quot;yyyyMMdd&quot;, inv)&#xA;            If Not picked.ContainsKey(key) Then picked(key) = New KeyValuePair(Of FileInfo, String)(fi, baseRel)&#xA;        End If&#xA;    Next&#xA;&#xA;    For Each pk As KeyValuePair(Of FileInfo, String) In picked.Values&#xA;        Try&#xA;            ' Keep the path relative to the source. Flattening would let two&#xA;            ' files of the same name in different subfolders overwrite each&#xA;            ' other, losing a statement silently.&#xA;            Dim outPath As String = Path.Combine(dest, pk.Value)&#xA;            If File.Exists(outPath) Then outPath = Path.Combine(dest, pk.Key.FullName.Substring(stageFrom.Length).TrimStart(&quot;\&quot;c))&#xA;            Dim n As Integer = 2&#xA;            While File.Exists(outPath)&#xA;                outPath = Path.Combine(dest, Path.GetDirectoryName(pk.Value), Path.GetFileNameWithoutExtension(pk.Value) &amp; &quot;~s&quot; &amp; n.ToString() &amp; Path.GetExtension(pk.Value))&#xA;                n += 1&#xA;            End While&#xA;            Dim outDir As String = Path.GetDirectoryName(outPath)&#xA;            If Not String.IsNullOrEmpty(outDir) Then Directory.CreateDirectory(outDir)&#xA;            File.Copy(pk.Key.FullName, outPath, False)&#xA;            counts(name) = counts(name) + 1&#xA;        Catch ex As Exception&#xA;            sb.AppendLine(name &amp; &quot;: copy failed for &quot; &amp; pk.Key.Name &amp; &quot; - &quot; &amp; ex.Message)&#xA;        End Try&#xA;    Next&#xA;&#xA;    sb.AppendLine(name &amp; &quot;: staged &quot; &amp; counts(name).ToString() &amp; &quot; file(s) from &quot; &amp; stageFrom &amp; &quot; (&quot; &amp; seenCounts(name).ToString() &amp; &quot; on the share now: &quot; &amp; src &amp; &quot;)&quot;)&#xA;    ' The silent killer: files are there but none carry the window's date, so the&#xA;    ' standard looks absent and its accounts reconcile against nothing.&#xA;    If seenCounts(name) &gt; 0 AndAlso counts(name) = 0 Then&#xA;        sb.AppendLine(name &amp; &quot;: WARNING - &quot; &amp; seenCounts(name).ToString() &amp; &quot; file(s) present but none dated in the window. Most recent files:&quot;)&#xA;        For Each s As String In samples&#xA;            sb.AppendLine(&quot;    &quot; &amp; s)&#xA;        Next&#xA;        sb.AppendLine(&quot;    (looked for these date tokens in the path: &quot; &amp; String.Join(&quot;, &quot;, tokens.OrderBy(Function(z) z).Take(8)) &amp; &quot; ...)&quot;)&#xA;    End If&#xA;Next&#xA;&#xA;' ---------------------------------------------------------- missing pages ---&#xA;'  Pages that never reached the share are downloaded by hand and uploaded on the&#xA;'  Nostro portal (finance has no access to the servers), which saves them into&#xA;'  in_ManualPagesPath\&lt;share&gt; (Missing Pages\SWIFTMX, \SWIFT, \SWIFTDETAIL).&#xA;'  Every file there goes into this run whatever its date: a hand download is&#xA;'  stamped with the day it was saved, so the date rules above would skip it.&#xA;'&#xA;'  Nothing is moved here. Main moves the files to Missing Pages\Processed only&#xA;'  once the reports are written, so a run that fails leaves them in place and&#xA;'  the next run tries again. out_ManualPages lists them for that move, one line&#xA;'  per file: KIND|share|source path|length|last write UTC ticks|note, where KIND&#xA;'  is STAGED (note = staged name), DUPLICATE (note = the staged file it repeats)&#xA;'  or UNUSED (note = why).&#xA;'&#xA;'  The statement readers do not descend into subfolders, so manual pages are&#xA;'  staged flat beside the share's files. A page identical to one already staged&#xA;'  is not staged again - it arrived on the share after all.&#xA;' ----------------------------------------------------------------------------&#xA;Dim manualLines As New List(Of String)()&#xA;Dim manualRoot As String = If(in_ManualPagesPath, &quot;&quot;).Trim().TrimEnd(&quot;\&quot;c)&#xA;If manualRoot.Length &gt; 0 Then&#xA;    manualRoot = Path.GetFullPath(manualRoot)&#xA;    Dim manualClash As String = &quot;&quot;&#xA;    If Overlaps(manualRoot, Path.GetFullPath(in_LocalRoot)) Then manualClash = &quot;LOCAL_STAGING_PATH (&quot; &amp; in_LocalRoot &amp; &quot;), which is cleared on every run&quot;&#xA;    If archiveRoot.Length &gt; 0 AndAlso Overlaps(manualRoot, archiveRoot) Then manualClash = &quot;ARCHIVE_PATH (&quot; &amp; archiveRoot &amp; &quot;)&quot;&#xA;    For Each mkv As KeyValuePair(Of String, String) In shares&#xA;        Dim mShare As String = If(mkv.Value, &quot;&quot;).Trim()&#xA;        If mShare.Length &gt; 0 AndAlso Overlaps(manualRoot, Path.GetFullPath(mShare)) Then manualClash = &quot;the &quot; &amp; mkv.Key &amp; &quot; share (&quot; &amp; mShare &amp; &quot;)&quot;&#xA;    Next&#xA;&#xA;    If manualClash.Length &gt; 0 Then&#xA;        sb.AppendLine(&quot;MISSING PAGES: drop folder &quot; &amp; manualRoot &amp; &quot; overlaps &quot; &amp; manualClash &amp; &quot; - manual pages were NOT staged.&quot;)&#xA;    Else&#xA;        ' Which extension each standard's reader picks up.&#xA;        Dim manualShares As New Dictionary(Of String, String)()&#xA;        manualShares.Add(&quot;SWIFTMX&quot;, &quot;.xml&quot;)&#xA;        manualShares.Add(&quot;SWIFT&quot;, &quot;.txt&quot;)&#xA;        manualShares.Add(&quot;SWIFTDETAIL&quot;, &quot;.txt&quot;)&#xA;&#xA;        Dim IsJunk = Function(jf As FileInfo) As Boolean&#xA;                         Dim jn As String = jf.Name.ToLowerInvariant()&#xA;                         Return jn = &quot;thumbs.db&quot; OrElse jn = &quot;desktop.ini&quot; OrElse jn.StartsWith(&quot;~$&quot;) OrElse jn.StartsWith(&quot;.&quot;) _&#xA;                             OrElse jn.EndsWith(&quot;.tmp&quot;) OrElse jn.EndsWith(&quot;.crdownload&quot;) OrElse jn.EndsWith(&quot;.partial&quot;) _&#xA;                             OrElse (jf.Attributes And FileAttributes.Hidden) = FileAttributes.Hidden&#xA;                     End Function&#xA;        Dim HashOf = Function(hp As String) As String&#xA;                         Using sha As System.Security.Cryptography.SHA256 = System.Security.Cryptography.SHA256.Create()&#xA;                             Using hs As New FileStream(hp, FileMode.Open, FileAccess.Read, FileShare.Read)&#xA;                                 Return BitConverter.ToString(sha.ComputeHash(hs))&#xA;                             End Using&#xA;                         End Using&#xA;                     End Function&#xA;        Dim Stamp = Function(sf As FileInfo) As String&#xA;                        Return sf.Length.ToString(inv) &amp; &quot;|&quot; &amp; sf.LastWriteTimeUtc.Ticks.ToString(inv)&#xA;                    End Function&#xA;&#xA;        ' The robot creates the folders, so finance only ever has to drop files in.&#xA;        Try&#xA;            For Each ms As String In manualShares.Keys&#xA;                Directory.CreateDirectory(Path.Combine(manualRoot, ms))&#xA;            Next&#xA;            Directory.CreateDirectory(Path.Combine(manualRoot, &quot;Processed&quot;))&#xA;        Catch ex As Exception&#xA;            sb.AppendLine(&quot;MISSING PAGES: could not create the drop folders under &quot; &amp; manualRoot &amp; &quot; - &quot; &amp; ex.Message)&#xA;        End Try&#xA;&#xA;        ' A file at the top of the drop folder has no standard, so it is reported&#xA;        ' rather than guessed at. upload-log.csv is the portal's record of who&#xA;        ' uploaded what.&#xA;        Try&#xA;            If Directory.Exists(manualRoot) Then&#xA;                For Each tf As String In Directory.GetFiles(manualRoot)&#xA;                    Dim tfi As New FileInfo(tf)&#xA;                    If IsJunk(tfi) OrElse tfi.Name.Equals(&quot;upload-log.csv&quot;, StringComparison.OrdinalIgnoreCase) Then Continue For&#xA;                    manualLines.Add(&quot;UNUSED|-|&quot; &amp; tf &amp; &quot;|&quot; &amp; Stamp(tfi) &amp; &quot;|it is not in the SWIFTMX, SWIFT or SWIFTDETAIL folder&quot;)&#xA;                Next&#xA;            End If&#xA;        Catch ex As Exception&#xA;            sb.AppendLine(&quot;MISSING PAGES: could not list &quot; &amp; manualRoot &amp; &quot; - &quot; &amp; ex.Message)&#xA;        End Try&#xA;&#xA;        For Each mkv As KeyValuePair(Of String, String) In manualShares&#xA;            Dim drop As String = Path.Combine(manualRoot, mkv.Key)&#xA;            Dim mDest As String = locals(mkv.Key)&#xA;            If Not Directory.Exists(drop) Then Continue For&#xA;            Dim dropped As String() = New String() {}&#xA;            Try&#xA;                dropped = Directory.GetFiles(drop, &quot;*&quot;, SearchOption.AllDirectories)&#xA;            Catch ex As Exception&#xA;                sb.AppendLine(&quot;MISSING PAGES: could not list &quot; &amp; drop &amp; &quot; - &quot; &amp; ex.Message)&#xA;                Continue For&#xA;            End Try&#xA;&#xA;            Dim used As Integer = 0&#xA;            Dim repeats As Integer = 0&#xA;            Dim stagedHashes As Dictionary(Of String, String) = Nothing&#xA;            For Each mf As String In dropped.OrderBy(Function(z) z, StringComparer.OrdinalIgnoreCase)&#xA;                Dim mfi As New FileInfo(mf)&#xA;                If IsJunk(mfi) Then Continue For&#xA;                If Not mfi.Extension.Equals(mkv.Value, StringComparison.OrdinalIgnoreCase) Then&#xA;                    manualLines.Add(&quot;UNUSED|&quot; &amp; mkv.Key &amp; &quot;|&quot; &amp; mf &amp; &quot;|&quot; &amp; Stamp(mfi) &amp; &quot;|only &quot; &amp; mkv.Value &amp; &quot; files are read from &quot; &amp; mkv.Key &amp; If(mfi.Extension.Equals(&quot;.zip&quot;, StringComparison.OrdinalIgnoreCase), &quot; - unzip it into the folder&quot;, &quot;&quot;))&#xA;                    Continue For&#xA;                End If&#xA;                If mfi.Length = 0 Then&#xA;                    manualLines.Add(&quot;UNUSED|&quot; &amp; mkv.Key &amp; &quot;|&quot; &amp; mf &amp; &quot;|&quot; &amp; Stamp(mfi) &amp; &quot;|the file is empty&quot;)&#xA;                    Continue For&#xA;                End If&#xA;                Try&#xA;                    If stagedHashes Is Nothing Then&#xA;                        stagedHashes = New Dictionary(Of String, String)()&#xA;                        For Each sf As String In Directory.GetFiles(mDest)&#xA;                            Dim sh As String = HashOf(sf)&#xA;                            If Not stagedHashes.ContainsKey(sh) Then stagedHashes.Add(sh, Path.GetFileName(sf))&#xA;                        Next&#xA;                    End If&#xA;                    Dim mHash As String = HashOf(mf)&#xA;                    If stagedHashes.ContainsKey(mHash) Then&#xA;                        manualLines.Add(&quot;DUPLICATE|&quot; &amp; mkv.Key &amp; &quot;|&quot; &amp; mf &amp; &quot;|&quot; &amp; Stamp(mfi) &amp; &quot;|&quot; &amp; stagedHashes(mHash))&#xA;                        repeats += 1&#xA;                        Continue For&#xA;                    End If&#xA;&#xA;                    Dim mOut As String = Path.Combine(mDest, mfi.Name)&#xA;                    Dim mn As Integer = 2&#xA;                    While File.Exists(mOut)&#xA;                        mOut = Path.Combine(mDest, Path.GetFileNameWithoutExtension(mfi.Name) &amp; &quot;~m&quot; &amp; mn.ToString() &amp; mfi.Extension)&#xA;                        mn += 1&#xA;                    End While&#xA;                    File.Copy(mf, mOut, False)&#xA;                    stagedHashes.Add(mHash, Path.GetFileName(mOut))&#xA;                    counts(mkv.Key) = counts(mkv.Key) + 1&#xA;                    used += 1&#xA;                    manualLines.Add(&quot;STAGED|&quot; &amp; mkv.Key &amp; &quot;|&quot; &amp; mf &amp; &quot;|&quot; &amp; Stamp(mfi) &amp; &quot;|&quot; &amp; Path.GetFileName(mOut))&#xA;&#xA;                    ' Archived under MANUAL, which staging never reads, so a re-run of an&#xA;                    ' earlier day is not changed by pages that were added later.&#xA;                    If archiveRoot.Length &gt; 0 Then&#xA;                        Try&#xA;                            Dim mArch As String = Path.Combine(archiveRoot, &quot;MANUAL&quot;, mkv.Key, DateTime.Today.ToString(&quot;yyyy-MM-dd&quot;, inv))&#xA;                            Directory.CreateDirectory(mArch)&#xA;                            Dim ap As String = Path.Combine(mArch, mfi.Name)&#xA;                            Dim av As Integer = 2&#xA;                            While File.Exists(ap) AndAlso Not SameAs(ap, mfi)&#xA;                                ap = Path.Combine(mArch, Path.GetFileNameWithoutExtension(mfi.Name) &amp; &quot;~v&quot; &amp; av.ToString() &amp; mfi.Extension)&#xA;                                av += 1&#xA;                            End While&#xA;                            If Not File.Exists(ap) Then&#xA;                                File.Copy(mf, ap, False)&#xA;                                File.SetCreationTimeUtc(ap, mfi.CreationTimeUtc)&#xA;                                File.SetLastWriteTimeUtc(ap, mfi.LastWriteTimeUtc)&#xA;                            End If&#xA;                        Catch ex As Exception&#xA;                            sb.AppendLine(&quot;MISSING PAGES: could not archive &quot; &amp; mfi.Name &amp; &quot; - &quot; &amp; ex.Message)&#xA;                        End Try&#xA;                    End If&#xA;                Catch ex As Exception&#xA;                    sb.AppendLine(&quot;MISSING PAGES: could not stage &quot; &amp; mf &amp; &quot; - &quot; &amp; ex.Message)&#xA;                End Try&#xA;            Next&#xA;            If used &gt; 0 OrElse repeats &gt; 0 Then&#xA;                sb.AppendLine(&quot;MISSING PAGES: &quot; &amp; mkv.Key &amp; &quot; staged &quot; &amp; used.ToString() &amp; &quot; hand-downloaded file(s) from &quot; &amp; drop &amp; If(repeats &gt; 0, &quot;, &quot; &amp; repeats.ToString() &amp; &quot; already on the share&quot;, &quot;&quot;))&#xA;            End If&#xA;        Next&#xA;        Dim unusedCount As Integer = manualLines.Where(Function(z) z.StartsWith(&quot;UNUSED|&quot;)).Count()&#xA;        If unusedCount &gt; 0 Then sb.AppendLine(&quot;MISSING PAGES: &quot; &amp; unusedCount.ToString() &amp; &quot; file(s) in &quot; &amp; manualRoot &amp; &quot; were not used - see the run email.&quot;)&#xA;    End If&#xA;End If&#xA;out_ManualPages = String.Join(vbLf, manualLines)&#xA;&#xA;' Both standards can land on the same day while the migration runs, so neither&#xA;' excludes the other - each chain runs for whatever arrived.&#xA;out_HasIso = (counts(&quot;SWIFTMX&quot;) &gt; 0)&#xA;out_HasLegacy = (counts(&quot;SWIFT&quot;) &gt; 0)&#xA;out_SwiftMxFolderPath = locals(&quot;SWIFTMX&quot;)&#xA;out_SwiftFolderPath = locals(&quot;SWIFT&quot;)&#xA;out_SwiftDetailedFolderPath = locals(&quot;SWIFTDETAIL&quot;)&#xA;out_LedgerFolderPath = locals(&quot;CBS&quot;)&#xA;&#xA;If startDate = endDate Then&#xA;    sb.AppendLine(&quot;Statement date: &quot; &amp; endDate.ToString(&quot;dd-MMM-yyyy&quot;, inv) &amp; &quot;  (expecting files to have arrived &quot; &amp; lag.ToString() &amp; &quot; day(s) later)&quot;)&#xA;Else&#xA;    sb.AppendLine(&quot;Statement window: &quot; &amp; startDate.ToString(&quot;dd-MMM-yyyy&quot;, inv) &amp; &quot; to &quot; &amp; endDate.ToString(&quot;dd-MMM-yyyy&quot;, inv) &amp; &quot; (&quot; &amp; spanDays.ToString() &amp; &quot; days)&quot;)&#xA;End If&#xA;&#xA;Dim standards As New List(Of String)()&#xA;If out_HasIso Then standards.Add(&quot;ISO 20022 (SWIFTMX)&quot;)&#xA;If out_HasLegacy Then standards.Add(&quot;Legacy (SWIFT + SWIFTDETAIL)&quot;)&#xA;sb.AppendLine(&quot;Standards to process: &quot; &amp; If(standards.Count = 0, &quot;none&quot;, String.Join(&quot; + &quot;, standards)))&#xA;out_FetchSummary = sb.ToString()&#xA;Console.WriteLine(out_FetchSummary)&#xA;&#xA;Dim window As String = If(startDate = endDate, endDate.ToString(&quot;dd-MMM-yyyy&quot;, inv), startDate.ToString(&quot;dd-MMM-yyyy&quot;, inv) &amp; &quot; to &quot; &amp; endDate.ToString(&quot;dd-MMM-yyyy&quot;, inv))&#xA;If counts(&quot;CBS&quot;) = 0 Then&#xA;    Throw New Exception(&quot;No CBS/ledger files for &quot; &amp; window &amp; &quot; - reconciliation cannot run.&quot; &amp; Environment.NewLine &amp; out_FetchSummary)&#xA;End If&#xA;If Not out_HasIso AndAlso Not out_HasLegacy Then&#xA;    Throw New Exception(&quot;No SWIFT statement files for &quot; &amp; window &amp; &quot; in either SWIFTMX or SWIFT.&quot; &amp; Environment.NewLine &amp; out_FetchSummary)&#xA;End If&#xA;&#xA;' One standard staging nothing while the other staged files is how nine camt&#xA;' accounts silently reconciled against an empty statement set: the run looks&#xA;' successful and reports the whole ledger balance as the difference. If files&#xA;' exist but none matched the window, that is a date problem, not an empty day.&#xA;If Not out_HasIso AndAlso seenCounts(&quot;SWIFTMX&quot;) &gt; 0 Then&#xA;    Throw New Exception(&quot;SWIFTMX holds &quot; &amp; seenCounts(&quot;SWIFTMX&quot;).ToString() &amp; &quot; file(s) but none dated &quot; &amp; window &amp; &quot;, so the ISO 20022 accounts would reconcile against nothing. Fix the dates or set STATEMENT_DATE explicitly.&quot; &amp; Environment.NewLine &amp; out_FetchSummary)&#xA;End If&#xA;If Not out_HasLegacy AndAlso seenCounts(&quot;SWIFT&quot;) &gt; 0 Then&#xA;    Throw New Exception(&quot;SWIFT holds &quot; &amp; seenCounts(&quot;SWIFT&quot;).ToString() &amp; &quot; file(s) but none dated &quot; &amp; window &amp; &quot;, so the legacy accounts would reconcile against nothing. Fix the dates or set STATEMENT_DATE explicitly.&quot; &amp; Environment.NewLine &amp; out_FetchSummary)&#xA;End If&#xA;If out_HasLegacy AndAlso counts(&quot;SWIFTDETAIL&quot;) = 0 Then&#xA;    Console.WriteLine(&quot;WARNING: legacy statements present with no SWIFTDETAIL files - detailed transactions will be missing.&quot;)&#xA;End If&#xA;" DisplayName="Archive the shares and stage statements" sap:VirtualizedContainerService.HintSize="600,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_1"><ui:InvokeCode.Arguments><InArgument x:TypeArguments="x:String" x:Key="in_SwiftPath">[in_SwiftPath]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_SwiftDetailPath">[in_SwiftDetailPath]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_SwiftMxPath">[in_SwiftMxPath]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_CbsPath">[in_CbsPath]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_LocalRoot">[in_LocalRoot]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_StatementDate">[in_StatementDate]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_StartDate">[in_StartDate]</InArgument><InArgument x:TypeArguments="x:Int32" x:Key="in_ArrivalLagDays">[in_ArrivalLagDays]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_ArchivePath">[in_ArchivePath]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_ManualPagesPath">[in_ManualPagesPath]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="out_SwiftFolderPath">[out_SwiftFolderPath]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="out_SwiftDetailedFolderPath">[out_SwiftDetailedFolderPath]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="out_SwiftMxFolderPath">[out_SwiftMxFolderPath]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="out_LedgerFolderPath">[out_LedgerFolderPath]</OutArgument><OutArgument x:TypeArguments="x:Boolean" x:Key="out_HasIso">[out_HasIso]</OutArgument><OutArgument x:TypeArguments="x:Boolean" x:Key="out_HasLegacy">[out_HasLegacy]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="out_FetchSummary">[out_FetchSummary]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="out_ManualPages">[out_ManualPages]</OutArgument></ui:InvokeCode.Arguments></ui:InvokeCode>

     Dim taxCdtrId As String = txDtls?.SelectSingleNode(&quot;c:Tax/c:Cdtr/c:TaxId&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim taxTtlAmt As String = txDtls?.SelectSingleNode(&quot;c:Tax/c:TtlTaxAmt&quot;, nsmgr)?.InnerText&#xD;&#xA;&#xD;&#xA;        ' --- Additional Transaction Info ---&#xD;&#xA;        Dim addtlTxInf As String = txDtls?.SelectSingleNode(&quot;c:AddtlTxInf&quot;, nsmgr)?.InnerText&#xD;&#xA;&#xD;&#xA;        ' --- Derived, so the recon report can use the agreed column names directly ---&#xD;&#xA;        Dim txPrtryCd  As String = txDtls?.SelectSingleNode(&quot;c:BkTxCd/c:Prtry/c:Cd&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim txnType    As String = (If(txPrtryCd, &quot;&quot;) &amp; &quot; &quot; &amp; If(bkTxPrtryCd, &quot;&quot;)).Trim()&#xD;&#xA;        Dim narrative  As String = (If(dbtrOrgBIC, &quot;&quot;) &amp; &quot; &quot; &amp; If(cdtrOrgBIC, &quot;&quot;)).Trim()&#xD;&#xA;        If narrative.Length = 0 Then narrative = If(addtlNtryInf, &quot;&quot;)&#xD;&#xA;&#xD;&#xA;        ' ===== Add Row =====&#xD;&#xA;        dtExtract.Rows.Add(&#xD;&#xA;            stmtId, stmtCreDtTm, stmtFrDt, stmtToDt, legalSeq, elctSeq, pgNb, lastPg,&#xD;&#xA;            acctIBAN, acctOthr, acctCcy, acctNm, acctBIC,&#xD;&#xA;            opnAmt, opnCcy, opnDrCr, opnDt,&#xD;&#xA;            clsAmt, clsCcy, clsDrCr, clsDt,&#xD;&#xA;            avlAmt, avlCcy, avlDt,&#xD;&#xA;            ntryRef, amount, ntryCcy, drcr, debit, credit, rvslInd, sts, bookgDt, valDt, acctSvcrRef,&#xD;&#xA;            bkTxDomn, bkTxFmly, bkTxSubFmly, bkTxPrtryCd, bkTxPrtryIs,&#xD;&#xA;            instdAmt, instdAmtCcy, txAmt, txAmtCcy, cntrAmt, cntrAmtCcy,&#xD;&#xA;            chrgsTtl, chrgsAmt, chrgsDrCr,&#xD;&#xA;            addtlNtryInf,&#xD;&#xA;            refsMsgId, refsAcctSvcr, refsPmtInfId, refsInstrId, refsE2EId, refsTxId, refsUETR,&#xD;&#xA;            refsMndtId, refsChqNb, refsClrSys, refsPrcgId, refsPrtryTp, refsPrtryRef,&#xD;&#xA;            txDtlsAmt, txDtlsAmtCcy, tx
    <ui:InvokeCode ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="Extracts the transactions from the swift file and outputs a datatable" Code="' === INPUT: Multiple XML file paths ===&#xD;&#xA;Dim xmlFilePaths As String() = Directory.GetFiles(statementsFolder, &quot;*.xml&quot;)&#xD;&#xA;&#xD;&#xA;' === OUTPUT: Comprehensive DataTable ===&#xD;&#xA;Dim dtExtract As New DataTable()&#xD;&#xA;&#xD;&#xA;' --- Statement Header ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Statement Id&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Statement Creation Date Time&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Statement From Date&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Statement To Date&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Legal Sequence Number&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Electronic Sequence Number&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Page Number&quot;, GetType(Integer))&#xD;&#xA;dtExtract.Columns.Add(&quot;Last Page Indicator&quot;)&#xD;&#xA;&#xD;&#xA;' --- Statement Account ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Account IBAN&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Account Number&quot;) 'Account Other Id&#xD;&#xA;dtExtract.Columns.Add(&quot;Currency&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Account Name&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Narration&quot;) 'Account Servicer BIC&#xD;&#xA;&#xD;&#xA;' --- Balances ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Opening Balance&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Opening Balance Currency&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Opening Balance Credit Debit Indicator&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Opening Balance Date&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Closing Balance&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Closing Balance Currency&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Closing Balance Credit Debit Indicator&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Closing Balance Date&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Available Balance Amount&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Available Balance Currency&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Available Balance Date&quot;)&#xD;&#xA;&#xD;&#xA;' --- Entry Core ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Entry Reference&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Entry Amount&quot;, GetType(Double))&#xD;&#xA;dtExtract.Columns.Add(&quot;Entry Currency&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Credit Debit Indicator&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Debit&quot;, GetType(Double))&#xD;&#xA;dtExtract.Columns.Add(&quot;Credit&quot;, GetType(Double))&#xD;&#xA;dtExtract.Columns.Add(&quot;Reversal Indicator&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Entry Status&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Booking Date&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Value Date&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Account Servicer Reference&quot;)&#xD;&#xA;&#xD;&#xA;' --- Entry Bank Transaction Code ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Bank Transaction Domain Code&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Bank Transaction Family Code&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Bank Transaction Sub Family Code&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Bank Transaction Proprietary Code&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Bank Transaction Proprietary Issuer&quot;)&#xD;&#xA;&#xD;&#xA;' --- Entry Amount Details ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Instructed Amount&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Instructed Amount Currency&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Transaction Amount&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Transaction Amount Currency&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Counter Value Amount&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Counter Value Currency&quot;)&#xD;&#xA;&#xD;&#xA;' --- Entry Charges ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Total Charges And Tax Amount&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Charge Amount&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Charge Credit Debit Indicator&quot;)&#xD;&#xA;&#xD;&#xA;' --- Entry Additional Info ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Additional Entry Information&quot;)&#xD;&#xA;&#xD;&#xA;' --- Transaction References ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Transaction Reference&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Transaction Servicer Reference&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Payment Information Id&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Related Reference (61)&quot;) '&quot;Instruction Id&quot;&#xD;&#xA;dtExtract.Columns.Add(&quot;End To End Id&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Related Reference (21)&quot;)   'Transaction Id&#xD;&#xA;dtExtract.Columns.Add(&quot;UETR&quot;)                    'Unique End-to-end Transaction Reference&#xD;&#xA;dtExtract.Columns.Add(&quot;Mandate Id&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Cheque Number&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Clearing System Reference&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Processing Id&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Proprietary Reference Type&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Proprietary Reference&quot;)&#xD;&#xA;&#xD;&#xA;' --- Transaction Amount Details ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Transaction Details Amount&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Transaction Details Currency&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Transaction Details Credit Debit Indicator&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Transaction Instructed Amount&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Transaction Instructed Amount Currency&quot;)&#xD;&#xA;&#xD;&#xA;' --- Debtor ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Debtor Name&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Debtor Street&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Debtor Town&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Debtor Country&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Debtor Organisation BIC&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Debtor Organisation Other Id&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Debtor Account IBAN&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Debtor Account Other Id&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Ultimate Debtor Name&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Ultimate Debtor Id&quot;)&#xD;&#xA;&#xD;&#xA;' --- Creditor ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Creditor Name&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Creditor Street&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Creditor Town&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Creditor Country&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Creditor Organisation BIC&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Creditor Organisation Other Id&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Creditor Account IBAN&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Creditor Account Other Id&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Ultimate Creditor Name&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Ultimate Creditor Id&quot;)&#xD;&#xA;&#xD;&#xA;' --- Related Agents ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Debtor Agent BIC&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Debtor Agent Name&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Debtor Agent Clearing System Member Id&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Creditor Agent BIC&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Creditor Agent Name&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Creditor Agent Clearing System Member Id&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Intermediary Agent 1 BIC&quot;)&#xD;&#xA;&#xD;&#xA;' --- Purpose &amp; Remittance ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Purpose Code&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Purpose Proprietary&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Remittance Unstructured&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Referred Document Number&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Referred Document Type&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Referred Document Amount&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Creditor Reference Type&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Creditor Reference&quot;)&#xD;&#xA;&#xD;&#xA;' --- Return Information ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Return Original Bank Transaction Code&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Return Reason Code&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Return Reason Proprietary&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Return Additional Information&quot;)&#xD;&#xA;&#xD;&#xA;' --- Related Dates ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Acceptance Date Time&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Interbank Settlement Date&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Transaction Date Time&quot;)&#xD;&#xA;&#xD;&#xA;' --- Tax ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Tax Debtor Id&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Tax Creditor Id&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Total Tax Amount&quot;)&#xD;&#xA;&#xD;&#xA;' --- Additional Transaction Info ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Additional Transaction Information&quot;)&#xD;&#xA;&#xD;&#xA;' --- Source ---&#xD;&#xA;dtExtract.Columns.Add(&quot;Source File&quot;)&#xD;&#xA;dtExtract.Columns.Add(&quot;Transaction Type&quot;)   'TxDtls proprietary code + entry proprietary code&#xD;&#xA;dtExtract.Columns.Add(&quot;Narrative&quot;)          'counterparty BIC pair, falling back to AddtlNtryInf&#xD;&#xA;&#xD;&#xA;' ==========================================&#xD;&#xA;' Helper Function: resolve Dt or DtTm&#xD;&#xA;' ==========================================&#xD;&#xA;Dim GetBalDate As Func(Of XmlNode, XmlNamespaceManager, String) =&#xD;&#xA;    Function(balNode As XmlNode, ns As XmlNamespaceManager) As String&#xD;&#xA;        If balNode Is Nothing Then Return Nothing&#xD;&#xA;        Dim d As String = balNode.SelectSingleNode(&quot;c:Dt/c:Dt&quot;, ns)?.InnerText&#xD;&#xA;        If String.IsNullOrEmpty(d) Then d = balNode.SelectSingleNode(&quot;c:Dt/c:DtTm&quot;, ns)?.InnerText&#xD;&#xA;        Return d&#xD;&#xA;    End Function&#xD;&#xA;&#xD;&#xA;' ==========================================&#xD;&#xA;' Loop through XML files&#xD;&#xA;' ==========================================&#xD;&#xA;For Each xmlFilePath As String In xmlFilePaths&#xD;&#xA;&#xD;&#xA;    Dim doc As New XmlDocument()&#xD;&#xA;    doc.Load(xmlFilePath)&#xD;&#xA;&#xD;&#xA;    Dim nsmgr As New XmlNamespaceManager(doc.NameTable)&#xD;&#xA;    nsmgr.AddNamespace(&quot;c&quot;, &quot;urn:iso:std:iso:20022:tech:xsd:camt.053.001.08&quot;)&#xD;&#xA;&#xD;&#xA;    ' ===== Statement Header =====&#xD;&#xA;    Dim stmtNode    As XmlNode = doc.SelectSingleNode(&quot;//c:Stmt&quot;, nsmgr)&#xD;&#xA;    Dim stmtId      As String = stmtNode?.SelectSingleNode(&quot;c:Id&quot;, nsmgr)?.InnerText&#xD;&#xA;    Dim stmtCreDtTm As String = stmtNode?.SelectSingleNode(&quot;c:CreDtTm&quot;, nsmgr)?.InnerText&#xD;&#xA;    Dim stmtFrDt    As String = stmtNode?.SelectSingleNode(&quot;c:FrToDt/c:FrDtTm&quot;, nsmgr)?.InnerText&#xD;&#xA;    Dim stmtToDt    As String = stmtNode?.SelectSingleNode(&quot;c:FrToDt/c:ToDtTm&quot;, nsmgr)?.InnerText&#xD;&#xA;    Dim legalSeq    As String = stmtNode?.SelectSingleNode(&quot;c:LglSeqNb&quot;, nsmgr)?.InnerText&#xD;&#xA;    Dim elctSeq     As String = stmtNode?.SelectSingleNode(&quot;c:ElctrncSeqNb&quot;, nsmgr)?.InnerText&#xD;&#xA;    Dim pgNb        As String = stmtNode?.SelectSingleNode(&quot;c:StmtPgntn/c:PgNb&quot;, nsmgr)?.InnerText&#xD;&#xA;    Dim lastPg      As String = stmtNode?.SelectSingleNode(&quot;c:StmtPgntn/c:LastPgInd&quot;, nsmgr)?.InnerText&#xD;&#xA;&#xD;&#xA;    ' ===== Statement Account =====&#xD;&#xA;    Dim acctNode As XmlNode = stmtNode?.SelectSingleNode(&quot;c:Acct&quot;, nsmgr)&#xD;&#xA;    Dim acctIBAN As String = acctNode?.SelectSingleNode(&quot;c:Id/c:IBAN&quot;, nsmgr)?.InnerText&#xD;&#xA;    Dim acctOthr As String = acctNode?.SelectSingleNode(&quot;c:Id/c:Othr/c:Id&quot;, nsmgr)?.InnerText&#xD;&#xA;    Dim acctCcy  As String = acctNode?.SelectSingleNode(&quot;c:Ccy&quot;, nsmgr)?.InnerText&#xD;&#xA;    Dim acctNm   As String = acctNode?.SelectSingleNode(&quot;c:Nm&quot;, nsmgr)?.InnerText&#xD;&#xA;    Dim acctBIC  As String = acctNode?.SelectSingleNode(&quot;c:Svcr/c:FinInstnId/c:BICFI&quot;, nsmgr)?.InnerText&#xD;&#xA;&#xD;&#xA;    ' ===== Balances =====&#xD;&#xA;    Dim opnBalNode As XmlNode = doc.SelectSingleNode(&quot;//c:Stmt/c:Bal[c:Tp/c:CdOrPrtry/c:Cd='OPBD']&quot;, nsmgr)&#xD;&#xA;    If opnBalNode Is Nothing Then&#xD;&#xA;        opnBalNode = doc.SelectSingleNode(&quot;//c:Stmt/c:Bal[c:Tp/c:CdOrPrtry/c:Cd='OPAV']&quot;, nsmgr)&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    Dim clsBalNode As XmlNode = doc.SelectSingleNode(&quot;//c:Stmt/c:Bal[c:Tp/c:CdOrPrtry/c:Cd='CLBD']&quot;, nsmgr)&#xD;&#xA;    If clsBalNode Is Nothing Then&#xD;&#xA;        clsBalNode = doc.SelectSingleNode(&quot;//c:Stmt/c:Bal[c:Tp/c:CdOrPrtry/c:Cd='CLAV']&quot;, nsmgr)&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    Dim avlBalNode As XmlNode = doc.SelectSingleNode(&quot;//c:Stmt/c:Bal[c:Tp/c:CdOrPrtry/c:Cd='FWAV']&quot;, nsmgr)&#xD;&#xA;    If avlBalNode Is Nothing Then&#xD;&#xA;        avlBalNode = doc.SelectSingleNode(&quot;//c:Stmt/c:Bal[c:Tp/c:CdOrPrtry/c:Cd='ITAV']&quot;, nsmgr)&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    Dim opnAmt  As String = opnBalNode?.SelectSingleNode(&quot;c:Amt&quot;, nsmgr)?.InnerText&#xD;&#xA;    Dim opnCcy  As String = opnBalNode?.SelectSingleNode(&quot;c:Amt&quot;, nsmgr)?.Attributes(&quot;Ccy&quot;)?.Value&#xD;&#xA;    Dim opnDrCr As String = opnBalNode?.SelectSingleNode(&quot;c:CdtDbtInd&quot;, nsmgr)?.InnerText&#xD;&#xA;    Dim opnDt   As String = GetBalDate(opnBalNode, nsmgr)&#xD;&#xA;&#xD;&#xA;    Dim clsAmt  As String = If(clsBalNode IsNot Nothing, clsBalNode.SelectSingleNode(&quot;c:Amt&quot;, nsmgr)?.InnerText, &quot;0&quot;)&#xD;&#xA;    Dim clsCcy  As String = clsBalNode?.SelectSingleNode(&quot;c:Amt&quot;, nsmgr)?.Attributes(&quot;Ccy&quot;)?.Value&#xD;&#xA;    Dim clsDrCr As String = clsBalNode?.SelectSingleNode(&quot;c:CdtDbtInd&quot;, nsmgr)?.InnerText&#xD;&#xA;    Dim clsDt   As String = GetBalDate(clsBalNode, nsmgr)&#xD;&#xA;&#xD;&#xA;    Dim avlAmt  As String = avlBalNode?.SelectSingleNode(&quot;c:Amt&quot;, nsmgr)?.InnerText&#xD;&#xA;    Dim avlCcy  As String = avlBalNode?.SelectSingleNode(&quot;c:Amt&quot;, nsmgr)?.Attributes(&quot;Ccy&quot;)?.Value&#xD;&#xA;    Dim avlDt   As String = GetBalDate(avlBalNode, nsmgr)&#xD;&#xA;&#xD;&#xA;    ' ===== Entries =====&#xD;&#xA;    Dim entries As XmlNodeList = doc.SelectNodes(&quot;//c:Stmt/c:Ntry&quot;, nsmgr)&#xD;&#xA;&#xD;&#xA;    For Each entry As XmlNode In entries&#xD;&#xA;&#xD;&#xA;        ' --- Entry Core ---&#xD;&#xA;        Dim ntryRef     As String = entry.SelectSingleNode(&quot;c:NtryRef&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim amtStr      As String = entry.SelectSingleNode(&quot;c:Amt&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim ntryCcy     As String = entry.SelectSingleNode(&quot;c:Amt&quot;, nsmgr)?.Attributes(&quot;Ccy&quot;)?.Value&#xD;&#xA;        Dim amount      As Double = If(Not String.IsNullOrEmpty(amtStr), Convert.ToDouble(amtStr), 0)&#xD;&#xA;        Dim drcr        As String = entry.SelectSingleNode(&quot;c:CdtDbtInd&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim rvslInd     As String = entry.SelectSingleNode(&quot;c:RvslInd&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim sts         As String = entry.SelectSingleNode(&quot;c:Sts/c:Cd&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim bookgDt     As String = entry.SelectSingleNode(&quot;c:BookgDt/c:Dt&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim valDt       As String = entry.SelectSingleNode(&quot;c:ValDt/c:Dt&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim acctSvcrRef As String = entry.SelectSingleNode(&quot;c:AcctSvcrRef&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim debit       As Double = If(drcr = &quot;DBIT&quot;, amount, 0)&#xD;&#xA;        Dim credit      As Double = If(drcr = &quot;CRDT&quot;, amount, 0)&#xD;&#xA;&#xD;&#xA;        ' --- Bank Transaction Code ---&#xD;&#xA;        Dim bkTxDomn    As String = entry.SelectSingleNode(&quot;c:BkTxCd/c:Domn/c:Cd&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim bkTxFmly    As String = entry.SelectSingleNode(&quot;c:BkTxCd/c:Domn/c:Fmly/c:Cd&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim bkTxSubFmly As String = entry.SelectSingleNode(&quot;c:BkTxCd/c:Domn/c:Fmly/c:SubFmlyCd&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim bkTxPrtryCd As String = entry.SelectSingleNode(&quot;c:BkTxCd/c:Prtry/c:Cd&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim bkTxPrtryIs As String = entry.SelectSingleNode(&quot;c:BkTxCd/c:Prtry/c:Issr&quot;, nsmgr)?.InnerText&#xD;&#xA;&#xD;&#xA;        ' --- Amount Details ---&#xD;&#xA;        Dim instdAmt    As String = entry.SelectSingleNode(&quot;c:AmtDtls/c:InstdAmt/c:Amt&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim instdAmtCcy As String = entry.SelectSingleNode(&quot;c:AmtDtls/c:InstdAmt/c:Amt&quot;, nsmgr)?.Attributes(&quot;Ccy&quot;)?.Value&#xD;&#xA;        Dim txAmt       As String = entry.SelectSingleNode(&quot;c:AmtDtls/c:TxAmt/c:Amt&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim txAmtCcy    As String = entry.SelectSingleNode(&quot;c:AmtDtls/c:TxAmt/c:Amt&quot;, nsmgr)?.Attributes(&quot;Ccy&quot;)?.Value&#xD;&#xA;        Dim cntrAmt     As String = entry.SelectSingleNode(&quot;c:AmtDtls/c:CntrValAmt/c:Amt&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim cntrAmtCcy  As String = entry.SelectSingleNode(&quot;c:AmtDtls/c:CntrValAmt/c:Amt&quot;, nsmgr)?.Attributes(&quot;Ccy&quot;)?.Value&#xD;&#xA;&#xD;&#xA;        ' --- Charges ---&#xD;&#xA;        Dim chrgsTtl  As String = entry.SelectSingleNode(&quot;c:Chrgs/c:TtlChrgsAndTaxAmt&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim chrgsAmt  As String = entry.SelectSingleNode(&quot;c:Chrgs/c:Rcrd/c:Amt&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim chrgsDrCr As String = entry.SelectSingleNode(&quot;c:Chrgs/c:Rcrd/c:CdtDbtInd&quot;, nsmgr)?.InnerText&#xD;&#xA;&#xD;&#xA;        ' --- Entry Additional Info ---&#xD;&#xA;        Dim addtlNtryInf As String = entry.SelectSingleNode(&quot;c:AddtlNtryInf&quot;, nsmgr)?.InnerText&#xD;&#xA;&#xD;&#xA;        ' ---- Transaction Details ----&#xD;&#xA;        Dim txDtls As XmlNode = entry.SelectSingleNode(&quot;c:NtryDtls/c:TxDtls&quot;, nsmgr)&#xD;&#xA;&#xD;&#xA;        ' --- Transaction References ---&#xD;&#xA;        Dim refsMsgId    As String = txDtls?.SelectSingleNode(&quot;c:Refs/c:MsgId&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim refsAcctSvcr As String = txDtls?.SelectSingleNode(&quot;c:Refs/c:AcctSvcrRef&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim refsPmtInfId As String = txDtls?.SelectSingleNode(&quot;c:Refs/c:PmtInfId&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim refsInstrId  As String = txDtls?.SelectSingleNode(&quot;c:Refs/c:InstrId&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim refsE2EId    As String = txDtls?.SelectSingleNode(&quot;c:Refs/c:EndToEndId&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim refsTxId     As String = &quot;&quot; 'txDtls?.SelectSingleNode(&quot;c:Refs/c:TxId&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim refsUETR     As String = txDtls?.SelectSingleNode(&quot;c:Refs/c:UETR&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim refsMndtId   As String = txDtls?.SelectSingleNode(&quot;c:Refs/c:MndtId&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim refsChqNb    As String = txDtls?.SelectSingleNode(&quot;c:Refs/c:ChqNb&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim refsClrSys   As String = txDtls?.SelectSingleNode(&quot;c:Refs/c:ClrSysRef&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim refsPrcgId   As String = txDtls?.SelectSingleNode(&quot;c:Refs/c:PrcgId&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim refsPrtryTp  As String = txDtls?.SelectSingleNode(&quot;c:Refs/c:Prtry/c:Tp&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim refsPrtryRef As String = txDtls?.SelectSingleNode(&quot;c:Refs/c:Prtry/c:Ref&quot;, nsmgr)?.InnerText&#xD;&#xA;&#xD;&#xA;        ' --- Transaction Amount ---&#xD;&#xA;        Dim txDtlsAmt    As String = txDtls?.SelectSingleNode(&quot;c:Amt&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim txDtlsAmtCcy As String = txDtls?.SelectSingleNode(&quot;c:Amt&quot;, nsmgr)?.Attributes(&quot;Ccy&quot;)?.Value&#xD;&#xA;        Dim txDtlsDrCr   As String = txDtls?.SelectSingleNode(&quot;c:CdtDbtInd&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim txDtlsInstd  As String = txDtls?.SelectSingleNode(&quot;c:AmtDtls/c:InstdAmt/c:Amt&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim txDtlsInstdC As String = txDtls?.SelectSingleNode(&quot;c:AmtDtls/c:InstdAmt/c:Amt&quot;, nsmgr)?.Attributes(&quot;Ccy&quot;)?.Value&#xD;&#xA;&#xD;&#xA;        ' --- Related Parties ---&#xD;&#xA;        Dim rltdPties As XmlNode = txDtls?.SelectSingleNode(&quot;c:RltdPties&quot;, nsmgr)&#xD;&#xA;&#xD;&#xA;        ' Debtor Name: try Pty first, fall back to Agt (FI-to-FI)&#xD;&#xA;        Dim dbtrNm As String = rltdPties?.SelectSingleNode(&quot;c:Dbtr/c:Pty/c:Nm&quot;, nsmgr)?.InnerText&#xD;&#xA;        If String.IsNullOrEmpty(dbtrNm) Then&#xD;&#xA;            dbtrNm = rltdPties?.SelectSingleNode(&quot;c:Dbtr/c:Agt/c:FinInstnId/c:Nm&quot;, nsmgr)?.InnerText&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;        Dim dbtrStrt     As String = rltdPties?.SelectSingleNode(&quot;c:Dbtr/c:Pty/c:PstlAdr/c:StrtNm&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim dbtrTwn      As String = rltdPties?.SelectSingleNode(&quot;c:Dbtr/c:Pty/c:PstlAdr/c:TwnNm&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim dbtrCtry     As String = rltdPties?.SelectSingleNode(&quot;c:Dbtr/c:Pty/c:PstlAdr/c:Ctry&quot;, nsmgr)?.InnerText&#xD;&#xA;&#xD;&#xA;        ' Debtor Org BIC: try Pty/OrgId first, fall back to Agt/FinInstnId&#xD;&#xA;        Dim dbtrOrgBIC As String = rltdPties?.SelectSingleNode(&quot;c:Dbtr/c:Pty/c:Id/c:OrgId/c:AnyBIC&quot;, nsmgr)?.InnerText&#xD;&#xA;        If String.IsNullOrEmpty(dbtrOrgBIC) Then&#xD;&#xA;            dbtrOrgBIC = rltdPties?.SelectSingleNode(&quot;c:Dbtr/c:Agt/c:FinInstnId/c:BICFI&quot;, nsmgr)?.InnerText&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;        Dim dbtrOrgOthr  As String = rltdPties?.SelectSingleNode(&quot;c:Dbtr/c:Pty/c:Id/c:OrgId/c:Othr/c:Id&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim dbtrAcctIBAN As String = rltdPties?.SelectSingleNode(&quot;c:DbtrAcct/c:Id/c:IBAN&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim dbtrAcctOthr As String = rltdPties?.SelectSingleNode(&quot;c:DbtrAcct/c:Id/c:Othr/c:Id&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim ultDbtrNm    As String = rltdPties?.SelectSingleNode(&quot;c:UltmtDbtr/c:Pty/c:Nm&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim ultDbtrId    As String = rltdPties?.SelectSingleNode(&quot;c:UltmtDbtr/c:Pty/c:Id/c:OrgId/c:Othr/c:Id&quot;, nsmgr)?.InnerText&#xD;&#xA;&#xD;&#xA;        ' Creditor Name: try Pty first, fall back to Agt (FI-to-FI)&#xD;&#xA;        Dim cdtrNm As String = rltdPties?.SelectSingleNode(&quot;c:Cdtr/c:Pty/c:Nm&quot;, nsmgr)?.InnerText&#xD;&#xA;        If String.IsNullOrEmpty(cdtrNm) Then&#xD;&#xA;            cdtrNm = rltdPties?.SelectSingleNode(&quot;c:Cdtr/c:Agt/c:FinInstnId/c:Nm&quot;, nsmgr)?.InnerText&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;        Dim cdtrStrt     As String = rltdPties?.SelectSingleNode(&quot;c:Cdtr/c:Pty/c:PstlAdr/c:StrtNm&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim cdtrTwn      As String = rltdPties?.SelectSingleNode(&quot;c:Cdtr/c:Pty/c:PstlAdr/c:TwnNm&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim cdtrCtry     As String = rltdPties?.SelectSingleNode(&quot;c:Cdtr/c:Pty/c:PstlAdr/c:Ctry&quot;, nsmgr)?.InnerText&#xD;&#xA;&#xD;&#xA;        ' Creditor Org BIC: try Pty/OrgId first, fall back to Agt/FinInstnId&#xD;&#xA;        Dim cdtrOrgBIC As String = rltdPties?.SelectSingleNode(&quot;c:Cdtr/c:Pty/c:Id/c:OrgId/c:AnyBIC&quot;, nsmgr)?.InnerText&#xD;&#xA;        If String.IsNullOrEmpty(cdtrOrgBIC) Then&#xD;&#xA;            cdtrOrgBIC = rltdPties?.SelectSingleNode(&quot;c:Cdtr/c:Agt/c:FinInstnId/c:BICFI&quot;, nsmgr)?.InnerText&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;        Dim cdtrOrgOthr  As String = rltdPties?.SelectSingleNode(&quot;c:Cdtr/c:Pty/c:Id/c:OrgId/c:Othr/c:Id&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim cdtrAcctIBAN As String = rltdPties?.SelectSingleNode(&quot;c:CdtrAcct/c:Id/c:IBAN&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim cdtrAcctOthr As String = rltdPties?.SelectSingleNode(&quot;c:CdtrAcct/c:Id/c:Othr/c:Id&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim ultCdtrNm    As String = rltdPties?.SelectSingleNode(&quot;c:UltmtCdtr/c:Pty/c:Nm&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim ultCdtrId    As String = rltdPties?.SelectSingleNode(&quot;c:UltmtCdtr/c:Pty/c:Id/c:OrgId/c:Othr/c:Id&quot;, nsmgr)?.InnerText&#xD;&#xA;&#xD;&#xA;        ' --- Related Agents ---&#xD;&#xA;        Dim rltdAgts As XmlNode = txDtls?.SelectSingleNode(&quot;c:RltdAgts&quot;, nsmgr)&#xD;&#xA;&#xD;&#xA;        Dim dbtrAgtBIC As String = rltdAgts?.SelectSingleNode(&quot;c:DbtrAgt/c:FinInstnId/c:BICFI&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim dbtrAgtNm  As String = rltdAgts?.SelectSingleNode(&quot;c:DbtrAgt/c:FinInstnId/c:Nm&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim dbtrAgtClr As String = rltdAgts?.SelectSingleNode(&quot;c:DbtrAgt/c:FinInstnId/c:ClrSysMmbId/c:MmbId&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim cdtrAgtBIC As String = rltdAgts?.SelectSingleNode(&quot;c:CdtrAgt/c:FinInstnId/c:BICFI&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim cdtrAgtNm  As String = rltdAgts?.SelectSingleNode(&quot;c:CdtrAgt/c:FinInstnId/c:Nm&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim cdtrAgtClr As String = rltdAgts?.SelectSingleNode(&quot;c:CdtrAgt/c:FinInstnId/c:ClrSysMmbId/c:MmbId&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim intrmyAgt1 As String = rltdAgts?.SelectSingleNode(&quot;c:IntrmyAgt1/c:FinInstnId/c:BICFI&quot;, nsmgr)?.InnerText&#xD;&#xA;&#xD;&#xA;        ' --- Purpose ---&#xD;&#xA;        Dim purpCd    As String = txDtls?.SelectSingleNode(&quot;c:Purp/c:Cd&quot;, nsmgr)?.InnerText&#xD;&#xA;        Dim purpPrtry As String = txDtls?.SelectSingleNode(&quot;c:Purp/c:Prtry&quot;, nsmgr)?.InnerText&#xD;&#xA;&#xD;&#xA;        ' --- Remittance Information
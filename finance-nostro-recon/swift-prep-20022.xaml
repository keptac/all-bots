    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Try&#xA;dtStatementCombined.Columns.Add(&quot;Age&quot;, GetType(Integer))&#xA;Catch ex1 As Exception&#xA;End Try&#xA;&#xA;&#xA;Dim closingBalance As String= dtStatementCombined(dtStatementCombined.Rows.Count-1)(&quot;Closing Balance&quot;).ToString&#xA;&#xA;dtStatementCombined.AsEnumerable().ToList().ForEach(Sub(row)&#xA;&#x9;Try&#xA;&#x9;&#x9;If row(&quot;Credit Debit Indicator&quot;).ToString.Equals(&quot;CRDT&quot;) Then&#xA;&#x9;&#x9;&#x9; &#x9;row(&quot;Entry Amount&quot;) = CDbl(row(&quot;Entry Amount&quot;).ToString())&#xA;&#x9;&#x9;&#x9;Else&#xA;&#x9;&#x9;&#x9;&#x9;row(&quot;Entry Amount&quot;) = CDbl(&quot;-&quot;+row(&quot;Entry Amount&quot;).ToString())&#xA;&#x9;&#x9;&#x9;End If&#xA;&#x9;Catch ex As Exception&#xA;&#x9;End Try&#xA;&#x9;&#xA;&#x9;&#x9;&#xA;&#x9;Try &#xA;&#x9;&#x9;row(&quot;Age&quot;) =  DateTime.Now.AddDays(-1).Subtract(DateTime.ParseExact(row(&quot;Value Date&quot;).ToString.Trim, &quot;yyMMdd&quot;, System.Globalization.CultureInfo.InvariantCulture)).Days&#xA;&#x9;Catch ex As Exception&#xA;&#x9;&#x9;&#x9;Try &#xA;&#x9;&#x9;row(&quot;Age&quot;) =  DateTime.Now.AddDays(-1).Subtract(DateTime.ParseExact(row(&quot;Value Date&quot;).ToString.Trim, &quot;MM/dd/yyyy&quot;, System.Globalization.CultureInfo.InvariantCulture)).Days&#xA;&#x9;Catch ex1 As Exception&#xA;&#x9;&#x9;Try &#xA;&#x9;&#xA;&#x9;&#x9;&#x9;If DateTime.Now.AddDays(-1).Subtract(DateTime.ParseExact(row(&quot;Value Date&quot;).ToString.Trim, &quot;MM/dd/yyyy HH:mm:ss&quot;, System.Globalization.CultureInfo.InvariantCulture)).Days &gt;15 Or DateTime.Now.AddDays(-1).Subtract(DateTime.ParseExact(row(&quot;Value Date&quot;).ToString.Trim, &quot;MM/dd/yyyy HH:mm:ss&quot;, System.Globalization.CultureInfo.InvariantCulture)).Days &lt;0  Then&#xA;&#x9;&#x9;&#x9;&#x9;row(&quot;Age&quot;) =  DateTime.Now.AddDays(-1).Subtract(DateTime.ParseExact(row(&quot;Value Date&quot;).ToString.Trim(), &quot;dd/MM/yyyy HH:mm:ss&quot;, System.Globalization.CultureInfo.InvariantCulture)).Days&#xA;&#x9;&#x9;&#x9;Else&#xA;&#x9;&#x9;&#x9;&#x9;row(&quot;Age&quot;) =  DateTime.Now.AddDays(-1).Subtract(DateTime.ParseExact(row(&quot;Value Date&quot;).ToString.Trim, &quot;MM/dd/yyyy HH:mm:ss&quot;, System.Globalization.CultureInfo.InvariantCulture)).Days&#xA;&#x9;&#x9;&#x9;End If&#xA;&#x9;&#xA;&#x9;Catch ex2 As Exception&#xA;&#x9;&#x9;Try &#xA;&#x9;&#x9;row(&quot;Age&quot;) =  DateTime.Now.AddDays(-1).Subtract(DateTime.ParseExact(row(&quot;Value Date&quot;).ToString.Trim, &quot;dd-MM-yyyy&quot;, System.Globalization.CultureInfo.InvariantCulture)).Days&#xA;&#x9;Catch ex3 As Exception&#xA;&#x9;&#x9;&#x9;Try &#xA;&#x9;&#x9;row(&quot;Age&quot;) =  DateTime.Now.AddDays(-1).Subtract(DateTime.ParseExact(row(&quot;Value Date&quot;).ToString.Trim, &quot;yyyy-MM-dd&quot;, System.Globalization.CultureInfo.InvariantCulture)).Days&#xA;&#x9;Catch ex4 As Exception&#xA;&#x9;&#x9;row(&quot;Age&quot;) = 0&#xA;&#x9;End Try&#xA;&#xA;&#x9;End Try&#xA;&#x9;End Try&#xA;&#x9;End Try&#xA;&#x9;End Try&#xA;   &#xA;End Sub)&#xA;" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="451.2,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_10">

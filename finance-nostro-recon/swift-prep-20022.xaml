    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ============================================================================&#xA;'  MISSING STATEMENT PAGES&#xA;' ============================================================================&#xA;'  Every camt.053 file is one page of one statement.  Pages are counted PER&#xA;'  STATEMENT - account + electronic sequence number - and read straight from&#xA;'  the files, because the previous check had two blind spots:&#xA;'&#xA;'   1. it pooled the page numbers of every account in the folder, so a gap in&#xA;'      one account was filled by another account's pages, and a missing first&#xA;'      or last page was never seen at all;&#xA;'   2. dtStatement holds one row per ENTRY, so a page with no entries looked&#xA;'      missing.&#xA;'&#xA;'  A statement is complete when it has pages 1..N and page N carries&#xA;'  LastPgInd = true.  A file without StmtPgntn is a single-page statement and&#xA;'  is not checked.&#xA;'&#xA;'  missingPagesSummary is &quot;&quot; when nothing is missing, otherwise one line per&#xA;'  incomplete statement - Main emails it and stops the run.&#xA;' ============================================================================&#xA;&#xA;Dim files As String() = Directory.GetFiles(statementsFolder, &quot;*.xml&quot;)&#xA;&#xA;' statement key -&gt; (page -&gt; file), plus what each statement says about itself&#xA;Dim pages As New Dictionary(Of String, Dictionary(Of Integer, String))(StringComparer.OrdinalIgnoreCase)&#xA;Dim lastPage As New Dictionary(Of String, Integer)(StringComparer.OrdinalIgnoreCase)&#xA;Dim label As New Dictionary(Of String, String)(StringComparer.OrdinalIgnoreCase)&#xA;Dim unreadable As New List(Of String)()&#xA;&#xA;For Each f As String In files&#xA;    Dim stmt As XmlNode = Nothing&#xA;    Try&#xA;        Dim doc As New XmlDocument()&#xA;        doc.Load(f)&#xA;        stmt = doc.SelectSingleNode(&quot;//*[local-name()='Stmt']&quot;)&#xA;    Catch ex As Exception&#xA;        unreadable.Add(Path.GetFileName(f) &amp; &quot; (&quot; &amp; ex.Message &amp; &quot;)&quot;)&#xA;        Continue For&#xA;    End Try&#xA;    If stmt Is Nothing Then Continue For&#xA;&#xA;    Dim T = Function(xp As String) As String&#xA;                Dim nd As XmlNode = stmt.SelectSingleNode(xp)&#xA;                Return If(nd Is Nothing, &quot;&quot;, nd.InnerText.Trim())&#xA;            End Function&#xA;&#xA;    Dim pgTxt As String = T(&quot;*[local-name()='StmtPgntn']/*[local-name()='PgNb']&quot;)&#xA;    Dim pg As Integer&#xA;    If Not Integer.TryParse(pgTxt, pg) Then Continue For&#xA;&#xA;    Dim acct As String = T(&quot;*[local-name()='Acct']/*[local-name()='Id']/*[local-name()='IBAN']&quot;)&#xA;    If acct.Length = 0 Then acct = T(&quot;*[local-name()='Acct']/*[local-name()='Id']/*[local-name()='Othr']/*[local-name()='Id']&quot;)&#xA;    Dim seq As String = T(&quot;*[local-name()='ElctrncSeqNb']&quot;)&#xA;    If seq.Length = 0 Then seq = T(&quot;*[local-name()='LglSeqNb']&quot;)&#xA;    If seq.Length = 0 Then seq = T(&quot;*[local-name()='FrToDt']/*[local-name()='FrDtTm']&quot;)&#xA;&#xA;    Dim key As String = acct &amp; &quot;|&quot; &amp; seq&#xA;    If Not pages.ContainsKey(key) Then&#xA;        pages(key) = New Dictionary(Of Integer, String)()&#xA;        Dim nm As String = T(&quot;*[local-name()='Acct']/*[local-name()='Nm']&quot;)&#xA;        label(key) = &quot;Account &quot; &amp; If(acct.Length &gt; 0, acct, &quot;(no account id)&quot;) &amp; _&#xA;                     If(nm.Length &gt; 0, &quot; (&quot; &amp; nm &amp; &quot;)&quot;, &quot;&quot;) &amp; _&#xA;                     If(seq.Length &gt; 0, &quot;, statement &quot; &amp; seq, &quot;&quot;)&#xA;    End If&#xA;    pages(key)(pg) = Path.GetFileName(f)&#xA;&#xA;    If T(&quot;*[local-name()='StmtPgntn']/*[local-name()='LastPgInd']&quot;).Equals(&quot;true&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;        If Not lastPage.ContainsKey(key) OrElse pg &gt; lastPage(key) Then lastPage(key) = pg&#xA;    End If&#xA;Next&#xA;&#xA;Dim lines As New List(Of String)()&#xA;missingCount = 0&#xA;For Each key As String In pages.Keys.OrderBy(Function(k) label(k))&#xA;    Dim have As Dictionary(Of Integer, String) = pages(key)&#xA;    Dim maxHave As Integer = have.Keys.Max()&#xA;    Dim upTo As Integer = If(lastPage.ContainsKey(key), lastPage(key), maxHave)&#xA;&#xA;    Dim gaps As New List(Of Integer)()&#xA;    For p As Integer = 1 To upTo&#xA;        If Not have.ContainsKey(p) Then gaps.Add(p)&#xA;    Next&#xA;&#xA;    Dim problems As New List(Of String)()&#xA;    If gaps.Count &gt; 0 Then problems.Add(&quot;missing page(s) &quot; &amp; String.Join(&quot;, &quot;, gaps))&#xA;    If Not lastPage.ContainsKey(key) Then&#xA;        problems.Add(&quot;last page not received (highest page is &quot; &amp; maxHave.ToString() &amp; &quot;, none marked as last)&quot;)&#xA;        missingCount += 1&#xA;    End If&#xA;    missingCount += gaps.Count&#xA;&#xA;    If problems.Count &gt; 0 Then&#xA;        lines.Add(label(key) &amp; &quot;: &quot; &amp; String.Join(&quot;; &quot;, problems) &amp; _&#xA;                  &quot; - received &quot; &amp; have.Count.ToString() &amp; &quot; page(s)&quot;)&#xA;    End If&#xA;Next&#xA;&#xA;For Each u As String In unreadable&#xA;    lines.Add(&quot;Could not read statement file &quot; &amp; u)&#xA;    missingCount += 1&#xA;Next&#xA;&#xA;missingPagesSummary = String.Join(Environment.NewLine, lines)&#xA;Console.WriteLine(If(lines.Count = 0, &quot;All statement pages present (&quot; &amp; pages.Count.ToString() &amp; &quot; paginated statements)&quot;, missingPagesSummary))" DisplayName="Check for missing statement pages" sap:VirtualizedContainerService.HintSize="451.2,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_14">

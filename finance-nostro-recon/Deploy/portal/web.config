<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS config for the Nostro manual matching portal, served as a child
  APPLICATION of the Orchestrator site at  https://robot.nmbtz.com/portal

  Deploy as an Application (not a plain virtual directory) so it gets its own
  configuration boundary and Orchestrator's pipeline is not inherited.

  Application pool: .NET CLR v4.0, Integrated, its own pool.
    (Managed code is needed ONLY for whoami.aspx, which returns the signed-in
     Windows user. Drop that one file and the pool can be "No Managed Code",
     but the portal will then ask the user to type their name.)

  In IIS Manager, on the /portal application, set Authentication to:
       Anonymous Authentication   DISABLED
       Windows Authentication     ENABLED
  Without that, User.Identity.Name is empty and the portal falls back to asking.

  Everything else is static. No reconciliation data is served over HTTP: the
  portal reads the run folders and writes the journal through the browser,
  against the share the user already has mapped.
-->
<configuration>

  <system.webServer>

    <!--
      Orchestrator registers a catch-all handler for its own runtime (aspNetCore
      on 2021.10+, or the managed handlers on older builds) and a child app
      inherits it, so a request for portal.html would be handed to Orchestrator.
      Clear them and register only what this app needs.
    -->
    <handlers>
      <clear />
      <add name="PortalApi"
           path="api.aspx"
           verb="GET,POST,HEAD"
           type="System.Web.UI.PageHandlerFactory"
           preCondition="integratedMode,runtimeVersionv4.0" />
      <add name="StaticFile"
           path="*"
           verb="GET,HEAD,OPTIONS"
           modules="StaticFileModule,DefaultDocumentModule"
           resourceType="Either"
           requireAccess="Read" />
    </handlers>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="portal.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!--
          The page carries its own script and styles and talks to nothing but
          whoami.aspx on this origin - hence connect-src 'self' and no remote
          origins anywhere.
        -->
        <add name="Content-Security-Policy"
             value="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="Permissions-Policy" value="geolocation=(), camera=(), microphone=()" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <!-- the only writable paths are api.aspx?op=tickets, upload and unupload; the static handler
             above accepts GET/HEAD/OPTIONS only, so POST cannot reach a file -->
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <add verb="OPTIONS" allowed="true" />
          <!-- POST reaches api.aspx only; the static handler above refuses it -->
          <add verb="POST" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

  </system.webServer>

  <system.web>
    <authentication mode="Windows" />
    <authorization>
      <!-- Windows Authentication is what makes the signed-in name available -->
      <deny users="?" />
      <allow users="*" />
    </authorization>
    <httpRuntime enableVersionHeader="false" />
    <compilation debug="false" targetFramework="4.0" />
  </system.web>

  <appSettings>
    <!--
      Where the reconciliation writes its dated run folders, as seen BY THIS
      SERVER. The app pool identity needs Read on this tree and Modify on the
      "Manual Matches" and "Missing Pages" subfolders (the journal is appended to,
      never overwritten; uploaded statement pages are saved for the robot).
      If the recon runs on a different machine, point this at the UNC share and
      give the app pool identity rights there.
    -->
    <add key="ReconRoot" value="C:\Users\kelvinch\Documents\FINANCE AUTOMATED RECON\Nostro" />
  </appSettings>

</configuration>

          <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ============================================================================&#xA;'  LEDGER REVERSALS - PAIRED REMOVAL&#xA;' ============================================================================&#xA;'  A reversal is a pair: an entry, and a later entry whose NARRATIVE quotes the&#xA;'  first one's TRN_REF_NO and whose amounts are its mirror image.  Removing the&#xA;'  pair is balance-neutral.&#xA;'&#xA;'  The previous version decided row by row while it was still emitting rows, so&#xA;'  an entry could be written to dtLedgerNonReversals and then later be claimed&#xA;'  as someone else's reversalRow.  Its partner left the ledger while it stayed,&#xA;'  which removed a non-zero net amount and pushed Summary!Check_Balance off zero.&#xA;'&#xA;'  This version resolves all pairs first, then splits, so a row can never end up&#xA;'  on both sides and the removed amount always nets to zero.&#xA;' ============================================================================&#xA;&#xA;Dim rows As List(Of DataRow) = dtLedgerFiltered.AsEnumerable().ToList()&#xA;Dim n As Integer = rows.Count&#xA;&#xA;Dim refs(Math.Max(0, n - 1)) As String&#xA;Dim narrs(Math.Max(0, n - 1)) As String&#xA;Dim dbt(Math.Max(0, n - 1)) As Double&#xA;Dim crd(Math.Max(0, n - 1)) As Double&#xA;Dim paired(Math.Max(0, n - 1)) As Boolean&#xA;Dim tmp As Double = 0&#xA;&#xA;For i As Integer = 0 To n - 1&#xA;    Dim r As DataRow = rows(i)&#xA;    refs(i) = &quot;&quot;&#xA;    If r.Table.Columns.Contains(&quot;TRN_REF_NO&quot;) AndAlso Not IsDBNull(r(&quot;TRN_REF_NO&quot;)) Then refs(i) = r(&quot;TRN_REF_NO&quot;).ToString().Trim()&#xA;    narrs(i) = &quot;&quot;&#xA;    If r.Table.Columns.Contains(&quot;NARRATIVE&quot;) AndAlso Not IsDBNull(r(&quot;NARRATIVE&quot;)) Then narrs(i) = r(&quot;NARRATIVE&quot;).ToString()&#xA;    tmp = 0&#xA;    If r.Table.Columns.Contains(&quot;DEBIT&quot;) AndAlso Not IsDBNull(r(&quot;DEBIT&quot;)) Then Double.TryParse(r(&quot;DEBIT&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), tmp)&#xA;    dbt(i) = Math.Round(tmp, 2)&#xA;    tmp = 0&#xA;    If r.Table.Columns.Contains(&quot;CREDIT&quot;) AndAlso Not IsDBNull(r(&quot;CREDIT&quot;)) Then Double.TryParse(r(&quot;CREDIT&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), tmp)&#xA;    crd(i) = Math.Round(tmp, 2)&#xA;Next i&#xA;&#xA;' Candidates are bucketed on the mirrored amount pair, so the narrative scan only&#xA;' ever runs over entries that could actually be the reversal (the previous&#xA;' version scanned every narrative for every row).&#xA;Const SEP As Char = Chr(0)&#xA;Dim byAmt As New Dictionary(Of String, List(Of Integer))()&#xA;For i As Integer = 0 To n - 1&#xA;    Dim k As String = crd(i).ToString(&quot;F2&quot;) &amp; SEP &amp; dbt(i).ToString(&quot;F2&quot;)&#xA;    Dim bucket As List(Of Integer) = Nothing&#xA;    If Not byAmt.TryGetValue(k, bucket) Then&#xA;        bucket = New List(Of Integer)()&#xA;        byAmt.Add(k, bucket)&#xA;    End If&#xA;    bucket.Add(i)&#xA;Next i&#xA;&#xA;For i As Integer = 0 To n - 1&#xA;    If paired(i) Then Continue For&#xA;    If refs(i).Length = 0 Then Continue For&#xA;    If dbt(i) = 0 AndAlso crd(i) = 0 Then Continue For&#xA;&#xA;    Dim bucket As List(Of Integer) = Nothing&#xA;    If Not byAmt.TryGetValue(dbt(i).ToString(&quot;F2&quot;) &amp; SEP &amp; crd(i).ToString(&quot;F2&quot;), bucket) Then Continue For&#xA;&#xA;    For Each j As Integer In bucket&#xA;        If j = i OrElse paired(j) Then Continue For&#xA;        If narrs(j).Contains(refs(i)) Then&#xA;            paired(i) = True&#xA;            paired(j) = True&#xA;            Exit For&#xA;        End If&#xA;    Next&#xA;Next i&#xA;&#xA;Dim dtLedgerNonReversals As DataTable = dtLedgerFiltered.Clone()&#xA;Dim dtLedgerPairs As DataTable = dtLedgerFiltered.Clone()&#xA;Dim remDbt As Double = 0&#xA;Dim remCrd As Double = 0&#xA;&#xA;For i As Integer = 0 To n - 1&#xA;    If paired(i) Then&#xA;        dtLedgerPairs.ImportRow(rows(i))&#xA;        remDbt += dbt(i)&#xA;        remCrd += crd(i)&#xA;    Else&#xA;        dtLedgerNonReversals.ImportRow(rows(i))&#xA;    End If&#xA;Next i&#xA;&#xA;Console.WriteLine(&quot;Ledger reversals removed: &quot; &amp; dtLedgerPairs.Rows.Count.ToString() &amp; &quot;  net value &quot; &amp; Math.Round(remDbt - remCrd, 2).ToString() &amp; &quot; (must be 0)&quot;)&#xA;&#xA;dtLedgerFiltered = dtLedgerNonReversals&#xA;dtLedgerPairsOut = dtLedgerPairs&#xA;" DisplayName="Remove ledger reversals (paired)" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_14"><ui:InvokeCode.Arguments><InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtLedgerFiltered">[dtLedgerFiltered]</InOutArgument><OutArgument x:TypeArguments="sd:DataTable" x:Key="dtLedgerPairsOut">[dtLedgerPairs]</OutArgument></ui:InvokeCode.Arguments></ui:InvokeCode>

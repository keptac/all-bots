              <ui:AddDataColumn x:TypeArguments="x:Object" AllowDBNull="{x:Null}" AutoIncrement="{x:Null}" Column="{x:Null}" DefaultValue="{x:Null}" MaxLength="{x:Null}" Unique="{x:Null}" ColumnName="TRN_DESC" DataTable="[dtLedgerHistorical]" DisplayName="Add Data Column" sap:VirtualizedContainerService.HintSize="382.4,220" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_3" /><ui:InvokeCode ContinueOnError="{x:Null}" Code="' ============================================================================&#xA;'  MERGE HISTORICAL OUTSTANDING INTO THE LEDGER POOL&#xA;' ============================================================================&#xA;'  Re-shapes the historical &quot;Internal outstanding&quot; rows onto dtLedgerFiltered's&#xA;'  schema and appends them IN MEMORY.&#xA;'&#xA;'  This replaces an Append Range onto the &quot;CBS&quot; sheet followed by a Read Range&#xA;'  back off it.  That round trip pushed ~90,000 x 9 cells out to a worksheet and&#xA;'  read every one back just to concatenate two DataTables - it was the single&#xA;'  most expensive step in the run, and it made correctness depend on Excel's&#xA;'  POSITIONAL append lining up with a hand-maintained column list.&#xA;'&#xA;'  The &quot;CBS&quot; sheet now holds only the current day's ledger extract, which is the&#xA;'  part of it anyone actually reviews; the brought-forward items are already in&#xA;'  the historical report and in Internal outstanding.&#xA;' ============================================================================&#xA;&#xA;Dim src As DataTable = dtLedgerHistorical&#xA;Dim dst As DataTable = dtLedgerFiltered&#xA;&#xA;' historical column -&gt; CBS column&#xA;Dim map As New Dictionary(Of String, String)(StringComparer.OrdinalIgnoreCase)&#xA;map.Add(&quot;TRN Date&quot;, &quot;TRN_DT&quot;)&#xA;map.Add(&quot;Value Date&quot;, &quot;VALUE_DT&quot;)&#xA;map.Add(&quot;DR&quot;, &quot;DEBIT&quot;)&#xA;map.Add(&quot;CR&quot;, &quot;CREDIT&quot;)&#xA;map.Add(&quot;TRN Reference&quot;, &quot;TRN_REF_NO&quot;)&#xA;map.Add(&quot;Source Reference&quot;, &quot;SOURCE_REF_NO&quot;)&#xA;map.Add(&quot;UETR No&quot;, &quot;UETR_NO&quot;)&#xA;map.Add(&quot;Narrative&quot;, &quot;NARRATIVE&quot;)&#xA;&#xA;Dim added As Integer = 0&#xA;For Each sr As DataRow In src.Rows&#xA;    Dim dr As DataRow = dst.NewRow()&#xA;    For Each sc As DataColumn In src.Columns&#xA;        Dim name As String = sc.ColumnName.Trim()&#xA;        Dim target As String = Nothing&#xA;        If map.ContainsKey(name) Then&#xA;            target = map(name)&#xA;        ElseIf dst.Columns.Contains(name) Then&#xA;            ' a historical file already written in CBS naming passes straight through&#xA;            target = name&#xA;        End If&#xA;        If target IsNot Nothing AndAlso dst.Columns.Contains(target) Then&#xA;            Dim v As Object = sr(sc)&#xA;            If v IsNot Nothing AndAlso Not IsDBNull(v) Then dr(target) = v.ToString()&#xA;        End If&#xA;    Next&#xA;    dst.Rows.Add(dr)&#xA;    added += 1&#xA;Next&#xA;&#xA;dtLedgerFiltered = dst&#xA;Console.WriteLine(&quot;Ledger pool: &quot; &amp; (dst.Rows.Count - added).ToString() &amp; &quot; current + &quot; &amp; added.ToString() &amp; &quot; historical = &quot; &amp; dst.Rows.Count.ToString() &amp; &quot; rows&quot;)&#xA;" DisplayName="Merge historical outstanding into ledger pool" sap:VirtualizedContainerService.HintSize="382.4,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_9001"><ui:InvokeCode.Arguments><InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtLedgerHistorical">[dtLedgerHistorical]</InOutArgument><InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtLedgerFiltered">[dtLedgerFiltered]</InOutArgument></ui:InvokeCode.Arguments></ui:InvokeCode>
              
              
              

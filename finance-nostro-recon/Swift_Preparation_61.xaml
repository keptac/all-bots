          <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Initialize the DataTable to store the combined results&#xD;&#xA;Dim dtTrxn As New DataTable()&#xD;&#xA;dtTrxn.Columns.Add(&quot;ValueDate&quot;)&#xD;&#xA;dtTrxn.Columns.Add(&quot;Debit&quot;)&#xD;&#xA;dtTrxn.Columns.Add(&quot;Credit&quot;)&#xD;&#xA;dtTrxn.Columns.Add(&quot;Currency&quot;)&#xD;&#xA;dtTrxn.Columns.Add(&quot;ReferenceCode&quot;)&#xD;&#xA;dtTrxn.Columns.Add(&quot;RelatedReference&quot;) ' New column for Related Reference after ReferenceCode&#xD;&#xA;dtTrxn.Columns.Add(&quot;TransactionDescription&quot;)&#xD;&#xA;dtTrxn.Columns.Add(&quot;AccountNumber&quot;)&#xD;&#xA;dtTrxn.Columns.Add(&quot;FileNumber&quot;)&#xD;&#xA;dtTrxn.Columns.Add(&quot;PageNumber&quot;)&#xD;&#xA;dtTrxn.Columns.Add(&quot;OpeningBalance&quot;)&#xD;&#xA;dtTrxn.Columns.Add(&quot;ClosingBalance&quot;)&#xD;&#xA;dtTrxn.Columns.Add(&quot;Unknown&quot;) ' Column for the unknown value from :20:&#xD;&#xA;&#xD;&#xA;' Input string containing SWIFT messages&#xD;&#xA;Dim input As String = outputSwift ' Replace with your actual input variable&#xD;&#xA;&#xD;&#xA;' Split the input string into batches using &quot;{1:F01&quot; as the delimiter&#xD;&#xA;Dim batches As String() = input.Split(New String() {&quot;{1:F01&quot;}, StringSplitOptions.None)&#xD;&#xA;&#xD;&#xA;' Variable to store the closing balance of the previous batch&#xD;&#xA;Dim previousClosingBalance As Decimal = 0D&#xD;&#xA;&#xD;&#xA;' Loop through each batch&#xD;&#xA;For i As Integer = 0 To batches.Length - 1&#xD;&#xA;    ' Skip empty batches&#xD;&#xA;    If String.IsNullOrWhiteSpace(batches(i)) Then Continue For&#xD;&#xA;&#xD;&#xA;    ' Reconstruct the batch by adding &quot;{1:F01&quot; prefix (which was removed during splitting)&#xD;&#xA;    Dim batch As String = &quot;{1:F01&quot; &amp; batches(i)&#xD;&#xA;&#xD;&#xA;    ' Extract account number, file number, and page number for this batch&#xD;&#xA;    Dim accountNumber As String = System.Text.RegularExpressions.Regex.Match(batch, &quot;(?&lt;=:25:)[^\r\n]+&quot;).Value.Trim()&#xD;&#xA;     Dim fileNumber As String = System.Text.RegularExpressions.Regex.Match(batch, &quot;(?&lt;=:28C:)[^/\r\n]+&quot;).Value.Trim()&#xD;&#xA;    Dim pageNumber As String = System.Text.RegularExpressions.Regex.Match(batch, &quot;(?&lt;=:28C:[^/]+/)[^\r\n]+&quot;).Value.Trim()&#xD;&#xA;&#xD;&#xA;    ' Extract the unknown value from :20:&#xD;&#xA;    Dim unknownValue As String = System.Text.RegularExpressions.Regex.Match(batch, &quot;(?&lt;=:20:)[^\r\n]+&quot;).Value.Trim()&#xD;&#xA;&#xD;&#xA;    ' Extract the Related Reference from :21: or similar tag if available&#xD;&#xA;    Dim relatedReference As String = System.Text.RegularExpressions.Regex.Match(batch, &quot;(?&lt;=:21:)[^\r\n]+&quot;).Value.Trim()&#xD;&#xA;&#xD;&#xA;    ' Extract Opening Balance and Currency&#xD;&#xA;    Dim openingBalance As Decimal = 0D&#xD;&#xA;    Dim currency As String = &quot;&quot;&#xD;&#xA;    Dim openingBalanceLine As String = &quot;&quot;&#xD;&#xA;&#xD;&#xA;    ' Check for :60M: or :60F:&#xD;&#xA;    If batch.Contains(&quot;:60M:&quot;) Then&#xD;&#xA;        openingBalanceLine = System.Text.RegularExpressions.Regex.Match(batch, &quot;(?&lt;=:60M:)[^\r\n]+&quot;).Value.Trim()&#xD;&#xA;    ElseIf batch.Contains(&quot;:60F:&quot;) Then&#xD;&#xA;        openingBalanceLine = System.Text.RegularExpressions.Regex.Match(batch, &quot;(?&lt;=:60F:)[^\r\n]+&quot;).Value.Trim()&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    If Not String.IsNullOrEmpty(openingBalanceLine) Then&#xD;&#xA;        ' Skip the first character (C or D) and the second part (date)&#xD;&#xA;        If openingBalanceLine.Length &gt; 10 Then&#xD;&#xA;            currency = openingBalanceLine.Substring(7, 3).Trim()&#xD;&#xA;            Dim balancePart = openingBalanceLine.Substring(10).Trim().Replace(&quot;,&quot;, &quot;.&quot;)&#xD;&#xA;            Decimal.TryParse(balancePart, openingBalance)&#xD;&#xA;        End If&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    ' Extract Closing Balance from :62F: or :62M:&#xD;&#xA;    Dim closingBalance As Decimal = 0D&#xD;&#xA;    Dim closingBalanceLine As String = &quot;&quot;&#xD;&#xA;&#xD;&#xA;    'If batch.Contains(&quot;:62F:&quot;) Then&#xD;&#xA;       closingBalanceLine = System.Text.RegularExpressions.Regex.Match(batch, &quot;(?&lt;=:62F:)[^\r\n]+&quot;).Value.Trim()&#xD;&#xA;   ' ElseIf batch.Contains(&quot;:62M:&quot;) Then&#xD;&#xA;       ' closingBalanceLine = System.Text.RegularExpressions.Regex.Match(batch, &quot;(?&lt;=:62M:)[^\r\n]+&quot;).Value.Trim()&#xD;&#xA;   ' End If&#xD;&#xA;&#xD;&#xA;    If Not String.IsNullOrEmpty(closingBalanceLine) Then&#xD;&#xA;        ' Skip the first character (C or D) and the second part (date)&#xD;&#xA;        If closingBalanceLine.Length &gt; 10 Then&#xD;&#xA;            Dim balancePart = closingBalanceLine.Substring(10).Trim().Replace(&quot;,&quot;, &quot;.&quot;)&#xD;&#xA;            Decimal.TryParse(balancePart, closingBalance)&#xD;&#xA;        End If&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    ' Update the closing balance for the next batch&#xD;&#xA;    previousClosingBalance = closingBalance&#xD;&#xA;&#xD;&#xA;    ' Split the batch into transactions using &quot;:61:&quot; as the delimiter&#xD;&#xA;    Dim transactionLines = batch.Split(New String() {&quot;:61:&quot;}, StringSplitOptions.RemoveEmptyEntries)&#xD;&#xA;&#xD;&#xA;    If transactionLines.Length &gt; 1 Then&#xD;&#xA;        For Each line In transactionLines.Skip(1)&#xD;&#xA;            Dim parts = line.Split(New String() {vbLf}, 2, StringSplitOptions.None)&#xD;&#xA;            If parts.Length &lt; 2 Then Continue For&#xD;&#xA;&#xD;&#xA;            Dim header = parts(0).Trim()&#xD;&#xA;            Dim description = If(parts.Length &gt; 1, parts(1).Trim().replace(vbLf,&quot;&quot;).Split(&quot;:&quot;)(0), &quot;&quot;)&#xD;&#xA;&#xD;&#xA;            Try&#xD;&#xA;                ' Extract ValueDate and determine Debit/Credit&#xD;&#xA;                Dim ValueDateStr = header.Substring(0, 6)&#xD;&#xA;                Dim typeIndex As Integer = header.IndexOfAny({&quot;D&quot;c, &quot;C&quot;c})&#xD;&#xA;                Dim type As String = &quot;&quot;&#xD;&#xA;                Dim amountStr As String = &quot;&quot;&#xD;&#xA;                Dim amountStartIndex As Integer&#xD;&#xA;                Dim amountEndIndex As Integer&#xD;&#xA;&#xD;&#xA;                If typeIndex &gt;= 0 Then&#xD;&#xA;                    amountStartIndex = typeIndex + 1&#xD;&#xA;                    amountEndIndex = header.IndexOfAny({&quot;A&quot;c, &quot;B&quot;c, &quot;E&quot;c, &quot;F&quot;c, &quot;G&quot;c, &quot;H&quot;c, &quot;I&quot;c, &quot;J&quot;c, &quot;K&quot;c, &quot;L&quot;c, &quot;M&quot;c, &quot;N&quot;c, &quot;O&quot;c, &quot;P&quot;c, &quot;Q&quot;c, &quot;R&quot;c, &quot;S&quot;c, &quot;T&quot;c, &quot;U&quot;c, &quot;V&quot;c, &quot;W&quot;c, &quot;X&quot;c, &quot;Z&quot;c}, amountStartIndex)&#xD;&#xA;&#xD;&#xA;                    If amountEndIndex &gt; 0 Then&#xD;&#xA;                        amountStr = header.Substring(amountStartIndex, amountEndIndex - amountStartIndex).Trim().Replace(&quot;,&quot;, &quot;.&quot;)&#xD;&#xA;                        If header(typeIndex) = &quot;D&quot;c Then&#xD;&#xA;                            type = &quot;D&quot;&#xD;&#xA;                        ElseIf header(typeIndex) = &quot;C&quot;c Then&#xD;&#xA;                            type = &quot;C&quot;&#xD;&#xA;                        End If&#xD;&#xA;                    End If&#xD;&#xA;                End If&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;                Dim debit  As String =&quot;0&quot;&#xD;&#xA;                Dim credit As String = &quot;0&quot;&#xD;&#xA;&#xD;&#xA;                If type = &quot;D&quot; Then&#xD;&#xA;                    debit = amountStr.Replace(&quot;C&quot;,&quot;&quot;).Replace(&quot;D&quot;,&quot;&quot;).Replace(&quot;Y&quot;,&quot;&quot;)&#xD;&#xA;                ElseIf type = &quot;C&quot; Then&#xD;&#xA;                    credit = amountStr.Replace(&quot;C&quot;,&quot;&quot;).Replace(&quot;D&quot;,&quot;&quot;).Replace(&quot;Y&quot;,&quot;&quot;)&#xD;&#xA;                End If&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#xD;&#xA;&#xD;&#xA;                ' Extract ReferenceCode from header&#xD;&#xA;                Dim referenceCode As String = If(amountEndIndex &gt; 0, header.Substring(amountEndIndex), &quot;&quot;)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;referenceCode = referenceCode.Substring(4, referenceCode.Length-4)&#xD;&#xA;&#xD;&#xA;                If batch.Contains(&quot;:86:&quot;) Then&#xD;&#xA;                    referenceCode = If(amountEndIndex &gt; 0,   header.Substring(amountEndIndex, header.IndexOf(&quot;//&quot;) - amountEndIndex), &quot;&quot;)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;referenceCode = referenceCode.Substring(4, referenceCode.Length-4)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;relatedReference = If(amountEndIndex &gt; 0, header.Substring(amountEndIndex+header.IndexOf(&quot;//&quot;) - amountEndIndex).Replace(&quot;/&quot;,&quot;&quot;), &quot;&quot;) '+parts(1).Trim().Substring(0,parts(1).Trim().IndexOf(&quot;:86:&quot;)).replace(vbLf,&quot;&quot;)&#xD;&#xA;                End If&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;If referenceCode.Contains(&quot;//&quot;) Then&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;relatedReference = referenceCode.Split(&quot;//&quot;)(1)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;referenceCode = referenceCode.Split(&quot;//&quot;)(0)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;End If &#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#xD;&#xA;&#xD;&#xA;                ' Add the parsed data to the DataTable, including the extracted account, file, page numbers, the unknown value, and the related reference&#xD;&#xA;                dtTrxn.Rows.Add(ValueDateStr, debit.ToString().TrimStart(&quot;0&quot;c), credit.ToString().TrimStart(&quot;0&quot;c), currency, referenceCode, relatedReference, description, accountNumber, fileNumber, pageNumber, openingBalance, previousClosingBalance, unknownValue)&#xD;&#xA;&#xD;&#xA;            Catch ex As Exception&#xD;&#xA;                Console.WriteLine($&quot;Error parsing line: {line}&quot; + ex.ToString )&#xD;&#xA;            End Try&#xD;&#xA;        Next&#xD;&#xA;    Else&#xD;&#xA;        ' No :61: transactions, create a row with the extracted data&#xD;&#xA;        dtTrxn.Rows.Add(&quot;&quot;, 0, 0, currency, &quot;&quot;, relatedReference, &quot;&quot;, accountNumber, fileNumber, pageNumber, openingBalance, previousClosingBalance, unknownValue)&#xD;&#xA;    End If&#xD;&#xA;Next&#xD;&#xA;&#xD;&#xA;' Now dtTrxn contains all the required data, including the transactions and the account, file, page numbers, the unknown value, and the related reference.&#xD;&#xA;dtSwiftStatement = dtTrxn ' Assign the resulting DataTable to your output variable&#xD;&#xA;&#xD;&#xA;dtSwiftStatement.Columns(&quot;ReferenceCode&quot;).ColumnName = &quot;Transaction Reference&quot;&#xD;&#xA;dtSwiftStatement.Columns(&quot;RelatedReference&quot;).ColumnName = &quot;Related Reference (61)&quot;&#xD;&#xA;" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_10">

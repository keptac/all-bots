              <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ============================================================================&#xA;'  NARRATIVE MATCHING - PAIRWISE (1:1)&#xA;' ============================================================================&#xA;'  A statement item is settled by a ledger item whose NARRATIVE quotes the&#xA;'  statement reference and whose amount mirrors it (statement Debit &lt;-&gt; ledger&#xA;'  Credit).  As before, but each side now CONSUMES its partner: previously both&#xA;'  sides were classified independently, so one ledger narrative could clear many&#xA;'  statement rows (and vice versa) and the two &quot;matched&quot; totals diverged, which&#xA;'  is what pushed Summary!Check_Balance off zero.&#xA;'&#xA;'  Pairs are appended to dtMatchedPairs, sharing a Match Id with their partner,&#xA;'  for the &quot;Matched Pairs&quot; workbook.&#xA;' ============================================================================&#xA;&#xA;Dim REFCOL As String = &quot;Related Reference (61)&quot;&#xA;Dim MINLEN As Integer = 7&#xA;Dim HOW As String = &quot;Narrative (Related Reference 61)&quot;&#xA;&#xA;Dim swiftRows As List(Of DataRow)  = dtSwiftOutstanding.AsEnumerable().ToList()&#xA;Dim ledgerRows As List(Of DataRow) = dtLedgerOutstandingNonSettlements.AsEnumerable().ToList()&#xA;Dim swiftCount As Integer  = swiftRows.Count&#xA;Dim ledgerCount As Integer = ledgerRows.Count&#xA;&#xA;If dtMatchedPairs Is Nothing OrElse dtMatchedPairs.Columns.Count = 0 Then&#xA;    dtMatchedPairs = New DataTable(&quot;Matched Pairs&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Match Id&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Matched On&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Source&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;TRN Date&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Value Date&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;TRN Reference&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Source Reference&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;UETR No&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;DR&quot;, GetType(Double))&#xA;    dtMatchedPairs.Columns.Add(&quot;CR&quot;, GetType(Double))&#xA;    dtMatchedPairs.Columns.Add(&quot;Narrative&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Item Id&quot;)&#xA;End If&#xA;&#xA;Dim G = Function(r As DataRow, c As String) CStr(If(r.Table.Columns.Contains(c) AndAlso Not IsDBNull(r(c)), r(c).ToString(), &quot;&quot;))&#xA;&#xA;Dim sRef(Math.Max(0, swiftCount - 1)) As String&#xA;Dim sDbt(Math.Max(0, swiftCount - 1)) As Double&#xA;Dim sCrd(Math.Max(0, swiftCount - 1)) As Double&#xA;Dim lNarr(Math.Max(0, ledgerCount - 1)) As String&#xA;Dim lDbt(Math.Max(0, ledgerCount - 1)) As Double&#xA;Dim lCrd(Math.Max(0, ledgerCount - 1)) As Double&#xA;Dim ledgerUsed(Math.Max(0, ledgerCount - 1)) As Boolean&#xA;Dim tmp As Double = 0&#xA;&#xA;For i As Integer = 0 To swiftCount - 1&#xA;    Dim r As DataRow = swiftRows(i)&#xA;    sRef(i) = &quot;&quot;&#xA;    If r.Table.Columns.Contains(REFCOL) AndAlso Not IsDBNull(r(REFCOL)) Then sRef(i) = r(REFCOL).ToString().Replace(&quot; &quot;, &quot;&quot;)&#xA;    tmp = 0&#xA;    If r.Table.Columns.Contains(&quot;Debit&quot;) AndAlso Not IsDBNull(r(&quot;Debit&quot;)) Then Double.TryParse(r(&quot;Debit&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), tmp)&#xA;    sDbt(i) = Math.Round(tmp, 2)&#xA;    tmp = 0&#xA;    If r.Table.Columns.Contains(&quot;Credit&quot;) AndAlso Not IsDBNull(r(&quot;Credit&quot;)) Then Double.TryParse(r(&quot;Credit&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), tmp)&#xA;    sCrd(i) = Math.Round(tmp, 2)&#xA;Next i&#xA;&#xA;For i As Integer = 0 To ledgerCount - 1&#xA;    Dim r As DataRow = ledgerRows(i)&#xA;    lNarr(i) = &quot;&quot;&#xA;    If r.Table.Columns.Contains(&quot;NARRATIVE&quot;) AndAlso Not IsDBNull(r(&quot;NARRATIVE&quot;)) Then lNarr(i) = r(&quot;NARRATIVE&quot;).ToString().Replace(&quot; &quot;, &quot;&quot;)&#xA;    tmp = 0&#xA;    If r.Table.Columns.Contains(&quot;DEBIT&quot;) AndAlso Not IsDBNull(r(&quot;DEBIT&quot;)) Then Double.TryParse(r(&quot;DEBIT&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), tmp)&#xA;    lDbt(i) = Math.Round(tmp, 2)&#xA;    tmp = 0&#xA;    If r.Table.Columns.Contains(&quot;CREDIT&quot;) AndAlso Not IsDBNull(r(&quot;CREDIT&quot;)) Then Double.TryParse(r(&quot;CREDIT&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), tmp)&#xA;    lCrd(i) = Math.Round(tmp, 2)&#xA;Next i&#xA;&#xA;' ledger index keyed on the amount pair, mirrored for the statement side&#xA;Const SEP As Char = Chr(0)&#xA;Dim ledgerLookup As New Dictionary(Of String, List(Of Integer))()&#xA;For i As Integer = 0 To ledgerCount - 1&#xA;    Dim k As String = lCrd(i).ToString(&quot;F2&quot;) &amp; SEP &amp; lDbt(i).ToString(&quot;F2&quot;)&#xA;    Dim bucket As List(Of Integer) = Nothing&#xA;    If Not ledgerLookup.TryGetValue(k, bucket) Then&#xA;        bucket = New List(Of Integer)()&#xA;        ledgerLookup(k) = bucket&#xA;    End If&#xA;    bucket.Add(i)&#xA;Next i&#xA;&#xA;Dim pairNo As Integer = dtMatchedPairs.Rows.Count \ 2&#xA;Dim swiftMatchedIdx As New List(Of Integer)()&#xA;Dim swiftUnmatchedIdx As New List(Of Integer)()&#xA;&#xA;For i As Integer = 0 To swiftCount - 1&#xA;    If sRef(i).Length &lt;= MINLEN OrElse (sDbt(i) = 0 AndAlso sCrd(i) = 0) Then&#xA;        swiftUnmatchedIdx.Add(i)&#xA;        Continue For&#xA;    End If&#xA;    Dim hit As Integer = -1&#xA;    Dim bucket As List(Of Integer) = Nothing&#xA;    If ledgerLookup.TryGetValue(sDbt(i).ToString(&quot;F2&quot;) &amp; SEP &amp; sCrd(i).ToString(&quot;F2&quot;), bucket) Then&#xA;        For Each j As Integer In bucket&#xA;            If ledgerUsed(j) Then Continue For&#xA;            If lNarr(j).Contains(sRef(i)) Then&#xA;                hit = j&#xA;                Exit For&#xA;            End If&#xA;        Next&#xA;    End If&#xA;    If hit &gt;= 0 Then&#xA;        ledgerUsed(hit) = True&#xA;        swiftMatchedIdx.Add(i)&#xA;&#xA;        pairNo += 1&#xA;        Dim matchId As String = &quot;M&quot; &amp; pairNo.ToString(&quot;000000&quot;)&#xA;        Dim lr As DataRow = ledgerRows(hit)&#xA;        Dim sr As DataRow = swiftRows(i)&#xA;        dtMatchedPairs.Rows.Add(matchId, HOW, &quot;CBS&quot;, G(lr, &quot;TRN_DT&quot;), G(lr, &quot;VALUE_DT&quot;), G(lr, &quot;TRN_REF_NO&quot;), G(lr, &quot;SOURCE_REF_NO&quot;), G(lr, &quot;UETR_NO&quot;), lDbt(hit), lCrd(hit), G(lr, &quot;NARRATIVE&quot;), G(lr, &quot;Item Id&quot;))&#xA;        dtMatchedPairs.Rows.Add(matchId, HOW, &quot;STATEMENT&quot;, G(sr, &quot;Booking Date&quot;), G(sr, &quot;Value Date&quot;), G(sr, &quot;Transaction Reference&quot;), G(sr, &quot;Related Reference (61)&quot;), G(sr, &quot;UETR&quot;), sDbt(i), sCrd(i), G(sr, &quot;Narrative&quot;), G(sr, &quot;Item Id&quot;))&#xA;    Else&#xA;        swiftUnmatchedIdx.Add(i)&#xA;    End If&#xA;Next i&#xA;&#xA;Dim swiftMatched As New List(Of DataRow)()&#xA;Dim swiftUnmatched As New List(Of DataRow)()&#xA;For Each i As Integer In swiftMatchedIdx&#xA;    swiftMatched.Add(swiftRows(i))&#xA;Next&#xA;For Each i As Integer In swiftUnmatchedIdx&#xA;    swiftUnmatched.Add(swiftRows(i))&#xA;Next&#xA;&#xA;Dim ledgerMatched As New List(Of DataRow)()&#xA;Dim ledgerUnmatched As New List(Of DataRow)()&#xA;For i As Integer = 0 To ledgerCount - 1&#xA;    If ledgerUsed(i) Then&#xA;        ledgerMatched.Add(ledgerRows(i))&#xA;    Else&#xA;        ledgerUnmatched.Add(ledgerRows(i))&#xA;    End If&#xA;Next i&#xA;&#xA;Dim dtSM As DataTable = If(swiftMatched.Count   &gt; 0, swiftMatched.CopyToDataTable(),   dtSwiftOutstanding.Clone())&#xA;Dim dtSU As DataTable = If(swiftUnmatched.Count &gt; 0, swiftUnmatched.CopyToDataTable(), dtSwiftOutstanding.Clone())&#xA;Dim dtLM As DataTable = If(ledgerMatched.Count   &gt; 0, ledgerMatched.CopyToDataTable(),   dtLedgerOutstandingNonSettlements.Clone())&#xA;Dim dtLU As DataTable = If(ledgerUnmatched.Count &gt; 0, ledgerUnmatched.CopyToDataTable(), dtLedgerOutstandingNonSettlements.Clone())&#xA;&#xA;Console.WriteLine(&quot;Narrative match on &quot; &amp; REFCOL &amp; &quot;: &quot; &amp; dtSM.Rows.Count.ToString() &amp; &quot; pairs&quot;)&#xA;&#xA;dtSwiftAllMatchedCopy = dtSM&#xA;dtLedgerMatchedCopy = dtLM&#xA;dtSwiftOutstanding = dtSU&#xA;dtLedgerOutstandingNonSettlements = dtLU&#xA;" DisplayName="Narrative match (pairwise) - Related Reference (61)" sap:VirtualizedContainerService.HintSize="478.4,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_27">

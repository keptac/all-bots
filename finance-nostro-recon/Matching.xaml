            <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ============================================================================&#xA;'  UETR REVERSALS WITHIN EACH OUTSTANDING SHEET&#xA;' ============================================================================&#xA;'  A payment posted and then reversed on the SAME side leaves two outstanding&#xA;'  legs that carry the same UETR - one a DR, the other a CR of the same&#xA;'  non-zero amount.  Neither leg has a counterparty on the other side, so no&#xA;'  cross-side rule can clear them.  They are paired here instead:&#xA;'&#xA;'    Internal outstanding  - ledger leg vs ledger leg, on UETR_NO&#xA;'    External outstanding  - statement leg vs statement leg, on UETR&#xA;'&#xA;'  A pair is DR,CR or CR,DR of one amount, so taking it out of one side is&#xA;'  balance-neutral and Check_Balance is unaffected.  Each leg is used once: a&#xA;'  third leg on the same UETR, or a partial reversal, stays outstanding for&#xA;'  review.  Blank / placeholder UETRs (shorter than 16 characters once spaces&#xA;'  and hyphens are stripped) are never used as a key.&#xA;'&#xA;'  Pairs go to Matched Pairs with both legs on the same Source, so they show&#xA;'  in the one colour.&#xA;' ============================================================================&#xA;&#xA;If dtMatchedPairs Is Nothing OrElse dtMatchedPairs.Columns.Count = 0 Then&#xA;    dtMatchedPairs = New DataTable(&quot;Matched Pairs&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Match Id&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Matched On&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Source&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;TRN Date&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Value Date&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;TRN Reference&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Source Reference&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;UETR No&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;DR&quot;, GetType(Double))&#xA;    dtMatchedPairs.Columns.Add(&quot;CR&quot;, GetType(Double))&#xA;    dtMatchedPairs.Columns.Add(&quot;Narrative&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Item Id&quot;)&#xA;End If&#xA;&#xA;Dim G = Function(r As DataRow, c As String) CStr(If(r.Table.Columns.Contains(c) AndAlso Not IsDBNull(r(c)), r(c).ToString(), &quot;&quot;))&#xA;Dim N = Function(r As DataRow, c As String) As Double&#xA;            Dim d As Double = 0&#xA;            If r.Table.Columns.Contains(c) AndAlso Not IsDBNull(r(c)) Then Double.TryParse(r(c).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), d)&#xA;            Return Math.Round(d, 2)&#xA;        End Function&#xA;&#xA;' Continue the Match Id sequence from the highest id already issued - a manual&#xA;' match can have more than two legs, so the row count is not a safe base.&#xA;Dim pairNo As Integer = 0&#xA;For Each r As DataRow In dtMatchedPairs.Rows&#xA;    Dim id As String = G(r, &quot;Match Id&quot;)&#xA;    Dim v As Integer = 0&#xA;    If id.StartsWith(&quot;M&quot;) AndAlso Integer.TryParse(id.Substring(1), v) AndAlso v &gt; pairNo Then pairNo = v&#xA;Next&#xA;&#xA;' Invoke Code arguments are ByRef, which a lambda cannot touch - use a local.&#xA;Dim pairsOut As DataTable = dtMatchedPairs&#xA;&#xA;' cols: TRN date, value date, DR, CR, TRN reference, source reference, UETR, narrative&#xA;Dim PairOff = Function(tb As DataTable, src As String, cols As String()) As DataTable&#xA;                  Dim rows As List(Of DataRow) = tb.AsEnumerable().ToList()&#xA;                  Dim cnt As Integer = rows.Count&#xA;                  Dim key(Math.Max(0, cnt - 1)) As String&#xA;                  Dim dbt(Math.Max(0, cnt - 1)) As Double&#xA;                  Dim crd(Math.Max(0, cnt - 1)) As Double&#xA;                  Dim used(Math.Max(0, cnt - 1)) As Boolean&#xA;&#xA;                  Dim idx As New Dictionary(Of String, List(Of Integer))(StringComparer.OrdinalIgnoreCase)&#xA;                  For i As Integer = 0 To cnt - 1&#xA;                      key(i) = G(rows(i), cols(6)).Replace(&quot; &quot;, &quot;&quot;).Replace(&quot;-&quot;, &quot;&quot;).Trim()&#xA;                      dbt(i) = N(rows(i), cols(2))&#xA;                      crd(i) = N(rows(i), cols(3))&#xA;                      If key(i).Length &lt; 16 OrElse (dbt(i) = 0 AndAlso crd(i) = 0) Then Continue For&#xA;                      Dim bucket As List(Of Integer) = Nothing&#xA;                      If Not idx.TryGetValue(key(i), bucket) Then&#xA;                          bucket = New List(Of Integer)()&#xA;                          idx.Add(key(i), bucket)&#xA;                      End If&#xA;                      bucket.Add(i)&#xA;                  Next i&#xA;&#xA;                  Dim how As String = &quot;UETR reversal (&quot; &amp; src &amp; &quot;)&quot;&#xA;                  Dim pairs As Integer = 0&#xA;                  Dim net As Double = 0&#xA;                  For i As Integer = 0 To cnt - 1&#xA;                      If used(i) Then Continue For&#xA;                      Dim bucket As List(Of Integer) = Nothing&#xA;                      If Not idx.TryGetValue(key(i), bucket) Then Continue For&#xA;                      Dim partner As Integer = -1&#xA;                      For Each j As Integer In bucket&#xA;                          If j = i OrElse used(j) Then Continue For&#xA;                          ' mirror image: this leg's DR is that leg's CR and vice versa&#xA;                          If dbt(i) = crd(j) AndAlso crd(i) = dbt(j) Then&#xA;                              partner = j&#xA;                              Exit For&#xA;                          End If&#xA;                      Next&#xA;                      If partner &lt; 0 Then Continue For&#xA;&#xA;                      used(i) = True&#xA;                      used(partner) = True&#xA;                      pairs += 1&#xA;                      pairNo += 1&#xA;                      Dim matchId As String = &quot;M&quot; &amp; pairNo.ToString(&quot;000000&quot;)&#xA;                      For Each k As Integer In New Integer() {i, partner}&#xA;                          Dim r As DataRow = rows(k)&#xA;                          pairsOut.Rows.Add(matchId, how, src, G(r, cols(0)), G(r, cols(1)), G(r, cols(4)), G(r, cols(5)), G(r, cols(6)), dbt(k), crd(k), G(r, cols(7)), G(r, &quot;Item Id&quot;))&#xA;                          net += crd(k) - dbt(k)&#xA;                      Next&#xA;                  Next i&#xA;&#xA;                  Dim keep As New List(Of DataRow)()&#xA;                  For i As Integer = 0 To cnt - 1&#xA;                      If Not used(i) Then keep.Add(rows(i))&#xA;                  Next i&#xA;&#xA;                  Console.WriteLine(&quot;UETR reversals (&quot; &amp; src &amp; &quot;): &quot; &amp; pairs.ToString() &amp; &quot; pairs removed, net value &quot; &amp; Math.Round(net, 2).ToString() &amp; &quot; (must be 0)&quot;)&#xA;                  Return If(keep.Count &gt; 0, keep.CopyToDataTable(), tb.Clone())&#xA;              End Function&#xA;&#xA;dtLedgerOutstandingNonSettlements = PairOff(dtLedgerOutstandingNonSettlements, &quot;CBS&quot;, _&#xA;    New String() {&quot;TRN_DT&quot;, &quot;VALUE_DT&quot;, &quot;DEBIT&quot;, &quot;CREDIT&quot;, &quot;TRN_REF_NO&quot;, &quot;SOURCE_REF_NO&quot;, &quot;UETR_NO&quot;, &quot;NARRATIVE&quot;})&#xA;dtSwiftOutstanding = PairOff(dtSwiftOutstanding, &quot;STATEMENT&quot;, _&#xA;    New String() {&quot;Booking Date&quot;, &quot;Value Date&quot;, &quot;Debit&quot;, &quot;Credit&quot;, &quot;Transaction Reference&quot;, &quot;Related Reference (61)&quot;, &quot;UETR&quot;, &quot;Narrative&quot;})" DisplayName="UETR reversals within each outstanding sheet" sap:VirtualizedContainerService.HintSize="478.6666666666667,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_9005">
              <ui:InvokeCode.Arguments>
                <InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtLedgerOutstandingNonSettlements">[dtLedgerOutstandingNonSettlements]</InOutArgument>
                <InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtSwiftOutstanding">[dtSwiftOutstanding]</InOutArgument>
                <InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtMatchedPairs">[dtMatchedPairs]</InOutArgument>
              </ui:InvokeCode.Arguments>
            </ui:InvokeCode>
            <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ============================================================================&#xA;'  BUILD THE TWO OUTSTANDING SHEETS IN THE AGREED REPORT LAYOUT&#xA;' ============================================================================&#xA;'  The outstanding tables are working tables carrying the camt.053 / CBS column&#xA;'  names.  The report has its own agreed headers, which the next run also reads&#xA;'  back as its historical file, so the two layouts have to stay fixed:&#xA;'&#xA;'    Internal outstanding (ledger)&#xA;'      TRN Date | Value Date | DR | CR | TRN Reference | Source Reference |&#xA;'      UETR No | Narrative | Aging | AGING GROUP | BOT Classification |&#xA;'      Duplicate Mark | Item Id&#xA;'&#xA;'    External outstanding (statement)&#xA;'      TRN Date | Value Date | DR | CR | TRN Reference | Source Reference |&#xA;'      UETR No | Narrative | Transaction Type | Aging | AGING GROUP |&#xA;'      BOT Classification | Item Id&#xA;'&#xA;'  Item Id is appended LAST so the agreed columns keep their positions. It is&#xA;'  what a manual match ticket points at, and it round-trips through the&#xA;'  historical file so a ticket raised today still resolves tomorrow.&#xA;'&#xA;'  DR and CR are written as numbers so the totals in row 5 still add up.&#xA;' ============================================================================&#xA;&#xA;Dim G = Function(r As DataRow, c As String) CStr(If(r.Table.Columns.Contains(c) AndAlso Not IsDBNull(r(c)), r(c).ToString(), &quot;&quot;))&#xA;Dim N = Function(r As DataRow, c As String) As Double&#xA;            Dim d As Double = 0&#xA;            If r.Table.Columns.Contains(c) AndAlso Not IsDBNull(r(c)) Then Double.TryParse(r(c).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), d)&#xA;            Return Math.Round(d, 2)&#xA;        End Function&#xA;&#xA;' ---------------- Internal outstanding ----------------&#xA;dtInternalReport = New DataTable(&quot;Internal outstanding&quot;)&#xA;dtInternalReport.Columns.Add(&quot;TRN Date&quot;)&#xA;dtInternalReport.Columns.Add(&quot;Value Date&quot;)&#xA;dtInternalReport.Columns.Add(&quot;DR&quot;, GetType(Double))&#xA;dtInternalReport.Columns.Add(&quot;CR&quot;, GetType(Double))&#xA;dtInternalReport.Columns.Add(&quot;TRN Reference&quot;)&#xA;dtInternalReport.Columns.Add(&quot;Source Reference&quot;)&#xA;dtInternalReport.Columns.Add(&quot;UETR No&quot;)&#xA;dtInternalReport.Columns.Add(&quot;Narrative&quot;)&#xA;dtInternalReport.Columns.Add(&quot;Aging&quot;)&#xA;dtInternalReport.Columns.Add(&quot;AGING GROUP&quot;)&#xA;dtInternalReport.Columns.Add(&quot;BOT Classification&quot;)&#xA;dtInternalReport.Columns.Add(&quot;Duplicate Mark&quot;)&#xA;dtInternalReport.Columns.Add(&quot;Item Id&quot;)&#xA;&#xA;' Duplicate Mark: a ledger item is only the FIRST occurrence of its&#xA;' reference + amount; any repeat of that same triple is marked DUPLICATE so the&#xA;' reconciliation unit can look at it.&#xA;Dim seen As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)&#xA;&#xA;For Each r As DataRow In dtLedgerOutstandingNonSettlements.Rows&#xA;    Dim dr As Double = N(r, &quot;DEBIT&quot;)&#xA;    Dim cr As Double = N(r, &quot;CREDIT&quot;)&#xA;    Dim ref As String = G(r, &quot;TRN_REF_NO&quot;).Replace(&quot; &quot;, &quot;&quot;)&#xA;    Dim dup As String = &quot;&quot;&#xA;    If ref.Length &gt; 0 Then&#xA;        Dim k As String = ref &amp; &quot;|&quot; &amp; dr.ToString(&quot;F2&quot;) &amp; &quot;|&quot; &amp; cr.ToString(&quot;F2&quot;)&#xA;        If Not seen.Add(k) Then dup = &quot;DUPLICATE&quot;&#xA;    End If&#xA;    dtInternalReport.Rows.Add(G(r, &quot;TRN_DT&quot;), G(r, &quot;VALUE_DT&quot;), dr, cr, _&#xA;        G(r, &quot;TRN_REF_NO&quot;), G(r, &quot;SOURCE_REF_NO&quot;), G(r, &quot;UETR_NO&quot;), G(r, &quot;NARRATIVE&quot;), _&#xA;        G(r, &quot;Aging&quot;), G(r, &quot;Aging Group&quot;), G(r, &quot;BOT Classification&quot;), dup, G(r, &quot;Item Id&quot;))&#xA;Next&#xA;&#xA;' ---------------- External outstanding ----------------&#xA;dtExternalReport = New DataTable(&quot;External outstanding&quot;)&#xA;dtExternalReport.Columns.Add(&quot;TRN Date&quot;)&#xA;dtExternalReport.Columns.Add(&quot;Value Date&quot;)&#xA;dtExternalReport.Columns.Add(&quot;DR&quot;, GetType(Double))&#xA;dtExternalReport.Columns.Add(&quot;CR&quot;, GetType(Double))&#xA;dtExternalReport.Columns.Add(&quot;TRN Reference&quot;)&#xA;dtExternalReport.Columns.Add(&quot;Source Reference&quot;)&#xA;dtExternalReport.Columns.Add(&quot;UETR No&quot;)&#xA;dtExternalReport.Columns.Add(&quot;Narrative&quot;)&#xA;dtExternalReport.Columns.Add(&quot;Transaction Type&quot;)&#xA;dtExternalReport.Columns.Add(&quot;Aging&quot;)&#xA;dtExternalReport.Columns.Add(&quot;AGING GROUP&quot;)&#xA;dtExternalReport.Columns.Add(&quot;BOT Classification&quot;)&#xA;dtExternalReport.Columns.Add(&quot;Item Id&quot;)&#xA;&#xA;For Each r As DataRow In dtSwiftOutstanding.Rows&#xA;    Dim td As String = G(r, &quot;Booking Date&quot;)&#xA;    If td.Length = 0 Then td = G(r, &quot;Value Date&quot;)&#xA;    dtExternalReport.Rows.Add(td, G(r, &quot;Value Date&quot;), N(r, &quot;Debit&quot;), N(r, &quot;Credit&quot;), _&#xA;        G(r, &quot;Transaction Reference&quot;), G(r, &quot;Related Reference (61)&quot;), G(r, &quot;UETR&quot;), G(r, &quot;Narrative&quot;), _&#xA;        G(r, &quot;Transaction Type&quot;), G(r, &quot;Aging&quot;), G(r, &quot;Aging Group&quot;), G(r, &quot;BOT Classification&quot;), G(r, &quot;Item Id&quot;))&#xA;Next&#xA;&#xA;Console.WriteLine(&quot;Report layout built - Internal &quot; &amp; dtInternalReport.Rows.Count.ToString() &amp; &quot; rows, External &quot; &amp; dtExternalReport.Rows.Count.ToString() &amp; &quot; rows&quot;)&#xA;" DisplayName="Build report sheets (agreed layout)" sap:VirtualizedContainerService.HintSize="478.6666666666667,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_9003">
              <ui:InvokeCode.Arguments>
                <InArgument x:TypeArguments="sd:DataTable" x:Key="dtLedgerOutstandingNonSettlements">[dtLedgerOutstandingNonSettlements]</InArgument>

        <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ============================================================================&#xA;'  AUTO-REVERSED STATEMENT ENTRIES - PAIRED REMOVAL&#xA;' ============================================================================&#xA;'  An auto-reversal is a PAIR: an entry and its mirror image carrying the same&#xA;'  reference.  Pulling the pair out of the statement is balance-neutral, so the&#xA;'  reconciliation is unaffected.&#xA;'&#xA;'  The previous version flagged rows independently and had two defects that made&#xA;'  the removal NOT balance-neutral - it leaked value straight into&#xA;'  Summary!Check_Balance:&#xA;'&#xA;'   1. keys concatenated the debit and credit amounts with no separator, so a&#xA;'      debit of X (&quot;X&quot; &amp; &quot;&quot;) was indistinguishable from a credit of X (&quot;&quot; &amp; &quot;X&quot;)&#xA;'      and unrelated entries collided;&#xA;'   2. camt.053 leaves &quot;Related Reference (21)&quot; empty, so the relRef lookup set&#xA;'      degenerated to a set of bare amounts and matched almost anything - every&#xA;'      entry with a blank &quot;Transaction Reference&quot; was discarded.&#xA;'&#xA;'  Both are fixed here: references must be non-empty to be used, every key is&#xA;'  separated, and each reversal consumes its partner so an odd entry is left in&#xA;'  place rather than silently dropped.&#xA;' ============================================================================&#xA;&#xA;Dim allRows As List(Of DataRow) = dtSwiftCombined.AsEnumerable().ToList()&#xA;Dim n As Integer = allRows.Count&#xA;&#xA;Dim txRef(Math.Max(0, n - 1)) As String&#xA;Dim relRef(Math.Max(0, n - 1)) As String&#xA;Dim dbt(Math.Max(0, n - 1)) As Double&#xA;Dim crd(Math.Max(0, n - 1)) As Double&#xA;Dim used(Math.Max(0, n - 1)) As Boolean&#xA;Dim tmp As Double = 0&#xA;&#xA;For i As Integer = 0 To n - 1&#xA;    Dim r As DataRow = allRows(i)&#xA;    txRef(i) = &quot;&quot;&#xA;    If r.Table.Columns.Contains(&quot;Transaction Reference&quot;) AndAlso Not IsDBNull(r(&quot;Transaction Reference&quot;)) Then txRef(i) = r(&quot;Transaction Reference&quot;).ToString().Replace(&quot; &quot;, &quot;&quot;).Trim().ToUpperInvariant()&#xA;    relRef(i) = &quot;&quot;&#xA;    If r.Table.Columns.Contains(&quot;Related Reference (21)&quot;) AndAlso Not IsDBNull(r(&quot;Related Reference (21)&quot;)) Then relRef(i) = r(&quot;Related Reference (21)&quot;).ToString().Replace(&quot; &quot;, &quot;&quot;).Trim().ToUpperInvariant()&#xA;    tmp = 0&#xA;    If r.Table.Columns.Contains(&quot;Debit&quot;) AndAlso Not IsDBNull(r(&quot;Debit&quot;)) Then Double.TryParse(r(&quot;Debit&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), tmp)&#xA;    dbt(i) = Math.Round(tmp, 2)&#xA;    tmp = 0&#xA;    If r.Table.Columns.Contains(&quot;Credit&quot;) AndAlso Not IsDBNull(r(&quot;Credit&quot;)) Then Double.TryParse(r(&quot;Credit&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), tmp)&#xA;    crd(i) = Math.Round(tmp, 2)&#xA;Next i&#xA;&#xA;Const SEP As Char = Chr(0)&#xA;&#xA;' Index every entry by each non-empty reference it carries.&#xA;Dim idx As New Dictionary(Of String, List(Of Integer))()&#xA;For i As Integer = 0 To n - 1&#xA;    For Each k As String In New String() {txRef(i), relRef(i)}&#xA;        If k.Length = 0 Then Continue For&#xA;        Dim bucket As List(Of Integer) = Nothing&#xA;        If Not idx.TryGetValue(k, bucket) Then&#xA;            bucket = New List(Of Integer)()&#xA;            idx.Add(k, bucket)&#xA;        End If&#xA;        bucket.Add(i)&#xA;    Next&#xA;Next i&#xA;&#xA;' Pair each entry with its mirror image; both are then removed together.&#xA;For i As Integer = 0 To n - 1&#xA;    If used(i) Then Continue For&#xA;    If dbt(i) = 0 AndAlso crd(i) = 0 Then Continue For&#xA;&#xA;    Dim partner As Integer = -1&#xA;    For Each k As String In New String() {txRef(i), relRef(i)}&#xA;        If k.Length = 0 Then Continue For&#xA;        Dim bucket As List(Of Integer) = Nothing&#xA;        If Not idx.TryGetValue(k, bucket) Then Continue For&#xA;        For Each j As Integer In bucket&#xA;            If j = i OrElse used(j) Then Continue For&#xA;            ' mirror image: this entry's debit is that entry's credit and vice versa&#xA;            If dbt(i) = crd(j) AndAlso crd(i) = dbt(j) Then&#xA;                partner = j&#xA;                Exit For&#xA;            End If&#xA;        Next&#xA;        If partner &gt;= 0 Then Exit For&#xA;    Next&#xA;&#xA;    If partner &gt;= 0 Then&#xA;        used(i) = True&#xA;        used(partner) = True&#xA;    End If&#xA;Next i&#xA;&#xA;Dim matched As New List(Of DataRow)()&#xA;Dim unmatched As New List(Of DataRow)()&#xA;Dim netDbt As Double = 0&#xA;Dim netCrd As Double = 0&#xA;For i As Integer = 0 To n - 1&#xA;    If used(i) Then&#xA;        matched.Add(allRows(i))&#xA;        netDbt += dbt(i)&#xA;        netCrd += crd(i)&#xA;    Else&#xA;        unmatched.Add(allRows(i))&#xA;    End If&#xA;Next i&#xA;&#xA;Dim dtMatched As DataTable = If(matched.Count &gt; 0, matched.CopyToDataTable(), dtSwiftCombined.Clone())&#xA;Dim dtUnmatched As DataTable = If(unmatched.Count &gt; 0, unmatched.CopyToDataTable(), dtSwiftCombined.Clone())&#xA;&#xA;Console.WriteLine(&quot;Auto-reversed entries removed: &quot; &amp; matched.Count.ToString() &amp; &quot;  net value &quot; &amp; Math.Round(netCrd - netDbt, 2).ToString() &amp; &quot; (must be 0)&quot;)&#xA;&#xA;dtSwiftCombined = dtUnmatched&#xA;dtSwiftFilteredAutoReversed = dtMatched&#xA;" DisplayName="Remove auto-reversed entries (paired)" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_25">

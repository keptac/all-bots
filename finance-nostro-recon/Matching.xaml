                <OutArgument x:TypeArguments="sd:DataTable" x:Key="dtExternalReport">[dtExternalReport]</OutArgument>
              </ui:InvokeCode.Arguments>
            </ui:InvokeCode>
            <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ============================================================================&#xD;&#xA;'  WRITE THE RECON REPORT  +  EXPORT THE MANUAL MATCHING PORTAL&#xD;&#xA;' ============================================================================&#xD;&#xA;'  Internal outstanding / External outstanding carry the agreed headers, which&#xD;&#xA;'  the next run reads back as its historical file, so both layouts stay fixed.&#xD;&#xA;'&#xD;&#xA;'  Matched Pairs goes into the SAME workbook as a third sheet: the legs of each&#xD;&#xA;'  match share a Match Id, the CBS legs in blue and the statement legs in red.&#xD;&#xA;'  Manual Match Log records what the journal did - applied or rejected and why.&#xD;&#xA;'&#xD;&#xA;'  The pair colours are three conditional-formatting rules over the whole range&#xD;&#xA;'  rather than a style applied row by row - styling ~94,000 rows individually in&#xD;&#xA;'  ClosedXML costs minutes and a lot of memory, this is three style objects.&#xD;&#xA;'&#xD;&#xA;'  Finally the outstanding items are exported as recon-data-&lt;account&gt;.json beside the&#xD;&#xA;'  report. portal.html loads that file through a file picker, so it runs&#xD;&#xA;'  straight off the file system and no transaction data leaves the machine.&#xD;&#xA;' ============================================================================&#xD;&#xA;&#xD;&#xA;Dim wb As New ClosedXML.Excel.XLWorkbook(summaryFilePath)&#xD;&#xA;&#xD;&#xA;Dim wl As ClosedXML.Excel.IXLWorksheet = wb.Worksheet(&quot;Internal outstanding&quot;)&#xD;&#xA;Dim ws As ClosedXML.Excel.IXLWorksheet = wb.Worksheet(&quot;External outstanding&quot;)&#xD;&#xA;&#xD;&#xA;wl.Range(wl.Cell(7, 1), wl.LastCellUsed()).Clear(ClosedXML.Excel.XLClearOptions.Contents)&#xD;&#xA;wl.Cell(7, 1).InsertTable(dtInternalReport)&#xD;&#xA;&#xD;&#xA;ws.Range(ws.Cell(7, 1), ws.LastCellUsed()).Clear(ClosedXML.Excel.XLClearOptions.Contents)&#xD;&#xA;ws.Cell(7, 1).InsertTable(dtExternalReport)&#xD;&#xA;&#xD;&#xA;If dtMatchedPairs IsNot Nothing AndAlso dtMatchedPairs.Rows.Count &gt; 0 Then&#xD;&#xA;&#xD;&#xA;    If wb.Worksheets.Contains(&quot;Matched Pairs&quot;) Then wb.Worksheet(&quot;Matched Pairs&quot;).Delete()&#xD;&#xA;    Dim wp As ClosedXML.Excel.IXLWorksheet = wb.Worksheets.Add(&quot;Matched Pairs&quot;)&#xD;&#xA;&#xD;&#xA;    wp.Cell(1, 1).InsertTable(dtMatchedPairs, False)&#xD;&#xA;&#xD;&#xA;    Dim lastRow As Integer = dtMatchedPairs.Rows.Count + 1&#xD;&#xA;    Dim lastCol As Integer = dtMatchedPairs.Columns.Count&#xD;&#xA;&#xD;&#xA;    Dim hdr As ClosedXML.Excel.IXLRange = wp.Range(wp.Cell(1, 1), wp.Cell(1, lastCol))&#xD;&#xA;    hdr.Style.Font.Bold = True&#xD;&#xA;    hdr.Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.FromArgb(235, 235, 235)&#xD;&#xA;    hdr.Style.Border.BottomBorder = ClosedXML.Excel.XLBorderStyleValues.Thin&#xD;&#xA;&#xD;&#xA;    Dim body As ClosedXML.Excel.IXLRange = wp.Range(wp.Cell(2, 1), wp.Cell(lastRow, lastCol))&#xD;&#xA;&#xD;&#xA;    ' DR and CR are columns 9 and 10&#xD;&#xA;    wp.Range(wp.Cell(2, 9), wp.Cell(lastRow, 10)).Style.NumberFormat.Format = &quot;#,##0.00&quot;&#xD;&#xA;&#xD;&#xA;    ' blue = ledger leg, red = statement leg (&quot;Source&quot; is column C)&#xD;&#xA;    Dim cfCbs As ClosedXML.Excel.IXLStyle = body.AddConditionalFormat().WhenIsTrue(&quot;=$C2=&quot;&quot;CBS&quot;&quot;&quot;)&#xD;&#xA;    cfCbs.Font.FontColor = ClosedXML.Excel.XLColor.FromArgb(0, 32, 96)&#xD;&#xA;&#xD;&#xA;    Dim cfStm As ClosedXML.Excel.IXLStyle = body.AddConditionalFormat().WhenIsTrue(&quot;=$C2=&quot;&quot;STATEMENT&quot;&quot;&quot;)&#xD;&#xA;    cfStm.Font.FontColor = ClosedXML.Excel.XLColor.FromArgb(192, 0, 0)&#xD;&#xA;&#xD;&#xA;    ' a manual ticket is the one a reviewer will want to find&#xD;&#xA;    Dim cfMan As ClosedXML.Excel.IXLStyle = body.AddConditionalFormat().WhenIsTrue(&quot;=LEFT($B2,6)=&quot;&quot;Manual&quot;&quot;&quot;)&#xD;&#xA;    cfMan.Fill.BackgroundColor = ClosedXML.Excel.XLColor.FromArgb(255, 245, 205)&#xD;&#xA;&#xD;&#xA;    wp.SheetView.FreezeRows(1)&#xD;&#xA;    wp.RangeUsed().SetAutoFilter()&#xD;&#xA;    wp.Columns(1, lastCol).AdjustToContents(1, 200)&#xD;&#xA;    wp.Column(11).Width = 60&#xD;&#xA;&#xD;&#xA;    Console.WriteLine(&quot;Matched Pairs sheet: &quot; &amp; dtMatchedPairs.Rows.Count.ToString() &amp; &quot; legs&quot;)&#xD;&#xA;End If&#xD;&#xA;&#xD;&#xA;If dtManualLog IsNot Nothing Then&#xD;&#xA;    If wb.Worksheets.Contains(&quot;Manual Match Log&quot;) Then wb.Worksheet(&quot;Manual Match Log&quot;).Delete()&#xD;&#xA;    Dim wm As ClosedXML.Excel.IXLWorksheet = wb.Worksheets.Add(&quot;Manual Match Log&quot;)&#xD;&#xA;    wm.Cell(1, 1).Value = &quot;Manual match journal: &quot; &amp; manualJournalPath&#xD;&#xA;    wm.Cell(1, 1).Style.Font.Bold = True&#xD;&#xA;    wm.Cell(3, 1).InsertTable(dtManualLog, False)&#xD;&#xA;    wm.Range(wm.Cell(3, 1), wm.Cell(3, dtManualLog.Columns.Count)).Style.Font.Bold = True&#xD;&#xA;    wm.Columns(1, dtManualLog.Columns.Count).AdjustToContents(1, 200)&#xD;&#xA;End If&#xD;&#xA;&#xD;&#xA;wb.Save()&#xD;&#xA;Console.WriteLine(&quot;Report written: &quot; &amp; summaryFilePath)&#xD;&#xA;&#xD;&#xA;' ------------------------------------------------ portal data export --------&#xD;&#xA;Dim folder As String = System.IO.Path.GetDirectoryName(summaryFilePath)&#xD;&#xA;&#xD;&#xA;' The two balances the corrected figures are built from, read back from the&#xD;&#xA;' Summary sheet itself so the portal recomputes from exactly what was published.&#xD;&#xA;Dim ledgerBal As Double = 0&#xD;&#xA;Dim stmtBal As Double = 0&#xD;&#xA;Try&#xD;&#xA;    Dim sm As ClosedXML.Excel.IXLWorksheet = wb.Worksheet(&quot;Summary&quot;)&#xD;&#xA;    Double.TryParse(sm.Cell(16, 4).Value.ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), ledgerBal)&#xD;&#xA;    Double.TryParse(sm.Cell(23, 4).Value.ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), stmtBal)&#xD;&#xA;Catch ex As Exception&#xD;&#xA;End Try&#xD;&#xA;&#xD;&#xA;Dim Esc = Function(v As String) As String&#xD;&#xA;              If v Is Nothing Then Return &quot;&quot;&#xD;&#xA;              Dim t As String = v.Replace(&quot;\&quot;, &quot;\\&quot;).Replace(&quot;&quot;&quot;&quot;, &quot;\&quot;&quot;&quot;)&#xD;&#xA;              t = t.Replace(vbCr, &quot; &quot;).Replace(vbLf, &quot; &quot;).Replace(vbTab, &quot; &quot;)&#xD;&#xA;              Return t&#xD;&#xA;          End Function&#xD;&#xA;&#xD;&#xA;Dim sb As New System.Text.StringBuilder()&#xD;&#xA;sb.Append(&quot;{&quot;&quot;account&quot;&quot;:&quot;&quot;&quot;).Append(Esc(accountNumber)).Append(&quot;&quot;&quot;,&quot;&quot;report&quot;&quot;:&quot;&quot;&quot;).Append(Esc(System.IO.Path.GetFileName(summaryFilePath)))&#xD;&#xA;sb.Append(&quot;&quot;&quot;,&quot;&quot;journal&quot;&quot;:&quot;&quot;&quot;).Append(Esc(manualJournalPath)).Append(&quot;&quot;&quot;,&quot;&quot;generated&quot;&quot;:&quot;&quot;&quot;).Append(DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm&quot;)).Append(&quot;&quot;&quot;,&quot;)&#xD;&#xA;sb.Append(&quot;&quot;&quot;ledgerBalance&quot;&quot;:&quot;).Append(ledgerBal.ToString(&quot;F2&quot;, System.Globalization.CultureInfo.InvariantCulture)).Append(&quot;,&quot;)&#xD;&#xA;sb.Append(&quot;&quot;&quot;statementBalance&quot;&quot;:&quot;).Append(stmtBal.ToString(&quot;F2&quot;, System.Globalization.CultureInfo.InvariantCulture)).Append(&quot;,&quot;)&#xD;&#xA;&#xD;&#xA;For Each spec As Object() In New Object() {New Object() {&quot;ledger&quot;, dtInternalReport, &quot;Duplicate Mark&quot;}, New Object() {&quot;statement&quot;, dtExternalReport, &quot;Transaction Type&quot;}}&#xD;&#xA;    Dim nm As String = CStr(spec(0))&#xD;&#xA;    Dim tb As DataTable = DirectCast(spec(1), DataTable)&#xD;&#xA;    Dim extraCol As String = CStr(spec(2))&#xD;&#xA;    sb.Append(&quot;&quot;&quot;&quot;).Append(nm).Append(&quot;&quot;&quot;:[&quot;)&#xD;&#xA;    Dim first As Boolean = True&#xD;&#xA;    For Each r As DataRow In tb.Rows&#xD;&#xA;        If Not first Then sb.Append(&quot;,&quot;)&#xD;&#xA;        first = False&#xD;&#xA;        sb.Append(&quot;{&quot;&quot;id&quot;&quot;:&quot;&quot;&quot;).Append(Esc(r(&quot;Item Id&quot;).ToString()))&#xD;&#xA;        sb.Append(&quot;&quot;&quot;,&quot;&quot;d&quot;&quot;:&quot;&quot;&quot;).Append(Esc(r(&quot;TRN Date&quot;).ToString()))&#xD;&#xA;        sb.Append(&quot;&quot;&quot;,&quot;&quot;v&quot;&quot;:&quot;&quot;&quot;).Append(Esc(r(&quot;Value Date&quot;).ToString()))&#xD;&#xA;        sb.Append(&quot;&quot;&quot;,&quot;&quot;dr&quot;&quot;:&quot;).Append(Convert.ToDouble(r(&quot;DR&quot;)).ToString(&quot;F2&quot;, System.Globalization.CultureInfo.InvariantCulture))&#xD;&#xA;        sb.Append(&quot;,&quot;&quot;cr&quot;&quot;:&quot;).Append(Convert.ToDouble(r(&quot;CR&quot;)).ToString(&quot;F2&quot;, System.Globalization.CultureInfo.InvariantCulture))&#xD;&#xA;        sb.Append(&quot;,&quot;&quot;r1&quot;&quot;:&quot;&quot;&quot;).Append(Esc(r(&quot;TRN Reference&quot;).ToString()))&#xD;&#xA;        sb.Append(&quot;&quot;&quot;,&quot;&quot;r2&quot;&quot;:&quot;&quot;&quot;).Append(Esc(r(&quot;Source Reference&quot;).ToString()))&#xD;&#xA;        sb.Append(&quot;&quot;&quot;,&quot;&quot;u&quot;&quot;:&quot;&quot;&quot;).Append(Esc(r(&quot;UETR No&quot;).ToString()))&#xD;&#xA;        sb.Append(&quot;&quot;&quot;,&quot;&quot;n&quot;&quot;:&quot;&quot;&quot;).Append(Esc(r(&quot;Narrative&quot;).ToString()))&#xD;&#xA;        sb.Append(&quot;&quot;&quot;,&quot;&quot;a&quot;&quot;:&quot;&quot;&quot;).Append(Esc(r(&quot;Aging&quot;).ToString()))&#xD;&#xA;        sb.Append(&quot;&quot;&quot;,&quot;&quot;g&quot;&quot;:&quot;&quot;&quot;).Append(Esc(r(&quot;AGING GROUP&quot;).ToString()))&#xD;&#xA;        sb.Append(&quot;&quot;&quot;,&quot;&quot;x&quot;&quot;:&quot;&quot;&quot;).Append(Esc(r(extraCol).ToString()))&#xD;&#xA;        sb.Append(&quot;&quot;&quot;}&quot;)&#xD;&#xA;    Next&#xD;&#xA;    sb.Append(&quot;],&quot;)&#xD;&#xA;Next&#xD;&#xA;sb.Length = sb.Length - 1&#xD;&#xA;sb.Append(&quot;}&quot;)&#xD;&#xA;&#xD;&#xA;' One file per account: every account of a bank shares this folder, and a single&#xD;&#xA;' recon-data.json was overwritten by each of them in turn.&#xD;&#xA;Dim dataName As String = &quot;recon-data-&quot; &amp; System.Text.RegularExpressions.Regex.Replace(accountNumber, &quot;[^A-Za-z0-9_\-]&quot;, &quot;&quot;) &amp; &quot;.json&quot;&#xD;&#xA;System.IO.File.WriteAllText(System.IO.Path.Combine(folder, dataName), sb.ToString(), System.Text.Encoding.UTF8)&#xD;&#xA;Console.WriteLine(&quot;Portal data exported: &quot; &amp; System.IO.Path.Combine(folder, dataName))&#xD;&#xA;" DisplayName="Write recon report" sap:VirtualizedContainerService.HintSize="478.6666666666667,188" sap2010:WorkflowViewState.IdRef="InvokeCode_22">
              <ui:InvokeCode.Arguments>
                <InArgument x:TypeArguments="x:String" x:Key="summaryFilePath">[summaryFilePath]</InArgument>
                <InArgument x:TypeArguments="x:String" x:Key="accountNumber">[accountNumber]</InArgument>
                <InArgument x:TypeArguments="x:String" x:Key="manualJournalPath">[manualJournalPath]</InArgument>
                <InArgument x:TypeArguments="sd:DataTable" x:Key="dtInternalReport">[dtInternalReport]</InArgument>
                <InArgument x:TypeArguments="sd:DataTable" x:Key="dtExternalReport">[dtExternalReport]</InArgument>
                <InArgument x:TypeArguments="sd:DataTable" x:Key="dtMatchedPairs">[dtMatchedPairs]</InArgument>
                <InArgument x:TypeArguments="sd:DataTable" x:Key="dtManualLog">[dtManualLog]</InArgument>
              </ui:InvokeCode.Arguments>
            </ui:InvokeCode>
          </Sequence>
        </Sequence>
        <ui:ReportStatus DisplayName="Report Status" sap:VirtualizedContainerService.HintSize="546.6666666666666,124" sap2010:WorkflowViewState.IdRef="ReportStatus_5" StatusText="[&quot;RECONCILING &quot;+fileName +accountNumber+&quot; &quot;+ &quot;COMPLETED&quot;]" />
        <ui:LogMessage DisplayName="Log Message" sap:VirtualizedContainerService.HintSize="546.6666666666666,167.33333333333334" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info" Message="[&quot;RECONCILING &quot;+accountNumber+&quot; &quot;+fileName + &quot;COMPLETED&quot;]" />

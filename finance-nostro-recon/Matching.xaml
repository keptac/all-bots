                <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ============================================================================&#xA;'  MERGE HISTORICAL OUTSTANDING INTO THE STATEMENT POOL&#xA;' ============================================================================&#xA;'  Re-shapes the historical &quot;External outstanding&quot; rows onto dtSwiftFiltered's&#xA;'  schema and appends them to it IN MEMORY.&#xA;'&#xA;'  Why the re-shape: the rows used to reach the pool via&#xA;'  Append Range -&gt; Read Range on the &quot;Swift&quot; sheet, and Append Range writes&#xA;'  POSITIONALLY, not by header.  dtSwiftFiltered is now the camt.053 extract&#xA;'  (100+ columns) where the MT940 path handed over 18, so appending the ~12&#xA;'  column historical sheet as-is dropped every historical amount and reference&#xA;'  into an unrelated column: they could never match and their balances were lost.&#xA;'&#xA;'  Why in memory: merging two DataTables by pushing ~94k x 114 cells out to a&#xA;'  worksheet and reading them back is both the slowest step in the run and the&#xA;'  only reason correctness ever depended on Excel's positional append.  The&#xA;'  Append Range that follows now only maintains the &quot;Swift&quot; sheet as a working&#xA;'  copy - nothing downstream reads it back.&#xA;' ============================================================================&#xA;&#xA;Dim src As DataTable = dtSwiftHistorical&#xA;Dim dst As DataTable = dtSwiftFiltered.Clone()&#xA;&#xA;' historical column -&gt; camt column&#xA;Dim map As New Dictionary(Of String, String)(StringComparer.OrdinalIgnoreCase)&#xA;map.Add(&quot;TRN Date&quot;, &quot;Booking Date&quot;)&#xA;map.Add(&quot;Value Date&quot;, &quot;Value Date&quot;)&#xA;map.Add(&quot;DR&quot;, &quot;Debit&quot;)&#xA;map.Add(&quot;CR&quot;, &quot;Credit&quot;)&#xA;map.Add(&quot;TRN Reference&quot;, &quot;Transaction Reference&quot;)&#xA;map.Add(&quot;Source Reference&quot;, &quot;Related Reference (61)&quot;)&#xA;map.Add(&quot;UETR No&quot;, &quot;UETR&quot;)&#xA;map.Add(&quot;Narrative&quot;, &quot;Narrative&quot;)&#xA;map.Add(&quot;Transaction Type&quot;, &quot;Transaction Type&quot;)&#xA;&#xA;For Each sr As DataRow In src.Rows&#xA;    Dim dr As DataRow = dst.NewRow()&#xA;    For Each sc As DataColumn In src.Columns&#xA;        Dim name As String = sc.ColumnName.Trim()&#xA;        Dim target As String = Nothing&#xA;        If map.ContainsKey(name) Then&#xA;            target = map(name)&#xA;        ElseIf dst.Columns.Contains(name) Then&#xA;            ' a historical file already written by this process keeps the camt names&#xA;            target = name&#xA;        End If&#xA;        If target IsNot Nothing AndAlso dst.Columns.Contains(target) Then&#xA;            Dim v As Object = sr(sc)&#xA;            If v IsNot Nothing AndAlso Not IsDBNull(v) Then&#xA;                If dst.Columns(target).DataType Is GetType(Double) Then&#xA;                    Dim d As Double = 0&#xA;                    Double.TryParse(v.ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), d)&#xA;                    dr(target) = d&#xA;                ElseIf dst.Columns(target).DataType Is GetType(Integer) Then&#xA;                    Dim n As Integer = 0&#xA;                    Integer.TryParse(v.ToString().Trim(), n)&#xA;                    dr(target) = n&#xA;                Else&#xA;                    dr(target) = v.ToString()&#xA;                End If&#xA;            End If&#xA;        End If&#xA;    Next&#xA;    If dst.Columns.Contains(&quot;Source File&quot;) Then dr(&quot;Source File&quot;) = &quot;HISTORICAL&quot;&#xA;    dst.Rows.Add(dr)&#xA;Next&#xA;&#xA;Dim broughtForward As Integer = dtSwiftFiltered.Rows.Count&#xA;For Each r As DataRow In dst.Rows&#xA;    dtSwiftFiltered.ImportRow(r)&#xA;Next&#xA;&#xA;' still handed to Append Range so the &quot;Swift&quot; working sheet stays complete&#xA;dtSwiftHistorical = dst&#xA;&#xA;Console.WriteLine(&quot;Statement pool: &quot; &amp; broughtForward.ToString() &amp; &quot; current + &quot; &amp; dst.Rows.Count.ToString() &amp; &quot; historical = &quot; &amp; dtSwiftFiltered.Rows.Count.ToString() &amp; &quot; rows&quot;)&#xA;" DisplayName="Merge historical outstanding into statement pool" sap:VirtualizedContainerService.HintSize="449.6,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_1">

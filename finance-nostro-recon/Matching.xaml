            </sap:WorkflowViewStateService.ViewState>
            <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ============================================================================&#xA;'  READ THE MANUAL MATCH JOURNAL&#xA;' ============================================================================&#xA;'  Items that no rule can pair, but that a human knows belong together, are&#xA;'  ticketed in the portal and land here.  The journal is the durable record:&#xA;'  the bot rebuilds the whole pool from scratch every run, so a manual decision&#xA;'  is not a one-off edit, it is a rule that has to be replayed every day.&#xA;'&#xA;'  It therefore lives OUTSIDE the dated run folder - one file per account,&#xA;'  alongside the recon root - and is never written by the recon itself.&#xA;'&#xA;'    Match Ref, Side, Item Id, Status, Proposed By, Proposed On,&#xA;'    Approved By, Approved On, Reason&#xA;'&#xA;'  Side is CBS or STATEMENT. Only Status = APPROVED is applied, so a ticket&#xA;'  parked at any other status has no effect on the numbers. One Match Ref may&#xA;'  carry several legs on either side; the matcher holds the group to&#xA;'  SUM(ledger DR - CR) = SUM(statement CR - DR) and rejects it otherwise.&#xA;' ============================================================================&#xA;&#xA;Dim root As String = System.IO.Path.GetDirectoryName(System.IO.Path.GetDirectoryName(System.IO.Path.GetDirectoryName(summaryFilePath)))&#xA;Dim folder As String = System.IO.Path.Combine(root, &quot;Manual Matches&quot;)&#xA;manualJournalPath = System.IO.Path.Combine(folder, accountNumber &amp; &quot;.csv&quot;)&#xA;&#xA;dtManualMatches = New DataTable(&quot;Manual Matches&quot;)&#xA;dtManualMatches.Columns.Add(&quot;Match Ref&quot;)&#xA;dtManualMatches.Columns.Add(&quot;Side&quot;)&#xA;dtManualMatches.Columns.Add(&quot;Item Id&quot;)&#xA;dtManualMatches.Columns.Add(&quot;Status&quot;)&#xA;dtManualMatches.Columns.Add(&quot;Proposed By&quot;)&#xA;dtManualMatches.Columns.Add(&quot;Proposed On&quot;)&#xA;dtManualMatches.Columns.Add(&quot;Approved By&quot;)&#xA;dtManualMatches.Columns.Add(&quot;Approved On&quot;)&#xA;dtManualMatches.Columns.Add(&quot;Reason&quot;)&#xA;&#xA;Try&#xA;    If Not System.IO.Directory.Exists(folder) Then System.IO.Directory.CreateDirectory(folder)&#xA;&#xA;    If Not System.IO.File.Exists(manualJournalPath) Then&#xA;        ' bootstrap an empty journal so the portal has somewhere to write back to&#xA;        System.IO.File.WriteAllText(manualJournalPath, &quot;Match Ref,Side,Item Id,Status,Proposed By,Proposed On,Approved By,Approved On,Reason&quot; &amp; Environment.NewLine)&#xA;        Console.WriteLine(&quot;Manual match journal created: &quot; &amp; manualJournalPath)&#xA;    Else&#xA;        Dim lines() As String = System.IO.File.ReadAllLines(manualJournalPath)&#xA;        Dim hdr As New Dictionary(Of String, Integer)(StringComparer.OrdinalIgnoreCase)&#xA;&#xA;        For ln As Integer = 0 To lines.Length - 1&#xA;            Dim line As String = lines(ln)&#xA;            If line Is Nothing OrElse line.Trim().Length = 0 Then Continue For&#xA;&#xA;            ' split on commas that are not inside double quotes&#xA;            Dim fields As New List(Of String)()&#xA;            Dim cur As New System.Text.StringBuilder()&#xA;            Dim inQ As Boolean = False&#xA;            For p As Integer = 0 To line.Length - 1&#xA;                Dim ch As Char = line(p)&#xA;                If ch = &quot;&quot;&quot;&quot;c Then&#xA;                    If inQ AndAlso p + 1 &lt; line.Length AndAlso line(p + 1) = &quot;&quot;&quot;&quot;c Then&#xA;                        cur.Append(&quot;&quot;&quot;&quot;c)&#xA;                        p += 1&#xA;                    Else&#xA;                        inQ = Not inQ&#xA;                    End If&#xA;                ElseIf ch = &quot;,&quot;c AndAlso Not inQ Then&#xA;                    fields.Add(cur.ToString())&#xA;                    cur.Length = 0&#xA;                Else&#xA;                    cur.Append(ch)&#xA;                End If&#xA;            Next&#xA;            fields.Add(cur.ToString())&#xA;&#xA;            If hdr.Count = 0 Then&#xA;                For c As Integer = 0 To fields.Count - 1&#xA;                    Dim nm As String = fields(c).Trim()&#xA;                    If nm.Length &gt; 0 AndAlso Not hdr.ContainsKey(nm) Then hdr.Add(nm, c)&#xA;                Next&#xA;                Continue For&#xA;            End If&#xA;&#xA;            Dim nr As DataRow = dtManualMatches.NewRow()&#xA;            For Each col As DataColumn In dtManualMatches.Columns&#xA;                Dim ix As Integer = -1&#xA;                If hdr.TryGetValue(col.ColumnName, ix) AndAlso ix &lt; fields.Count Then nr(col.ColumnName) = fields(ix).Trim()&#xA;            Next&#xA;            dtManualMatches.Rows.Add(nr)&#xA;        Next&#xA;&#xA;        Dim approved As Integer = dtManualMatches.AsEnumerable().Where(Function(x) x(&quot;Status&quot;).ToString().Trim().ToUpperInvariant() = &quot;APPROVED&quot;).Count()&#xA;        Console.WriteLine(&quot;Manual match journal: &quot; &amp; dtManualMatches.Rows.Count.ToString() &amp; &quot; legs, &quot; &amp; approved.ToString() &amp; &quot; approved -&gt; &quot; &amp; manualJournalPath)&#xA;    End If&#xA;Catch ex As Exception&#xA;    ' a missing or unreadable journal must never stop the reconciliation&#xA;    Console.WriteLine(&quot;Manual match journal could not be read (&quot; &amp; ex.Message &amp; &quot;) - continuing with automatic matching only&quot;)&#xA;End Try&#xA;" DisplayName="Read manual match journal" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_9004">
              <ui:InvokeCode.Arguments>
                <InArgument x:TypeArguments="x:String" x:Key="summaryFilePath">[summaryFilePath]</InArgument>
                <InArgument x:TypeArguments="x:String" x:Key="accountNumber">[accountNumber]</InArgument>
                <OutArgument x:TypeArguments="sd:DataTable" x:Key="dtManualMatches">[dtManualMatches]</OutArgument>
                <OutArgument x:TypeArguments="x:String" x:Key="manualJournalPath">[manualJournalPath]</OutArgument>
              </ui:InvokeCode.Arguments>
            </ui:InvokeCode>
            <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ============================================================================&#xA;'  PAIRWISE (1:1) LEDGER &lt;-&gt; STATEMENT MATCHING&#xA;' ============================================================================&#xA;'  Replaces the previous approach, which classified each side independently by&#xA;'  asking &quot;does a row with this reference+amount exist on the other side?&quot;.&#xA;'  That is a set-membership test, not a pairing: several ledger rows could all&#xA;'  be flagged matched against a single statement row (and vice versa), so the&#xA;'  matched value on one side did not equal the matched value on the other and&#xA;'  the Summary &quot;Check_Balance&quot; came out non-zero.&#xA;'&#xA;'  Corrected ledger balance and corrected statement balance only agree when the&#xA;'  matching is a bijection, so every match here consumes exactly one row on each&#xA;'  side.&#xA;'&#xA;'  Passes, in order:&#xA;'    pass 0  MANUAL  - approved tickets from the manual match journal. Human&#xA;'                      intent is authoritative, so these are applied before any&#xA;'                      automatic rule can claim a row.&#xA;'    pass 1  UETR                                        (globally unique)&#xA;'    pass 2  MsgId / Related Ref (21) / Related Ref (61) / EndToEndId&#xA;'            against TRN_REF_NO / SOURCE_REF_NO&#xA;'&#xA;'  Direction is enforced: a ledger DEBIT settles a statement CREDIT and a&#xA;'  ledger CREDIT settles a statement DEBIT.  A manual ticket may pair several&#xA;'  rows against several rows, so it is held to the same rule in aggregate:&#xA;'      SUM(ledger DR - CR)  =  SUM(statement CR - DR)&#xA;'  A ticket that does not balance is REJECTED rather than applied, because&#xA;'  applying it would push Summary!Check_Balance off zero.&#xA;'&#xA;'  Every match is appended to dtMatchedPairs, all legs of one match sharing a&#xA;'  Match Id, which the &quot;Matched Pairs&quot; sheet renders in colour.&#xA;' ============================================================================&#xA;&#xA;' ---------------------------------------------------------------- Item Id ---&#xA;' A stable, content-derived id for every row, so a human ticket raised today&#xA;' still points at the same item after tomorrow's run rebuilds the pool from&#xA;' scratch. An id that arrives on a carried-forward row is preserved; only new&#xA;' rows are stamped.&#xA;If Not dtLedger.Columns.Contains(&quot;Item Id&quot;) Then dtLedger.Columns.Add(&quot;Item Id&quot;)&#xA;If Not dtSwiftFiltered.Columns.Contains(&quot;Item Id&quot;) Then dtSwiftFiltered.Columns.Add(&quot;Item Id&quot;)&#xA;&#xA;Dim sha As System.Security.Cryptography.SHA1 = System.Security.Cryptography.SHA1.Create()&#xA;Dim seenId As New Dictionary(Of String, Integer)(StringComparer.OrdinalIgnoreCase)&#xA;&#xA;Dim G = Function(r As DataRow, c As String) CStr(If(r.Table.Columns.Contains(c) AndAlso Not IsDBNull(r(c)), r(c).ToString().Trim(), &quot;&quot;))&#xA;Dim N = Function(r As DataRow, c As String) As Double&#xA;            Dim d As Double = 0&#xA;            If r.Table.Columns.Contains(c) AndAlso Not IsDBNull(r(c)) Then Double.TryParse(r(c).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), d)&#xA;            Return Math.Round(d, 2)&#xA;        End Function&#xA;&#xA;Dim swiftRows As List(Of DataRow)  = dtSwiftFiltered.AsEnumerable().ToList()&#xA;Dim ledgerRows As List(Of DataRow) = dtLedger.AsEnumerable().ToList()&#xA;&#xA;Dim sDr(Math.Max(0, swiftRows.Count - 1)) As Double&#xA;Dim sCr(Math.Max(0, swiftRows.Count - 1)) As Double&#xA;Dim lDr(Math.Max(0, ledgerRows.Count - 1)) As Double&#xA;Dim lCr(Math.Max(0, ledgerRows.Count - 1)) As Double&#xA;&#xA;Dim byItemId As New Dictionary(Of String, Integer)(StringComparer.OrdinalIgnoreCase)&#xA;Dim idSideL As New Dictionary(Of String, Integer)(StringComparer.OrdinalIgnoreCase)&#xA;&#xA;For i As Integer = 0 To ledgerRows.Count - 1&#xA;    Dim r As DataRow = ledgerRows(i)&#xA;    lDr(i) = N(r, &quot;DEBIT&quot;)&#xA;    lCr(i) = N(r, &quot;CREDIT&quot;)&#xA;    Dim id As String = G(r, &quot;Item Id&quot;)&#xA;    If id.Length = 0 Then&#xA;        Dim raw As String = &quot;L|&quot; &amp; G(r, &quot;TRN_REF_NO&quot;) &amp; &quot;|&quot; &amp; G(r, &quot;SOURCE_REF_NO&quot;) &amp; &quot;|&quot; &amp; G(r, &quot;UETR_NO&quot;) &amp; &quot;|&quot; &amp; lDr(i).ToString(&quot;F2&quot;) &amp; &quot;|&quot; &amp; lCr(i).ToString(&quot;F2&quot;) &amp; &quot;|&quot; &amp; G(r, &quot;TRN_DT&quot;)&#xA;        Dim b() As Byte = sha.ComputeHash(System.Text.Encoding.UTF8.GetBytes(raw.ToUpperInvariant()))&#xA;        Dim hx As New System.Text.StringBuilder()&#xA;        For k As Integer = 0 To 5&#xA;            hx.Append(b(k).ToString(&quot;X2&quot;))&#xA;        Next&#xA;        id = &quot;L-&quot; &amp; hx.ToString()&#xA;        Dim seq As Integer = 0&#xA;        If seenId.TryGetValue(id, seq) Then&#xA;            seq += 1&#xA;            seenId(id) = seq&#xA;            id = id &amp; &quot;-&quot; &amp; seq.ToString()&#xA;        Else&#xA;            seenId.Add(id, 1)&#xA;        End If&#xA;        r(&quot;Item Id&quot;) = id&#xA;    End If&#xA;    If Not idSideL.ContainsKey(id) Then idSideL.Add(id, i)&#xA;Next&#xA;&#xA;For i As Integer = 0 To swiftRows.Count - 1&#xA;    Dim r As DataRow = swiftRows(i)&#xA;    sDr(i) = N(r, &quot;Debit&quot;)&#xA;    sCr(i) = N(r, &quot;Credit&quot;)&#xA;    Dim id As String = G(r, &quot;Item Id&quot;)&#xA;    If id.Length = 0 Then&#xA;        Dim dt As String = G(r, &quot;Booking Date&quot;)&#xA;        If dt.Length = 0 Then dt = G(r, &quot;Value Date&quot;)&#xA;        Dim raw As String = &quot;S|&quot; &amp; G(r, &quot;Transaction Reference&quot;) &amp; &quot;|&quot; &amp; G(r, &quot;Related Reference (61)&quot;) &amp; &quot;|&quot; &amp; G(r, &quot;UETR&quot;) &amp; &quot;|&quot; &amp; sDr(i).ToString(&quot;F2&quot;) &amp; &quot;|&quot; &amp; sCr(i).ToString(&quot;F2&quot;) &amp; &quot;|&quot; &amp; dt&#xA;        Dim b() As Byte = sha.ComputeHash(System.Text.Encoding.UTF8.GetBytes(raw.ToUpperInvariant()))&#xA;        Dim hx As New System.Text.StringBuilder()&#xA;        For k As Integer = 0 To 5&#xA;            hx.Append(b(k).ToString(&quot;X2&quot;))&#xA;        Next&#xA;        id = &quot;S-&quot; &amp; hx.ToString()&#xA;        Dim seq As Integer = 0&#xA;        If seenId.TryGetValue(id, seq) Then&#xA;            seq += 1&#xA;            seenId(id) = seq&#xA;            id = id &amp; &quot;-&quot; &amp; seq.ToString()&#xA;        Else&#xA;            seenId.Add(id, 1)&#xA;        End If&#xA;        r(&quot;Item Id&quot;) = id&#xA;    End If&#xA;    If Not byItemId.ContainsKey(id) Then byItemId.Add(id, i)&#xA;Next&#xA;&#xA;dtSwiftOutstanding  = dtSwiftFiltered.Clone()&#xA;dtSwiftMatched      = dtSwiftFiltered.Clone()&#xA;dtLedgerOutstanding = dtLedger.Clone()&#xA;dtLedgerMatched     = dtLedger.Clone()&#xA;&#xA;If dtMatchedPairs Is Nothing OrElse dtMatchedPairs.Columns.Count = 0 Then&#xA;    dtMatchedPairs = New DataTable(&quot;Matched Pairs&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Match Id&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Matched On&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Source&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;TRN Date&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Value Date&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;TRN Reference&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Source Reference&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;UETR No&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;DR&quot;, GetType(Double))&#xA;    dtMatchedPairs.Columns.Add(&quot;CR&quot;, GetType(Double))&#xA;    dtMatchedPairs.Columns.Add(&quot;Narrative&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Item Id&quot;)&#xA;End If&#xA;&#xA;dtManualLog = New DataTable(&quot;Manual Match Log&quot;)&#xA;dtManualLog.Columns.Add(&quot;Match Ref&quot;)&#xA;dtManualLog.Columns.Add(&quot;Outcome&quot;)&#xA;dtManualLog.Columns.Add(&quot;Detail&quot;)&#xA;dtManualLog.Columns.Add(&quot;Ledger Legs&quot;)&#xA;dtManualLog.Columns.Add(&quot;Statement Legs&quot;)&#xA;dtManualLog.Columns.Add(&quot;Ledger Net&quot;, GetType(Double))&#xA;dtManualLog.Columns.Add(&quot;Statement Net&quot;, GetType(Double))&#xA;&#xA;Dim swiftUsed(Math.Max(0, swiftRows.Count - 1)) As Boolean&#xA;Dim ledgerUsed(Math.Max(0, ledgerRows.Count - 1)) As Boolean&#xA;&#xA;Dim pairNo As Integer = 0&#xA;Dim pass0 As Integer = 0&#xA;Dim pass1 As Integer = 0&#xA;Dim pass2 As Integer = 0&#xA;&#xA;' ------------------------------------------------- pass 0 : manual tickets ---&#xA;If dtManualMatches IsNot Nothing AndAlso dtManualMatches.Rows.Count &gt; 0 Then&#xA;&#xA;    Dim groups As New Dictionary(Of String, List(Of DataRow))(StringComparer.OrdinalIgnoreCase)&#xA;    Dim order As New List(Of String)()&#xA;    For Each mr As DataRow In dtManualMatches.Rows&#xA;        Dim status As String = G(mr, &quot;Status&quot;).ToUpperInvariant()&#xA;        If status &lt;&gt; &quot;APPROVED&quot; Then Continue For&#xA;        Dim ref As String = G(mr, &quot;Match Ref&quot;)&#xA;        If ref.Length = 0 Then Continue For&#xA;        Dim lst As List(Of DataRow) = Nothing&#xA;        If Not groups.TryGetValue(ref, lst) Then&#xA;            lst = New List(Of DataRow)()&#xA;            groups.Add(ref, lst)&#xA;            order.Add(ref)&#xA;        End If&#xA;        lst.Add(mr)&#xA;    Next&#xA;&#xA;    For Each ref As String In order&#xA;        Dim legs As List(Of DataRow) = groups(ref)&#xA;        Dim li As New List(Of Integer)()&#xA;        Dim si As New List(Of Integer)()&#xA;        Dim bad As String = &quot;&quot;&#xA;&#xA;        For Each leg As DataRow In legs&#xA;            Dim side As String = G(leg, &quot;Side&quot;).ToUpperInvariant()&#xA;            Dim itemId As String = G(leg, &quot;Item Id&quot;)&#xA;            If itemId.Length = 0 Then&#xA;                bad = &quot;leg with no Item Id&quot;&#xA;                Exit For&#xA;            End If&#xA;            If side = &quot;CBS&quot; OrElse side = &quot;LEDGER&quot; Then&#xA;                Dim ix As Integer = -1&#xA;                If Not idSideL.TryGetValue(itemId, ix) Then&#xA;                    bad = &quot;ledger item not outstanding: &quot; &amp; itemId&#xA;                    Exit For&#xA;                End If&#xA;                If ledgerUsed(ix) OrElse li.Contains(ix) Then&#xA;                    bad = &quot;ledger item already matched: &quot; &amp; itemId&#xA;                    Exit For&#xA;                End If&#xA;                li.Add(ix)&#xA;            ElseIf side = &quot;STATEMENT&quot; OrElse side = &quot;SWIFT&quot; Then&#xA;                Dim ix As Integer = -1&#xA;                If Not byItemId.TryGetValue(itemId, ix) Then&#xA;                    bad = &quot;statement item not outstanding: &quot; &amp; itemId&#xA;                    Exit For&#xA;                End If&#xA;                If swiftUsed(ix) OrElse si.Contains(ix) Then&#xA;                    bad = &quot;statement item already matched: &quot; &amp; itemId&#xA;                    Exit For&#xA;                End If&#xA;                si.Add(ix)&#xA;            Else&#xA;                bad = &quot;unrecognised Side: &quot; &amp; side&#xA;                Exit For&#xA;            End If&#xA;        Next&#xA;&#xA;        Dim lNet As Double = 0&#xA;        Dim sNet As Double = 0&#xA;        For Each ix As Integer In li&#xA;            lNet += lDr(ix) - lCr(ix)&#xA;        Next&#xA;        For Each ix As Integer In si&#xA;            sNet += sCr(ix) - sDr(ix)&#xA;        Next&#xA;        lNet = Math.Round(lNet, 2)&#xA;        sNet = Math.Round(sNet, 2)&#xA;&#xA;        If bad.Length = 0 AndAlso (li.Count = 0 OrElse si.Count = 0) Then bad = &quot;a ticket needs at least one leg on each side&quot;&#xA;        If bad.Length = 0 AndAlso lNet &lt;&gt; sNet Then bad = &quot;does not balance: ledger net &quot; &amp; lNet.ToString(&quot;F2&quot;) &amp; &quot; vs statement net &quot; &amp; sNet.ToString(&quot;F2&quot;)&#xA;&#xA;        If bad.Length &gt; 0 Then&#xA;            dtManualLog.Rows.Add(ref, &quot;REJECTED&quot;, bad, li.Count.ToString(), si.Count.ToString(), lNet, sNet)&#xA;            Continue For&#xA;        End If&#xA;&#xA;        pairNo += 1&#xA;        Dim matchId As String = &quot;M&quot; &amp; pairNo.ToString(&quot;000000&quot;)&#xA;        Dim how As String = &quot;Manual &quot; &amp; ref&#xA;        For Each ix As Integer In li&#xA;            ledgerUsed(ix) = True&#xA;            Dim lr As DataRow = ledgerRows(ix)&#xA;            dtMatchedPairs.Rows.Add(matchId, how, &quot;CBS&quot;, G(lr, &quot;TRN_DT&quot;), G(lr, &quot;VALUE_DT&quot;), G(lr, &quot;TRN_REF_NO&quot;), G(lr, &quot;SOURCE_REF_NO&quot;), G(lr, &quot;UETR_NO&quot;), lDr(ix), lCr(ix), G(lr, &quot;NARRATIVE&quot;), G(lr, &quot;Item Id&quot;))&#xA;        Next&#xA;        For Each ix As Integer In si&#xA;            swiftUsed(ix) = True&#xA;            Dim sr As DataRow = swiftRows(ix)&#xA;            dtMatchedPairs.Rows.Add(matchId, how, &quot;STATEMENT&quot;, G(sr, &quot;Booking Date&quot;), G(sr, &quot;Value Date&quot;), G(sr, &quot;Transaction Reference&quot;), G(sr, &quot;Related Reference (61)&quot;), G(sr, &quot;UETR&quot;), sDr(ix), sCr(ix), G(sr, &quot;Narrative&quot;), G(sr, &quot;Item Id&quot;))&#xA;        Next&#xA;        pass0 += 1&#xA;        dtManualLog.Rows.Add(ref, &quot;APPLIED&quot;, matchId, li.Count.ToString(), si.Count.ToString(), lNet, sNet)&#xA;    Next&#xA;End If&#xA;&#xA;' ------------------------------------------- passes 1 and 2 : automatic ------&#xA;Dim swiftRefCols As String()  = {&quot;Transaction Reference&quot;, &quot;Related Reference (21)&quot;, &quot;Related Reference (61)&quot;, &quot;End To End Id&quot;}&#xA;Dim ledgerRefCols As String() = {&quot;TRN_REF_NO&quot;, &quot;SOURCE_REF_NO&quot;}&#xA;&#xA;Dim idxUetr As New Dictionary(Of String, List(Of Integer))&#xA;Dim idxRef As New Dictionary(Of String, List(Of Integer))&#xA;Dim key As String = &quot;&quot;&#xA;Dim bucket As List(Of Integer) = Nothing&#xA;&#xA;For i As Integer = 0 To swiftRows.Count - 1&#xA;    Dim r As DataRow = swiftRows(i)&#xA;    key = G(r, &quot;UETR&quot;).Replace(&quot; &quot;, &quot;&quot;).ToUpperInvariant()&#xA;    If key.Length &gt; 0 Then&#xA;        If Not idxUetr.TryGetValue(key, bucket) Then&#xA;            bucket = New List(Of Integer)()&#xA;            idxUetr.Add(key, bucket)&#xA;        End If&#xA;        bucket.Add(i)&#xA;    End If&#xA;    For Each c As String In swiftRefCols&#xA;        key = G(r, c).Replace(&quot; &quot;, &quot;&quot;).ToUpperInvariant()&#xA;        If key.Length &gt; 0 Then&#xA;            If Not idxRef.TryGetValue(key, bucket) Then&#xA;                bucket = New List(Of Integer)()&#xA;                idxRef.Add(key, bucket)&#xA;            End If&#xA;            bucket.Add(i)&#xA;        End If&#xA;    Next&#xA;Next&#xA;&#xA;For pass As Integer = 1 To 2&#xA;    For i As Integer = 0 To ledgerRows.Count - 1&#xA;        If ledgerUsed(i) Then Continue For&#xA;        Dim lr As DataRow = ledgerRows(i)&#xA;        If lDr(i) = 0 AndAlso lCr(i) = 0 Then Continue For&#xA;&#xA;        Dim keys As New List(Of String)()&#xA;        If pass = 1 Then&#xA;            keys.Add(G(lr, &quot;UETR_NO&quot;).Replace(&quot; &quot;, &quot;&quot;).ToUpperInvariant())&#xA;        Else&#xA;            For Each c As String In ledgerRefCols&#xA;                keys.Add(G(lr, c).Replace(&quot; &quot;, &quot;&quot;).ToUpperInvariant())&#xA;            Next&#xA;        End If&#xA;&#xA;        Dim hit As Integer = -1&#xA;        For Each k As String In keys&#xA;            If k.Length = 0 Then Continue For&#xA;            bucket = Nothing&#xA;            Dim found As Boolean = False&#xA;            If pass = 1 Then&#xA;                found = idxUetr.TryGetValue(k, bucket)&#xA;            Else&#xA;                found = idxRef.TryGetValue(k, bucket)&#xA;            End If&#xA;            If Not found Then Continue For&#xA;            For Each j As Integer In bucket&#xA;                If swiftUsed(j) Then Continue For&#xA;                ' ledger DEBIT settles statement CREDIT, ledger CREDIT settles statement DEBIT&#xA;                If lDr(i) = sCr(j) AndAlso lCr(i) = sDr(j) Then&#xA;                    hit = j&#xA;                    Exit For&#xA;                End If&#xA;            Next&#xA;            If hit &gt;= 0 Then Exit For&#xA;        Next&#xA;&#xA;        If hit &gt;= 0 Then&#xA;            ledgerUsed(i) = True&#xA;            swiftUsed(hit) = True&#xA;            If pass = 1 Then&#xA;                pass1 += 1&#xA;            Else&#xA;                pass2 += 1&#xA;            End If&#xA;&#xA;            pairNo += 1&#xA;            Dim matchId As String = &quot;M&quot; &amp; pairNo.ToString(&quot;000000&quot;)&#xA;            Dim how As String = &quot;Reference&quot;&#xA;            If pass = 1 Then how = &quot;UETR&quot;&#xA;            Dim sr As DataRow = swiftRows(hit)&#xA;&#xA;            dtMatchedPairs.Rows.Add(matchId, how, &quot;CBS&quot;, G(lr, &quot;TRN_DT&quot;), G(lr, &quot;VALUE_DT&quot;), G(lr, &quot;TRN_REF_NO&quot;), G(lr, &quot;SOURCE_REF_NO&quot;), G(lr, &quot;UETR_NO&quot;), lDr(i), lCr(i), G(lr, &quot;NARRATIVE&quot;), G(lr, &quot;Item Id&quot;))&#xA;            dtMatchedPairs.Rows.Add(matchId, how, &quot;STATEMENT&quot;, G(sr, &quot;Booking Date&quot;), G(sr, &quot;Value Date&quot;), G(sr, &quot;Transaction Reference&quot;), G(sr, &quot;Related Reference (61)&quot;), G(sr, &quot;UETR&quot;), sDr(hit), sCr(hit), G(sr, &quot;Narrative&quot;), G(sr, &quot;Item Id&quot;))&#xA;        End If&#xA;    Next&#xA;Next&#xA;&#xA;For i As Integer = 0 To ledgerRows.Count - 1&#xA;    If ledgerUsed(i) Then&#xA;        dtLedgerMatched.ImportRow(ledgerRows(i))&#xA;    Else&#xA;        dtLedgerOutstanding.ImportRow(ledgerRows(i))&#xA;    End If&#xA;Next&#xA;&#xA;For j As Integer = 0 To swiftRows.Count - 1&#xA;    If swiftUsed(j) Then&#xA;        dtSwiftMatched.ImportRow(swiftRows(j))&#xA;    Else&#xA;        dtSwiftOutstanding.ImportRow(swiftRows(j))&#xA;    End If&#xA;Next&#xA;&#xA;Console.WriteLine(&quot;Manual tickets applied: &quot; &amp; pass0.ToString() &amp; &quot; (rejected &quot; &amp; (dtManualLog.Rows.Count - pass0).ToString() &amp; &quot;)&quot;)&#xA;Console.WriteLine(&quot;Automatic pairs: &quot; &amp; (pass1 + pass2).ToString() &amp; &quot; (UETR &quot; &amp; pass1.ToString() &amp; &quot;, reference &quot; &amp; pass2.ToString() &amp; &quot;)&quot;)&#xA;Console.WriteLine(&quot;Ledger    matched &quot; &amp; dtLedgerMatched.Rows.Count.ToString() &amp; &quot; / outstanding &quot; &amp; dtLedgerOutstanding.Rows.Count.ToString())&#xA;Console.WriteLine(&quot;Statement matched &quot; &amp; dtSwiftMatched.Rows.Count.ToString() &amp; &quot; / outstanding &quot; &amp; dtSwiftOutstanding.Rows.Count.ToString())&#xA;" DisplayName="Pairwise match ledger and statement" sap:VirtualizedContainerService.HintSize="478.4,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_12">

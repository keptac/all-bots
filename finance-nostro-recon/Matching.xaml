            <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ============================================================================&#xA;'  NARRATIVE MATCHING - PAIRWISE (1:1)&#xA;' ============================================================================&#xA;'  A statement item is settled by a ledger item whose NARRATIVE quotes the&#xA;'  statement reference and whose amount mirrors it (statement Debit &lt;-&gt; ledger&#xA;'  Credit).  As before, but each side now CONSUMES its partner: previously both&#xA;'  sides were classified independently, so one ledger narrative could clear many&#xA;'  statement rows (and vice versa) and the two &quot;matched&quot; totals diverged, which&#xA;'  is what pushed Summary!Check_Balance off zero.&#xA;'&#xA;'  Pairs are appended to dtMatchedPairs, sharing a Match Id with their partner,&#xA;'  for the &quot;Matched Pairs&quot; workbook.&#xA;' ============================================================================&#xA;&#xA;Dim REFCOL As String = &quot;Transaction Reference&quot;&#xA;Dim MINLEN As Integer = 6&#xA;Dim HOW As String = &quot;Narrative (Transaction Reference)&quot;&#xA;&#xA;Dim swiftRows As List(Of DataRow)  = dtSwiftOutstanding.AsEnumerable().ToList()&#xA;Dim ledgerRows As List(Of DataRow) = dtLedgerOutstandingNonSettlements.AsEnumerable().ToList()&#xA;Dim swiftCount As Integer  = swiftRows.Count&#xA;Dim ledgerCount As Integer = ledgerRows.Count&#xA;&#xA;If dtMatchedPairs Is Nothing OrElse dtMatchedPairs.Columns.Count = 0 Then&#xA;    dtMatchedPairs = New DataTable(&quot;Matched Pairs&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Match Id&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Matched On&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Source&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;TRN Date&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Value Date&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;TRN Reference&quot;)&#xA;    dtMatchedPairs.Columns.Add(&quot;Source Reference&quot;)&#xA;    dt
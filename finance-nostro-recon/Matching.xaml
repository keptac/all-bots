            <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim inputDate As String&#xA;Dim convertedDate As String&#xA;Dim ageCount As Double = 0&#xA;' Use the date itself - round-tripping it through a dd/MM/yyyy string and&#xA;' DateTime.Parse throws under an M/d/yyyy culture on any day past the 12th.&#xA;Dim fileDate As DateTime = DateTime.Today&#xA;' Parse the row dates against the formats that actually occur (CBS yyyyMMdd once&#xA;' normalised, camt yyyy-MM-dd, report yyyy/MM/dd) rather than relying on the&#xA;' machine culture.&#xA;Dim ParseRowDate = Function(v As String) DateTime.ParseExact(v.Trim(), New String() {&quot;yyyy/MM/dd&quot;, &quot;yyyy-MM-dd&quot;, &quot;yyyyMMdd&quot;, &quot;dd/MM/yyyy&quot;}, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None)&#xA;&#xA;For Each row As DataRow In dtSwiftOutstanding.AsEnumerable()&#xA;    inputDate = row(&quot;Value Date&quot;).ToString() ' Assuming column name is &quot;YourDateColumn&quot; where &quot;240925&quot; is stored&#xA;    If inputDate.Length = 6 Then&#xA;        ' Convert the inputDate from &quot;240925&quot; to &quot;2024/09/25&quot;&#xA;        Dim year As String = &quot;20&quot; &amp; inputDate.Substring(0, 2)&#xA;        Dim month As String = inputDate.Substring(2, 2)&#xA;        Dim day As String = inputDate.Substring(4, 2)&#xA;        convertedDate = year &amp; &quot;/&quot; &amp; month &amp; &quot;/&quot; &amp; day&#xA;        &#xA;        ' Set the converted date back to the DataTable&#xA;        row(&quot;Value Date&quot;) = convertedDate&#xA;    End If&#xA;&#x9;&#xA;&#x9;&#xA;&#x9;&#xA;&#x9;Try&#xA;&#x9;&#x9;&#x9;ageCount = (fileDate - ParseRowDate(row(&quot;Value Date&quot;).ToString())).TotalDays&#xA;&#x9;Catch inEx As Exception&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;Try&#xA;&#x9;&#x9;&#x9;&#x9;ageCount = (fileDate - DateTime.FromOADate(Double.Parse(row(&quot;Value Date&quot;).ToString))).TotalDays&#xA;&#x9;&#x9;&#x9;Catch oaEx As Exception&#xA;&#x9;&#x9;&#x9;&#x9;System.Console.WriteLine(oaEx)&#xA;&#x9;&#x9;&#x9;End Try&#xA;&#x9;End Try &#xA;&#x9;&#x9;&#xA;&#x9;Try&#xA;&#x9;&#x9;row(&quot;Aging&quot;) = ageCount.ToString&#xA;&#x9;&#xA;&#x9;&#x9;If ageCount&lt;4 Then&#xA;&#x9;&#x9;&#x9;row(&quot;Aging Group&quot;) = &quot;0-3 Days&quot;&#xA;&#x9;&#x9;Else If ageCount&lt; 31 Then&#xA;&#x9;&#x9;&#x9;row(&quot;Aging Group&quot;) = &quot;4-30 Days&quot;&#xA;&#x9;&#x9;Else If ageCount&lt; 61 Then&#xA;&#x9;&#x9;&#x9;row(&quot;Aging Group&quot;) = &quot;31-60 Days&quot;&#xA;&#x9;&#x9;Else If  ageCount&lt; 90 Then&#xA;&#x9;&#x9;&#x9;row(&quot;Aging Group&quot;) = &quot;61-90 Days&quot;&#xA;&#x9;&#x9;Else&#xA;&#x9;&#x9;&#x9;row(&quot;Aging Group&quot;) = &quot;Above 90 Days&quot;&#xA;&#x9;&#x9;End If&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;If ageCount&lt;30 Then&#xA;&#x9;&#x9;&#x9;row(&quot;BOT Classification&quot;) = &quot;Normal&quot;&#xA;&#x9;&#x9;Else If ageCount&lt; 60 Then&#xA;&#x9;&#x9;&#x9;row(&quot;BOT Classification&quot;) = &quot;Especially Mentioned&quot;&#xA;&#x9;&#x9;Else If ageCount&lt; 90 Then&#xA;&#x9;&#x9;&#x9;row(&quot;BOT Classification&quot;) = &quot;Substandard&quot;&#xA;&#x9;&#x9;Else If  ageCount&lt; 180 Then&#xA;&#x9;&#x9;&#x9;row(&quot;BOT Classification&quot;) = &quot;Doubtful&quot;&#xA;&#x9;&#x9;Else&#xA;&#x9;&#x9;&#x9;row(&quot;BOT Classification&quot;) = &quot;Loss&quot;&#xA;&#x9;&#x9;End If&#xA;&#x9;Catch ed As Exception&#xA;&#x9;End Try&#xA;Next&#xA;&#xA;" DisplayName="Age the statement outstanding" sap:VirtualizedContainerService.HintSize="478.4,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_5">

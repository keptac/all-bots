                              <ui:InvokeCode ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="Missing statement pages uploaded on the Nostro portal land in &lt;report root&gt;\Missing Pages and were staged by Unattended-statements-fetch whatever their date. Now that the reports are written they are moved to Missing Pages\Processed\&lt;run time&gt;, and the email lists each one. A run that fails before this step leaves them in place for the next run. A STATEMENT_DATE re-run picks them up too." Code="' Moves the hand-downloaded pages this run reconciled out of the Missing Pages&#xA;' drop folder, so the next run does not stage them again, and tells the email&#xA;' reader what went in. It runs only once the reports are written: a run that&#xA;' fails before this point leaves the pages where they are and the next run&#xA;' tries again.&#xA;'&#xA;' manualPages comes from staging, one line per file:&#xA;'   KIND|share|source path|length|last write UTC ticks|note&#xA;' A file that changed after it was staged is left in place - the run used the&#xA;' older copy, so the new one still has to go in.&#xA;&#xA;Dim inv As System.Globalization.CultureInfo = System.Globalization.CultureInfo.InvariantCulture&#xA;Dim Enc = Function(v As String) System.Net.WebUtility.HtmlEncode(If(v, &quot;&quot;))&#xA;Dim rows As New List(Of String())()&#xA;Dim moved As Integer = 0&#xA;Dim root As String = If(manualPagesRoot, &quot;&quot;).Trim().TrimEnd(&quot;\&quot;c)&#xA;&#xA;If Not String.IsNullOrWhiteSpace(manualPages) AndAlso root.Length &gt; 0 Then&#xA;    ' Who uploaded each page, from the portal's log:&#xA;    ' When,User,Action,Standard,File,Bytes,SHA256 - the last UPLOAD of a name wins.&#xA;    Dim uploader As New Dictionary(Of String, String)(StringComparer.OrdinalIgnoreCase)&#xA;    Try&#xA;        Dim logPath As String = Path.Combine(root, &quot;upload-log.csv&quot;)&#xA;        If File.Exists(logPath) Then&#xA;            Using ls As New FileStream(logPath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite)&#xA;                Using lr As New StreamReader(ls)&#xA;                    lr.ReadLine()&#xA;                    While Not lr.EndOfStream&#xA;                        Dim lc As String() = lr.ReadLine().Split(&quot;,&quot;c)&#xA;                        If lc.Length &gt;= 5 AndAlso lc(2) = &quot;UPLOAD&quot; Then uploader(lc(3) &amp; &quot;\&quot; &amp; lc(4)) = lc(1).Trim(&quot;&quot;&quot;&quot;c)&#xA;                    End While&#xA;                End Using&#xA;            End Using&#xA;        End If&#xA;    Catch ex As Exception&#xA;        Console.WriteLine(&quot;Could not read the upload log: &quot; &amp; ex.Message)&#xA;    End Try&#xA;&#xA;    Dim batch As String = DateTime.Now.ToString(&quot;yyyy-MM-dd HHmm&quot;, inv)&#xA;    Dim processed As String = Path.Combine(root, &quot;Processed&quot;, batch)&#xA;    For Each raw As String In manualPages.Split(New String() {vbCrLf, vbLf}, StringSplitOptions.RemoveEmptyEntries)&#xA;        Dim c As String() = raw.Split(&quot;|&quot;c)&#xA;        If c.Length &lt; 6 Then Continue For&#xA;        Dim kind As String = c(0)&#xA;        Dim src As String = c(2)&#xA;        Dim note As String = String.Join(&quot;|&quot;, c.Skip(5))&#xA;        Dim rel As String = src&#xA;        If src.StartsWith(root &amp; &quot;\&quot;, StringComparison.OrdinalIgnoreCase) Then rel = src.Substring(root.Length + 1)&#xA;&#xA;        If kind = &quot;UNUSED&quot; Then&#xA;            rows.Add(New String() {rel, &quot;Not used: &quot; &amp; note &amp; &quot;. Left in the drop folder.&quot;})&#xA;            Continue For&#xA;        End If&#xA;&#xA;        Dim outcome As String = If(kind = &quot;STAGED&quot;, &quot;Reconciled in this run&quot;, &quot;Not added: the same file was already on the share (&quot; &amp; note &amp; &quot;)&quot;)&#xA;        If uploader.ContainsKey(rel) Then outcome = &quot;Uploaded by &quot; &amp; uploader(rel) &amp; &quot;. &quot; &amp; outcome&#xA;        Try&#xA;            If Not File.Exists(src) Then&#xA;                outcome &amp;= &quot;. It is no longer in the drop folder.&quot;&#xA;            Else&#xA;                Dim fi As New FileInfo(src)&#xA;                If fi.Length.ToString(inv) &lt;&gt; c(3) OrElse fi.LastWriteTimeUtc.Ticks.ToString(inv) &lt;&gt; c(4) Then&#xA;                    outcome &amp;= &quot;, but the file changed after it was picked up, so the new version was left for the next run.&quot;&#xA;                Else&#xA;                    Dim target As String = Path.Combine(processed, rel)&#xA;                    Directory.CreateDirectory(Path.GetDirectoryName(target))&#xA;                    Dim n As Integer = 2&#xA;                    While File.Exists(target)&#xA;                        target = Path.Combine(Path.GetDirectoryName(Path.Combine(processed, rel)), Path.GetFileNameWithoutExtension(rel) &amp; &quot;~&quot; &amp; n.ToString() &amp; Path.GetExtension(rel))&#xA;                        n += 1&#xA;                    End While&#xA;                    File.Move(src, target)&#xA;                    moved += 1&#xA;                    outcome &amp;= &quot;. Moved to Processed\&quot; &amp; batch &amp; &quot;.&quot;&#xA;                End If&#xA;            End If&#xA;        Catch ex As Exception&#xA;            outcome &amp;= &quot;. Could NOT be moved to Processed (&quot; &amp; ex.Message &amp; &quot;). Move it out by hand, or the next run will reconcile it again.&quot;&#xA;        End Try&#xA;        rows.Add(New String() {rel, outcome})&#xA;    Next&#xA;&#xA;    ' Subfolders someone made inside the drop folders go once they are empty;&#xA;    ' the drop folders themselves stay.&#xA;    For Each share As String In New String() {&quot;SWIFTMX&quot;, &quot;SWIFT&quot;, &quot;SWIFTDETAIL&quot;}&#xA;        Try&#xA;            Dim drop As String = Path.Combine(root, share)&#xA;            If Not Directory.Exists(drop) Then Continue For&#xA;            For Each sub1 As String In Directory.GetDirectories(drop, &quot;*&quot;, SearchOption.AllDirectories).OrderByDescending(Function(z) z.Length)&#xA;                If Not Directory.EnumerateFileSystemEntries(sub1).Any() Then Directory.Delete(sub1)&#xA;            Next&#xA;        Catch ex As Exception&#xA;            Console.WriteLine(&quot;Could not tidy the &quot; &amp; share &amp; &quot; drop folder: &quot; &amp; ex.Message)&#xA;        End Try&#xA;    Next&#xA;End If&#xA;&#xA;If rows.Count &gt; 0 Then&#xA;    Dim sb As New System.Text.StringBuilder()&#xA;    sb.Append(&quot;&lt;div style=&quot;&quot;font-family:Segoe UI,Arial,sans-serif;font-size:13px;color:#222&quot;&quot;&gt;&quot;)&#xA;    sb.Append(&quot;&lt;p style=&quot;&quot;margin:16px 0 4px 0&quot;&quot;&gt;&lt;b&gt;Uploaded statement pages&lt;/b&gt; &amp;middot; missing pages uploaded on the Nostro portal (&quot;)&#xA;    sb.Append(Enc(root))&#xA;    sb.Append(&quot;)&lt;/p&gt;&quot;)&#xA;    sb.Append(&quot;&lt;table cellspacing=&quot;&quot;0&quot;&quot; cellpadding=&quot;&quot;6&quot;&quot; style=&quot;&quot;border-collapse:collapse;font-size:12px&quot;&quot;&gt;&quot;)&#xA;    sb.Append(&quot;&lt;tr style=&quot;&quot;background:#dce6f1;font-weight:bold&quot;&quot;&gt;&lt;th style=&quot;&quot;border:1px solid #9bb;text-align:left&quot;&quot;&gt;File&lt;/th&gt;&lt;th style=&quot;&quot;border:1px solid #9bb;text-align:left&quot;&quot;&gt;Outcome&lt;/th&gt;&lt;/tr&gt;&quot;)&#xA;    For Each r As String() In rows&#xA;        sb.Append(&quot;&lt;tr&gt;&lt;td style=&quot;&quot;border:1px solid #ccc&quot;&quot;&gt;&quot; &amp; Enc(r(0)) &amp; &quot;&lt;/td&gt;&lt;td style=&quot;&quot;border:1px solid #ccc&quot;&quot;&gt;&quot; &amp; Enc(r(1)) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;)&#xA;    Next&#xA;    sb.Append(&quot;&lt;/table&gt;&lt;/div&gt;&quot;)&#xA;    runSummaryHtml = If(runSummaryHtml, &quot;&quot;) &amp; sb.ToString()&#xA;End If&#xA;Console.WriteLine(&quot;Missing pages drop folder: &quot; &amp; rows.Count.ToString() &amp; &quot; file(s) reported, &quot; &amp; moved.ToString() &amp; &quot; moved to Processed.&quot;)&#xA;" DisplayName="Move used missing pages to Processed" sap:VirtualizedContainerService.HintSize="504.6666666666667,196" sap2010:WorkflowViewState.IdRef="InvokeCode_600">

          <If.Then>
            <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ============================================================================&#xA;'  CLEAR PREVIOUS OUTPUT BEFORE AN UNATTENDED RUN&#xA;' ============================================================================&#xA;'  Two scopes:&#xA;'&#xA;'   * normal run  - clear only the folder for the recon date being produced.&#xA;'     Each run stamps its files with HH_mm, so re-running a date otherwise&#xA;'     leaves several sets side by side, and the history lookup in Ledger&#xA;'     Preparation takes the FIRST *&lt;account&gt;*.xlsx it finds - which with&#xA;'     several runs present is the alphabetically first, i.e. the OLDEST.&#xA;'&#xA;'   * AUTOMATION_RESET - clear every dated folder under the Nostro root. A&#xA;'     reset declares the reset point to be the only history, so leaving older&#xA;'     report folders lying about means a later run can still pick one up as&#xA;'     its brought-forward position.&#xA;'&#xA;'  This is a recursive delete, so every target is checked three ways: the leaf&#xA;'  must parse as a dd-MMM-yyyy recon date, the parent must be the Nostro report&#xA;'  root, and the target must be neither the folder this run reads its history&#xA;'  from nor anywhere on the path to the reset point.&#xA;' ============================================================================&#xA;&#xA;Dim target As String = If(currentDateFolder, &quot;&quot;).Trim().TrimEnd(&quot;\&quot;c)&#xA;deletedInfo = &quot;&quot;&#xA;&#xA;If target.Length = 0 Then&#xA;    Throw New InvalidOperationException(&quot;currentDateFolder is empty - refusing to delete anything.&quot;)&#xA;End If&#xA;&#xA;Dim full As String = Path.GetFullPath(target)&#xA;Dim nostroRoot As String = Path.GetDirectoryName(full)&#xA;&#xA;If nostroRoot Is Nothing OrElse Not nostroRoot.TrimEnd(&quot;\&quot;c).EndsWith(&quot;FINANCE AUTOMATED RECON\Nostro&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;    Throw New InvalidOperationException(&quot;Refusing to delete under &quot;&quot;&quot; &amp; Convert.ToString(nostroRoot) &amp; &quot;&quot;&quot; - it is not the FINANCE AUTOMATED RECON\Nostro report root.&quot;)&#xA;End If&#xA;&#xA;' Paths this run must not destroy, whatever else happens.&#xA;Dim protectedPaths As New List(Of String)()&#xA;For Each p As String In New String() {historicalRoot, resetPointPath}&#xA;    Dim v As String = If(p, &quot;&quot;).Trim().TrimEnd(&quot;\&quot;c)&#xA;    If v.Length &gt; 0 Then&#xA;        Try&#xA;            protectedPaths.Add(Path.GetFullPath(v))&#xA;        Catch ex As Exception&#xA;        End Try&#xA;    End If&#xA;Next&#xA;&#xA;&#xA;Dim victims As New List(Of String)()&#xA;If automationReset Then&#xA;    ' Every dated folder, not just today's.&#xA;    For Each dir As String In Directory.GetDirectories(nostroRoot)&#xA;        victims.Add(dir)&#xA;    Next&#xA;Else&#xA;    victims.Add(full)&#xA;End If&#xA;&#xA;Dim cleared As Integer = 0&#xA;Dim filesGone As Integer = 0&#xA;Dim notes As New List(Of String)()&#xA;&#xA;For Each victim As String In victims&#xA;    Dim vFull As String = Path.GetFullPath(victim.TrimEnd(&quot;\&quot;c))&#xA;    Dim leaf As String = Path.GetFileName(vFull)&#xA;&#xA;    Dim dayDate As DateTime&#xA;    If Not DateTime.TryParseExact(leaf, &quot;dd-MMM-yyyy&quot;, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, dayDate) Then&#xA;        notes.Add(&quot;skipped &quot; &amp; leaf &amp; &quot; (not a dd-MMM-yyyy recon date)&quot;)&#xA;        Continue For&#xA;    End If&#xA;&#xA;    Dim parent As String = Path.GetDirectoryName(vFull)&#xA;    If parent Is Nothing OrElse Not String.Equals(parent.TrimEnd(&quot;\&quot;c), nostroRoot.TrimEnd(&quot;\&quot;c), StringComparison.OrdinalIgnoreCase) Then&#xA;        notes.Add(&quot;skipped &quot; &amp; leaf &amp; &quot; (not directly under the Nostro root)&quot;)&#xA;        Continue For&#xA;    End If&#xA;&#xA;    Dim blocked As Boolean = False&#xA;    For Each prot As String In protectedPaths&#xA;        If String.Equals(prot, vFull, StringComparison.OrdinalIgnoreCase) OrElse prot.StartsWith(vFull &amp; &quot;\&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;            blocked = True&#xA;            Exit For&#xA;        End If&#xA;    Next&#xA;    If blocked Then&#xA;        notes.Add(&quot;kept &quot; &amp; leaf &amp; &quot; (this run reads its history from it)&quot;)&#xA;        Continue For&#xA;    End If&#xA;&#xA;    If Not Directory.Exists(vFull) Then&#xA;        Continue For&#xA;    End If&#xA;&#xA;    Try&#xA;        Dim n As Integer = Directory.GetFiles(vFull, &quot;*&quot;, SearchOption.AllDirectories).Length&#xA;        Directory.Delete(vFull, True)&#xA;        cleared += 1&#xA;        filesGone += n&#xA;        notes.Add(&quot;cleared &quot; &amp; leaf &amp; &quot; (&quot; &amp; n.ToString() &amp; &quot; file(s))&quot;)&#xA;    Catch ex As Exception&#xA;        notes.Add(&quot;could not clear &quot; &amp; leaf &amp; &quot; - &quot; &amp; ex.Message)&#xA;    End Try&#xA;Next&#xA;&#xA;If automationReset Then&#xA;    deletedInfo = &quot;AUTOMATION_RESET: cleared &quot; &amp; cleared.ToString() &amp; &quot; dated folder(s), &quot; &amp; filesGone.ToString() &amp; &quot; file(s), under &quot; &amp; nostroRoot &amp; &quot;. The reset point is now the only history.&quot;&#xA;ElseIf cleared &gt; 0 Then&#xA;    deletedInfo = &quot;Cleared previous output for &quot; &amp; Path.GetFileName(full) &amp; &quot; (&quot; &amp; filesGone.ToString() &amp; &quot; file(s)) before re-running.&quot;&#xA;Else&#xA;    deletedInfo = &quot;No previous output for &quot; &amp; Path.GetFileName(full) &amp; &quot; - nothing to clear.&quot;&#xA;End If&#xA;&#xA;For Each nt As String In notes&#xA;    deletedInfo = deletedInfo &amp; Environment.NewLine &amp; &quot;  &quot; &amp; nt&#xA;Next&#xA;&#xA;Console.WriteLine(deletedInfo)&#xA;" DisplayName="Clear previous output for this recon date" sap:VirtualizedContainerService.HintSize
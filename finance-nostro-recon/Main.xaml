                                  </scg:Dictionary>
                                </sap:WorkflowViewStateService.ViewState>
                                <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Columns mirror the Summary sheet's reconciliation statement so the email can be&#xA;' tied back to each workbook cell by cell.&#xA;dtRunSummary = New DataTable()&#xA;dtRunSummary.Columns.Add(&quot;Bank&quot;, GetType(String))&#xA;dtRunSummary.Columns.Add(&quot;Account&quot;, GetType(String))&#xA;dtRunSummary.Columns.Add(&quot;LedgerBalance&quot;, GetType(Double))&#xA;dtRunSummary.Columns.Add(&quot;StatementBalance&quot;, GetType(Double))&#xA;dtRunSummary.Columns.Add(&quot;StmtOutstandingCr&quot;, GetType(Double))&#xA;dtRunSummary.Columns.Add(&quot;StmtOutstandingDr&quot;, GetType(Double))&#xA;dtRunSummary.Columns.Add(&quot;LedgerOutstandingDr&quot;, GetType(Double))&#xA;dtRunSummary.Columns.Add(&quot;LedgerOutstandingCr&quot;, GetType(Double))&#xA;dtRunSummary.Columns.Add(&quot;CorrectedLedger&quot;, GetType(Double))&#xA;dtRunSummary.Columns.Add(&quot;CorrectedStatement&quot;, GetType(Double))&#xA;dtRunSummary.Columns.Add(&quot;CheckBalance&quot;, GetType(Double))&#xA;dtRunSummary.Columns.Add(&quot;StmtItems&quot;, GetType(Integer))&#xA;dtRunSummary.Columns.Add(&quot;LedgerItems&quot;, GetType(Integer))&#xA;dtRunSummary.Columns.Add(&quot;Balanced&quot;, GetType(Boolean))&#xA;&#xA;summaryFiles = New String() {}&#xA;Try&#xA;    If Not String.IsNullOrWhiteSpace(currentDateFolder) AndAlso Directory.Exists(currentDateFolder) Then&#xA;        summaryFiles = Directory.GetFiles(currentDateFolder, &quot;*Summary.xlsx&quot;, SearchOption.AllDirectories)&#xA;        Array.Sort(summaryFiles)&#xA;    End If&#xA;Catch ex As Exception&#xA;    Console.WriteLine(&quot;Could not list the Summary workbooks for the run summary: &quot; &amp; ex.Message)&#xA;End Try&#xA;Console.WriteLine(&quot;Run summary: &quot; &amp; summaryFiles.Length.ToString() &amp; &quot; account workbook(s) to summarise.&quot;)&#xA;" DisplayName="Start run summary" sap:VirtualizedContainerService.HintSize="478,196" sap2010:WorkflowViewState.IdRef="InvokeCode_500">
                                  <ui:InvokeCode.Arguments>
                                    <InArgument x:TypeArguments="x:String" x:Key="currentDateFolder">[currentDateFolder]</InArgument>

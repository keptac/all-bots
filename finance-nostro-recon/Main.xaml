                                          <ui:ReadRange WorkbookPathResource="{x:Null}" AddHeaders="False" DataTable="[dtHead]" DisplayName="Read Summary balances" sap:VirtualizedContainerService.HintSize="410,112" sap2010:WorkflowViewState.IdRef="ReadRange_500" Range="A16:D23" SheetName="Summary" WorkbookPath="[summaryFile]" />
                                          <ui:ReadRange WorkbookPathResource="{x:Null}" AddHeaders="True" DataTable="[dtExt]" DisplayName="Read External outstanding" sap:VirtualizedContainerService.HintSize="410,112" sap2010:WorkflowViewState.IdRef="ReadRange_501" Range="A7" SheetName="External outstanding" WorkbookPath="[summaryFile]" />
                                          <ui:ReadRange WorkbookPathResource="{x:Null}" AddHeaders="True" DataTable="[dtInt]" DisplayName="Read Internal outstanding" sap:VirtualizedContainerService.HintSize="410,112" sap2010:WorkflowViewState.IdRef="ReadRange_502" Range="A7" SheetName="Internal outstanding" WorkbookPath="[summaryFile]" />
                                          <ui:InvokeCode ContinueOnError="{x:Null}" Code="' One account. dtHead is Summary!A16:D23 read without headers, so D16 is row 0&#xA;' column 3 and D23 is row 7 column 3. Both are written as text by Write Cell, hence&#xA;' the parse. dtExt / dtInt are the outstanding sheets read from A7 with headers, so&#xA;' their DR and CR columns are named.&#xA;'&#xA;' The arithmetic is exactly the Summary sheet's own:&#xA;'   D20 corrected ledger    = D16 + D17 - D18   where D17 = External CR, D18 = External DR&#xA;'   D27 corrected statement = D23 + D24 - D25   where D24 = Internal DR, D25 = Internal CR&#xA;'   D30 Check_Balance       = D20 - D27&#xA;' Those cells are formulas with no cached value, so nothing can read them back from&#xA;' the workbook; recomputing here is the only way to report the figure.&#xA;&#xA;Dim inv As System.Globalization.CultureInfo = System.Globalization.CultureInfo.InvariantCulture&#xA;&#xA;Dim d16 As Double = 0&#xA;Dim d23 As Double = 0&#xA;If dtHead IsNot Nothing AndAlso dtHead.Rows.Count &gt;= 8 AndAlso dtHead.Columns.Count &gt;= 4 Then&#xA;    Double.TryParse(dtHead.Rows(0)(3).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), System.Globalization.NumberStyles.Any, inv, d16)&#xA;    Double.TryParse(dtHead.Rows(7)(3).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), System.Globalization.NumberStyles.Any, inv, d23)&#xA;End If&#xA;&#xA;Dim extDr As Double = 0&#xA;Dim extCr As Double = 0&#xA;Dim extN As Integer = 0&#xA;If dtExt IsNot Nothing Then&#xA;    For Each r As DataRow In dtExt.Rows&#xA;        Dim a As Double = 0&#xA;        Dim b As Double = 0&#xA;        If dtExt.Columns.Contains(&quot;DR&quot;) AndAlso Not r.IsNull(&quot;DR&quot;) Then Double.TryParse(r(&quot;DR&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), System.Globalization.NumberStyles.Any, inv, a)&#xA;        If dtExt.Columns.Contains(&quot;CR&quot;) AndAlso Not r.IsNull(&quot;CR&quot;) Then Double.TryParse(r(&quot;CR&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), System.Globalization.NumberStyles.Any, inv, b)&#xA;        If a &lt;&gt; 0 OrElse b &lt;&gt; 0 Then extN += 1&#xA;        extDr += a&#xA;        extCr += b&#xA;    Next&#xA;End If&#xA;&#xA;Dim intDr As Double = 0&#xA;Dim intCr As Double = 0&#xA;Dim intN As Integer = 0&#xA;If dtInt IsNot Nothing Then&#xA;    For Each r As DataRow In dtInt.Rows&#xA;        Dim a As Double = 0&#xA;        Dim b As Double = 0&#xA;        If dtInt.Columns.Contains(&quot;DR&quot;) AndAlso Not r.IsNull(&quot;DR&quot;) Then Double.TryParse(r(&quot;DR&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), System.Globalization.NumberStyles.Any, inv, a)&#xA;        If dtInt.Columns.Contains(&quot;CR&quot;) AndAlso Not r.IsNull(&quot;CR&quot;) Then Double.TryParse(r(&quot;CR&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim(), System.Globalization.NumberStyles.Any, inv, b)&#xA;        If a &lt;&gt; 0 OrElse b &lt;&gt; 0 Then intN += 1&#xA;        intDr += a&#xA;        intCr += b&#xA;    Next&#xA;End If&#xA;&#xA;Dim correctedLedger As Double = d16 + extCr - extDr&#xA;Dim correctedStmt As Double = d23 + intDr - intCr&#xA;Dim chk As Double = Math.Round(correctedLedger - correctedStmt, 2)&#xA;&#xA;' The workbook is named &quot;&lt;BANK&gt;_&lt;CCY&gt;_&lt;ACCOUNT&gt; HH_mm Summary.xlsx&quot; and sits in a&#xA;' folder named for the bank.&#xA;Dim leaf As String = Path.GetFileNameWithoutExtension(summaryFile)&#xA;Dim bankName As String = Path.GetFileName(Path.GetDirectoryName(summaryFile))&#xA;Dim acct As String = &quot;&quot;&#xA;Dim mm As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(leaf, &quot;(\d{9,})&quot;)&#xA;If mm.Success Then acct = mm.Groups(1).Value&#xA;&#xA;Dim nr As DataRow = dtRunSummary.NewRow()&#xA;nr(&quot;Bank&quot;) = bankName&#xA;nr(&quot;Account&quot;) = acct&#xA;nr(&quot;LedgerBalance&quot;) = Math.Round(d16, 2)&#xA;nr(&quot;StatementBalance&quot;) = Math.Round(d23, 2)&#xA;nr(&quot;StmtOutstandingCr&quot;) = Math.Round(extCr, 2)&#xA;nr(&quot;StmtOutstandingDr&quot;) = Math.Round(extDr, 2)&#xA;nr(&quot;LedgerOutstandingDr&quot;) = Math.Round(intDr, 2)&#xA;nr(&quot;LedgerOutstandingCr&quot;) = Math.Round(intCr, 2)&#xA;nr(&quot;CorrectedLedger&quot;) = Math.Round(correctedLedger, 2)&#xA;nr(&quot;CorrectedStatement&quot;) = Math.Round(correctedStmt, 2)&#xA;nr(&quot;CheckBalance&quot;) = chk&#xA;nr(&quot;StmtItems&quot;) = extN&#xA;nr(&quot;LedgerItems&quot;) = intN&#xA;nr(&quot;Balanced&quot;) = (Math.Abs(chk) &lt;= 0.05)&#xA;dtRunSummary.Rows.Add(nr)&#xA;&#xA;Console.WriteLine(bankName &amp; &quot; &quot; &amp; acct &amp; &quot;  Check_Balance &quot; &amp; chk.ToString(&quot;N2&quot;, inv) &amp; If(Math.Abs(chk) &lt;= 0.05, &quot;  BALANCED&quot;, &quot;  NOT BALANCED&quot;))&#xA;" DisplayName="Add account to run summary" sap:VirtualizedContainerService.HintSize="410,196" sap2010:WorkflowViewState.IdRef="InvokeCode_501">
                                            <ui:InvokeCode.Arguments>
                                              <InArgument x:TypeArguments="x:String" x:Key="summaryFile">[summaryFile]</InArgument>
                                              <InArgument x:TypeArguments="sd:DataTable" x:Key="dtHead">[dtHead]</InArgument>
                                              <InArgument x:TypeArguments="sd:DataTable" x:Key="dtExt">[dtExt]</InArgument>
                                              <InArgument x:TypeArguments="sd:DataTable" x:Key="dtInt">[dtInt]</InArgument>
                                              <InArgument x:TypeArguments="sd:DataTable" x:Key="dtRunSummary">[dtRunSummary]</InArgument>
                                            </ui:InvokeCode.Arguments>
                                          </ui:InvokeCode>
                                        </Sequence>
                                      </TryCatch.Try>
                                      <TryCatch.Catches>
                                        <Catch x:TypeArguments="s:Exception" sap:VirtualizedContainerService.HintSize="430,23" sap2010:WorkflowViewState.IdRef="Catch\1_500">
                                          <ActivityAction x:TypeArguments="s:Exception">
                                            <ActivityAction.Argument>
                                              <DelegateInArgument x:TypeArguments="s:Exception" Name="sumEx" />
                                            </ActivityAction.Argument>
                                            <ui:LogMessage DisplayName="Log summary read failure" sap:VirtualizedContainerService.HintSize="410,110" sap2010:WorkflowViewState.IdRef="LogMessage_500" Level="Warn" Message="[&quot;Could not summarise &quot; + System.IO.Path.GetFileName(summaryFile) + &quot; - &quot; + sumEx.Message + &quot;. It will be absent from the email summary.&quot;]" />
                                          </ActivityAction>
                                        </Catch>
                                      </TryCatch.Catches>
                                    </TryCatch>
                                  </ActivityAction>
                                </ForEach>
                                <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Renders the per-account run summary for the email body. Not-balanced accounts are&#xA;' listed first and highlighted, because that is what the reader needs to act on.&#xA;'&#xA;' Missing statement pages no longer stop the run. The page check's lines name the&#xA;' EXTERNAL account on the camt statement; the Banks sheet maps that to the NMB&#xA;' account the summary is keyed on, and the pages become the Reason for any account&#xA;' that does not balance.&#xA;'&#xA;' Every account is also appended to &lt;report root&gt;\run-history.csv, which nothing&#xA;' clears. &quot;Open problem days&quot; lists earlier value dates whose latest run still did&#xA;' not balance and had missing pages - the days to re-run once the pages arrive.&#xA;&#xA;Dim inv As System.Globalization.CultureInfo = System.Globalization.CultureInfo.InvariantCulture&#xA;Dim sb As New System.Text.StringBuilder()&#xA;Dim Enc = Function(v As String) System.Net.WebUtility.HtmlEncode(If(v, &quot;&quot;))&#xA;Dim Digits = Function(v As String) New String(If(v, &quot;&quot;).Where(Function(ch) Char.IsDigit(ch)).ToArray())&#xA;Dim Csv = Function(v As String) As String&#xA;              Dim t As String = If(v, &quot;&quot;).Replace(vbCr, &quot; &quot;).Replace(vbLf, &quot; &quot;)&#xA;              Return If(t.IndexOfAny(New Char() {&quot;,&quot;c, &quot;&quot;&quot;&quot;c}) &gt;= 0, &quot;&quot;&quot;&quot; &amp; t.Replace(&quot;&quot;&quot;&quot;, &quot;&quot;&quot;&quot;&quot;&quot;) &amp; &quot;&quot;&quot;&quot;, t)&#xA;          End Function&#xA;Dim ParseCsv = Function(line As String) As List(Of String)&#xA;                   Dim cells As New List(Of String)()&#xA;                   Dim cur As New System.Text.StringBuilder()&#xA;                   Dim q As Boolean = False&#xA;                   Dim i As Integer = 0&#xA;                   While i &lt; line.Length&#xA;                       Dim ch As Char = line(i)&#xA;                       If q Then&#xA;                           If ch = &quot;&quot;&quot;&quot;c AndAlso i + 1 &lt; line.Length AndAlso line(i + 1) = &quot;&quot;&quot;&quot;c Then&#xA;                               cur.Append(&quot;&quot;&quot;&quot;c)&#xA;                               i += 1&#xA;                           ElseIf ch = &quot;&quot;&quot;&quot;c Then&#xA;                               q = False&#xA;                           Else&#xA;                               cur.Append(ch)&#xA;                           End If&#xA;                       ElseIf ch = &quot;&quot;&quot;&quot;c Then&#xA;                           q = True&#xA;                       ElseIf ch = &quot;,&quot;c Then&#xA;                           cells.Add(cur.ToString())&#xA;                           cur.Clear()&#xA;                       Else&#xA;                           cur.Append(ch)&#xA;                       End If&#xA;                       i += 1&#xA;                   End While&#xA;                   cells.Add(cur.ToString())&#xA;                   Return cells&#xA;               End Function&#xA;&#xA;' ---------------------------------------------------------------- value date --&#xA;' The same rule as staging: STATEMENT_DATE, or yesterday when it is blank.&#xA;Dim fmts As String() = {&quot;yyyy-MM-dd&quot;, &quot;dd-MMM-yyyy&quot;, &quot;dd/MM/yyyy&quot;, &quot;yyyyMMdd&quot;}&#xA;Dim valueDate As DateTime = DateTime.Today.AddDays(-1)&#xA;If Not String.IsNullOrWhiteSpace(statementDate) Then DateTime.TryParseExact(statementDate.Trim(), fmts, inv, System.Globalization.DateTimeStyles.None, valueDate)&#xA;valueDate = valueDate.Date&#xA;Dim windowStart As String = &quot;&quot;&#xA;Dim ws As DateTime&#xA;If Not String.IsNullOrWhiteSpace(startDate) AndAlso DateTime.TryParseExact(startDate.Trim(), fmts, inv, System.Globalization.DateTimeStyles.None, ws) Then windowStart = ws.ToString(&quot;yyyy-MM-dd&quot;, inv)&#xA;&#xA;' ------------------------------------------------------ missing pages by account --&#xA;Dim extToNmb As New Dictionary(Of String, String)()&#xA;If dtBanks IsNot Nothing AndAlso dtBanks.Columns.Contains(&quot;EXTERNAL ACC&quot;) AndAlso dtBanks.Columns.Contains(&quot;NMB ACC&quot;) Then&#xA;    For Each b As DataRow In dtBanks.Rows&#xA;        Dim ext As String = Digits(b(&quot;EXTERNAL ACC&quot;).ToString())&#xA;        Dim nmb As String = Digits(b(&quot;NMB ACC&quot;).ToString())&#xA;        If ext.Length &gt;= 6 AndAlso nmb.Length &gt; 0 AndAlso Not extToNmb.ContainsKey(ext) Then extToNmb.Add(ext, nmb)&#xA;    Next&#xA;End If&#xA;&#xA;Dim pagesByAcct As New Dictionary(Of String, List(Of String))()&#xA;Dim pageLines As New Dictionary(Of String, List(Of String))()&#xA;Dim unplaced As New List(Of String)()&#xA;For Each raw As String In If(missingPages, &quot;&quot;).Split(New String() {vbCrLf, vbLf}, StringSplitOptions.RemoveEmptyEntries)&#xA;    Dim line As String = raw.Trim()&#xA;    If line.Length = 0 Then Continue For&#xA;    Dim mAcct As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(line, &quot;^Account (\S+)&quot;)&#xA;    Dim nmbAcct As String = &quot;&quot;&#xA;    If mAcct.Success Then&#xA;        Dim onStmt As String = Digits(mAcct.Groups(1).Value)&#xA;        ' an IBAN carries the account number at its end, so allow a suffix match&#xA;        For Each kv As KeyValuePair(Of String, String) In extToNmb&#xA;            If onStmt.Length &gt;= 6 AndAlso (onStmt = kv.Key OrElse onStmt.EndsWith(kv.Key) OrElse kv.Key.EndsWith(onStmt)) Then&#xA;                nmbAcct = kv.Value&#xA;                Exit For&#xA;            End If&#xA;        Next&#xA;    End If&#xA;    If nmbAcct.Length = 0 Then&#xA;        unplaced.Add(line)&#xA;    Else&#xA;        Dim reason As String = System.Text.RegularExpressions.Regex.Replace(line, &quot;^Account \S+( \([^)]*\))?(, )?&quot;, &quot;&quot;)&#xA;        If Not pagesByAcct.ContainsKey(nmbAcct) Then&#xA;            pagesByAcct.Add(nmbAcct, New List(Of String)())&#xA;            pageLines.Add(nmbAcct, New List(Of String)())&#xA;        End If&#xA;        pagesByAcct(nmbAcct).Add(reason)&#xA;        pageLines(nmbAcct).Add(line)&#xA;    End If&#xA;Next&#xA;Dim PagesFor = Function(acct As String) As String&#xA;                   Dim key As String = Digits(acct)&#xA;                   If key.Length = 0 OrElse Not pagesByAcct.ContainsKey(key) Then Return &quot;&quot;&#xA;                   Return String.Join(&quot;; &quot;, pagesByAcct(key))&#xA;               End Function&#xA;&#xA;Dim total As Integer = 0&#xA;Dim okCount As Integer = 0&#xA;If dtRunSummary IsNot Nothing Then&#xA;    total = dtRunSummary.Rows.Count&#xA;    For Each r As DataRow In dtRunSummary.Rows&#xA;        If CBool(r(&quot;Balanced&quot;)) Then okCount += 1&#xA;    Next&#xA;End If&#xA;Dim badCount As Integer = total - okCount&#xA;&#xA;' An account with missing pages but no workbook in this run has no row to carry&#xA;' the reason, so its lines are listed under the table instead.&#xA;Dim inRun As New HashSet(Of String)()&#xA;If dtRunSummary IsNot Nothing Then&#xA;    For Each r As DataRow In dtRunSummary.Rows&#xA;        inRun.Add(Digits(r(&quot;Account&quot;).ToString()))&#xA;    Next&#xA;End If&#xA;For Each kv As KeyValuePair(Of String, List(Of String)) In pageLines&#xA;    If Not inRun.Contains(kv.Key) Then unplaced.AddRange(kv.Value)&#xA;Next&#xA;&#xA;' ---------------------------------------------------------------- run history --&#xA;Dim historyPath As String = Path.Combine(reportRoot, &quot;run-history.csv&quot;)&#xA;Dim historyNote As String = &quot;&quot;&#xA;Dim header As String = &quot;Value Date,Window Start,Run At,Machine,User,Mode,Bank,Account,Check_Balance,Balanced,Missing Pages,Report Folder&quot;&#xA;Dim runAt As String = DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;, inv)&#xA;Dim newLines As New System.Text.StringBuilder()&#xA;If dtRunSummary IsNot Nothing Then&#xA;    For Each r As DataRow In dtRunSummary.Rows&#xA;        newLines.Append(String.Join(&quot;,&quot;, New String() {&#xA;            valueDate.ToString(&quot;yyyy-MM-dd&quot;, inv), windowStart, runAt, Csv(Environment.MachineName), Csv(Environment.UserName), Csv(mode),&#xA;            Csv(r(&quot;Bank&quot;).ToString()), Csv(r(&quot;Account&quot;).ToString()), CDbl(r(&quot;CheckBalance&quot;)).ToString(&quot;F2&quot;, inv),&#xA;            If(CBool(r(&quot;Balanced&quot;)), &quot;Yes&quot;, &quot;No&quot;), Csv(PagesFor(r(&quot;Account&quot;).ToString())), Csv(currentDateFolder)}))&#xA;        newLines.Append(vbCrLf)&#xA;    Next&#xA;End If&#xA;For attempt As Integer = 1 To 3&#xA;    Try&#xA;        Directory.CreateDirectory(reportRoot)&#xA;        If Not File.Exists(historyPath) Then File.WriteAllText(historyPath, header &amp; vbCrLf, System.Text.Encoding.UTF8)&#xA;        If newLines.Length &gt; 0 Then File.AppendAllText(historyPath, newLines.ToString(), System.Text.Encoding.UTF8)&#xA;        historyNote = &quot;&quot;&#xA;        Exit For&#xA;    Catch ex As Exception&#xA;        ' most often the file is open in Excel on someone's desk&#xA;        historyNote = &quot;Run history was NOT updated (&quot; &amp; historyPath &amp; &quot;): &quot; &amp; ex.Message&#xA;        System.Threading.Thread.Sleep(2000)&#xA;    End Try&#xA;Next&#xA;&#xA;' Latest run per value date and account; open = not balanced with missing pages.&#xA;Dim openDays As New List(Of String())()&#xA;Try&#xA;    If File.Exists(historyPath) Then&#xA;        Dim latest As New Dictionary(Of String, List(Of String))()&#xA;        Dim first As Boolean = True&#xA;        Using fs As New FileStream(historyPath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite)&#xA;            Using rd As New StreamReader(fs)&#xA;                While Not rd.EndOfStream&#xA;                    Dim ln As String = rd.ReadLine()&#xA;                    If first Then&#xA;                        first = False&#xA;                        Continue While&#xA;                    End If&#xA;                    Dim c As List(Of String) = ParseCsv(ln)&#xA;                    If c.Count &lt; 12 Then Continue While&#xA;                    Dim k As String = c(0) &amp; &quot;|&quot; &amp; Digits(c(7))&#xA;                    If Not latest.ContainsKey(k) OrElse String.CompareOrdinal(c(2), latest(k)(2)) &gt;= 0 Then latest(k) = c&#xA;                End While&#xA;            End Using&#xA;        End Using&#xA;        Dim today As String = valueDate.ToString(&quot;yyyy-MM-dd&quot;, inv)&#xA;        For Each c As List(Of String) In latest.Values.OrderByDescending(Function(z) z(0)).ThenBy(Function(z) z(6))&#xA;            If String.CompareOrdinal(c(0), today) &lt; 0 AndAlso c(9) = &quot;No&quot; AndAlso c(10).Trim().Length &gt; 0 Then&#xA;                openDays.Add(New String() {c(0), c(6), c(7), c(8), c(10), c(2)})&#xA;            End If&#xA;        Next&#xA;    End If&#xA;Catch ex As Exception&#xA;    historyNote = (historyNote &amp; &quot; Could not read run history: &quot; &amp; ex.Message).Trim()&#xA;End Try&#xA;&#xA;' ---------------------------------------------------------------- the email --&#xA;sb.Append(&quot;&lt;div style=&quot;&quot;font-family:Segoe UI,Arial,sans-serif;font-size:13px;color:#222&quot;&quot;&gt;&quot;)&#xA;sb.Append(&quot;&lt;p style=&quot;&quot;margin:0 0 6px 0&quot;&quot;&gt;Nostro reconciliation run summary&lt;/p&gt;&quot;)&#xA;sb.Append(&quot;&lt;p style=&quot;&quot;margin:0 0 14px 0;font-size:12px;color:#555&quot;&quot;&gt;Reconciliation date &quot;)&#xA;sb.Append(If(String.IsNullOrWhiteSpace(reconLabel), &quot;(from the CBS extract)&quot;, reconLabel))&#xA;sb.Append(&quot; &amp;middot; produced &quot;)&#xA;sb.Append(DateTime.Now.ToString(&quot;dd-MMM-yyyy HH:mm&quot;, inv))&#xA;sb.Append(&quot; on &quot;)&#xA;sb.Append(Environment.MachineName)&#xA;sb.Append(&quot;&lt;/p&gt;&quot;)&#xA;&#xA;sb.Append(&quot;&lt;p style=&quot;&quot;margin:0 0 12px 0&quot;&quot;&gt;&lt;b&gt;&quot;)&#xA;sb.Append(okCount.ToString())&#xA;sb.Append(&quot; of &quot;)&#xA;sb.Append(total.ToString())&#xA;sb.Append(&quot; account(s) balanced.&lt;/b&gt;&quot;)&#xA;If badCount &gt; 0 Then&#xA;    sb.Append(&quot; &lt;span style=&quot;&quot;color:#b00020&quot;&quot;&gt;&quot;)&#xA;    sb.Append(badCount.ToString())&#xA;    sb.Append(&quot; did not and need review.&lt;/span&gt;&quot;)&#xA;End If&#xA;sb.Append(&quot;&lt;/p&gt;&quot;)&#xA;&#xA;' What to do next, in plain steps, ahead of the table.&#xA;Dim portalUrl As String = &quot;https://robot.nmbtz.com/portal&quot;&#xA;sb.Append(&quot;&lt;div style=&quot;&quot;margin:0 0 16px 0;padding:10px 14px;border:1px solid #c9d6e8;background:#f5f8fc&quot;&quot;&gt;&quot;)&#xA;sb.Append(&quot;&lt;p style=&quot;&quot;margin:0 0 8px 0&quot;&quot;&gt;&lt;b&gt;Nostro portal:&lt;/b&gt; &lt;a href=&quot;&quot;&quot; &amp; portalUrl &amp; &quot;&quot;&quot;&gt;&quot; &amp; portalUrl &amp; &quot;&lt;/a&gt;&lt;/p&gt;&quot;)&#xA;sb.Append(&quot;&lt;p style=&quot;&quot;margin:0 0 2px 0&quot;&quot;&gt;&lt;b&gt;To match items manually&lt;/b&gt;&lt;/p&gt;&quot;)&#xA;sb.Append(&quot;&lt;ol style=&quot;&quot;margin:0 0 10px 0;padding-left:20px&quot;&quot;&gt;&quot;)&#xA;sb.Append(&quot;&lt;li&gt;Open the portal, sign in and choose the account from the &lt;b&gt;Account&lt;/b&gt; list.&lt;/li&gt;&quot;)&#xA;sb.Append(&quot;&lt;li&gt;Tick the items that belong together under &lt;b&gt;Ledger (CBS) outstanding&lt;/b&gt; and &lt;b&gt;Statement outstanding&lt;/b&gt;, type why they match and click &lt;b&gt;Add ticket&lt;/b&gt;.&lt;/li&gt;&quot;)&#xA;sb.Append(&quot;&lt;li&gt;When you are done, click &lt;b&gt;Save tickets&lt;/b&gt;. The Summary position shows the new Check_Balance.&lt;/li&gt;&quot;)&#xA;sb.Append(&quot;&lt;/ol&gt;&quot;)&#xA;sb.Append(&quot;&lt;p style=&quot;&quot;margin:0 0 2px 0&quot;&quot;&gt;&lt;b&gt;If statement pages are missing&lt;/b&gt;&lt;/p&gt;&quot;)&#xA;sb.Append(&quot;&lt;ol style=&quot;&quot;margin:0 0 8px 0;padding-left:20px&quot;&quot;&gt;&quot;)&#xA;sb.Append(&quot;&lt;li&gt;Download the missing page from SWIFT.&lt;/li&gt;&quot;)&#xA;sb.Append(&quot;&lt;li&gt;In the portal click &lt;b&gt;Missing pages&lt;/b&gt;, choose the kind of statement, select the file and click &lt;b&gt;Upload&lt;/b&gt;.&lt;/li&gt;&quot;)&#xA;sb.Append(&quot;&lt;li&gt;Check the file is listed under &lt;b&gt;Waiting for the next run&lt;/b&gt;.&lt;/li&gt;&quot;)&#xA;sb.Append(&quot;&lt;/ol&gt;&quot;)&#xA;sb.Append(&quot;&lt;p style=&quot;&quot;margin:0;color:#8a5a00&quot;&quot;&gt;&lt;b&gt;Note:&lt;/b&gt; uploaded pages are only reconciled in the following day's run, so today's results below will not change.&lt;/p&gt;&quot;)&#xA;sb.Append(&quot;&lt;/div&gt;&quot;)&#xA;&#xA;If total = 0 Then&#xA;    sb.Append(&quot;&lt;p style=&quot;&quot;color:#b00020&quot;&quot;&gt;No account workbooks were produced by this run.&lt;/p&gt;&quot;)&#xA;Else&#xA;    sb.Append(&quot;&lt;table cellspacing=&quot;&quot;0&quot;&quot; cellpadding=&quot;&quot;6&quot;&quot; style=&quot;&quot;border-collapse:collapse;font-size:12px&quot;&quot;&gt;&quot;)&#xA;    sb.Append(&quot;&lt;tr style=&quot;&quot;background:#dce6f1;font-weight:bold&quot;&quot;&gt;&quot;)&#xA;    For Each h As String In New String() {&quot;Bank&quot;, &quot;Account&quot;, &quot;Ledger balance&quot;, &quot;Statement balance&quot;, &quot;Corrected ledger&quot;, &quot;Corrected statement&quot;, &quot;Check_Balance&quot;, &quot;Stmt items&quot;, &quot;Ledger items&quot;, &quot;Result&quot;, &quot;Reason&quot;}&#xA;        sb.Append(&quot;&lt;th style=&quot;&quot;border:1px solid #9bb;text-align:left&quot;&quot;&gt;&quot;)&#xA;        sb.Append(h)&#xA;        sb.Append(&quot;&lt;/th&gt;&quot;)&#xA;    Next&#xA;    sb.Append(&quot;&lt;/tr&gt;&quot;)&#xA;&#xA;    ' Not balanced first, then by bank.&#xA;    Dim ordered As List(Of DataRow) = dtRunSummary.AsEnumerable().OrderBy(Function(r) CBool(r(&quot;Balanced&quot;))).ThenBy(Function(r) r(&quot;Bank&quot;).ToString()).ToList()&#xA;&#xA;    For Each r As DataRow In ordered&#xA;        Dim bal As Boolean = CBool(r(&quot;Balanced&quot;))&#xA;        Dim chk As Double = CDbl(r(&quot;CheckBalance&quot;))&#xA;        sb.Append(&quot;&lt;tr style=&quot;&quot;background:&quot;)&#xA;        sb.Append(If(bal, &quot;#ffffff&quot;, &quot;#fdecee&quot;))&#xA;        sb.Append(&quot;&quot;&quot;&gt;&quot;)&#xA;        sb.Append(&quot;&lt;td style=&quot;&quot;border:1px solid #ccc&quot;&quot;&gt;&quot; &amp; r(&quot;Bank&quot;).ToString() &amp; &quot;&lt;/td&gt;&quot;)&#xA;        sb.Append(&quot;&lt;td style=&quot;&quot;border:1px solid #ccc&quot;&quot;&gt;&quot; &amp; r(&quot;Account&quot;).ToString() &amp; &quot;&lt;/td&gt;&quot;)&#xA;        For Each col As String In New String() {&quot;LedgerBalance&quot;, &quot;StatementBalance&quot;, &quot;CorrectedLedger&quot;, &quot;CorrectedStatement&quot;}&#xA;            sb.Append(&quot;&lt;td style=&quot;&quot;border:1px solid #ccc;text-align:right&quot;&quot;&gt;&quot; &amp; CDbl(r(col)).ToString(&quot;N2&quot;, inv) &amp; &quot;&lt;/td&gt;&quot;)&#xA;        Next&#xA;        sb.Append(&quot;&lt;td style=&quot;&quot;border:1px solid #ccc;text-align:right;font-weight:bold;color:&quot;)&#xA;        sb.Append(If(bal, &quot;#0a7&quot;, &quot;#b00020&quot;))&#xA;        sb.Append(&quot;&quot;&quot;&gt;&quot; &amp; chk.ToString(&quot;N2&quot;, inv) &amp; &quot;&lt;/td&gt;&quot;)&#xA;        sb.Append(&quot;&lt;td style=&quot;&quot;border:1px solid #ccc;text-align:right&quot;&quot;&gt;&quot; &amp; r(&quot;StmtItems&quot;).ToString() &amp; &quot;&lt;/td&gt;&quot;)&#xA;        sb.Append(&quot;&lt;td style=&quot;&quot;border:1px solid #ccc;text-align:right&quot;&quot;&gt;&quot; &amp; r(&quot;LedgerItems&quot;).ToString() &amp; &quot;&lt;/td&gt;&quot;)&#xA;        sb.Append(&quot;&lt;td style=&quot;&quot;border:1px solid #ccc;font-weight:bold;color:&quot;)&#xA;        sb.Append(If(bal, &quot;#0a7&quot;, &quot;#b00020&quot;))&#xA;        sb.Append(&quot;&quot;&quot;&gt;&quot; &amp; If(bal, &quot;Balanced&quot;, &quot;NOT balanced&quot;) &amp; &quot;&lt;/td&gt;&quot;)&#xA;        ' The reason is only given where the account did not balance.&#xA;        Dim pages As String = If(bal, &quot;&quot;, PagesFor(r(&quot;Account&quot;).ToString()))&#xA;        sb.Append(&quot;&lt;td style=&quot;&quot;border:1px solid #ccc&quot;&quot;&gt;&quot; &amp; If(pages.Length &gt; 0, &quot;Missing statement pages: &quot; &amp; Enc(pages), &quot;&quot;) &amp; &quot;&lt;/td&gt;&quot;)&#xA;        sb.Append(&quot;&lt;/tr&gt;&quot;)&#xA;    Next&#xA;    sb.Append(&quot;&lt;/table&gt;&quot;)&#xA;End If&#xA;&#xA;If unplaced.Count &gt; 0 Then&#xA;    sb.Append(&quot;&lt;p style=&quot;&quot;margin:12px 0 4px 0&quot;&quot;&gt;&lt;b&gt;Statement pages missing for accounts not matched to this run's workbooks&lt;/b&gt;&lt;/p&gt;&quot;)&#xA;    sb.Append(&quot;&lt;pre style=&quot;&quot;font-family:Consolas,monospace;font-size:12px;white-space:pre-wrap;margin:0&quot;&quot;&gt;&quot; &amp; Enc(String.Join(vbLf, unplaced)) &amp; &quot;&lt;/pre&gt;&quot;)&#xA;End If&#xA;&#xA;If openDays.Count &gt; 0 Then&#xA;    sb.Append(&quot;&lt;p style=&quot;&quot;margin:16px 0 4px 0&quot;&quot;&gt;&lt;b&gt;Open problem days&lt;/b&gt; &amp;middot; earlier value dates whose latest run did not balance and had missing pages. Upload the missing pages on the Nostro portal (Missing pages) and the next run reconciles them, or re-run the day with STATEMENT_DATE once the pages reach the SWIFT share - every file is kept in the archive, so the rest of that day is still there.&lt;/p&gt;&quot;)&#xA;    sb.Append(&quot;&lt;table cellspacing=&quot;&quot;0&quot;&quot; cellpadding=&quot;&quot;6&quot;&quot; style=&quot;&quot;border-collapse:collapse;font-size:12px&quot;&quot;&gt;&quot;)&#xA;    sb.Append(&quot;&lt;tr style=&quot;&quot;background:#fbe5c8;font-weight:bold&quot;&quot;&gt;&quot;)&#xA;    For Each h As String In New String() {&quot;Value date&quot;, &quot;Bank&quot;, &quot;Account&quot;, &quot;Check_Balance&quot;, &quot;Missing pages&quot;, &quot;Last run&quot;}&#xA;        sb.Append(&quot;&lt;th style=&quot;&quot;border:1px solid #d9b98c;text-align:left&quot;&quot;&gt;&quot; &amp; h &amp; &quot;&lt;/th&gt;&quot;)&#xA;    Next&#xA;    sb.Append(&quot;&lt;/tr&gt;&quot;)&#xA;    For Each od As String() In openDays&#xA;        Dim chkTxt As String = od(3)&#xA;        Dim chkVal As Double&#xA;        If Double.TryParse(od(3), System.Globalization.NumberStyles.Any, inv, chkVal) Then chkTxt = chkVal.ToString(&quot;N2&quot;, inv)&#xA;        sb.Append(&quot;&lt;tr&gt;&quot;)&#xA;        sb.Append(&quot;&lt;td style=&quot;&quot;border:1px solid #ccc&quot;&quot;&gt;&quot; &amp; Enc(od(0)) &amp; &quot;&lt;/td&gt;&quot;)&#xA;        sb.Append(&quot;&lt;td style=&quot;&quot;border:1px solid #ccc&quot;&quot;&gt;&quot; &amp; Enc(od(1)) &amp; &quot;&lt;/td&gt;&quot;)&#xA;        sb.Append(&quot;&lt;td style=&quot;&quot;border:1px solid #ccc&quot;&quot;&gt;&quot; &amp; Enc(od(2)) &amp; &quot;&lt;/td&gt;&quot;)&#xA;        sb.Append(&quot;&lt;td style=&quot;&quot;border:1px solid #ccc;text-align:right&quot;&quot;&gt;&quot; &amp; Enc(chkTxt) &amp; &quot;&lt;/td&gt;&quot;)&#xA;        sb.Append(&quot;&lt;td style=&quot;&quot;border:1px solid #ccc&quot;&quot;&gt;&quot; &amp; Enc(od(4)) &amp; &quot;&lt;/td&gt;&quot;)&#xA;        sb.Append(&quot;&lt;td style=&quot;&quot;border:1px solid #ccc&quot;&quot;&gt;&quot; &amp; Enc(od(5)) &amp; &quot;&lt;/td&gt;&quot;)&#xA;        sb.Append(&quot;&lt;/tr&gt;&quot;)&#xA;    Next&#xA;    sb.Append(&quot;&lt;/table&gt;&quot;)&#xA;End If&#xA;&#xA;If historyNote.Length &gt; 0 Then&#xA;    sb.Append(&quot;&lt;p style=&quot;&quot;margin:12px 0 0 0;color:#b00020&quot;&quot;&gt;&quot; &amp; Enc(historyNote) &amp; &quot;&lt;/p&gt;&quot;)&#xA;End If&#xA;&#xA;sb.Append(&quot;&lt;/div&gt;&quot;)&#xA;runSummaryHtml = sb.ToString()&#xA;&#xA;Console.WriteLine(&quot;Run summary: &quot; &amp; okCount.ToString() &amp; &quot; balanced, &quot; &amp; badCount.ToString() &amp; &quot; not balanced.&quot; &amp; If(openDays.Count &gt; 0, &quot; &quot; &amp; openDays.Count.ToString() &amp; &quot; open problem day row(s).&quot;, &quot;&quot;) &amp; If(historyNote.Length &gt; 0, &quot; &quot; &amp; historyNote, &quot;&quot;))" DisplayName="Render run summary for the email" sap:VirtualizedContainerService.HintSize="478,196" sap2010:WorkflowViewState.IdRef="InvokeCode_502">
                                  <ui:InvokeCode.Arguments>
                                    <InArgument x:TypeArguments="sd:DataTable" x:Key="dtRunSummary">[dtRunSummary]</InArgument>
                                    <InArgument x:TypeArguments="x:String" x:Key="reconLabel">[If(String.IsNullOrWhiteSpace(STATEMENT_DATE), "", STATEMENT_DATE)]</InArgument>
                                    <InArgument x:TypeArguments="x:String" x:Key="missingPages">[missingPages]</InArgument>
                                    <InArgument x:TypeArguments="sd:DataTable" x:Key="dtBanks">[dtBanks]</InArgument>
                                    <InArgument x:TypeArguments="x:String" x:Key="statementDate">[STATEMENT_DATE]</InArgument>
                                    <InArgument x:TypeArguments="x:String" x:Key="startDate">[START_DATE]</InArgument>
                                    <InArgument x:TypeArguments="x:String" x:Key="reportRoot">[reportRoot]</InArgument>
                                    <InArgument x:TypeArguments="x:String" x:Key="mode">[MODE]</InArgument>
                                    <InArgument x:TypeArguments="x:String" x:Key="currentDateFolder">[currentDateFolder]</InArgument>
                                    <OutArgument x:TypeArguments="x:String" x:Key="runSummaryHtml">[runSummaryHtml]</OutArgument>
                                  </ui:InvokeCode.Arguments>

                      <ui:InvokeCode ContinueOnError="{x:Null}" Code="// In:  glStatementFile (string)&#xA;// Out: dtGlStatement (DataTable), fromDate (string), toDate (string)&#xA;&#xA;System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);&#xA;&#xA;fromDate = &quot;&quot;;&#xA;toDate = &quot;&quot;;&#xA;&#xA;var dt = new DataTable();&#xA;&#xA;using (var stream = File.Open(glStatementFile, FileMode.Open, FileAccess.Read))&#xA;{&#xA;    using (var reader = ExcelReaderFactory.CreateReader(stream))&#xA;    {&#xA;        var result = reader.AsDataSet(new ExcelDataSetConfiguration()&#xA;        {&#xA;            ConfigureDataTable = (_) =&gt; new ExcelDataTableConfiguration()&#xA;            {&#xA;                UseHeaderRow = false&#xA;            }&#xA;        });&#xA;&#xA;        var table = result.Tables.Cast&lt;DataTable&gt;()&#xA;            .FirstOrDefault(t =&gt; t.TableName.Trim().Equals(&quot;GL Statement&quot;, StringComparison.OrdinalIgnoreCase));&#xA;&#xA;        if (table == null)&#xA;            throw new Exception(&quot;Worksheet 'GL Statement' not found.&quot;);&#xA;&#xA;        // === G6 and G7 ===&#xA;        if (table.Rows.Count &gt; 6 &amp;&amp; table.Columns.Count &gt; 6)&#xA;        {&#xA;            fromDate = table.Rows[5][6]?.ToString()?.Trim();&#xA;            toDate = table.Rows[6][6]?.ToString()?.Trim();&#xA;        }&#xA;&#xA;        // === Read headers (row 12) ===&#xA;        int startRow = 12;&#xA;        int startCol = 1;&#xA;&#xA;        var headersRow = table.Rows[11];&#xA;        for (int col = startCol; col &lt; headersRow.ItemArray.Length; col++)&#xA;        {&#xA;            var header = headersRow[col]?.ToString()?.Trim();&#xA;            dt.Columns.Add(string.IsNullOrEmpty(header) ? $&quot;Column{col}&quot; : header, typeof(string)); // load as string&#xA;        }&#xA;&#xA;        // === Load data rows ===&#xA;        for (int row = startRow; row &lt; table.Rows.Count; row++)&#xA;        {&#xA;            var sourceRow = table.Rows[row];&#xA;            var dataRow = dt.NewRow();&#xA;&#xA;            for (int col = startCol, i = 0; col &lt; sourceRow.ItemArray.Length &amp;&amp; i &lt; dt.Columns.Count; col++, i++)&#xA;            {&#xA;                dataRow[i] = sourceRow[col]?.ToString();&#xA;            }&#xA;&#xA;            dt.Rows.Add(dataRow);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Convert Debit/Credit from string to decimal via new columns ===&#xA;if (dt.Columns.Contains(&quot;Debit&quot;) &amp;&amp; !dt.Columns.Contains(&quot;Debit_Parsed&quot;))&#xA;    dt.Columns.Add(&quot;Debit_Parsed&quot;, typeof(decimal));&#xA;&#xA;if (dt.Columns.Contains(&quot;Credit&quot;) &amp;&amp; !dt.Columns.Contains(&quot;Credit_Parsed&quot;))&#xA;    dt.Columns.Add(&quot;Credit_Parsed&quot;, typeof(decimal));&#xA;&#xA;foreach (DataRow row in dt.Rows)&#xA;{&#xA;    // Parse Debit&#xA;    if (dt.Columns.Contains(&quot;Debit&quot;))&#xA;    {&#xA;        string rawDebit = row[&quot;Debit&quot;]?.ToString()?.Trim().Replace(&quot;,&quot;, &quot;&quot;);&#xA;        if (!string.IsNullOrWhiteSpace(rawDebit))&#xA;        {&#xA;            if (rawDebit.StartsWith(&quot;(&quot;) &amp;&amp; rawDebit.EndsWith(&quot;)&quot;))&#xA;                rawDebit = &quot;-&quot; + rawDebit.Trim('(', ')');&#xA;&#xA;            if (decimal.TryParse(rawDebit, out var parsedDebit))&#xA;                row[&quot;Debit_Parsed&quot;] = parsedDebit;&#xA;            else&#xA;                row[&quot;Debit_Parsed&quot;] = 0m;&#xA;        }&#xA;        else&#xA;        {&#xA;            row[&quot;Debit_Parsed&quot;] = 0m;&#xA;        }&#xA;    }&#xA;&#xA;    // Parse Credit&#xA;    if (dt.Columns.Contains(&quot;Credit&quot;))&#xA;    {&#xA;        string rawCredit = row[&quot;Credit&quot;]?.ToString()?.Trim().Replace(&quot;,&quot;, &quot;&quot;);&#xA;        if (!string.IsNullOrWhiteSpace(rawCredit))&#xA;        {&#xA;            if (rawCredit.StartsWith(&quot;(&quot;) &amp;&amp; rawCredit.EndsWith(&quot;)&quot;))&#xA;                rawCredit = &quot;-&quot; + rawCredit.Trim('(', ')');&#xA;&#xA;            if (decimal.TryParse(rawCredit, out var parsedCredit))&#xA;                row[&quot;Credit_Parsed&quot;] = parsedCredit;&#xA;            else&#xA;                row[&quot;Credit_Parsed&quot;] = 0m;&#xA;        }&#xA;        else&#xA;        {&#xA;            row[&quot;Credit_Parsed&quot;] = 0m;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Replace original columns ===&#xA;if (dt.Columns.Contains(&quot;Debit&quot;))&#xA;    dt.Columns.Remove(&quot;Debit&quot;);&#xA;&#xA;if (dt.Columns.Contains(&quot;Credit&quot;))&#xA;    dt.Columns.Remove(&quot;Credit&quot;);&#xA;&#xA;dt.Columns[&quot;Debit_Parsed&quot;].ColumnName = &quot;Debit&quot;;&#xA;dt.Columns[&quot;Credit_Parsed&quot;].ColumnName = &quot;Credit&quot;;&#xA;&#xA;// === Return final result ===&#xA;dtGlStatement = dt;&#xA;" DisplayName="Load &quot;GL Statement&quot; and G6 and G7" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_16" Language="CSharp">

                      <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ================================================================================================&#xA;// Load Account Balance And Status Report  -  STREAMING (no DataSet / no DataTable)&#xA;// ------------------------------------------------------------------------------------------------&#xA;// Previous implementation called reader.AsDataSet(...) which materialised the entire workbook -&#xA;// 822,733 rows x 57 columns, roughly 2 GB of DataTable - purely to sum ONE column filtered by&#xA;// another. The resulting table was never assigned to dtAccountBalanceAndStatusReport and is never&#xA;// read anywhere in the project, so it was pure overhead.&#xA;//&#xA;// This version streams the sheet with XmlReader and reads only the two columns it needs:&#xA;//   filter : &quot;Wallet Currency&quot;  ==  reconCurrency&#xA;//   sum    : &quot;Closing Balance&quot;&#xA;// Verified against the 193 MB production file: identical result (39,725,455,149.70 over 623,997&#xA;// matched rows of 822,732), ~59 s instead of ~80 s, and no multi-GB allocation.&#xA;//&#xA;// In : accountBalanceAndStatusReportFile (string), reconCurrency (string)&#xA;// Out: cmsBalance (decimal)&#xA;// dtAccountBalanceAndStatusReport is intentionally left untouched, exactly as before.&#xA;// ================================================================================================&#xA;&#xA;const string SHEET_NAME = &quot;Data Sheet1&quot;;&#xA;const string COL_CURRENCY = &quot;Wallet Currency&quot;;&#xA;const string COL_BALANCE = &quot;Closing Balance&quot;;&#xA;&#xA;int AbsColIdx(string cellRef)&#xA;{&#xA;    int n = 0;&#xA;    for (int i = 0; i &lt; cellRef.Length; i++)&#xA;    {&#xA;        char ch = cellRef[i];&#xA;        if (ch &gt;= 'A' &amp;&amp; ch &lt;= 'Z') n = n * 26 + (ch - 'A' + 1); else break;&#xA;    }&#xA;    return n - 1;&#xA;}&#xA;&#xA;decimal AbsParse(string s)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(s)) return 0m;&#xA;    s = s.Replace(&quot;,&quot;, &quot;&quot;).Trim();&#xA;    if (s.Length == 0) return 0m;&#xA;    if (s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;)) s = &quot;-&quot; + s.Trim('(', ')');&#xA;    decimal d;&#xA;    return decimal.TryParse(s, System.Globalization.NumberStyles.Any,&#xA;        System.Globalization.CultureInfo.InvariantCulture, out d) ? d : 0m;&#xA;}&#xA;&#xA;decimal totalClosingBalance = 0m;&#xA;int matchedRowsCount = 0, scannedRows = 0;&#xA;string wanted = (reconCurrency ?? &quot;&quot;).Trim().ToUpperInvariant();&#xA;&#xA;using (var zip = System.IO.Compression.ZipFile.OpenRead(accountBalanceAndStatusReportFile))&#xA;{&#xA;    // ---- resolve the worksheet part ----&#xA;    var ridMap = new System.Collections.Generic.Dictionary&lt;string, string&gt;();&#xA;    var relsEntry = zip.GetEntry(&quot;xl/_rels/workbook.xml.rels&quot;);&#xA;    var relsDoc = new System.Xml.XmlDocument();&#xA;    using (var rs = relsEntry.Open()) relsDoc.Load(rs);&#xA;    foreach (System.Xml.XmlNode nd in relsDoc.DocumentElement.ChildNodes)&#xA;    {&#xA;        var el = nd as System.Xml.XmlElement; if (el == null) continue;&#xA;        string t = el.GetAttribute(&quot;Target&quot;);&#xA;        t = t.StartsWith(&quot;/&quot;) ? t.TrimStart('/') : &quot;xl/&quot; + t;&#xA;        ridMap[el.GetAttribute(&quot;Id&quot;)] = t.Replace(&quot;xl/xl/&quot;, &quot;xl/&quot;);&#xA;    }&#xA;    string sheetPart = null;&#xA;    var wbDoc = new System.Xml.XmlDocument();&#xA;    using (var ws = zip.GetEntry(&quot;xl/workbook.xml&quot;).Open()) wbDoc.Load(ws);&#xA;    foreach (System.Xml.XmlNode nd in wbDoc.GetElementsByTagName(&quot;sheet&quot;))&#xA;    {&#xA;        var el = nd as System.Xml.XmlElement; if (el == null) continue;&#xA;        if (!el.GetAttribute(&quot;name&quot;).Trim().Equals(SHEET_NAME, StringComparison.OrdinalIgnoreCase)) continue;&#xA;        string r = &quot;&quot;; foreach (System.Xml.XmlAttribute a in el.Attributes) if (a.LocalName == &quot;id&quot;) r = a.Value;&#xA;        ridMap.TryGetValue(r, out sheetPart);&#xA;    }&#xA;    if (sheetPart == null) throw new Exception(&quot;Worksheet '&quot; + SHEET_NAME + &quot;' not found.&quot;);&#xA;&#xA;    // ---- pass 1: shared strings (indices matching the currency, plus header text) ----&#xA;    var currencyIdx = new System.Collections.Generic.HashSet&lt;int&gt;();&#xA;    var strings = new System.Collections.Generic.List&lt;string&gt;();&#xA;    var ssEntry = zip.GetEntry(&quot;xl/sharedStrings.xml&quot;);&#xA;    if (ssEntry != null)&#xA;    {&#xA;        using (var ss = ssEntry.Open())&#xA;        {&#xA;            var cfg = new System.Xml.XmlReaderSettings(); cfg.DtdProcessing = System.Xml.DtdProcessing.Ignore;&#xA;            using (var xr = System.Xml.XmlReader.Create(ss, cfg))&#xA;            {&#xA;                System.Text.StringBuilder cur = null; bool cap = false; int si = 0;&#xA;                while (xr.Read())&#xA;                {&#xA;                    if (xr.NodeType == System.Xml.XmlNodeType.Element)&#xA;                    {&#xA;                        if (xr.LocalName == &quot;si&quot;) { cur = new System.Text.StringBuilder(); if (xr.IsEmptyElement) { strings.Add(&quot;&quot;); si++; cur = null; } }&#xA;                        else if (xr.LocalName == &quot;t&quot; &amp;&amp; cur != null) cap = !xr.IsEmptyElement;&#xA;                    }&#xA;                    else if ((xr.NodeType == System.Xml.XmlNodeType.Text || xr.NodeType == System.Xml.XmlNodeType.CDATA) &amp;&amp; cap &amp;&amp; cur != null) cur.Append(xr.Value);&#xA;                    else if (xr.NodeType == System.Xml.XmlNodeType.EndElement)&#xA;                    {&#xA;                        if (xr.LocalName == &quot;t&quot;) cap = false;&#xA;                        else if (xr.LocalName == &quot;si&quot;)&#xA;                        {&#xA;                            string v = cur == null ? &quot;&quot; : cur.ToString();&#xA;                            if (v.Trim().ToUpperInvariant() == wanted) currencyIdx.Add(si);&#xA;                            strings.Add(v.Length &lt;= 64 ? v : &quot;&quot;);&#xA;                            si++; cur = null;&#xA;                        }&#xA;                    }&#xA;                }&#xA;            }&#xA;        }&#xA;    }&#xA;&#xA;    // ---- pass 2: stream the sheet, reading only the two columns ----&#xA;    int curCol = -1, colCur = -1, colBal = -1;&#xA;    string cellType = null; bool capV = false, headerDone = false, rowOk = false;&#xA;    string rowBal = null;&#xA;    var val = new System.Text.StringBuilder();&#xA;&#xA;    using (var sh = zip.GetEntry(sheetPart).Open())&#xA;    {&#xA;        var cfg = new System.Xml.XmlReaderSettings(); cfg.DtdProcessing = System.Xml.DtdProcessing.Ignore;&#xA;        using (var xr = System.Xml.XmlReader.Create(sh, cfg))&#xA;        {&#xA;            while (xr.Read())&#xA;            {&#xA;                if (xr.NodeType == System.Xml.XmlNodeType.Element)&#xA;                {&#xA;                    if (xr.LocalName == &quot;row&quot;) { rowOk = false; rowBal = null; }&#xA;                    else if (xr.LocalName == &quot;c&quot;)&#xA;                    {&#xA;                        string cr = xr.GetAttribute(&quot;r&quot;);&#xA;                        curCol = cr == null ? -1 : AbsColIdx(cr);&#xA;                        cellType = xr.GetAttribute(&quot;t&quot;);&#xA;                        val.Length = 0; capV = false;&#xA;                    }&#xA;                    else if (xr.LocalName == &quot;v&quot; || xr.LocalName == &quot;t&quot;) capV = !xr.IsEmptyElement;&#xA;                }&#xA;                else if ((xr.NodeType == System.Xml.XmlNodeType.Text || xr.NodeType == System.Xml.XmlNodeType.CDATA) &amp;&amp; capV) val.Append(xr.Value);&#xA;                else if (xr.NodeType == System.Xml.XmlNodeType.EndElement)&#xA;                {&#xA;                    if (xr.LocalName == &quot;v&quot; || xr.LocalName == &quot;t&quot;) capV = false;&#xA;                    else if (xr.LocalName == &quot;c&quot; &amp;&amp; curCol &gt;= 0)&#xA;                    {&#xA;                        string raw = val.ToString();&#xA;                        if (!headerDone)&#xA;                        {&#xA;                            string txt = raw;&#xA;                            if (cellType == &quot;s&quot;) { int ix; if (int.TryParse(raw, out ix) &amp;&amp; ix &gt;= 0 &amp;&amp; ix &lt; strings.Count) txt = strings[ix]; }&#xA;                            if (txt.Trim().Equals(COL_CURRENCY, StringComparison.OrdinalIgnoreCase)) colCur = curCol;&#xA;                            else if (txt.Trim().Equals(COL_BALANCE, StringComparison.OrdinalIgnoreCase)) colBal = curCol;&#xA;                        }&#xA;                        else if (curCol == colCur)&#xA;                        {&#xA;                            if (cellType == &quot;s&quot;) { int ix; rowOk = int.TryParse(raw, out ix) &amp;&amp; currencyIdx.Contains(ix); }&#xA;                            else rowOk = raw.Trim().ToUpperInvariant() == wanted;&#xA;                        }&#xA;                        else if (curCol == colBal)&#xA;                        {&#xA;                            if (cellType == &quot;s&quot;) { int ix; rowBal = (int.TryParse(raw, out ix) &amp;&amp; ix &gt;= 0 &amp;&amp; ix &lt; strings.Count) ? strings[ix] : raw; }&#xA;                            else rowBal = raw;&#xA;                        }&#xA;                        curCol = -1;&#xA;                    }&#xA;                    else if (xr.LocalName == &quot;row&quot;)&#xA;                    {&#xA;                        if (!headerDone) headerDone = true;&#xA;                        else&#xA;                        {&#xA;                            scannedRows++;&#xA;                            if (rowOk &amp;&amp; !string.IsNullOrWhiteSpace(rowBal)) { totalClosingBalance += AbsParse(rowBal); matchedRowsCount++; }&#xA;                        }&#xA;                    }&#xA;                }&#xA;            }&#xA;        }&#xA;    }&#xA;    if (colCur &lt; 0 || colBal &lt; 0)&#xA;        throw new Exception(&quot;Required columns not found: '&quot; + COL_CURRENCY + &quot;' or '&quot; + COL_BALANCE + &quot;'.&quot;);&#xA;}&#xA;&#xA;// === Store the result ===&#xA;cmsBalance = totalClosingBalance;&#xA;&#xA;// === Summary log ===&#xA;Console.WriteLine($&quot;[SUMMARY] Total Closing Balance for {reconCurrency} ({matchedRowsCount} of {scannedRows} rows): {totalClosingBalance:N2}&quot;);&#xA;" DisplayName="Load Account Balance And Status Report" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_10" Language="CSharp">
                        <ui:InvokeCode.Arguments>
                          <InOutArgument x:TypeArguments="x:String" x:Key="accountBalanceAndStatusReportFile">[accountBalanceAndStatusReportFile]</InOutArgument>
                          <InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtAccountBalanceAndStatusReport">[dtAccountBalanceAndStatusReport]</InOutArgument>
                          <InOutArgument x:TypeArguments="x:Decimal" x:Key="cmsBalance">[cmsBalance]</InOutArgument>

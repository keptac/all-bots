            <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Setup ===&#xA;CultureInfo inv = CultureInfo.InvariantCulture;&#xA;&#xA;// === Prepare DataTable ===&#xA;var dt = new DataTable();&#xA;lastReconDate = &quot;&quot;;&#xA;adjustedCBSBalance = 0m;&#xA;&#xA;// === Open workbook using EPPlus ===&#xA;using var package = new ExcelPackage(new FileInfo(historicalReconReportFile));&#xA;var ws = package.Workbook.Worksheets[&quot;Recon Report&quot;]&#xA;    ?? throw new Exception(&quot;Worksheet 'Recon Report' not found.&quot;);&#xA;&#xA;// === 1) Read Last Recon Date (H6) ===&#xA;lastReconDate = ws.Cells[6, 8].Text?.Trim() ?? &quot;&quot;;&#xA;&#xA;// === 2) Read Adjusted CBS Balance (K9) ===&#xA;var k9Raw = ws.Cells[9, 11].Text?.Trim() ?? &quot;&quot;;&#xA;if (string.IsNullOrWhiteSpace(k9Raw))&#xA;    throw new Exception(&quot;Cell K9 empty—recalculate &amp; save.&quot;);&#xA;&#xA;var normK9 = k9Raw&#xA;    .Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;)&#xA;    .Replace(&quot;Dr&quot;, &quot;&quot;, StringComparison.OrdinalIgnoreCase)&#xA;    .Replace(&quot;Cr&quot;, &quot;&quot;, StringComparison.OrdinalIgnoreCase)&#xA;    .Replace(&quot;,&quot;, &quot;&quot;).Trim();&#xA;&#xA;if (!decimal.TryParse(normK9, NumberStyles.Any, inv, out adjustedCBSBalance))&#xA;    throw new Exception($&quot;Cannot parse CBS balance '{k9Raw}'&quot;);&#xA;&#xA;// === 3) Define expected columns ===&#xA;var orderedColumns = new (string Name, Type Type)[]&#xA;{&#xA;    (&quot;SNO&quot;, typeof(string)),&#xA;    (&quot;Branch code&quot;, typeof(string)),&#xA;    (&quot;GL_Code&quot;, typeof(string)),&#xA;    (&quot;GL Description&quot;, typeof(string)),&#xA;    (&quot;Booking Date&quot;, typeof(string)),&#xA;    (&quot;Value Date&quot;, typeof(string)),&#xA;    (&quot;Transaction Ref No:&quot;, typeof(string)),&#xA;    (&quot;Narration&quot;, typeof(string)),&#xA;    ($&quot;Debit ({reconCurrency})&quot;, typeof(decimal)),&#xA;    ($&quot;Credit ({reconCurrency})&quot;, typeof(decimal)),&#xA;    (&quot;Aging&quot;, typeof(string)),&#xA;    (&quot;Aging Group&quot;, typeof(string)),&#xA;    (&quot;BOT Classification&quot;, typeof(string)),&#xA;    (&quot;Root Cause&quot;, typeof(string)),&#xA;    (&quot;Root Cause Category&quot;, typeof(string)),&#xA;    (&quot;Recommended Action&quot;, typeof(string)),&#xA;    (&quot;Action Owner&quot;, typeof(string))&#xA;};&#xA;&#xA;// === 4) Read header row (row 17) and map to column indices ===&#xA;int headerRow = 17, dataStartRow = 18;&#xA;var headerMap = new Dictionary&lt;string, int&gt;();&#xA;for (int c = 1; c &lt;= ws.Dimension.End.Column; c++)&#xA;{&#xA;    string headerText = ws.Cells[headerRow, c].Text?.Trim();&#xA;    if (!string.IsNullOrEmpty(headerText))&#xA;        headerMap[headerText.ToLowerInvariant()] = c;&#xA;}&#xA;&#xA;var columnIndices = new Dictionary&lt;string, int&gt;();&#xA;foreach (var (colName, _) in orderedColumns)&#xA;{&#xA;    columnIndices[colName] = headerMap.TryGetValue(colName.ToLowerInvariant(), out int idx) ? idx : -1;&#xA;    if (columnIndices[colName] == -1)&#xA;        throw new Exception($&quot;Missing expected column '{colName}' in header row {headerRow}&quot;);&#xA;}&#xA;&#xA;// === 5) Build DataTable ===&#xA;foreach (var (name, type) in orderedColumns)&#xA;    dt.Columns.Add(name, type);&#xA;&#xA;// === 5b) Audit: count how many data rows are in the file ===&#xA;int fileRowCount = 0;&#xA;for (int r = dataStartRow; r &lt;= ws.Dimension.End.Row; r++)&#xA;{&#xA;    bool hasAny = false;&#xA;&#xA;    for (int i = 0; i &lt; orderedColumns.Length; i++)&#xA;    {&#xA;        string colName = orderedColumns[i].Name;&#xA;        int colIdx = columnIndices[colName];&#xA;        var val = ws.Cells[r, colIdx].Value;&#xA;&#xA;        if (val != null &amp;&amp; !string.IsNullOrWhiteSpace(val.ToString()))&#xA;        {&#xA;            hasAny = true;&#xA;            break;&#xA;        }&#xA;    }&#xA;&#xA;    if (hasAny)&#xA;        fileRowCount++;&#xA;}&#xA;&#xA;int loaded = 0;&#xA;&#xA;// === 6) Load raw data ===&#xA;for (int r = dataStartRow; r &lt;= ws.Dimension.End.Row; r++)&#xA;{&#xA;    var dr = dt.NewRow();&#xA;    bool hasAny = false;&#xA;&#xA;    for (int i = 0; i &lt; orderedColumns.Length; i++)&#xA;    {&#xA;        string colName = orderedColumns[i].Name;&#xA;        int colIdx = columnIndices[colName];&#xA;        var val = ws.Cells[r, colIdx].Value;&#xA;&#xA;        if (orderedColumns[i].Type == typeof(decimal))&#xA;            dr[i] = TryParseDecimal(val);&#xA;        else&#xA;            dr[i] = val?.ToString()?.Trim();&#xA;&#xA;        if (val != null &amp;&amp; !string.IsNullOrWhiteSpace(val.ToString()))&#xA;            hasAny = true;&#xA;    }&#xA;&#xA;    if (hasAny)&#xA;    {&#xA;        dt.Rows.Add(dr);&#xA;        loaded++;&#xA;    }&#xA;}&#xA;&#xA;// === 7) Add formatted columns ===&#xA;dt.Columns.Add(&quot;Booking Date (Formatted)&quot;, typeof(string));&#xA;dt.Columns.Add(&quot;Value Date (Formatted)&quot;, typeof(string));&#xA;dt.Columns.Add(&quot;Debit_Final&quot;, typeof(decimal));&#xA;dt.Columns.Add(&quot;Credit_Final&quot;, typeof(decimal));&#xA;&#xA;// === 8) Parse and format values ===&#xA;int bookingCol = dt.Columns.IndexOf(&quot;Booking Date&quot;);&#xA;int valueCol = dt.Columns.IndexOf(&quot;Value Date&quot;);&#xA;int debitCol = dt.Columns.IndexOf($&quot;Debit ({reconCurrency})&quot;);&#xA;int creditCol = dt.Columns.IndexOf($&quot;Credit ({reconCurrency})&quot;);&#xA;&#xA;foreach (DataRow row in dt.Rows)&#xA;{&#xA;    var bookingRaw = row[bookingCol]?.ToString();&#xA;    var valueRaw = row[valueCol]?.ToString();&#xA;&#xA;    var bookingParsed = TryParseDate(bookingRaw);&#xA;    var valueParsed = TryParseDate(valueRaw);&#xA;&#xA;    row[&quot;Booking Date (Formatted)&quot;] = bookingParsed != null&#xA;        ? bookingParsed.Value.ToString(&quot;dd-MMM-yyyy&quot;, inv)&#xA;        : bookingRaw;&#xA;&#xA;    row[&quot;Value Date (Formatted)&quot;] = valueParsed != null&#xA;        ? valueParsed.Value.ToString(&quot;dd-MMM-yyyy&quot;, inv)&#xA;        : valueRaw;&#xA;&#xA;    row[&quot;Debit_Final&quot;] = row[debitCol] is decimal d ? d : 0m;&#xA;    row[&quot;Credit_Final&quot;] = row[creditCol] is decimal c ? c : 0m;&#xA;}&#xA;&#xA;// === 9) Remove originals and rename formatted columns ===&#xA;if (dt.Columns.Contains(&quot;Booking Date&quot;)) dt.Columns.Remove(&quot;Booking Date&quot;);&#xA;if (dt.Columns.Contains(&quot;Value Date&quot;)) dt.Columns.Remove(&quot;Value Date&quot;);&#xA;dt.Columns[&quot;Booking Date (Formatted)&quot;].ColumnName = &quot;Booking Date&quot;;&#xA;dt.Columns[&quot;Value Date (Formatted)&quot;].ColumnName = &quot;Value Date&quot;;&#xA;&#xA;if (dt.Columns.Contains($&quot;Debit ({reconCurrency})&quot;)) dt.Columns.Remove($&quot;Debit ({reconCurrency})&quot;);&#xA;if (dt.Columns.Contains($&quot;Credit ({reconCurrency})&quot;)) dt.Columns.Remove($&quot;Credit ({reconCurrency})&quot;);&#xA;dt.Columns[&quot;Debit_Final&quot;].ColumnName = $&quot;Debit ({reconCurrency})&quot;;&#xA;dt.Columns[&quot;Credit_Final&quot;].ColumnName = $&quot;Credit ({reconCurrency})&quot;;&#xA;&#xA;// === 10) Assign output ===&#xA;dtHistoricalReconTransactionsReport = dt;&#xA;&#xA;// === 11) Summary ===&#xA;var currencyCol = reconCurrency; // local copy for LINQ&#xA;decimal totalDebit = dt.AsEnumerable().Sum(r =&gt; r.Field&lt;decimal&gt;($&quot;Debit ({currencyCol})&quot;));&#xA;decimal totalCredit = dt.AsEnumerable().Sum(r =&gt; r.Field&lt;decimal&gt;($&quot;Credit ({currencyCol})&quot;));&#xA;int negCreditCount = dt.AsEnumerable().Count(r =&gt; r.Field&lt;decimal&gt;($&quot;Credit ({currencyCol})&quot;) &lt; 0);&#xA;&#xA;// === 11b) Audit logs ===&#xA;Console.WriteLine($&quot;📄 File rows with data (from Excel): {fileRowCount}&quot;);&#xA;Console.WriteLine($&quot;📥 Loaded rows into DataTable       : {loaded}&quot;);&#xA;Console.WriteLine($&quot;⚠️ Skipped empty rows                : {fileRowCount - loaded}&quot;);&#xA;&#xA;Console.WriteLine($&quot;✅ Last Recon Date = '{lastReconDate}'&quot;);&#xA;Console.WriteLine($&quot;✅ Adjusted CBS Balance = {adjustedCBSBalance:N2}&quot;);&#xA;Console.WriteLine($&quot;🔢 Rows with negative Credit: {negCreditCount}&quot;);&#xA;Console.WriteLine($&quot;📊 Total Debit ({currencyCol}): {totalDebit:N2}&quot;);&#xA;Console.WriteLine($&quot;📊 Total Credit ({currencyCol}): {totalCredit:N2}&quot;);&#xA;&#xA;// === Helper Functions ===&#xA;DateTime? TryParseDate(object raw)&#xA;{&#xA;    if (raw == null) return null;&#xA;&#xA;    if (raw is DateTime dt) return dt;&#xA;&#xA;    // Try Excel serial&#xA;    if (double.TryParse(raw.ToString(), out double serial) &amp;&amp; serial &gt;= 0 &amp;&amp; serial &lt; 2958466)&#xA;    {&#xA;        try { return DateTime.FromOADate(serial); }&#xA;        catch { return null; }&#xA;    }&#xA;&#xA;    // Try string formats&#xA;    string str = raw.ToString().Trim();&#xA;    string[] formats = { &quot;dd/MM/yyyy HH:mm:ss&quot;, &quot;dd/MM/yyyy&quot; };&#xA;    foreach (var fmt in formats)&#xA;    {&#xA;        if (DateTime.TryParseExact(str, fmt, inv, DateTimeStyles.None, out DateTime dt2))&#xA;            return dt2;&#xA;    }&#xA;&#xA;    return null;&#xA;}&#xA;&#xA;decimal TryParseDecimal(object val)&#xA;{&#xA;    var str = val?.ToString()?.Trim()&#xA;        .Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;)&#xA;        .Replace(&quot;Cr&quot;, &quot;&quot;, StringComparison.OrdinalIgnoreCase)&#xA;        .Replace(&quot;Dr&quot;, &quot;&quot;, StringComparison.OrdinalIgnoreCase)&#xA;        .Replace(&quot;,&quot;, &quot;&quot;);&#xA;&#xA;    return decimal.TryParse(str, NumberStyles.Any, inv, out var v) ? v : 0m;&#xA;}&#xA;" DisplayName="19/11/2025 Load Recon Report ClosedXML.Excel" sap:VirtualizedContainerService.HintSize="486.6666666666667,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_60" Language="CSharp">

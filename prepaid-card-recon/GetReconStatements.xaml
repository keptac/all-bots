(string.IsNullOrWhiteSpace(input)) return &quot;&quot;;&#xA;&#xA;    // Replace all Unicode whitespace with standard space&#xA;    var cleaned = string.Concat(input.Select(c =&gt; char.IsWhiteSpace(c) ? ' ' : c));&#xA;&#xA;    // Collapse double spaces and remove colons, trim and lowercase&#xA;    return cleaned.Replace(&quot;:&quot;, &quot;&quot;)&#xA;                  .Replace(&quot;\u00A0&quot;, &quot;&quot;) // non-breaking space&#xA;                  .Replace(&quot;  &quot;, &quot; &quot;)&#xA;                  .Trim()&#xA;                  .ToLowerInvariant();&#xA;}&#xA;&#xA;// === Read header from row 17 ===&#xA;var headerRow = ws.Row(17);&#xA;var headerMap = new Dictionary&lt;string, int&gt;(); // normalizedHeader → columnIndex&#xA;&#xA;foreach (var cell in headerRow.Cells())&#xA;{&#xA;    var rawHeader = cell.GetString();&#xA;    var normHeader = Normalize(rawHeader);&#xA;    if (!string.IsNullOrWhiteSpace(normHeader) &amp;&amp; !headerMap.ContainsKey(normHeader))&#xA;    {&#xA;        headerMap[normHeader] = cell.Address.ColumnNumber;&#xA;    }&#xA;}&#xA;&#xA;// === Match expected headers with actual ===&#xA;var columnIndices = new Dictionary&lt;string, int&gt;();&#xA;foreach (var (expectedName, _) in orderedColumns)&#xA;{&#xA;    var normalizedExpected = Normalize(expectedName);&#xA;    columnIndices[expectedName] = headerMap.TryGetValue(normalizedExpected, out int colIdx) ? colIdx : -1;&#xA;}&#xA;&#xA;// === Validate all required columns exist ===&#xA;var missingCols = columnIndices.Where(kvp =&gt; kvp.Value == -1).Select(kvp =&gt; kvp.Key).ToList();&#xA;if (missingCols.Any())&#xA;{&#xA;    Console.WriteLine(&quot;❌ Missing columns:&quot;);&#xA;    foreach (var col in missingCols)&#xA;        Console.WriteLine($&quot; - {col}&quot;);&#xA;    throw new Exception(&quot;❌ Some required columns not found in the header row.&quot;);&#xA;}&#xA;&#xA;// === Create final DataTable with proper schema ===&#xA;var finalDt = new DataTable();&#xA;foreach (var col in orderedColumns)&#xA;    finalDt.Columns.Add(col.Name, col.Type);&#xA;&#xA;finalDt.BeginLoadData(); // for performance&#xA;&#xA;// === Decimal parser ===&#xA;decimal ParseAmount(string s)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(s)) return 0m;&#xA;    s = s.Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;).Replace(&quot;,&quot;, &quot;&quot;).Trim();&#xA;    return decimal.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out var v) ? v : 0m;&#xA;}&#xA;&#xA;// === Read rows from 18 down to last used ===&#xA;int startRow = 18;&#xA;int lastRow = ws.LastRowUsed().RowNumber();&#xA;int rowsAdded = 0;&#xA;&#xA;for (int r = startRow; r &lt;= lastRow; r++)&#xA;{&#xA;    var row = ws.Row(r);&#xA;&#xA;    // Validate &quot;SNO&quot; and &quot;Booking Date&quot; to avoid footer rows&#xA;    var snoColIndex = columnIndices[&quot;SNO&quot;];&#xA;    var snoVal = row.Cell(snoColIndex).GetString().Trim();&#xA;&#xA;    var bookingDateColIndex = columnIndices[&quot;Booking Date&quot;];&#xA;    var bookingDateVal = row.Cell(bookingDateColIndex).GetString().Trim();&#xA;&#xA;    bool isSnoInvalid = string.IsNullOrWhiteSpace(snoVal) || !long.TryParse(snoVal, out _);&#xA;    bool isBookingDateInvalid = string.IsNullOrWhiteSpace(bookingDateVal) || !DateTime.TryParse(bookingDateVal, out _);&#xA;&#xA;    if (isSnoInvalid &amp;&amp; isBookingDateInvalid)&#xA;    {&#xA;        Console.WriteLine($&quot;⛔ Footer or invalid data detected at Excel row {r}. Skipping remaining rows.&quot;);&#xA;        break;&#xA;    }&#xA;&#xA;    // Read and parse values&#xA;    var values = new object[orderedColumns.Length];&#xA;    for (int i = 0; i &lt; orderedColumns.Length; i++)&#xA;    {&#xA;        var (colName, colType) = orderedColumns[i];&#xA;        int colIdx = columnIndices[colName];&#xA;        var cell = row.Cell(colIdx);&#xA;        var cellVal = cell.GetString();&#xA;&#xA;        values[i] = (colType == typeof(decimal)) ? ParseAmount(cellVal) : cellVal?.Trim() ?? &quot;&quot;;&#xA;    }&#xA;&#xA;    finalDt.LoadDataRow(values, true);&#xA;    rowsAdded++;&#xA;}&#xA;&#xA;finalDt.EndLoadData();&#xA;dtHistoricalReconTransactionsReport = finalDt;&#xA;&#xA;// === Summary logging ===&#xA;Console.WriteLine($&quot;📄 Total Excel rows (from row {startRow}): {lastRow - startRow + 1}&quot;);&#xA;Console.WriteLine($&quot;✅ Total rows added to DataTable: {rowsAdded}&quot;);&#xA;&#xA;// === Totals calculation ===&#xA;int negCredit = 0;&#xA;decimal totalDebit = 0m, totalCredit = 0m;&#xA;&#xA;foreach (DataRow row in finalDt.Rows)&#xA;{&#xA;    var debit = row.Field&lt;decimal&gt;(&quot;Debit (TZS)&quot;);&#xA;    var credit = row.Field&lt;decimal&gt;(&quot;Credit (TZS)&quot;);&#xA;    if (credit &lt; 0) negCredit++;&#xA;    totalDebit += debit;&#xA;    totalCredit += credit;&#xA;}&#xA;&#xA;Console.WriteLine($&quot;🔢 Negative Credit Rows: {negCredit}&quot;);&#xA;Console.WriteLine($&quot;💰 Total Debit (TZS): {totalDebit:N2}&quot;);&#xA;Console.WriteLine($&quot;💳 Total Credit (TZS): {totalCredit:N2}&quot;);&#xA;" DisplayName="Load Recon Report ClosedXML.Excel" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_59" Language="CSharp">

                            <ui:InvokeCode ContinueOnError="{x:Null}" Code="// EPPlus License Context&#xA;//ExcelPackage.LicenseContext = LicenseContext.NonCommercial;&#xA;&#xA;using (var package = new ExcelPackage(new FileInfo(historicalReconReportFile)))&#xA;{&#xA;    var ws = package.Workbook.Worksheets[&quot;Recon Report&quot;];&#xA;    if (ws == null) throw new Exception(&quot;Worksheet 'Recon Report' not found.&quot;);&#xA;&#xA;    // === Extract glCutOffBalance from K9 ===&#xA;    glCutOffBalance = 0m;&#xA;    var raw = ws.Cells[&quot;K9&quot;].Text.Trim().Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;);&#xA;    if (!decimal.TryParse(raw, NumberStyles.Any, CultureInfo.InvariantCulture, out glCutOffBalance))&#xA;        Console.WriteLine($&quot;⚠️ Could not parse value from K9: '{raw}'&quot;);&#xA;    else&#xA;        Console.WriteLine($&quot;✅ glCutOffBalance (K9): {glCutOffBalance:N2}&quot;);&#xA;&#xA;    // === Define expected columns ===&#xA;    var orderedColumns = new (string Name, Type Type)[]&#xA;    {&#xA;        (&quot;SNO&quot;, typeof(string)),&#xA;        (&quot;Branch code&quot;, typeof(string)),&#xA;        (&quot;GL_Code&quot;, typeof(string)),&#xA;        (&quot;GL Description&quot;, typeof(string)),&#xA;        (&quot;Booking Date&quot;, typeof(string)),&#xA;        (&quot;Value Date&quot;, typeof(string)),&#xA;        (&quot;Transaction Ref No:&quot;, typeof(string)),&#xA;        (&quot;Narration&quot;, typeof(string)),&#xA;        (&quot;Debit (TZS)&quot;, typeof(decimal)),&#xA;        (&quot;Credit (TZS)&quot;, typeof(decimal)),&#xA;        (&quot;Aging&quot;, typeof(string)),&#xA;        (&quot;Aging Group&quot;, typeof(string)),&#xA;        (&quot;BOT Classification&quot;, typeof(string)),&#xA;        (&quot;Root Cause&quot;, typeof(string)),&#xA;        (&quot;Root Cause Category&quot;, typeof(string)),&#xA;        (&quot;Recommended Action&quot;, typeof(string)),&#xA;        (&quot;Action Owner&quot;, typeof(string))&#xA;    };&#xA;&#xA;    string Normalize(string input) =&gt;&#xA;        input?.Replace(&quot;:&quot;, &quot;&quot;)&#xA;              .Replace(&quot;\u00A0&quot;, &quot; &quot;)&#xA;              .Replace(&quot; &quot;, &quot; &quot;)&#xA;              .Trim()&#xA;              .ToLowerInvariant() ?? &quot;&quot;;&#xA;&#xA;    // === Map header row (row 17) ===&#xA;    var headerMap = new Dictionary&lt;string, int&gt;();&#xA;    for (int col = 1; col &lt;= ws.Dimension.End.Column; col++)&#xA;    {&#xA;        var rawHeader = ws.Cells[17, col].Text;&#xA;        var norm = Normalize(rawHeader);&#xA;        if (!string.IsNullOrWhiteSpace(norm) &amp;&amp; !headerMap.ContainsKey(norm))&#xA;            headerMap[norm] = col;&#xA;    }&#xA;&#xA;    var columnIndices = new Dictionary&lt;string, int&gt;();&#xA;    foreach (var (name, _) in orderedColumns)&#xA;    {&#xA;        var norm = Normalize(name);&#xA;        columnIndices[name] = headerMap.TryGetValue(norm, out int colIdx) ? colIdx : -1;&#xA;    }&#xA;&#xA;    var missingCols = columnIndices.Where(kvp =&gt; kvp.Value == -1).Select(kvp =&gt; kvp.Key).ToList();&#xA;    if (missingCols.Any())&#xA;    {&#xA;        Console.WriteLine(&quot;❌ Missing columns:&quot;);&#xA;        foreach (var col in missingCols)&#xA;            Console.WriteLine($&quot; - {col}&quot;);&#xA;        throw new Exception(&quot;❌ Some required columns not found in the header row.&quot;);&#xA;    }&#xA;&#xA;    var finalDt = new DataTable();&#xA;    foreach (var col in orderedColumns)&#xA;        finalDt.Columns.Add(col.Name, col.Type);&#xA;&#xA;    decimal ParseAmount(string s)&#xA;    {&#xA;        if (string.IsNullOrWhiteSpace(s)) return 0m;&#xA;        s = s.Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;).Replace(&quot;,&quot;, &quot;&quot;).Trim();&#xA;        return decimal.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out var v) ? Math.Round(v, 2) : 0m;&#xA;    }&#xA;&#xA;    finalDt.BeginLoadData();&#xA;&#xA;    int startRow = 18;&#xA;    int lastRow = ws.Dimension.End.Row;&#xA;    int rowsAdded = 0;&#xA;    int consecutiveSkips = 0;&#xA;&#xA;    for (int row = startRow; row &lt;= lastRow; row++)&#xA;    {&#xA;        string sno = ws.Cells[row, columnIndices[&quot;SNO&quot;]].Text?.Trim();&#xA;        string branch = ws.Cells[row, columnIndices[&quot;Branch code&quot;]].Text?.Trim();&#xA;        string glCode = ws.Cells[row, columnIndices[&quot;GL_Code&quot;]].Text?.Trim();&#xA;        string glDesc = ws.Cells[row, columnIndices[&quot;GL Description&quot;]].Text?.Trim();&#xA;&#xA;        bool isCoreRowValid = !string.IsNullOrWhiteSpace(sno) &amp;&amp;&#xA;                              !string.IsNullOrWhiteSpace(branch) &amp;&amp;&#xA;                              !string.IsNullOrWhiteSpace(glCode) &amp;&amp;&#xA;                              !string.IsNullOrWhiteSpace(glDesc);&#xA;&#xA;        if (!isCoreRowValid)&#xA;        {&#xA;            Console.WriteLine($&quot;🚫 Skipped row {row} - Missing fields: SNO='{sno}', Branch='{branch}', GL_Code='{glCode}', GL_Desc='{glDesc}'&quot;);&#xA;            consecutiveSkips++;&#xA;            if (consecutiveSkips &gt;= 3)&#xA;            {&#xA;                Console.WriteLine($&quot;🛑 Stopping: Encountered {consecutiveSkips} consecutive invalid rows. Ending load early.&quot;);&#xA;                break;&#xA;            }&#xA;            continue;&#xA;        }&#xA;&#xA;        consecutiveSkips = 0; // Reset&#xA;&#xA;        var values = new object[orderedColumns.Length];&#xA;        for (int i = 0; i &lt; orderedColumns.Length; i++)&#xA;        {&#xA;            var (colName, colType) = orderedColumns[i];&#xA;            int colIdx = columnIndices[colName];&#xA;            var cell = ws.Cells[row, colIdx];&#xA;&#xA;            if (colType == typeof(decimal))&#xA;            {&#xA;                values[i] = ParseAmount(cell.Text);&#xA;            }&#xA;            else if (colName == &quot;Booking Date&quot; || colName == &quot;Value Date&quot;)&#xA;            {&#xA;                if (cell.Value is DateTime dt)&#xA;                    values[i] = dt.ToString(&quot;MM/dd/yyyy&quot;, CultureInfo.InvariantCulture);&#xA;                else if (DateTime.TryParse(cell.Text, out var parsedDate))&#xA;                    values[i] = parsedDate.ToString(&quot;MM/dd/yyyy&quot;, CultureInfo.InvariantCulture);&#xA;                else&#xA;                    values[i] = &quot;&quot;;&#xA;            }&#xA;            else&#xA;            {&#xA;                values[i] = cell.Text?.Trim() ?? &quot;&quot;;&#xA;            }&#xA;        }&#xA;&#xA;        finalDt.LoadDataRow(values, true);&#xA;        rowsAdded++;&#xA;    }&#xA;&#xA;    finalDt.EndLoadData();&#xA;    dtHistoricalReconTransactionsReport = finalDt;&#xA;&#xA;    Console.WriteLine($&quot;📄 Total Excel rows scanned: {lastRow - startRow + 1}&quot;);&#xA;    Console.WriteLine($&quot;✅ Total valid rows loaded before stop: {rowsAdded}&quot;);&#xA;&#xA;    // === Totals Calculation ===&#xA;    decimal totalDebit = 0m, totalCredit = 0m;&#xA;    int debitZero = 0, creditZero = 0;&#xA;    int debitNegative = 0, creditNegative = 0;&#xA;    int highDebitCount = 0;&#xA;&#xA;    foreach (DataRow row in finalDt.Rows)&#xA;    {&#xA;        decimal debit = row.Field&lt;decimal&gt;(&quot;Debit (TZS)&quot;);&#xA;        decimal credit = row.Field&lt;decimal&gt;(&quot;Credit (TZS)&quot;);&#xA;&#xA;        totalDebit += debit;&#xA;        totalCredit += credit;&#xA;&#xA;        if (debit == 0) debitZero++;&#xA;        if (credit == 0) creditZero++;&#xA;        if (debit &lt; 0) debitNegative++;&#xA;        if (credit &lt; 0) creditNegative++;&#xA;&#xA;        if (debit &gt; 4000000)&#xA;        {&#xA;            highDebitCount++;&#xA;            Console.WriteLine($&quot;🔍 High Debit Row: {debit:N2}&quot;);&#xA;        }&#xA;    }&#xA;&#xA;    Console.WriteLine($&quot;💰 Total Debit (TZS): {totalDebit:N2}&quot;);&#xA;    Console.WriteLine($&quot;💳 Total Credit (TZS): {totalCredit:N2}&quot;);&#xA;    Console.WriteLine($&quot;🧾 Zero Debits: {debitZero}, Zero Credits: {creditZero}&quot;);&#xA;    Console.WriteLine($&quot;🔻 Negative Debits: {debitNegative}, Negative Credits: {creditNegative}&quot;);&#xA;    Console.WriteLine($&quot;⚠️ Rows with Debit &gt; 4M: {highDebitCount}&quot;);&#xA;}&#xA;" DisplayName="29/07 Load Recon Report ClosedXML.Excel" sap:VirtualizedContainerService.HintSize="416,48" sap2010:WorkflowViewState.IdRef="InvokeCode_58" Language="CSharp">

      <ui:InvokeCode ContinueOnError="{x:Null}" Code="using (var package = new ExcelPackage(new FileInfo(prepaidCardWorkingsFileName)))&#xA;{&#xA;    // --- Recreate MERGEREV sheet ---&#xA;    var wsRaw = package.Workbook.Worksheets.FirstOrDefault(w =&gt; &#xA;        w.Name.Trim().Equals(&quot;MERGEREV&quot;, StringComparison.OrdinalIgnoreCase));&#xA;    if (wsRaw != null) package.Workbook.Worksheets.Delete(wsRaw);&#xA;    wsRaw = package.Workbook.Worksheets.Add(&quot;MERGEREV&quot;);&#xA;&#xA;    if (dtHistoricalReconTransactionsReportRev == null)&#xA;        throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReportRev), &quot;Input DataTable is null.&quot;);&#xA;&#xA;    int totalRows = dtHistoricalReconTransactionsReportRev.Rows.Count;&#xA;    int totalCols = dtHistoricalReconTransactionsReportRev.Columns.Count;&#xA;&#xA;    // Write headers (row 1) if there are columns&#xA;    if (totalCols &gt; 0)&#xA;    {&#xA;        for (int c = 0; c &lt; totalCols; c++)&#xA;            wsRaw.Cells[1, c + 1].Value = dtHistoricalReconTransactionsReportRev.Columns[c].ColumnName;&#xA;&#xA;        wsRaw.Cells[1, 1, 1, totalCols].Style.Font.Bold = true;&#xA;    }&#xA;&#xA;    // Disable calculation for faster write&#xA;    package.Workbook.CalcMode = ExcelCalcMode.Manual;&#xA;&#xA;    // Write data only if there are rows&#xA;    if (totalRows &gt; 0 &amp;&amp; totalCols &gt; 0)&#xA;    {&#xA;        var values = new object[totalRows, totalCols];&#xA;        for (int r = 0; r &lt; totalRows; r++)&#xA;        {&#xA;            for (int c = 0; c &lt; totalCols; c++)&#xA;            {&#xA;                var v = dtHistoricalReconTransactionsReportRev.Rows[r][c];&#xA;                values[r, c] = (v == DBNull.Value) ? &quot;&quot; : v;&#xA;            }&#xA;        }&#xA;        // Bulk write: data starts at row 2&#xA;        wsRaw.Cells[2, 1, totalRows + 1, totalCols].Value = values;&#xA;&#xA;        // Apply number/date formatting in bulk – only if the columns exist&#xA;        int bookingCol = dtHistoricalReconTransactionsReportRev.Columns.Contains(&quot;Booking Date&quot;)&#xA;            ? dtHistoricalReconTransactionsReportRev.Columns[&quot;Booking Date&quot;].Ordinal + 1&#xA;            : -1;&#xA;        int valueCol = dtHistoricalReconTransactionsReportRev.Columns.Contains(&quot;Value Date&quot;)&#xA;            ? dtHistoricalReconTransactionsReportRev.Columns[&quot;Value Date&quot;].Ordinal + 1&#xA;            : -1;&#xA;&#xA;        // Guard the ranges to avoid &quot;start &gt; end&quot;&#xA;        if (bookingCol &gt; 0)&#xA;            wsRaw.Cells[2, bookingCol, totalRows + 1, bookingCol].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;        if (valueCol &gt; 0)&#xA;            wsRaw.Cells[2, valueCol, totalRows + 1, valueCol].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;    }&#xA;&#xA;    // (Optional) Auto-fit headers/columns if there is content&#xA;    if (totalCols &gt; 0)&#xA;        wsRaw.Cells[1, 1, Math.Max(1, totalRows + 1), totalCols].AutoFitColumns();&#xA;&#xA;    package.Save();&#xA;}&#xA;&#xA;Console.WriteLine($&quot;✅ dtHistoricalReconTransactionsReportRev saved to 'MERGEREV' — Rows: {dtHistoricalReconTransactionsReportRev.Rows.Count:N0}, Cols: {dtHistoricalReconTransactionsReportRev.Columns.Count:N0}.&quot;);&#xA;" DisplayName="Write merge reversals" sap:VirtualizedContainerService.HintSize="1169.3333333333333,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_81" Language="CSharp">

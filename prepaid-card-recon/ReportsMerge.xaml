            <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Args (In/Out): DataTable dtTransactionReport&#xA;&#xA;// --- Helper: robust parse for accounting numbers (supports &quot;()&quot;, &quot;-&quot;, trailing &quot;-&quot;) ---&#xA;Func&lt;object, decimal&gt; ParseBilling = (value) =&gt;&#xA;{&#xA;    if (value == null || value == DBNull.Value) return 0m;&#xA;&#xA;    var s = value.ToString().Trim();&#xA;    if (string.IsNullOrWhiteSpace(s)) return 0m;&#xA;&#xA;    bool negative = false;&#xA;&#xA;    // Accounting parentheses e.g. &quot;(1,234.56)&quot;&#xA;    if (s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;))&#xA;    {&#xA;        negative = true;&#xA;        s = s.Trim('(', ')').Trim();&#xA;    }&#xA;&#xA;    // Trailing minus e.g. &quot;123.45-&quot;&#xA;    if (s.EndsWith(&quot;-&quot;))&#xA;    {&#xA;        negative = true;&#xA;        s = s.Substring(0, s.Length - 1).Trim();&#xA;    }&#xA;&#xA;    // Leading minus e.g. &quot;-123.45&quot;&#xA;    if (s.StartsWith(&quot;-&quot;))&#xA;    {&#xA;        negative = true;&#xA;        s = s.Substring(1).Trim();&#xA;    }&#xA;&#xA;    // Remove thousand separators&#xA;    s = s.Replace(&quot;,&quot;, &quot;&quot;);&#xA;&#xA;    decimal v;&#xA;    if (!decimal.TryParse(s, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out v))&#xA;        return 0m;&#xA;&#xA;    return negative ? -v : v;&#xA;};&#xA;&#xA;// --- Ensure target column exists ---&#xA;string targetCol = &quot;DR/CR to Cardholder&quot;;&#xA;if (!dtTransactionReport.Columns.Contains(targetCol))&#xA;{&#xA;    dtTransactionReport.Columns.Add(targetCol, typeof(string));&#xA;}&#xA;&#xA;// --- Walk all rows, do not skip any ---&#xA;decimal totalDR = 0m; // sum of positive amounts&#xA;decimal totalCR = 0m; // sum of absolute negative amounts&#xA;int drCount = 0, crCount = 0, zeroCount = 0;&#xA;&#xA;foreach (DataRow row in dtTransactionReport.Rows)&#xA;{&#xA;    decimal amt = ParseBilling(row[&quot;Billing Amount&quot;]);&#xA;&#xA;    if (amt &gt; 0m)&#xA;    {&#xA;        row[targetCol] = &quot;DR&quot;;&#xA;        totalDR += amt;&#xA;        drCount++;&#xA;    }&#xA;    else if (amt &lt; 0m)&#xA;    {&#xA;        row[targetCol] = &quot;CR&quot;;&#xA;        totalCR += Math.Abs(amt);&#xA;        crCount++;&#xA;    }&#xA;    else&#xA;    {&#xA;        row[targetCol] = &quot;ZERO&quot;;&#xA;        zeroCount++;&#xA;    }&#xA;}&#xA;&#xA;// --- Log summary ---&#xA;Console.WriteLine($&quot;✅ Processed {dtTransactionReport.Rows.Count} rows (DR={drCount}, CR={crCount}, ZERO={zeroCount}).&quot;);&#xA;Console.WriteLine($&quot;📊 Total DR (sum of positives): {totalDR:N2}&quot;);&#xA;Console.WriteLine($&quot;📊 Total CR (sum of absolute negatives): {totalCR:N2}&quot;);&#xA;" DisplayName="TOTALS" sap:VirtualizedContainerService.HintSize="477.3333333333333,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_65" Language="CSharp">

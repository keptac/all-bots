            <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Args (In): string reconCurrency&#xA;// Args (In/Out): DataTable dtTransactionReport&#xA;&#xA;// Collect rows to delete first (to avoid modifying the collection while iterating)&#xA;var rowsToDelete = new List&lt;DataRow&gt;();&#xA;&#xA;foreach (DataRow row in dtTransactionReport.Rows)&#xA;{&#xA;    object currencyObj = row[&quot;Billing Currency&quot;];&#xA;    string currency = currencyObj == DBNull.Value ? &quot;&quot; : currencyObj.ToString().Trim();&#xA;&#xA;    if (!string.Equals(currency, reconCurrency, StringComparison.OrdinalIgnoreCase))&#xA;    {&#xA;        rowsToDelete.Add(row);&#xA;    }&#xA;}&#xA;&#xA;// Now remove them&#xA;foreach (var row in rowsToDelete)&#xA;{&#xA;    dtTransactionReport.Rows.Remove(row);&#xA;}&#xA;&#xA;Console.WriteLine($&quot;🗑 Deleted {rowsToDelete.Count} rows where Billing Currency != {reconCurrency}&quot;);&#xA;" DisplayName="BillingCurrency != reconCurrency dtTransactionReport" sap:VirtualizedContainerService.HintSize="477.3333333333333,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_74" Language="CSharp">

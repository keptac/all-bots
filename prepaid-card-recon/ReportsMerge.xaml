        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== HIST reversals removal (UiPath C# Invoke Code) ====&#xA;// Args (In):     string reconCurrency&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport, DataTable dtHistoricalReconTransactionsReportRev&#xA;&#xA;System.Diagnostics.Stopwatch sw = System.Diagnostics.Stopwatch.StartNew();&#xA;&#xA;int removedRowsCount = 0;&#xA;int groupsProcessed   = 0;&#xA;int pairsMatched      = 0;&#xA;int groupsSkippedEmptyRef = 0;&#xA;int rowsIgnoredOdd   = 0;&#xA;&#xA;var rowsToDelete = new HashSet&lt;DataRow&gt;();&#xA;var insertedKeys = new HashSet&lt;string&gt;(); // prevent duplicate inserts to *_Rev&#xA;&#xA;// Build column names once&#xA;string refCol     = &quot;Transaction Ref No:&quot;;&#xA;string debitCol   = &quot;Debit (&quot;  + reconCurrency + &quot;)&quot;;&#xA;string creditCol  = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xA;&#xA;// Defensive: ensure cols exist&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(refCol) ||&#xA;    !dtHistoricalReconTransactionsReport.Columns.Contains(debitCol) ||&#xA;    !dtHistoricalReconTransactionsReport.Columns.Contains(creditCol))&#xA;{&#xA;    Console.WriteLine($&quot;[REV] Missing required columns. Abort.&quot;);&#xA;    return;&#xA;}&#xA;&#xA;// Ensure the *_Rev table is schema-compatible&#xA;if (dtHistoricalReconTransactionsReportRev == null ||&#xA;    dtHistoricalReconTransactionsReportRev.Columns.Count != dtHistoricalReconTransactionsReport.Columns.Count)&#xA;{&#xA;    dtHistoricalReconTransactionsReportRev = dtHistoricalReconTransactionsReport.Clone();&#xA;}&#xA;&#xA;// ---------- Helpers ----------&#xA;string SanNum(string s)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(s)) return &quot;&quot;;&#xA;    // Remove thousands separators, spaces (incl. NBSP), plus signs&#xA;    s = s.Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot; &quot;, &quot;&quot;).Replace(&quot;\u00A0&quot;, &quot;&quot;).Replace(&quot;+&quot;, &quot;&quot;).Trim();&#xA;    return s;&#xA;}&#xA;&#xA;decimal ParseAmount(object value)&#xA;{&#xA;    if (value == null || value == DBNull.Value) return 0m;&#xA;    var raw = value.ToString().Trim();&#xA;    if (string.IsNullOrWhiteSpace(raw)) return 0m;&#xA;&#xA;    bool paren = raw.StartsWith(&quot;(&quot;) &amp;&amp; raw.EndsWith(&quot;)&quot;);&#xA;    string s = SanNum(raw);&#xA;    if (paren)&#xA;    {&#xA;        s = s.Replace(&quot;(&quot;, &quot;&quot;).Replace(&quot;)&quot;, &quot;&quot;);&#xA;    }&#xA;&#xA;    // Handle trailing minus like &quot;1234-&quot;&#xA;    bool trailingMinus = s.EndsWith(&quot;-&quot;);&#xA;    if (trailingMinus) s = s.Substring(0, s.Length - 1);&#xA;&#xA;    decimal v;&#xA;    if (!decimal.TryParse(s, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out v))&#xA;        return 0m;&#xA;&#xA;    if (paren || trailingMinus) v = -v;&#xA;    return v;&#xA;}&#xA;&#xA;// Amount equality with small tolerance&#xA;bool EqWithin(decimal a, decimal b, decimal eps = 0.01m) =&gt; Math.Abs(a - b) &lt;= eps;&#xA;&#xA;// Key maker for Rev table duplication guard (include per-group index to allow duplicates)&#xA;string MakeKey(string txnRef, decimal d, decimal c, int idx) =&gt; $&quot;{txnRef}|{d}|{c}|{idx}&quot;;&#xA;&#xA;// ---------- BEFORE balance snapshot ----------&#xA;decimal beforeDebit = 0m, beforeCredit = 0m;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    beforeDebit  += ParseAmount(r[debitCol]);&#xA;    beforeCredit += ParseAmount(r[creditCol]);&#xA;}&#xA;decimal beforeDiff = beforeDebit - beforeCredit;&#xA;Console.WriteLine($&quot;[BAL] BEFORE — Debit: {beforeDebit:N2} | Credit: {beforeCredit:N2} | Δ(D−C): {beforeDiff:N2}&quot;);&#xA;&#xA;// Totals of what we actually remove&#xA;decimal removedDebit = 0m, removedCredit = 0m;&#xA;&#xA;// ---------- Build lookup by Transaction Ref No ----------&#xA;var refLookup = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;(StringComparer.OrdinalIgnoreCase);&#xA;&#xA;foreach (DataRow r in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    if (r.RowState == DataRowState.Deleted) continue;&#xA;    string key = (r[refCol] == DBNull.Value ? &quot;&quot; : r[refCol].ToString().Trim());&#xA;    if (string.IsNullOrEmpty(key))&#xA;    {&#xA;        groupsSkippedEmptyRef++;&#xA;        continue;&#xA;    }&#xA;    if (!refLookup.TryGetValue(key, out var list))&#xA;    {&#xA;        list = new List&lt;DataRow&gt;();&#xA;        refLookup[key] = list;&#xA;    }&#xA;    list.Add(r);&#xA;}&#xA;&#xA;// ---------- For each Transaction Ref group, pair debits with credits of equal magnitude ----------&#xA;foreach (var kvp in refLookup)&#xA;{&#xA;    var txnRef = kvp.Key;&#xA;    var rows   = kvp.Value;&#xA;    if (rows == null || rows.Count == 0) continue;&#xA;&#xA;    groupsProcessed++;&#xA;&#xA;    // Build in-group lists with amounts &amp; stable index&#xA;    var debits  = new List&lt;(decimal amt, DataRow row, int idx)&gt;();&#xA;    var credits = new List&lt;(decimal amt, DataRow row, int idx)&gt;();&#xA;&#xA;    for (int i = 0; i &lt; rows.Count; i++)&#xA;    {&#xA;        var r = rows[i];&#xA;        if (r.RowState == DataRowState.Deleted) continue;&#xA;&#xA;        decimal d = ParseAmount(r[debitCol]);&#xA;        decimal c = ParseAmount(r[creditCol]);&#xA;&#xA;        // ignore fully-zero rows&#xA;        if (d == 0m &amp;&amp; c == 0m) continue;&#xA;&#xA;        if (d &gt; 0m &amp;&amp; c == 0m)&#xA;            debits.Add((d, r, i));&#xA;        else if (c &gt; 0m &amp;&amp; d == 0m)&#xA;            credits.Add((c, r, i));&#xA;        else&#xA;            rowsIgnoredOdd++;&#xA;    }&#xA;&#xA;    if (debits.Count == 0 || credits.Count == 0) continue;&#xA;&#xA;    // Greedy matching: for each debit, find the first equal credit (within tolerance)&#xA;    var usedDebits  = new HashSet&lt;int&gt;(); // by position in 'debits'&#xA;    var usedCredits = new HashSet&lt;int&gt;(); // by position in 'credits'&#xA;&#xA;    for (int i = 0; i &lt; debits.Count; i++)&#xA;    {&#xA;        if (usedDebits.Contains(i)) continue;&#xA;        var (dAmt, dRow, dIdx) = debits[i];&#xA;&#xA;        for (int j = 0; j &lt; credits.Count; j++)&#xA;        {&#xA;            if (usedCredits.Contains(j)) continue;&#xA;&#xA;            var (cAmt, cRow, cIdx) = credits[j];&#xA;&#xA;            if (EqWithin(dAmt, cAmt))&#xA;            {&#xA;                // Safety: assert same ref on both rows (should always hold within the group)&#xA;                string ref1 = (dRow[refCol] == DBNull.Value ? &quot;&quot; : dRow[refCol].ToString().Trim());&#xA;                string ref2 = (cRow[refCol] == DBNull.Value ? &quot;&quot; : cRow[refCol].ToString().Trim());&#xA;                if (!ref1.Equals(ref2, StringComparison.OrdinalIgnoreCase)) continue;&#xA;&#xA;                // Insert both rows into *_Rev exactly once&#xA;                string k1 = MakeKey(txnRef, ParseAmount(dRow[debitCol]), ParseAmount(dRow[creditCol]), dIdx);&#xA;                if (insertedKeys.Add(k1)) dtHistoricalReconTransactionsReportRev.ImportRow(dRow);&#xA;&#xA;                string k2 = MakeKey(txnRef, ParseAmount(cRow[debitCol]), ParseAmount(cRow[creditCol]), cIdx);&#xA;                if (insertedKeys.Add(k2)) dtHistoricalReconTransactionsReportRev.ImportRow(cRow);&#xA;&#xA;                // Mark for deletion &amp; accumulate removed totals&#xA;                rowsToDelete.Add(dRow);&#xA;                rowsToDelete.Add(cRow);&#xA;                removedDebit  += ParseAmount(dRow[debitCol]);&#xA;                removedCredit += ParseAmount(cRow[creditCol]);&#xA;&#xA;                usedDebits.Add(i);&#xA;                usedCredits.Add(j);&#xA;                pairsMatched++;&#xA;                break; // move to next debit&#xA;            }&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// ---------- Remove marked rows ----------&#xA;foreach (var r in rowsToDelete)&#xA;{&#xA;    try&#xA;    {&#xA;        if (r.Table != null &amp;&amp; r.RowState != DataRowState.Deleted)&#xA;        {&#xA;            dtHistoricalReconTransactionsReport.Rows.Remove(r);&#xA;            removedRowsCount++;&#xA;        }&#xA;    }&#xA;    catch (Exception ex)&#xA;    {&#xA;        Console.WriteLine($&quot;❌ Error removing row: {ex.Message}&quot;);&#xA;    }&#xA;}&#xA;&#xA;// ---------- AFTER balance snapshot &amp; identity check ----------&#xA;decimal afterDebit = 0m, afterCredit = 0m;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    afterDebit  += ParseAmount(r[debitCol]);&#xA;    afterCredit += ParseAmount(r[creditCol]);&#xA;}&#xA;decimal afterDiff = afterDebit - afterCredit;&#xA;&#xA;Console.WriteLine($&quot;[BAL] REMOVED — Debit: {removedDebit:N2} | Credit: {removedCredit:N2}&quot;);&#xA;Console.WriteLine($&quot;[BAL] AFTER   — Debit: {afterDebit:N2} | Credit: {afterCredit:N2} | Δ(D−C): {afterDiff:N2}&quot;);&#xA;&#xA;// Two invariants to verify:&#xA;// 1) Per-side identity: Pre − Removed = Post&#xA;// 2) Δ(D−C) unchanged (since we remove equal debit/credit pairs)&#xA;const decimal TOL = 0.01m;&#xA;bool okSideDebit  = Math.Abs((beforeDebit  - removedDebit ) - afterDebit ) &lt;= TOL;&#xA;bool okSideCredit = Math.Abs((beforeCredit - removedCredit) - afterCredit) &lt;= TOL;&#xA;bool okDelta      = Math.Abs(beforeDiff - afterDiff) &lt;= TOL;&#xA;&#xA;if (okSideDebit &amp;&amp; okSideCredit)&#xA;    Console.WriteLine($&quot;✅ Check 1 OK: Pre − Removed = Post (per-side) within ±{TOL:N2}.&quot;);&#xA;else&#xA;    Console.WriteLine($&quot;⚠️ Check 1 FAIL: (Debit or Credit) Pre − Removed ≠ Post beyond ±{TOL:N2}.&quot;);&#xA;&#xA;if (okDelta)&#xA;    Console.WriteLine($&quot;✅ Check 2 OK: Δ_before ({beforeDiff:N2}) ≈ Δ_after ({afterDiff:N2}) within ±{TOL:N2}.&quot;);&#xA;else&#xA;    Console.WriteLine($&quot;⚠️ Check 2 FAIL: Δ_before ({beforeDiff:N2}) vs Δ_after ({afterDiff:N2}).&quot;);&#xA;&#xA;// ---------- Final log ----------&#xA;sw.Stop();&#xA;Console.WriteLine($&quot;✅ REVERSALS (by Transaction Ref + amount): groups={groupsProcessed}, pairs={pairsMatched}, rows removed={removedRowsCount}, groupsSkippedEmptyRef={groupsSkippedEmptyRef}, rowsIgnoredOdd={rowsIgnoredOdd} in {sw.ElapsedMilliseconds} ms&quot;);&#xA;" DisplayName="GL Source REMOVE Reversals (Debit (reconCurrency)/Credit (reconCurrency) " sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_69" Language="CSharp">

debitCol]  = 0m; }&#xA;    else if (drcr == &quot;CR&quot;) { newRow[debitCol]  = billing; newRow[creditCol] = 0m; }&#xA;    else { newRow[creditCol] = 0m; newRow[debitCol]  = 0m; }&#xA;&#xA;    newRow[&quot;Source&quot;]               = &quot;CMS&quot;;&#xA;    newRow[&quot;Type&quot;]                 = &quot;new&quot;;&#xA;    newRow[&quot;Root Cause&quot;]           = &quot;&quot;;&#xA;    newRow[&quot;Root Cause Category&quot;]  = &quot;&quot;;&#xA;    newRow[&quot;Recommended Action&quot;]   = &quot;&quot;;&#xA;    newRow[&quot;Action Owner&quot;]         = &quot;&quot;;&#xA;&#xA;    newRow[&quot;Aging&quot;]             = &quot;=$H$6-G&quot; + reportRowNumber;&#xA;    newRow[&quot;Aging Group&quot;]       = &quot;=IF(L&quot; + reportRowNumber + &quot;&lt;4,\&quot;0-3 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;31,\&quot;4-30 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;61,\&quot;31-60 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;=90,\&quot;61-90 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;    newRow[&quot;BOT Classification&quot;] = &quot;=IF(J&quot; + reportRowNumber + &quot;&gt;0,IF(L&quot; + reportRowNumber + &quot;&lt;30,\&quot;Normal\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;60,\&quot;Especially Mentioned\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;90,\&quot;Substandard\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;=180,\&quot;Doubtful\&quot;,IF(L&quot; + reportRowNumber + &quot;&gt;180,\&quot;Loss\&quot;,\&quot;0\&quot;))))),\&quot;Not Applicable\&quot;)&quot;;&#xA;&#xA;    dtHistoricalReconTransactionsReport.Rows.Add(newRow);&#xA;    cmsAdded++;&#xA;}&#xA;&#xA;// ---------------------------&#xA;// Commit &amp; diagnostics&#xA;// ---------------------------&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;&#xA;int afterCount = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;Console.WriteLine(&quot;[HIST] Marked existing rows: &quot; + histBefore);&#xA;Console.WriteLine(&quot;[Merge] GL rows in: &quot; + dtGlStatement.Rows.Count + &quot;, CMS rows in: &quot; + dtTransactionReport.Rows.Count);&#xA;Console.WriteLine(&quot;[Merge] GL enriched from Postilion: &quot; + glEnriched);&#xA;Console.WriteLine(&quot;[Merge] Added GL: &quot; + glAdded + &quot;, Added CMS: &quot; + cmsAdded);&#xA;Console.WriteLine(&quot;[Merge] HRecon before: &quot; + beforeCount + &quot;, after: &quot; + afterCount + &quot;, delta: &quot; + (afterCount - beforeCount));&#xA;" DisplayName="Merge 15/10  preserves GL exactly “as is." sap:VirtualizedContainerService.HintSize="382,48" sap2010:WorkflowViewState.IdRef="InvokeCode_64" Language="CSharp">

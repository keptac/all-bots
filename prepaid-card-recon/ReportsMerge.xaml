        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== HIST sign normalization (UiPath C# Invoke Code) ====&#xA;// Args (In):     string reconCurrency&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport&#xA;&#xA;&#xA;// ---------- hard guards ----------&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;{&#xA;    Console.WriteLine(&quot;[HIST-FIX] Skipped: dtHistoricalReconTransactionsReport is null.&quot;);&#xA;    return;&#xA;}&#xA;if (string.IsNullOrWhiteSpace(reconCurrency))&#xA;{&#xA;    Console.WriteLine(&quot;[HIST-FIX] Skipped: reconCurrency is null/empty.&quot;);&#xA;    return;&#xA;}&#xA;&#xA;// ---------- column names (do NOT rename) ----------&#xA;string debitCol  = &quot;Debit (&quot; + reconCurrency + &quot;)&quot;;&#xA;string creditCol = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xA;&#xA;// ---------- column existence check ----------&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(debitCol) ||&#xA;    !dtHistoricalReconTransactionsReport.Columns.Contains(creditCol))&#xA;{&#xA;    Console.WriteLine($&quot;[HIST-FIX] Skipped: missing '{debitCol}' or '{creditCol}'.&quot;);&#xA;    return;&#xA;}&#xA;&#xA;// ---------- local helpers ----------&#xA;decimal ParseCellToSignedDecimal(object cell)&#xA;{&#xA;    // Accept null/DBNULL/numeric/string; capture (), -, commas, dots, digits&#xA;    if (cell == null || cell == DBNull.Value) return 0m;&#xA;&#xA;    string raw = cell.ToString();&#xA;    if (raw == null) return 0m; // defensive&#xA;&#xA;    // Normalize common oddities&#xA;    raw = raw.Trim()&#xA;             .Replace('–','-')          // en dash&#xA;             .Replace('—','-')          // em dash&#xA;             .Replace(&quot;\u00A0&quot;, &quot; &quot;);   // NBSP -&gt; space&#xA;&#xA;    bool hadParens = raw.StartsWith(&quot;(&quot;) &amp;&amp; raw.EndsWith(&quot;)&quot;);&#xA;&#xA;    // Keep only number-related chars&#xA;    var sb = new StringBuilder(raw.Length);&#xA;    for (int i = 0; i &lt; raw.Length; i++)&#xA;    {&#xA;        char ch = raw[i];&#xA;        if ((ch &gt;= '0' &amp;&amp; ch &lt;= '9') || ch == '.' || ch == ',' || ch == '-' || ch == '(' || ch == ')')&#xA;            sb.Append(ch);&#xA;    }&#xA;&#xA;    string cleaned = sb.ToString();&#xA;    if (hadParens) cleaned = cleaned.Trim('(', ')'); // remove () before parsing&#xA;    cleaned = cleaned.Replace(&quot;,&quot;, &quot;&quot;);&#xA;&#xA;    decimal val = 0m;&#xA;    decimal.TryParse(&#xA;        cleaned,&#xA;        NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint,&#xA;        CultureInfo.InvariantCulture,&#xA;        out val&#xA;    );&#xA;&#xA;    // If we had accounting parentheses, force negative of absolute (raw meaning)&#xA;    if (hadParens) val = -Math.Abs(val);&#xA;&#xA;    return val;&#xA;}&#xA;&#xA;decimal Snap(decimal v) =&gt; Math.Abs(v) &lt; 0.0005m ? 0m : v;&#xA;&#xA;// ---------- main loop ----------&#xA;int movedToCredit = 0, movedToDebit = 0, absFixedOneSide = 0, bothNonZeroWarn = 0, rowErrors = 0;&#xA;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var row = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    if (row == null) { rowErrors++; continue; }&#xA;&#xA;    try&#xA;    {&#xA;        // Parse raw values to signed decimals&#xA;        decimal d = ParseCellToSignedDecimal(row[debitCol]);&#xA;        decimal c = ParseCellToSignedDecimal(row[creditCol]);&#xA;&#xA;        // Snap tiny artifacts like -0.00 / (0.00)&#xA;        d = Snap(d);&#xA;        c = Snap(c);&#xA;&#xA;        // A) Debit negative &amp; Credit zero  -&gt; move abs(Debit) to Credit&#xA;        if (d &lt; 0m &amp;&amp; c == 0m)&#xA;        {&#xA;            row[debitCol]  = (object)0m;&#xA;            row[creditCol] = (object)Math.Abs(d);&#xA;            movedToCredit++;&#xA;            continue;&#xA;        }&#xA;&#xA;        // B) Credit negative &amp; Debit zero -&gt; move abs(Credit) to Debit&#xA;        if (c &lt; 0m &amp;&amp; d == 0m)&#xA;        {&#xA;            row[creditCol] = (object)0m;&#xA;            row[debitCol]  = (object)Math.Abs(c);&#xA;            movedToDebit++;&#xA;            continue;&#xA;        }&#xA;&#xA;        // C) If exactly one side has value, force absolute on that side (keep the other as zero)&#xA;        bool debitHas = d != 0m;&#xA;        bool creditHas = c != 0m;&#xA;&#xA;        if (debitHas ^ creditHas) // exactly one side&#xA;        {&#xA;            decimal newD = debitHas ? Math.Abs(d) : 0m;&#xA;            decimal newC = creditHas ? Math.Abs(c) : 0m;&#xA;&#xA;            // Only set if changed (to avoid unnecessary boxing)&#xA;            if (newD != d || newC != c)&#xA;            {&#xA;                row[debitCol]  = (object)newD;&#xA;                row[creditCol] = (object)newC;&#xA;                absFixedOneSide++;&#xA;            }&#xA;        }&#xA;        else if (debitHas &amp;&amp; creditHas)&#xA;        {&#xA;            // Both sides non-zero after parse -&gt; leave as-is but warn&#xA;            bothNonZeroWarn++;&#xA;            // Optionally: you can choose to zero the smaller side if you know business rule,&#xA;            // but by default we keep the data and let later steps handle/report.&#xA;        }&#xA;        else&#xA;        {&#xA;            // both zero -&gt; nothing to do&#xA;        }&#xA;    }&#xA;    catch (Exception ex)&#xA;    {&#xA;        rowErrors++;&#xA;        Console.WriteLine($&quot;[HIST-FIX] Row {i + 1}: {ex.GetType().Name} -&gt; {ex.Message}&quot;);&#xA;    }&#xA;}&#xA;&#xA;Console.WriteLine($&quot;✅ [HIST-FIX] moved-&gt;Credit: {movedToCredit}, moved-&gt;Debit: {movedToDebit}, abs-fixed(one-side): {absFixedOneSide}, both-nonzero-warn: {bothNonZeroWarn}, row-errors: {rowErrors}&quot;);&#xA;" DisplayName="negative Credit == Debit" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_70" Language="CSharp">

A;    newRow[&quot;Transaction Amount&quot;]   = SafeStr(row[&quot;Transaction Amount&quot;]);&#xA;    newRow[&quot;Settlement Currency&quot;]  = SafeStr(row[&quot;Settlement Currency&quot;]);&#xA;    newRow[&quot;Settlement Amount&quot;]    = SafeStr(row[&quot;Settlement Amount&quot;]);&#xA;    newRow[&quot;FOREIGN_CURRENCY&quot;]     = false;&#xA;&#xA;    // ---- GL AMOUNTS: KEEP AS-IS (NO ABS, NO REBALANCING) ----&#xA;    decimal debRaw = SafeParseAmount(row.Table.Columns.Contains(debitCol)  ? row[debitCol]  : null);&#xA;    decimal crRaw  = SafeParseAmount(row.Table.Columns.Contains(creditCol) ? row[creditCol] : null);&#xA;&#xA;    newRow[debitCol]  = debRaw;&#xA;    newRow[creditCol] = crRaw;&#xA;    // ---------------------------------------------------------&#xA;&#xA;    newRow[&quot;Source&quot;]               = &quot;GL&quot;;&#xA;    newRow[&quot;Type&quot;]                 = &quot;new&quot;;&#xA;    newRow[&quot;Root Cause&quot;]           = &quot;&quot;;&#xA;    newRow[&quot;Root Cause Category&quot;]  = &quot;&quot;;&#xA;    newRow[&quot;Recommended Action&quot;]   = &quot;&quot;;&#xA;    newRow[&quot;Action Owner&quot;]         = &quot;&quot;;&#xA;&#xA;    newRow[&quot;Aging&quot;]             = &quot;=$H$6-G&quot; + reportRowNumber;&#xA;    newRow[&quot;Aging Group&quot;]       = &quot;=IF(L&quot; + reportRowNumber + &quot;&lt;4,\&quot;0-3 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;31,\&quot;4-30 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;61,\&quot;31-60 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;=90,\&quot;61-90 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;    newRow[&quot;BOT Classification&quot;] = &quot;=IF(J&quot; + reportRowNumber + &quot;&gt;0,IF(L&quot; + reportRowNumber + &quot;&lt;30,\&quot;Normal\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;60,\&quot;Especially Mentioned\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;90,\&quot;Substandard\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;=180,\&quot;Doubtful\&quot;,IF(L&quot; + reportRowNumber + &quot;&gt;180,\&quot;Loss\&quot;,\&quot;0\&quot;))))),\&quot;Not Applicable\&quot;)&quot;;&#xA;&#xA;    dtHistoricalReconTransactionsReport.Rows.Add(newRow);&#xA;    glAdded++;&#xA;}&#xA;&#xA;int cmsAdded = 0;&#xA;for (int i = 0; i &lt; dtTransactionReport.Rows.Count; i++)&#xA;{&#xA;    DataRow row = dtTransactionReport.Rows[i];&#xA;    DataRow newRow = dtHistoricalReconTransactionsReport.NewRow();&#xA;    newRow[&quot;SNO&quot;] = ++lastSNO;&#xA;    int reportRowNumber = lastSNO + reportOffset;&#xA;&#xA;    newRow[&quot;Branch code&quot;]    = &quot;101&quot;;&#xA;    newRow[&quot;GL_Code&quot;]        = &quot;202030015&quot;;&#xA;    newRow[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;&#xA;    // Use CMS Transaction Date for both booking/value&#xA;    object cmsDt = (row.Table.Columns.Contains(&quot;Transaction Date&quot;) &amp;&amp; row[&quot;Transaction Date&quot;] is DateTime) ? row[&quot;Transaction Date&quot;] : (object)DBNull.Value;&#xA;    newRow[&quot;Booking Date&quot;] = cmsDt;&#xA;    newRow[&quot;Value Date&quot;]   = cmsDt;&#xA;&#xA;    newRow[&quot;Transaction Ref No:&quot;] = SafeStr(row[&quot;Transaction Ref No:&quot;]);&#xA;    newRow[&quot;C_PAN&quot;]               = SafeStr(row[&quot;C_PAN&quot;]);&#xA;    newRow[&quot;RRN&quot;]                 = SafeStr(row[&quot;RRN&quot;]);&#xA;    newRow[&quot;STAN&quot;]                = SafeStr(row[&quot;STAN&quot;]);&#xA;    newRow[&quot;AUTH&quot;]                = SafeStr(row[&quot;AUTH&quot;]);&#xA;    newRow[&quot;Narration&quot;]           = SafeStr(row[&quot;Narration&quot;]);&#xA;    newRow[&quot;FLEXREF&quot;]             = SafeStr(row[&quot;FLEXREF&quot;]);&#xA;    newRow[&quot;Transaction Type&quot;]    = SafeStr(row[&quot;Transaction Type&quot;]);&#xA;    newRow[&quot;Billing Amount&quot;]      = SafeStr(row[&quot;Billing Amount&quot;]);&#xA;    newRow[&quot;Device Number&quot;]       = SafeStr(row[&quot;Device Number&quot;]);&#xA;    newRow[&quot;ARN&quot;]                 = SafeStr(row[&quot;ARN&quot;]);&#xA;    newRow[&quot;Channel&quot;]             = SafeStr(row[&quot;Channel&quot;]);&#xA;    newRow[&quot;Classification&quot;]      = &quot;&quot;;&#xA;&#xA;    // Carry currency/amount fields from CMS&#xA;    newRow[&quot;Billing Currency&quot;]     = SafeStr(row[&quot;Billing Currency&quot;]);&#xA;    newRow[&quot;Transaction Currency&quot;] = SafeStr(row[&quot;Transaction Currency&quot;]);&#xA;    newRow[&quot;Transaction Amount&quot;]   = SafeStr(row[&quot;Transaction Amount&quot;]);&#xA;    newRow[&quot;Settlement Currency&quot;]  = SafeStr(row[&quot;Settlement Currency&quot;]);&#xA;    newRow[&quot;Settlement Amount&quot;]    = SafeStr(row[&quot;Settlement Amount&quot;]);&#xA;    newRow[&quot;FOREIGN_CURRENCY&quot;]     = false;&#xA;&#xA;    // Map Billing Amount into dr/cr in recon currency using DR/CR column (vice versa, with abs)&#xA;    string drcr = row[&quot;DR/CR to Cardholder&quot;]?.ToString().Trim().ToUpper();&#xA;    decimal billing = Math.Abs(SafeParseAmount(row[&quot;Billing Amount&quot;]));&#xA;&#xA;    if (drcr == &quot;DR&quot;)&#xA;    {&#xA;        // DR goes into Credit&#xA;        newRow[creditCol] = billing;&#xA;        newRow[debitCol]  = 0m;&#xA;    }&#xA;    else if (drcr == &quot;CR&quot;)&#xA;    {&#xA;        // CR goes into Debit&#xA;        newRow[debitCol]  = billing;&#xA;        newRow[creditCol] = 0m;&#xA;    }&#xA;    else&#xA;    {&#xA;        newRow[creditCol] = 0m;&#xA;        newRow[debitCol]  = 0m;&#xA;    }&#xA;&#xA;    newRow[&quot;Source&quot;]               = &quot;CMS&quot;;&#xA;    newRow[&quot;Type&quot;]                 = &quot;new&quot;;&#xA;    newRow[&quot;Root Cause&quot;]           = &quot;&quot;;&#xA;    newRow[&quot;Root Cause Category&quot;]  = &quot;&quot;;&#xA;    newRow[&quot;Recommended Action&quot;]   = &quot;&quot;;&#xA;    newRow[&quot;Action Owner&quot;]         = &quot;&quot;;&#xA;&#xA;    newRow[&quot;Aging&quot;]             = &quot;=$H$6-G&quot; + reportRowNumber;&#xA;    newRow[&quot;Aging Group&quot;]       = &quot;=IF(L&quot; + reportRowNumber + &quot;&lt;4,\&quot;0-3 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;31,\&quot;4-30 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;61,\&quot;31-60 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;=90,\&quot;61-90 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;    newRow[&quot;BOT Classification&quot;] = &quot;=IF(J&quot; + reportRowNumber + &quot;&gt;0,IF(L&quot; + reportRowNumber + &quot;&lt;30,\&quot;Normal\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;60,\&quot;Especially Mentioned\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;90,\&quot;Substandard\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;=180,\&quot;Doubtful\&quot;,IF(L&quot; + reportRowNumber + &quot;&gt;180,\&quot;Loss\&quot;,\&quot;0\&quot;))))),\&quot;Not Applicable\&quot;)&quot;;&#xA;&#xA;    dtHistoricalReconTransactionsReport.Rows.Add(newRow);&#xA;    cmsAdded++;&#xA;}&#xA;&#xA;// ===== Audit B: Merge accounting (before AcceptChanges) =====&#xA;int expectedAdded = dtGlStatement.Rows.Count + dtTransactionReport.Rows.Count;&#xA;int actualAdded = dtHistoricalReconTransactionsReport.Rows.Count - beforeCount;&#xA;&#xA;Console.WriteLine(&quot;[AUDIT B] EXPECTED added (GL + CMS): &quot; + expectedAdded);&#xA;Console.WriteLine(&quot;[AUDIT B] ACTUAL added to HIST: &quot; + actualAdded);&#xA;if (actualAdded != expectedAdded)&#xA;{&#xA;    Console.WriteLine(&quot;[AUDIT B][WARN] Actual added != Expected. Investigate merge loops or earlier errors.&quot;);&#xA;}&#xA;&#xA;// Sanity: sample a few tail rows&#xA;int tail = Math.Min(5, dtHistoricalReconTransactionsReport.Rows.Count);&#xA;string dcol = &quot;Debit (&quot; + reconCurrency + &quot;)&quot;;&#xA;string ccol = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xA;for (int k = dtHistoricalReconTransactionsReport.Rows.Count - tail; k &lt; dtHistoricalReconTransactionsReport.Rows.Count; k++)&#xA;{&#xA;    if (k &lt; 0) break;&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[k];&#xA;    Console.WriteLine(&quot;[AUDIT B] HIST tail SNO=&quot; + SafeStr(r[&quot;SNO&quot;]) +&#xA;                      &quot; Source=&quot; + SafeStr(r[&quot;Source&quot;]) +&#xA;                      &quot; TrxRef=&quot; + SafeStr(r[&quot;Transaction Ref No:&quot;]) +&#xA;                      &quot; RRN=&quot; + SafeStr(r[&quot;RRN&quot;]) +&#xA;                      &quot; Debit=&quot; + (dtHistoricalReconTransactionsReport.Columns.Contains(dcol) ? SafeStr(r[dcol]) : &quot;&quot;) +&#xA;                      &quot; Credit=&quot; + (dtHistoricalReconTransactionsReport.Columns.Contains(ccol) ? SafeStr(r[ccol]) : &quot;&quot;));&#xA;}&#xA;&#xA;// ---------------------------&#xA;// Commit &amp; diagnostics&#xA;// ---------------------------&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;&#xA;int afterCount = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;Console.WriteLine(&quot;[HIST] Marked existing rows: &quot; + histBefore);&#xA;Console.WriteLine(&quot;[Merge] GL rows in: &quot; + dtGlStatement.Rows.Count + &quot;, CMS rows in: &quot; + dtTransactionReport.Rows.Count);&#xA;Console.WriteLine(&quot;[Merge] GL enriched from Postilion: &quot; + glEnriched);&#xA;Console.WriteLine(&quot;[Merge] HIST enriched from Postilion: &quot; + histEnrichedFromPost);&#xA;Console.WriteLine(&quot;[Merge] Added GL: &quot; + glAdded + &quot;, Added CMS: &quot; + cmsAdded);&#xA;Console.WriteLine(&quot;[Merge] HRecon before: &quot; + beforeCount + &quot;, after: &quot; + afterCount + &quot;, delta: &quot; + (afterCount - beforeCount));&#xA;&#xA;// ====================================================================&#xA;// ADD ROOT_CAUSE_PROCESSED COLUMN IF MISSING&#xA;// ====================================================================&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;ROOT_CAUSE_PROCESSED&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;ROOT_CAUSE_PROCESSED&quot;, typeof(string));&#xA;&#xA;Console.WriteLine(&quot;=== Setting ROOT_CAUSE_PROCESSED Column Values ===&quot;);&#xA;&#xA;foreach (DataRow r in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string src = SafeStr(r[&quot;Source&quot;]).ToUpper();&#xA;&#xA;    // HIST rows → always TRUE&#xA;    if (src == &quot;HIST&quot;)&#xA;    {&#xA;        r[&quot;ROOT_CAUSE_PROCESSED&quot;] = &quot;TRUE&quot;;&#xA;        continue;&#xA;    }&#xA;&#xA;    // CMS rows → always FALSE&#xA;    if (src == &quot;CMS&quot;)&#xA;    {&#xA;        r[&quot;ROOT_CAUSE_PROCESSED&quot;] = &quot;FALSE&quot;;&#xA;        continue;&#xA;    }&#xA;&#xA;    // GL rows → preserve TRUE, else FALSE&#xA;    if (src == &quot;GL&quot;)&#xA;    {&#xA;        string cur = SafeStr(r[&quot;ROOT_CAUSE_PROCESSED&quot;]).ToUpper();&#xA;&#xA;        if (cur == &quot;TRUE&quot;)&#xA;        {&#xA;            // keep TRUE&#xA;            r[&quot;ROOT_CAUSE_PROCESSED&quot;] = &quot;TRUE&quot;;&#xA;        }&#xA;        else&#xA;        {&#xA;            // if NULL or EMPTY or anything else → FALSE&#xA;            r[&quot;ROOT_CAUSE_PROCESSED&quot;] = &quot;FALSE&quot;;&#xA;        }&#xA;&#xA;        continue;&#xA;    }&#xA;&#xA;    // Any other unknown source → set to FALSE&#xA;    r[&quot;ROOT_CAUSE_PROCESSED&quot;] = &quot;FALSE&quot;;&#xA;}&#xA;&#xA;// Optional: mark column finalized&#xA;Console.WriteLine(&quot;=== ROOT_CAUSE_PROCESSED Column Updated for All Rows ===&quot;);&#xA;" DisplayName="Merge 22/10  preserves GL exactly “as is." sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_94" Language="CSharp">

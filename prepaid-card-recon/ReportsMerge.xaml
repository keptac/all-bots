              <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== HIST sign normalization (UiPath C# Invoke Code) ====&#xA;// Args (In):     string reconCurrency&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport&#xA;&#xA;int movedToCredit = 0, movedToDebit = 0, absFixed = 0;&#xA;&#xA;// Build column names once&#xA;string debitCol  = &quot;Debit (&quot; + reconCurrency + &quot;)&quot;;&#xA;string creditCol = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xA;&#xA;// Defensive: skip if columns missing&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(debitCol) ||&#xA;    !dtHistoricalReconTransactionsReport.Columns.Contains(creditCol))&#xA;{&#xA;    Console.WriteLine($&quot;[HIST-FIX] Skipped: missing '{debitCol}' or '{creditCol}'&quot;);&#xA;}&#xA;else&#xA;{&#xA;    for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;    {&#xA;        var row = dtHistoricalReconTransactionsReport.Rows[i];&#xA;&#xA;        // ---- Hardened parse for Debit ----&#xA;        string dRaw = (row[debitCol] == DBNull.Value ? &quot;&quot; : row[debitCol].ToString().Trim());&#xA;        bool dParen = dRaw.StartsWith(&quot;(&quot;) &amp;&amp; dRaw.EndsWith(&quot;)&quot;);&#xA;        // keep digits, dot, comma, minus, parentheses&#xA;        System.Text.StringBuilder dSb = new System.Text.StringBuilder(dRaw.Length);&#xA;        for (int k = 0; k &lt; dRaw.Length; k++)&#xA;        {&#xA;            char ch = dRaw[k];&#xA;            if ((ch &gt;= '0' &amp;&amp; ch &lt;= '9') || ch == '.' || ch == ',' || ch == '-' || ch == '(' || ch == ')')&#xA;                dSb.Append(ch);&#xA;        }&#xA;        dRaw = dSb.ToString();&#xA;        if (dParen) dRaw = dRaw.Trim('(', ')');&#xA;        dRaw = dRaw.Replace(&quot;,&quot;, &quot;&quot;);&#xA;        decimal d = 0m;&#xA;        decimal.TryParse(dRaw,&#xA;            System.Globalization.NumberStyles.AllowLeadingSign | System.Globalization.NumberStyles.AllowDecimalPoint,&#xA;            System.Globalization.CultureInfo.InvariantCulture, out d);&#xA;        if (dParen) d = -System.Math.Abs(d);&#xA;&#xA;        // ---- Hardened parse for Credit ----&#xA;        string cRaw = (row[creditCol] == DBNull.Value ? &quot;&quot; : row[creditCol].ToString().Trim());&#xA;        bool cParen = cRaw.StartsWith(&quot;(&quot;) &amp;&amp; cRaw.EndsWith(&quot;)&quot;);&#xA;        System.Text.StringBuilder cSb = new System.Text.StringBuilder(cRaw.Length);&#xA;        for (int k = 0; k &lt; cRaw.Length; k++)&#xA;        {&#xA;            char ch = cRaw[k];&#xA;            if ((ch &gt;= '0' &amp;&amp; ch &lt;= '9') || ch == '.' || ch == ',' || ch == '-' || ch == '(' || ch == ')')&#xA;                cSb.Append(ch);&#xA;        }&#xA;        cRaw = cSb.ToString();&#xA;        if (cParen) cRaw = cRaw.Trim('(', ')');&#xA;        cRaw = cRaw.Replace(&quot;,&quot;, &quot;&quot;);&#xA;        decimal c = 0m;&#xA;        decimal.TryParse(cRaw,&#xA;            System.Globalization.NumberStyles.AllowLeadingSign | System.Globalization.NumberStyles.AllowDecimalPoint,&#xA;            System.Globalization.CultureInfo.InvariantCulture, out c);&#xA;        if (cParen) c = -System.Math.Abs(c);&#xA;&#xA;        // ---- Normalization rules ----&#xA;        // A) Debit negative &amp; Credit zero  -&gt; move abs(Debit) to Credit&#xA;        if (d &lt; 0m &amp;&amp; c == 0m)&#xA;        {&#xA;            row[debitCol]  = 0m;&#xA;            row[creditCol] = System.Math.Abs(d);&#xA;            movedToCredit++;&#xA;            continue;&#xA;        }&#xA;&#xA;        // B) Credit negative &amp; Debit zero -&gt; move abs(Credit) to Debit&#xA;        if (c &lt; 0m &amp;&amp; d == 0m)&#xA;        {&#xA;            row[creditCol] = 0m;&#xA;            row[debitCol]  = System.Math.Abs(c);&#xA;            movedToDebit++;&#xA;            continue;&#xA;        }&#xA;&#xA;        // C) Safety: force abs magnitudes on both sides&#xA;        decimal newD = System.Math.Abs(d);&#xA;        decimal newC = System.Math.Abs(c);&#xA;        if (newD != d || newC != c)&#xA;        {&#xA;            row[debitCol]  = newD;&#xA;            row[creditCol] = newC;&#xA;            absFixed++;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;Console.WriteLine($&quot;✅ [HIST-FIX] moved-&gt;Credit: {movedToCredit}, moved-&gt;Debit: {movedToDebit}, abs-fixed: {absFixed}&quot;);&#xA;" DisplayName="negative Credit == Debit dtHistoricalReconTransactionsReport" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_54" Language="CSharp">

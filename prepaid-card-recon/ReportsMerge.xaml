            <ui:InvokeCode ContinueOnError="{x:Null}" Code="/*&#xA;-----------------------------------------------&#xA;STEP 6: Adjust Billing Amount for Foreign Wallet Transfers&#xA;-----------------------------------------------&#xA;This code processes rows in dtTransactionReport by:&#xA;✅ Finding rows where:&#xA;   - Transaction Type == &quot;Intra Client - Wallet to Wallet Transfer(Debit)&quot;&#xA;   - Billing Currency ≠ reconCurrency&#xA;✅ Then updating:&#xA;   - Billing Amount = Transaction Amount * 1&#xA;   - Formatted to 2 decimal places&#xA;✅ Finally:&#xA;   - Commits changes using dtTransactionReport.AcceptChanges()&#xA;-----------------------------------------------&#xA;*/&#xA;&#xA;// ✅ Helper function to normalize text (trim, lowercase, collapse spaces)&#xA;string Normalize(string input)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(input)) return string.Empty;&#xA;    return System.Text.RegularExpressions.Regex.Replace(input.Trim(), @&quot;\s+&quot;, &quot; &quot;).ToLowerInvariant();&#xA;}&#xA;&#xA;// ✅ Normalize reconCurrency once&#xA;string reconCurrencyNormalized = Normalize(reconCurrency);&#xA;&#xA;// ✅ Identify the correct column names (case/space insensitive match)&#xA;string billingCurrencyCol = null;&#xA;string transactionTypeCol = null;&#xA;string billingAmountCol = null;&#xA;string transactionAmountCol = null;&#xA;&#xA;foreach (System.Data.DataColumn col in dtTransactionReport.Columns)&#xA;{&#xA;    var name = Normalize(col.ColumnName);&#xA;    if (name == &quot;billing currency&quot;) billingCurrencyCol = col.ColumnName;&#xA;    else if (name == &quot;transaction type&quot;) transactionTypeCol = col.ColumnName;&#xA;    else if (name == &quot;billing amount&quot;) billingAmountCol = col.ColumnName;&#xA;    else if (name == &quot;transaction amount&quot;) transactionAmountCol = col.ColumnName;&#xA;}&#xA;&#xA;// ❌ Stop execution if any required column is missing&#xA;if (billingCurrencyCol == null || transactionTypeCol == null || billingAmountCol == null || transactionAmountCol == null)&#xA;{&#xA;    throw new System.Exception(&quot;❌ Required columns not found.&quot;);&#xA;}&#xA;&#xA;// ✅ Process and update matching rows&#xA;int updatedCount = 0;&#xA;&#xA;foreach (System.Data.DataRow row in dtTransactionReport.Rows)&#xA;{&#xA;    // Read and normalize relevant fields&#xA;    string transactionType = row[transactionTypeCol]?.ToString()?.Trim();&#xA;    string billingCurrency = Normalize(row[billingCurrencyCol]?.ToString());&#xA;&#xA;    // ✅ Check if row meets the specified condition&#xA;    if (transactionType == &quot;Intra Client - Wallet to Wallet Transfer(Debit)&quot; &amp;&amp;&#xA;        billingCurrency != reconCurrencyNormalized)&#xA;    {&#xA;        if (decimal.TryParse(row[transactionAmountCol]?.ToString(), out decimal transactionAmount))&#xA;        {&#xA;            // ✅ Set Billing Amount = 1 * Transaction Amount, formatted to 2 decimal places&#xA;            decimal updatedBillingAmount = 1 * transactionAmount;&#xA;            row[billingAmountCol] = updatedBillingAmount.ToString(&quot;F2&quot;);&#xA;            updatedCount++;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// ✅ Commit all changes to the DataTable&#xA;dtTransactionReport.AcceptChanges();&#xA;&#xA;System.Console.WriteLine($&quot;STEP 6 ✅ Total rows updated where Billing Currency != {reconCurrency} for wallet transfers: {updatedCount}&quot;);&#xA;" DisplayName="STEP 6) Intra Client - Wallet to Wallet Transfer(Debit)" sap:VirtualizedContainerService.HintSize="477.3333333333333,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_25" Language="CSharp">

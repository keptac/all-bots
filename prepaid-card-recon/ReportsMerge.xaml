.Globalization.DateTimeStyles.None, out dt3)) return dt3.Date;&#xA;    return null;&#xA;}&#xA;&#xA;void ConvertColumnToUsDateOnly(System.Data.DataTable dt, string colName, out int blanks)&#xA;{&#xA;    blanks = 0;&#xA;    if (dt == null || !dt.Columns.Contains(colName)) return;&#xA;&#xA;    string rawCol = colName + &quot;_RAW&quot;;&#xA;    if (!dt.Columns.Contains(rawCol)) dt.Columns.Add(rawCol, typeof(string));&#xA;&#xA;    bool alreadyDT = dt.Columns[colName].DataType == typeof(System.DateTime);&#xA;&#xA;    string tmp = colName + &quot;_DATE_ONLY&quot;;&#xA;    if (dt.Columns.Contains(tmp)) dt.Columns.Remove(tmp);&#xA;    var nc = dt.Columns.Add(tmp, typeof(System.DateTime));&#xA;&#xA;    foreach (System.Data.DataRow r in dt.Rows)&#xA;    {&#xA;        string raw = r[colName] == System.DBNull.Value ? &quot;&quot; : r[colName].ToString().Trim();&#xA;        r[rawCol] = raw;&#xA;&#xA;        System.DateTime? parsed = alreadyDT&#xA;            ? (r[colName] == System.DBNull.Value ? (System.DateTime?)null : ((System.DateTime)r[colName]).Date)&#xA;            : ParseUsDateOnly(r[colName]);&#xA;&#xA;        if (parsed.HasValue) r[tmp] = parsed.Value; else { r[tmp] = System.DBNull.Value; blanks++; }&#xA;    }&#xA;&#xA;    int ord = dt.Columns[colName].Ordinal;&#xA;    dt.Columns.Remove(colName);&#xA;    nc.ColumnName = colName;&#xA;    dt.Columns[colName].SetOrdinal(ord);&#xA;}&#xA;&#xA;// --------------------------- Validate &amp; normalize ---------------------------&#xA;if (dtHistoricalReconTransactionsReport == null || dtHistoricalReconTransactionsReport.Rows.Count == 0)&#xA;    throw new System.Exception(&quot;DataTable 'dtHistoricalReconTransactionsReport' is null or empty.&quot;);&#xA;&#xA;int blanksBooking, blanksValue;&#xA;ConvertColumnToUsDateOnly(dtHistoricalReconTransactionsReport, &quot;Booking Date&quot;, out blanksBooking);&#xA;ConvertColumnToUsDateOnly(dtHistoricalReconTransactionsReport, &quot;Value Date&quot;,   out blanksValue);&#xA;System.Console.WriteLine($&quot;[DATES] Booking blanks={blanksBooking}, Value blanks={blanksValue} (MM/dd policy).&quot;);&#xA;&#xA;for (int iRow = 0; iRow &lt; dtHistoricalReconTransactionsReport.Rows.Count; iRow++)&#xA;{&#xA;    var row = dtHistoricalReconTransactionsReport.Rows[iRow];&#xA;    row[&quot;Branch code&quot;]    = &quot;101&quot;;&#xA;    row[&quot;GL_Code&quot;]        = &quot;202030015&quot;;&#xA;    row[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;}&#xA;&#xA;if (!System.IO.File.Exists(prepaidCardFileName))&#xA;    throw new System.IO.FileNotFoundException(&quot;File not found: &quot; + prepaidCardFileName);&#xA;&#xA;const int EXCEL_MAX_ROWS = 1048576;&#xA;int startingRow = 18;&#xA;int totalRows   = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;int maxWritable = System.Math.Max(0, EXCEL_MAX_ROWS - startingRow + 1);&#xA;if (totalRows &gt; maxWritable)&#xA;{&#xA;    System.Console.WriteLine($&quot;[WARN] Truncating write from {totalRows:N0} to {maxWritable:N0} rows (Excel row limit).&quot;);&#xA;    totalRows = maxWritable;&#xA;}&#xA;bool hasRows = totalRows &gt; 0;&#xA;int lastRow = hasRows ? (startingRow + totalRows - 1) : startingRow;&#xA;&#xA;string debitColName  = &quot;Debit (&quot;  + reconCurrency + &quot;)&quot;;&#xA;string creditColName = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(debitColName))  throw new System.Exception(&quot;Column not found: &quot; + debitColName);&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(creditColName)) throw new System.Exception(&quot;Column not found: &quot; + creditColName);&#xA;&#xA;System.Console.WriteLine($&quot;[BEGIN] Writing {totalRows:N0} rows to '{prepaidCardFileName}' starting at row {startingRow} ...&quot;);&#xA;&#xA;var sw = System.Diagnostics.Stopwatch.StartNew();&#xA;&#xA;try&#xA;{&#xA;    // Open workbook with ClosedXML&#xA;    using (var wb = new ClosedXML.Excel.XLWorkbook(prepaidCardFileName))&#xA;    {&#xA;        var ws = wb.Worksheet(&quot;Recon Report&quot;);&#xA;        if (ws == null) throw new System.Exception(&quot;Worksheet 'Recon Report' not found.&quot;);&#xA;&#xA;        // ===== Global font setup: Tahoma 8 across the worksheet =====&#xA;        ws.Style.Font.SetFontName(&quot;Tahoma&quot;);&#xA;        ws.Style.Font.SetFontSize(8);&#xA;&#xA;        // H6 recon date&#xA;        var reconDt = ParseReconDateUs(reconDate);&#xA;        ws.Cell(&quot;H6&quot;).Value = reconDt;&#xA;        ws.Cell(&quot;H6&quot;).Style.DateFormat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;&#xA;        // Clear previous B..R block&#xA;        int sheetLast = ws.LastRowUsed() != null ? ws.LastRowUsed().RowNumber() : 0;&#xA;        if (sheetLast &gt;= startingRow)&#xA;        {&#xA;            int clearEnd = System.Math.Min(sheetLast, EXCEL_MAX_ROWS);&#xA;            ws.Range(startingRow, 2, clearEnd, 18).Clear(ClosedXML.Excel.XLClearOptions.Contents);&#xA;        }&#xA;&#xA;        if (hasRows)&#xA;        {&#xA;            int batchSize = 10000;&#xA;            int written = 0;&#xA;            int batchNo = 0;&#xA;            int curRow  = startingRow;&#xA;&#xA;            bool hasTxnRef = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Transaction Ref No:&quot;);&#xA;            bool hasNarr   = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Narration&quot;);&#xA;            bool hasRC     = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Root Cause&quot;);&#xA;            bool hasRCC    = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Root Cause Category&quot;);&#xA;            bool hasRA     = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Recommended Action&quot;);&#xA;            bool hasAO     = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Action Owner&quot;);&#xA;            bool hasBDraw  = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Booking Date_RAW&quot;);&#xA;            bool hasVdraw  = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Value Date_RAW&quot;);&#xA;&#xA;            while (written &lt; totalRows)&#xA;            {&#xA;                batchNo++;&#xA;                int take = System.Math.Min(batchSize, totalRows - written);&#xA;&#xA;                // Build rows as IEnumerable&lt;object[]&gt;&#xA;                var rows = new System.Collections.Generic.List&lt;object[]&gt;(take);&#xA;&#xA;                for (int i = 0; i &lt; take; i++)&#xA;                {&#xA;                    var dr = dtHistoricalReconTransactionsReport.Rows[written + i];&#xA;&#xA;                    object bDate = (dr[&quot;Booking Date&quot;] != System.DBNull.Value &amp;&amp; dr[&quot;Booking Date&quot;] is System.DateTime)&#xA;                                   ? (object)((System.DateTime)dr[&quot;Booking Date&quot;])&#xA;                                   : (hasBDraw ? dr[&quot;Booking Date_RAW&quot;] : null);&#xA;&#xA;                    object vDate = (dr[&quot;Value Date&quot;] != System.DBNull.Value &amp;&amp; dr[&quot;Value Date&quot;] is System.DateTime)&#xA;                                   ? (object)((System.DateTime)dr[&quot;Value Date&quot;])&#xA;                                   : (hasVdraw ? dr[&quot;Value Date_RAW&quot;] : null);&#xA;&#xA;                    var debit  = System.Math.Round(ParseAmountInvariant(dr[debitColName]), 2);&#xA;                    var credit = System.Math.Round(ParseAmountInvariant(dr[creditColName]), 2);&#xA;&#xA;                    var rowArr = new object[17];&#xA;                    int c = 0;&#xA;                    rowArr[c++] = written + i + 1;                              // B (SNO)&#xA;                    rowArr[c++] = dr[&quot;Branch code&quot;];                            // C&#xA;                    rowArr[c++] = dr[&quot;GL_Code&quot;];                                // D&#xA;                    rowArr[c++] = dr[&quot;GL Description&quot;];                         // E&#xA;                    rowArr[c++] = bDate;                                        // F&#xA;                    rowArr[c++] = vDate;                                        // G&#xA;                    rowArr[c++] = hasTxnRef ? dr[&quot;Transaction Ref No:&quot;] : null; // H&#xA;                    rowArr[c++] = hasNarr   ? dr[&quot;Narration&quot;] : null;           // I&#xA;                    rowArr[c++] = debit;                                        // J&#xA;                    rowArr[c++] = credit;                                       // K&#xA;                    rowArr[c++] = null;                                         // L (formula later)&#xA;                    rowArr[c++] = null;                                         // M (formula later)&#xA;                    rowArr[c++] = null;                                         // N (formula later)&#xA;                    rowArr[c++] = hasRC  ? dr[&quot;Root Cause&quot;] : null;             // O&#xA;                    rowArr[c++] = hasRCC ? dr[&quot;Root Cause Category&quot;] : null;    // P&#xA;                    rowArr[c++] = hasRA  ? dr[&quot;Recommended Action&quot;] : null;     // Q&#xA;                    rowArr[c++] = hasAO  ? dr[&quot;Action Owner&quot;] : null;           // R&#xA;&#xA;                    rows.Add(rowArr);&#xA;                }&#xA;&#xA;                // Dump this chunk (starting at B = col 2)&#xA;                ws.Cell(curRow, 2).InsertData(rows);&#xA;&#xA;                // Formats for dates/amounts&#xA;                ws.Range(curRow, 6, curRow + take - 1, 7).Style.DateFormat.Format = &quot;dd-MMM-yyyy&quot;; // F..G&#xA;                ws.Range(curRow,10, curRow + take - 1, 11).Style.NumberFormat.Format = &quot;#,##0.00&quot;; // J..K&#xA;&#xA;                // Formulas L/M/N — ensure no stale values, then set formulas explicitly&#xA;                for (int rr = curRow; rr &lt;= curRow + take - 1; rr++)&#xA;                {&#xA;                    ws.Cell(rr, 12).Clear(ClosedXML.Excel.XLClearOptions.Contents);&#xA;                    ws.Cell(rr, 13).Clear(ClosedXML.Excel.XLClearOptions.Contents);&#xA;                    ws.Cell(rr, 14).Clear(ClosedXML.Excel.XLClearOptions.Contents);&#xA;&#xA;                    ws.Cell(rr, 12).SetFormulaA1(&quot;$H$6 - G&quot; + rr);&#xA;                    ws.Cell(rr, 13).SetFormulaA1(&#xA;                        &quot;IF(L&quot; + rr + &quot;&lt;4,\&quot;0-3 Days\&quot;,IF(L&quot; + rr + &quot;&lt;31,\&quot;4-30 Days\&quot;,IF(L&quot; + rr + &quot;&lt;61,\&quot;31-60 Days\&quot;,IF(L&quot; + rr + &quot;&lt;=90,\&quot;61-90 Days\&quot;,\&quot;Above 90 Days\&quot;))))&quot;&#xA;                    );&#xA;                    ws.Cell(rr, 14).SetFormulaA1(&#xA;                        &quot;IF(J&quot; + rr + &quot;&gt;0,IF(L&quot; + rr + &quot;&lt;30,\&quot;Normal\&quot;,IF(L&quot; + rr + &quot;&lt;60,\&quot;Especially Mentioned\&quot;,IF(L&quot; + rr + &quot;&lt;90,\&quot;Substandard\&quot;,IF(L&quot; + rr + &quot;&lt;=180,\&quot;Doubtful\&quot;,\&quot;Loss\&quot;)))),\&quot;Not Applicable\&quot;)&quot;&#xA;                    );&#xA;                }&#xA;&#xA;                // Per-chunk logging&#xA;                int batchStartSno = written + 1;&#xA;                int batchEndSno   = written + take;&#xA;                System.Console.WriteLine($&quot;[BATCH {batchNo}] Wrote {take:N0} rows (SNO {batchStartSno:N0}..{batchEndSno:N0}) to Excel rows {curRow:N0}..{(curRow + take - 1):N0}. Cumulative: {(written + take):N0}/{totalRows:N0}&quot;);&#xA;&#xA;                written += take;&#xA;                curRow  += take;&#xA;            }&#xA;        }&#xA;        else&#xA;        {&#xA;            System.Console.WriteLine(&quot;[INFO] No rows to write; leaving block empty.&quot;);&#xA;        }&#xA;&#xA;        // Totals &amp; headers (use formulas where appropriate)&#xA;        ws.Cell(&quot;K9&quot;).Value  = glClosingBalance;&#xA;        ws.Cell(&quot;K10&quot;).Value = cmsBalance;&#xA;&#xA;        ws.Cell(&quot;K11&quot;).Clear(ClosedXML.Excel.XLClearOptions.Contents);&#xA;        ws.Cell(&quot;K11&quot;).SetFormulaA1(&quot;ROUND((K9-K10),2)&quot;);&#xA;&#xA;        string jRange = hasRows ? $&quot;J{startingRow}:J{lastRow}&quot; : &quot;J999:J999&quot;;&#xA;        string kRange = hasRows ? $&quot;K{startingRow}:K{lastRow}&quot; : &quot;K999:K999&quot;;&#xA;&#xA;        ws.Cell(&quot;J13&quot;).Clear(ClosedXML.Excel.XLClearOptions.Contents);&#xA;        ws.Cell(&quot;K13&quot;).Clear(ClosedXML.Excel.XLClearOptions.Contents);&#xA;        ws.Cell(&quot;J16&quot;).Clear(ClosedXML.Excel.XLClearOptions.Contents);&#xA;        ws.Cell(&quot;K16&quot;).Clear(ClosedXML.Excel.XLClearOptions.Contents);&#xA;        ws.Cell(&quot;K14&quot;).Clear(ClosedXML.Excel.XLClearOptions.Contents);&#xA;        ws.Cell(&quot;K15&quot;).Clear(ClosedXML.Excel.XLClearOptions.Contents);&#xA;&#xA;        ws.Cell(&quot;J13&quot;).SetFormulaA1($&quot;-SUM({jRange})&quot;);&#xA;        ws.Cell(&quot;K13&quot;).SetFormulaA1($&quot;SUM({kRange})&quot;);&#xA;        ws.Cell(&quot;J16&quot;).SetFormulaA1($&quot;SUM({jRange})&quot;);&#xA;        ws.Cell(&quot;K16&quot;).SetFormulaA1($&quot;SUM({kRange})&quot;);&#xA;        ws.Cell(&quot;K14&quot;).SetFormulaA1(&quot;ROUND((J13+K13),2)&quot;);&#xA;        ws.Cell(&quot;K15&quot;).SetFormulaA1(&quot;ROUND((K11-K14),2)&quot;);&#xA;&#xA;        ws.Range(&quot;K9:K11&quot;).Style.NumberFormat.Format = &quot;#,##0.00&quot;;&#xA;&#xA;        // Optional: maintain named range ReconData (ClosedXML-safe)&#xA;        try&#xA;        {&#xA;            var rng = hasRows&#xA;                ? ws.Range(startingRow, 2, lastRow, 18)&#xA;                : ws.Range(startingRow, 2, startingRow, 18);&#xA;&#xA;            var existing = wb.NamedRanges.NamedRange(&quot;ReconData&quot;);&#xA;            if (existing != null) existing.Delete();&#xA;            wb.NamedRanges.Add(&quot;ReconData&quot;, rng);&#xA;        }&#xA;        catch { /* ignore named range issues */ }&#xA;&#xA;        // ===== NEW: Font color black for everything from row 18 down =====&#xA;        {&#xA;            int endRow = ws.LastRowUsed() != null ? ws.LastRowUsed().RowNumber() : startingRow;&#xA;            int endCol = ws.LastColumnUsed() != null ? ws.LastColumnUsed().ColumnNumber() : 18;&#xA;            if (endRow &lt; startingRow) endRow = startingRow;&#xA;            if (endCol &lt; 1) endCol = 18;&#xA;            ws.Range(startingRow, 1, endRow, endCol).Style.Font.FontColor = ClosedXML.Excel.XLColor.Black;&#xA;        }&#xA;&#xA;        // ===== NEW: Bold everything above A16 (i.e., rows 1..16), keep rows &gt;=17 not bold =====&#xA;        {&#xA;            int endCol = ws.LastColumnUsed() != null ? ws.LastColumnUsed().ColumnNumber() : 18;&#xA;            if (endCol &lt; 1) endCol = 18;&#xA;&#xA;            ws.Range(1, 1, 16, endCol).Style.Font.SetBold(true);&#xA;&#xA;            int endRow = ws.LastRowUsed() != null ? ws.LastRowUsed().RowNumber() : startingRow;&#xA;            if (endRow &lt; 17) endRow = 17;&#xA;            ws.Range(17, 1, endRow, endCol).Style.Font.SetBold(false);&#xA;        }&#xA;&#xA;        // ===== Ensure formulas persist &amp; Excel recalculates on open =====&#xA;        // (These flags tell Excel to rebuild the calc chain; formulas are saved as formula strings above.)&#xA;        wb.CalculateMode = ClosedXML.Excel.XLCalculateMode.Auto;&#xA;        wb.ForceFullCalculation = true;&#xA;        wb.FullCalculationOnLoad = true;&#xA;&#xA;        // ===== Atomic save: temp → replace =====&#xA;        var dir  = System.IO.Path.GetDirectoryName(prepaidCardFileName);&#xA;        var name = System.IO.Path.GetFileNameWithoutExtension(prepaidCardFileName);&#xA;        var ext  = System.IO.Path.GetExtension(prepaidCardFileName);&#xA;        var tmp  = System.IO.Path.Combine(dir, name + &quot;.tmp_write&quot; + ext);&#xA;&#xA;        wb.SaveAs(tmp);&#xA;        System.IO.File.Copy(tmp, prepaidCardFileName, true);&#xA;        try { System.IO.File.Delete(tmp); } catch { }&#xA;    }&#xA;&#xA;    sw.Stop();&#xA;    System.Console.WriteLine($&quot;[DONE] Wrote {totalRows:N0} rows in {sw.Elapsed.TotalSeconds:F1}s (ClosedXML)&quot;);&#xA;    System.Console.WriteLine(&quot;       glClosingBalance (K9): &quot; + glClosingBalance.ToString(&quot;N2&quot;));&#xA;    System.Console.WriteLine(&quot;       cmsBalance      (K10): &quot; + cmsBalance.ToString(&quot;N2&quot;));&#xA;}&#xA;catch (System.Exception ex)&#xA;{&#xA;    System.Console.WriteLine(&quot;ERROR: &quot; + ex.Message);&#xA;    if (ex.InnerException != null) System.Console.WriteLine(&quot;Inner: &quot; + ex.InnerException.Message);&#xA;}&#xA;" DisplayName="FINAL dtHistoricalReconTransactionsReport and Recon Report Balances" sap:VirtualizedContainerService.HintSize="382,188" sap2010:WorkflowViewState.IdRef="InvokeCode_87" Language="CSharp">

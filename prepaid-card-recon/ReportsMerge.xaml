            <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Start timer&#xA;System.Diagnostics.Stopwatch sw = System.Diagnostics.Stopwatch.StartNew();&#xA;&#xA;// Validate reconCurrency&#xA;if (string.IsNullOrWhiteSpace(reconCurrency))&#xA;    throw new ArgumentException(&quot;❌ reconCurrency cannot be null or empty.&quot;);&#xA;&#xA;// Build column names dynamically&#xA;string debitCol = $&quot;Debit ({reconCurrency})&quot;;&#xA;string creditCol = $&quot;Credit ({reconCurrency})&quot;;&#xA;&#xA;// Check columns exist&#xA;if (!dtGlStatement.Columns.Contains(debitCol) || !dtGlStatement.Columns.Contains(creditCol))&#xA;{&#xA;    Console.WriteLine($&quot;❌ Columns '{debitCol}' or '{creditCol}' not found in dtGlStatement.&quot;);&#xA;    Console.WriteLine(&quot;Available columns:&quot;);&#xA;    foreach (DataColumn col in dtGlStatement.Columns)&#xA;        Console.WriteLine($&quot; - {col.ColumnName}&quot;);&#xA;    return;&#xA;}&#xA;&#xA;var rowsToDelete = new HashSet&lt;DataRow&gt;();&#xA;int removedRowsCount = 0;&#xA;&#xA;// === Build quick lookup for Transaction Ref No: ===&#xA;var txnRefLookup = dtGlStatement.AsEnumerable()&#xA;    .Where(r =&gt; !Convert.IsDBNull(r[&quot;Transaction Ref No:&quot;]))&#xA;    .GroupBy(r =&gt; (r.Field&lt;string&gt;(&quot;Transaction Ref No:&quot;) ?? string.Empty).Trim())&#xA;    .ToDictionary(g =&gt; g.Key, g =&gt; g.ToList());&#xA;&#xA;// === Track inserted reversals to avoid duplicates ===&#xA;var reversalsInserted = new HashSet&lt;string&gt;();&#xA;&#xA;// === Process each transaction ===&#xA;foreach (var row in dtGlStatement.AsEnumerable())&#xA;{&#xA;    string txnRef = (row.Field&lt;string&gt;(&quot;Transaction Ref No:&quot;) ?? string.Empty).Trim();&#xA;    if (string.IsNullOrEmpty(txnRef))&#xA;        continue;&#xA;&#xA;    decimal debitAmount = 0, creditAmount = 0;&#xA;    decimal.TryParse(row[debitCol]?.ToString(), out debitAmount);&#xA;    decimal.TryParse(row[creditCol]?.ToString(), out creditAmount);&#xA;&#xA;    // Skip rows with zero debit and credit&#xA;    if (debitAmount == 0 &amp;&amp; creditAmount == 0)&#xA;        continue;&#xA;&#xA;    if (!txnRefLookup.TryGetValue(txnRef, out var possibleMatches))&#xA;        continue;&#xA;&#xA;    foreach (var reversalRow in possibleMatches)&#xA;    {&#xA;        if (object.ReferenceEquals(row, reversalRow))&#xA;            continue; // Skip itself&#xA;&#xA;        decimal revDebit = 0, revCredit = 0;&#xA;        decimal.TryParse(reversalRow[debitCol]?.ToString(), out revDebit);&#xA;        decimal.TryParse(reversalRow[creditCol]?.ToString(), out revCredit);&#xA;&#xA;        // Check if this is a reversal pair&#xA;        bool isReversal =&#xA;            (revDebit == -debitAmount &amp;&amp; revCredit == 0) ||&#xA;            (revCredit == -creditAmount &amp;&amp; revDebit == 0);&#xA;&#xA;        if (isReversal)&#xA;        {&#xA;            string rowKey = $&quot;{txnRef}|{debitAmount}|{creditAmount}&quot;;&#xA;            string reversalKey = $&quot;{txnRef}|{revDebit}|{revCredit}&quot;;&#xA;&#xA;            if (reversalsInserted.Add(rowKey))&#xA;                dtReversalsGl.ImportRow(row);&#xA;&#xA;            if (reversalsInserted.Add(reversalKey))&#xA;                dtReversalsGl.ImportRow(reversalRow);&#xA;&#xA;            // Mark for deletion&#xA;            rowsToDelete.Add(row);&#xA;            rowsToDelete.Add(reversalRow);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Remove marked rows safely ===&#xA;foreach (var rowToDelete in rowsToDelete)&#xA;{&#xA;    try&#xA;    {&#xA;        dtGlStatement.Rows.Remove(rowToDelete);&#xA;        removedRowsCount++;&#xA;    }&#xA;    catch (Exception ex)&#xA;    {&#xA;        Console.WriteLine($&quot;❌ Error removing row: {ex.Message}&quot;);&#xA;    }&#xA;}&#xA;&#xA;// === Final log ===&#xA;sw.Stop();&#xA;Console.WriteLine($&quot;✅ REVERSALS processed&quot;);&#xA;Console.WriteLine($&quot;✅ Total Rows Removed: {removedRowsCount} in {sw.ElapsedMilliseconds} ms&quot;);&#xA;" DisplayName="REMOVE Reversals (Debit (TZS)/Credit (TZS) " sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_90" Language="CSharp">

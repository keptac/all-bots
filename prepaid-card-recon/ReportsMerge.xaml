              <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: Merge + Enrich (strict GL/CMS/HIST date formats, LINQ-free, hardened) ====&#xA;// Args (In): string reconCurrency&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport, DataTable dtGlStatement, DataTable dtTransactionReport, DataTable dtPostilionTxn&#xA;&#xA;// ---------------------------&#xA;// Config toggles&#xA;// ---------------------------&#xA;// If true -&gt; only merge CMS rows whose Billing Currency (or detected currency) equals reconCurrency.&#xA;// If false -&gt; include others but keep TZS Debit/Credit = 0 and mark FOREIGN_CURRENCY = true.&#xA;const bool CMS_ONLY_RECON_CCY = true;&#xA;&#xA;// Optional: do the same for GL if desired.&#xA;const bool GL_ONLY_RECON_CCY = false;&#xA;&#xA;// ---------------------------&#xA;// Basic helpers&#xA;// ---------------------------&#xA;DateTime? ParseDate_Fallback(object obj)&#xA;{&#xA;    if (obj == null || obj == DBNull.Value) return null;&#xA;    var s = obj.ToString().Trim();&#xA;    if (string.IsNullOrEmpty(s)) return null;&#xA;    DateTime any;&#xA;    return DateTime.TryParse(s, out any) ? (DateTime?)any : null;&#xA;}&#xA;&#xA;// Hardened amount parser:&#xA;// - Accepts (1,234.56), -1,234.56, &quot;1,234.56 Cr&quot;, &quot;1,234.56 Dr&quot;, &quot;TZS 1,234.56&quot;&#xA;// - Strips currency symbols/letters, keeps digits, sign, dot, comma, parentheses.&#xA;// - Honors accounting parentheses as negative.&#xA;decimal SafeParseAmount(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return 0m;&#xA;    string s = val.ToString();&#xA;    if (string.IsNullOrWhiteSpace(s)) return 0m;&#xA;&#xA;    s = s.Trim();&#xA;&#xA;    // Normalize common trailing tokens&#xA;    // e.g., &quot;1,234.56 Cr&quot; -&gt; &quot;1,234.56&quot;, &quot;1,234.56 Dr&quot; -&gt; &quot;1,234.56&quot;&#xA;    // We will handle sign via parentheses or leading '-'&#xA;    string lower = s.ToLowerInvariant();&#xA;    if (lower.EndsWith(&quot; cr&quot;) || lower.EndsWith(&quot; dr&quot;))&#xA;        s = s.Substring(0, s.Length - 3).Trim();&#xA;&#xA;    // Remove currency codes/symbols/letters while preserving digits, . , - and parentheses&#xA;    System.Text.StringBuilder sb = new System.Text.StringBuilder(s.Length);&#xA;    for (int i = 0; i &lt; s.Length; i++)&#xA;    {&#xA;        char ch = s[i];&#xA;        if ((ch &gt;= '0' &amp;&amp; ch &lt;= '9') || ch == '.' || ch == ',' || ch == '-' || ch == '(' || ch == ')')&#xA;            sb.Append(ch);&#xA;        // else drop (currency letters like TZS, ZWL, whitespace, etc.)&#xA;    }&#xA;    s = sb.ToString();&#xA;&#xA;    bool hasParen = s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;);&#xA;    if (hasParen)&#xA;        s = s.Trim('(', ')');&#xA;&#xA;    // Remove thousand separators (commas)&#xA;    s = s.Replace(&quot;,&quot;, &quot;&quot;);&#xA;&#xA;    decimal d;&#xA;    if (!decimal.TryParse(s, System.Globalization.NumberStyles.AllowLeadingSign | System.Globalization.NumberStyles.AllowDecimalPoint,&#xA;        System.Globalization.CultureInfo.InvariantCulture, out d))&#xA;    {&#xA;        // Try current culture as a fallback&#xA;        if (!decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.CurrentCulture, out d))&#xA;            return 0m;&#xA;    }&#xA;&#xA;    if (hasParen) d = -System.Math.Abs(d);&#xA;    return d;&#xA;}&#xA;&#xA;string SafeStr(object v) { return v == null || v == DBNull.Value ? string.Empty : v.ToString().Trim(); }&#xA;&#xA;void EnsureColumns(System.Data.DataTable dt, string[] cols, string currency)&#xA;{&#xA;    for (int i = 0; i &lt; cols.Length; i++)&#xA;    {&#xA;        string col = cols[i];&#xA;        if (!dt.Columns.Contains(col))&#xA;        {&#xA;            System.Type type =&#xA;                (col.IndexOf(&quot;Date&quot;, System.StringComparison.OrdinalIgnoreCase) &gt;= 0) ? typeof(System.DateTime) :&#xA;                (col == (&quot;Debit (&quot; + currency + &quot;)&quot;) || col == (&quot;Credit (&quot; + currency + &quot;)&quot;)) ? typeof(decimal) :&#xA;                (col == &quot;FOREIGN_CURRENCY&quot;) ? typeof(bool) :&#xA;                typeof(string);&#xA;            dt.Columns.Add(col, type);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;bool IsReconCurrency(System.Data.DataRow r, string reconCurrency)&#xA;{&#xA;    // Try common currency columns first (CMS/GL/HIST)&#xA;    string[] ccys = new string[] { &quot;Billing Currency&quot;, &quot;Currency&quot;, &quot;Transaction Currency&quot;, &quot;TXN_CCY&quot;, &quot;Settlement Currency&quot; };&#xA;    for (int i = 0; i &lt; ccys.Length; i++)&#xA;    {&#xA;        string c = ccys[i];&#xA;        if (r.Table.Columns.Contains(c))&#xA;        {&#xA;            string v = SafeStr(r[c]);&#xA;            if (v != &quot;&quot;) return string.Equals(v, reconCurrency, System.StringComparison.OrdinalIgnoreCase);&#xA;        }&#xA;    }&#xA;    // If no currency info present, treat as recon currency (legacy single-ccy files)&#xA;    return true;&#xA;}&#xA;&#xA;// Extract last 4 digits without StringBuilder&#xA;string ExtractLast4Digits(string s)&#xA;{&#xA;    if (string.IsNullOrEmpty(s)) return string.Empty;&#xA;    char[] buf = new char[4];&#xA;    int count = 0;&#xA;    for (int i = s.Length - 1; i &gt;= 0 &amp;&amp; count &lt; 4; i--)&#xA;    {&#xA;        char c = s[i];&#xA;        if (c &gt;= '0' &amp;&amp; c &lt;= '9')&#xA;        {&#xA;            buf[3 - count] = c;&#xA;            count++;&#xA;        }&#xA;    }&#xA;    return count == 4 ? new string(buf) : string.Empty;&#xA;}&#xA;&#xA;// === RRN Helpers ===&#xA;string CanonicalizeRRN_DigitsLast12(string raw)&#xA;{&#xA;    raw = SafeStr(raw);&#xA;    if (string.IsNullOrEmpty(raw)) return &quot;000000000000&quot;;&#xA;    System.Text.StringBuilder digits = new System.Text.StringBuilder();&#xA;    for (int i = 0; i &lt; raw.Length; i++)&#xA;    {&#xA;        char ch = raw[i];&#xA;        if (ch &gt;= '0' &amp;&amp; ch &lt;= '9') digits.Append(ch);&#xA;    }&#xA;    string d = digits.ToString();&#xA;    if (d.Length &gt;= 12) return d.Substring(d.Length - 12);&#xA;    return d.PadLeft(12, '0');&#xA;}&#xA;&#xA;string KeepLast12Chars(string raw)&#xA;{&#xA;    string s = SafeStr(raw);&#xA;    if (s.Length &lt;= 12) return s;&#xA;    return s.Substring(s.Length - 12);&#xA;}&#xA;&#xA;string GetPostilionRRN(System.Data.DataRow r)&#xA;{&#xA;    if (r.Table.Columns.Contains(&quot;FIELD37&quot;))&#xA;    {&#xA;        string from37 = CanonicalizeRRN_DigitsLast12(SafeStr(r[&quot;FIELD37&quot;]));&#xA;        if (!string.IsNullOrEmpty(from37)) return from37;&#xA;    }&#xA;    if (r.Table.Columns.Contains(&quot;RRN&quot;))&#xA;    {&#xA;        string fromRrn = CanonicalizeRRN_DigitsLast12(SafeStr(r[&quot;RRN&quot;]));&#xA;        if (!string.IsNullOrEmpty(fromRrn)) return fromRrn;&#xA;    }&#xA;    return &quot;000000000000&quot;;&#xA;}&#xA;&#xA;// ---------------------------&#xA;// Required columns&#xA;// ---------------------------&#xA;string[] baseCols = new string[] {&#xA;    &quot;SNO&quot;, &quot;Branch code&quot;, &quot;GL_Code&quot;, &quot;GL Description&quot;,&#xA;    &quot;Booking Date&quot;, &quot;Value Date&quot;, &quot;Transaction Ref No:&quot;,&#xA;    &quot;C_PAN&quot;, &quot;RRN&quot;, &quot;STAN&quot;, &quot;FLEXREF&quot;, &quot;Narration&quot;,&#xA;    &quot;Source&quot;, &quot;Type&quot;, &quot;Root Cause&quot;, &quot;Root Cause Category&quot;,&#xA;    &quot;Recommended Action&quot;, &quot;Action Owner&quot;, &quot;Aging&quot;, &quot;Aging Group&quot;,&#xA;    &quot;BOT Classification&quot;, &quot;AUTH&quot;, &quot;Transaction Type&quot;, &quot;Transaction Date&quot;,&#xA;    &quot;Billing Amount&quot;, &quot;Device Number&quot;, &quot;ARN&quot;, &quot;Channel&quot;, &quot;Classification&quot;,&#xA;    &quot;FOREIGN_CURRENCY&quot;,&#xA;    &quot;Billing Currency&quot;, &quot;Transaction Currency&quot;, &quot;Transaction Amount&quot;,&#xA;    &quot;Settlement Currency&quot;, &quot;Settlement Amount&quot;&#xA;};&#xA;string debitCol = &quot;Debit (&quot; + reconCurrency + &quot;)&quot;;&#xA;string creditCol = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xA;&#xA;// Build {baseCols + debit/credit}&#xA;string[] addCols = new string[] { debitCol, creditCol };&#xA;&#xA;string[] histCols = new string[baseCols.Length + addCols.Length];&#xA;for (int i = 0; i &lt; baseCols.Length; i++) histCols[i] = baseCols[i];&#xA;for (int i = 0; i &lt; addCols.Length; i++) histCols[baseCols.Length + i] = addCols[i];&#xA;&#xA;EnsureColumns(dtHistoricalReconTransactionsReport, histCols, reconCurrency);&#xA;EnsureColumns(dtGlStatement,                     histCols, reconCurrency);&#xA;EnsureColumns(dtTransactionReport,               histCols, reconCurrency);&#xA;EnsureColumns(dtPostilionTxn,                    histCols, reconCurrency);&#xA;&#xA;// ---------------------------&#xA;// Strict date formats (GL, CMS, HIST) — no static/readonly&#xA;// ---------------------------&#xA;string[] GL_DATE_FORMATS = new string[] {&#xA;    &quot;M/d/yyyy HH:mm:ss&quot;, &quot;MM/dd/yyyy HH:mm:ss&quot;,&#xA;    &quot;M/d/yyyy HH:mm&quot;,    &quot;MM/dd/yyyy HH:mm&quot;,&#xA;    &quot;M/d/yyyy&quot;,          &quot;MM/dd/yyyy&quot;,&#xA;    &quot;M/d/yy&quot;,            &quot;MM/dd/yy&quot;&#xA;};&#xA;&#xA;string[] CMS_DATE_FORMATS = new string[] {&#xA;    &quot;dd-MMM-yyyy HH:mm:ss&quot;, &quot;dd-MMM-yyyy HH:mm&quot;,&#xA;    &quot;dd-MMM-yyyy&quot;,          &quot;d-MMM-yyyy&quot;,&#xA;    &quot;yyyy-MM-dd HH:mm:ss&quot;,  &quot;yyyy-MM-dd HH:mm&quot;, &quot;yyyy-MM-dd&quot;,&#xA;    &quot;dd/MM/yyyy HH:mm:ss&quot;,  &quot;dd/MM/yyyy HH:mm&quot;, &quot;dd/MM/yyyy&quot;,&#xA;    &quot;d/M/yyyy HH:mm:ss&quot;,    &quot;d/M/yyyy HH:mm&quot;,   &quot;d/M/yyyy&quot;,&#xA;    &quot;dd-MMM-yy&quot;&#xA;};&#xA;&#xA;// Merge unique formats (no LINQ Distinct)&#xA;string[] MergeUnique(string[][] lists)&#xA;{&#xA;    System.Collections.Generic.HashSet&lt;string&gt; set = new System.Collections.Generic.HashSet&lt;string&gt;(System.StringComparer.Ordinal);&#xA;    System.Collections.Generic.List&lt;string&gt; res = new System.Collections.Generic.List&lt;string&gt;();&#xA;    for (int i = 0; i &lt; lists.Length; i++)&#xA;    {&#xA;        string[] arr = lists[i];&#xA;        for (int j = 0; j &lt; arr.Length; j++)&#xA;        {&#xA;            string f = arr[j];&#xA;            if (set.Add(f)) res.Add(f);&#xA;        }&#xA;    }&#xA;    return res.ToArray();&#xA;}&#xA;&#xA;string[] extraHist = new string[] { &quot;yyyy-MMM-dd&quot;, &quot;M/d/yy&quot;, &quot;MM/dd/yy&quot; };&#xA;string[][] toMerge = new string[][] { GL_DATE_FORMATS, CMS_DATE_FORMATS, extraHist };&#xA;string[] HIST_DATE_FORMATS = MergeUnique(toMerge);&#xA;&#xA;// Parser funcs&#xA;System.DateTime? ParseDate_GL(object obj)&#xA;{&#xA;    if (obj == null || obj == DBNull.Value) return null;&#xA;    string s = obj.ToString().Trim();&#xA;    if (string.IsNullOrEmpty(s)) return null;&#xA;    System.DateTime dt;&#xA;    if (System.DateTime.TryParseExact(s, GL_DATE_FORMATS,&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xA;        System.Globalization.DateTimeStyles.None, out dt)) return dt;&#xA;    return null;&#xA;}&#xA;&#xA;System.DateTime? ParseDate_CMS(object obj)&#xA;{&#xA;    if (obj == null || obj == DBNull.Value) return null;&#xA;    string s = obj.ToString().Trim();&#xA;    if (string.IsNullOrEmpty(s)) return null;&#xA;    System.DateTime dt;&#xA;    if (System.DateTime.TryParseExact(s, CMS_DATE_FORMATS,&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xA;        System.Globalization.DateTimeStyles.None, out dt)) return dt;&#xA;    return null;&#xA;}&#xA;&#xA;System.DateTime? ParseDate_HIST(object obj)&#xA;{&#xA;    if (obj == null || obj == DBNull.Value) return null;&#xA;    string s = obj.ToString().Trim();&#xA;    if (string.IsNullOrEmpty(s)) return null;&#xA;    System.DateTime dt;&#xA;    if (System.DateTime.TryParseExact(s, HIST_DATE_FORMATS,&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xA;        System.Globalization.DateTimeStyles.None, out dt)) return dt;&#xA;&#xA;    // Optional: fallback parse&#xA;    return ParseDate_Fallback(s);&#xA;}&#xA;&#xA;// Coercion helper&#xA;void CoerceToDateTime(System.Data.DataTable dt, string colName, System.Func&lt;object, System.DateTime?&gt; parser)&#xA;{&#xA;    if (!dt.Columns.Contains(colName)) return;&#xA;&#xA;    if (dt.Columns[colName].DataType == typeof(System.DateTime))&#xA;    {&#xA;        for (int i = 0; i &lt; dt.Rows.Count; i++)&#xA;        {&#xA;            object v = dt.Rows[i][colName];&#xA;            if (v is string)&#xA;            {&#xA;                System.DateTime? p = parser(v);&#xA;                dt.Rows[i][colName] = p.HasValue ? (object)p.Value : DBNull.Value;&#xA;            }&#xA;        }&#xA;        return;&#xA;    }&#xA;&#xA;    string tmp = colName + &quot;__DT&quot;;&#xA;    if (!dt.Columns.Contains(tmp)) dt.Columns.Add(tmp, typeof(System.DateTime));&#xA;&#xA;    for (int i = 0; i &lt; dt.Rows.Count; i++)&#xA;    {&#xA;        System.DateTime? p = parser(dt.Rows[i][colName]);&#xA;        dt.Rows[i][tmp] = p.HasValue ? (object)p.Value : DBNull.Value;&#xA;    }&#xA;&#xA;    int ordinal = dt.Columns[colName].Ordinal;&#xA;    dt.Columns.Remove(colName);&#xA;    dt.Columns[tmp].ColumnName = colName;&#xA;    dt.Columns[colName].SetOrdinal(ordinal);&#xA;}&#xA;&#xA;// ---------------------------&#xA;// Normalize existing HIST rows&#xA;// ---------------------------&#xA;int histBefore = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    System.Data.DataRow r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    r[&quot;Source&quot;] = &quot;HIST&quot;;&#xA;    r[&quot;Type&quot;]   = &quot;old&quot;;&#xA;    if (r.Table.Columns.Contains(&quot;Classification&quot;))&#xA;    {&#xA;        var v = r[&quot;Classification&quot;];&#xA;        if (v == DBNull.Value || SafeStr(v) == &quot;&quot;) r[&quot;Classification&quot;] = &quot;&quot;;&#xA;    }&#xA;}&#xA;CoerceToDateTime(dtHistoricalReconTransactionsReport, &quot;Booking Date&quot;,     ParseDate_HIST);&#xA;CoerceToDateTime(dtHistoricalReconTransactionsReport, &quot;Value Date&quot;,       ParseDate_HIST);&#xA;CoerceToDateTime(dtHistoricalReconTransactionsReport, &quot;Transaction Date&quot;, ParseDate_HIST);&#xA;&#xA;// ---------------------------&#xA;// CMS mapping + normalization (with currency guard)&#xA;// ---------------------------&#xA;if (!dtTransactionReport.Columns.Contains(&quot;RRN&quot;))     dtTransactionReport.Columns.Add(&quot;RRN&quot;,  typeof(string));&#xA;if (!dtTransactionReport.Columns.Contains(&quot;STAN&quot;))    dtTransactionReport.Columns.Add(&quot;STAN&quot;, typeof(string));&#xA;if (!dtTransactionReport.Columns.Contains(&quot;AUTH&quot;))    dtTransactionReport.Columns.Add(&quot;AUTH&quot;, typeof(string));&#xA;if (!dtTransactionReport.Columns.Contains(&quot;C_PAN&quot;))   dtTransactionReport.Columns.Add(&quot;C_PAN&quot;, typeof(string));&#xA;if (!dtTransactionReport.Columns.Contains(&quot;Transaction Ref No:&quot;)) dtTransactionReport.Columns.Add(&quot;Transaction Ref No:&quot;, typeof(string));&#xA;if (!dtTransactionReport.Columns.Contains(&quot;Narration&quot;))           dtTransactionReport.Columns.Add(&quot;Narration&quot;, typeof(string));&#xA;if (!dtTransactionReport.Columns.Contains(&quot;Channel&quot;))             dtTransactionReport.Columns.Add(&quot;Channel&quot;, typeof(string));&#xA;if (!dtTransactionReport.Columns.Contains(&quot;Classification&quot;))      dtTransactionReport.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;&#xA;string[] cmsCarryCols = new string[] {&#xA;    &quot;Billing Currency&quot;,&quot;Transaction Currency&quot;,&quot;Transaction Amount&quot;,&#xA;    &quot;Settlement Currency&quot;,&quot;Settlement Amount&quot;&#xA;};&#xA;EnsureColumns(dtTransactionReport, cmsCarryCols, reconCurrency);&#xA;&#xA;// Enforce CMS date formats&#xA;CoerceToDateTime(dtTransactionReport, &quot;Transaction Date&quot;, ParseDate_CMS);&#xA;CoerceToDateTime(dtTransactionReport, &quot;Booking Date&quot;,     ParseDate_CMS);&#xA;CoerceToDateTime(dtTransactionReport, &quot;Value Date&quot;,       ParseDate_CMS);&#xA;&#xA;string cmsStanSrc  = dtTransactionReport.Columns.Contains(&quot;Trace Audit Number&quot;)   ? &quot;Trace Audit Number&quot;   : (dtTransactionReport.Columns.Contains(&quot;STAN&quot;) ? &quot;STAN&quot; : null);&#xA;string cmsRrnSrc   = dtTransactionReport.Columns.Contains(&quot;Reference Number&quot;)     ? &quot;Reference Number&quot;     : (dtTransactionReport.Columns.Contains(&quot;RRN&quot;)  ? &quot;RRN&quot;  : null);&#xA;string cmsAuthSrc  = dtTransactionReport.Columns.Contains(&quot;Authorization Number&quot;) ? &quot;Authorization Number&quot; : (dtTransactionReport.Columns.Contains(&quot;AUTH&quot;) ? &quot;AUTH&quot; : null);&#xA;&#xA;// Normalize CMS rows&#xA;for (int i = 0; i &lt; dtTransactionReport.Rows.Count; i++)&#xA;{&#xA;    System.Data.DataRow row = dtTransactionReport.Rows[i];&#xA;&#xA;    if (!string.IsNullOrEmpty(cmsStanSrc)) row[&quot;STAN&quot;] = SafeStr(row[cmsStanSrc]);&#xA;    if (!string.IsNullOrEmpty(cmsRrnSrc))  row[&quot;RRN&quot;]  = KeepLast12Chars(SafeStr(row[cmsRrnSrc]));&#xA;    if (!string.IsNullOrEmpty(cmsAuthSrc)) row[&quot;AUTH&quot;] = SafeStr(row[cmsAuthSrc]);&#xA;&#xA;    if (dtTransactionReport.Columns.Contains(&quot;ARN&quot;))&#xA;    {&#xA;        string arn = SafeStr(row[&quot;ARN&quot;]);&#xA;        row[&quot;Transaction Ref No:&quot;] = arn.Length &gt;= 23 ? arn.Substring(0, 23) : arn;&#xA;    }&#xA;&#xA;    string deviceNumber = SafeStr(row[&quot;Device Number&quot;]);&#xA;    if (!string.IsNullOrEmpty(deviceNumber) &amp;&amp; deviceNumber.Length &gt;= 16)&#xA;        row[&quot;C_PAN&quot;] = deviceNumber.Substring(0, 6) + &quot;XXXXXX&quot; + deviceNumber.Substring(deviceNumber.Length - 4);&#xA;    else&#xA;        row[&quot;C_PAN&quot;] = string.Empty;&#xA;&#xA;    string txnType = SafeStr(row[&quot;Transaction Type&quot;]);&#xA;    string stan    = SafeStr(row[&quot;STAN&quot;]);&#xA;    string rrn     = SafeStr(row[&quot;RRN&quot;]);&#xA;    string auth    = SafeStr(row[&quot;AUTH&quot;]);&#xA;    row[&quot;Narration&quot;] = txnType + &quot;-&quot; + row[&quot;C_PAN&quot;] + &quot;-&quot; + stan + &quot;-&quot; + rrn + &quot;-&quot; + auth;&#xA;&#xA;    var vClass = row[&quot;Classification&quot;];&#xA;    if (vClass == DBNull.Value || SafeStr(vClass) == &quot;&quot;) row[&quot;Classification&quot;] = &quot;&quot;;&#xA;}&#xA;&#xA;// ---------------------------&#xA;// GL enrich from Postilion (no LINQ)&#xA;// ---------------------------&#xA;string fixedBin = &quot;550558&quot;;&#xA;bool hasMaskedCol = dtPostilionTxn.Columns.Contains(&quot;FIELD65_MASKED&quot;);&#xA;&#xA;// Build first-hit FLEXREF -&gt; DataRow lookup manually&#xA;System.Collections.Generic.Dictionary&lt;string, System.Data.DataRow&gt; postilionLookup =&#xA;    new System.Collections.Generic.Dictionary&lt;string, System.Data.DataRow&gt;(System.StringComparer.OrdinalIgnoreCase);&#xA;&#xA;for (int i = 0; i &lt; dtPostilionTxn.Rows.Count; i++)&#xA;{&#xA;    System.Data.DataRow r = dtPostilionTxn.Rows[i];&#xA;    string fx = SafeStr(r[&quot;FLEXREF&quot;]);&#xA;    if (!string.IsNullOrEmpty(fx))&#xA;    {&#xA;        if (!postilionLookup.ContainsKey(fx))&#xA;            postilionLookup.Add(fx, r);&#xA;    }&#xA;}&#xA;&#xA;// Enforce GL date formats&#xA;CoerceToDateTime(dtGlStatement, &quot;Booking Date&quot;,     ParseDate_GL);&#xA;CoerceToDateTime(dtGlStatement, &quot;Value Date&quot;,       ParseDate_GL);&#xA;CoerceToDateTime(dtGlStatement, &quot;Transaction Date&quot;, ParseDate_GL);&#xA;&#xA;int glEnriched = 0;&#xA;for (int i = 0; i &lt; dtGlStatement.Rows.Count; i++)&#xA;{&#xA;    System.Data.DataRow glRow = dtGlStatement.Rows[i];&#xA;    string trxRef = SafeStr(glRow[&quot;Transaction Ref No:&quot;]);&#xA;    if (!string.IsNullOrEmpty(trxRef) &amp;&amp; postilionLookup.ContainsKey(trxRef))&#xA;    {&#xA;        System.Data.DataRow postRow = postilionLookup[trxRef];&#xA;        glRow[&quot;FLEXREF&quot;] = SafeStr(postRow[&quot;FLEXREF&quot;]);&#xA;&#xA;        if (hasMaskedCol)&#xA;        {&#xA;            string masked = SafeStr(postRow[&quot;FIELD65_MASKED&quot;]);&#xA;            string last4  = ExtractLast4Digits(masked);&#xA;            if (!string.IsNullOrEmpty(last4))&#xA;                glRow[&quot;C_PAN&quot;] = fixedBin + &quot;XXXXXX&quot; + last4;&#xA;        }&#xA;&#xA;        glRow[&quot;RRN&quot;] = GetPostilionRRN(postRow);&#xA;&#xA;        // Append C_PAN and RRN to existing GL narration instead of overwriting&#xA;        string cPan = SafeStr(glRow[&quot;C_PAN&quot;]);&#xA;        string rrn  = SafeStr(glRow[&quot;RRN&quot;]);&#xA;        if (!string.IsNullOrEmpty(cPan) &amp;&amp; !string.IsNullOrEmpty(rrn))&#xA;        {&#xA;            string existingNarr = SafeStr(glRow[&quot;Narration&quot;]);&#xA;            string suffix = &quot;C_PAN: &quot; + cPan + &quot; RRN: &quot; + rrn;&#xA;            glRow[&quot;Narration&quot;] = string.IsNullOrEmpty(existingNarr) ? suffix : (existingNarr + &quot; &quot; + suffix);&#xA;        }&#xA;&#xA;        if (glRow.Table.Columns.Contains(&quot;Classification&quot;))&#xA;        {&#xA;            var v = glRow[&quot;Classification&quot;];&#xA;            if (v == DBNull.Value || SafeStr(v) == &quot;&quot;) glRow[&quot;Classification&quot;] = &quot;&quot;;&#xA;        }&#xA;&#xA;        glEnriched++;&#xA;    }&#xA;}&#xA;&#xA;// ---------------------------&#xA;// Pre-merge audit (expected totals from each source)&#xA;// ---------------------------&#xA;decimal SumHistDeb = 0m, SumHistCre = 0m;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    decimal d = dtHistoricalReconTransactionsReport.Columns.Contains(debitCol)  ? SafeParseAmount(r[debitCol])  : 0m;&#xA;    decimal c = dtHistoricalReconTransactionsReport.Columns.Contains(creditCol) ? SafeParseAmount(r[creditCol]) : 0m;&#xA;    // HIST uses positive magnitudes per side&#xA;    SumHistDeb += System.Math.Abs(d);&#xA;    SumHistCre += System.Math.Abs(c);&#xA;}&#xA;&#xA;decimal SumGlDeb = 0m, SumGlCre = 0m;&#xA;for (int i = 0; i &lt; dtGlStatement.Rows.Count; i++)&#xA;{&#xA;    var r = dtGlStatement.Rows[i];&#xA;    decimal d = dtGlStatement.Columns.Contains(debitCol)  ? SafeParseAmount(r[debitCol])  : 0m;&#xA;    decimal c = dtGlStatement.Columns.Contains(creditCol) ? SafeParseAmount(r[creditCol]) : 0m;&#xA;    SumGlDeb += System.Math.Abs(d);&#xA;    SumGlCre += System.Math.Abs(c);&#xA;}&#xA;&#xA;decimal SumCmsDeb = 0m, SumCmsCre = 0m;&#xA;for (int i = 0; i &lt; dtTransactionReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtTransactionReport.Rows[i];&#xA;    // CMS expectation based on Billing Amount sign (only when recon currency)&#xA;    bool isRecon = IsReconCurrency(r, reconCurrency);&#xA;    decimal billing = SafeParseAmount(r[&quot;Billing Amount&quot;]);&#xA;    if (isRecon)&#xA;    {&#xA;        if (billing &lt; 0) SumCmsDeb += System.Math.Abs(billing); else if (billing &gt; 0) SumCmsCre += System.Math.Abs(billing);&#xA;        // billing == 0 ignored&#xA;    }&#xA;}&#xA;&#xA;// ---------------------------&#xA;// Merge GL + CMS into Historical (with normalization &amp; currency guards)&#xA;// ---------------------------&#xA;int beforeCount = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;int lastSNO = beforeCount;&#xA;int reportOffset = 17;&#xA;&#xA;int glAdded = 0;&#xA;int glSkippedNonRecon = 0;&#xA;&#xA;for (int i = 0; i &lt; dtGlStatement.Rows.Count; i++)&#xA;{&#xA;    System.Data.DataRow row = dtGlStatement.Rows[i];&#xA;&#xA;    bool glIsRecon = IsReconCurrency(row, reconCurrency);&#xA;    if (GL_ONLY_RECON_CCY &amp;&amp; !glIsRecon)&#xA; 
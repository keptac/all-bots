      <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: CMS income/fee/levy tagging (no cash-advance logic) =====&#xA;// Args (In): reconDate (string)  // not used&#xA;// Args (In/Out): dtHistoricalReconTransactionsReport (DataTable)&#xA;&#xA;/////////////////////// Helpers ///////////////////////&#xA;&#xA;bool HasCol(System.Data.DataTable dt, string name) =&gt; dt != null &amp;&amp; dt.Columns.Contains(name);&#xA;&#xA;void EnsureTextCol(System.Data.DataTable dt, string name)&#xA;{&#xA;    if (!dt.Columns.Contains(name))&#xA;        dt.Columns.Add(new System.Data.DataColumn(name, typeof(string)) { DefaultValue = &quot;&quot; });&#xA;}&#xA;&#xA;string NormalizeTxnType(string s)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(s)) return &quot;&quot;;&#xA;    return System.Text.RegularExpressions.Regex.Replace(s.Trim().ToLowerInvariant(), @&quot;\s+&quot;, &quot; &quot;);&#xA;}&#xA;&#xA;/////////////////////// Ensure output cols ///////////////////////&#xA;&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;Root Cause&quot;);&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;Root Cause Category&quot;);&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;Recommended Action&quot;);&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;Action Owner&quot;);&#xA;&#xA;// NEW COLUMN for processed flags&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;ROOT_CAUSE_PROCESSED&quot;);&#xA;&#xA;/////////////////////// Tag income/fee/levy for CMS new where channel != API ///////////////////////&#xA;&#xA;int tagged = 0;&#xA;&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string source   = HasCol(dtHistoricalReconTransactionsReport, &quot;Source&quot;)   ? (row[&quot;Source&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;    string type     = HasCol(dtHistoricalReconTransactionsReport, &quot;Type&quot;)     ? (row[&quot;Type&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;    string channel  = HasCol(dtHistoricalReconTransactionsReport, &quot;Channel&quot;)  ? (row[&quot;Channel&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;    string txnType  = HasCol(dtHistoricalReconTransactionsReport, &quot;Transaction Type&quot;) ? (row[&quot;Transaction Type&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;&#xA;    // Only CMS &quot;new&quot;&#xA;    if (!(source.Equals(&quot;CMS&quot;, System.StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;          type.Equals(&quot;new&quot;, System.StringComparison.OrdinalIgnoreCase))) continue;&#xA;&#xA;    // Don't overwrite if already tagged&#xA;    if (!string.IsNullOrEmpty(row[&quot;Root Cause&quot;]?.ToString())) continue;&#xA;&#xA;    string normalizedTxnType = NormalizeTxnType(txnType);&#xA;&#xA;    // Tag if channel != API and matches income/fee/levy&#xA;    if (channel != &quot;API&quot; &amp;&amp; &#xA;        (normalizedTxnType.Contains(&quot;fee&quot;) ||&#xA;         normalizedTxnType.Contains(&quot;income&quot;) ||&#xA;         normalizedTxnType.Contains(&quot;tax on income&quot;) ||&#xA;         normalizedTxnType.Contains(&quot;levy&quot;)))&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Prepaid Card Income updated on CMS only&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Post the income manually&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Finance&quot;;&#xA;&#xA;        // NEW: mark as processed&#xA;        row[&quot;ROOT_CAUSE_PROCESSED&quot;] = &quot;TRUE&quot;;&#xA;&#xA;        tagged++;&#xA;    }&#xA;}&#xA;&#xA;System.Console.WriteLine($&quot;✅ CMS income/fee/levy tagging complete. Tagged: {tagged} (ROOT_CAUSE_PROCESSED set TRUE)&quot;);&#xA;// End&#xA;" DisplayName="Income, fees, levy and Channel != API" sap:VirtualizedContainerService.HintSize="1169.3333333333333,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode
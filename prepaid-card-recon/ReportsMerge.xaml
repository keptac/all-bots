        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== HIST reversals removal by PAN + RefNo + amount (UiPath C# Invoke Code) ====&#xA;// Args (In):     string reconCurrency&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport, DataTable dtHistoricalReconTransactionsReportRev&#xA;&#xA;System.Diagnostics.Stopwatch sw = System.Diagnostics.Stopwatch.StartNew();&#xA;&#xA;int removedRowsCount = 0;&#xA;int groupsProcessed   = 0;  &#xA;int pairsMatched      = 0;&#xA;&#xA;var rowsToDelete = new HashSet&lt;DataRow&gt;();&#xA;var insertedKeys = new HashSet&lt;string&gt;();&#xA;&#xA;// Build column names once&#xA;string narrationCol = &quot;Narration&quot;;&#xA;string refNoCol     = &quot;Transaction Ref No:&quot;;&#xA;string debitCol     = &quot;Debit (&quot;  + reconCurrency + &quot;)&quot;;&#xA;string creditCol    = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xA;&#xA;// Defensive: ensure required columns exist&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(narrationCol) ||&#xA;    !dtHistoricalReconTransactionsReport.Columns.Contains(refNoCol) ||&#xA;    !dtHistoricalReconTransactionsReport.Columns.Contains(debitCol) ||&#xA;    !dtHistoricalReconTransactionsReport.Columns.Contains(creditCol))&#xA;{&#xA;    Console.WriteLine($&quot;[REV] Missing required columns. Abort.&quot;);&#xA;    return;&#xA;}&#xA;&#xA;// ---------- Helpers ----------&#xA;decimal ParseAmount(object value)&#xA;{&#xA;    if (value == null || value == DBNull.Value) return 0m;&#xA;    var s = value.ToString().Trim();&#xA;    if (string.IsNullOrWhiteSpace(s)) return 0m;&#xA;&#xA;    bool paren = s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;);&#xA;    s = s.Replace(&quot;(&quot;, &quot;&quot;).Replace(&quot;)&quot;, &quot;&quot;).Replace(&quot;,&quot;, &quot;&quot;).Trim();&#xA;&#xA;    decimal v;&#xA;    if (!decimal.TryParse(s, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out v))&#xA;        return 0m;&#xA;&#xA;    return paren ? -v : v;&#xA;}&#xA;&#xA;bool Eq(decimal a, decimal b) =&gt; a == b;&#xA;&#xA;// PAN normalization&#xA;string NormalizePanKey(string raw)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(raw)) return &quot;&quot;;&#xA;&#xA;    string s = raw.Trim().ToUpperInvariant();&#xA;&#xA;    // Masked PAN (accept *, X, x, 0)&#xA;    var mMasked = System.Text.RegularExpressions.Regex.Match(&#xA;        s, @&quot;\b(?&lt;first6&gt;\d{6})(?:[\*Xx0]{6})(?&lt;last4&gt;\d{4})\b&quot;,&#xA;        System.Text.RegularExpressions.RegexOptions.IgnoreCase&#xA;    );&#xA;    if (mMasked.Success)&#xA;        return mMasked.Groups[&quot;first6&quot;].Value + &quot;XXXXXX&quot; + mMasked.Groups[&quot;last4&quot;].Value;&#xA;&#xA;    // Full PAN (10–19 digits)&#xA;    var mDigits = System.Text.RegularExpressions.Regex.Match(s, @&quot;\b(?&lt;digits&gt;\d{10,19})\b&quot;);&#xA;    if (mDigits.Success)&#xA;    {&#xA;        var digits = mDigits.Groups[&quot;digits&quot;].Value;&#xA;        return digits.Substring(0, 6) + &quot;XXXXXX&quot; + digits.Substring(digits.Length - 4, 4);&#xA;    }&#xA;&#xA;    return &quot;&quot;;&#xA;}&#xA;&#xA;string ExtractPANKeyFromNarration(string narr)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(narr)) return &quot;&quot;;&#xA;&#xA;    var mMasked = System.Text.RegularExpressions.Regex.Match(&#xA;        narr, @&quot;\b(?&lt;first6&gt;\d{6})(?:[\*Xx0]{6})(?&lt;last4&gt;\d{4})\b&quot;,&#xA;        System.Text.RegularExpressions.RegexOptions.IgnoreCase&#xA;    );&#xA;    if (mMasked.Success)&#xA;        return mMasked.Groups[&quot;first6&quot;].Value + &quot;XXXXXX&quot; + mMasked.Groups[&quot;last4&quot;].Value;&#xA;&#xA;    var mDigits = System.Text.RegularExpressions.Regex.Match(&#xA;        narr, @&quot;\b(?&lt;digits&gt;\d{10,19})\b&quot;,&#xA;        System.Text.RegularExpressions.RegexOptions.IgnoreCase&#xA;    );&#xA;    if (mDigits.Success)&#xA;    {&#xA;        var digits = mDigits.Groups[&quot;digits&quot;].Value;&#xA;        return digits.Substring(0, 6) + &quot;XXXXXX&quot; + digits.Substring(digits.Length - 4, 4);&#xA;    }&#xA;&#xA;    return &quot;&quot;;&#xA;}&#xA;&#xA;// Duplicate guard&#xA;string MakeKey(string panKey, string refNo, decimal d, decimal c, int idx) &#xA;    =&gt; $&quot;{panKey}|{refNo}|{d}|{c}|{idx}&quot;;&#xA;&#xA;// ---------- Build lookup by PAN + RefNo ----------&#xA;var groupLookup = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;(System.StringComparer.Ordinal);&#xA;&#xA;foreach (DataRow r in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    if (r.RowState == DataRowState.Deleted) continue;&#xA;&#xA;    string panKey = ExtractPANKeyFromNarration(r[narrationCol]?.ToString() ?? &quot;&quot;);&#xA;    if (string.IsNullOrEmpty(panKey)) continue;&#xA;&#xA;    string refNo = r[refNoCol]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;    if (string.IsNullOrEmpty(refNo)) continue;&#xA;&#xA;    string groupKey = panKey + &quot;|&quot; + refNo;&#xA;&#xA;    if (!groupLookup.TryGetValue(groupKey, out var list))&#xA;    {&#xA;        list = new List&lt;DataRow&gt;();&#xA;        groupLookup[groupKey] = list;&#xA;    }&#xA;    list.Add(r);&#xA;}&#xA;&#xA;// ---------- Match within each group ----------&#xA;foreach (var kvp in groupLookup)&#xA;{&#xA;    string groupKey = kvp.Key;&#xA;    var rows = kvp.Value;&#xA;    if (rows == null || rows.Count == 0) continue;&#xA;&#xA;    groupsProcessed++;&#xA;&#xA;    var debits  = new List&lt;(decimal amt, DataRow row, int idx)&gt;();&#xA;    var credits = new List&lt;(decimal amt, DataRow row, int idx)&gt;();&#xA;&#xA;    for (int i = 0; i &lt; rows.Count; i++)&#xA;    {&#xA;        var r = rows[i];&#xA;        if (r.RowState == DataRowState.Deleted) continue;&#xA;&#xA;        decimal d = ParseAmount(r[debitCol]);&#xA;        decimal c = ParseAmount(r[creditCol]);&#xA;&#xA;        if (d == 0m &amp;&amp; c == 0m) continue;&#xA;&#xA;        if (d &gt; 0m &amp;&amp; c == 0m) debits.Add((d, r, i));&#xA;        else if (c &gt; 0m &amp;&amp; d == 0m) credits.Add((c, r, i));&#xA;    }&#xA;&#xA;    if (debits.Count == 0 || credits.Count == 0) continue;&#xA;&#xA;    var usedDebits  = new HashSet&lt;int&gt;();&#xA;    var usedCredits = new HashSet&lt;int&gt;();&#xA;&#xA;    for (int i = 0; i &lt; debits.Count; i++)&#xA;    {&#xA;        if (usedDebits.Contains(i)) continue;&#xA;        var (dAmt, dRow, dIdx) = debits[i];&#xA;&#xA;        for (int j = 0; j &lt; credits.Count; j++)&#xA;        {&#xA;            if (usedCredits.Contains(j)) continue;&#xA;            var (cAmt, cRow, cIdx) = credits[j];&#xA;&#xA;            if (Eq(dAmt, cAmt))&#xA;            {&#xA;                string refNo = dRow[refNoCol]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;                string panKey = ExtractPANKeyFromNarration(dRow[narrationCol]?.ToString() ?? &quot;&quot;);&#xA;&#xA;                string k1 = MakeKey(panKey, refNo, ParseAmount(dRow[debitCol]), ParseAmount(dRow[creditCol]), dIdx);&#xA;                if (insertedKeys.Add(k1)) dtHistoricalReconTransactionsReportRev.ImportRow(dRow);&#xA;&#xA;                string k2 = MakeKey(panKey, refNo, ParseAmount(cRow[debitCol]), ParseAmount(cRow[creditCol]), cIdx);&#xA;                if (insertedKeys.Add(k2)) dtHistoricalReconTransactionsReportRev.ImportRow(cRow);&#xA;&#xA;                rowsToDelete.Add(dRow);&#xA;                rowsToDelete.Add(cRow);&#xA;&#xA;                usedDebits.Add(i);&#xA;                usedCredits.Add(j);&#xA;                pairsMatched++;&#xA;                break;&#xA;            }&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// ---------- Remove marked rows ----------&#xA;foreach (var r in rowsToDelete)&#xA;{&#xA;    try&#xA;    {&#xA;        if (r.Table != null &amp;&amp; r.RowState != DataRowState.Deleted)&#xA;        {&#xA;            dtHistoricalReconTransactionsReport.Rows.Remove(r);&#xA;            removedRowsCount++;&#xA;        }&#xA;    }&#xA;    catch (Exception ex)&#xA;    {&#xA;        Console.WriteLine($&quot;❌ Error removing row: {ex.Message}&quot;);&#xA;    }&#xA;}&#xA;&#xA;// ---------- Final log ----------&#xA;sw.Stop();&#xA;Console.WriteLine($&quot;✅ REVERSALS (by PAN+RefNo+amount): groups={groupsProcessed}, pairs={pairsMatched}, rows removed={removedRowsCount} in {sw.ElapsedMilliseconds} ms&quot;);&#xA;" DisplayName="CMS Source REMOVE Reversals (Debit (reconCurrency)/Credit (reconCurrency) " sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_75" Language="CSharp">

              <ui:InvokeCode ContinueOnError="{x:Null}" Code="using (var package = new ExcelPackage(new FileInfo(prepaidCardWorkingsFileName)))&#xA;{&#xA;    // --- GL sheet ---&#xA;var wsRaw = package.Workbook.Worksheets.FirstOrDefault(w =&gt; w.Name.Trim().Equals(&quot;GL&quot;, StringComparison.OrdinalIgnoreCase));&#xA;if (wsRaw != null) package.Workbook.Worksheets.Delete(wsRaw);&#xA;&#xA;wsRaw = package.Workbook.Worksheets.Add(&quot;GL&quot;);&#xA;&#xA;&#xA;    int totalRows = dtGlStatement.Rows.Count;&#xA;    int totalCols = dtGlStatement.Columns.Count;&#xA;&#xA;    // Write headers&#xA;    for (int c = 0; c &lt; totalCols; c++)&#xA;        wsRaw.Cells[1, c + 1].Value = dtGlStatement.Columns[c].ColumnName;&#xA;&#xA;    // Disable calculation for faster write&#xA;    package.Workbook.CalcMode = ExcelCalcMode.Manual;&#xA;&#xA;    // Write rows directly&#xA;    var values = new object[totalRows, totalCols];&#xA;    for (int r = 0; r &lt; totalRows; r++)&#xA;    {&#xA;        for (int c = 0; c &lt; totalCols; c++)&#xA;        {&#xA;            values[r, c] = dtGlStatement.Rows[r][c] ?? &quot;&quot;; // DBNull -&gt; empty&#xA;        }&#xA;    }&#xA;    wsRaw.Cells[2, 1, totalRows + 1, totalCols].Value = values;&#xA;&#xA;    // Apply number/date formatting in bulk&#xA;    var bookingCol = dtGlStatement.Columns[&quot;Booking Date&quot;].Ordinal + 1;&#xA;    var valueCol = dtGlStatement.Columns[&quot;Value Date&quot;].Ordinal + 1;&#xA;    wsRaw.Cells[2, bookingCol, totalRows + 1, bookingCol].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;    wsRaw.Cells[2, valueCol, totalRows + 1, valueCol].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;&#xA;    package.Save();&#xA;}&#xA;&#xA;Console.WriteLine($&quot;✅ dtGlStatement saved to sheet 'GL' ({dtGlStatement.Rows.Count:N0} rows).&quot;);&#xA;" DisplayName="Write dtGlStatement" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_39" Language="CSharp">

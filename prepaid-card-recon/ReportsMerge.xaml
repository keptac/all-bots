ystem.Globalization.CultureInfo.InvariantCulture, out d);&#xA;        if (dParen) d = -System.Math.Abs(d);&#xA;&#xA;        // ---- Hardened parse for Credit ----&#xA;        string cRaw = (row[creditCol] == DBNull.Value ? &quot;&quot; : row[creditCol].ToString().Trim());&#xA;        bool cParen = cRaw.StartsWith(&quot;(&quot;) &amp;&amp; cRaw.EndsWith(&quot;)&quot;);&#xA;        System.Text.StringBuilder cSb = new System.Text.StringBuilder(cRaw.Length);&#xA;        for (int k = 0; k &lt; cRaw.Length; k++)&#xA;        {&#xA;            char ch = cRaw[k];&#xA;            if ((ch &gt;= '0' &amp;&amp; ch &lt;= '9') || ch == '.' || ch == ',' || ch == '-' || ch == '(' || ch == ')')&#xA;                cSb.Append(ch);&#xA;        }&#xA;        cRaw = cSb.ToString();&#xA;        if (cParen) cRaw = cRaw.Trim('(', ')');&#xA;        cRaw = cRaw.Replace(&quot;,&quot;, &quot;&quot;);&#xA;        decimal c = 0m;&#xA;        decimal.TryParse(cRaw,&#xA;            System.Globalization.NumberStyles.AllowLeadingSign | System.Globalization.NumberStyles.AllowDecimalPoint,&#xA;            System.Globalization.CultureInfo.InvariantCulture, out c);&#xA;        if (cParen) c = -System.Math.Abs(c);&#xA;&#xA;        // ---- Normalization rules ----&#xA;        // A) Debit negative &amp; Credit zero  -&gt; move abs(Debit) to Credit&#xA;        if (d &lt; 0m &amp;&amp; c == 0m)&#xA;        {&#xA;            row[debitCol]  = 0m;&#xA;            row[creditCol] = System.Math.Abs(d);&#xA;            movedToCredit++;&#xA;            continue;&#xA;        }&#xA;&#xA;        // B) Credit negative &amp; Debit zero -&gt; move abs(Credit) to Debit&#xA;        if (c &lt; 0m &amp;&amp; d == 0m)&#xA;        {&#xA;            row[creditCol] = 0m;&#xA;            row[debitCol]  = System.Math.Abs(c);&#xA;            movedToDebit++;&#xA;            continue;&#xA;        }&#xA;&#xA;        // C) Safety: force abs magnitudes on both sides&#xA;        decimal newD = System.Math.Abs(d);&#xA;        decimal newC =
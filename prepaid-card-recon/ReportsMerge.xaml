        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: PPAT classification CLEANUP =====&#xA;// Phase 1: GL-only PPAT classification (narration-based, NO late-post here)&#xA;// Phase 2: Cleanup any PPAT still with &quot;Unmatched manual entries&quot; (narration-based)&#xA;// Phase 3: FINAL OVERRIDE — Late posted (±2 days) applied LAST on ALL PPAT&#xA;//&#xA;// Args (In):     string reconDate&#xA;// Args (In/Out): DataTable dtGlStatement&#xA;&#xA;/////////////////////// Helpers ///////////////////////&#xA;void EnsureColumn(System.Data.DataTable dt, string name)&#xA;{&#xA;    if (!dt.Columns.Contains(name))&#xA;        dt.Columns.Add(new System.Data.DataColumn(name, typeof(string)) { DefaultValue = &quot;&quot; });&#xA;}&#xA;&#xA;// --- NEW: robust column name normalizer (handles spaces, NBSP, colons, case) ---&#xA;string NormalizeColName(string name)&#xA;{&#xA;    if (name == null) return &quot;&quot;;&#xA;    name = name.Replace('\u00A0', ' '); // NBSP -&gt; normal space&#xA;    name = name.Trim();&#xA;    name = name.ToUpperInvariant();&#xA;    // collapse multiple spaces&#xA;    name = System.Text.RegularExpressions.Regex.Replace(name, @&quot;\s+&quot;, &quot; &quot;);&#xA;    // drop colon&#xA;    name = name.Replace(&quot;:&quot;, &quot;&quot;);&#xA;    return name;&#xA;}&#xA;&#xA;string FindFirstExistingColumn(System.Data.DataTable dt, params string[] names)&#xA;{&#xA;    if (dt == null) return null;&#xA;&#xA;    // Build a normalized map of existing columns&#xA;    var map = new System.Collections.Generic.Dictionary&lt;string, string&gt;();&#xA;    foreach (System.Data.DataColumn c in dt.Columns)&#xA;    {&#xA;        var norm = NormalizeColName(c.ColumnName);&#xA;        if (!map.ContainsKey(norm))&#xA;            map[norm] = c.ColumnName; // keep real name&#xA;    }&#xA;&#xA;    foreach (var n in names)&#xA;    {&#xA;        if (string.IsNullOrEmpty(n)) continue;&#xA;        var normWanted = NormalizeColName(n);&#xA;        if (map.TryGetValue(normWanted, out var real))&#xA;            return real;&#xA;    }&#xA;&#xA;    return null;&#xA;}&#xA;&#xA;DateTime? ParseDateFlexible(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return null;&#xA;&#xA;    if (val is DateTime dt) return dt;&#xA;&#xA;    if (val is double d)&#xA;    {&#xA;        try { return DateTime.FromOADate(d); } catch { }&#xA;    }&#xA;&#xA;    if (double.TryParse(val.ToString(),&#xA;        System.Globalization.NumberStyles.Float,&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xA;        out var d2))&#xA;    {&#xA;        try { return DateTime.FromOADate(d2); } catch { }&#xA;    }&#xA;&#xA;    string s = val.ToString().Trim();&#xA;    string[] fmts = new[]&#xA;    {&#xA;        &quot;dd/MM/yyyy HH:mm:ss&quot;,&quot;dd/MM/yyyy HH:mm&quot;,&quot;dd/MM/yyyy&quot;,&#xA;        &quot;yyyy-MM-dd HH:mm:ss&quot;,&quot;yyyy-MM-dd&quot;,&quot;yyyy/MM/dd&quot;,&#xA;        &quot;dd-MMM-yyyy&quot;,&quot;d-MMM-yyyy&quot; // added for things like 02-Nov-2025&#xA;    };&#xA;&#xA;    if (DateTime.TryParseExact(s, fmts,&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xA;        System.Globalization.DateTimeStyles.None,&#xA;        out var exact))&#xA;        return exact;&#xA;&#xA;    if (DateTime.TryParse(s,&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xA;        System.Globalization.DateTimeStyles.None,&#xA;        out var any))&#xA;        return any;&#xA;&#xA;    return null;&#xA;}&#xA;&#xA;string U(string s) =&gt; (s ?? &quot;&quot;).Trim().ToUpperInvariant();&#xA;&#xA;string NormalizeSoft(string s)&#xA;{&#xA;    var x = U(s);&#xA;    x = System.Text.RegularExpressions.Regex.Replace(x, @&quot;[-_]+&quot;, &quot; &quot;);&#xA;    x = System.Text.RegularExpressions.Regex.Replace(x, @&quot;\s+&quot;, &quot; &quot;);&#xA;    return x;&#xA;}&#xA;&#xA;bool ContainsAny(string hay, params string[] needles)&#xA;{&#xA;    hay = NormalizeSoft(hay);&#xA;    foreach (var n in needles)&#xA;    {&#xA;        var nn = NormalizeSoft(n);&#xA;        if (hay.Contains(nn)) return true;&#xA;    }&#xA;    return false;&#xA;}&#xA;&#xA;// Detect GL default classification that we want to &quot;fix&quot; for PPAT rows&#xA;bool IsGlDefault(System.Data.DataRow row)&#xA;{&#xA;    string rc   = (row.Table.Columns.Contains(&quot;Root Cause&quot;)          ? row[&quot;Root Cause&quot;]          : null)?.ToString().Trim() ?? &quot;&quot;;&#xA;    string rcat = (row.Table.Columns.Contains(&quot;Root Cause Category&quot;) ? row[&quot;Root Cause Category&quot;] : null)?.ToString().Trim() ?? &quot;&quot;;&#xA;    string act  = (row.Table.Columns.Contains(&quot;Recommended Action&quot;)  ? row[&quot;Recommended Action&quot;]  : null)?.ToString().Trim() ?? &quot;&quot;;&#xA;    string own  = (row.Table.Columns.Contains(&quot;Action Owner&quot;)        ? row[&quot;Action Owner&quot;]        : null)?.ToString().Trim() ?? &quot;&quot;;&#xA;&#xA;    return rc.Equals(&quot;Unmatched manual entries&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;           rcat.Equals(&quot;System&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;           act.Equals(&quot;To be manually matched&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;           own.Equals(&quot;Card Reconciliation&quot;, StringComparison.OrdinalIgnoreCase);&#xA;}&#xA;&#xA;void ForcePpat(System.Data.DataRow row)&#xA;{&#xA;    if (row.Table.Columns.Contains(&quot;Classification&quot;))&#xA;        row[&quot;Classification&quot;] = &quot;PPAT&quot;;&#xA;}&#xA;&#xA;void SetPpatTemplate(System.Data.DataRow row)&#xA;{&#xA;    ForcePpat(row);&#xA;    row[&quot;Root Cause&quot;] = &quot;Unsuccessful ATM withdrawal transaction debited the GL&quot;;&#xA;    row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;    row[&quot;Recommended Action&quot;] = &quot;Follow up with respective branch to suspend the overages as per process&quot;;&#xA;    row[&quot;Action Owner&quot;] = &quot;ATM Reconciliation Team&quot;;&#xA;}&#xA;&#xA;void SetLatePosted(System.Data.DataRow row)&#xA;{&#xA;    ForcePpat(row);&#xA;    row[&quot;Root Cause&quot;] = &quot;Late posted transaction&quot;;&#xA;    row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;    row[&quot;Recommended Action&quot;] = &quot;Check if updates CMS on the following date&quot;;&#xA;    row[&quot;Action Owner&quot;] = &quot;Card Reconciliation&quot;;&#xA;}&#xA;&#xA;// Shared narration-based PPAT classification helper&#xA;void ClassifyPpatByNarration(System.Data.DataRow row)&#xA;{&#xA;    string narration = row.Table.Columns.Contains(&quot;Narration&quot;)&#xA;        ? (row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;)&#xA;        : &quot;&quot;;&#xA;&#xA;    // 1) Principal ATM withdrawal&#xA;    if (ContainsAny(narration,&#xA;        &quot;ATM WITHDRAWL PREPAID&quot;, &quot;ATM WITHDRAWAL PREPAID&quot;,&#xA;        &quot;ATM WITHDRAWL&quot;, &quot;ATM WITHDRAWAL&quot;))&#xA;    {&#xA;        SetPpatTemplate(row);&#xA;        return;&#xA;    }&#xA;&#xA;    // 2) Government levy&#xA;    if (ContainsAny(narration, &quot;GOVERNMENT LEVY&quot;, &quot; LEVY&quot;))&#xA;    {&#xA;        ForcePpat(row);&#xA;        row[&quot;Root Cause&quot;] = &quot;Government levy on unsuccessful ATM withdrawal transactions&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Reverse the levy&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;        return;&#xA;    }&#xA;&#xA;    // 3) Charges / fees / VAT&#xA;    if (ContainsAny(narration,&#xA;        &quot;CASH WITHDRAW CHARGE&quot;, &quot;CASH WITHDRAWAL CHARGE&quot;,&#xA;        &quot;CASH WITHDRAWAL TRANSACTION FEE&quot;, &quot;TRANSACTION FEE&quot;,&#xA;        &quot;VAT PAYABLE ON COMM AND FEES&quot;, &quot;VAT PAYABLE&quot;, &quot;VAT&quot;))&#xA;    {&#xA;        ForcePpat(row);&#xA;        row[&quot;Root Cause&quot;] = &quot;Cash withdrawal charges on unsuccessful ATM withdrawal transactions&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Reverse the charge&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;        return;&#xA;    }&#xA;&#xA;    // 4) Fallback PPAT default&#xA;    SetPpatTemplate(row);&#xA;}&#xA;&#xA;/////////////////////// Setup ///////////////////////&#xA;if (dtGlStatement == null)&#xA;    throw new ArgumentNullException(nameof(dtGlStatement));&#xA;&#xA;EnsureColumn(dtGlStatement, &quot;Classification&quot;);&#xA;EnsureColumn(dtGlStatement, &quot;Root Cause&quot;);&#xA;EnsureColumn(dtGlStatement, &quot;Root Cause Category&quot;);&#xA;EnsureColumn(dtGlStatement, &quot;Recommended Action&quot;);&#xA;EnsureColumn(dtGlStatement, &quot;Action Owner&quot;);&#xA;&#xA;// Using the NEW robust FindFirstExistingColumn&#xA;string txnRefCol = FindFirstExistingColumn(&#xA;    dtGlStatement,&#xA;    &quot;Transaction Ref No:&quot;, &quot;Transaction Ref No&quot;, &quot;Transaction Reference No&quot;,&#xA;    &quot;Transaction Reference Number&quot;, &quot;Txn Ref No&quot;&#xA;);&#xA;&#xA;string valueDateCol = FindFirstExistingColumn(&#xA;    dtGlStatement,&#xA;    &quot;Value Date&quot;, &quot;ValueDate&quot;&#xA;);&#xA;&#xA;// reconDate used for late-posted rule (final pass)&#xA;DateTime? reconDateParsed = ParseDateFlexible(reconDate);&#xA;&#xA;// Counters for logging&#xA;int totalRows              = dtGlStatement.Rows.Count;&#xA;int totalGlRows            = 0;&#xA;int totalGlPpatRows        = 0;&#xA;&#xA;int setNarrPrincipal_GL    = 0;&#xA;int setNarrLevy_GL         = 0;&#xA;int setNarrFee_GL          = 0;&#xA;int setTxnRefOnly_GL       = 0;&#xA;&#xA;int skippedNonPPAT_GL      = 0;&#xA;int skippedNonGL           = 0;&#xA;int fixedFromGlDefault     = 0;&#xA;&#xA;int forcedNarrOverride     = 0;  // Phase 2&#xA;int finalLateOverrides     = 0;  // Phase 3&#xA;&#xA;/////////////////////// PHASE 1: GL-only PPAT classification (NO late-post here) ///////////////////////&#xA;foreach (System.Data.DataRow row in dtGlStatement.Rows)&#xA;{&#xA;    // Must be GL for phase 1&#xA;    string source = dtGlStatement.Columns.Contains(&quot;Source&quot;)&#xA;        ? (row[&quot;Source&quot;]?.ToString() ?? &quot;&quot;)&#xA;        : &quot;&quot;;&#xA;&#xA;    if (!source.Equals(&quot;GL&quot;, StringComparison.OrdinalIgnoreCase))&#xA;    {&#xA;        skippedNonGL++;&#xA;        continue;&#xA;    }&#xA;&#xA;    totalGlRows++;&#xA;&#xA;    // TxnRef must contain PPAT&#xA;    string txnRef = (!string.IsNullOrEmpty(txnRefCol) &amp;&amp;&#xA;                     dtGlStatement.Columns.Contains(txnRefCol))&#xA;                    ? (row[txnRefCol]?.ToString() ?? &quot;&quot;)&#xA;                    : &quot;&quot;;&#xA;&#xA;    bool txnHasPPAT =&#xA;        !string.IsNullOrWhiteSpace(txnRef) &amp;&amp;&#xA;        (txnRef.IndexOf(&quot;PPAT&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0 || txnRef.IndexOf(&quot;AWPC&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0);&#xA;&#xA;    if (!txnHasPPAT)&#xA;    {&#xA;        skippedNonPPAT_GL++;&#xA;        continue;&#xA;    }&#xA;&#xA;    totalGlPpatRows++;&#xA;&#xA;    // We may overwrite GL default; track that&#xA;    bool wasGlDefault = IsGlDefault(row);&#xA;&#xA;    // Narration bucketing (GL-only phase)&#xA;    string narration = dtGlStatement.Columns.Contains(&quot;Narration&quot;)&#xA;        ? (row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;)&#xA;        : &quot;&quot;;&#xA;&#xA;    // 1) Principal ATM withdrawal&#xA;    if (ContainsAny(narration,&#xA;        &quot;ATM WITHDRAWL PREPAID&quot;, &quot;ATM WITHDRAWAL PREPAID&quot;,&#xA;        &quot;ATM WITHDRAWL&quot;, &quot;ATM WITHDRAWAL&quot;))&#xA;    {&#xA;        if (wasGlDefault) fixedFromGlDefault++;&#xA;        SetPpatTemplate(row);&#xA;        setNarrPrincipal_GL++;&#xA;        continue;&#xA;    }&#xA;&#xA;    // 2) Government levy&#xA;    if (ContainsAny(narration, &quot;GOVERNMENT LEVY&quot;, &quot; LEVY&quot;))&#xA;    {&#xA;        if (wasGlDefault) fixedFromGlDefault++;&#xA;        ForcePpat(row);&#xA;        row[&quot;Root Cause&quot;] = &quot;Government levy on unsuccessful ATM withdrawal transactions&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Reverse the levy&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;        setNarrLevy_GL++;&#xA;        continue;&#xA;    }&#xA;&#xA;    // 3) Charges / fees / VAT&#xA;    if (ContainsAny(narration,&#xA;        &quot;CASH WITHDRAW CHARGE&quot;, &quot;CASH WITHDRAWAL CHARGE&quot;,&#xA;        &quot;CASH WITHDRAWAL TRANSACTION FEE&quot;, &quot;TRANSACTION FEE&quot;,&#xA;        &quot;VAT PAYABLE ON COMM AND FEES&quot;, &quot;VAT PAYABLE&quot;, &quot;VAT&quot;))&#xA;    {&#xA;        if (wasGlDefault) fixedFromGlDefault++;&#xA;        ForcePpat(row);&#xA;        row[&quot;Root Cause&quot;] = &quot;Cash withdrawal charges on unsuccessful ATM withdrawal transactions&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Reverse the charge&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;        setNarrFee_GL++;&#xA;        continue;&#xA;    }&#xA;&#xA;    // 4) Fallback PPAT default (GL)&#xA;    if (wasGlDefault) fixedFromGlDefault++;&#xA;    SetPpatTemplate(row);&#xA;    setTxnRefOnly_GL++;&#xA;}&#xA;&#xA;/////////////////////// PHASE 2: Cleanup any PPAT still = &quot;Unmatched manual entries&quot; ///////////////////////&#xA;// Use narration-based PPAT classification for these.&#xA;if (!string.IsNullOrEmpty(txnRefCol) &amp;&amp;&#xA;    dtGlStatement.Columns.Contains(txnRefCol))&#xA;{&#xA;    foreach (System.Data.DataRow row in dtGlStatement.Rows)&#xA;    {&#xA;        string txnRef = row[txnRefCol]?.ToString() ?? &quot;&quot;;&#xA;        if (string.IsNullOrWhiteSpace(txnRef) ||&#xA;            (txnRef.IndexOf(&quot;PPAT&quot;, StringComparison.OrdinalIgnoreCase) &lt; 0 &amp;&amp; txnRef.IndexOf(&quot;AWPC&quot;, StringComparison.OrdinalIgnoreCase) &lt; 0))&#xA;            continue;&#xA;&#xA;        string rcNow = row.Table.Columns.Contains(&quot;Root Cause&quot;)&#xA;            ? (row[&quot;Root Cause&quot;]?.ToString() ?? &quot;&quot;)&#xA;            : &quot;&quot;;&#xA;&#xA;        // --- NEW: tolerant check for &quot;Unmatched manual entries&quot; (trims, NBSP, extra spaces) ---&#xA;        string rcNorm = NormalizeSoft(rcNow);&#xA;        if (!rcNorm.Contains(&quot;UNMATCHED MANUAL ENTRIES&quot;))&#xA;            continue;&#xA;&#xA;        // Override old GL default using narration-based PPAT classification.&#xA;        ClassifyPpatByNarration(row);&#xA;        forcedNarrOverride++;&#xA;    }&#xA;}&#xA;&#xA;/////////////////////// PHASE 3: FINAL LATE-POSTED OVERRIDE (applies LAST on ALL PPAT) ///////////////////////&#xA;// If any PPAT row (any Source) is within ±2 days of reconDate (or ValueDate = null),&#xA;// it will be marked as &quot;Late posted transaction&quot;, overriding any existing PPAT classification.&#xA;if (reconDateParsed != null &amp;&amp;&#xA;    !string.IsNullOrEmpty(txnRefCol) &amp;&amp;&#xA;    dtGlStatement.Columns.Contains(txnRefCol) &amp;&amp;&#xA;    !string.IsNullOrEmpty(valueDateCol) &amp;&amp;&#xA;    dtGlStatement.Columns.Contains(valueDateCol))&#xA;{&#xA;    DateTime startRange = reconDateParsed.Value.AddDays(-2);&#xA;    DateTime endRange   = reconDateParsed.Value.AddDays(+2);&#xA;&#xA;    foreach (System.Data.DataRow row in dtGlStatement.Rows)&#xA;    {&#xA;        string txnRef = row[txnRefCol]?.ToString() ?? &quot;&quot;;&#xA;        if (string.IsNullOrWhiteSpace(txnRef) ||&#xA;            (txnRef.IndexOf(&quot;PPAT&quot;, StringComparison.OrdinalIgnoreCase) &lt; 0 &amp;&amp; txnRef.IndexOf(&quot;AWPC&quot;, StringComparison.OrdinalIgnoreCase) &lt; 0))&#xA;            continue;&#xA;&#xA;        DateTime? vDate = ParseDateFlexible(row[valueDateCol]);&#xA;&#xA;        bool isLate;&#xA;&#xA;        if (vDate == null)&#xA;        {&#xA;            // Business rule: treat NULL ValueDate as late&#xA;            isLate = true;&#xA;        }&#xA;        else&#xA;        {&#xA;            var d = vDate.Value.Date;&#xA;            isLate = (d &gt;= startRange.Date &amp;&amp; d &lt;= endRange.Date);&#xA;        }&#xA;&#xA;        if (!isLate)&#xA;            continue;&#xA;&#xA;        // FINAL override: Late posted MUST be the last to apply on all PPAT&#xA;        SetLatePosted(row);&#xA;        finalLateOverrides++;&#xA;    }&#xA;}&#xA;&#xA;// Summary diagnostics&#xA;System.Console.WriteLine(&#xA;    &quot;PPAT CLEANUP SUMMARY: &quot; +&#xA;    $&quot;TotalRows={totalRows}, &quot; +&#xA;    $&quot;TotalGL={totalGlRows}, &quot; +&#xA;    $&quot;TotalGL_PPAT={totalGlPpatRows}, &quot; +&#xA;    $&quot;GL_Principal={setNarrPrincipal_GL}, &quot; +&#xA;    $&quot;GL_Levy={setNarrLevy_GL}, &quot; +&#xA;    $&quot;GL_Fee={setNarrFee_GL}, &quot; +&#xA;    $&quot;GL_DefaultPPAT={setTxnRefOnly_GL}, &quot; +&#xA;    $&quot;ForcedNarrOverride_Unmatched={forcedNarrOverride}, &quot; +&#xA;    $&quot;FinalLateOverrides_ALL_PPAT={finalLateOverrides}, &quot; +&#xA;    $&quot;FixedFromGLDefault={fixedFromGlDefault}, &quot; +&#xA;    $&quot;SkippedNonPPAT_GL={skippedNonPPAT_GL}, &quot; +&#xA;    $&quot;SkippedNonGL={skippedNonGL}&quot;);&#xA;" DisplayName="PPAT SAFE GUARD" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_103" Language="CSharp">

            <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: FINAL INCOME OVERRIDE FOR dtTransactionReport ====&#xA;// In/Out: DataTable dtTransactionReport&#xA;&#xA;if (dtTransactionReport == null)&#xA;    throw new ArgumentNullException(nameof(dtTransactionReport));&#xA;&#xA;// Ensure required target columns exist&#xA;string[] needCols = new[]&#xA;{&#xA;    &quot;Root Cause&quot;,&#xA;    &quot;Root Cause Category&quot;,&#xA;    &quot;Recommended Action&quot;,&#xA;    &quot;Action Owner&quot;&#xA;};&#xA;&#xA;foreach (string c in needCols)&#xA;{&#xA;    if (!dtTransactionReport.Columns.Contains(c))&#xA;        dtTransactionReport.Columns.Add(c, typeof(string));&#xA;}&#xA;&#xA;// Helper to normalize narration&#xA;string Norm(string s) =&gt;&#xA;    string.IsNullOrWhiteSpace(s)&#xA;        ? &quot;&quot;&#xA;        : System.Text.RegularExpressions.Regex.Replace(&#xA;              s.Trim().ToLowerInvariant(), @&quot;\s+&quot;, &quot; &quot;);&#xA;&#xA;// STRICT heads that narration should start with&#xA;string[] incomeHeads = new[]&#xA;{&#xA;    &quot;cash withdrawal transaction fee&quot;,&#xA;    &quot;purchase/auth completion transaction fee&quot;,&#xA;    &quot;balance inquiry transaction fee&quot;&#xA;};&#xA;&#xA;// GENERAL income-related keywords (contained anywhere)&#xA;string[] incomeKeywords = new[]&#xA;{&#xA;    &quot;income&quot;,&#xA;    &quot;fee&quot;,&#xA;    &quot;fees&quot;,&#xA;    &quot;levy&quot;&#xA;};&#xA;&#xA;// Target values&#xA;const string RC   = &quot;Prepaid Card Income updated on CMS only&quot;;&#xA;const string RCAT = &quot;System&quot;;&#xA;const string ACT  = &quot;Post the income manually&quot;;&#xA;const string OWN  = &quot;Card Finance&quot;;&#xA;&#xA;int overridden = 0;&#xA;&#xA;foreach (System.Data.DataRow row in dtTransactionReport.Rows)&#xA;{&#xA;    string narr = dtTransactionReport.Columns.Contains(&quot;Transaction Type&quot;)&#xA;        ? (row[&quot;Transaction Type&quot;] == null ? &quot;&quot; : row[&quot;Transaction Type&quot;].ToString())&#xA;        : &quot;&quot;;&#xA;&#xA;    string normNarr = Norm(narr);&#xA;    if (string.IsNullOrEmpty(normNarr))&#xA;        continue;&#xA;&#xA;    bool match = false;&#xA;&#xA;    // STRICT HEAD MATCH&#xA;    foreach (var head in incomeHeads)&#xA;    {&#xA;        if (normNarr.StartsWith(head))&#xA;        {&#xA;            match = true;&#xA;            break;&#xA;        }&#xA;    }&#xA;&#xA;    // GENERAL KEYWORD MATCH&#xA;    if (!match)&#xA;    {&#xA;        foreach (var kw in incomeKeywords)&#xA;        {&#xA;            if (normNarr.Contains(kw))&#xA;            {&#xA;                match = true;&#xA;                break;&#xA;            }&#xA;        }&#xA;    }&#xA;&#xA;    if (!match)&#xA;        continue;&#xA;&#xA;    // APPLY override&#xA;    row[&quot;Root Cause&quot;]          = RC;&#xA;    row[&quot;Root Cause Category&quot;] = RCAT;&#xA;    row[&quot;Recommended Action&quot;]  = ACT;&#xA;    row[&quot;Action Owner&quot;]        = OWN;&#xA;&#xA;    overridden++;&#xA;}&#xA;&#xA;// (NO LOGGING)&#xA;" DisplayName="income" sap:VirtualizedContainerService.HintSize="477.3333333333333,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_101" Language="CSharp">

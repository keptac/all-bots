      <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: FINAL OVERRIDE FOR PREPAID INCOME FEES (CMS only) ====&#xA;// In/Out: DataTable dtHistoricalReconTransactionsReport&#xA;&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport));&#xA;&#xA;// Helper to normalize narration&#xA;string Norm(string s) =&gt;&#xA;    string.IsNullOrWhiteSpace(s)&#xA;        ? &quot;&quot;&#xA;        : System.Text.RegularExpressions.Regex.Replace(&#xA;              s.Trim().ToLowerInvariant(), @&quot;\s+&quot;, &quot; &quot;);&#xA;&#xA;// STRICT heads that must start with:&#xA;string[] incomeHeads = new[]&#xA;{&#xA;    &quot;cash withdrawal transaction fee&quot;,&#xA;    &quot;purchase/auth completion transaction fee&quot;,&#xA;    &quot;balance inquiry transaction fee&quot;&#xA;};&#xA;&#xA;// GENERAL income keywords (contained anywhere)&#xA;string[] incomeKeywords = new[]&#xA;{&#xA;    &quot;income&quot;,&#xA;    &quot;fee&quot;,&#xA;    &quot;fees&quot;,&#xA;    &quot;levy&quot;&#xA;};&#xA;&#xA;// Target values&#xA;const string RC   = &quot;Prepaid Card Income updated on CMS only&quot;;&#xA;const string RCAT = &quot;System&quot;;&#xA;const string ACT  = &quot;Post the income manually&quot;;&#xA;const string OWN  = &quot;Card Finance&quot;;&#xA;&#xA;int overridden = 0;&#xA;&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    // Apply only to CMS&#xA;    string src = row[&quot;Source&quot;] == null ? &quot;&quot; : row[&quot;Source&quot;].ToString().Trim().ToUpperInvariant();&#xA;    if (src != &quot;CMS&quot;)&#xA;        continue;&#xA;&#xA;    string narr = row[&quot;Narration&quot;] == null ? &quot;&quot; : row[&quot;Narration&quot;].ToString();&#xA;    string normNarr = Norm(narr);&#xA;    if (string.IsNullOrEmpty(normNarr))&#xA;        continue;&#xA;&#xA;    bool match = false;&#xA;&#xA;    // 1️⃣ STRICT HEADS — narration must start with:&#xA;    foreach (var head in incomeHeads)&#xA;    {&#xA;        if (normNarr.StartsWith(head))&#xA;        {&#xA;            match = true;&#xA;            break;&#xA;        }&#xA;    }&#xA;&#xA;    // 2️⃣ GENERAL INCOME KEYWORDS — anywhere in narration&#xA;    if (!match)&#xA;    {&#xA;        foreach (var kw in incomeKeywords)&#xA;        {&#xA;            if (normNarr.Contains(kw))&#xA;            {&#xA;                match = true;&#xA;                break;&#xA;            }&#xA;        }&#xA;    }&#xA;&#xA;    if (!match)&#xA;        continue;&#xA;&#xA;    // Apply override&#xA;    row[&quot;Root Cause&quot;]          = RC;&#xA;    row[&quot;Root Cause Category&quot;] = RCAT;&#xA;    row[&quot;Recommended Action&quot;]  = ACT;&#xA;    row[&quot;Action Owner&quot;]        = OWN;&#xA;    overridden++;&#xA;}&#xA;&#xA;// SUMMARY ONLY&#xA;System.Console.WriteLine($&quot;[INCOME OVERRIDE FINAL] CMS rows overridden: {overridden}&quot;);&#xA;" DisplayName="Income, fees, levy and Channel == API" sap:VirtualizedContainerService.HintSize="1169.3333333333333,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_100" Language="CSharp">

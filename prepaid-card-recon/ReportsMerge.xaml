        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: UTLP Root Cause Only (No PAN, No RRN, No Logging) ====&#xA;// In/Out: System.Data.DataTable dtGlStatement&#xA;&#xA;if (dtGlStatement == null)&#xA;    throw new ArgumentNullException(nameof(dtGlStatement));&#xA;&#xA;var t = dtGlStatement;&#xA;&#xA;// --------------------------------------------------------------&#xA;// Ensure required columns exist&#xA;// --------------------------------------------------------------&#xA;string[] cols =&#xA;{&#xA;    &quot;Root Cause&quot;,&#xA;    &quot;Root Cause Category&quot;,&#xA;    &quot;Recommended Action&quot;,&#xA;    &quot;Action Owner&quot;,&#xA;    &quot;ROOT_CAUSE_PROCESSED&quot;&#xA;};&#xA;&#xA;foreach (string c in cols)&#xA;    if (!t.Columns.Contains(c))&#xA;        t.Columns.Add(c, typeof(string));&#xA;&#xA;// --------------------------------------------------------------&#xA;// Determine reference column&#xA;// --------------------------------------------------------------&#xA;string refCol =&#xA;    t.Columns.Contains(&quot;Transaction Ref No:&quot;) ? &quot;Transaction Ref No:&quot; :&#xA;    t.Columns.Contains(&quot;Transaction Ref No&quot;)  ? &quot;Transaction Ref No&quot;  :&#xA;    null;&#xA;&#xA;// --------------------------------------------------------------&#xA;// Apply UTLP rule (NO RRN, NO PAN)&#xA;// --------------------------------------------------------------&#xA;foreach (System.Data.DataRow row in t.Rows)&#xA;{&#xA;    if (refCol == null || row[refCol] == DBNull.Value)&#xA;        continue;&#xA;&#xA;    string tr = row[refCol].ToString().ToUpperInvariant();&#xA;&#xA;    // ---- UTLP detection ----&#xA;    if (!tr.Contains(&quot;UTLP&quot;))&#xA;        continue;&#xA;&#xA;    // ---- Apply fixed UTLP root cause ----&#xA;    row[&quot;Root Cause&quot;]           = &quot;Entries not yet established&quot;;&#xA;    row[&quot;Root Cause Category&quot;]  = &quot;People&quot;;&#xA;    row[&quot;Recommended Action&quot;]   = &quot;To advise&quot;;&#xA;    row[&quot;Action Owner&quot;]         = &quot;ICT&quot;;&#xA;    row[&quot;ROOT_CAUSE_PROCESSED&quot;] = &quot;TRUE&quot;;&#xA;}&#xA;" DisplayName="UTLP" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_102" Language="CSharp">

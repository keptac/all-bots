              <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: Merge + Enrich (strict 12-alnum RRN; PAN mask normalization; LINQ-free) ====&#xA;// Args (In): string reconCurrency&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport, DataTable dtGlStatement, DataTable dtTransactionReport, DataTable dtPostilionTxn&#xA;&#xA;// ---------------------------&#xA;// Basic helpers&#xA;// ---------------------------&#xA;DateTime? ParseDate_Fallback(object obj)&#xA;{&#xA;    if (obj == null || obj == DBNull.Value) return null;&#xA;    var s = obj.ToString().Trim();&#xA;    if (string.IsNullOrEmpty(s)) return null;&#xA;    DateTime any;&#xA;    return DateTime.TryParse(s, out any) ? (DateTime?)any : null;&#xA;}&#xA;&#xA;decimal SafeParseAmount(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return 0m;&#xA;    string s = val.ToString().Trim();&#xA;    if (string.IsNullOrEmpty(s)) return 0m;&#xA;    bool neg = s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;);&#xA;    s = s.Replace(&quot;(&quot;, &quot;&quot;).Replace(&quot;)&quot;, &quot;&quot;).Replace(&quot;,&quot;, &quot;&quot;);&#xA;    decimal d;&#xA;    if (!decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out d))&#xA;        decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.CurrentCulture, out d);&#xA;    return neg ? -Math.Abs(d) : d;&#xA;}&#xA;&#xA;string SafeStr(object v) { return v == null || v == DBNull.Value ? string.Empty : v.ToString().Trim(); }&#xA;&#xA;void EnsureColumns(DataTable dt, string[] cols, string currency)&#xA;{&#xA;    for (int i = 0; i &lt; cols.Length; i++)&#xA;    {&#xA;        string col = cols[i];&#xA;        if (!dt.Columns.Contains(col))&#xA;        {&#xA;            Type type =&#xA;                (col.IndexOf(&quot;Date&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0) ? typeof(DateTime) :&#xA;                (col == (&quot;Debit (&quot; + currency + &quot;)&quot;) || col == (&quot;Credit (&quot; + currency + &quot;)&quot;)) ? typeof(decimal) :&#xA;                (col == &quot;FOREIGN_CURRENCY&quot;) ? typeof(bool) :&#xA;                typeof(string);&#xA;            dt.Columns.Add(col, type);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// ---------------------------&#xA;// Masked PAN normalization (BIN + XXXXXX + last4)&#xA;// ---------------------------&#xA;string NormalizeMaskedPan(string raw)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(raw)) return string.Empty;&#xA;    var m = System.Text.RegularExpressions.Regex.Match(&#xA;        raw, @&quot;\b(?&lt;bin&gt;\d{6})\D{4,10}(?&lt;last4&gt;\d{4})\b&quot;);&#xA;    if (m.Success) return m.Groups[&quot;bin&quot;].Value + &quot;XXXXXX&quot; + m.Groups[&quot;last4&quot;].Value;&#xA;&#xA;    var m2 = System.Text.RegularExpressions.Regex.Match(&#xA;        raw, @&quot;\b(?&lt;bin&gt;\d{6})[Xx]{6}(?&lt;last4&gt;\d{4})\b&quot;);&#xA;    if (m2.Success) return m2.Groups[&quot;bin&quot;].Value + &quot;XXXXXX&quot; + m2.Groups[&quot;last4&quot;].Value;&#xA;&#xA;    return string.Empty;&#xA;}&#xA;&#xA;string NormalizeMaskedPansInText(string text)&#xA;{&#xA;    if (string.IsNullOrEmpty(text)) return text;&#xA;    string replaced = System.Text.RegularExpressions.Regex.Replace(&#xA;        text, @&quot;\b(?&lt;bin&gt;\d{6})\D{4,10}(?&lt;last4&gt;\d{4})\b&quot;,&#xA;        m =&gt; m.Groups[&quot;bin&quot;].Value + &quot;XXXXXX&quot; + m.Groups[&quot;last4&quot;].Value);&#xA;    replaced = System.Text.RegularExpressions.Regex.Replace(&#xA;        replaced, @&quot;\b(?&lt;bin&gt;\d{6})[Xx]{6}(?&lt;last4&gt;\d{4})\b&quot;,&#xA;        m =&gt; m.Groups[&quot;bin&quot;].Value + &quot;XXXXXX&quot; + m.Groups[&quot;last4&quot;].Value);&#xA;    return replaced;&#xA;}&#xA;&#xA;// ---------------------------&#xA;// RRN helpers (STRICT 12-ALPHANUMERIC; prefer rightmost hyphen-delimited; prefer all-digits)&#xA;// ---------------------------&#xA;string CanonicalizeRRN_AlnumLast12(string raw)&#xA;{&#xA;    string s0 = SafeStr(raw);&#xA;    if (string.IsNullOrEmpty(s0)) return string.Empty;&#xA;    System.Text.StringBuilder alnum = new System.Text.StringBuilder(s0.Length);&#xA;    for (int i = 0; i &lt; s0.Length; i++)&#xA;    {&#xA;        char ch = s0[i];&#xA;        if ((ch &gt;= '0' &amp;&amp; ch &lt;= '9') || (ch &gt;= 'A' &amp;&amp; ch &lt;= 'Z') || (ch &gt;= 'a' &amp;&amp; ch &lt;= 'z'))&#xA;            alnum.Append(char.ToUpperInvariant(ch));&#xA;    }&#xA;    string s = alnum.ToString();&#xA;    if (s.Length &gt;= 12) return s.Substring(s.Length - 12, 12);&#xA;    return s.PadLeft(12, '0');&#xA;}&#xA;&#xA;string KeepLast12AlnumOrEmpty(string raw)&#xA;{&#xA;    string s = CanonicalizeRRN_AlnumLast12(raw);&#xA;    return s.Length == 12 ? s : string.Empty;&#xA;}&#xA;&#xA;// Rightmost hyphen-delimited 12-alnum; else rightmost 12-alnum token; else rightmost long-run last-12.&#xA;// Prefer a 12-digit match over mixed-alnum when both exist at the same position.&#xA;string ExtractRrnFromNarr_Smart(string narrationRaw)&#xA;{&#xA;    string narration = SafeStr(narrationRaw);&#xA;    if (narration.Length == 0) return &quot;&quot;;&#xA;&#xA;    var hy = System.Text.RegularExpressions.Regex.Matches(narration, @&quot;(?&lt;=-)[A-Za-z0-9]{12}(?=-)&quot;);&#xA;    if (hy.Count &gt; 0)&#xA;    {&#xA;        for (int i = hy.Count - 1; i &gt;= 0; i--)&#xA;        {&#xA;            var v = hy[i].Value.ToUpperInvariant();&#xA;            if (System.Text.RegularExpressions.Regex.IsMatch(v, @&quot;^\d{12}$&quot;)) return v;&#xA;        }&#xA;        return hy[hy.Count - 1].Value.ToUpperInvariant();&#xA;    }&#xA;&#xA;    var tok = System.Text.RegularExpressions.Regex.Matches(narration, @&quot;\b([A-Za-z0-9]{12})\b&quot;);&#xA;    if (tok.Count &gt; 0)&#xA;    {&#xA;        for (int i = tok.Count - 1; i &gt;= 0; i--)&#xA;        {&#xA;            var v = tok[i].Groups[1].Value.ToUpperInvariant();&#xA;            if (System.Text.RegularExpressions.Regex.IsMatch(v, @&quot;^\d{12}$&quot;)) return v;&#xA;        }&#xA;        return tok[tok.Count - 1].Groups[1].Value.ToUpperInvariant();&#xA;    }&#xA;&#xA;    var run = System.Text.RegularExpressions.Regex.Matches(narration, @&quot;[A-Za-z0-9]{12,}&quot;);&#xA;    if (run.Count &gt; 0)&#xA;    {&#xA;        string last = run[run.Count - 1].Value.ToUpperInvariant();&#xA;        var digs = System.Text.RegularExpressions.Regex.Matches(last, @&quot;\d{12}&quot;);&#xA;        if (digs.Count &gt; 0) return digs[digs.Count - 1].Value;&#xA;        return last.Substring(last.Length - 12, 12);&#xA;    }&#xA;    return &quot;&quot;;&#xA;}&#xA;&#xA;string GetPostilionRRN(DataRow r)&#xA;{&#xA;    if (r.Table.Columns.Contains(&quot;FIELD37&quot;))&#xA;    {&#xA;        string from37 = KeepLast12AlnumOrEmpty(SafeStr(r[&quot;FIELD37&quot;]));&#xA;        if (!string.IsNullOrEmpty(from37)) return from37;&#xA;    }&#xA;    if (r.Table.Columns.Contains(&quot;RRN&quot;))&#xA;    {&#xA;        string fromRrn = KeepLast12AlnumOrEmpty(SafeStr(r[&quot;RRN&quot;]));&#xA;        if (!string.IsNullOrEmpty(fromRrn)) return fromRrn;&#xA;    }&#xA;    return &quot;000000000000&quot;;&#xA;}&#xA;&#xA;// ---------------------------&#xA;// Required columns&#xA;// ---------------------------&#xA;string[] baseCols = new string[] {&#xA;    &quot;SNO&quot;,&quot;Branch code&quot;,&quot;GL_Code&quot;,&quot;GL Description&quot;,&#xA;    &quot;Booking Date&quot;,&quot;Value Date&quot;,&quot;Transaction Ref No:&quot;,&#xA;    &quot;C_PAN&quot;,&quot;RRN&quot;,&quot;STAN&quot;,&quot;FLEXREF&quot;,&quot;Narration&quot;,&#xA;    &quot;Source&quot;,&quot;Type&quot;,&quot;Root Cause&quot;,&quot;Root Cause Category&quot;,&#xA;    &quot;Recommended Action&quot;,&quot;Action Owner&quot;,&quot;Aging&quot;,&quot;Aging Group&quot;,&#xA;    &quot;BOT Classification&quot;,&quot;AUTH&quot;,&quot;Transaction Type&quot;,&quot;Transaction Date&quot;,&#xA;    &quot;Billing Amount&quot;,&quot;Device Number&quot;,&quot;ARN&quot;,&quot;Channel&quot;,&quot;Classification&quot;,&#xA;    &quot;FOREIGN_CURRENCY&quot;,&quot;Billing Currency&quot;,&quot;Transaction Currency&quot;,&quot;Transaction Amount&quot;,&#xA;    &quot;Settlement Currency&quot;,&quot;Settlement Amount&quot;&#xA;};&#xA;string debitCol = &quot;Debit (&quot; + reconCurrency + &quot;)&quot;;&#xA;string creditCol = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xA;string[] addCols = new string[] { debitCol, creditCol };&#xA;string[] histCols = new string[baseCols.Length + addCols.Length];&#xA;for (int i = 0; i &lt; baseCols.Length; i++) histCols[i] = baseCols[i];&#xA;for (int i = 0; i &lt; addCols.Length; i++) histCols[baseCols.Length + i] = addCols[i];&#xA;&#xA;EnsureColumns(dtHistoricalReconTransactionsReport, histCols, reconCurrency);&#xA;EnsureColumns(dtGlStatement,                     histCols, reconCurrency);&#xA;EnsureColumns(dtTransactionReport,               histCols, reconCurrency);&#xA;EnsureColumns(dtPostilionTxn,                    histCols, reconCurrency);&#xA;&#xA;// ---------------------------&#xA;// Strict date formats&#xA;// ---------------------------&#xA;string[] GL_DATE_FORMATS = new string[] {&#xA;    &quot;M/d/yyyy HH:mm:ss&quot;,&quot;MM/dd/yyyy HH:mm:ss&quot;,&quot;M/d/yyyy HH:mm&quot;,&quot;MM/dd/yyyy HH:mm&quot;,&#xA;    &quot;M/d/yyyy&quot;,&quot;MM/dd/yyyy&quot;,&quot;M/d/yy&quot;,&quot;MM/dd/yy&quot;&#xA;};&#xA;string[] CMS_DATE_FORMATS = new string[] {&#xA;    &quot;dd-MMM-yyyy HH:mm:ss&quot;,&quot;dd-MMM-yyyy HH:mm&quot;,&quot;dd-MMM-yyyy&quot;,&quot;d-MMM-yyyy&quot;,&#xA;    &quot;yyyy-MM-dd HH:mm:ss&quot;,&quot;yyyy-MM-dd HH:mm&quot;,&quot;yyyy-MM-dd&quot;,&#xA;    &quot;dd/MM/yyyy HH:mm:ss&quot;,&quot;dd/MM/yyyy HH:mm&quot;,&quot;dd/MM/yyyy&quot;,&#xA;    &quot;d/M/yyyy HH:mm:ss&quot;,&quot;d/M/yyyy HH:mm&quot;,&quot;d/M/yyyy&quot;,&quot;dd-MMM-yy&quot;&#xA;};&#xA;string[] extraHist = new string[] { &quot;yyyy-MMM-dd&quot;,&quot;M/d/yy&quot;,&quot;MM/dd/yy&quot; };&#xA;&#xA;string[] MergeUnique(string[][] lists)&#xA;{&#xA;    var set = new System.Collections.Generic.HashSet&lt;string&gt;(StringComparer.Ordinal);&#xA;    var res = new System.Collections.Generic.List&lt;string&gt;();&#xA;    for (int i = 0; i &lt; lists.Length; i++)&#xA;        for (int j = 0; j &lt; lists[i].Length; j++)&#xA;            if (set.Add(lists[i][j])) res.Add(lists[i][j]);&#xA;    return res.ToArray();&#xA;}&#xA;string[] HIST_DATE_FORMATS = MergeUnique(new string[][] { GL_DATE_FORMATS, CMS_DATE_FORMATS, extraHist });&#xA;&#xA;DateTime? ParseDate_Exact(object obj, string[] formats)&#xA;{&#xA;    if (obj == null || obj == DBNull.Value) return null;&#xA;    string s = obj.ToString().Trim();&#xA;    if (string.IsNullOrEmpty(s)) return null;&#xA;    DateTime dt;&#xA;    if (DateTime.TryParseExact(s, formats, System.Globalization.CultureInfo.InvariantCulture,&#xA;        System.Globalization.DateTimeStyles.None, out dt)) return dt;&#xA;    return null;&#xA;}&#xA;&#xA;void CoerceToDateTime(DataTable dt, string colName, string[] formats)&#xA;{&#xA;    if (!dt.Columns.Contains(colName)) return;&#xA;    Func&lt;object, DateTime?&gt; parser = (o) =&gt; ParseDate_Exact(o, formats) ?? ParseDate_Fallback(o);&#xA;&#xA;    if (dt.Columns[colName].DataType == typeof(DateTime))&#xA;    {&#xA;        for (int i = 0; i &lt; dt.Rows.Count; i++)&#xA;        {&#xA;            object v = dt.Rows[i][colName];&#xA;            if (v is string)&#xA;            {&#xA;                DateTime? p = parser(v);&#xA;                dt.Rows[i][colName] = p.HasValue ? (object)p.Value : DBNull.Value;&#xA;            }&#xA;        }&#xA;        return;&#xA;    }&#xA;&#xA;    string tmp = colName + &quot;__DT&quot;;&#xA;    if (!dt.Columns.Contains(tmp)) dt.Columns.Add(tmp, typeof(DateTime));&#xA;    for (int i = 0; i &lt; dt.Rows.Count; i++)&#xA;    {&#xA;        DateTime? p = parser(dt.Rows[i][colName]);&#xA;        dt.Rows[i][tmp] = p.HasValue ? (object)p.Value : DBNull.Value;&#xA;    }&#xA;    int ordinal = dt.Columns[colName].Ordinal;&#xA;    dt.Columns.Remove(colName);&#xA;    dt.Columns[tmp].ColumnName = colName;&#xA;    dt.Columns[colName].SetOrdinal(ordinal);&#xA;}&#xA;&#xA;// ---------------------------&#xA;// Normalize existing HIST rows&#xA;// ---------------------------&#xA;int histBefore = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    DataRow r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    r[&quot;Source&quot;] = &quot;HIST&quot;;&#xA;    if (r.Table.Columns.Contains(&quot;Classification&quot;))&#xA;    {&#xA;        var v = r[&quot;Classification&quot;];&#xA;        if (v == DBNull.Value || SafeStr(v) == &quot;&quot;) r[&quot;Classification&quot;] = &quot;&quot;;&#xA;    }&#xA;}&#xA;CoerceToDateTime(dtHistoricalReconTransactionsReport, &quot;Booking Date&quot;, HIST_DATE_FORMATS);&#xA;CoerceToDateTime(dtHistoricalReconTransactionsReport, &quot;Value Date&quot;, HIST_DATE_FORMATS);&#xA;CoerceToDateTime(dtHistoricalReconTransactionsReport, &quot;Transaction Date&quot;, HIST_DATE_FORMATS);&#xA;&#xA;// ---------------------------&#xA;// CMS mapping + normalization&#xA;// ---------------------------&#xA;if (!dtTransactionReport.Columns.Contains(&quot;RRN&quot;))     dtTransactionReport.Columns.Add(&quot;RRN&quot;,  typeof(string));&#xA;if (!dtTransactionReport.Columns.Contains(&quot;STAN&quot;))    dtTransactionReport.Columns.Add(&quot;STAN&quot;, typeof(string));&#xA;if (!dtTransactionReport.Columns.Contains(&quot;AUTH&quot;))    dtTransactionReport.Columns.Add(&quot;AUTH&quot;, typeof(string));&#xA;if (!dtTransactionReport.Columns.Contains(&quot;C_PAN&quot;))   dtTransactionReport.Columns.Add(&quot;C_PAN&quot;, typeof(string));&#xA;if (!dtTransactionReport.Columns.Contains(&quot;Transaction Ref No:&quot;)) dtTransactionReport.Columns.Add(&quot;Transaction Ref No:&quot;, typeof(string));&#xA;if (!dtTransactionReport.Columns.Contains(
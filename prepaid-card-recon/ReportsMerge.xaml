;    if (!string.IsNullOrEmpty(cmsRrnSrc))  row[&quot;RRN&quot;]  = CanonicalizeRRN_AlnumLast12(SafeStr(row[cmsRrnSrc]));&#xA;    if (!string.IsNullOrEmpty(cmsAuthSrc)) row[&quot;AUTH&quot;] = SafeStr(row[cmsAuthSrc]);&#xA;&#xA;    // CMS C_PAN&#xA;    string normPanCms = NormalizeMaskedPan(SafeStr(row[&quot;Device Number&quot;]));&#xA;    row[&quot;C_PAN&quot;] = string.IsNullOrEmpty(normPanCms) ? string.Empty : normPanCms;&#xA;&#xA;    // Narration&#xA;    string txnType = SafeStr(row[&quot;Transaction Type&quot;]);&#xA;    string stan    = SafeStr(row[&quot;STAN&quot;]);&#xA;    string rrn     = SafeStr(row[&quot;RRN&quot;]);&#xA;    string auth    = SafeStr(row[&quot;AUTH&quot;]);&#xA;    row[&quot;Narration&quot;] = NormalizeMaskedPansInText(txnType + &quot;-&quot; + row[&quot;C_PAN&quot;] + &quot;-&quot; + stan + &quot;-&quot; + rrn + &quot;-&quot; + auth);&#xA;&#xA;    if (row[&quot;Classification&quot;] == DBNull.Value || SafeStr(row[&quot;Classification&quot;]) == &quot;&quot;) row[&quot;Classification&quot;] = &quot;&quot;;&#xA;}&#xA;&#xA;// ---------------------------&#xA;// GL enrich from Postilion&#xA;// ---------------------------&#xA;bool hasMaskedCol = dtPostilionTxn.Columns.Contains(&quot;FIELD65_MASKED&quot;);&#xA;var postilionLookup = new System.Collections.Generic.Dictionary&lt;string, DataRow&gt;(StringComparer.OrdinalIgnoreCase);&#xA;for (int i = 0; i &lt; dtPostilionTxn.Rows.Count; i++)&#xA;{&#xA;    DataRow r = dtPostilionTxn.Rows[i];&#xA;    string fx = SafeStr(r[&quot;FLEXREF&quot;]);&#xA;    if (!string.IsNullOrEmpty(fx) &amp;&amp; !postilionLookup.ContainsKey(fx)) postilionLookup.Add(fx, r);&#xA;}&#xA;&#xA;CoerceToDateTime(dtGlStatement, &quot;Booking Date&quot;, GL_DATE_FORMATS);&#xA;CoerceToDateTime(dtGlStatement, &quot;Value Date&quot;, GL_DATE_FORMATS);&#xA;CoerceToDateTime(dtGlStatement, &quot;Transaction Date&quot;, GL_DATE_FORMATS);&#xA;&#xA;int glEnriched = 0;&#xA;for (int i = 0; i &lt; dtGlStatement.Rows.Count; i++)&#xA;{&#xA;   
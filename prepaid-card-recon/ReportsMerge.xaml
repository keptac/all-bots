            <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: Balance Movement (HIST as-is; TXN forced DR-/CR+; ensure Debits total is negative) ====&#xA;// Args (In):     decimal adjustedCBSBalance, decimal cmsBalance, string reconCurrency&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport, DataTable dtTransactionReport&#xA;// Args (Out):    decimal balanceMovement, string balanceMovementDebitOrCredit&#xA;&#xA;// --- Helpers as lambdas (Invoke Code doesn't allow local methods) ---&#xA;Func&lt;object, decimal&gt; ParseSigned = (value) =&gt;&#xA;{&#xA;    if (value == null || value == DBNull.Value) return 0m;&#xA;    var s = value.ToString().Trim();&#xA;    if (string.IsNullOrWhiteSpace(s)) return 0m;&#xA;&#xA;    s = s.Replace(&quot;,&quot;, &quot;&quot;);&#xA;    bool paren = s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;);&#xA;    if (paren) s = s.Trim('(', ')');&#xA;&#xA;    decimal v;&#xA;    if (!decimal.TryParse(s, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out v))&#xA;        return 0m;&#xA;&#xA;    // honor accounting parentheses; otherwise keep the sign as provided&#xA;    return paren ? -v : v;&#xA;};&#xA;&#xA;Func&lt;object, decimal&gt; ParseMagnitude = (value) =&gt;&#xA;{&#xA;    // Used only for TXN before forcing sign via DR/CR&#xA;    if (value == null || value == DBNull.Value) return 0m;&#xA;    var s = value.ToString().Trim();&#xA;    if (string.IsNullOrWhiteSpace(s)) return 0m;&#xA;&#xA;    s = s.Replace(&quot;,&quot;, &quot;&quot;);&#xA;    bool paren = s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;);&#xA;    if (paren) s = s.Trim('(', ')');&#xA;    if (s.StartsWith(&quot;+&quot;) || s.StartsWith(&quot;-&quot;)) s = s.Substring(1);&#xA;&#xA;    decimal v;&#xA;    if (!decimal.TryParse(s, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out v))&#xA;        return 0m;&#xA;&#xA;    return Math.Abs(v);&#xA;};&#xA;&#xA;string debitCol  = &quot;Debit (&quot; + reconCurrency + &quot;)&quot;;&#xA;string creditCol = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xA;&#xA;// --- Safety checks ---&#xA;if (dtHistoricalReconTransactionsReport == null) throw new Exception(&quot;dtHistoricalReconTransactionsReport is null.&quot;);&#xA;if (dtTransactionReport == null) throw new Exception(&quot;dtTransactionReport is null.&quot;);&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(debitCol))  throw new Exception(&quot;Missing HIST column: '&quot; + debitCol + &quot;'&quot;);&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(creditCol)) throw new Exception(&quot;Missing HIST column: '&quot; + creditCol + &quot;'&quot;);&#xA;if (!dtTransactionReport.Columns.Contains(&quot;DR/CR to Cardholder&quot;) || !dtTransactionReport.Columns.Contains(&quot;Billing Amount&quot;))&#xA;    throw new Exception(&quot;dtTransactionReport must contain 'DR/CR to Cardholder' and 'Billing Amount'.&quot;);&#xA;&#xA;// === 1) HIST totals (AS-IS SIGNS), then ensure Debits total is negative ===&#xA;decimal histDebits  = 0m; // will be forced &lt;= 0 after summing&#xA;decimal histCredits = 0m; // keep as-is (typically &gt;= 0)&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    histDebits  += ParseSigned(row[debitCol]);   // as-is (parens honored)&#xA;    histCredits += ParseSigned(row[creditCol]);  // as-is (parens honored)&#xA;}&#xA;&#xA;// 👉 Ensure the final Debits total is negative (fix cases where source was positive/no parens)&#xA;if (histDebits &gt; 0m) histDebits = -histDebits;&#xA;&#xA;// HIST Combined (Debits + Credits) — your definition&#xA;decimal histCombined = Math.Round(histDebits + histCredits, 2);&#xA;&#xA;// === 2) TXN totals (FORCED: DR negative, CR positive) ===&#xA;decimal txnDebits  = 0m; // negative&#xA;decimal txnCredits = 0m; // positive&#xA;&#xA;foreach (DataRow row in dtTransactionReport.Rows)&#xA;{&#xA;    string drcr = row[&quot;DR/CR to Cardholder&quot;] == DBNull.Value ? &quot;&quot; : row[&quot;DR/CR to Cardholder&quot;].ToString().Trim().ToUpperInvariant();&#xA;    if (string.IsNullOrEmpty(drcr)) continue;&#xA;&#xA;    decimal amtMag = ParseMagnitude(row[&quot;Billing Amount&quot;]); // magnitude, then apply sign by DR/CR&#xA;&#xA;    if (drcr == &quot;DR&quot;)      txnDebits  += -amtMag;&#xA;    else if (drcr == &quot;CR&quot;) txnCredits +=  amtMag;&#xA;    // else ignore&#xA;}&#xA;&#xA;decimal txnCombined = Math.Round(txnDebits + txnCredits, 2);&#xA;&#xA;// === 3) System Difference (CBS - CMS) ===&#xA;decimal systemDifference = Math.Round(adjustedCBSBalance - cmsBalance, 2);&#xA;&#xA;// === 4) Delta &amp; Balance Movement ===&#xA;// Delta = (CBS − CMS) − (HIST Debits + HIST Credits)&#xA;// Balance Movement = Delta + (TXN DR + TXN CR)&#xA;decimal delta = Math.Round(systemDifference - histCombined, 2);&#xA;balanceMovement = Math.Round(delta + txnCombined, 2);&#xA;&#xA;// === 5) Logs ===&#xA;Console.WriteLine(&quot;===== Balance Movement Calculation =====&quot;);&#xA;Console.WriteLine(&quot;reconCurrency                    : &quot; + reconCurrency);&#xA;Console.WriteLine(&quot;Adjusted CBS Balance             : &quot; + adjustedCBSBalance.ToString(&quot;N2&quot;));&#xA;Console.WriteLine(&quot;CMS Balance                      : &quot; + cmsBalance.ToString(&quot;N2&quot;));&#xA;Console.WriteLine();&#xA;Console.WriteLine(&quot;HIST Debits (as-is, corrected ≤0): &quot; + histDebits.ToString(&quot;N2&quot;));&#xA;Console.WriteLine(&quot;HIST Credits (as-is)             : &quot; + histCredits.ToString(&quot;N2&quot;));&#xA;Console.WriteLine(&quot;HIST Debits + Credits            : &quot; + histCombined.ToString(&quot;N2&quot;));&#xA;Console.WriteLine();&#xA;Console.WriteLine(&quot;TXN Debits (DR forced negative)  : &quot; + txnDebits.ToString(&quot;N2&quot;));&#xA;Console.WriteLine(&quot;TXN Credits (CR forced positive) : &quot; + txnCredits.ToString(&quot;N2&quot;));&#xA;Console.WriteLine(&quot;TXN Combined Total (DR+CR)       : &quot; + txnCombined.ToString(&quot;N2&quot;));&#xA;Console.WriteLine();&#xA;Console.WriteLine(&quot;CBS - CMS                        : &quot; + systemDifference.ToString(&quot;N2&quot;));&#xA;Console.WriteLine(&quot;Delta (System - HIST)            : &quot; + delta.ToString(&quot;N2&quot;));&#xA;Console.WriteLine(&quot;Balance Movement                 : &quot; + balanceMovement.ToString(&quot;N2&quot;));&#xA;Console.WriteLine();&#xA;&#xA;// === 6) Movement type ===&#xA;balanceMovementDebitOrCredit = &quot;NEUTRAL&quot;;&#xA;if (balanceMovement &gt; 0m)&#xA;{&#xA;    balanceMovementDebitOrCredit = &quot;DEBIT&quot;;&#xA;    Console.WriteLine(&quot;Balance Movement Type            : DEBIT&quot;);&#xA;}&#xA;else if (balanceMovement &lt; 0m)&#xA;{&#xA;    balanceMovementDebitOrCredit = &quot;CREDIT&quot;;&#xA;    Console.WriteLine(&quot;Balance Movement Type            : CREDIT&quot;);&#xA;}&#xA;else&#xA;{&#xA;    Console.WriteLine(&quot;Balance Movement Type            : NEUTRAL&quot;);&#xA;}&#xA;&#xA;// === 7) Percentage variance (optional) ===&#xA;if (cmsBalance != 0m)&#xA;{&#xA;    decimal percentageVariance = Math.Round((balanceMovement / cmsBalance) * 100m, 4);&#xA;    Console.WriteLine(&quot;Percentage Variance              : &quot; + percentageVariance.ToString(&quot;N4&quot;) + &quot;%&quot;);&#xA;}&#xA;&#xA;Console.WriteLine(&quot;===== End =====&quot;);&#xA;" DisplayName="balanceMovement " sap:VirtualizedContainerService.HintSize="477.3333333333333,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_46" Language="CSharp">

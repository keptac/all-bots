            <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ✅ Normalize helper&#xA;string Normalize(string input)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(input)) return string.Empty;&#xA;    return System.Text.RegularExpressions.Regex.Replace(input.Trim(), @&quot;\s+&quot;, &quot; &quot;).ToLowerInvariant();&#xA;}&#xA;&#xA;// ✅ Normalize reconCurrency once&#xA;string reconCurrencyNormalized = Normalize(reconCurrency);&#xA;&#xA;decimal expectedCR = 0m;&#xA;decimal expectedDR = 0m;&#xA;decimal totalCredits = 0m;&#xA;decimal totalDebits = 0m;&#xA;&#xA;foreach (DataRow row in dtTransactionReport.Rows)&#xA;{&#xA;    string drcr = row[&quot;DR/CR to Cardholder&quot;]?.ToString()?.Trim().ToUpper();&#xA;    string reversalFlag = row[&quot;Reversal Flag&quot;]?.ToString()?.Trim().ToUpper();&#xA;    string billingCurrency = Normalize(row[&quot;Billing Currency&quot;]?.ToString());&#xA;    string transactionType = row[&quot;Transaction Type&quot;]?.ToString()?.Trim().ToUpper();&#xA;&#xA;    decimal billingAmount = 0;&#xA;&#xA;    if (!decimal.TryParse(row[&quot;Billing Amount&quot;]?.ToString(), out billingAmount))&#xA;    {&#xA;        row[&quot;Billing Amount&quot;] = 0m;&#xA;        continue;&#xA;    }&#xA;&#xA;    // 🔁 Special Case: Intra Client Debit (non-reconCurrency) — treat as credit only&#xA;    bool isIntraClientDebit = transactionType.Contains(&quot;INTRA CLIENT - WALLET TO WALLET TRANSFER(DEBIT)&quot;) &amp;&amp;&#xA;                              billingCurrency != reconCurrencyNormalized;&#xA;&#xA;    if (isIntraClientDebit)&#xA;    {&#xA;        billingAmount = -Math.Abs(billingAmount);         // Force to negative&#xA;        totalCredits += Math.Abs(billingAmount);          // Count as credit&#xA;        row[&quot;Billing Amount&quot;] = billingAmount;&#xA;        continue; // ✅ Skip DR/CR &amp; expected logic&#xA;    }&#xA;&#xA;    // 📌 Adjust expected DR/CR with reversal logic&#xA;    decimal adjustedAmount = Math.Abs(billingAmount);&#xA;    if ((drcr == &quot;CR&quot; &amp;&amp; reversalFlag == &quot;ORIGINAL&quot;) ||&#xA;        (drcr == &quot;DR&quot; &amp;&amp; reversalFlag == &quot;REVERSAL&quot;))&#xA;    {&#xA;        adjustedAmount *= -1;&#xA;    }&#xA;&#xA;    if (drcr == &quot;CR&quot;)&#xA;    {&#xA;        expectedCR += adjustedAmount;&#xA;        billingAmount = -Math.Abs(billingAmount);         // CR stored as negative&#xA;        totalCredits += Math.Abs(billingAmount);&#xA;    }&#xA;    else if (drcr == &quot;DR&quot;)&#xA;    {&#xA;        expectedDR += adjustedAmount;&#xA;        billingAmount = Math.Abs(billingAmount);          // DR stored as positive&#xA;        totalDebits += billingAmount;&#xA;    }&#xA;&#xA;    row[&quot;Billing Amount&quot;] = billingAmount;&#xA;}&#xA;&#xA;// ✅ Print Totals&#xA;Console.WriteLine($&quot;💳 Total Debits: {totalDebits:N2}&quot;);&#xA;Console.WriteLine($&quot;💰 Total Credits: {totalCredits:N2}&quot;);&#xA;Console.WriteLine($&quot;📌 Expected DR: {expectedDR:N2}&quot;);&#xA;Console.WriteLine($&quot;📌 Expected CR: {expectedCR:N2}&quot;);&#xA;" DisplayName="dtTransactionReport negate DR/CR to Cardholder" sap:VirtualizedContainerService.HintSize="477.3333333333333,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_28" Language="CSharp">

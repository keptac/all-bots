okingCol = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Booking Date&quot;)&#xA;            ? dtHistoricalReconTransactionsReport.Columns[&quot;Booking Date&quot;].Ordinal + 1&#xA;            : -1;&#xA;        int valueCol = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Value Date&quot;)&#xA;            ? dtHistoricalReconTransactionsReport.Columns[&quot;Value Date&quot;].Ordinal + 1&#xA;            : -1;&#xA;&#xA;        // Guard the ranges to avoid &quot;start &gt; end&quot;&#xA;        if (bookingCol &gt; 0)&#xA;            wsRaw.Cells[2, bookingCol, totalRows + 1, bookingCol].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;        if (valueCol &gt; 0)&#xA;            wsRaw.Cells[2, valueCol, totalRows + 1, valueCol].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;    }&#xA;&#xA;    // (Optional) Auto-fit headers/columns if there is content&#xA;    if (totalCols &gt; 0)&#xA;        wsRaw.Cells[1, 1, Math.Max(1, totalRows + 1), totalCols].AutoFitColumns();&#xA;&#xA;    package.Save();&#xA;}&#xA;&#xA;Console.WriteLine($&quot;✅ dtHistoricalReconTransactionsReport saved to 'MERGE' — Rows: {dtHistoricalReconTransactionsReport.Rows.Count:N0}, Cols: {dtHistoricalReconTransactionsReport.Columns.Count:N0}.&quot;);&#xA;" DisplayName="Write dtTransactionReport MERGE" sap:VirtualizedContainerService.HintSize="382,188" sap2010:WorkflowViewState.IdRef="InvokeCode_79" Language="CSharp">

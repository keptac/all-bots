      <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Ensure ROOT_CAUSE_PROCESSED column exists&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;ROOT_CAUSE_PROCESSED&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;ROOT_CAUSE_PROCESSED&quot;, typeof(string));&#xA;&#xA;// Helper: normalize for PPS detection&#xA;string Normalize(string s) =&gt;&#xA;    (s ?? &quot;&quot;).Replace(&quot; &quot;, &quot;&quot;).Trim().ToUpper();&#xA;&#xA;// Helper: case-insensitive contains&#xA;bool ContainsIgnoreCase(string source, string value) =&gt;&#xA;    (source ?? &quot;&quot;).IndexOf(value, StringComparison.OrdinalIgnoreCase) &gt;= 0;&#xA;&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string txnRef = row[&quot;Transaction Ref No:&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string normalized = Normalize(txnRef);&#xA;&#xA;    // True PPS = 16 chars AND contains PPS&#xA;    bool isPPS = (normalized.Length == 16 &amp;&amp; normalized.Contains(&quot;PPS&quot;));&#xA;&#xA;    string rc  = row[&quot;Root Cause&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string cat = row[&quot;Root Cause Category&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string ra  = row[&quot;Recommended Action&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string own = row[&quot;Action Owner&quot;]?.ToString() ?? &quot;&quot;;&#xA;&#xA;    // ---- DEFAULT PPS VALUES ----&#xA;    string ppsRC  = &quot;Auth dump posted transactions not matched against outstanding remote-on-us txns&quot;;&#xA;    string ppsCat = &quot;System&quot;;&#xA;    string ppsRA  = &quot;Under investigation&quot;;&#xA;    string ppsOwn = &quot;Card Reconciliation&quot;;&#xA;&#xA;    // =====================================================&#xA;    // 1) CLEANUP: Remove PPS-defaults from NON-PPS rows&#xA;    // =====================================================&#xA;    bool hasDefaultPpsValues =&#xA;           rc.Trim()  == ppsRC&#xA;        &amp;&amp; cat.Trim() == ppsCat&#xA;        &amp;&amp; ra.Trim()  == ppsRA&#xA;        &amp;&amp; own.Trim() == ppsOwn;&#xA;&#xA;    if (!isPPS &amp;&amp; hasDefaultPpsValues)&#xA;    {&#xA;        row[&quot;Root Cause&quot;]          = &quot;&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;&quot;;&#xA;        row[&quot;Recommended Action&quot;]  = &quot;&quot;;&#xA;        row[&quot;Action Owner&quot;]        = &quot;&quot;;&#xA;&#xA;        // Mark processed&#xA;        row[&quot;ROOT_CAUSE_PROCESSED&quot;] = &quot;TRUE&quot;;&#xA;        continue;&#xA;    }&#xA;&#xA;    // =====================================================&#xA;    // 2) SPECIAL RULE: PPS MUST NEVER BE LATE POSTED&#xA;    // =====================================================&#xA;    bool containsLate =&#xA;           ContainsIgnoreCase(rc, &quot;late&quot;)&#xA;        || ContainsIgnoreCase(cat, &quot;late&quot;)&#xA;        || ContainsIgnoreCase(ra, &quot;late&quot;)&#xA;        || ContainsIgnoreCase(own, &quot;late&quot;);&#xA;&#xA;    if (isPPS &amp;&amp; containsLate)&#xA;    {&#xA;        row[&quot;Root Cause&quot;]          = ppsRC;&#xA;        row[&quot;Root Cause Category&quot;] = ppsCat;&#xA;        row[&quot;Recommended Action&quot;]  = ppsRA;&#xA;        row[&quot;Action Owner&quot;]        = ppsOwn;&#xA;&#xA;        // Mark processed&#xA;        row[&quot;ROOT_CAUSE_PROCESSED&quot;] = &quot;TRUE&quot;;&#xA;        continue;&#xA;    }&#xA;&#xA;    // =====================================================&#xA;    // 3) PPS DEFAULTS (only if empty)&#xA;    // =====================================================&#xA;    if (isPPS)&#xA;    {&#xA;        bool applied = false;&#xA;&#xA;        if (string.IsNullOrWhiteSpace(rc))&#xA;        {&#xA;            row[&quot;Root Cause&quot;] = ppsRC;&#xA;            applied = true;&#xA;        }&#xA;&#xA;        if (string.IsNullOrWhiteSpace(cat))&#xA;        {&#xA;            row[&quot;Root Cause Category&quot;] = ppsCat;&#xA;            applied = true;&#xA;        }&#xA;&#xA;        if (string.IsNullOrWhiteSpace(ra))&#xA;        {&#xA;            row[&quot;Recommended Action&quot;] = ppsRA;&#xA;            applied = true;&#xA;        }&#xA;&#xA;        if (string.IsNullOrWhiteSpace(own))&#xA;        {&#xA;            row[&quot;Action Owner&quot;] = ppsOwn;&#xA;            applied = true;&#xA;        }&#xA;&#xA;        if (applied)&#xA;            row[&quot;ROOT_CAUSE_PROCESSED&quot;] = &quot;TRUE&quot;;&#xA;    }&#xA;}&#xA;" DisplayName="PPS" sap:VirtualizedContainerService.HintSize="1169.3333333333333,188" sap2010:WorkflowViewState.IdRef="InvokeCode_95" Language="CSharp">

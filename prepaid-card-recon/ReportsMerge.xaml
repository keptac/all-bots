        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: AGW FX Root Causes (CMS-Driven, Unicode-Clean, Heavy Logging) ====&#xA;//&#xA;// In/Out: DataTable dtGlStatement&#xA;// In    : DataTable dtTransactionReportForeignCurrencyTZS&#xA;// In    : string reconCurrency&#xA;//&#xA;// This version fixes ALL matching issues:&#xA;//   ✓ Unicode-cleaning for GL Narration&#xA;//   ✓ C_PAN normalized to FIRST6 + &quot;XXXXXX&quot; + LAST4&#xA;//   ✓ CMS-driven matching using Reference Number&#xA;//   ✓ GL grouped by PAN and summed to match CMS Transaction Amount&#xA;//   ✓ Works for your sample (AGW 9556.00)&#xA;//&#xA;// --------------------------------------------------------------------&#xA;&#xA;if (dtGlStatement == null)&#xA;    throw new ArgumentNullException(nameof(dtGlStatement));&#xA;&#xA;System.Data.DataTable t = dtGlStatement;&#xA;&#xA;// --------------------------------------------------------------&#xA;// Logger&#xA;// --------------------------------------------------------------&#xA;System.Action&lt;string&gt; Log = msg =&gt; System.Console.WriteLine(msg);&#xA;Log(&quot;=== AGW FX PROCESSING START (CMS-Driven; Unicode-Clean) ===&quot;);&#xA;&#xA;// --------------------------------------------------------------&#xA;// Dynamic GL debit/credit columns&#xA;// --------------------------------------------------------------&#xA;string debitCol  = &quot;Debit (&quot;  + reconCurrency + &quot;)&quot;;&#xA;string creditCol = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xA;&#xA;if (!t.Columns.Contains(debitCol))  throw new Exception(&quot;Missing column: &quot; + debitCol);&#xA;if (!t.Columns.Contains(creditCol)) throw new Exception(&quot;Missing column: &quot; + creditCol);&#xA;&#xA;// --------------------------------------------------------------&#xA;// Ensure required GL columns exist&#xA;// --------------------------------------------------------------&#xA;string[] cols = {&#xA;    &quot;C_PAN&quot;,&quot;PS_RRN&quot;,&#xA;    &quot;Root Cause&quot;,&quot;Root Cause Category&quot;,&quot;Recommended Action&quot;,&quot;Action Owner&quot;,&#xA;    &quot;ROOT_CAUSE_PROCESSED&quot;,&quot;Source&quot;&#xA;};&#xA;&#xA;foreach (string c in cols)&#xA;    if (!t.Columns.Contains(c))&#xA;        t.Columns.Add(c, typeof(string));&#xA;&#xA;// --------------------------------------------------------------&#xA;// Helpers&#xA;// --------------------------------------------------------------&#xA;string SafeStr(object v)&#xA;{&#xA;    return (v == null || v == DBNull.Value) ? &quot;&quot; : v.ToString();&#xA;}&#xA;&#xA;// Remove ALL invisible Unicode characters&#xA;string CleanUnicode(string s)&#xA;{&#xA;    if (string.IsNullOrEmpty(s)) return &quot;&quot;;&#xA;    return new string(s.Where(ch =&gt;&#xA;        ch != '\u200B' &amp;&amp;  // zero-width space&#xA;        ch != '\u200C' &amp;&amp;  // zero-width non-joiner&#xA;        ch != '\u200D' &amp;&amp;  // zero-width joiner&#xA;        ch != '\uFEFF' &amp;&amp;  // zero-width no-break space&#xA;        ch != '\u00A0'     // non-breaking space&#xA;    ).ToArray());&#xA;}&#xA;&#xA;decimal ParseAmt(object v)&#xA;{&#xA;    if (v == null || v == DBNull.Value) return 0m;&#xA;    string s = CleanUnicode(Convert.ToString(v).Trim());&#xA;    if (s == &quot;&quot;) return 0m;&#xA;&#xA;    bool negParen = s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;);&#xA;    if (negParen) s = s.Substring(1, s.Length - 2);&#xA;&#xA;    s = s.Replace(&quot;,&quot;, &quot;&quot;);&#xA;&#xA;    decimal d;&#xA;    if (!decimal.TryParse(s, System.Globalization.NumberStyles.Any,&#xA;            System.Globalization.CultureInfo.InvariantCulture, out d))&#xA;    {&#xA;        decimal.TryParse(s, System.Globalization.NumberStyles.Any,&#xA;            System.Globalization.CultureInfo.CurrentCulture, out d);&#xA;    }&#xA;&#xA;    if (negParen) d = -Math.Abs(d);&#xA;    return d;&#xA;}&#xA;&#xA;decimal Round2(decimal d)&#xA;{&#xA;    return Math.Round(d, 2, MidpointRounding.AwayFromZero);&#xA;}&#xA;&#xA;// C_PAN normalization: FIRST6 + &quot;XXXXXX&quot; + LAST4&#xA;string StandardMaskPan(string input)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(input)) return &quot;&quot;;&#xA;&#xA;    input = CleanUnicode(input);&#xA;&#xA;    var digits = new System.Text.StringBuilder();&#xA;    foreach (char ch in input)&#xA;        if (char.IsDigit(ch)) digits.Append(ch);&#xA;&#xA;    string all = digits.ToString();&#xA;    if (all.Length &lt; 10) return all;&#xA;&#xA;    string first6 = all.Substring(0, 6);&#xA;    string last4  = all.Substring(all.Length - 4);&#xA;    return first6 + &quot;XXXXXX&quot; + last4;&#xA;}&#xA;&#xA;// --------------------------------------------------------------&#xA;// Regexes (precompiled)&#xA;// --------------------------------------------------------------&#xA;var rgCardPan = new System.Text.RegularExpressions.Regex(&#xA;    @&quot;Card\s*No:?\s*([0-9]{6}[\*\sxX#\-\._0-9\?]{3,20}[0-9]{4})&quot;,&#xA;    System.Text.RegularExpressions.RegexOptions.IgnoreCase |&#xA;    System.Text.RegularExpressions.RegexOptions.Compiled&#xA;);&#xA;&#xA;var rgPanFlexible = new System.Text.RegularExpressions.Regex(&#xA;    @&quot;([0-9]{6})([\*\sxX#\-\._0-9\?]{3,20})([0-9]{4})&quot;,&#xA;    System.Text.RegularExpressions.RegexOptions.Compiled&#xA;);&#xA;&#xA;var rgPS = new System.Text.RegularExpressions.Regex(&#xA;    @&quot;PS\d{10}&quot;,&#xA;    System.Text.RegularExpressions.RegexOptions.Compiled&#xA;);&#xA;&#xA;// Extract a normalized C_PAN from GL narration&#xA;string ExtractStandardPan(string narration)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(narration)) return &quot;&quot;;&#xA;    narration = CleanUnicode(narration);&#xA;&#xA;    var m1 = rgCardPan.Match(narration);&#xA;    if (m1.Success)&#xA;        return StandardMaskPan(m1.Groups[1].Value);&#xA;&#xA;    var m2 = rgPanFlexible.Match(narration);&#xA;    if (m2.Success)&#xA;        return m2.Groups[1].Value + &quot;XXXXXX&quot; + m2.Groups[3].Value;&#xA;&#xA;    return &quot;&quot;;&#xA;}&#xA;&#xA;// --------------------------------------------------------------&#xA;// PRE-FILL GL: C_PAN + PS_RRN&#xA;// --------------------------------------------------------------&#xA;for (int i = 0; i &lt; t.Rows.Count; i++)&#xA;{&#xA;    var row = t.Rows[i];&#xA;    string narr = CleanUnicode(SafeStr(row[&quot;Narration&quot;]));&#xA;&#xA;    string pan = ExtractStandardPan(narr);&#xA;    if (!string.IsNullOrEmpty(pan))&#xA;        row[&quot;C_PAN&quot;] = StandardMaskPan(pan);&#xA;&#xA;    var mps = rgPS.Match(narr);&#xA;    if (mps.Success)&#xA;        row[&quot;PS_RRN&quot;] = mps.Value;&#xA;}&#xA;&#xA;// --------------------------------------------------------------&#xA;// CMS-DRIVEN MATCHING&#xA;// --------------------------------------------------------------&#xA;int cmsTotal = dtTransactionReportForeignCurrencyTZS?.Rows.Count ?? 0;&#xA;int cmsConsidered = 0;&#xA;int cmsMatched = 0;&#xA;int updatedAGW = 0;&#xA;&#xA;if (dtTransactionReportForeignCurrencyTZS != null)&#xA;{&#xA;    for (int ci = 0; ci &lt; dtTransactionReportForeignCurrencyTZS.Rows.Count; ci++)&#xA;    {&#xA;        var cms = dtTransactionReportForeignCurrencyTZS.Rows[ci];&#xA;&#xA;        string refRaw = SafeStr(cms[&quot;Reference Number&quot;]);&#xA;        string refCms = CleanUnicode(refRaw).Trim();&#xA;&#xA;        decimal cmsAmt = Round2(Math.Abs(ParseAmt(cms[&quot;Transaction Amount&quot;])));&#xA;&#xA;        string cmsDevice = SafeStr(cms[&quot;Device Number&quot;]);&#xA;        string cmsPan = StandardMaskPan(cmsDevice);&#xA;&#xA;        // ---- CMS DEBUG ----&#xA;        Log(&quot;&quot;);&#xA;        Log(&quot;========== CMS ROW #&quot; + ci + &quot; ==========&quot;);&#xA;        Log(&quot;CMS Ref Raw      : [&quot; + refRaw + &quot;]&quot;);&#xA;        Log(&quot;CMS Ref Clean    : [&quot; + refCms + &quot;]&quot;);&#xA;        Log(&quot;CMS PAN Raw      : [&quot; + cmsDevice + &quot;]&quot;);&#xA;        Log(&quot;CMS PAN Masked   : [&quot; + cmsPan + &quot;]&quot;);&#xA;        Log(&quot;CMS Txn Amount   : &quot; + cmsAmt);&#xA;        Log(&quot;========================================&quot;);&#xA;&#xA;        if (string.IsNullOrEmpty(refCms)) { Log(&quot;SKIP: CMS Ref empty.&quot;); continue; }&#xA;        if (!rgPS.IsMatch(refCms))       { Log(&quot;SKIP: CMS Ref not PS+10.&quot;); continue; }&#xA;        if (cmsAmt &lt;= 0)                 { Log(&quot;SKIP: CMS Amount zero.&quot;); continue; }&#xA;&#xA;        cmsConsidered++;&#xA;&#xA;        // ------------------------------------------------------&#xA;        // FIND GL rows whose CLEANED narration contains this PS&#xA;        // ------------------------------------------------------&#xA;        var glCandidates = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;        string refKey = CleanUnicode(refCms);&#xA;&#xA;        for (int gi = 0; gi &lt; t.Rows.Count; gi++)&#xA;        {&#xA;            var gl = t.Rows[gi];&#xA;&#xA;            string narrRaw = SafeStr(gl[&quot;Narration&quot;]);&#xA;            string narr = CleanUnicode(narrRaw);&#xA;&#xA;            if (narr.Contains(refKey))&#xA;            {&#xA;                glCandidates.Add(gl);&#xA;&#xA;                Log(&quot;---- GL HIT ----&quot;);&#xA;                Log(&quot;GL RefNo    : &quot; + SafeStr(gl[&quot;Transaction Ref No:&quot;]));&#xA;                Log(&quot;NARR RAW    : [&quot; + narrRaw + &quot;]&quot;);&#xA;                Log(&quot;NARR CLEAN  : [&quot; + narr + &quot;]&quot;);&#xA;                Log(&quot;GL PAN      : &quot; + SafeStr(gl[&quot;C_PAN&quot;]));&#xA;                Log(&quot;----------------&quot;);&#xA;            }&#xA;        }&#xA;&#xA;        if (glCandidates.Count == 0)&#xA;        {&#xA;            Log(&quot;❌ NO GL rows containing PS: &quot; + refKey);&#xA;            continue;&#xA;        }&#xA;&#xA;        Log(&quot;GL candidates = &quot; + glCandidates.Count);&#xA;&#xA;        // ------------------------------------------------------&#xA;        // GROUP GL by PAN&#xA;        // ------------------------------------------------------&#xA;        var groups = new System.Collections.Generic.Dictionary&lt;string,&#xA;            System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;&#xA;        foreach (var gl in glCandidates)&#xA;        {&#xA;            string pan = StandardMaskPan(SafeStr(gl[&quot;C_PAN&quot;]));&#xA;&#xA;            if (string.IsNullOrEmpty(pan)) continue;&#xA;&#xA;            decimal d = ParseAmt(gl[debitCol]);&#xA;            decimal c = ParseAmt(gl[creditCol]);&#xA;            decimal amt = Math.Abs(d) &gt; 0 ? Math.Abs(d) : Math.Abs(c);&#xA;            if (amt == 0) continue;&#xA;&#xA;            if (!groups.ContainsKey(pan))&#xA;                groups[pan] = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;&#xA;            groups[pan].Add(gl);&#xA;&#xA;            Log($&quot;PAN GROUPING: {pan} | Amt={amt}&quot;);&#xA;        }&#xA;&#xA;        if (groups.Count == 0)&#xA;        {&#xA;            Log(&quot;❌ GL candidates have NO usable PAN+Amount.&quot;);&#xA;            continue;&#xA;        }&#xA;&#xA;        // ------------------------------------------------------&#xA;        // MATCH GROUP TOTAL TO CMS AMOUNT&#xA;        // ------------------------------------------------------&#xA;        bool matchedThisCMS = false;&#xA;&#xA;        foreach (var kvp in groups)&#xA;        {&#xA;            string panKey = kvp.Key;&#xA;            var rows = kvp.Value;&#xA;&#xA;            decimal total = 0;&#xA;            foreach (var gl in rows)&#xA;            {&#xA;                decimal d = ParseAmt(gl[debitCol]);&#xA;                decimal c = ParseAmt(gl[creditCol]);&#xA;                total += Math.Abs(d) &gt; 0 ? Math.Abs(d) : Math.Abs(c);&#xA;            }&#xA;            total = Round2(total);&#xA;&#xA;            Log($&quot;PAN={panKey} | GLTotal={total} | CMS={cmsAmt}&quot;);&#xA;&#xA;            if (total == cmsAmt)&#xA;            {&#xA;                matchedThisCMS = true;&#xA;                cmsMatched++;&#xA;&#xA;                Log($&quot;✅ MATCH FOUND FOR PS={refCms}, PAN={panKey}, Total={total}&quot;);&#xA;&#xA;                // APPLY ROOT CAUSE&#xA;                foreach (var gl in rows)&#xA;                {&#xA;                    gl[&quot;C_PAN&quot;] = panKey;&#xA;                    gl[&quot;Root Cause&quot;] = &quot;Wakala withdrawal debited TZS instead of FX GL&quot;;&#xA;                    gl[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;&#xA;                    gl[&quot;Recommended Action&quot;] =&#xA;                        $&quot;DR: 202030015 (USD {SafeStr(cms[&quot;Billing Amount&quot;])}) &quot; +&#xA;                        $&quot;CR: 202030015 (TZS {SafeStr(cms[&quot;Transaction Amount&quot;])})&quot;;&#xA;&#xA;                    gl[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;                    gl[&quot;ROOT_CAUSE_PROCESSED&quot;] = &quot;TRUE&quot;;&#xA;&#xA;                    updatedAGW++;&#xA;                }&#xA;&#xA;                break; // only first match&#xA;            }&#xA;        }&#xA;&#xA;        if (!matchedThisCMS)&#xA;        {&#xA;            Log($&quot;❌ No matching PAN group for CMS Ref={refCms} | CMS Amount={cmsAmt}&quot;);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// --------------------------------------------------------------&#xA;// SUMMARY&#xA;// --------------------------------------------------------------&#xA;Log(&quot;&quot;);&#xA;Log(&quot;=== AGW FX SUMMARY ===&quot;);&#xA;Log(&quot;CMS Total Rows   : &quot; + cmsTotal);&#xA;Log(&quot;CMS Considered   : &quot; + cmsConsidered);&#xA;Log(&quot;CMS Matched      : &quot; + cmsMatched);&#xA;Log(&quot;GL Rows Updated  : &quot; + updatedAGW);&#xA;Log(&quot;=== END AGW FX PROCESSING ===&quot;);&#xA;" DisplayName="FXWAKALA" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_98" Language="CSharp">
          <ui:InvokeCode.Arguments>

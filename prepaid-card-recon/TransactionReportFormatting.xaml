            <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === 1. Ensure MATCH column exists ===&#xA;if (!dtTransactionReport.Columns.Contains(&quot;MATCH&quot;))&#xA;    dtTransactionReport.Columns.Add(&quot;MATCH&quot;, typeof(bool));&#xA;&#xA;if (!dtTransactionReportRev.Columns.Contains(&quot;MATCH&quot;))&#xA;    dtTransactionReportRev.Columns.Add(&quot;MATCH&quot;, typeof(bool));&#xA;&#xA;// === 2. Helper to Copy Row ===&#xA;void CopyRow_Optimized(DataRow source, DataRow target, DataTable targetTable)&#xA;{&#xA;    foreach (DataColumn col in targetTable.Columns)&#xA;    {&#xA;        if (source.Table.Columns.Contains(col.ColumnName))&#xA;        {&#xA;            target[col.ColumnName] = source[col.ColumnName];&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === 3. Build lookup for unmatched rows by C_PAN + Device ===&#xA;var unmatchedLookup = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;();&#xA;foreach (DataRow row in dtTransactionReport.Rows)&#xA;{&#xA;    if (row[&quot;MATCH&quot;] != DBNull.Value &amp;&amp; Convert.ToBoolean(row[&quot;MATCH&quot;])) continue;&#xA;&#xA;    string cpan = row[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string device = row[&quot;Device Number&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string key = $&quot;{cpan}|{device}&quot;;&#xA;&#xA;    if (!unmatchedLookup.ContainsKey(key))&#xA;        unmatchedLookup[key] = new List&lt;DataRow&gt;();&#xA;&#xA;    unmatchedLookup[key].Add(row);&#xA;}&#xA;&#xA;// === 4. Match rows within each group ===&#xA;foreach (var kvp in unmatchedLookup)&#xA;{&#xA;    var rows = kvp.Value;&#xA;&#xA;    for (int i = 0; i &lt; rows.Count; i++)&#xA;    {&#xA;        var row1 = rows[i];&#xA;        if (row1[&quot;MATCH&quot;] != DBNull.Value &amp;&amp; Convert.ToBoolean(row1[&quot;MATCH&quot;])) continue;&#xA;&#xA;        string reversal1 = row1.Table.Columns.Contains(&quot;Reversal Flag&quot;)&#xA;            ? row1[&quot;Reversal Flag&quot;]?.ToString()?.ToUpper() ?? &quot;&quot;&#xA;            : &quot;&quot;;&#xA;&#xA;        string transType1 = row1[&quot;Transaction Type&quot;]?.ToString()?.ToUpper() ?? &quot;&quot;;&#xA;        decimal.TryParse(row1[&quot;Billing Amount&quot;]?.ToString(), out decimal amt1);&#xA;&#xA;        for (int j = i + 1; j &lt; rows.Count; j++)&#xA;        {&#xA;            var row2 = rows[j];&#xA;            if (row2[&quot;MATCH&quot;] != DBNull.Value &amp;&amp; Convert.ToBoolean(row2[&quot;MATCH&quot;])) continue;&#xA;&#xA;            string reversal2 = row2.Table.Columns.Contains(&quot;Reversal Flag&quot;)&#xA;                ? row2[&quot;Reversal Flag&quot;]?.ToString()?.ToUpper() ?? &quot;&quot;&#xA;                : &quot;&quot;;&#xA;&#xA;            string transType2 = row2[&quot;Transaction Type&quot;]?.ToString()?.ToUpper() ?? &quot;&quot;;&#xA;            decimal.TryParse(row2[&quot;Billing Amount&quot;]?.ToString(), out decimal amt2);&#xA;&#xA;            bool reversalOpposite =&#xA;                (reversal1 == &quot;ORIGINAL&quot; &amp;&amp; reversal2 == &quot;REVERSAL&quot;) ||&#xA;                (reversal1 == &quot;REVERSAL&quot; &amp;&amp; reversal2 == &quot;ORIGINAL&quot;);&#xA;&#xA;            bool strictMatch =&#xA;                transType1 != transType2 &amp;&amp;&#xA;                Math.Round(amt1, 2) == -Math.Round(amt2, 2) &amp;&amp;&#xA;                reversalOpposite;&#xA;&#xA;            if (strictMatch)&#xA;            {&#xA;                row1[&quot;MATCH&quot;] = true;&#xA;                row2[&quot;MATCH&quot;] = true;&#xA;                break;&#xA;            }&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === 5. Move matched or &quot;REV&quot; transactions to dtTransactionReportRev ===&#xA;var toMove = dtTransactionReport.AsEnumerable()&#xA;    .Where(row =&gt;&#xA;    {&#xA;        string code = row[&quot;Transaction Code&quot;]?.ToString()?.ToUpper() ?? &quot;&quot;;&#xA;        bool isMatched = row[&quot;MATCH&quot;] != DBNull.Value &amp;&amp; Convert.ToBoolean(row[&quot;MATCH&quot;]);&#xA;        return isMatched || code.Contains(&quot;REV&quot;);&#xA;    }).ToList();&#xA;&#xA;foreach (var row in toMove)&#xA;{&#xA;    var newRow = dtTransactionReportRev.NewRow();&#xA;    CopyRow_Optimized(row, newRow, dtTransactionReportRev);&#xA;    newRow[&quot;MATCH&quot;] = row[&quot;MATCH&quot;];&#xA;    dtTransactionReportRev.Rows.Add(newRow);&#xA;    dtTransactionReport.Rows.Remove(row);&#xA;}&#xA;&#xA;// === 6. Finalize changes ===&#xA;dtTransactionReport.AcceptChanges();&#xA;dtTransactionReportRev.AcceptChanges();&#xA;&#xA;// === 7. Print Summary ===&#xA;int finalMatchedCount = dtTransactionReportRev.AsEnumerable()&#xA;    .Count(r =&gt; r[&quot;MATCH&quot;] != DBNull.Value &amp;&amp; Convert.ToBoolean(r[&quot;MATCH&quot;]));&#xA;&#xA;int finalUnmatchedCount = dtTransactionReportRev.AsEnumerable()&#xA;    .Count(r =&gt; r[&quot;MATCH&quot;] != DBNull.Value &amp;&amp; !Convert.ToBoolean(r[&quot;MATCH&quot;]));&#xA;&#xA;Console.WriteLine(&quot;=============================================&quot;);&#xA;Console.WriteLine($&quot;✅ Total Matched Reversals: {finalMatchedCount}&quot;);&#xA;Console.WriteLine($&quot;✅ Total Unmatched Reversals: {finalUnmatchedCount}&quot;);&#xA;Console.WriteLine($&quot;✅ Remaining rows in dtTransactionReport: {dtTransactionReport.Rows.Count}&quot;);&#xA;Console.WriteLine(&quot;=============================================&quot;);&#xA;" DisplayName="Remove Auto REV" sap:VirtualizedContainerService.HintSize="449.6,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_12" Language="CSharp">

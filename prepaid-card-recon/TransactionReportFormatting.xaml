            <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Utility: Rename columns in a DataTable ===&#xA;void RenameColumns(DataTable table, Dictionary&lt;string, string&gt; renameMap)&#xA;{&#xA;    foreach (var kvp in renameMap)&#xA;    {&#xA;        string original = kvp.Key;&#xA;        string target = kvp.Value;&#xA;&#xA;        if (!table.Columns.Contains(original))&#xA;            continue;&#xA;&#xA;        if (original == target)&#xA;            continue;&#xA;&#xA;        // Avoid renaming if target column already exists&#xA;        if (table.Columns.Contains(target))&#xA;            continue;&#xA;&#xA;        table.Columns[original].ColumnName = target;&#xA;    }&#xA;}&#xA;&#xA;// === Utility: Add C_PAN column if missing and mask Device Number ===&#xA;void MaskDeviceNumberToCPAN(DataTable table)&#xA;{&#xA;    if (!table.Columns.Contains(&quot;C_PAN&quot;))&#xA;    {&#xA;        table.Columns.Add(&quot;C_PAN&quot;, typeof(string));&#xA;    }&#xA;&#xA;    foreach (DataRow row in table.Rows)&#xA;    {&#xA;        var deviceNumber = row[&quot;Device Number&quot;]?.ToString()?.Trim();&#xA;&#xA;        if (!string.IsNullOrEmpty(deviceNumber) &amp;&amp; deviceNumber.Length &gt;= 16)&#xA;        {&#xA;            row[&quot;C_PAN&quot;] = $&quot;{deviceNumber.Substring(0, 6)}XXXXXX{deviceNumber.Substring(12, 4)}&quot;;&#xA;        }&#xA;        else&#xA;        {&#xA;            row[&quot;C_PAN&quot;] = string.Empty;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === USAGE BLOCK ===&#xA;&#xA;// Define rename mappings&#xA;var renameMap = new Dictionary&lt;string, string&gt;&#xA;{&#xA;    { &quot;Reference Number&quot;, &quot;RRN&quot; },&#xA;    { &quot;Trace Audit Number&quot;, &quot;STAN&quot; },&#xA;    { &quot;Authorization Number&quot;, &quot;AUTHORIZATION_NUMBER&quot; }&#xA;};&#xA;&#xA;// Apply renaming&#xA;RenameColumns(dtTransactionReport, renameMap);&#xA;&#xA;// Apply PAN masking&#xA;MaskDeviceNumberToCPAN(dtTransactionReport);&#xA;" DisplayName="dtTransa
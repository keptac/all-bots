            <ui:InvokeCode ContinueOnError="{x:Null}" Code="decimal totalDebits_GL = 0;&#xA;decimal totalCredits_GL = 0;&#xA;decimal totalDebits_HIST = 0;&#xA;decimal totalCredits_HIST = 0;&#xA;decimal totalDebits_TXN = 0;&#xA;decimal totalCredits_TXN = 0;&#xA;&#xA;// === 1. Sum dtGlStatement ===&#xA;foreach (DataRow row in dtGlStatement.Rows)&#xA;{&#xA;    if (decimal.TryParse(row[&quot;Debit (TZS)&quot;]?.ToString()?.Replace(&quot;,&quot;, &quot;&quot;).Trim(), out var debit))&#xA;        totalDebits_GL += debit;&#xA;&#xA;    if (decimal.TryParse(row[&quot;Credit (TZS)&quot;]?.ToString()?.Replace(&quot;,&quot;, &quot;&quot;).Trim(), out var credit))&#xA;        totalCredits_GL += credit;&#xA;}&#xA;&#xA;// === 2. Sum dtHistoricalReconTransactionsReport with sign correction ===&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string rawDebit = row[&quot;Debit (TZS)&quot;]?.ToString()?.Trim().Replace(&quot;,&quot;, &quot;&quot;);&#xA;    if (!string.IsNullOrEmpty(rawDebit))&#xA;    {&#xA;        if (rawDebit.StartsWith(&quot;(&quot;) &amp;&amp; rawDebit.EndsWith(&quot;)&quot;))&#xA;            rawDebit = &quot;-&quot; + rawDebit.Trim('(', ')');&#xA;&#xA;        if (decimal.TryParse(rawDebit, out var debitTzs))&#xA;            totalDebits_HIST += debitTzs;&#xA;    }&#xA;&#xA;    string rawCredit = row[&quot;Credit (TZS)&quot;]?.ToString()?.Trim().Replace(&quot;,&quot;, &quot;&quot;);&#xA;    if (!string.IsNullOrEmpty(rawCredit))&#xA;    {&#xA;        if (rawCredit.StartsWith(&quot;(&quot;) &amp;&amp; rawCredit.EndsWith(&quot;)&quot;))&#xA;            rawCredit = &quot;-&quot; + rawCredit.Trim('(', ')');&#xA;&#xA;        if (decimal.TryParse(rawCredit, out var creditTzs))&#xA;            totalCredits_HIST += creditTzs;&#xA;    }&#xA;}&#xA;&#xA;// === 3. Sum dtTransactionReport with sign correction ===&#xA;foreach (DataRow row in dtTransactionReport.Rows)&#xA;{&#xA;    string drcr = row[&quot;DR/CR to Cardholder&quot;]?.ToString()?.Trim().ToUpper();&#xA;    string amountRaw = row[&quot;Billing Amount&quot;]?.ToString()?.Trim().Replace(&quot;,&quot;, &quot;&quot;);&#xA;&#xA;    if (string.IsNullOrEmpty(drcr) || string.IsNullOrEmpty(amountRaw)) continue;&#xA;&#xA;    if (amountRaw.StartsWith(&quot;(&quot;) &amp;&amp; amountRaw.EndsWith(&quot;)&quot;))&#xA;        amountRaw = &quot;-&quot; + amountRaw.Trim('(', ')');&#xA;&#xA;    if (!decimal.TryParse(amountRaw, out var amount)) continue;&#xA;&#xA;    if (drcr == &quot;DR&quot;)&#xA;        totalDebits_TXN += amount;&#xA;    else if (drcr == &quot;CR&quot;)&#xA;        totalCredits_TXN += amount;&#xA;}&#xA;&#xA;// === 4. Totals Logging ===&#xA;Console.WriteLine($&quot;📘 GL Statement — Debits: {totalDebits_GL:N2}, Credits: {totalCredits_GL:N2}&quot;);&#xA;Console.WriteLine($&quot;📗 Historical Recon — Debits: {totalDebits_HIST:N2}, Credits: {totalCredits_HIST:N2}&quot;);&#xA;Console.WriteLine($&quot;📙 Transaction Report — Debits: {totalDebits_TXN:N2}, Credits: {totalCredits_TXN:N2}&quot;);&#xA;&#xA;// === 5. Compute GL+HIST Totals ===&#xA;decimal totalGLHISTDR = totalDebits_GL + totalDebits_HIST;&#xA;decimal totalGLHISTCR = totalCredits_GL + totalCredits_HIST;&#xA;decimal glHistDelta = Math.Round(-totalGLHISTDR + totalGLHISTCR, 2); // Equivalent to (-DR + CR)&#xA;Console.WriteLine($&quot;🔍 GL+HIST Combined Total (CR - DR): {glHistDelta:N2}&quot;);&#xA;&#xA;// === 6. System Difference ===&#xA;decimal systemDifference = glClosingBalance - cmsBalance;&#xA;Console.WriteLine($&quot;🧮 System Difference: {systemDifference:N2}&quot;);&#xA;&#xA;// === 7. TXN Net Total ===&#xA;decimal txnNetTotal = Math.Round(totalDebits_TXN + totalCredits_TXN, 2);&#xA;Console.WriteLine($&quot;🔍 TXN Combined Total: {txnNetTotal:N2}&quot;);&#xA;&#xA;// === 8. Delta between GL+HIST and System ===&#xA;decimal delta = Math.Round(systemDifference - glHistDelta, 2);&#xA;Console.WriteLine($&quot;🧾 Delta (System - GL+HIST): {delta:N2}&quot;);&#xA;&#xA;// === 9. Balance Movement Calculation ===&#xA; balanceMovement = Math.Round(delta - txnNetTotal, 2);&#xA;Console.WriteLine($&quot;📊 Balance Movement: {balanceMovement:N2}&quot;);&#xA;&#xA;// === 10. Determine Movement Type ===&#xA; balanceMovementDebitOrCredit = &quot;NEUTRAL&quot;;&#xA;if (balanceMovement &gt; 0)&#xA;{&#xA;    balanceMovementDebitOrCredit = &quot;DEBIT&quot;;&#xA;    Console.WriteLine(&quot;📘 Balance Movement Type: DEBIT&quot;);&#xA;}&#xA;else if (balanceMovement &lt; 0)&#xA;{&#xA;    balanceMovementDebitOrCredit = &quot;CREDIT&quot;;&#xA;    Console.WriteLine(&quot;📕 Balance Movement Type: CREDIT&quot;);&#xA;}&#xA;else&#xA;{&#xA;    Console.WriteLine(&quot;📗 Balance Movement Type: NEUTRAL&quot;);&#xA;}&#xA;" DisplayName="balanceMovement " sap:VirtualizedContainerService.HintSize="449.6,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_14" Language="CSharp">

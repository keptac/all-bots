            <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Ensure the column 'C_NARRATION' exists&#xA;if (!dtTransactionReport.Columns.Contains(&quot;C_NARRATION&quot;))&#xA;{&#xA;    dtTransactionReport.Columns.Add(&quot;C_NARRATION&quot;, typeof(string));&#xA;}&#xA;&#xA;// Process each row&#xA;foreach (DataRow row in dtTransactionReport.Rows)&#xA;{&#xA;    string transactionType = row[&quot;Transaction Type&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;    string cPan = row[&quot;C_PAN&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;    string stan = row.Table.Columns.Contains(&quot;STAN&quot;) ? row[&quot;STAN&quot;]?.ToString()?.Trim() ?? &quot;&quot; : &quot;&quot;;&#xA;    string rrnRaw = row.Table.Columns.Contains(&quot;RRN&quot;) ? row[&quot;RRN&quot;]?.ToString()?.Trim() ?? &quot;&quot; : &quot;&quot;;&#xA;    string authNumber = row.Table.Columns.Contains(&quot;AUTHORIZATION_NUMBER&quot;) ? row[&quot;AUTHORIZATION_NUMBER&quot;]?.ToString()?.Trim() ?? &quot;&quot; : &quot;&quot;;&#xA;&#xA;    // Process RRN: default and pad to 12 digits&#xA;    string rrn = string.IsNullOrEmpty(rrnRaw) ? &quot;000000000000&quot; &#xA;               : rrnRaw.PadLeft(12, '0');&#xA;&#xA;    // Build C_NARRATION&#xA;    row[&quot;C_NARRATION&quot;] = $&quot;{transactionType}-{cPan}-{stan}-{rrn}-{authNumber}&quot;;&#xA;}&#xA;" DisplayName="dtTransactionReport add C_NARRATION " sap:VirtualizedContainerService.HintSize="449.6,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_11" Language="CSharp">

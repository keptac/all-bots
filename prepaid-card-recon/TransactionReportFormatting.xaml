            <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Ensure Search Key Column Exists ===&#xA;if (!dtTransactionReport.Columns.Contains(&quot;Search Key&quot;))&#xA;{&#xA;    dtTransactionReport.Columns.Add(&quot;Search Key&quot;, typeof(string));&#xA;}&#xA;&#xA;// === Prepare column existence flag for RRN only ===&#xA;bool hasRRN = dtTransactionReport.Columns.Contains(&quot;RRN&quot;);&#xA;&#xA;// === Helper: Normalize Search Key ===&#xA;string NormalizeSearchKey(string key) =&gt;&#xA;    Regex.Replace((key ?? &quot;&quot;).Trim(), &quot;[^a-zA-Z0-9]&quot;, &quot;&quot;).ToUpper();&#xA;&#xA;// === Main Loop ===&#xA;foreach (DataRow row in dtTransactionReport.Rows)&#xA;{&#xA;    try&#xA;    {&#xA;        string cPan = row[&quot;C_PAN&quot;]?.ToString()?.Trim().ToUpper() ?? &quot;MISSING_PAN&quot;;&#xA;        if (cPan == &quot;MISSING_PAN&quot;)&#xA;        {&#xA;            row[&quot;Search Key&quot;] = DBNull.Value;&#xA;            continue;&#xA;        }&#xA;&#xA;        string rrn = hasRRN &amp;&amp; row[&quot;RRN&quot;] != DBNull.Value&#xA;            ? row[&quot;RRN&quot;].ToString().Trim().PadLeft(12, '0')&#xA;            : &quot;000000000000&quot;;&#xA;&#xA;        string billingAmountFormatted = decimal.TryParse(row[&quot;Billing Amount&quot;]?.ToString(), out var billingAmount)&#xA;            ? billingAmount.ToString(&quot;F2&quot;)&#xA;            : &quot;0.00&quot;;&#xA;&#xA;        string rawKey = $&quot;{cPan}{rrn}{billingAmountFormatted}&quot;;&#xA;        row[&quot;Search Key&quot;] = NormalizeSearchKey(rawKey);&#xA;    }&#xA;    catch&#xA;    {&#xA;        row[&quot;Search Key&quot;] = DBNull.Value;&#xA;    }&#xA;}&#xA;" DisplayName="dtTransactionReport add Search Key" sap:VirtualizedContainerService.HintSize="449.6,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_9" Language="CSharp">

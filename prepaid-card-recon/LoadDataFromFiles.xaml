              <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Step 0: Ensure reconciliation columns and align schemas without resetting data ===&#xA;&#xA;void EnsureColumns(DataTable table, string tableName, string sourceValue = &quot;&quot;)&#xA;{&#xA;    if (table == null)&#xA;        throw new ArgumentNullException($&quot;{tableName} is null&quot;);&#xA;&#xA;    void AddIfMissing(string name, Type type, object defaultValue)&#xA;    {&#xA;        if (!table.Columns.Contains(name))&#xA;        {&#xA;            var col = new DataColumn(name, type) { DefaultValue = defaultValue };&#xA;            table.Columns.Add(col);&#xA;&#xA;            foreach (DataRow row in table.Rows)&#xA;                row[name] = defaultValue;&#xA;        }&#xA;    }&#xA;&#xA;&#xA;&#xA;    // Add standard reconciliation columns&#xA;&#x9;AddIfMissing(&quot;FOREIGN_CURRENCY&quot;, typeof(bool), false);&#xA;    AddIfMissing(&quot;MATCH&quot;, typeof(bool), false);&#xA;    AddIfMissing(&quot;Duplicate&quot;, typeof(bool), false);&#xA;    AddIfMissing(&quot;GROUP_MATCHED&quot;, typeof(bool), false);&#xA;    AddIfMissing(&quot;usonus&quot;, typeof(bool), false);&#xA;    AddIfMissing(&quot;ProductCode&quot;, typeof(string), sourceValue ?? &quot;&quot;);&#xA;    AddIfMissing(&quot;source&quot;, typeof(string), sourceValue ?? &quot;&quot;);&#xA;    AddIfMissing(&quot;C_PAN_AMOUNT&quot;, typeof(string), &quot;&quot;);&#xA;    AddIfMissing(&quot;C_PAN&quot;, typeof(string), &quot;&quot;);&#xA;    AddIfMissing(&quot;RRN&quot;, typeof(string), &quot;&quot;);&#xA;    AddIfMissing(&quot;STAN&quot;, typeof(string), &quot;&quot;);&#xA;    AddIfMissing(&quot;AUTHORIZATION_NUMBER&quot;, typeof(string), &quot;&quot;);&#xA;    AddIfMissing(&quot;C_NARRATION&quot;, typeof(string), &quot;&quot;);&#xA;    AddIfMissing(&quot;EXTRACTED_TERMINAL_ID&quot;, typeof(string), &quot;&quot;);&#xA;    AddIfMissing(&quot;Search Key&quot;, typeof(string), &quot;&quot;);&#xA;    AddIfMissing(&quot;TIME&quot;, typeof(string), &quot;&quot;);&#xA;    AddIfMissing(&quot;C_PAN_AMOUNT_DATE_TIME&quot;, typeof(string), &quot;&quot;);&#xA;    AddIfMissing(&quot;C_PAN_AUTHORIZATION_NUMBER&quot;, typeof(string), &quot;&quot;);&#xA;    AddIfMissing(&quot;RRN_GROUP&quot;, typeof(string), &quot;&quot;);&#xA;&#x9;AddIfMissing(&quot;MEMO&quot;, typeof(string), &quot;&quot;);&#xA;}&#xA;&#xA;void EnsureMatchingColumns(DataTable target, DataTable reference, string targetName)&#xA;{&#xA;    if (target == null)&#xA;        throw new ArgumentNullException($&quot;{targetName} is null.&quot;);&#xA;    if (reference == null)&#xA;        throw new ArgumentNullException(&quot;Reference DataTable is null.&quot;);&#xA;&#xA;    foreach (DataColumn refCol in reference.Columns)&#xA;    {&#xA;        string name = refCol.ColumnName;&#xA;&#xA;        if (!target.Columns.Contains(name))&#xA;        {&#xA;            var newCol = new DataColumn(name, refCol.DataType)&#xA;            {&#xA;                DefaultValue = refCol.DefaultValue&#xA;            };&#xA;&#xA;            target.Columns.Add(newCol);&#xA;&#xA;            foreach (DataRow row in target.Rows)&#xA;                row[name] = newCol.DefaultValue;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Apply to all target DataTables ===&#xA;EnsureColumns(dtGlStatement, &quot;dtGlStatement&quot;, &quot;GL&quot;);&#xA;EnsureColumns(dtTransactionReport, &quot;dtTransactionReport&quot;, &quot;CMS&quot;);&#xA;EnsureColumns(dtHistoricalReconTransactionsReport, &quot;dtHistoricalReconTransactionsReport&quot;, &quot;HIST&quot;);&#xA;&#xA;// Ensure GL and CMS tables have any extra columns present in HIST&#xA;EnsureMatchingColumns(dtGlStatement, dtHistoricalReconTransactionsReport, &quot;dtGlStatement&quot;);&#xA;EnsureMatchingColumns(dtTransactionReport, dtHistoricalReconTransactionsReport, &quot;dtTransactionReport&quot;);&#xA;" DisplayName="Add Column MATCH, source, C_PAN_AMOUNT to all datatables" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:Workflo
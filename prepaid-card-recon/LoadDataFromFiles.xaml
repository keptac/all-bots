                        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// In:  historicalReconReportFile (String)&#xA;// In/Out: glCutOffBalance (Decimal)&#xA;// Out: dtHistoricalReconTransactionsReport (DataTable)&#xA;&#xA;Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);&#xA;&#xA;// === 1. Read the workbook&#xA;DataSet result;&#xA;using (var stream = File.Open(historicalReconReportFile, FileMode.Open, FileAccess.Read))&#xA;using (var reader = ExcelReaderFactory.CreateReader(stream))&#xA;{&#xA;    result = reader.AsDataSet(new ExcelDataSetConfiguration&#xA;    {&#xA;        ConfigureDataTable = _ =&gt; new ExcelDataTableConfiguration { UseHeaderRow = false }&#xA;    });&#xA;}&#xA;&#xA;// === 2. Grab the “Recon Report” sheet&#xA;var sheet = result.Tables[&quot;Recon Report&quot;]&#xA;    ?? throw new Exception(&quot;Worksheet 'Recon Report' not found.&quot;);&#xA;&#xA;// === 3. Extract glCutOffBalance from cell K9 (row 8, column 10)&#xA;glCutOffBalance = 0m;&#xA;if (sheet.Rows.Count &gt; 8 &amp;&amp; sheet.Columns.Count &gt; 10)&#xA;{&#xA;    var raw = sheet.Rows[8][10]?.ToString()?.Trim()&#xA;        .Replace(&quot;,&quot;, &quot;&quot;)&#xA;        .Replace(&quot;(&quot;, &quot;-&quot;)&#xA;        .Replace(&quot;)&quot;, &quot;&quot;) ?? &quot;&quot;;&#xA;&#xA;    if (!decimal.TryParse(raw, NumberStyles.Any, CultureInfo.InvariantCulture, out glCutOffBalance))&#xA;        Console.WriteLine($&quot;⚠️ Could not parse value from K9: '{raw}'&quot;);&#xA;    else&#xA;        Console.WriteLine($&quot;✅ glCutOffBalance (K9): {glCutOffBalance:N2}&quot;);&#xA;}&#xA;&#xA;// === 4. Read header row (row 17 = index 16)&#xA;var headerRow = sheet.Rows[16].ItemArray.Select(x =&gt; x?.ToString()?.Trim() ?? &quot;&quot;).ToList();&#xA;&#xA;// === 5. Define required columns&#xA;var desiredColumns = new[]&#xA;{&#xA;    &quot;SNO&quot;, &quot;Branch code&quot;, &quot;GL_Code&quot;, &quot;GL Description&quot;, &quot;Booking Date&quot;, &quot;Value Date&quot;,&#xA;    &quot;Transaction Ref No:&quot;, &quot;Narration&quot;, &quot;Debit (TZS)&quot;, &quot;Credit (TZS)&quot;,&#xA;    &quot;Aging&quot;, &quot;Aging Group&quot;, &quot;BOT Classification&quot;, &quot;Root Cause&quot;,&#xA;    &quot;Root Cause Category&quot;, &quot;Recommended Action&quot;, &quot;Action Owner&quot;&#xA;};&#xA;&#xA;// === 6. Validate columns exist and map indices&#xA;var columnIndices = new Dictionary&lt;string, int&gt;();&#xA;foreach (var col in desiredColumns)&#xA;{&#xA;    int idx = headerRow.IndexOf(col);&#xA;    if (idx == -1)&#xA;        throw new Exception($&quot;❌ Required column '{col}' not found in header row.&quot;);&#xA;    columnIndices[col] = idx;&#xA;}&#xA;&#xA;// === 7. Build DataTable schema&#xA;var dt = new DataTable();&#xA;foreach (var col in desiredColumns)&#xA;    dt.Columns.Add(col, typeof(string));&#xA;&#xA;// === 8. Read rows from index 17 onward (row 18 in Excel)&#xA;int loaded = 0;&#xA;string[] requiredFieldsForValidation = {&#xA;    &quot;SNO&quot;, &quot;Branch code&quot;, &quot;GL_Code&quot;, &quot;GL Description&quot;,&#xA;    &quot;Booking Date&quot;, &quot;Value Date&quot;, &quot;Narration&quot;&#xA;};&#xA;&#xA;for (int r = 17; r &lt; sheet.Rows.Count; r++)&#xA;{&#xA;    var excelRow = sheet.Rows[r];&#xA;    var newRow = dt.NewRow();&#xA;    bool hasData = false;&#xA;&#xA;    foreach (var col in desiredColumns)&#xA;    {&#xA;        int idx = columnIndices[col];&#xA;        string val = (idx &gt;= 0 &amp;&amp; idx &lt; excelRow.ItemArray.Length)&#xA;            ? excelRow[idx]?.ToString()?.Trim() ?? &quot;&quot;&#xA;            : &quot;&quot;;&#xA;        newRow[col] = val;&#xA;        if (!string.IsNullOrWhiteSpace(val)) hasData = true;&#xA;    }&#xA;&#xA;    if (!hasData) continue;&#xA;&#xA;    // ✅ Skip if any critical field is missing&#xA;    bool isRowValid = requiredFieldsForValidation.All(col =&gt;&#xA;    {&#xA;        var val = newRow[col]?.ToString()?.Trim();&#xA;        return !string.IsNullOrWhiteSpace(val);&#xA;    });&#xA;&#xA;    if (!isRowValid) continue;&#xA;&#xA;    dt.Rows.Add(newRow);&#xA;    loaded++;&#xA;}&#xA;&#xA;Console.WriteLine($&quot;✅ Loaded {loaded} filtered rows with full required fields.&quot;);&#xA;&#xA;// === 9. Parse numeric columns: Debit and Credit&#xA;dt.Columns.Add(&quot;Debit (TZS)_Parsed&quot;, typeof(decimal));&#xA;dt.Columns.Add(&quot;Credit (TZS)_Parsed&quot;, typeof(decimal));&#xA;&#xA;Func&lt;string, decimal&gt; parseAmount = s =&gt;&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(s)) return 0m;&#xA;    var clean = s.Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;).Replace(&quot;,&quot;, &quot;&quot;).Trim();&#xA;    return decimal.TryParse(clean, NumberStyles.Any, CultureInfo.InvariantCulture, out var v) ? v : 0m;&#xA;};&#xA;&#xA;foreach (DataRow row in dt.Rows)&#xA;{&#xA;    row[&quot;Debit (TZS)_Parsed&quot;] = parseAmount(row[&quot;Debit (TZS)&quot;]?.ToString());&#xA;    row[&quot;Credit (TZS)_Parsed&quot;] = parseAmount(row[&quot;Credit (TZS)&quot;]?.ToString());&#xA;}&#xA;&#xA;// === 10. Replace original amount columns&#xA;dt.Columns.Remove(&quot;Debit (TZS)&quot;);&#xA;dt.Columns.Remove(&quot;Credit (TZS)&quot;);&#xA;dt.Columns[&quot;Debit (TZS)_Parsed&quot;].ColumnName = &quot;Debit (TZS)&quot;;&#xA;dt.Columns[&quot;Credit (TZS)_Parsed&quot;].ColumnName = &quot;Credit (TZS)&quot;;&#xA;&#xA;// === 11. Assign output&#xA;dtHistoricalReconTransactionsReport = dt;&#xA;&#xA;// === 12. Log summary stats&#xA;int negCreditCount = dt.AsEnumerable().Count(r =&gt; r.Field&lt;decimal&gt;(&quot;Credit (TZS)&quot;) &lt; 0);&#xA;decimal totalDebit = dt.AsEnumerable().Sum(r =&gt; r.Field&lt;decimal&gt;(&quot;Debit (TZS)&quot;));&#xA;decimal totalCredit = dt.AsEnumerable().Sum(r =&gt; r.Field&lt;decimal&gt;(&quot;Credit (TZS)&quot;));&#xA;&#xA;Console.WriteLine($&quot;🔢 Rows with negative Credit: {negCreditCount}&quot;);&#xA;Console.WriteLine($&quot;💰 Total Debit (TZS):  {totalDebit:N2}&quot;);&#xA;Console.WriteLine($&quot;💳 Total Credit (TZS): {totalCredit:N2}&quot;);&#xA;" DisplayName="Load Recon Report" sap:VirtualizedContainerService.HintSize="416,48" sap2010:WorkflowViewState.IdRef="InvokeCode_20" Language="CSharp">

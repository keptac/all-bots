                <ui:InvokeCode ContinueOnError="{x:Null}" Code="&#xA;&#xA;// Inputs&#xA;// string historicalReconReportFile&#xA;// ref decimal glCutOffBalance&#xA;// out DataTable dtHistoricalReconTransactionsReport&#xA;&#xA;Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);&#xA;&#xA;// === 1. Read Excel file&#xA;DataSet result;&#xA;using (var stream = File.Open(historicalReconReportFile, FileMode.Open, FileAccess.Read))&#xA;using (var reader = ExcelReaderFactory.CreateReader(stream))&#xA;{&#xA;    result = reader.AsDataSet(new ExcelDataSetConfiguration&#xA;    {&#xA;        ConfigureDataTable = _ =&gt; new ExcelDataTableConfiguration { UseHeaderRow = false }&#xA;    });&#xA;}&#xA;&#xA;// === 2. Get the 'Recon Report' sheet&#xA;var sheet = result.Tables[&quot;Recon Report&quot;]&#xA;    ?? throw new Exception(&quot;Worksheet 'Recon Report' not found.&quot;);&#xA;&#xA;// === 3. Extract glCutOffBalance from cell K9 (row 8, col 10)&#xA;glCutOffBalance = 0m;&#xA;if (sheet.Rows.Count &gt; 8 &amp;&amp; sheet.Columns.Count &gt; 10)&#xA;{&#xA;    var raw = sheet.Rows[8][10]?.ToString()?.Trim()&#xA;        .Replace(&quot;,&quot;, &quot;&quot;)&#xA;        .Replace(&quot;(&quot;, &quot;-&quot;)&#xA;        .Replace(&quot;)&quot;, &quot;&quot;) ?? &quot;&quot;;&#xA;&#xA;    if (!decimal.TryParse(raw, NumberStyles.Any, CultureInfo.InvariantCulture, out glCutOffBalance))&#xA;        Console.WriteLine($&quot;⚠️ Could not parse value from K9: '{raw}'&quot;);&#xA;    else&#xA;        Console.WriteLine($&quot;✅ glCutOffBalance (K9): {glCutOffBalance:N2}&quot;);&#xA;}&#xA;&#xA;// === 4. Define expected header structure (column name and type)&#xA;var orderedColumns = new (string Name, Type Type)[]&#xA;{&#xA;    (&quot;SNO&quot;, typeof(string)),&#xA;    (&quot;Branch code&quot;, typeof(string)),&#xA;    (&quot;GL_Code&quot;, typeof(string)),&#xA;    (&quot;GL Description&quot;, typeof(string)),&#xA;    (&quot;Booking Date&quot;, typeof(string)),&#xA;    (&quot;Value Date&quot;, typeof(string)),&#xA;    (&quot;Transaction Ref No:&quot;, typeof(string)),&#xA;    (&quot;Narration&quot;, typeof(string)),&#xA;    (&quot;Debit (TZS)&quot;, typeof(decimal)),&#xA;    (&quot;Credit (TZS)&quot;, typeof(decimal)),&#xA;    (&quot;Aging&quot;, typeof(string)),&#xA;    (&quot;Aging Group&quot;, typeof(string)),&#xA;    (&quot;BOT Classification&quot;, typeof(string)),&#xA;    (&quot;Root Cause&quot;, typeof(string)),&#xA;    (&quot;Root Cause Category&quot;, typeof(string)),&#xA;    (&quot;Recommended Action&quot;, typeof(string)),&#xA;    (&quot;Action Owner&quot;, typeof(string))&#xA;};&#xA;&#xA;// === 5. Read actual header row from Excel row 17 (index 16)&#xA;var headerRow = sheet.Rows[16].ItemArray.Select(x =&gt; x?.ToString()?.Trim() ?? &quot;&quot;).ToList();&#xA;var columnIndices = new Dictionary&lt;string, int&gt;();&#xA;&#xA;foreach (var (name, _) in orderedColumns)&#xA;{&#xA;    int idx = headerRow.IndexOf(name);&#xA;    if (idx == -1)&#xA;        throw new Exception($&quot;❌ Column '{name}' not found in Excel header row.&quot;);&#xA;    columnIndices[name] = idx;&#xA;}&#xA;&#xA;// === 6. Setup new DataTable with correct order &amp; types&#xA;var finalDt = new DataTable();&#xA;foreach (var col in orderedColumns)&#xA;    finalDt.Columns.Add(col.Name, col.Type);&#xA;&#xA;// === 7. Load data from Excel row 18 onward (index 17)&#xA;int loaded = 0;&#xA;string[] requiredFields = { &quot;SNO&quot;, &quot;Branch code&quot;, &quot;GL_Code&quot;, &quot;GL Description&quot;, &quot;Booking Date&quot;, &quot;Value Date&quot;, &quot;Narration&quot; };&#xA;&#xA;Func&lt;string, decimal&gt; parseAmount = s =&gt;&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(s)) return 0m;&#xA;    var clean = s.Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;).Replace(&quot;,&quot;, &quot;&quot;).Trim();&#xA;    return decimal.TryParse(clean, NumberStyles.Any, CultureInfo.InvariantCulture, out var v) ? v : 0m;&#xA;};&#xA;&#xA;for (int r = 17; r &lt;
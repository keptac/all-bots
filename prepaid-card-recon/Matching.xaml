                <ui:InvokeCode ContinueOnError="{x:Null}" Code="//  ✅ C_PAN + RRN exact/subset matching&#xA;//  ✅ Grouped ARN(23) + C_PAN vs RRN + C_PAN sum matching&#xA;//This code avoids clearing source tables (dtGlStatement, dtTransactionReport), adds to matched DataTables, and removes only matched rows from sources.&#xA;&#xA;&#xA;// === Normalization and Helpers ===&#xA;Regex normalizeRegex = new Regex(&quot;[^a-zA-Z0-9]&quot;, RegexOptions.Compiled);&#xA;&#xA;string Normalize(string val) =&gt;&#xA;    normalizeRegex.Replace((val ?? &quot;&quot;).Trim(), &quot;&quot;).ToUpperInvariant();&#xA;&#xA;string GetSearchKey(DataRow row)&#xA;{&#xA;    string pan = Normalize(row[&quot;C_PAN&quot;]?.ToString());&#xA;    string rrn = Normalize(row[&quot;RRN&quot;]?.ToString());&#xA;    return (!string.IsNullOrEmpty(pan) &amp;&amp; rrn.Length &gt; 0) ? pan + rrn : &quot;INVALID_KEY&quot;;&#xA;}&#xA;&#xA;decimal GetAmount(DataRow row, string col1, string col2)&#xA;{&#xA;    string val1 = row[col1]?.ToString()?.Replace(&quot;,&quot;, &quot;&quot;) ?? &quot;&quot;;&#xA;    string val2 = row[col2]?.ToString()?.Replace(&quot;,&quot;, &quot;&quot;) ?? &quot;&quot;;&#xA;    if (decimal.TryParse(val1, out var d)) return d;&#xA;    if (decimal.TryParse(val2, out var c)) return c;&#xA;    return 0m;&#xA;}&#xA;&#xA;IEnumerable&lt;List&lt;T&gt;&gt; GetSubsets&lt;T&gt;(List&lt;T&gt; items, int maxSubsetSize = 6)&#xA;{&#xA;    int n = items.Count;&#xA;    for (int size = 1; size &lt;= Math.Min(maxSubsetSize, n); size++)&#xA;    {&#xA;        int[] indices = Enumerable.Range(0, size).ToArray();&#xA;        while (true)&#xA;        {&#xA;            yield return indices.Select(i =&gt; items[i]).ToList();&#xA;&#xA;            int t = size - 1;&#xA;            while (t &gt;= 0 &amp;&amp; indices[t] == n - size + t) t--;&#xA;            if (t &lt; 0) break;&#xA;&#xA;            indices[t]++;&#xA;            for (int i = t + 1; i &lt; size; i++)&#xA;                indices[i] = indices[i - 1] + 1;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Grouped Matching Keys ===&#xA;string GetArnCpanKey(DataRow row)&#xA;{&#xA;    string arn = row[&quot;ARN&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;    string cpan = Normalize(row[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;);&#xA;    return (arn.Length &gt;= 23 ? arn.Substring(0, 23) : arn) + &quot;|&quot; + cpan;&#xA;}&#xA;&#xA;string GetRrnCpanKey(DataRow row)&#xA;{&#xA;    string rrn = Normalize(row[&quot;RRN&quot;]?.ToString() ?? &quot;&quot;);&#xA;    string cpan = Normalize(row[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;);&#xA;    return rrn + &quot;|&quot; + cpan;&#xA;}&#xA;&#xA;// === Indexing Phase ===&#xA;var glIndex = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;();&#xA;var txnIndex = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;();&#xA;var glMatched = new HashSet&lt;DataRow&gt;();&#xA;var txnMatched = new HashSet&lt;DataRow&gt;();&#xA;int matchCount = 0;&#xA;&#xA;foreach (DataRow row in dtGlStatement.Rows)&#xA;{&#xA;    string key = GetSearchKey(row);&#xA;    if (key != &quot;INVALID_KEY&quot;)&#xA;    {&#xA;        if (!glIndex.ContainsKey(key))&#xA;            glIndex[key] = new List&lt;DataRow&gt;();&#xA;        glIndex[key].Add(row);&#xA;    }&#xA;}&#xA;&#xA;foreach (DataRow row in dtTransactionReport.Rows)&#xA;{&#xA;    string key = GetSearchKey(row);&#xA;    if (key != &quot;INVALID_KEY&quot;)&#xA;    {&#xA;        if (!txnIndex.ContainsKey(key))&#xA;            txnIndex[key] = new List&lt;DataRow&gt;();&#xA;        txnIndex[key].Add(row);&#xA;    }&#xA;}&#xA;&#xA;// === C_PAN + RRN Subset Matching ===&#xA;foreach (var key in glIndex.Keys.Intersect(txnIndex.Keys))&#xA;{&#xA;    var glRows = glIndex[key].Where(r =&gt; !glMatched.Contains(r)).ToList();&#xA;    var txnRows = txnIndex[key].Where(r =&gt; !txnMatched.Contains(r)).ToList();&#xA;&#xA;    foreach (var glRow in glRows)&#xA;    {&#xA;        decimal glAmt = Math.Round(GetAmount(glRow, &quot;Debit (TZS)&quot;, &quot;Credit (TZS)&quot;), 2);&#xA;        if (glAmt == 0) continue;&#xA;&#xA;        foreach (var subset in GetSubsets(txnRows))&#xA;        {&#xA;            if (subset.Any(txn =&gt; txnMatched.Contains(txn))) continue;&#xA;&#xA;            decimal txnSum = Math.Round(subset.Sum(t =&gt; GetAmount(t, &quot;Billing Amount&quot;, &quot;Billing Amount&quot;)), 2);&#xA;            if (txnSum == glAmt)&#xA;            {&#xA;                glMatched.Add(glRow);&#xA;                dtGlStatementMatched.Rows.Add(glRow.ItemArray);&#xA;&#xA;                foreach (var tx in subset)&#xA;                {&#xA;                    txnMatched.Add(tx);&#xA;                    dtTransactionReportMatched.Rows.Add(tx.ItemArray);&#xA;                }&#xA;&#xA;                matchCount++;&#xA;                break;&#xA;            }&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Grouped Matching: ARN(23) + C_PAN vs RRN + C_PAN ===&#xA;var arnGroups = dtTransactionReport.AsEnumerable()&#xA;    .Where(r =&gt; !string.IsNullOrWhiteSpace(r[&quot;ARN&quot;]?.ToString()) &amp;&amp; !string.IsNullOrWhiteSpace(r[&quot;C_PAN&quot;]?.ToString()))&#xA;    .GroupBy(r =&gt; GetArnCpanKey(r))&#xA;    .ToDictionary(g =&gt; g.Key, g =&gt; g.ToList());&#xA;&#xA;var rrnGroups = dtGlStatement.AsEnumerable()&#xA;    .Where(r =&gt; !string.IsNullOrWhiteSpace(r[&quot;RRN&quot;]?.ToString()) &amp;&amp; !string.IsNullOrWhiteSpace(r[&quot;C_PAN&quot;]?.ToString()))&#xA;    .GroupBy(r =&gt; GetRrnCpanKey(r))&#xA;    .ToDictionary(g =&gt; g.Key, g =&gt; g.ToList());&#xA;&#xA;int groupMatchCount = 0;&#xA;&#xA;foreach (var arnGroup in arnGroups)&#xA;{&#xA;    string groupKey = arnGroup.Key;&#xA;    var txnRows = arnGroup.Value.Where(r =&gt; !txnMatched.Contains(r)).ToList();&#xA;    decimal txnSum = txnRows.Sum(r =&gt; GetAmount(r, &quot;Billing Amount&quot;, &quot;Billing Amount&quot;));&#xA;&#xA;    if (rrnGroups.TryGetValue(groupKey, out var glRows))&#xA;    {&#xA;        var unMatchedGLs = glRows.Where(r =&gt; !glMatched.Contains(r)).ToList();&#xA;        decimal glSum = unMatchedGLs.Sum(r =&gt; GetAmount(r, &quot;Debit (TZS)&quot;, &quot;Credit (TZS)&quot;));&#xA;&#xA;        if (Math.Round(txnSum, 2) == Math.Round(glSum, 2))&#xA;        {&#xA;            foreach (var tx in txnRows)&#xA;            {&#xA;                txnMatched.Add(tx);&#xA;                dtTransactionReportMatched.Rows.Add(tx.ItemArray);&#xA;            }&#xA;&#xA;            foreach (var gl in unMatchedGLs)&#xA;            {&#xA;                glMatched.Add(gl);&#xA;                dtGlStatementMatched.Rows.Add(gl.ItemArray);&#xA;            }&#xA;&#xA;            groupMatchCount++;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Final Removal ===&#xA;int removedGL = 0, removedTXN = 0;&#xA;&#xA;for (int i = dtGlStatement.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    if (glMatched.Contains(dtGlStatement.Rows[i]))&#xA;    {&#xA;        dtGlStatement.Rows.RemoveAt(i);&#xA;        removedGL++;&#xA;    }&#xA;}&#xA;&#xA;for (int i = dtTransactionReport.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    if (txnMatched.Contains(dtTransactionReport.Rows[i]))&#xA;    {&#xA;        dtTransactionReport.Rows.RemoveAt(i);&#xA;        removedTXN++;&#xA;    }&#xA;}&#xA;&#xA;// === Final Logs ===&#xA;Console.WriteLine(&quot;=== Combined Matching Summary ===&quot;);&#xA;Console.WriteLine($&quot;✅ Subset Match Count (C_PAN + RRN): {matchCount}&quot;);&#xA;Console.WriteLine($&quot;✅ Grouped Match Count (ARN+C_PAN vs RRN+C_PAN): {groupMatchCount}&quot;);&#xA;Console.WriteLine($&quot;🧹 Total GL Removed: {removedGL}&quot;);&#xA;Console.WriteLine($&quot;🧹 Total TXN Removed: {removedTXN}&quot;);&#xA;Console.WriteLine($&quot;📊 Remaining GL: {dtGlStatement.Rows.Count}&quot;);&#xA;Console.WriteLine($&quot;📊 Remaining TXN: {dtTransactionReport.Rows.Count}&quot;);&#xA;" DisplayName="dtGlStatement VS dtTransactionReport" sap:VirtualizedContainerService.HintSize="439.2,188" sap2010:WorkflowViewState.IdRef="InvokeCode_266" Language="CSharp">

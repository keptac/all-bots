        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Step 1: Define target match code ===&#xA;const string matchCode = &quot;LOAD/RELOAD&quot;;&#xA;&#xA;// === Step 2: Collect matching rows and indices in a single pass ===&#xA;var matchingRows = new List&lt;DataRow&gt;();&#xA;var rowIndicesToDelete = new List&lt;int&gt;();&#xA;&#xA;for (int i = 0; i &lt; dtTransactionReport.Rows.Count; i++)&#xA;{&#xA;    var row = dtTransactionReport.Rows[i];&#xA;    var type = row[&quot;Transaction Type&quot;]?.ToString()?.Trim().ToUpperInvariant();&#xA;&#xA;    if (type == matchCode)&#xA;    {&#xA;        matchingRows.Add(row);&#xA;        rowIndicesToDelete.Add(i);&#xA;    }&#xA;}&#xA;&#xA;Console.WriteLine($&quot;[INFO] Matched LOAD/RELOAD rows: {matchingRows.Count}&quot;);&#xA;&#xA;// === Step 3: Import into destination table ===&#xA;foreach (var row in matchingRows)&#xA;    dtTransactionReportLoadAndReload.ImportRow(row);&#xA;&#xA;// === Step 4: Remove from source in reverse order ===&#xA;for (int i = rowIndicesToDelete.Count - 1; i &gt;= 0; i--)&#xA;    dtTransactionReport.Rows.RemoveAt(rowIndicesToDelete[i]);&#xA;&#xA;// === Step 5: Commit changes if absolutely required ===&#xA;dtTransactionReport.AcceptChanges(); // ⚠️ Only if you're done with this table&#xA;" DisplayName="dtTransactionReportLoadAndReload" sap:VirtualizedContainerService.HintSize="456.6666666666667,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_225" Language="CSharp">

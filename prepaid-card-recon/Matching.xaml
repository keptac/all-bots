        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Regex Normalize ===&#xD;&#xA;Regex normalizeRegex = new Regex(&quot;[^a-zA-Z0-9]&quot;, RegexOptions.Compiled);&#xD;&#xA;string Normalize(string input) =&gt;&#xD;&#xA;    normalizeRegex.Replace((input ?? &quot;&quot;).Trim(), &quot;&quot;).ToUpperInvariant();&#xD;&#xA;&#xD;&#xA;decimal SafeParseDecimal(object value)&#xD;&#xA;{&#xD;&#xA;    var raw = value?.ToString()?.Replace(&quot;,&quot;, &quot;&quot;).Trim();&#xD;&#xA;    return decimal.TryParse(raw, out var result) ? result : 0m;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;DateTime? ExtractDate(string narration)&#xD;&#xA;{&#xD;&#xA;    if (string.IsNullOrWhiteSpace(narration)) return null;&#xD;&#xA;&#xD;&#xA;    var match = Regex.Match(narration, @&quot;\d{4}-\d{2}-\d{2}&quot;);&#xD;&#xA;    if (match.Success &amp;&amp;&#xD;&#xA;        DateTime.TryParseExact(match.Value, &quot;yyyy-MM-dd&quot;, CultureInfo.InvariantCulture, DateTimeStyles.None, out var result))&#xD;&#xA;        return result;&#xD;&#xA;&#xD;&#xA;    return null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;bool TryParseDate(object value, out DateTime result)&#xD;&#xA;{&#xD;&#xA;    return DateTime.TryParse(value?.ToString(), out result);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// === Ensure MATCH columns ===&#xD;&#xA;void EnsureMatchColumn(DataTable dt)&#xD;&#xA;{&#xD;&#xA;    if (!dt.Columns.Contains(&quot;MATCH&quot;))&#xD;&#xA;    {&#xD;&#xA;        var col = dt.Columns.Add(&quot;MATCH&quot;, typeof(bool));&#xD;&#xA;        col.DefaultValue = false;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;EnsureMatchColumn(dtGlStatementManualEntries);&#xD;&#xA;EnsureMatchColumn(dtHistoricalReconTransactionsReport);&#xD;&#xA;&#xD;&#xA;// === Step 1: Filter Historical: Refund not yet posted ===&#xD;&#xA;var histFiltered = dtHistoricalReconTransactionsReport.AsEnumerable()&#xD;&#xA;    .Where(r =&gt; r[&quot;Root Cause&quot;]?.ToString()?.Trim() == &quot;Refund not yet posted&quot; &amp;&amp;&#xD;&#xA;                r[&quot;C_PAN&quot;] != DBNull.Value)&#xD;&#xA;    .ToList();&#xD;&#xA;&#xD;&#xA;if (histFiltered.Count == 0)&#xD;&#xA;{&#xD;&#xA;    Console.WriteLine(&quot;[INFO] No matching 'Refund not yet posted' rows in historical data.&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// === Step 2: Build lookup of Historical by (C_PAN + Amount) ===&#xD;&#xA;var histLookup = histFiltered&#xD;&#xA;    .Select(r =&gt;&#xD;&#xA;    {&#xD;&#xA;        string pan = r[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xD;&#xA;        decimal amount = SafeParseDecimal(r[&quot;Debit (TZS)&quot;]) + SafeParseDecimal(r[&quot;Credit (TZS)&quot;]);&#xD;&#xA;        string key = Normalize(pan) + Math.Round(amount, 2).ToString(&quot;F2&quot;);&#xD;&#xA;        return new { Row = r, Key = key };&#xD;&#xA;    })&#xD;&#xA;    .GroupBy(x =&gt; x.Key)&#xD;&#xA;    .ToDictionary(g =&gt; g.Key, g =&gt; g.Select(x =&gt; x.Row).ToList());&#xD;&#xA;&#xD;&#xA;// === Step 3: Match tracking ===&#xD;&#xA;var glMatched = new HashSet&lt;DataRow&gt;();&#xD;&#xA;var histMatched = new HashSet&lt;DataRow&gt;();&#xD;&#xA;&#xD;&#xA;// === Step 4: One-to-One Matching ===&#xD;&#xA;foreach (DataRow glRow in dtGlStatementManualEntries.Rows)&#xD;&#xA;{&#xD;&#xA;    if (glMatched.Contains(glRow)) continue;&#xD;&#xA;&#xD;&#xA;    string cPan = glRow[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xD;&#xA;    string narration = glRow[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;;&#xD;&#xA;    DateTime? narrationDate = ExtractDate(narration);&#xD;&#xA;    if (narrationDate == null) continue;&#xD;&#xA;&#xD;&#xA;    decimal amount = SafeParseDecimal(glRow[&quot;Debit (TZS)&quot;]) + SafeParseDecimal(glRow[&quot;Credit (TZS)&quot;]);&#xD;&#xA;    if (amount == 0m) continue;&#xD;&#xA;&#xD;&#xA;    string key = Normalize(cPan) + Math.Round(amount, 2).ToString(&quot;F2&quot;);&#xD;&#xA;    if (!histLookup.TryGetValue(key, out var candidates)) continue;&#xD;&#xA;&#xD;&#xA;    var match = candidates.FirstOrDefault(histRow =&gt;&#xD;&#xA;        !histMatched.Contains(histRow) &amp;&amp;&#xD;&#xA;        TryParseDate(histRow[&quot;Booking Date&quot;], out var bookingDate) &amp;&amp;&#xD;&#xA;        Math.Abs((bookingDate - narrationDate.Value).TotalDays) &lt;= 1);&#xD;&#xA;&#xD;&#xA;    if (match != null)&#xD;&#xA;    {&#xD;&#xA;        glRow[&quot;MATCH&quot;] = true;&#xD;&#xA;        match[&quot;MATCH&quot;] = true;&#xD;&#xA;        glMatched.Add(glRow);&#xD;&#xA;        histMatched.Add(match);&#xD;&#xA;        dtGlStatementMatched.ImportRow(glRow);&#xD;&#xA;        dtHistoricalReconTransactionsReportMatched.ImportRow(match);&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// === Step 5: Remove Matched Rows ===&#xD;&#xA;int removedGl = 0, removedHist = 0;&#xD;&#xA;&#xD;&#xA;for (int i = dtGlStatementManualEntries.Rows.Count - 1; i &gt;= 0; i--)&#xD;&#xA;{&#xD;&#xA;    if (glMatched.Contains(dtGlStatementManualEntries.Rows[i]))&#xD;&#xA;    {&#xD;&#xA;        dtGlStatementManualEntries.Rows.RemoveAt(i);&#xD;&#xA;        removedGl++;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;for (int i = dtHistoricalReconTransactionsReport.Rows.Count - 1; i &gt;= 0; i--)&#xD;&#xA;{&#xD;&#xA;    if (histMatched.Contains(dtHistoricalReconTransactionsReport.Rows[i]))&#xD;&#xA;    {&#xD;&#xA;        dtHistoricalReconTransactionsReport.Rows.RemoveAt(i);&#xD;&#xA;        removedHist++;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// === Step 6: Logging Summary ===&#xD;&#xA;Console.WriteLine($&quot;✅ One-to-One MATCHED: {glMatched.Count} GL ↔ {histMatched.Count} HISTORICAL rows.&quot;);&#xD;&#xA;Console.WriteLine($&quot;🧹 REMOVED: {removedGl} from Manual Entries, {removedHist} from Historical source.&quot;);&#xD;&#xA;Console.WriteLine($&quot;📊 REMAINING: Manual = {dtGlStatementManualEntries.Rows.Count}, Historical = {dtHistoricalReconTransactionsReport.Rows.Count}&quot;);&#xD;&#xA;" DisplayName="dtGlStatementManualEntries VS HISTO" sap:VirtualizedContainerService.HintSize="495.3333333333333,197.33333333333334" sap2010:WorkflowViewState.IdRef="Invo
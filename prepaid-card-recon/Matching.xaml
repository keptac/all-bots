        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Setup &amp; Helpers ===&#xA;Regex nonAlphanumeric = new Regex(&quot;[^a-zA-Z0-9]&quot;, RegexOptions.Compiled);&#xA;&#xA;string Normalize(string val) =&gt;&#xA;    nonAlphanumeric.Replace((val ?? &quot;&quot;).Trim(), &quot;&quot;).ToUpperInvariant();&#xA;&#xA;string GetKey(string pan, string rrn) =&gt;&#xA;    Normalize(pan) + Normalize(rrn?.PadLeft(12, '0') ?? &quot;000000000000&quot;);&#xA;&#xA;decimal ParseAmount(object val)&#xA;{&#xA;    if (val == DBNull.Value || val == null) return 0m;&#xA;    string raw = val.ToString().Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;).Trim();&#xA;    return decimal.TryParse(raw, out var result) ? result : 0m;&#xA;}&#xA;&#xA;// === MATCH Columns ===&#xA;void EnsureMatchColumn(DataTable dt)&#xA;{&#xA;    if (!dt.Columns.Contains(&quot;MATCH&quot;))&#xA;    {&#xA;        var col = dt.Columns.Add(&quot;MATCH&quot;, typeof(bool));&#xA;        col.DefaultValue = false;&#xA;    }&#xA;}&#xA;EnsureMatchColumn(dtGlStatementPPSPCCSP);&#xA;EnsureMatchColumn(dtTransactionReportRemoteOnUs);&#xA;&#xA;// === Group by C_PAN + RRN ===&#xA;var glGroups = dtGlStatementPPSPCCSP.AsEnumerable()&#xA;    .Where(r =&gt; r[&quot;C_PAN&quot;] != DBNull.Value &amp;&amp; r[&quot;RRN&quot;] != DBNull.Value)&#xA;    .GroupBy(r =&gt; GetKey(r[&quot;C_PAN&quot;].ToString(), r[&quot;RRN&quot;].ToString()))&#xA;    .ToDictionary(g =&gt; g.Key, g =&gt; g.ToList());&#xA;&#xA;var remoteGroups = dtTransactionReportRemoteOnUs.AsEnumerable()&#xA;    .Where(r =&gt; r[&quot;C_PAN&quot;] != DBNull.Value &amp;&amp; r[&quot;RRN&quot;] != DBNull.Value)&#xA;    .GroupBy(r =&gt; GetKey(r[&quot;C_PAN&quot;].ToString(), r[&quot;RRN&quot;].ToString()))&#xA;    .ToDictionary(g =&gt; g.Key, g =&gt; g.ToList());&#xA;&#xA;// === Match Phase ===&#xA;var glMatched = new HashSet&lt;DataRow&gt;();&#xA;var remoteMatched = new HashSet&lt;DataRow&gt;();&#xA;int groupMatchCount = 0;&#xA;&#xA;foreach (var key in glGroups.Keys.Intersect(remoteGroups.Keys))&#xA;{&#xA;    var glList = glGroups[key].Where(r =&gt; !glMatched.Contains(r)).ToList();&#xA;    var remoteList = remoteGroups[key].Where(r =&gt; !remoteMatched.Contains(r)).ToList();&#xA;&#xA;    if (glList.Count == 0 || remoteList.Count == 0)&#xA;        continue;&#xA;&#xA;    // === Quick sum maps for Remote&#xA;    var remoteAmountMap = new Dictionary&lt;decimal, List&lt;DataRow&gt;&gt;();&#xA;    foreach (var r in remoteList)&#xA;    {&#xA;        decimal amt = ParseAmount(r[&quot;Billing Amount&quot;]);&#xA;        if (!remoteAmountMap.TryGetValue(amt, out var bucket))&#xA;            bucket = new List&lt;DataRow&gt;();&#xA;&#xA;        bucket.Add(r);&#xA;        remoteAmountMap[amt] = bucket;&#xA;    }&#xA;&#xA;    bool matched = false;&#xA;&#xA;    // === Phase 1: Exact 1-to-1 matching&#xA;    foreach (var glRow in glList)&#xA;    {&#xA;        if (matched) break;&#xA;&#xA;        decimal glAmt = ParseAmount(glRow[&quot;Debit (TZS)&quot;]);&#xA;        if (glAmt == 0) glAmt = ParseAmount(glRow[&quot;Credit (TZS)&quot;]);&#xA;&#xA;        if (remoteAmountMap.TryGetValue(glAmt, out var remoteCandidates))&#xA;        {&#xA;            var remoteMatch = remoteCandidates.FirstOrDefault(r =&gt; !remoteMatched.Contains(r));&#xA;            if (remoteMatch != null)&#xA;            {&#xA;                glRow[&quot;MATCH&quot;] = true;&#xA;                remoteMatch[&quot;MATCH&quot;] = true;&#xA;&#xA;                dtGlStatementMatched.ImportRow(glRow);&#xA;                dtTransactionReportMatched.ImportRow(remoteMatch);&#xA;&#xA;                glMatched.Add(glRow);&#xA;                remoteMatched.Add(remoteMatch);&#xA;&#xA;                groupMatchCount++;&#xA;                matched = true;&#xA;                break;&#xA;            }&#xA;        }&#xA;    }&#xA;&#xA;    if (matched) continue;&#xA;&#xA;    // === Phase 2: Fallback to limited group combo sum match (max 2)&#xA;    var glCombos = GetLimitedCombinations(glList);&#xA;    var remoteCombos = GetLimitedCombinations(remoteList);&#xA;&#xA;    foreach (var gSet in glCombos)&#xA;    {&#xA;        decimal gSum = gSet.Sum(r =&gt; ParseAmount(r[&quot;Debit (TZS)&quot;]) + ParseAmount(r[&quot;Credit (TZS)&quot;]));&#xA;&#xA;        foreach (var rSet in remoteCombos)&#xA;        {&#xA;            decimal rSum = rSet.Sum(r =&gt; ParseAmount(r[&quot;Billing Amount&quot;]));&#xA;&#xA;            if (gSum == rSum)&#xA;            {&#xA;                foreach (var g in gSet)&#xA;                {&#xA;                    g[&quot;MATCH&quot;] = true;&#xA;                    dtGlStatementMatched.ImportRow(g);&#xA;                    glMatched.Add(g);&#xA;                }&#xA;&#xA;                foreach (var r in rSet)&#xA;                {&#xA;                    r[&quot;MATCH&quot;] = true;&#xA;                    dtTransactionReportMatched.ImportRow(r);&#xA;                    remoteMatched.Add(r);&#xA;                }&#xA;&#xA;                groupMatchCount++;&#xA;                matched = true;&#xA;                break;&#xA;            }&#xA;        }&#xA;        if (matched) break;&#xA;    }&#xA;}&#xA;&#xA;// === Cleanup: Remove matched rows ===&#xA;for (int i = dtGlStatementPPSPCCSP.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    if (glMatched.Contains(dtGlStatementPPSPCCSP.Rows[i]))&#xA;        dtGlStatementPPSPCCSP.Rows.RemoveAt(i);&#xA;}&#xA;&#xA;for (int i = dtTransactionReportRemoteOnUs.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    if (remoteMatched.Contains(dtTransactionReportRemoteOnUs.Rows[i]))&#xA;        dtTransactionReportRemoteOnUs.Rows.RemoveAt(i);&#xA;}&#xA;&#xA;// === Logging ===&#xA;Console.WriteLine($&quot;✅ GROUP MATCHES: {groupMatchCount}&quot;);&#xA;Console.WriteLine($&quot;🧹 REMOVED: {glMatched.Count} GL, {remoteMatched.Count} Remote&quot;);&#xA;Console.WriteLine($&quot;📊 REMAINING: GL = {dtGlStatementPPSPCCSP.Rows.Count}, Remote = {dtTransactionReportRemoteOnUs.Rows.Count}&quot;);&#xA;&#xA;// === Limited combination generator ===&#xA;IEnumerable&lt;List&lt;T&gt;&gt; GetLimitedCombinations&lt;T&gt;(List&lt;T&gt; source)&#xA;{&#xA;    int count = source.Count;&#xA;    for (int i = 0; i &lt; count; i++)&#xA;        yield return new List&lt;T&gt; { source[i] };&#xA;&#xA;    for (int i = 0; i &lt; count; i++)&#xA;    for (int j = i + 1; j &lt; count; j++)&#xA;        yield return new List&lt;T&gt; { source[i], source[j] };&#xA;}&#xA;" DisplayName="PPSP, PPSA, CCSA &amp; CCSP  VS dtTransactionReportRemoteOnUs" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_206" Language="CSharp">

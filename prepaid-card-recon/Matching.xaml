        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Normalize Helper ===&#xD;&#xA;Regex normalizeRegex = new Regex(&quot;[^a-zA-Z0-9]&quot;, RegexOptions.Compiled);&#xD;&#xA;string Normalize(string input) =&gt;&#xD;&#xA;    normalizeRegex.Replace((input ?? &quot;&quot;).Trim(), &quot;&quot;).ToUpperInvariant();&#xD;&#xA;&#xD;&#xA;decimal SafeParseDecimal(object value)&#xD;&#xA;{&#xD;&#xA;    var raw = value?.ToString()?.Replace(&quot;,&quot;, &quot;&quot;).Trim();&#xD;&#xA;    return decimal.TryParse(raw, out var result) ? result : 0m;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// === Extract yyyy-MM-dd from GL.Narration ===&#xD;&#xA;DateTime? ExtractNarrationDate(string narration)&#xD;&#xA;{&#xD;&#xA;    if (string.IsNullOrWhiteSpace(narration)) return null;&#xD;&#xA;&#xD;&#xA;    var match = Regex.Match(narration, @&quot;\d{4}-\d{2}-\d{2}&quot;);&#xD;&#xA;    if (match.Success &amp;&amp;&#xD;&#xA;        DateTime.TryParseExact(match.Value, &quot;yyyy-MM-dd&quot;, CultureInfo.InvariantCulture, DateTimeStyles.None, out var result))&#xD;&#xA;        return result;&#xD;&#xA;&#xD;&#xA;    return null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// === Parse Refund.Transaction Date (&quot;dd/MM/yyyy HH:mm:ss&quot;) → DateOnly ===&#xD;&#xA;DateTime? ExtractTransactionDate(object value)&#xD;&#xA;{&#xD;&#xA;    var raw = value?.ToString()?.Trim();&#xD;&#xA;    if (string.IsNullOrEmpty(raw)) return null;&#xD;&#xA;&#xD;&#xA;    return DateTime.TryParseExact(raw, &quot;dd/MM/yyyy HH:mm:ss&quot;, CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt)&#xD;&#xA;        ? dt.Date&#xD;&#xA;        : null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// === Ensure MATCH column ===&#xD;&#xA;void EnsureMatchColumn(DataTable dt)&#xD;&#xA;{&#xD;&#xA;    if (!dt.Columns.Contains(&quot;MATCH&quot;))&#xD;&#xA;    {&#xD;&#xA;        var col = dt.Columns.Add(&quot;MATCH&quot;, typeof(bool));&#xD;&#xA;        col.DefaultValue = false;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;EnsureMatchColumn(dtGlStatementManualEntries);&#xD;&#xA;EnsureMatchColumn(dtTransactionReportRefund);&#xD;&#xA;&#xD;&#xA;// === Build Refund Lookup by (Normalized C_PAN + Rounded Billing Amount) ===&#xD;&#xA;var refundLookup = dtTransactionReportRefund.AsEnumerable()&#xD;&#xA;    .Where(r =&gt; r[&quot;C_PAN&quot;] != DBNull.Value &amp;&amp; r[&quot;Billing Amount&quot;] != DBNull.Value)&#xD;&#xA;    .Select(r =&gt;&#xD;&#xA;    {&#xD;&#xA;        string pan = r[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xD;&#xA;        decimal amt = Math.Round(SafeParseDecimal(r[&quot;Billing Amount&quot;]), 2);&#xD;&#xA;        string key = Normalize(pan) + amt.ToString(&quot;F2&quot;);&#xD;&#xA;        return new { Row = r, Key = key };&#xD;&#xA;    })&#xD;&#xA;    .GroupBy(x =&gt; x.Key)&#xD;&#xA;    .ToDictionary(g =&gt; g.Key, g =&gt; g.Select(x =&gt; x.Row).ToList());&#xD;&#xA;&#xD;&#xA;// === Match tracking ===&#xD;&#xA;var glMatched = new HashSet&lt;DataRow&gt;();&#xD;&#xA;var refundMatched = new HashSet&lt;DataRow&gt;();&#xD;&#xA;&#xD;&#xA;// === One-to-One Match Logic ===&#xD;&#xA;foreach (DataRow glRow in dtGlStatementManualEntries.Rows)&#xD;&#xA;{&#xD;&#xA;    if (glMatched.Contains(glRow)) continue;&#xD;&#xA;&#xD;&#xA;    string cPan = glRow[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xD;&#xA;    DateTime? narrationDate = ExtractNarrationDate(glRow[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;);&#xD;&#xA;    if (narrationDate == null) continue;&#xD;&#xA;&#xD;&#xA;    decimal glAmount = Math.Round(&#xD;&#xA;        SafeParseDecimal(glRow[&quot;Debit (TZS)&quot;]) + SafeParseDecimal(glRow[&quot;Credit (TZS)&quot;]), 2);&#xD;&#xA;    if (glAmount == 0m) continue;&#xD;&#xA;&#xD;&#xA;    string key = Normalize(cPan) + glAmount.ToString(&quot;F2&quot;);&#xD;&#xA;    if (!refundLookup.TryGetValue(key, out var candidates)) continue;&#xD;&#xA;&#xD;&#xA;    var match = candidates.FirstOrDefault(refundRow =&gt;&#xD;&#xA;        !refundMatched.Contains(refundRow) &amp;&amp;&#xD;&#xA;        ExtractTransactionDate(refundRow[&quot;Transaction Date&quot;]) is DateTime trxDate &amp;&amp;&#xD;&#xA;        (trxDate - narrationDate.Value).Duration().Days &lt;= 1);&#xD;&#xA;&#xD;&#xA;    if (match != null)&#xD;&#xA;    {&#xD;&#xA;        glRow[&quot;MATCH&quot;] = true;&#xD;&#xA;        match[&quot;MATCH&quot;] = true;&#xD;&#xA;        glMatched.Add(glRow);&#xD;&#xA;        refundMatched.Add(match);&#xD;&#xA;        dtGlStatementMatched.ImportRow(glRow);&#xD;&#xA;        dtTransactionReportMatched.ImportRow(match);&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// === Remove matched rows ===&#xD;&#xA;int removedGl = 0, removedRefund = 0;&#xD;&#xA;&#xD;&#xA;for (int i = dtGlStatementManualEntries.Rows.Count - 1; i &gt;= 0; i--)&#xD;&#xA;{&#xD;&#xA;    if (glMatched.Contains(dtGlStatementManualEntries.Rows[i]))&#xD;&#xA;    {&#xD;&#xA;        dtGlStatementManualEntries.Rows.RemoveAt(i);&#xD;&#xA;        removedGl++;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;for (int i = dtTransactionReportRefund.Rows.Count - 1; i &gt;= 0; i--)&#xD;&#xA;{&#xD;&#xA;    if (refundMatched.Contains(dtTransactionReportRefund.Rows[i]))&#xD;&#xA;    {&#xD;&#xA;        dtTransactionReportRefund.Rows.RemoveAt(i);&#xD;&#xA;        removedRefund++;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// === Log Summary ===&#xD;&#xA;Console.WriteLine($&quot;✅ One-to-One MATCHED: {glMatched.Count} GL rows ↔ {refundMatched.Count} Refund rows.&quot;);&#xD;&#xA;Console.WriteLine($&quot;🧹 REMOVED: {removedGl} from Manual Entries, {removedRefund} from Refund report.&quot;);&#xD;&#xA;Console.WriteLine($&quot;📊 REMAINING: Manual = {dtGlStatementManualEntries.Rows.Count}, Refund = {dtTransactionReportRefund.Rows.Count}&quot;);&#xD;&#xA;" DisplayName="dtGlStatementManualEntries VS dtTransactionReportRefund" sap:VirtualizedContainerService.HintSize="495.3333333333333,188" sap2010:WorkflowViewState.IdRef="InvokeCode_246" Language="CSharp">

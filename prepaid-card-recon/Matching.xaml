        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Step 0: Define reusable constants ===&#xA;var agrCodes = new HashSet&lt;string&gt; { &quot;PRDP&quot;, &quot;AGR1&quot;, &quot;AGR2&quot; };&#xA;const string cwppCode = &quot;CWPP&quot;;&#xA;&#xA;// === Step 1: Collect GL Statement Matches ===&#xA;var glMatches = new List&lt;DataRow&gt;();&#xA;var glDeleteIndices = new List&lt;int&gt;();&#xA;&#xA;for (int i = 0; i &lt; dtGlStatement.Rows.Count; i++)&#xA;{&#xA;    var row = dtGlStatement.Rows[i];&#xA;    var code = row[&quot;ProductCode&quot;]?.ToString()?.Trim();&#xA;&#xA;    if (agrCodes.Contains(code))&#xA;    {&#xA;        glMatches.Add(row);&#xA;        glDeleteIndices.Add(i);&#xA;    }&#xA;    else if (string.Equals(code, cwppCode, StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;             decimal.TryParse(row[&quot;Credit (TZS)&quot;]?.ToString(), out var credit) &amp;&amp;&#xA;             credit != 0)&#xA;    {&#xA;        glMatches.Add(row);&#xA;        glDeleteIndices.Add(i);&#xA;    }&#xA;}&#xA;&#xA;// === Step 2: Collect Historical Matches ===&#xA;var historicalMatches = new List&lt;DataRow&gt;();&#xA;var histDeleteIndices = new List&lt;int&gt;();&#xA;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var row = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    var code = row[&quot;ProductCode&quot;]?.ToString()?.Trim();&#xA;&#xA;    if (agrCodes.Contains(code))&#xA;    {&#xA;        historicalMatches.Add(row);&#xA;        histDeleteIndices.Add(i);&#xA;    }&#xA;    else if (string.Equals(code, cwppCode, StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;             decimal.TryParse(row[&quot;Credit (TZS)&quot;]?.ToString(), out var credit) &amp;&amp;&#xA;             credit != 0)&#xA;    {&#xA;        historicalMatches.Add(row);&#xA;        histDeleteIndices.Add(i);&#xA;    }&#xA;}&#xA;&#xA;Console.WriteLine($&quot;[INFO] GL matches: {glMatches.Count}, Historical matches: {historicalMatches.Count}&quot;);&#xA;&#xA;// === Step 3: Import to PRDP/AGR1/AGR2 target ===&#xA;foreach (var row in glMatches)&#xA;    dtGlStatementPRDPAGR1AGR2.ImportRow(row);&#xA;&#xA;foreach (var row in historicalMatches)&#xA;    dtGlStatementPRDPAGR1AGR2.ImportRow(row);&#xA;&#xA;// === Step 4: Remove from source tables (reverse index deletion) ===&#xA;for (int i = glDeleteIndices.Count - 1; i &gt;= 0; i--)&#xA;    dtGlStatement.Rows.RemoveAt(glDeleteIndices[i]);&#xA;&#xA;for (int i = histDeleteIndices.Count - 1; i &gt;= 0; i--)&#xA;    dtHistoricalReconTransactionsReport.Rows.RemoveAt(histDeleteIndices[i]);&#xA;&#xA;Console.WriteLine($&quot;[INFO] Rows removed: GL = {glDeleteIndices.Count}, Historical = {histDeleteIndices.Count}&quot;);&#xA;" DisplayName="MOVE PRDP, AGR1, AGR2, CWPP (CR) from GL and Historical" sap:VirtualizedContainerService.HintSize="456.6666666666667,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_201" Language="CSharp">

 var glAmount = Math.Round(SafeParseDecimal(glRow[&quot;Debit (TZS)&quot;]) + SafeParseDecimal(glRow[&quot;Credit (TZS)&quot;]), 2);&#xA;&#xA;        var match = remoteList.FirstOrDefault(r =&gt;&#xA;            Math.Round(SafeParseDecimal(r[&quot;Billing Amount&quot;]), 2) == glAmount &amp;&amp;&#xA;            !remoteMatched.Contains(r));&#xA;&#xA;        if (match != null)&#xA;        {&#xA;            glRow[&quot;MATCH&quot;] = true;&#xA;            match[&quot;MATCH&quot;] = true;&#xA;            glMatched.Add(glRow);&#xA;            remoteMatched.Add(match);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Append Matched Rows (no Clone, preserve existing) ===&#xA;foreach (var row in glMatched)&#xA;    dtGlStatementMatched.ImportRow(row);&#xA;&#xA;foreach (var row in remoteMatched)&#xA;    dtTransactionReportMatched.ImportRow(row);&#xA;&#xA;// === Remove matched from original tables ===&#xA;int removedGl = 0, removedRemote = 0;&#xA;&#xA;for (int i = dtGlStatementUMJP.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    if (glMatched.Contains(dtGlStatementUMJP.Rows[i]))&#xA;    {&#xA;        dtGlStatementUMJP.Rows.RemoveAt(i);&#xA;        removedGl++;&#xA;    }&#xA;}&#xA;&#xA;for (int i = dtTransactionReportCashAdvance.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    if (remoteMatched.Contains(dtTransactionReportCashAdvance.Rows[i]))&#xA;    {&#xA;        dtTransactionReportCashAdvance.Rows.RemoveAt(i);&#xA;        removedRemote++;&#xA;    }&#xA;}&#xA;&#xA;// === Summary Logs ===&#xA;Console.WriteLine($&quot;✅ Matched GL rows: {glMatched.Count}&quot;);&#xA;Console.WriteLine($&quot;✅ Matched Cash Advance rows: {remoteMatched.Count}&quot;);&#xA;Console.WriteLine($&quot;🧹 Removed: {removedGl} from GL, {removedRemote} from Cash Advance&quot;);&#xA;Console.WriteLine($&quot;📊 Remaining GL: {dtGlStatementUMJP.Rows.Count}&quot;);&#xA;Console.WriteLine($&quot;📊 Remaining Cash Advance: {dtTransactionReportCashAdvance.Rows.Count}&quot;);&#xA;" DisplayName="UMJP VS dtTransactionReportCa
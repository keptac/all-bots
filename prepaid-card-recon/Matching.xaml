        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Compiled Regex Patterns ===&#xA;var regexMaskedCard = new Regex(@&quot;\b(550558)[*xX0]{6}(\d{4})\b&quot;, RegexOptions.Compiled);&#xA;var regexFullPan = new Regex(@&quot;\b(\d{6})[Xx*]{6}(\d{4})\b&quot;, RegexOptions.Compiled);&#xA;var regex16Digits = new Regex(@&quot;\b\d{16}\b&quot;, RegexOptions.Compiled);&#xA;var regexCardInNarration = new Regex(@&quot;(\d{6}XXXXXX\d{4}.*)&quot;, RegexOptions.Compiled);&#xA;var regexDigitsOnly = new Regex(@&quot;\D&quot;, RegexOptions.Compiled);&#xA;var regexClean = new Regex(@&quot;\s|[^\u0020-\u007E]&quot;, RegexOptions.Compiled);&#xA;var regexTrxId = new Regex(@&quot;TrxID\s*[:：]?\s*([A-Z0-9]+)&quot;, RegexOptions.Compiled | RegexOptions.IgnoreCase);&#xA;var regexBillNumber = new Regex(@&quot;Bill\s*Number\s*:\s*([^\s]+)&quot;, RegexOptions.Compiled | RegexOptions.IgnoreCase);&#xA;&#xA;// === Helper Methods ===&#xA;&#xA;string NormalizeMaskedCardNumber(string narration) =&gt;&#xA;    string.IsNullOrWhiteSpace(narration) ? &quot;&quot; :&#xA;    regexMaskedCard.Replace(narration, m =&gt; $&quot;{m.Groups[1].Value}XXXXXX{m.Groups[2].Value}&quot;);&#xA;&#xA;string ExtractC_PANFromNarration(string text)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(text)) return &quot;&quot;;&#xA;&#xA;    var m = regexFullPan.Match(text);&#xA;    if (m.Success) return $&quot;{m.Groups[1].Value}XXXXXX{m.Groups[2].Value}&quot;;&#xA;&#xA;    m = regex16Digits.Match(text);&#xA;    return m.Success ? m.Value.Substring(0, 6) + &quot;XXXXXX&quot; + m.Value.Substring(12, 4) : &quot;&quot;;&#xA;}&#xA;&#xA;string ExtractCNarration(string text)&#xA;{&#xA;    var m = regexCardInNarration.Match(text);&#xA;    return m.Success ? m.Groups[1].Value : text;&#xA;}&#xA;&#xA;(string stan, string rrn, string termId, string auth) ExtractTransactionFields(string narration)&#xA;{&#xA;    // Full format: PAN - STAN - RRN - AUTH&#xA;    var m = Regex.Match(narration, @&quot;\b\d{6}[*xX]{6}\d{4}[-\s]*([0-9]{6})[-\s]*([0-9]{10,12})[-\s]*([A-Z0-9]+)\b&quot;);&#xA;    if (m.Success)&#xA;    {&#xA;        string stan = m.Groups[1].Value;&#xA;        string rrn = m.Groups[2].Value.PadLeft(12, '0');&#xA;        string auth = m.Groups[3].Value;&#xA;        return (stan, rrn, auth, auth);&#xA;    }&#xA;&#xA;    // Short format: PAN - STAN - AUTH&#xA;    m = Regex.Match(narration, @&quot;\b\d{6}[*xX]{6}\d{4}[-\s]*([0-9]{6})[-\s]*([A-Z0-9]+)\b&quot;);&#xA;    if (m.Success)&#xA;    {&#xA;        string stan = m.Groups[1].Value;&#xA;        string rrn = &quot;000000000000&quot;;&#xA;        string auth = m.Groups[2].Value;&#xA;        return (stan, rrn, auth, auth);&#xA;    }&#xA;&#xA;    // Fallback: Only authorization&#xA;    m = Regex.Match(narration, @&quot;Auth:\s*(\w+)&quot;, RegexOptions.IgnoreCase);&#xA;    if (m.Success)&#xA;    {&#xA;        return (&quot;&quot;, &quot;000000000000&quot;, &quot;&quot;, m.Groups[1].Value);&#xA;    }&#xA;&#xA;    return (&quot;&quot;, &quot;000000000000&quot;, &quot;&quot;, &quot;&quot;);&#xA;}&#xA;&#xA;string ExtractPanFromBillNumber(string text)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(text)) return &quot;MISSING_PAN&quot;;&#xA;&#xA;    text = text.Replace(&quot;******&quot;, &quot;XXXXXX&quot;)&#xA;               .Replace(&quot;xxxxxx&quot;, &quot;XXXXXX&quot;)&#xA;               .Replace(&quot;000000&quot;, &quot;XXXXXX&quot;);&#xA;&#xA;    var billMatch = regexBillNumber.Match(text);&#xA;    if (!billMatch.Success) return &quot;MISSING_PAN&quot;;&#xA;&#xA;    foreach (var part in billMatch.Groups[1].Value.Split('!', StringSplitOptions.RemoveEmptyEntries))&#xA;    {&#xA;        var m = regexFullPan.Match(part);&#xA;        if (m.Success) return $&quot;{m.Groups[1].Value}XXXXXX{m.Groups[2].Value}&quot;;&#xA;&#xA;        var broken = Regex.Match(part, @&quot;^(\d{5})[Xx*]{6}(\d{5})$&quot;);&#xA;        if (broken.Success)&#xA;            return $&quot;{broken.Groups[1].Value}0XXXXXX{broken.Groups[2].Value.Substring(1, 4)}&quot;;&#xA;&#xA;        var digits = regexDigitsOnly.Replace(part, &quot;&quot;);&#xA;        if (digits.Length == 16)&#xA;            return digits.Substring(0, 6) + &quot;XXXXXX&quot; + digits.Substring(12, 4);&#xA;    }&#xA;&#xA;    return &quot;MISSING_PAN&quot;;&#xA;}&#xA;&#xA;string ExtractRRN(string text)&#xA;{&#xA;    var match = regexTrxId.Match(text);&#xA;    string rrnRaw = match.Success ? match.Groups[1].Value.Trim() : &quot;&quot;;&#xA;    string digits = regexDigitsOnly.Replace(rrnRaw, &quot;&quot;);&#xA;    return string.IsNullOrWhiteSpace(digits) ? &quot;000000000000&quot; : digits.PadLeft(12, '0');&#xA;}&#xA;&#xA;string CleanAndTrim(string input) =&gt; regexClean.Replace(input ?? &quot;&quot;, &quot;&quot;);&#xA;&#xA;string FormatAmount(string amount) =&gt;&#xA;    decimal.TryParse(amount, out var val) ? val.ToString(&quot;0.00&quot;) : &quot;0.00&quot;;&#xA;&#xA;// === RECON Processing for dtHistoricalReconTransactionsReport ===&#xA;&#xA;int totalBefore = dtHistoricalReconTransactionsReport.Rows.Count, proc = 0;&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string raw = row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string norm = NormalizeMaskedCardNumber(raw);&#xA;&#xA;    string pan = ExtractC_PANFromNarration(norm);&#xA;    row[&quot;C_PAN&quot;] = string.IsNullOrWhiteSpace(pan) ? &quot;MISSING_PAN&quot; : pan;&#xA;    row[&quot;C_NARRATION&quot;] = ExtractCNarration(norm);&#xA;&#xA;    var (stan, rrn, termId, auth) = ExtractTransactionFields(norm);&#xA;&#xA;    // Fallback if RRN is missing&#xA;    if (string.IsNullOrWhiteSpace(rrn) || rrn == &quot;000000000000&quot;)&#xA;        rrn = ExtractRRN(norm);&#xA;&#xA;    row[&quot;STAN&quot;] = stan;&#xA;    row[&quot;RRN&quot;] = rrn;&#xA;    row[&quot;EXTRACTED_TERMINAL_ID&quot;] = termId;&#xA;    row[&quot;AUTHORIZATION_NUMBER&quot;] = auth;&#xA;&#xA;    string debit = row[&quot;Debit (TZS)&quot;]?.ToString();&#xA;    string credit = row[&quot;Credit (TZS)&quot;]?.ToString();&#xA;    string amount = !string.IsNullOrWhiteSpace(debit) &amp;&amp; debit != &quot;0&quot;&#xA;        ? FormatAmount(debit)&#xA;        : FormatAmount(credit);&#xA;&#xA;    row[&quot;Search Key&quot;] = CleanAndTrim(pan + rrn + amount);&#xA;    proc++;&#xA;}&#xA;&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;int missingPanCount = dtHistoricalReconTransactionsReport.AsEnumerable().Count(r =&gt; r[&quot;C_PAN&quot;]?.ToString() == &quot;MISSING_PAN&quot;);&#xA;&#xA;Console.WriteLine($&quot;✅ HIST rows: {totalBefore} | Processed: {proc} | ❌ Missing PAN: {missingPanCount}&quot;);&#xA;&#xA;// === Optional: Enrich Missing PAN or RRN from bill number ===&#xA;&#xA;int updatedPanCount = 0, updatedRRNCount = 0;&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string narration = row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;;&#xA;&#xA;    string currentPan = row[&quot;C_PAN&quot;]?.ToString();&#xA;    if (string.IsNullOrWhiteSpace(currentPan) || currentPan == &quot;MISSING_PAN&quot;)&#xA;    {&#xA;        string billPan = ExtractPanFromBillNumber(narration);&#xA;        if (!string.IsNullOrWhiteSpace(billPan) &amp;&amp; billPan != &quot;MISSING_PAN&quot;)&#xA;        {&#xA;            row[&quot;C_PAN&quot;] = billPan;&#xA;            updatedPanCount++;&#xA;        }&#xA;    }&#xA;&#xA;    if (row.Table.Columns.Contains(&quot;RRN&quot;))&#xA;    {&#xA;        string rrn = row[&quot;RRN&quot;]?.ToString();&#xA;        if (string.IsNullOrWhiteSpace(rrn) || rrn == &quot;000000000000&quot;)&#xA;        {&#xA;            row[&quot;RRN&quot;] = ExtractRRN(narration);&#xA;            updatedRRNCount++;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;&#xA;Console.WriteLine($&quot;✅ HIST PANs newly filled: {updatedPanCount}&quot;);&#xA;Console.WriteLine($&quot;✅ HIST RRNs updated (forced 12-digit): {updatedRRNCount}&quot;);&#xA;" DisplayName="Extract C_PAN, STAN, RRN, TERMINAL ID" sap:VirtualizedContainerService.HintSize="484.8,56.8" sap2010:WorkflowViewState.IdRef="InvokeCode_263" Language="CSharp">

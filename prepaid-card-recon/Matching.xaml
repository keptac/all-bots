        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === CONFIGURATION ===&#xA;bool enableLogging = true;&#xA;void Log(string msg) { if (enableLogging) Console.WriteLine(msg); }&#xA;&#xA;// === Helpers ===&#xA;string CleanString(string input)&#xA;{&#xA;    if (string.IsNullOrEmpty(input)) return &quot;&quot;;&#xA;    var sb = new System.Text.StringBuilder(input.Length);&#xA;    foreach (var c in input)&#xA;        if (char.IsLetterOrDigit(c)) sb.Append(c);&#xA;    return sb.ToString();&#xA;}&#xA;&#xA;decimal SafeDecimal(object val)&#xA;{&#xA;    string raw = val?.ToString()?.Replace(&quot;,&quot;, &quot;&quot;).Trim() ?? &quot;&quot;;&#xA;    return decimal.TryParse(raw, out var result) ? result : 0m;&#xA;}&#xA;&#xA;// === Step 1: Generate Key for GL (C_PAN + Amount + Date) ===&#xA;foreach (DataRow row in dtGlStatementPRDPAGR1AGR2.Rows)&#xA;{&#xA;    string cpan = row[&quot;C_PAN&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;    decimal amount = SafeDecimal(row[&quot;Debit (TZS)&quot;]);&#xA;    if (amount == 0) amount = SafeDecimal(row[&quot;Credit (TZS)&quot;]);&#xA;&#xA;    string date = DateTime.TryParse(row[&quot;Booking Date&quot;]?.ToString(), out var dt)&#xA;        ? dt.ToString(&quot;ddMMyyyy&quot;)&#xA;        : &quot;&quot;;&#xA;&#xA;    row[&quot;C_PAN_AMOUNT_DATE_TIME&quot;] = CleanString($&quot;{cpan}{amount:F2}{date}&quot;);&#xA;}&#xA;&#xA;// === Step 1b: Generate Key for TRX (C_PAN + Amount + Date) ===&#xA;foreach (DataRow row in dtTransactionReportLoadAndReload.Rows)&#xA;{&#xA;    string cpan = row[&quot;C_PAN&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;    decimal amount = SafeDecimal(row[&quot;Billing Amount&quot;]);&#xA;&#xA;    string date = DateTime.TryParse(row[&quot;Transaction Date&quot;]?.ToString(), out var dt)&#xA;        ? dt.ToString(&quot;ddMMyyyy&quot;)&#xA;        : &quot;&quot;;&#xA;&#xA;    row[&quot;C_PAN_AMOUNT_DATE_TIME&quot;] = CleanString($&quot;{cpan}{amount:F2}{date}&quot;);&#xA;}&#xA;&#xA;// === Step 2: Build Lookup for TRX&#xA;var trxLookup = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;(dtTransactionReportLoadAndReload.Rows.Count);&#xA;&#xA;foreach (DataRow row in dtTransactionReportLoadAndReload.Rows)&#xA;{&#xA;    var key = row[&quot;C_PAN_AMOUNT_DATE_TIME&quot;]?.ToString();&#xA;    if (string.IsNullOrWhiteSpace(key)) continue;&#xA;&#xA;    if (!trxLookup.TryGetValue(key, out var list))&#xA;    {&#xA;        list = new List&lt;DataRow&gt;();&#xA;        trxLookup[key] = list;&#xA;    }&#xA;    list.Add(row);&#xA;}&#xA;&#xA;// === Step 3: Match by TIME (exact HH:mm)&#xA;var matchedGL = new List&lt;DataRow&gt;();&#xA;var matchedTR = new List&lt;DataRow&gt;();&#xA;var matchedTRIndices = new HashSet&lt;int&gt;();&#xA;&#xA;for (int i = 0; i &lt; dtGlStatementPRDPAGR1AGR2.Rows.Count; i++)&#xA;{&#xA;    var glRow = dtGlStatementPRDPAGR1AGR2.Rows[i];&#xA;    var key = glRow[&quot;C_PAN_AMOUNT_DATE_TIME&quot;]?.ToString();&#xA;&#xA;    if (string.IsNullOrEmpty(key) || !trxLookup.TryGetValue(key, out var trxRows)) continue;&#xA;&#xA;    string glTime = glRow[&quot;TIME&quot;]?.ToString();&#xA;    if (string.IsNullOrWhiteSpace(glTime) || glTime.Length &lt; 5) continue;&#xA;&#xA;    glTime = glTime.Substring(0, 5);&#xA;&#xA;    foreach (var trRow in trxRows)&#xA;    {&#xA;        int trIndex = dtTransactionReportLoadAndReload.Rows.IndexOf(trRow);&#xA;        if (matchedTRIndices.Contains(trIndex)) continue;&#xA;&#xA;        string trTime = trRow[&quot;TIME&quot;]?.ToString();&#xA;        if (string.IsNullOrWhiteSpace(trTime) || trTime.Length &lt; 5) continue;&#xA;&#xA;        trTime = trTime.Substring(0, 5);&#xA;&#xA;        if (glTime == trTime)&#xA;        {&#xA;            glRow[&quot;MATCH&quot;] = true;&#xA;            trRow[&quot;MATCH&quot;] = true;&#xA;&#xA;            matchedGL.Add(glRow);&#xA;            matchedTR.Add(trRow);&#xA;            matchedTRIndices.Add(trIndex);&#xA;            break;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Step 4: Import Matched Rows to Final Tables&#xA;foreach (var row in matchedGL)&#xA;    dtGlStatementMatched.ImportRow(row);&#xA;&#xA;foreach (var row in matchedTR)&#xA;    dtTransactionReportMatched.ImportRow(row);&#xA;&#xA;Log($&quot;[MOVE] Matched TRX rows: {matchedTR.Count}&quot;);&#xA;&#xA;// === Step 5: Remove Matched Rows (Reverse for Safety)&#xA;var glIndices = new HashSet&lt;int&gt;();&#xA;foreach (var row in matchedGL)&#xA;    glIndices.Add(dtGlStatementPRDPAGR1AGR2.Rows.IndexOf(row));&#xA;&#xA;for (int i = dtGlStatementPRDPAGR1AGR2.Rows.Count - 1; i &gt;= 0; i--)&#xA;    if (glIndices.Contains(i))&#xA;        dtGlStatementPRDPAGR1AGR2.Rows.RemoveAt(i);&#xA;&#xA;var trIndices = new HashSet&lt;int&gt;();&#xA;foreach (var row in matchedTR)&#xA;    trIndices.Add(dtTransactionReportLoadAndReload.Rows.IndexOf(row));&#xA;&#xA;for (int i = dtTransactionReportLoadAndReload.Rows.Count - 1; i &gt;= 0; i--)&#xA;    if (trIndices.Contains(i))&#xA;        dtTransactionReportLoadAndReload.Rows.RemoveAt(i);&#xA;&#xA;Log(&quot;[DONE] Exact TIME matching complete.&quot;);&#xA;" DisplayName="HH:mm dtGlStatementPRDPAGR1AGR2 vs Load/Reload" sap:VirtualizedContainerService.HintSize="453.6,56.8" sap2010:WorkflowViewState.IdRef="InvokeCode_203" Language="CSharp">

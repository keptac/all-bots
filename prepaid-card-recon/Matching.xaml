        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Helper: Parse date only (dd/MM/yyyy or yyyy-MM-dd) ===&#xA;DateTime? GetDateOnly(object input)&#xA;{&#xA;    if (input == null) return null;&#xA;    string raw = input.ToString()?.Trim();&#xA;    return DateTime.TryParse(raw, out var dt) ? dt.Date : null;&#xA;}&#xA;&#xA;// === Helper: Parse decimal safely ===&#xA;decimal SafeParseAmount(object input)&#xA;{&#xA;    return decimal.TryParse(input?.ToString(), out var result) ? result : 0m;&#xA;}&#xA;&#xA;// === Optional Logging ===&#xA;bool enableLogging = true;&#xA;void Log(string msg) { if (enableLogging) Console.WriteLine(msg); }&#xA;&#xA;// === Create match output tables (preserving existing rows if any) ===&#xA;// Remove .Clone() if already initialized outside&#xA;// dtGlStatementMatched = dtGlStatementPRDPAGR1AGR2.Clone();&#xA;// dtTransactionReportMatched = dtTransactionReportLoadAndReload.Clone();&#xA;&#xA;// === Build TRX lookup: Key = C_PAN + Date + Amount ===&#xA;var trxLookup = dtTransactionReportLoadAndReload.AsEnumerable()&#xA;    .Where(r =&gt; r[&quot;C_PAN&quot;] != DBNull.Value &amp;&amp; r[&quot;Billing Amount&quot;] != DBNull.Value &amp;&amp; r[&quot;Transaction Date&quot;] != DBNull.Value)&#xA;    .GroupBy(r =&gt;&#xA;    {&#xA;        var pan = r[&quot;C_PAN&quot;].ToString().Trim().ToUpperInvariant();&#xA;        var date = GetDateOnly(r[&quot;Transaction Date&quot;]);&#xA;        var amt = SafeParseAmount(r[&quot;Billing Amount&quot;]);&#xA;        return date.HasValue ? $&quot;{pan}|{date.Value:yyyyMMdd}|{amt:F2}&quot; : null;&#xA;    })&#xA;    .Where(g =&gt; g.Key != null)&#xA;    .ToDictionary(g =&gt; g.Key, g =&gt; new Queue&lt;DataRow&gt;(g)); // FIFO queue&#xA;&#xA;var matchedTrxRows = new HashSet&lt;DataRow&gt;();&#xA;var matchedGlRows = new HashSet&lt;DataRow&gt;();&#xA;&#xA;// === Match GL rows ===&#xA;foreach (DataRow glRow in dtGlStatementPRDPAGR1AGR2.Rows)&#xA;{&#xA;    var pan = glRow[&quot;C_PAN&quot;]?.ToString()?.Trim()?.ToUpperInvariant();&#xA;    var date = GetDateOnly(glRow[&quot;Booking Date&quot;]);&#xA;    var amount = SafeParseAmount(glRow[&quot;Debit (TZS)&quot;]);&#xA;    if (amount == 0m) amount = SafeParseAmount(glRow[&quot;Credit (TZS)&quot;]);&#xA;    if (string.IsNullOrEmpty(pan) || !date.HasValue || amount == 0m) continue;&#xA;&#xA;    string key = $&quot;{pan}|{date.Value:yyyyMMdd}|{amount:F2}&quot;;&#xA;    if (trxLookup.TryGetValue(key, out var queue) &amp;&amp; queue.Count &gt; 0)&#xA;    {&#xA;        var trxRow = queue.Dequeue();&#xA;&#xA;        // Optional: mark match flag&#xA;        glRow[&quot;MATCH&quot;] = true;&#xA;        trxRow[&quot;MATCH&quot;] = true;&#xA;&#xA;        dtGlStatementMatched.ImportRow(glRow);&#xA;        dtTransactionReportMatched.ImportRow(trxRow);&#xA;&#xA;        matchedTrxRows.Add(trxRow);&#xA;        matchedGlRows.Add(glRow);&#xA;    }&#xA;}&#xA;&#xA;// === Clean up matched from original tables ===&#xA;int removedGl = 0, removedTrx = 0;&#xA;&#xA;for (int i = dtGlStatementPRDPAGR1AGR2.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    if (matchedGlRows.Contains(dtGlStatementPRDPAGR1AGR2.Rows[i]))&#xA;    {&#xA;        dtGlStatementPRDPAGR1AGR2.Rows.RemoveAt(i);&#xA;        removedGl++;&#xA;    }&#xA;}&#xA;&#xA;for (int i = dtTransactionReportLoadAndReload.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    if (matchedTrxRows.Contains(dtTransactionReportLoadAndReload.Rows[i]))&#xA;    {&#xA;        dtTransactionReportLoadAndReload.Rows.RemoveAt(i);&#xA;        removedTrx++;&#xA;    }&#xA;}&#xA;&#xA;// === Final summary ===&#xA;Log(&quot;✅ [SUMMARY] GL to TRX exact match by PAN + Date + Amount complete.&quot;);&#xA;Log($&quot;   → Matched GL rows: {matchedGlRows.Count}&quot;);&#xA;Log($&quot;   → Matched TRX rows: {matchedTrxRows.Count}&quot;);&#xA;Log($&quot;   → Removed from GL: {removedGl}&quot;);&#xA;Log($&quot;   → Removed from TRX: {removedTrx}&quot;);&#xA;Log($&quot;   → Remaining GL: {dtGlStatementPRDPAGR1AGR2.Rows.Count}&quot;);&#
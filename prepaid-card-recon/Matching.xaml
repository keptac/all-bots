        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === CONFIGURATION ===&#xA;Regex nonAlphanumeric = new Regex(&quot;[^a-zA-Z0-9]&quot;, RegexOptions.Compiled);&#xA;&#xA;// === Helpers ===&#xA;string Normalize(string val) =&gt;&#xA;    nonAlphanumeric.Replace((val ?? &quot;&quot;).Trim(), &quot;&quot;).ToUpperInvariant();&#xA;&#xA;string GetKey(string pan, string rrn) =&gt;&#xA;    Normalize(pan) + Normalize(rrn?.PadLeft(12, '0') ?? &quot;000000000000&quot;);&#xA;&#xA;decimal SafeParse(object val)&#xA;{&#xA;    if (val == DBNull.Value || val == null) return 0m;&#xA;    var str = val.ToString().Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;).Trim();&#xA;    return decimal.TryParse(str, out var result) ? result : 0m;&#xA;}&#xA;&#xA;// === Ensure MATCH column ===&#xA;void EnsureMatchColumn(DataTable dt)&#xA;{&#xA;    if (!dt.Columns.Contains(&quot;MATCH&quot;))&#xA;    {&#xA;        var col = dt.Columns.Add(&quot;MATCH&quot;, typeof(bool));&#xA;        col.DefaultValue = false;&#xA;    }&#xA;}&#xA;EnsureMatchColumn(dtGlStatementPPSPCCSP);&#xA;EnsureMatchColumn(dtHistoricalReconTransactionsReport);&#xA;&#xA;// === TEMP: Lightweight Group Storage with Aggregation ===&#xA;var histLookup = new Dictionary&lt;string, (List&lt;DataRow&gt; Rows, decimal Sum)&gt;(capacity: 10000);&#xA;var glLookup = new Dictionary&lt;string, (List&lt;DataRow&gt; Rows, decimal Sum)&gt;(capacity: 10000);&#xA;&#xA;// === Load Historical Groups ===&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    if (row[&quot;C_PAN&quot;] == DBNull.Value || row[&quot;RRN&quot;] == DBNull.Value) continue;&#xA;    var key = GetKey(row[&quot;C_PAN&quot;].ToString(), row[&quot;RRN&quot;].ToString());&#xA;&#xA;    decimal amount = SafeParse(row[&quot;Debit (TZS)&quot;]);&#xA;    if (amount == 0m)&#xA;        amount = SafeParse(row[&quot;Credit (TZS)&quot;]);&#xA;&#xA;    if (!histLookup.TryGetValue(key, out var entry))&#xA;        entry = (new List&lt;DataRow&gt;(), 0m);&#xA;&#xA;    entry.Rows.Add(row);&#xA;    entry.Sum += amount;&#xA;    histLookup[key] = entry;&#xA;}&#xA;&#xA;// === Load GL Groups ===&#xA;foreach (DataRow row in dtGlStatementPPSPCCSP.Rows)&#xA;{&#xA;    if (row[&quot;C_PAN&quot;] == DBNull.Value || row[&quot;RRN&quot;] == DBNull.Value) continue;&#xA;    var key = GetKey(row[&quot;C_PAN&quot;].ToString(), row[&quot;RRN&quot;].ToString());&#xA;&#xA;    decimal amount = SafeParse(row[&quot;Debit (TZS)&quot;]);&#xA;    if (amount == 0m)&#xA;        amount = SafeParse(row[&quot;Credit (TZS)&quot;]);&#xA;&#xA;    if (!glLookup.TryGetValue(key, out var entry))&#xA;        entry = (new List&lt;DataRow&gt;(), 0m);&#xA;&#xA;    entry.Rows.Add(row);&#xA;    entry.Sum += amount;&#xA;    glLookup[key] = entry;&#xA;}&#xA;&#xA;// === Match and Export ===&#xA;int matchedGroupCount = 0;&#xA;&#xA;foreach (var key in glLookup.Keys)&#xA;{&#xA;    if (!histLookup.TryGetValue(key, out var histEntry)) continue;&#xA;&#xA;    var glEntry = glLookup[key];&#xA;&#xA;    if (Math.Abs(glEntry.Sum - histEntry.Sum) &lt; 0.01m)&#xA;    {&#xA;        foreach (var row in glEntry.Rows)&#xA;        {&#xA;            row[&quot;MATCH&quot;] = true;&#xA;            dtGlStatementMatched.ImportRow(row); // append to existing matched&#xA;        }&#xA;&#xA;        foreach (var row in histEntry.Rows)&#xA;        {&#xA;            row[&quot;MATCH&quot;] = true;&#xA;            dtHistoricalReconTransactionsReportMatched.ImportRow(row); // append to existing matched&#xA;        }&#xA;&#xA;        matchedGroupCount++;&#xA;    }&#xA;}&#xA;&#xA;// === Reverse Delete Matched Rows ===&#xA;int removedGl = 0, removedHist = 0;&#xA;&#xA;for (int i = dtGlStatementPPSPCCSP.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    if (dtGlStatementPPSPCCSP.Rows[i][&quot;MATCH&quot;] is bool m &amp;&amp; m)&#xA;    {&#xA;        dtGlStatementPPSPCCSP.Rows.RemoveAt(i);&#xA;        removedGl++;&#xA;    }&#xA;}&#xA;&#xA;for (int i = dtHistoricalReconTransactionsReport.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    if (dtHistoricalReconTransactionsReport.Rows[i][&quot;MATCH&quot;] is bool m &amp;&amp; m)&#xA;    {&#xA;        dtHistoricalReconTransactionsReport.Rows.RemoveAt(i);&#xA;        removedHist++;&#xA;    }&#xA;}&#xA;&#xA;// === Log Summary ===&#xA;Console.WriteLine($&quot;✅ GROUP MATCHES: {matchedGroupCount}&quot;);&#xA;Console.WriteLine($&quot;🧹 REMOVED: {removedHist} HIST, {removedGl} GL&quot;);&#xA;Console.WriteLine($&quot;📊 REMAINING: {dtHistoricalReconTransactionsReport.Rows.Count} HIST, {dtGlStatementPPSPCCSP.Rows.Count} GL&quot;);&#xA;" DisplayName="PPSP, PPSA, CCSA &amp; CCSP  VS &quot;Remote-on-us transaction not yet posted&quot;" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_222" Language="CSharp">

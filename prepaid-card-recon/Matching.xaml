ctionsReportMatched.ImportRow(h);&#xA;                    }&#xA;                    goto NextGroup;&#xA;                }&#xA;            }&#xA;        }&#xA;    }&#xA;&#xA;NextGroup:&#xA;    continue;&#xA;}&#xA;&#xA;// === Step 2: Fallback 1-to-1 exact match ===&#xA;foreach (var key in glGroups.Keys.Intersect(histGroups.Keys))&#xA;{&#xA;    var glList = glGroups[key].Where(r =&gt; !glMatched.Contains(r)).ToList();&#xA;    var histList = histGroups[key].Where(r =&gt; !histMatched.Contains(r)).ToList();&#xA;&#xA;    foreach (var g in glList)&#xA;    {&#xA;        decimal gAmount = GetAmount(g);&#xA;&#xA;        var match = histList.FirstOrDefault(h =&gt;&#xA;            GetAmount(h) == gAmount &amp;&amp; !histMatched.Contains(h));&#xA;&#xA;        if (match != null)&#xA;        {&#xA;            g[&quot;MATCH&quot;] = true;&#xA;            match[&quot;MATCH&quot;] = true;&#xA;            glMatched.Add(g);&#xA;            histMatched.Add(match);&#xA;            dtGlStatementMatched.ImportRow(g);&#xA;            dtHistoricalReconTransactionsReportMatched.ImportRow(match);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Remove matched from originals ===&#xA;int removedGl = 0, removedHist = 0;&#xA;&#xA;for (int i = dtGlStatementCWPP.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    if (glMatched.Contains(dtGlStatementCWPP.Rows[i]))&#xA;    {&#xA;        dtGlStatementCWPP.Rows.RemoveAt(i);&#xA;        removedGl++;&#xA;    }&#xA;}&#xA;&#xA;for (int i = dtHistoricalReconTransactionsReport.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    if (histMatched.Contains(dtHistoricalReconTransactionsReport.Rows[i]))&#xA;    {&#xA;        dtHistoricalReconTransactionsReport.Rows.RemoveAt(i);&#xA;        removedHist++;&#xA;    }&#xA;}&#xA;&#xA;// === Summary Logs ===&#xA;Console.WriteLine($&quot;✅ MATCHED: {glMatched.Count} GL ↔ {histMatched.Count} HIST&quot;);&#xA;Console.WriteLine($&quot;🧹 REMOVED: {removedGl} from GL, {removedHist} from HIST&quot;);&#xA;&#xA;// === Combo generator (max 2 elements) ===&#xA;IEnumerable&lt;List&lt;T&gt;&gt; GetLimitedCombinations&lt;T&gt;(List&lt;T&gt; list)&#xA;{&#xA;    int n = list.Count;&#xA;    for (int r = 1; r &lt;= Math.Min(2, n); r++)&#xA;    {&#xA;        int[] indices = Enumerable.Range(0, r).ToArray();&#xA;        while (indices[0] &lt;= n - r)&#xA;        {&#xA;            yield return indices.Select(i =&gt; list[i]).ToList();&#xA;&#xA;            int t = r - 1;&#xA;            while (t &gt; 0 &amp;&amp; indices[t] == n - r + t) t--;&#xA;            indices[t]++;&#xA;            for (int i = t + 1; i &lt; r; i++)&#xA;                indices[i] = indices[i - 1] + 1;&#xA;        }&#xA;    }&#xA;}&#xA;" DisplayName="dtGlStatementCWPP   VS &quot;On-us purchases updated CMS only&quot;" sap:VirtualizedContainerService.HintSize="416,57.333333333333336" sap2010:WorkflowViewState.IdRef="InvokeCode_223" Language="CSharp">

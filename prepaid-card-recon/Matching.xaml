        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Precompiled Regex ===&#xA;Regex normalizeRegex = new Regex(&quot;[^a-zA-Z0-9]&quot;, RegexOptions.Compiled);&#xA;&#xA;// === Normalize helper ===&#xA;string Normalize(string input) =&gt;&#xA;    normalizeRegex.Replace((input ?? &quot;&quot;).Trim(), &quot;&quot;).ToUpperInvariant();&#xA;&#xA;string GetKey(string cPan, string rrn) =&gt;&#xA;    Normalize(cPan) + Normalize(rrn).PadLeft(12, '0');&#xA;&#xA;// === Limited Combinations: max size 2 ===&#xA;IEnumerable&lt;List&lt;T&gt;&gt; GetLimitedCombinations&lt;T&gt;(List&lt;T&gt; list)&#xA;{&#xA;    for (int i = 0; i &lt; list.Count; i++)&#xA;        yield return new List&lt;T&gt; { list[i] };&#xA;&#xA;    for (int i = 0; i &lt; list.Count - 1; i++)&#xA;    for (int j = i + 1; j &lt; list.Count; j++)&#xA;        yield return new List&lt;T&gt; { list[i], list[j] };&#xA;}&#xA;&#xA;// === Ensure MATCH column ===&#xA;void EnsureMatchColumn(DataTable dt)&#xA;{&#xA;    if (!dt.Columns.Contains(&quot;MATCH&quot;))&#xA;        dt.Columns.Add(&quot;MATCH&quot;, typeof(bool));&#xA;}&#xA;EnsureMatchColumn(dtGlStatementCWPP);&#xA;EnsureMatchColumn(dtHistoricalReconTransactionsReport);&#xA;&#xA;// === Step 1: Filter and Group ===&#xA;var reconRows = dtHistoricalReconTransactionsReport.AsEnumerable()&#xA;    .Where(r =&gt; r[&quot;Root Cause&quot;]?.ToString()?.Trim() == &quot;On-us purchases updated CMS only&quot;)&#xA;    .ToList();&#xA;&#xA;var glGroups = dtGlStatementCWPP.AsEnumerable()&#xA;    .Where(r =&gt; r[&quot;C_PAN&quot;] != DBNull.Value &amp;&amp; r[&quot;RRN&quot;] != DBNull.Value)&#xA;    .GroupBy(r =&gt; GetKey(r[&quot;C_PAN&quot;].ToString(), r[&quot;RRN&quot;].ToString()))&#xA;    .ToDictionary(g =&gt; g.Key, g =&gt; g.ToList());&#xA;&#xA;var histGroups = reconRows&#xA;    .Where(r =&gt; r[&quot;C_PAN&quot;] != DBNull.Value &amp;&amp; r[&quot;RRN&quot;] != DBNull.Value)&#xA;    .GroupBy(r =&gt; GetKey(r[&quot;C_PAN&quot;].ToString(), r[&quot;RRN&quot;].ToString()))&#xA;    .ToDictionary(g =&gt; g.Key, g =&gt; g.ToList());&#xA;&#xA;// === Step 2: Match Logic ===&#xA;var glMatched = new HashSet&lt;DataRow&gt;();&#xA;var histMatched = new HashSet&lt;DataRow&gt;();&#xA;&#xA;foreach (var key in glGroups.Keys.Intersect(histGroups.Keys))&#xA;{&#xA;    var glList = glGroups[key].Where(r =&gt; !glMatched.Contains(r)).ToList();&#xA;    var histList = histGroups[key].Where(r =&gt; !histMatched.Contains(r)).ToList();&#xA;    if (glList.Count == 0 || histList.Count == 0) continue;&#xA;&#xA;    // Precompute GL combo sums&#xA;    var glComboMap = GetLimitedCombinations(glList)&#xA;        .GroupBy(set =&gt;&#xA;        {&#xA;            decimal total = 0;&#xA;            foreach (var r in set)&#xA;                total += decimal.TryParse(r[&quot;Debit (TZS)&quot;]?.ToString(), out var d) ? d :&#xA;                         decimal.TryParse(r[&quot;Credit (TZS)&quot;]?.ToString(), out var c) ? c : 0;&#xA;            return Math.Round(total, 2);&#xA;        })&#xA;        .ToDictionary(g =&gt; g.Key, g =&gt; g.ToList());&#xA;&#xA;    bool matched = false;&#xA;&#xA;    foreach (var histSet in GetLimitedCombinations(histList))&#xA;    {&#xA;        decimal histSum = 0;&#xA;        foreach (var r in histSet)&#xA;            histSum += decimal.TryParse(r[&quot;Debit (TZS)&quot;]?.ToString(), out var d1) ? d1 :&#xA;                       decimal.TryParse(r[&quot;Credit (TZS)&quot;]?.ToString(), out var c1) ? c1 : 0;&#xA;        histSum = Math.Round(histSum, 2);&#xA;&#xA;        if (glComboMap.TryGetValue(histSum, out var glCombos))&#xA;        {&#xA;            foreach (var glSet in glCombos)&#xA;            {&#xA;                if (glSet.All(r =&gt; !glMatched.Contains(r)) &amp;&amp;&#xA;                    histSet.All(r =&gt; !histMatched.Contains(r)))&#xA;                {&#xA;                    foreach (var r in glSet)&#xA;                    {&#xA;                        r[&quot;MATCH&quot;] = true;&#xA;                        glMatched.Add(r);&#xA;                        dtGlStatementMatched.ImportRow(r);&#xA;                    }&#xA;                    foreach (var r in histSet)&#xA;                    {&#xA;                        r[&quot;MATCH&quot;] = true;&#xA;                        histMatched.Add(r);&#xA;                        dtHistoricalReconTransactionsReportMatched.ImportRow(r);&#xA;                    }&#xA;&#xA;                    matched = true;&#xA;                    break;&#xA;                }&#xA;            }&#xA;        }&#xA;&#xA;        if (matched) break;&#xA;    }&#xA;}&#xA;&#xA;// === Step 3: Remove matched rows ===&#xA;int removedGl = 0, removedHist = 0;&#xA;&#xA;for (int i = dtGlStatementCWPP.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    if (glMatched.Contains(dtGlStatementCWPP.Rows[i]))&#xA;    {&#xA;        dtGlStatementCWPP.Rows.RemoveAt(i);&#xA;        removedGl++;&#xA;    }&#xA;}&#xA;&#xA;for (int i = dtHistoricalReconTransactionsReport.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    if (histMatched.Contains(dtHistoricalReconTransactionsReport.Rows[i]))&#xA;    {&#xA;        dtHistoricalReconTransactionsReport.Rows.RemoveAt(i);&#xA;        removedHist++;&#xA;    }&#xA;}&#xA;&#xA;// === Final Summary ===&#xA;Console.WriteLine($&quot;✅ MATCHED: {glMatched.Count} GL rows ↔ {histMatched.Count} Historical rows.&quot;);&#xA;Console.WriteLine($&quot;🧹 REMOVED: {removedGl} from GL, {removedHist} from Historical.&quot;);&#xA;" DisplayName="dtGlStatementPRDPAGR1AGR2 VS &quot;On-us purchases updated CMS only&quot;" sap:VirtualizedContainerService.HintSize="456.6666666666667,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_245" Language="CSharp">

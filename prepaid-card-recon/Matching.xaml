        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === CONFIGURATION ===&#xA;int timeTolerance = 80; // in seconds&#xA;bool enableLogging = true;&#xA;void Log(string msg) { if (enableLogging) Console.WriteLine(msg); }&#xA;&#xA;// === Helper: Parse TIME string into seconds since midnight ===&#xA;int ParseTimeToSeconds(string time)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(time)) return -1;&#xA;    var parts = time.Split(':');&#xA;    if (parts.Length &lt; 2) return -1;&#xA;&#xA;    int h = int.TryParse(parts[0], out var hh) ? hh : 0;&#xA;    int m = int.TryParse(parts[1], out var mm) ? mm : 0;&#xA;    int s = (parts.Length &gt; 2 &amp;&amp; int.TryParse(parts[2], out var ss)) ? ss : 0;&#xA;&#xA;    return (h * 3600) + (m * 60) + s;&#xA;}&#xA;&#xA;// === Step 1: Build TRX lookup indexed by C_PAN+Amount+Date, with TIME in seconds ===&#xA;var trxLookup = new Dictionary&lt;string, List&lt;(DataRow Row, int TimeSec)&gt;&gt;();&#xA;&#xA;foreach (DataRow row in dtTransactionReportLoadAndReload.Rows)&#xA;{&#xA;    var key = row[&quot;C_PAN_AMOUNT_DATE_TIME&quot;]?.ToString();&#xA;    if (string.IsNullOrWhiteSpace(key)) continue;&#xA;&#xA;    int timeSec = ParseTimeToSeconds(row[&quot;TIME&quot;]?.ToString());&#xA;    if (timeSec == -1) continue;&#xA;&#xA;    if (!trxLookup.TryGetValue(key, out var list))&#xA;        list = trxLookup[key] = new List&lt;(DataRow, int)&gt;();&#xA;&#xA;    list.Add((row, timeSec));&#xA;}&#xA;&#xA;// === Step 2: Match GL rows with TRX rows within time tolerance ===&#xA;var glMatches = new List&lt;DataRow&gt;();&#xA;var trMatches = new List&lt;DataRow&gt;();&#xA;var matchedTrxIndices = new HashSet&lt;int&gt;();&#xA;&#xA;for (int i = 0; i &lt; dtGlStatementPRDPAGR1AGR2.Rows.Count; i++)&#xA;{&#xA;    var glRow = dtGlStatementPRDPAGR1AGR2.Rows[i];&#xA;    var key = glRow[&quot;C_PAN_AMOUNT_DATE_TIME&quot;]?.ToString();&#xA;    if (string.IsNullOrWhiteSpace(key) || !trxLookup.TryGetValue(key, out var trxCandidates))&#xA;        continue;&#xA;&#xA;    int glTimeSec = ParseTimeToSeconds(glRow[&quot;TIME&quot;]?.ToString());&#xA;    if (glTimeSec == -1) continue;&#xA;&#xA;    foreach (var (trRow, trTimeSec) in trxCandidates)&#xA;    {&#xA;        int trIndex = dtTransactionReportLoadAndReload.Rows.IndexOf(trRow);&#xA;        if (matchedTrxIndices.Contains(trIndex)) continue;&#xA;&#xA;        if (Math.Abs(glTimeSec - trTimeSec) &lt;= timeTolerance)&#xA;        {&#xA;            glRow[&quot;MATCH&quot;] = true;&#xA;            trRow[&quot;MATCH&quot;] = true;&#xA;&#xA;            glMatches.Add(glRow);&#xA;            trMatches.Add(trRow);&#xA;            matchedTrxIndices.Add(trIndex);&#xA;            break;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;Log($&quot;[MATCH] Tolerant matches found: GL = {glMatches.Count}, TRX = {trMatches.Count}&quot;);&#xA;&#xA;// === Step 3: Import matched rows ===&#xA;foreach (var row in glMatches)&#xA;    dtGlStatementMatched.ImportRow(row);&#xA;&#xA;foreach (var row in trMatches)&#xA;    dtTransactionReportMatched.ImportRow(row);&#xA;&#xA;Log(&quot;[MOVE] Imported matched rows to final tables.&quot;);&#xA;&#xA;// === Step 4: Remove matched GL rows (safe reverse loop) ===&#xA;var glIndicesToDelete = new HashSet&lt;int&gt;();&#xA;foreach (var row in glMatches)&#xA;{&#xA;    int idx = dtGlStatementPRDPAGR1AGR2.Rows.IndexOf(row);&#xA;    if (idx &gt;= 0) glIndicesToDelete.Add(idx);&#xA;}&#xA;&#xA;for (int i = dtGlStatementPRDPAGR1AGR2.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    if (glIndicesToDelete.Contains(i))&#xA;        dtGlStatementPRDPAGR1AGR2.Rows.RemoveAt(i);&#xA;}&#xA;&#xA;// === Step 5: Remove matched TRX rows (safe reverse loop) ===&#xA;var trIndicesToDelete = new HashSet&lt;int&gt;(matchedTrxIndices);&#xA;&#xA;for (int i = dtTransactionReportLoadAndReload.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    if (trIndicesToDelete.Contains(i))&#xA;        dtTransactionReportLoadAndReload.Rows.RemoveAt(i);&#xA;}&#xA;&#xA;// === Step 6: Final Log Summary ===&#xA;Log(&quot;✅ [SUMMARY] TIME-tolerance match complete.&quot;);&#xA;Log($&quot;   → Matched GL rows: {glMatches.Count}&quot;);&#xA;Log($&quot;   → Matched TRX rows: {trMatches.Count}&quot;);&#xA;Log($&quot;   → Remaining GL rows: {dtGlStatementPRDPAGR1AGR2.Rows.Count}&quot;);&#xA;Log($&quot;   → Remaining TRX rows: {dtTransactionReportLoadAndReload.Rows.Count}&quot;);&#xA;" DisplayName="HH:mm:ss dtGlStatementPRDPAGR1AGR2 vs Load/Reload" sap:VirtualizedContainerService.HintSize="453.6,56.8" sap2010:WorkflowViewState.IdRef="InvokeCode_219" Language="CSharp">

uot;RRN&quot;] != DBNull.Value)&#xA;    .GroupBy(r =&gt; GetKey(r[&quot;C_PAN&quot;].ToString(), r[&quot;RRN&quot;].ToString()))&#xA;    .ToDictionary(g =&gt; g.Key, g =&gt; g.ToList());&#xA;&#xA;// === Combo generator (1 or 2 row combinations) ===&#xA;IEnumerable&lt;List&lt;T&gt;&gt; GetFastCombos&lt;T&gt;(List&lt;T&gt; list)&#xA;{&#xA;    for (int i = 0; i &lt; list.Count; i++)&#xA;        yield return new List&lt;T&gt; { list[i] };&#xA;&#xA;    for (int i = 0; i &lt; list.Count - 1; i++)&#xA;    for (int j = i + 1; j &lt; list.Count; j++)&#xA;        yield return new List&lt;T&gt; { list[i], list[j] };&#xA;}&#xA;&#xA;// === Track matched ===&#xA;var glMatched = new HashSet&lt;DataRow&gt;();&#xA;var remoteMatched = new HashSet&lt;DataRow&gt;();&#xA;&#xA;// === STEP 1: Try combo matches ===&#xA;foreach (var key in glGroups.Keys.Intersect(remoteGroups.Keys))&#xA;{&#xA;    var glList = glGroups[key].Where(r =&gt; !glMatched.Contains(r)).ToList();&#xA;    var remoteList = remoteGroups[key].Where(r =&gt; !remoteMatched.Contains(r.Row)).ToList();&#xA;&#xA;    foreach (var glRow in glList)&#xA;    {&#xA;        decimal glAmount = GetAmount(glRow, &quot;Debit (TZS)&quot;, &quot;Credit (TZS)&quot;);&#xA;        if (glAmount == 0) continue;&#xA;&#xA;        foreach (var combo in GetFastCombos(remoteList))&#xA;        {&#xA;            if (combo.All(r =&gt; !remoteMatched.Contains(r.Row)))&#xA;            {&#xA;                decimal comboSum = combo.Sum(x =&gt; x.Amount);&#xA;                if (Math.Round(comboSum, 2) == Math.Round(glAmount, 2))&#xA;                {&#xA;                    glRow[&quot;MATCH&quot;] = true;&#xA;                    glMatched.Add(glRow);&#xA;                    dtGlStatementMatched.ImportRow(glRow);&#xA;&#xA;                    foreach (var r in combo)&#xA;                    {&#xA;                        r.Row[&quot;MATCH&quot;] = true;&#xA;                        remoteMatched.Add(r.Row);&#xA;                        dtTransactionReportMatc
                      <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Ensure the summary DataTable is initialized&#xA;If dtTransactionReportSummary Is Nothing Then&#xA;    dtTransactionReportSummary = New DataTable()&#xA;End If&#xA;&#xA;' Create columns in the summary table&#xA;dtTransactionReportSummary.Columns.Add(&quot;Transaction Code&quot;, GetType(String))&#xA;dtTransactionReportSummary.Columns.Add(&quot;Total Billing Amount&quot;, GetType(Decimal)) ' Use Decimal for financial data&#xA;&#xA;' Group data by Transaction Code and calculate totals&#xA;Dim groupedData = dtTransactionReport.AsEnumerable() _&#xA;    .GroupBy(Function(row) row.Field(Of String)(&quot;Transaction Code&quot;)) _&#xA;    .Select(Function(Group) New With {&#xA;        .TransactionCode = Group.Key,&#xA;        .TotalBillingAmount = Group.Sum(Function(row) Convert.ToDecimal(row(&quot;Billing Amount&quot;))) ' Convert to Decimal explicitly&#xA;    })&#xA;&#xA;' Populate the summary table&#xA;For Each Group In groupedData&#xA;    dtTransactionReportSummary.Rows.Add(Group.TransactionCode, Group.TotalBillingAmount)&#xA;Next&#xA;&#xA;' Calculate the grand total&#xA;Dim grandTotal As Decimal = dtTransactionReport.AsEnumerable() _&#xA;    .Sum(Function(row) Convert.ToDecimal(row(&quot;Billing Amount&quot;))) ' Convert to Decimal explicitly&#xA;dtTransactionReportSummary.Rows.Add(&quot;Grand Total&quot;, grandTotal)&#xA;grandTotalTransactionReport = grandTotal&#xA;&#xA;' Output the summary table (for testing/debugging purposes)&#xA;'For Each row As DataRow In dtTransactionReportSummary.Rows&#xA;    'Console.WriteLine(String.Format(&quot;Transaction Code: {0}, Total Billing Amount: {1}&quot;, row(&quot;Transaction Code&quot;), row(&quot;Total Billing Amount&quot;)))&#xA;'Next&#xA;" DisplayName="summarize Txn Report by Transaction Code" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_43">

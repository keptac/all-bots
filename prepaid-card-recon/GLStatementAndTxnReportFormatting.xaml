                <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Helper: Extract PAN from narration ===&#xA;string ExtractPan(string text)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(text))&#xA;        return &quot;MISSING_PAN&quot;;&#xA;&#xA;    text = text.Replace(&quot;******&quot;, &quot;XXXXXX&quot;)&#xA;               .Replace(&quot;xxxxxx&quot;, &quot;XXXXXX&quot;)&#xA;               .Replace(&quot;000000&quot;, &quot;XXXXXX&quot;);&#xA;&#xA;    var billMatch = Regex.Match(text, @&quot;Bill\s*Number\s*:\s*([^\s]+)&quot;, RegexOptions.IgnoreCase);&#xA;    if (billMatch.Success)&#xA;    {&#xA;        string rawSegment = billMatch.Groups[1].Value;&#xA;        var parts = rawSegment.Split('!', StringSplitOptions.RemoveEmptyEntries);&#xA;        foreach (var part in parts)&#xA;        {&#xA;            var masked = Regex.Match(part, @&quot;^(\d{6})[Xx*]{6}(\d{4})$&quot;);&#xA;            if (masked.Success)&#xA;                return $&quot;{masked.Groups[1].Value}XXXXXX{masked.Groups[2].Value}&quot;;&#xA;&#xA;            var brokenMasked = Regex.Match(part, @&quot;^(\d{5})[Xx*]{6}(\d{5})$&quot;);&#xA;            if (brokenMasked.Success)&#xA;                return $&quot;{brokenMasked.Groups[1].Value}0XXXXXX{brokenMasked.Groups[2].Value.Substring(1, 4)}&quot;;&#xA;&#xA;            var digits = Regex.Replace(part, @&quot;\D&quot;, &quot;&quot;);&#xA;            if (digits.Length == 16)&#xA;                return digits.Substring(0, 6) + &quot;XXXXXX&quot; + digits.Substring(12, 4);&#xA;        }&#xA;    }&#xA;    return &quot;MISSING_PAN&quot;;&#xA;}&#xA;&#xA;// === Helper: Extract RRN from narration (forced 12 digits) ===&#xA;string ExtractRRN(string text)&#xA;{&#xA;    var match = Regex.Match(text, @&quot;TrxID\s*[:：]?\s*([A-Z0-9]+)&quot;, RegexOptions.IgnoreCase);&#xA;    string rrnRaw = match.Success ? match.Groups[1].Value.Trim() : &quot;&quot;;&#xA;&#xA;    // Extract digits only and pad to 12&#xA;    string rrnDigits = Regex.Replace(rrnRaw, @&quot;\D&quot;, &quot;&quot;);&#xA;    if (string.IsNullOrWhiteSpace(rrnDigits))&#xA;        return &quot;000000000000&quot;;&#xA;&#xA;    return rrnDigits.PadLeft(12, '0');&#xA;}&#xA;&#xA;// === Main logic ===&#xA;int updatedPanCount = 0;&#xA;int updatedRRNCount = 0;&#xA;&#xA;foreach (DataRow row in dtGlStatement.Rows)&#xA;{&#xA;    string narration = row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;;&#xA;&#xA;    // Extract and update PAN if missing&#xA;    if (row[&quot;C_PAN&quot;]?.ToString() == &quot;MISSING_PAN&quot; || string.IsNullOrWhiteSpace(row[&quot;C_PAN&quot;]?.ToString()))&#xA;    {&#xA;        string pan = ExtractPan(narration);&#xA;        if (!string.IsNullOrWhiteSpace(pan) &amp;&amp; pan != &quot;MISSING_PAN&quot;)&#xA;        {&#xA;            row[&quot;C_PAN&quot;] = pan;&#xA;            updatedPanCount++;&#xA;        }&#xA;    }&#xA;&#xA;    // Always update RRN, even if current value exists&#xA;    if (row.Table.Columns.Contains(&quot;RRN&quot;))&#xA;    {&#xA;        string rrn = ExtractRRN(narration);&#xA;        row[&quot;RRN&quot;] = rrn;&#xA;        updatedRRNCount++;&#xA;    }&#xA;}&#xA;&#xA;dtGlStatement.AcceptChanges();&#xA;&#xA;// === Final summary ===&#xA;Console.WriteLine($&quot;✅ PANs newly filled: {updatedPanCount}&quot;);&#xA;Console.WriteLine($&quot;✅ RRNs updated (forced 12-digit): {updatedRRNCount}&quot;);&#xA;" DisplayName="Extract C_PAN for BillNumber:" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_32" Language="CSharp">

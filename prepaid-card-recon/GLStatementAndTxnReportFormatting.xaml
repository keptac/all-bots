          <ui:InvokeCode ContinueOnError="{x:Null}" Code="/*&#xA;---------------------------------------------------&#xA;STEP 4: REMOVE WALLET TRANSACTIONS (reconCurrency-reconCurrency)&#xA;---------------------------------------------------&#xA;This code removes rows from dtTransactionReport where:&#xA;✅ Transaction Type contains &quot;wallet&quot; (case-insensitive)&#xA;✅ Billing Currency == reconCurrency&#xA;✅ Transaction Currency == reconCurrency&#xA;---------------------------------------------------&#xA;*/&#xA;&#xA;// 🔧 Helper to normalize: lowercase, trim, collapse spaces&#xA;string Normalize(string input)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(input)) return string.Empty;&#xA;    return System.Text.RegularExpressions.Regex.Replace(input.Trim(), @&quot;\s+&quot;, &quot; &quot;).ToLowerInvariant();&#xA;}&#xA;&#xA;// 🔧 Normalize reconCurrency once&#xA;string reconCurrencyNormalized = Normalize(reconCurrency);&#xA;&#xA;// 🔧 Resolve actual column names using normalized comparison&#xA;string billingCurrencyCol = null;&#xA;string transactionCurrencyCol = null;&#xA;string transactionTypeCol = null;&#xA;&#xA;foreach (System.Data.DataColumn col in dtTransactionReport.Columns)&#xA;{&#xA;    var name = Normalize(col.ColumnName);&#xA;    if (name == &quot;billing currency&quot;) billingCurrencyCol = col.ColumnName;&#xA;    else if (name == &quot;transaction currency&quot;) transactionCurrencyCol = col.ColumnName;&#xA;    else if (name == &quot;transaction type&quot;) transactionTypeCol = col.ColumnName;&#xA;}&#xA;&#xA;// ❌ Throw error if any required column is missing&#xA;if (billingCurrencyCol == null || transactionCurrencyCol == null || transactionTypeCol == null)&#xA;{&#xA;    throw new System.Exception(&quot;❌ Required columns not found. Check for typos or spacing in column names.&quot;);&#xA;}&#xA;&#xA;// 📝 Log resolved column names&#xA;System.Console.WriteLine($&quot;📌 Resolved Columns → Billing: '{billingCurrencyCol}', Transaction: '{transactionCurrencyCol}', Type: '{transactionTypeCol}'&quot;);&#xA;&#xA;// ✅ Collect rows to delete based on condition&#xA;var rowsToDelete = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;&#xA;foreach (System.Data.DataRow row in dtTransactionReport.Rows)&#xA;{&#xA;    string billingCurrency = Normalize(row[billingCurrencyCol]?.ToString());&#xA;    string transactionCurrency = Normalize(row[transactionCurrencyCol]?.ToString());&#xA;    string transactionType = Normalize(row[transactionTypeCol]?.ToString());&#xA;&#xA;    if (transactionType.Contains(&quot;wallet&quot;) &amp;&amp;&#xA;        billingCurrency == reconCurrencyNormalized &amp;&amp;&#xA;        transactionCurrency == reconCurrencyNormalized)&#xA;    {&#xA;        rowsToDelete.Add(row);&#xA;    }&#xA;}&#xA;&#xA;// 🧹 Remove matched rows&#xA;foreach (var row in rowsToDelete)&#xA;{&#xA;    dtTransactionReport.Rows.Remove(row);&#xA;}&#xA;&#xA;// ✅ Commit changes to the DataTable&#xA;dtTransactionReport.AcceptChanges();&#xA;&#xA;// 🧾 Final summary&#xA;System.Console.WriteLine($&quot;STEP 4 ✅ Total rows removed where wallet &amp; currency == {reconCurrency}: {rowsToDelete.Count}&quot;);&#xA;" DisplayName="STEP 4) &quot;Wallet&quot; Billing Currency == reconCurrency and Transaction Currency == TZS" sap:VirtualizedContainerService.HintSize="486.6666666666667,57.333333333333336" sap2010:WorkflowViewState.IdRef="InvokeCode_60" Language="CSharp">

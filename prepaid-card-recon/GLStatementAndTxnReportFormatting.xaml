          <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === 1. Ensure MATCH column exists ===&#xA;if (!dtTransactionReport.Columns.Contains(&quot;MATCH&quot;))&#xA;    dtTransactionReport.Columns.Add(&quot;MATCH&quot;, typeof(bool));&#xA;&#xA;if (!dtTransactionReportRev.Columns.Contains(&quot;MATCH&quot;))&#xA;    dtTransactionReportRev.Columns.Add(&quot;MATCH&quot;, typeof(bool));&#xA;&#xA;// === 2. Helper to Copy Row ===&#xA;void CopyRow_Optimized(DataRow source, DataRow target, DataTable targetTable)&#xA;{&#xA;    foreach (DataColumn col in targetTable.Columns)&#xA;    {&#xA;        if (source.Table.Columns.Contains(col.ColumnName))&#xA;        {&#xA;            target[col.ColumnName] = source[col.ColumnName];&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === 3. Build lookup by (ARN[0:23] + Abs(Billing Amount)) ===&#xA;var unmatched = dtTransactionReport.AsEnumerable()&#xA;    .Where(r =&gt; r[&quot;MATCH&quot;] == DBNull.Value || !Convert.ToBoolean(r[&quot;MATCH&quot;]))&#xA;    .Where(r =&gt;&#xA;        !string.IsNullOrWhiteSpace(r[&quot;ARN&quot;]?.ToString()) &amp;&amp;&#xA;        r[&quot;ARN&quot;].ToString().Length &gt;= 23 &amp;&amp;&#xA;        !string.IsNullOrWhiteSpace(r[&quot;Billing Amount&quot;]?.ToString()) &amp;&amp;&#xA;        !string.IsNullOrWhiteSpace(r[&quot;DR/CR to Cardholder&quot;]?.ToString()))&#xA;    .ToList();&#xA;&#xA;var lookup = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;();&#xA;&#xA;foreach (var row in unmatched)&#xA;{&#xA;    string arnPrefix = row[&quot;ARN&quot;].ToString().Substring(0, 23).Trim();&#xA;    string drcr = row[&quot;DR/CR to Cardholder&quot;].ToString().Trim().ToUpper();&#xA;&#xA;    if (!decimal.TryParse(&#xA;        row[&quot;Billing Amount&quot;].ToString().Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;),&#xA;        out var amount))&#xA;        continue;&#xA;&#xA;    string key = $&quot;{arnPrefix}|{Math.Abs(amount):0.00}&quot;;&#xA;&#xA;    if (!lookup.ContainsKey(key))&#xA;        lookup[key] = new List&lt;DataRow&gt;();&#xA;&#xA;    lookup[key].Add(row);&#xA;}&#xA;&#xA;// === 4. Match DR/CR pairs&#xA;foreach (var kvp in lookup)&#xA;{&#xA;    var rows = kvp.Value;&#xA;    var drList = rows.Where(r =&gt; r[&quot;DR/CR to Cardholder&quot;].ToString().Trim().ToUpper() == &quot;DR&quot;).ToList();&#xA;    var crList = rows.Where(r =&gt; r[&quot;DR/CR to Cardholder&quot;].ToString().Trim().ToUpper() == &quot;CR&quot;).ToList();&#xA;&#xA;    int pairCount = Math.Min(drList.Count, crList.Count);&#xA;&#xA;    for (int i = 0; i &lt; pairCount; i++)&#xA;    {&#xA;        drList[i][&quot;MATCH&quot;] = true;&#xA;        crList[i][&quot;MATCH&quot;] = true;&#xA;    }&#xA;}&#xA;&#xA;// === 5. Move matched rows to dtTransactionReportRev&#xA;var toMove = dtTransactionReport.AsEnumerable()&#xA;    .Where(row =&gt; row[&quot;MATCH&quot;] != DBNull.Value &amp;&amp; Convert.ToBoolean(row[&quot;MATCH&quot;]))&#xA;    .ToList();&#xA;&#xA;foreach (var row in toMove)&#xA;{&#xA;    var newRow = dtTransactionReportRev.NewRow();&#xA;    CopyRow_Optimized(row, newRow, dtTransactionReportRev);&#xA;    newRow[&quot;MATCH&quot;] = true;&#xA;    dtTransactionReportRev.Rows.Add(newRow);&#xA;    dtTransactionReport.Rows.Remove(row);&#xA;}&#xA;&#xA;// === 6. Finalize changes ===&#xA;dtTransactionReport.AcceptChanges();&#xA;dtTransactionReportRev.AcceptChanges();&#xA;&#xA;// === 7. Summary ===&#xA;int matched = dtTransactionReportRev.AsEnumerable()&#xA;    .Count(r =&gt; r[&quot;MATCH&quot;] != DBNull.Value &amp;&amp; Convert.ToBoolean(r[&quot;MATCH&quot;]));&#xA;&#xA;Console.WriteLine(&quot;=============================================&quot;);&#xA;Console.WriteLine($&quot;✅ DR/CR Matched Pairs Removed: {matched}&quot;);&#xA;Console.WriteLine($&quot;✅ Remaining rows in dtTransactionReport: {dtTransactionReport.Rows.Count}&quot;);&#xA;Console.WriteLine(&quot;=============================================&quot;);&#xA;" DisplayName="Remove Auto REV GRP (DR/CR PAIR)" sap:VirtualizedContainerService.HintSize="486.6666666666667,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_68" Language="CSharp">

          <ui:InvokeCode ContinueOnError="{x:Null}" Code="System.Diagnostics.Stopwatch sw = System.Diagnostics.Stopwatch.StartNew();&#xA;&#xA;var rowsToDelete = new HashSet&lt;DataRow&gt;();&#xA;int removedRowsCount = 0;&#xA;&#xA;// === Build quick lookup for Transaction Ref No: ===&#xA;var txnRefLookup = dtGlStatement.AsEnumerable()&#xA;    .Where(r =&gt; !Convert.IsDBNull(r[&quot;Transaction Ref No:&quot;]))&#xA;    .GroupBy(r =&gt; r.Field&lt;string&gt;(&quot;Transaction Ref No:&quot;)?.Trim() ?? string.Empty)&#xA;    .ToDictionary(g =&gt; g.Key, g =&gt; g.ToList());&#xA;&#xA;// === Build quick lookup for Reversals GL already inserted ===&#xA;var reversalsInserted = new HashSet&lt;string&gt;();&#xA;&#xA;// === Process each transaction ===&#xA;foreach (var row in dtGlStatement.AsEnumerable())&#xA;{&#xA;    string txnRef = row.Field&lt;string&gt;(&quot;Transaction Ref No:&quot;)?.Trim() ?? string.Empty;&#xA;    if (string.IsNullOrEmpty(txnRef))&#xA;        continue;&#xA;&#xA;    decimal debitAmount = 0, creditAmount = 0;&#xA;    decimal.TryParse(row[&quot;Debit (TZS)&quot;]?.ToString(), out debitAmount);&#xA;    decimal.TryParse(row[&quot;Credit (TZS)&quot;]?.ToString(), out creditAmount);&#xA;&#xA;    // Skip rows with zero debit and credit&#xA;    if (debitAmount == 0 &amp;&amp; creditAmount == 0)&#xA;        continue;&#xA;&#xA;    if (!txnRefLookup.TryGetValue(txnRef, out var possibleMatches))&#xA;        continue;&#xA;&#xA;    foreach (var reversalRow in possibleMatches)&#xA;    {&#xA;        if (object.ReferenceEquals(row, reversalRow))&#xA;            continue; // Don't match with itself&#xA;&#xA;        decimal revDebit = 0, revCredit = 0;&#xA;        decimal.TryParse(reversalRow[&quot;Debit (TZS)&quot;]?.ToString(), out revDebit);&#xA;        decimal.TryParse(reversalRow[&quot;Credit (TZS)&quot;]?.ToString(), out revCredit);&#xA;&#xA;        bool isReversal = &#xA;            (revDebit == -debitAmount &amp;&amp; revCredit == 0) ||&#xA;            (revCredit == -creditAmount &amp;&amp; revDebit == 0);&#xA;&#xA;        if (isReversal)&#xA;        {&#xA;            string rowKey = $&quot;{txnRef}|{debitAmount}|{creditAmount}&quot;;&#xA;            string reversalKey = $&quot;{txnRef}|{revDebit}|{revCredit}&quot;;&#xA;&#xA;            // Add the original row if not yet inserted&#xA;            if (reversalsInserted.Add(rowKey))&#xA;                dtReversalsGl.ImportRow(row);&#xA;&#xA;            // Add the reversal row if not yet inserted&#xA;            if (reversalsInserted.Add(reversalKey))&#xA;                dtReversalsGl.ImportRow(reversalRow);&#xA;&#xA;            // Mark both rows for deletion&#xA;            rowsToDelete.Add(row);&#xA;            rowsToDelete.Add(reversalRow);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Remove marked rows safely ===&#xA;foreach (var rowToDelete in rowsToDelete)&#xA;{&#xA;    try&#xA;    {&#xA;        dtGlStatement.Rows.Remove(rowToDelete);&#xA;        removedRowsCount++;&#xA;    }&#xA;    catch (Exception ex)&#xA;    {&#xA;        Console.WriteLine($&quot;❌ Error removing row: {ex.Message}&quot;);&#xA;    }&#xA;}&#xA;&#xA;// === Final log ===&#xA;sw.Stop();&#xA;Console.WriteLine($&quot;✅ REVERSALS&quot;);&#xA;Console.WriteLine($&quot;✅ Total Rows Removed: {removedRowsCount} in {sw.ElapsedMilliseconds} ms&quot;);&#xA;" DisplayName="REMOVE Reversals (Debit (TZS)/Credit (TZS) " sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_52" Language="CSharp">

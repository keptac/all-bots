          <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Find the index of the first row where Balance equals glCutOffBalance&#xA;int cutoffIndex = -1;&#xA;for (int i = 0; i &lt; dtGlStatement.Rows.Count; i++)&#xA;{&#xA;    var balanceStr = dtGlStatement.Rows[i][&quot;Balance&quot;]?.ToString()?.Trim();&#xA;    if (decimal.TryParse(balanceStr, out decimal balanceValue))&#xA;    {&#xA;        if (balanceValue == glCutOffBalance)&#xA;        {&#xA;            cutoffIndex = i;&#xA;            break;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// If cutoff not found, log and exit&#xA;if (cutoffIndex == -1)&#xA;{&#xA;    Console.WriteLine($&quot;❌ Cutoff balance {glCutOffBalance} not found in 'Balance' column.&quot;);&#xA;}&#xA;else&#xA;{&#xA;    // Remove from 0 to cutoffIndex (inclusive)&#xA;    int rowsToRemove = cutoffIndex + 1;&#xA;    for (int i = 0; i &lt; rowsToRemove; i++)&#xA;    {&#xA;        dtGlStatement.Rows.RemoveAt(0); // Always remove the first row (rows shift up after each remove)&#xA;    }&#xA;&#xA;    Console.WriteLine($&quot;✅ Removed {rowsToRemove} rows from GL statement (from top to glCutOffBalance).&quot;);&#xA;}&#xA;" DisplayName="Remove Transactions glCutOffBalance &gt;=" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_26" Language="CSharp">

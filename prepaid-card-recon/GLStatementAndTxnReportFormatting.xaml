          <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ✅ Normalize helper&#xA;string Normalize(string input)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(input)) return string.Empty;&#xA;    return System.Text.RegularExpressions.Regex.Replace(input.Trim(), @&quot;\s+&quot;, &quot; &quot;).ToLowerInvariant();&#xA;}&#xA;&#xA;// ✅ Normalize reconCurrency once&#xA;string reconCurrencyNormalized = Normalize(reconCurrency);&#xA;&#xA;// ✅ Resolve actual column names&#xA;string billingCurrencyCol = null;&#xA;string transactionCurrencyCol = null;&#xA;&#xA;foreach (System.Data.DataColumn col in dtTransactionReport.Columns)&#xA;{&#xA;    var name = Normalize(col.ColumnName);&#xA;    if (name == &quot;billing currency&quot;) billingCurrencyCol = col.ColumnName;&#xA;    else if (name == &quot;transaction currency&quot;) transactionCurrencyCol = col.ColumnName;&#xA;}&#xA;&#xA;if (billingCurrencyCol == null || transactionCurrencyCol == null)&#xA;{&#xA;    throw new System.Exception(&quot;❌ Required columns not found.&quot;);&#xA;}&#xA;&#xA;// ✅ Identify rows to remove&#xA;var rowsToDelete = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;&#xA;foreach (System.Data.DataRow row in dtTransactionReport.Rows)&#xA;{&#xA;    string billingCurrency = Normalize(row[billingCurrencyCol]?.ToString());&#xA;    string transactionCurrency = Normalize(row[transactionCurrencyCol]?.ToString());&#xA;&#xA;    if (billingCurrency != reconCurrencyNormalized &amp;&amp; transactionCurrency != reconCurrencyNormalized)&#xA;    {&#xA;        rowsToDelete.Add(row);&#xA;    }&#xA;}&#xA;&#xA;// 🧹 Remove rows&#xA;foreach (var row in rowsToDelete)&#xA;{&#xA;    dtTransactionReport.Rows.Remove(row);&#xA;}&#xA;&#xA;// 🧾 Summary&#xA;System.Console.WriteLine($&quot;STEP 1 ✅ Total rows removed where both Billing and Transaction Currency != {reconCurrency}: {rowsToDelete.Count}&quot;);&#xA;" DisplayName="STEP 1) billingCurrency != &quot;reconCurrency&quot; &amp;&amp; transactionCurrency != &q
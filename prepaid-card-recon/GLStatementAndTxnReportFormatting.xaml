          <ui:InvokeCode ContinueOnError="{x:Null}" Code="&#xA;&#xA;// Assume: toDate and dtGlStatement are passed as arguments&#xA;&#xA;DateTime parsedToDate;&#xA;&#xA;if (!DateTime.TryParseExact(toDate, &quot;dd-MM-yyyy&quot;, CultureInfo.InvariantCulture, DateTimeStyles.None, out parsedToDate))&#xA;    throw new ArgumentException(&quot;Invalid toDate format. Expected format: dd-MM-yyyy&quot;);&#xA;&#xA;// 👇 Shift toDate back by 1 day&#xA;parsedToDate = parsedToDate.AddDays(-1);&#xA;&#xA;// Step 1: Identify index of the last row with Value Date == toDate - 1&#xA;int lastToDateIndex = -1;&#xA;for (int i = 0; i &lt; dtGlStatement.Rows.Count; i++)&#xA;{&#xA;    string rawDate = dtGlStatement.Rows[i][&quot;Value Date&quot;]?.ToString();&#xA;    if (DateTime.TryParse(rawDate, out DateTime valueDate) &amp;&amp; valueDate.Date == parsedToDate.Date)&#xA;    {&#xA;        lastToDateIndex = i;&#xA;    }&#xA;}&#xA;&#xA;if (lastToDateIndex == -1)&#xA;    throw new Exception($&quot;❌ No row found with Value Date equal to {parsedToDate:dd-MM-yyyy}&quot;);&#xA;&#xA;// Step 2: Remove all rows after the last matching toDate row&#xA;int deletedCount = 0;&#xA;for (int i = dtGlStatement.Rows.Count - 1; i &gt; lastToDateIndex; i--)&#xA;{&#xA;    dtGlStatement.Rows.RemoveAt(i);&#xA;    deletedCount++;&#xA;}&#xA;&#xA;// Step 3: Log the result&#xA;Console.WriteLine($&quot;🗑️ Removed {deletedCount} row(s) after the last entry with Value Date = {parsedToDate:dd-MM-yyyy}&quot;);&#xA;&#xA;// Step 4: Print Closing Balance&#xA;// Assume: decimal glClosingBalance (passed as an out argument)&#xA;&#xA;if (dtGlStatement.Rows.Count &gt; 0)&#xA;{&#xA;    string balanceStr = dtGlStatement.Rows[dtGlStatement.Rows.Count - 1][&quot;Balance&quot;]?.ToString();&#xA;&#xA;    if (decimal.TryParse(balanceStr, out decimal parsedBalance))&#xA;    {&#xA;        glClosingBalance = parsedBalance;&#xA;        Console.WriteLine($&quot;🔚 Closing Balance: {glClosingBalance}&quot;);&#xA;    }&#xA;    else&#xA;    {&#xA;        glClosingBalance = 0;&#xA;        Console.WriteLine($&quot;⚠️ Could not parse closing balance: '{balanceStr}'&quot;);&#xA;    }&#xA;}&#xA;else&#xA;{&#xA;    glClosingBalance = 0;&#xA;    Console.WriteLine(&quot;⚠️ No rows remain in the table after filtering. No Closing Balance available.&quot;);&#xA;}" DisplayName="Remove Transactions after last Value Date == toDate" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_27" Language="CSharp">

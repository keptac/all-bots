          <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Utility: Rename columns in a DataTable (includes ARN → Transaction Ref No: with trimming) ===&#xA;void RenameColumns(DataTable table, Dictionary&lt;string, string&gt; renameMap)&#xA;{&#xA;    foreach (var kvp in renameMap)&#xA;    {&#xA;        string original = kvp.Key;&#xA;        string target = kvp.Value;&#xA;&#xA;        if (!table.Columns.Contains(original)) continue;&#xA;        if (original == target) continue;&#xA;&#xA;        // Special case: ARN → Transaction Ref No: with 23-char trimming&#xA;        if (original == &quot;ARN&quot; &amp;&amp; target == &quot;Transaction Ref No:&quot;)&#xA;        {&#xA;            if (table.Columns.Contains(target))&#xA;                table.Columns.Remove(target);&#xA;&#xA;            table.Columns.Add(target, typeof(string));&#xA;&#xA;            foreach (DataRow row in table.Rows)&#xA;            {&#xA;                string val = row[original]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;                row[target] = val.Length &gt;= 23 ? val.Substring(0, 23) : val;&#xA;            }&#xA;&#xA;            table.Columns.Remove(original);&#xA;        }&#xA;        else&#xA;        {&#xA;            if (table.Columns.Contains(target))&#xA;                table.Columns.Remove(target);&#xA;&#xA;            table.Columns[original].ColumnName = target;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Utility: Add C_PAN column if missing and mask Device Number ===&#xA;void MaskDeviceNumberToCPAN(DataTable table)&#xA;{&#xA;    if (!table.Columns.Contains(&quot;C_PAN&quot;))&#xA;        table.Columns.Add(&quot;C_PAN&quot;, typeof(string));&#xA;&#xA;    foreach (DataRow row in table.Rows)&#xA;    {&#xA;        string deviceNumber = row[&quot;Device Number&quot;]?.ToString()?.Trim();&#xA;        row[&quot;C_PAN&quot;] = (!string.IsNullOrEmpty(deviceNumber) &amp;&amp; deviceNumber.Length &gt;= 16)&#xA;            ? $&quot;{deviceNumber.Substring(0, 6)}XXXXXX{deviceNumber.Substring(12, 4)}&quot;&#xA;            : string.Empty;&#xA;    }&#xA;}&#xA;&#xA;// === RRN Cleanup Helper: Ensure 12 alphanumeric characters ===&#xA;string CleanRRN(string input)&#xA;{&#xA;    string alphanumeric = Regex.Replace(input ?? &quot;&quot;, &quot;[^A-Za-z0-9]&quot;, &quot;&quot;);&#xA;    if (string.IsNullOrEmpty(alphanumeric)) return &quot;000000000000&quot;;&#xA;    return alphanumeric.Length &gt;= 12&#xA;        ? alphanumeric.Substring(alphanumeric.Length - 12)&#xA;        : alphanumeric.PadLeft(12, '0');&#xA;}&#xA;&#xA;// === Step 1: Apply renaming ===&#xA;var renameMap = new Dictionary&lt;string, string&gt;&#xA;{&#xA;    { &quot;Trace Audit Number&quot;, &quot;STAN&quot; },&#xA;    { &quot;Reference Number&quot;, &quot;RRN&quot; },&#xA;    { &quot;Authorization Number&quot;, &quot;AUTHORIZATION_NUMBER&quot; },&#xA;    { &quot;ARN&quot;, &quot;Transaction Ref No:&quot; }&#xA;};&#xA;RenameColumns(dtTransactionReport, renameMap);&#xA;&#xA;// === Step 2: Apply PAN masking ===&#xA;MaskDeviceNumberToCPAN(dtTransactionReport);&#xA;&#xA;// === Step 2b: Log C_PAN consistency ===&#xA;int totalRows = dtTransactionReport.Rows.Count;&#xA;int totalCPANs = dtTransactionReport.AsEnumerable()&#xA;    .Count(r =&gt; !string.IsNullOrWhiteSpace(r[&quot;C_PAN&quot;]?.ToString()));&#xA;&#xA;Console.WriteLine($&quot;✅ Total Rows: {totalRows}&quot;);&#xA;Console.WriteLine($&quot;✅ Total C_PANs: {totalCPANs}&quot;);&#xA;&#xA;if (totalCPANs == totalRows)&#xA;{&#xA;    Console.WriteLine(&quot;✅ All rows have C_PAN values.&quot;);&#xA;}&#xA;else&#xA;{&#xA;    Console.WriteLine($&quot;⚠️ Mismatch: {totalRows - totalCPANs} row(s) missing C_PAN.&quot;);&#xA;&#xA;    var missingCPANRows = dtTransactionReport.AsEnumerable()&#xA;        .Select((r, index) =&gt; new { Row = r, Index = index + 1 })&#xA;        .Where(x =&gt; string.IsNullOrWhiteSpace(x.Row[&quot;C_PAN&quot;]?.ToString()))&#xA;        .Select(x =&gt; x.Index)&#xA;        .ToList();&#xA;&#xA;    Console.WriteLine(&quot;⚠️ Rows missing C_PAN: &quot; + string.Join(&quot;, &quot;, missingCPANRows));&#xA;}&#xA;&#xA;// === Step 3: Ensure required columns ===&#xA;if (!dtTransactionReport.Columns.Contains(&quot;C_NARRATION&quot;))&#xA;    dtTransactionReport.Columns.Add(&quot;C_NARRATION&quot;, typeof(string));&#xA;&#xA;if (!dtTransactionReport.Columns.Contains(&quot;Search Key&quot;))&#xA;    dtTransactionReport.Columns.Add(&quot;Search Key&quot;, typeof(string));&#xA;&#xA;// === Step 4: Setup normalization ===&#xA;Regex normalizeRegex = new Regex(&quot;[^a-zA-Z0-9]&quot;, RegexOptions.Compiled);&#xA;string Normalize(string val) =&gt; normalizeRegex.Replace((val ?? &quot;&quot;).Trim(), &quot;&quot;).ToUpperInvariant();&#xA;&#xA;// === Step 5: Single-pass row processing ===&#xA;foreach (DataRow row in dtTransactionReport.Rows)&#xA;{&#xA;    try&#xA;    {&#xA;        string transactionType = row[&quot;Transaction Type&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;        string cPan = row[&quot;C_PAN&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;        string stan = row.Table.Columns.Contains(&quot;STAN&quot;) ? row[&quot;STAN&quot;]?.ToString()?.Trim() ?? &quot;&quot; : &quot;&quot;;&#xA;        string rrnRaw = row.Table.Columns.Contains(&quot;RRN&quot;) ? row[&quot;RRN&quot;]?.ToString()?.Trim() ?? &quot;&quot; : &quot;&quot;;&#xA;        string authNumber = row.Table.Columns.Contains(&quot;AUTHORIZATION_NUMBER&quot;) ? row[&quot;AUTHORIZATION_NUMBER&quot;]?.ToString()?.Trim() ?? &quot;&quot; : &quot;&quot;;&#xA;&#xA;        string rrn = CleanRRN(rrnRaw); // ✅ Use alphanumeric 12-char RRN&#xA;&#xA;        row[&quot;C_NARRATION&quot;] = $&quot;{transactionType}-{cPan}-{stan}-{rrn}-{authNumber}&quot;;&#xA;&#xA;        string cleanCPAN = string.IsNullOrEmpty(cPan) ? &quot;MISSING_PAN&quot; : cPan.ToUpperInvariant();&#xA;        if (cleanCPAN == &quot;MISSING_PAN&quot;)&#xA;        {&#xA;            row[&quot;Search Key&quot;] = DBNull.Value;&#xA;            continue;&#xA;        }&#xA;&#xA;        string billingAmountFormatted = decimal.TryParse(row[&quot;Billing Amount&quot;]?.ToString(), out var billingAmount)&#xA;            ? billingAmount.ToString(&quot;F2&quot;)&#xA;            : &quot;0.00&quot;;&#xA;&#xA;        string rawKey = $&quot;{cleanCPAN}{rrn}{billingAmountFormatted}&quot;;&#xA;        row[&quot;Search Key&quot;] = Normalize(rawKey);&#xA;    }&#xA;    catch&#xA;    {&#xA;        row[&quot;Search Key&quot;] = DBNull.Value;&#xA;    }&#xA;}&#xA;" DisplayName="Search Key, CPAN, C_NARRATION, RRN, STAN, AUTH" sap:VirtualizedContainerService.HintSize="486.6666666666667,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_70" Language="CSharp">

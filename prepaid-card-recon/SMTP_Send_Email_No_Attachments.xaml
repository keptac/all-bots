      <ui:InvokeCode ContinueOnError="{x:Null}" Code="&#xD;&#xA;&#xD;&#xA;try&#xD;&#xA;{&#xD;&#xA;    // === Debug print of all input parameters ===&#xD;&#xA;    Console.WriteLine(&quot;📨 recipientEmails: &quot; + recipientEmails);&#xD;&#xA;    Console.WriteLine(&quot;📨 fromEmail: &quot; + fromEmail);&#xD;&#xA;    Console.WriteLine(&quot;📨 emailSubject: &quot; + emailSubject);&#xD;&#xA;    Console.WriteLine(&quot;📨 emailBody: &quot; + emailBody);&#xD;&#xA;    Console.WriteLine(&quot;📨 smtpServer: &quot; + smtpServer);&#xD;&#xA;    Console.WriteLine(&quot;📨 smtpPort: &quot; + smtpPort.ToString());&#xD;&#xA;&#xD;&#xA;    // === Null checks ===&#xD;&#xA;    if (string.IsNullOrWhiteSpace(recipientEmails)) throw new Exception(&quot;recipientEmails is null or empty&quot;);&#xD;&#xA;    if (string.IsNullOrWhiteSpace(fromEmail)) throw new Exception(&quot;fromEmail is null or empty&quot;);&#xD;&#xA;    if (string.IsNullOrWhiteSpace(emailSubject)) throw new Exception(&quot;emailSubject is null or empty&quot;);&#xD;&#xA;    if (string.IsNullOrWhiteSpace(emailBody)) throw new Exception(&quot;emailBody is null or empty&quot;);&#xD;&#xA;    if (string.IsNullOrWhiteSpace(smtpServer)) throw new Exception(&quot;smtpServer is null or empty&quot;);&#xD;&#xA;&#xD;&#xA;    // === Split and clean recipient list ===&#xD;&#xA;    string[] recipients = recipientEmails&#xD;&#xA;        .Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)&#xD;&#xA;        .Select(email =&gt; email.Trim())&#xD;&#xA;        .ToArray();&#xD;&#xA;&#xD;&#xA;    Console.WriteLine(&quot;✅ Parsed recipients:&quot;);&#xD;&#xA;    foreach (string email in recipients)&#xD;&#xA;    {&#xD;&#xA;        Console.WriteLine(&quot;  - &quot; + email);&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // === Create and send MailMessage ===&#xD;&#xA;    using (MailMessage mailMessage = new MailMessage())&#xD;&#xA;    {&#xD;&#xA;        mailMessage.From = new MailAddress(fromEmail);&#xD;&#xA;        mailMessage.Subject = emailSubject;&#xD;&#xA;        mailMessage.Body = emailBody;&#xD;&#xA;        mailMessage.IsBodyHtml = true;&#xD;&#xA;&#xD;&#xA;        foreach (string email in recipients)&#xD;&#xA;        {&#xD;&#xA;            mailMessage.To.Add(email);&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        using (SmtpClient smtpClient = new SmtpClient(smtpServer, smtpPort))&#xD;&#xA;        {&#xD;&#xA;            smtpClient.EnableSsl = false; // Use true if your SMTP server requires SSL&#xD;&#xA;            smtpClient.UseDefaultCredentials = true;&#xD;&#xA;&#xD;&#xA;            smtpClient.Send(mailMessage);&#xD;&#xA;            Console.WriteLine(&quot;✅ Email sent successfully via Anonymous SMTP Relay!&quot;);&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;catch (Exception ex)&#xD;&#xA;{&#xD;&#xA;    Console.WriteLine(&quot;❌ Error sending email: &quot; + ex.Message);&#xD;&#xA;}&#xD;&#xA;" DisplayName="EMAIL NO attachmnets" sap:VirtualizedContainerService.HintSize="478.4,188" sap2010:WorkflowViewState.IdRef="InvokeCode_2" Language="CSharp">

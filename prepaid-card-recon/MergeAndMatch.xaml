n 0m;&#xA;    return decimal.TryParse(value.ToString(), out var result) ? result : 0m;&#xA;}&#xA;&#xA;object SafeParseDate(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return DBNull.Value;&#xA;    return DateTime.TryParse(val.ToString(), out var dt) ? dt : DBNull.Value;&#xA;}&#xA;&#xA;object[][] ToJagged(object[,] data)&#xA;{&#xA;    int rows = data.GetLength(0), cols = data.GetLength(1);&#xA;    object[][] jagged = new object[rows][];&#xA;    for (int i = 0; i &lt; rows; i++)&#xA;    {&#xA;        jagged[i] = new object[cols];&#xA;        for (int j = 0; j &lt; cols; j++)&#xA;            jagged[i][j] = data[i, j];&#xA;    }&#xA;    return jagged;&#xA;}&#xA;" DisplayName="UNMATCHED dtHistoricalReconTransactionsReport" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_72" Language="CSharp">

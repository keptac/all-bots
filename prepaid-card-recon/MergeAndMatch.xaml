        <ui:InvokeCode ContinueOnError="{x:Null}" Code="&#xA;&#xA;// === Logging Setup ===&#xA;void Log(string message) =&gt;&#xA;    Console.WriteLine($&quot;[{DateTime.Now:yyyy-MM-dd HH:mm:ss}] {message}&quot;);&#xA;&#xA;// === Precompiled Regex ===&#xA;var regexPanMask = new Regex(@&quot;^(\d{6})[*xX0]{6}(\d{4})$&quot;, RegexOptions.Compiled);&#xA;var regexPosPrepaid = new Regex(@&quot;(550558[*xX0]{6}\d{4})\s*-\s*(\d{6})\s*-\s*(\d{12})\s*-\s*(\w+)&quot;, RegexOptions.Compiled);&#xA;&#xA;// === Helpers ===&#xA;string NormalizeCpan(string pan)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(pan)) return &quot;MISSING_PAN&quot;;&#xA;    var cleaned = Regex.Replace(pan, @&quot;[*xX0]&quot;, &quot;X&quot;);&#xA;    var match = regexPanMask.Match(cleaned);&#xA;    return match.Success ? $&quot;{match.Groups[1].Value}XXXXXX{match.Groups[2].Value}&quot; : cleaned;&#xA;}&#xA;&#xA;decimal ParseAmount(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return 0m;&#xA;    var s = val.ToString().Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;).Trim();&#xA;    return decimal.TryParse(s, out var result) ? result : 0m;&#xA;}&#xA;&#xA;void TryHandlePosPrepaidSettlementNarration(DataRow row)&#xA;{&#xA;    string narr = row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;;&#xA;    if (!narr.ToUpperInvariant().Contains(&quot;POS PREPAID SETTLEMENT&quot;)) return;&#xA;&#xA;    var match = regexPosPrepaid.Match(narr);&#xA;    if (match.Success)&#xA;    {&#xA;        row[&quot;C_PAN&quot;] = NormalizeCpan(match.Groups[1].Value.Trim());&#xA;        row[&quot;STAN&quot;] = match.Groups[2].Value.Trim();&#xA;        row[&quot;RRN&quot;] = match.Groups[3].Value.Trim();&#xA;        row[&quot;AUTHORIZATION_NUMBER&quot;] = match.Groups[4].Value.Trim();&#xA;    }&#xA;}&#xA;&#xA;// === Configuration ===&#xA;var glIdentifiers = new[] { &quot;PPSP&quot;, &quot;PPSA&quot;, &quot;CCSA&quot;, &quot;CCSP&quot; };&#xA;var cmsKeywords = new[] {&#xA;    &quot;PURCHASE/AUTH COMPLETION&quot;,&#xA;    &quot;RECURRING TRANSACTION&quot;,&#xA;    &quot;UNIQUE TXN&quot;,&#xA;    &quot;CASH WITHDRAWAL&quot;,&#xA;    &quot;POS PREPAID SETTLEMENT&quot;&#xA;};&#xA;var feeExclusionKeywords = new[] { &quot;TRANSACTION FEE&quot;, &quot;SERVICE TAX&quot;, &quot;INCOME&quot;, &quot;Purchase/Auth Completion Transaction Fee&quot;, &quot;PURCHASE/AUTH COMPLETION TRANSACTION FEE&quot; };&#xA;&#xA;// === Grouping Setup ===&#xA;var cmsGroups = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;(StringComparer.OrdinalIgnoreCase);&#xA;var glGroups = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;(StringComparer.OrdinalIgnoreCase);&#xA;&#xA;// === Pre-fetch column indexes ===&#xA;int colRef = dtHistoricalReconTransactionsReport.Columns[&quot;Transaction Ref No:&quot;].Ordinal;&#xA;int colNarr = dtHistoricalReconTransactionsReport.Columns[&quot;Narration&quot;].Ordinal;&#xA;int colRRN = dtHistoricalReconTransactionsReport.Columns[&quot;RRN&quot;].Ordinal;&#xA;int colPAN = dtHistoricalReconTransactionsReport.Columns[&quot;C_PAN&quot;].Ordinal;&#xA;int colDebit = dtHistoricalReconTransactionsReport.Columns[&quot;Debit (TZS)&quot;].Ordinal;&#xA;int colCredit = dtHistoricalReconTransactionsReport.Columns[&quot;Credit (TZS)&quot;].Ordinal;&#xA;&#xA;// === Grouping Phase ===&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    // 🟡 Extract if special POS pattern&#xA;    TryHandlePosPrepaidSettlementNarration(row);&#xA;&#xA;    string refNo = row[colRef]?.ToString() ?? &quot;&quot;;&#xA;    string narr = row[colNarr]?.ToString() ?? &quot;&quot;;&#xA;    string upperNarr = narr.ToUpperInvariant();&#xA;    string rrn = (row[colRRN]?.ToString() ?? &quot;&quot;).Trim().PadLeft(12, '0');&#xA;    string pan = NormalizeCpan(row[colPAN]?.ToString());&#xA;&#xA;    // 🛑 Skip if invalid&#xA;    if (rrn == &quot;000000000000&quot; || string.IsNullOrEmpty(rrn) || pan == &quot;MISSING_PAN&quot;) continue;&#xA;&#xA;    string key = $&quot;{rrn}|{pan}&quot;;&#xA;    bool isGL = glIdentifiers.Any(refNo.Contains);&#xA;&#xA;    if (isGL)&#xA;    {&#xA;        if (!glGroups.TryGetValue(key, out var glList))&#xA;        {&#xA;            glList = new List&lt;DataRow&gt;(1);&#xA;            glGroups[key] = glList;&#xA;        }&#xA;        glList.Add(row);&#xA;    }&#xA;    else&#xA;    {&#xA;        if (feeExclusionKeywords.Any(k =&gt; upperNarr.Contains(k))) continue;&#xA;        if (!cmsKeywords.Any(k =&gt; upperNarr.Contains(k))) continue;&#xA;&#xA;        if (!cmsGroups.TryGetValue(key, out var cmsList))&#xA;        {&#xA;            cmsList = new List&lt;DataRow&gt;(1);&#xA;            cmsGroups[key] = cmsList;&#xA;        }&#xA;        cmsList.Add(row);&#xA;    }&#xA;}&#xA;&#xA;Log($&quot;📌 CMS Grouping complete: {cmsGroups.Count} keys.&quot;);&#xA;Log($&quot;📌 GL Grouping complete: {glGroups.Count} keys.&quot;);&#xA;&#xA;// === Matching Phase ===&#xA;var rowsToRemove = new HashSet&lt;DataRow&gt;();&#xA;int matchCount = 0;&#xA;&#xA;foreach (var kvp in cmsGroups)&#xA;{&#xA;    string key = kvp.Key;&#xA;    if (!glGroups.TryGetValue(key, out var glList)) continue;&#xA;&#xA;    var cmsList = kvp.Value;&#xA;&#xA;    decimal cmsSum = cmsList.Sum(r =&gt; ParseAmount(r[colCredit]));&#xA;    decimal glSum = glList.Sum(r =&gt; ParseAmount(r[colDebit]));&#xA;    decimal diff = glSum - cmsSum;&#xA;&#xA;    if (cmsSum &gt; 0 &amp;&amp; glSum &gt; 0)&#xA;    {&#xA;        foreach (var gl in glList)&#xA;        {&#xA;            dtHistoricalReconTransactionsReportMatched.ImportRow(gl);&#xA;            rowsToRemove.Add(gl);&#xA;        }&#xA;&#xA;        foreach (var cms in cmsList)&#xA;        {&#xA;            dtHistoricalReconTransactionsReportMatched.ImportRow(cms);&#xA;            rowsToRemove.Add(cms);&#xA;        }&#xA;&#xA;        exchangeGainOrLossPPS += diff;&#xA;        matchCount++;&#xA;&#xA;        //Log($&quot;✅ Matched: {key} | CMS={cmsSum:N2} | GL={glSum:N2} | Diff={diff:N2}&quot;);&#xA;    }&#xA;}&#xA;&#xA;// === Remove Matched Rows ===&#xA;foreach (var row in rowsToRemove)&#xA;{&#xA;    if (row.Table == dtHistoricalReconTransactionsReport &amp;&amp; row.RowState != DataRowState.Detached)&#xA;        dtHistoricalReconTransactionsReport.Rows.Remove(row);&#xA;}&#xA;Log($&quot;🗑 Removed {rowsToRemove.Count} matched rows from original dataset.&quot;);&#xA;&#xA;// === Summary ===&#xA;Log($&quot;🧾 Summary: Matched {matchCount} groups.&quot;);&#xA;Log($&quot;💰 Total Exchange Gain/Loss: {exchangeGainOrLossPPS:N2}&quot;);&#xA;" DisplayName="PPSP, PPSA, CCSA &amp; CCSP + exchangeGainOrLossPPS" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_116" Language="CSharp">

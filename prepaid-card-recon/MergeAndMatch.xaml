            <ui:InvokeCode ContinueOnError="{x:Null}" Code="int reportRowNumber = 2;&#xA;&#xA;foreach (DataRow row in dtTransactionReport.Rows)&#xA;{&#xA;    string txnType = row[&quot;Transaction Type&quot;]?.ToString()?.Trim().ToUpper() ?? &quot;&quot;;&#xA;    string channel = row[&quot;Channel&quot;]?.ToString()?.Trim().ToUpper() ?? &quot;&quot;;&#xA;    string billingCurrency = row[&quot;Billing Currency&quot;]?.ToString()?.Trim().ToUpper() ?? &quot;&quot;;&#xA;    string transactionCurrency = row[&quot;Transaction Currency&quot;]?.ToString()?.Trim().ToUpper() ?? &quot;&quot;;&#xA;    string transactionAmount = row[&quot;Transaction Amount&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;    string billingAmount = row[&quot;Billing Amount&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;&#xA;    if (string.IsNullOrEmpty(txnType)) continue;&#xA;&#xA;    // === Excel-style formulas ===&#xA;    row[&quot;Aging&quot;] = $&quot;=$H$6-G{reportRowNumber}&quot;;&#xA;    row[&quot;Aging Group&quot;] = $&quot;=IF(L{reportRowNumber}&lt;4,\&quot;0-3 Days\&quot;,IF(L{reportRowNumber}&lt;31,\&quot;4-30 Days\&quot;,IF(L{reportRowNumber}&lt;61,\&quot;31-60 Days\&quot;,IF(L{reportRowNumber}&lt;=90,\&quot;61-90 Days\&quot;,IF(L{reportRowNumber}&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;    row[&quot;BOT Classification&quot;] = $&quot;=IF(J{reportRowNumber}&gt;0,IF(L{reportRowNumber}&lt;30,\&quot;Normal\&quot;,IF(L{reportRowNumber}&lt;60,\&quot;Especially Mentioned\&quot;,IF(L{reportRowNumber}&lt;90,\&quot;Substandard\&quot;,IF(L{reportRowNumber}&lt;=180,\&quot;Doubtful\&quot;,IF(L{reportRowNumber}&gt;180,\&quot;Loss\&quot;,\&quot;0\&quot;))))),\&quot;Not Applicable\&quot;)&quot;;&#xA;&#xA;    // === Foreign currency logic ===&#xA;    if (billingCurrency != &quot;TZS&quot; &amp;&amp; channel == &quot;API&quot;)&#xA;    {&#xA;        row[&quot;FOREIGN_CURRENCY&quot;] = true;&#xA;        row[&quot;Recommended Action&quot;] = $&quot;Debit 101-202030015 ({transactionCurrency} {transactionAmount}) and Credit 101-202030015 ({billingCurrency} {billingAmount})&quot;;&#xA;    }&#xA;&#xA;    // === REFUND ===&#xA;    if (txnType == &quot;REFUND&quot;)&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Refund not yet posted&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Post the pending refund&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;    }&#xA;    // === TRANSFER DEBIT FROM 3RD PARTY ===&#xA;    else if (txnType.Contains(&quot;TRANSFER DEBIT FROM&quot;))&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Wakala updated CMS only&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Perform MISC ADJUSTMENT CREDIT&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Stephen Jilala&quot;;&#xA;    }&#xA;    // === Wallet Transfers ===&#xA;    else if (txnType.Contains(&quot;INTRA CLIENT - WALLET TO WALLET TRANSFER(DEBIT)&quot;))&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Intra-wallet transfer updated CMS only&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = $&quot;Debit 101-202030015 ({transactionCurrency} {transactionAmount}) and Credit 101-202030015 ({billingCurrency} {billingAmount})&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;    }&#xA;    else if (txnType.Contains(&quot;INTRA CLIENT - WALLET TO WALLET TRANSFER(CREDIT)&quot;))&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Intra-wallet transfer updated CMS only&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = $&quot;Debit 101-202030015 ({transactionCurrency} {transactionAmount}) and Credit 101-202030015 ({billingCurrency} {billingAmount})&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;    }&#xA;// === Prepaid Card Income-related (FEE, INCOME, TAX ON INCOME) for non-API channels ===&#xA;else if (&#xA;    channel != &quot;API&quot; &amp;&amp;&#xA;    (&#xA;        txnType.IndexOf(&quot;FEE&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0 ||&#xA;        txnType.IndexOf(&quot;INCOME&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0 ||&#xA;        txnType.IndexOf(&quot;TAX ON INCOME&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0&#xA;    )&#xA;)&#xA;{&#xA;    row[&quot;Root Cause&quot;] = &quot;Prepaid Card Income updated on CMS only&quot;;&#xA;    row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;    row[&quot;Recommended Action&quot;] = &quot;Post the income manually&quot;;&#xA;    row[&quot;Action Owner&quot;] = &quot;Card Finance&quot;;&#xA;}&#xA;&#xA;    // === MoneySend ===&#xA;    else if (txnType.Contains(&quot;MONEY SEND&quot;))&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;MoneySend not yet posted&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Post the pending MoneySend&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;    }&#xA;    // === MISC DEBIT or CREDIT ===&#xA;    else if (txnType.Contains(&quot;MISCELLANEOUS DEBIT&quot;) || txnType.Contains(&quot;MISCELLANEOUS CREDIT&quot;))&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Refund not yet posted&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Post the pending refund&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;    }&#xA;    // === API Purchase, Cash Advance, Tax ===&#xA;    else if (&#xA;        (txnType == &quot;PURCHASE/AUTH COMPLETION&quot; &amp;&amp; channel == &quot;API&quot;) ||&#xA;        txnType == &quot;CASH ADVANCE/ CASH AT POS / CASH OUT&quot; ||&#xA;        txnType == &quot;CASH ADVANCE/ CASH AT POS / CASH OUT TRANSACTION FEE&quot; ||&#xA;        txnType == &quot;SERVICE TAX/TAX ON INCOME&quot; ||&#xA;        txnType == &quot;LOAD/RELOAD&quot;&#xA;    )&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Unsuccessful ATM withdrawal transaction and charges updated CMS only&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Process MISC ADJUSTMENT CREDIT&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Stephen Jilala&quot;;&#xA;    }&#xA;    // === Non-API remote-on-us transactions ===&#xA;    else if (&#xA;        (txnType == &quot;CASH WITHDRAWAL&quot; &#xA;&#x9;&#x9;|| txnType == &quot;PURCHASE/AUTH COMPLETION&quot; &#xA;&#x9;&#x9;|| txnType == &quot;UNIQUE TXN&quot; || txnType == &quot;RECURRING TRANSACTION&quot;) &amp;&amp;&#xA;        channel != &quot;API&quot;&#xA;    )&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Remote-on-us transaction not yet posted&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Load pending auth dump files&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;ICT&quot;;&#xA;    }&#xA;    // === Fallback ===&#xA;    else&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Wakala updated CMS only&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Perform MISC ADJUSTMENT CREDIT&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Stephen Jilala&quot;;&#xA;    }&#xA;&#xA;    reportRowNumber++;&#xA;}&#xA;" DisplayName="dtTransactionReport add Root Cause" sap:VirtualizedContainerService.HintSize="416,48" sap2010:WorkflowViewState.IdRef="InvokeCode_51" Language="CSharp">

,\&quot;Loss\&quot;)))),\&quot;Not Applicable\&quot;)&quot;;&#xA;&#xA;            ws.Cells[r, 15].Value = row[&quot;Root Cause&quot;];&#xA;            ws.Cells[r, 16].Value = row[&quot;Root Cause Category&quot;];&#xA;            ws.Cells[r, 17].Value = row[&quot;Recommended Action&quot;];&#xA;            ws.Cells[r, 18].Value = row[&quot;Action Owner&quot;];&#xA;&#xA;            if ((i + 1) % 10000 == 0)&#xA;                Console.WriteLine($&quot;  → Written {i + 1:N0} rows...&quot;);&#xA;        }&#xA;&#xA;        ws.Cells[startingRow, 6, lastRow, 7].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;        ws.Cells[startingRow, 10, lastRow, 11].Style.Numberformat.Format = &quot;#,##0.00;[Red]-#,##0.00&quot;;&#xA;&#xA;        ws.Cells[&quot;H6&quot;].Value = reconDate;&#xA;        ws.Cells[&quot;K9&quot;].Value = glClosingBalance;&#xA;        ws.Cells[&quot;K10&quot;].Value = cmsBalance;&#xA;&#xA;        string jRange = $&quot;J{startingRow}:J{lastRow}&quot;;&#xA;        string kRange = $&quot;K{startingRow}:K{lastRow}&quot;;&#xA;        ws.Cells[&quot;J13&quot;].Formula = $&quot;-SUM({jRange})&quot;;&#xA;        ws.Cells[&quot;K13&quot;].Formula = $&quot;SUM({kRange})&quot;;&#xA;        ws.Cells[&quot;J16&quot;].Formula = $&quot;SUM({jRange})&quot;;&#xA;        ws.Cells[&quot;K16&quot;].Formula = $&quot;SUM({kRange})&quot;;&#xA;        ws.Cells[&quot;K14&quot;].Formula = &quot;ROUND((J13+K13),2)&quot;;&#xA;        ws.Cells[&quot;K15&quot;].Formula = &quot;ROUND((K11-K14),2)&quot;;&#xA;&#xA;        package.Workbook.CalcMode = ExcelCalcMode.Automatic;&#xA;        package.Workbook.FullCalcOnLoad = true;&#xA;&#xA;        package.Save();&#xA;    }&#xA;&#xA;    Console.WriteLine($&quot;✅ Written {rowCount:N0} rows.&quot;);&#xA;    Console.WriteLine($&quot;✅ glClosingBalance (K9): {glClosingBalance:N2}&quot;);&#xA;    Console.WriteLine($&quot;✅ cmsBalance (K10): {cmsBalance:N2}&quot;);&#xA;}&#xA;catch (Exception ex)&#xA;{&#xA;    Console.WriteLine($&quot;❌ ERROR: {ex.Message}&quot;);&#xA;}&#xA;&#xA;#endregion&#xA;" DisplayName="Write dtHistoricalReconTransactionsReport and Recon Report Balances" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_121" Language="CSharp">

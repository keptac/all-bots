      <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Get last SNO from the DataTable ===&#xA;int lastSNO = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;SNO&quot;)&#xA;    ? dtHistoricalReconTransactionsReport.AsEnumerable()&#xA;        .Select(r =&gt; r[&quot;SNO&quot;]?.ToString())&#xA;        .Where(s =&gt; !string.IsNullOrWhiteSpace(s) &amp;&amp; int.TryParse(s, out _))&#xA;        .Select(s =&gt; int.Parse(s))&#xA;        .DefaultIfEmpty(0)&#xA;        .Max()&#xA;    : 0;&#xA;&#xA;int newSNO = lastSNO + 1;&#xA;&#xA;// === Create and populate new DataRow ===&#xA;DataRow newRow = dtHistoricalReconTransactionsReport.NewRow();&#xA;&#xA;newRow[&quot;SNO&quot;] = newSNO;&#xA;newRow[&quot;Branch code&quot;] = &quot;101&quot;;&#xA;newRow[&quot;GL_Code&quot;] = &quot;202030015&quot;;&#xA;newRow[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;newRow[&quot;Booking Date&quot;] = movementDate;&#xA;newRow[&quot;Value Date&quot;] = movementDate;&#xA;newRow[&quot;Transaction Ref No:&quot;] = DBNull.Value;&#xA;newRow[&quot;Narration&quot;] = $&quot;Balance movement not explained by posted transactions {Convert.ToDateTime(movementDate):yyyy-MM-dd}&quot;;&#xA;&#xA;// === Excel formula placeholders (as string) ===&#xA;string excelRowRef = (newSNO + 5).ToString(); // Assuming Excel starts at row 6 for this data&#xA;string prevRowRef = (newSNO + 4).ToString();&#xA;&#xA;newRow[&quot;Aging&quot;] = $&quot;=$H$6-G{excelRowRef}&quot;;&#xA;newRow[&quot;Aging Group&quot;] = $&quot;=IF(L{prevRowRef}&lt;4,\&quot;0-3 Days\&quot;,IF(L{prevRowRef}&lt;31,\&quot;4-30 Days\&quot;,IF(L{prevRowRef}&lt;61,\&quot;31-60 Days\&quot;,IF(L{prevRowRef}&lt;=90,\&quot;61-90 Days\&quot;,IF(L{prevRowRef}&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;newRow[&quot;BOT Classification&quot;] = $&quot;=IF(J{prevRowRef}&gt;0,IF(L{prevRowRef}&lt;30,\&quot;Normal\&quot;,IF(L{prevRowRef}&lt;60,\&quot;Especially Mentioned\&quot;,IF(L{prevRowRef}&lt;90,\&
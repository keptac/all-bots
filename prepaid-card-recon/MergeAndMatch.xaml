        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Create local copy of reconCurrency to avoid CS1628 error in lambdas/indexers&#xA;string reconCurrencyLocal = reconCurrency;&#xA;&#xA;// Add Search Key column if it doesn't exist&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Search Key&quot;))&#xA;{&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Search Key&quot;, typeof(string));&#xA;}&#xA;&#xA;// Helper: Normalize Search Key&#xA;string NormalizeSearchKey(string key)&#xA;{&#xA;    return Regex.Replace((key ?? &quot;&quot;).Trim(), &quot;[^a-zA-Z0-9]&quot;, &quot;&quot;).ToUpper();&#xA;}&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    try&#xA;    {&#xA;        // Get C_PAN&#xA;        string cPan = row[&quot;C_PAN&quot;] != DBNull.Value ? row[&quot;C_PAN&quot;].ToString() : &quot;MISSING_PAN&quot;;&#xA;&#xA;        // === SKIP if C_PAN is MISSING_PAN ===&#xA;        if (cPan == &quot;MISSING_PAN&quot;)&#xA;        {&#xA;            row[&quot;Search Key&quot;] = DBNull.Value;&#xA;            continue;&#xA;        }&#xA;&#xA;        // Get and prepare RRN (mandatory → always 12 digits)&#xA;        string rrn = &quot;000000000000&quot;;&#xA;        if (row.Table.Columns.Contains(&quot;RRN&quot;) &amp;&amp; row[&quot;RRN&quot;] != DBNull.Value)&#xA;        {&#xA;            rrn = row[&quot;RRN&quot;].ToString().Trim().PadLeft(12, '0');&#xA;        }&#xA;&#xA;        // Get Billing Amount using reconCurrencyLocal&#xA;        decimal debit = row.Table.Columns.Contains($&quot;Debit ({reconCurrencyLocal})&quot;) &amp;&amp; row[$&quot;Debit ({reconCurrencyLocal})&quot;] != DBNull.Value&#xA;            ? Convert.ToDecimal(row[$&quot;Debit ({reconCurrencyLocal})&quot;])&#xA;            : 0;&#xA;        decimal credit = row.Table.Columns.Contains($&quot;Credit ({reconCurrencyLocal})&quot;) &amp;&amp; row[$&quot;Credit ({reconCurrencyLocal})&quot;] != DBNull.Value&#xA;            ? Convert.ToDecimal(row[$&quot;Credit ({reconCurrencyLocal})&quot;])&#xA;            : 0;&#xA;        decimal billingAmount = debit != 0 ? debit : credit;&#xA;&#xA;        // Build raw key (without STAN)&#xA;        string rawKey = $&quot;{cPan}{rrn}{billingAmount:F2}&quot;;&#xA;&#xA;        // Normalize and assign&#xA;        row[&quot;Search Key&quot;] = NormalizeSearchKey(rawKey);&#xA;    }&#xA;    catch (Exception ex)&#xA;    {&#xA;        // Optional error handling&#xA;        // Console.WriteLine($&quot;Search Key Error: {ex.Message}&quot;);&#xA;        row[&quot;Search Key&quot;] = DBNull.Value;&#xA;    }&#xA;}&#xA;" DisplayName="add Search Key dtHistoricalReconTransactionsReport" sap:VirtualizedContainerService.HintSize="416,48" sap2010:WorkflowViewState.IdRef="InvokeCode_105" Language="CSharp">

    <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Arguments:&#xA;// In/Out: DataTable dtHistoricalReconTransactionsReport&#xA;// In: string reconDate&#xA;&#xA;string[] reconDateFormats = { &quot;dd-MM-yyyy&quot;, &quot;dd-MMM-yyyy&quot;, &quot;d-MMM-yyyy&quot;, &quot;d-MM-yyyy&quot; };&#xA;string[] valueDateFormats = { &quot;dd-MMM-yyyy&quot;, &quot;MM/dd/yyyy&quot;, &quot;M/d/yyyy&quot;, &quot;MM/dd/yyyy HH:mm:ss&quot; };&#xA;System.Globalization.CultureInfo invCulture = System.Globalization.CultureInfo.InvariantCulture;&#xA;&#xA;System.DateTime reconDateParsed;&#xA;if (!System.DateTime.TryParseExact(reconDate, reconDateFormats, invCulture, System.Globalization.DateTimeStyles.None, out reconDateParsed))&#xA;    throw new Exception($&quot;❌ Could not parse reconDate: '{reconDate}'&quot;);&#xA;&#xA;int latePostedCount = 0;&#xA;&#xA;string[] latePostPatterns = { &quot;PPAT&quot;, &quot;AGW&quot;, &quot;AGR&quot;, &quot;PRDP&quot;, &quot;CWPP&quot;, &quot;PPSP&quot;, &quot;PPSA&quot;, &quot;CCSA&quot;, &quot;CCSP&quot;, &quot;UMJP&quot; };&#xA;&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string refNo = row[&quot;Transaction Ref No:&quot;]?.ToString()?.ToUpperInvariant() ?? &quot;&quot;;&#xA;    string valueDateStr = row[&quot;Value Date&quot;]?.ToString();&#xA;&#xA;    bool matchFound = latePostPatterns.Any(p =&gt; refNo.Contains(p));&#xA;    if (!matchFound) continue;&#xA;&#xA;    System.DateTime valueDate;&#xA;    bool parsed = System.DateTime.TryParseExact(valueDateStr, valueDateFormats, invCulture, System.Globalization.DateTimeStyles.None, out valueDate)&#xA;               || System.DateTime.TryParse(valueDateStr, out valueDate);&#xA;&#xA;    if (parsed)&#xA;    {&#xA;        // Allow ±2 days range for late posting&#xA;        var startRange = reconDateParsed.AddDays(-2);&#xA;        var endRange = reconDateParsed.AddDays(2);&#xA;&#xA;        if (valueDate &gt;= startRange &amp;&amp; valueDate &lt;= endRange)
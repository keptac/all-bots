        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Compiled Regex Patterns ===&#xA;var regexMaskedCard = new Regex(@&quot;\b(550558)[*xX0]{6}(\d{4})\b&quot;, RegexOptions.Compiled);&#xA;var regexFullPan = new Regex(@&quot;\b(\d{6})[Xx*]{6}(\d{4})\b&quot;, RegexOptions.Compiled);&#xA;var regex16Digits = new Regex(@&quot;\b\d{16}\b&quot;, RegexOptions.Compiled);&#xA;var regexCardInNarration = new Regex(@&quot;(\d{6}XXXXXX\d{4}.*)&quot;, RegexOptions.Compiled);&#xA;var regexDigitsOnly = new Regex(@&quot;\D&quot;, RegexOptions.Compiled);&#xA;var regexClean = new Regex(@&quot;\s|[^\u0020-\u007E]&quot;, RegexOptions.Compiled);&#xA;var regexRRN12Char = new Regex(@&quot;\b[A-Z0-9]{12}\b&quot;, RegexOptions.Compiled | RegexOptions.IgnoreCase);&#xA;var regexBillNumber = new Regex(@&quot;Bill\s*Number\s*:\s*([^\s]+)&quot;, RegexOptions.Compiled | RegexOptions.IgnoreCase);&#xA;&#xA;// Create local copy of reconCurrency to avoid CS1628 error in lambdas/indexers&#xA;string reconCurrencyLocal = reconCurrency;&#xA;&#xA;// === Helper Methods ===&#xA;&#xA;string NormalizeMaskedCardNumber(string narration) =&gt;&#xA;    string.IsNullOrWhiteSpace(narration) ? &quot;&quot; :&#xA;    regexMaskedCard.Replace(narration, m =&gt; $&quot;{m.Groups[1].Value}XXXXXX{m.Groups[2].Value}&quot;);&#xA;&#xA;string ExtractC_PANFromNarration(string text)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(text)) return &quot;&quot;;&#xA;    var m = regexFullPan.Match(text);&#xA;    if (m.Success) return $&quot;{m.Groups[1].Value}XXXXXX{m.Groups[2].Value}&quot;;&#xA;&#xA;    m = regex16Digits.Match(text);&#xA;    return m.Success ? m.Value.Substring(0, 6) + &quot;XXXXXX&quot; + m.Value.Substring(12, 4) : &quot;&quot;;&#xA;}&#xA;&#xA;string ExtractCNarration(string text)&#xA;{&#xA;    var m = regexCardInNarration.Match(text);&#xA;    return m.Success ? m.Groups[1].Value : text;&#xA;}&#xA;&#xA;(string stan, string rrn, string termId, string auth) ExtractTransactionFields(string narration)&#xA;{&#xA;    var m = Regex.Match(narration, @&quot;\b(?:\d{6}[*xX0]{6}\d{4}|\d{16})[-\s]+(\d{6})[-\s]+([A-Z0-9]{12})[-\s]+([A-Z0-9]{4,})\b&quot;, RegexOptions.IgnoreCase);&#xA;    if (m.Success)&#xA;        return (m.Groups[1].Value, m.Groups[2].Value, &quot;&quot;, m.Groups[3].Value);&#xA;&#xA;    // fallback for any standalone 12-char alphanumeric RRN&#xA;    m = regexRRN12Char.Match(narration);&#xA;    if (m.Success)&#xA;        return (&quot;&quot;, m.Value, &quot;&quot;, &quot;&quot;);&#xA;&#xA;    return (&quot;&quot;, &quot;000000000000&quot;, &quot;&quot;, &quot;&quot;);&#xA;}&#xA;&#xA;string ExtractPanFromBillNumber(string text)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(text)) return &quot;MISSING_PAN&quot;;&#xA;&#xA;    text = text.Replace(&quot;******&quot;, &quot;XXXXXX&quot;)&#xA;               .Replace(&quot;xxxxxx&quot;, &quot;XXXXXX&quot;)&#xA;               .Replace(&quot;000000&quot;, &quot;XXXXXX&quot;);&#xA;&#xA;    var billMatch = regexBillNumber.Match(text);&#xA;    if (!billMatch.Success) return &quot;MISSING_PAN&quot;;&#xA;&#xA;    foreach (var part in billMatch.Groups[1].Value.Split('!', StringSplitOptions.RemoveEmptyEntries))&#xA;    {&#xA;        var m = regexFullPan.Match(part);&#xA;        if (m.Success) return $&quot;{m.Groups[1].Value}XXXXXX{m.Groups[2].Value}&quot;;&#xA;&#xA;        var digits = regexDigitsOnly.Replace(part, &quot;&quot;);&#xA;        if (digits.Length == 16)&#xA;            return digits.Substring(0, 6) + &quot;XXXXXX&quot; + digits.Substring(12, 4);&#xA;    }&#xA;&#xA;    return &quot;MISSING_PAN&quot;;&#xA;}&#xA;&#xA;string CleanAndTrim(string input) =&gt; regexClean.Replace(input ?? &quot;&quot;, &quot;&quot;);&#xA;&#xA;string FormatAmount(string amount) =&gt;&#xA;    decimal.TryParse(amount, out var val) ? val.ToString(&quot;0.00&quot;) : &quot;0.00&quot;;&#xA;&#xA;// === RECON Processing ===&#xA;&#xA;int totalBefore = dtHistoricalReconTransactionsReport.Rows.Count, proc = 0;&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string raw = row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string norm = NormalizeMaskedCardNumber(raw);&#xA;&#xA;    string pan = ExtractC_PANFromNarration(norm);&#xA;    row[&quot;C_PAN&quot;] = string.IsNullOrWhiteSpace(pan) ? &quot;MISSING_PAN&quot; : pan;&#xA;    row[&quot;C_NARRATION&quot;] = ExtractCNarration(norm);&#xA;&#xA;    var (stan, rrn, termId, auth) = ExtractTransactionFields(norm);&#xA;    row[&quot;STAN&quot;] = stan;&#xA;    row[&quot;RRN&quot;] = rrn;&#xA;    row[&quot;EXTRACTED_TERMINAL_ID&quot;] = termId;&#xA;    row[&quot;AUTHORIZATION_NUMBER&quot;] = auth;&#xA;&#xA;    // Use reconCurrencyLocal here&#xA;    string debit = row[$&quot;Debit ({reconCurrencyLocal})&quot;]?.ToString();&#xA;    string credit = row[$&quot;Credit ({reconCurrencyLocal})&quot;]?.ToString();&#xA;    string amount = !string.IsNullOrWhiteSpace(debit) &amp;&amp; debit != &quot;0&quot;&#xA;        ? FormatAmount(debit)&#xA;        : FormatAmount(credit);&#xA;&#xA;    row[&quot;Search Key&quot;] = CleanAndTrim(pan + rrn + amount);&#xA;    proc++;&#xA;}&#xA;&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;&#xA;int missingPanCount = dtHistoricalReconTransactionsReport.AsEnumerable()&#xA;    .Count(r =&gt; r[&quot;C_PAN&quot;]?.ToString() == &quot;MISSING_PAN&quot;);&#xA;&#xA;Console.WriteLine($&quot;✅ HIST rows: {totalBefore} | Processed: {proc} | ❌ Missing PAN: {missingPanCount}&quot;);&#xA;&#xA;int updatedPanCount = 0, updatedRRNCount = 0;&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string narration = row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;;&#xA;&#xA;    string currentPan = row[&quot;C_PAN&quot;]?.ToString();&#xA;    if (string.IsNullOrWhiteSpace(currentPan) || currentPan == &quot;MISSING_PAN&quot;)&#xA;    {&#xA;        string billPan = ExtractPanFromBillNumber(narration);&#xA;        if (!string.IsNullOrWhiteSpace(billPan) &amp;&amp; billPan != &quot;MISSING_PAN&quot;)&#xA;        {&#xA;            row[&quot;C_PAN&quot;] = billPan;&#xA;            updatedPanCount++;&#xA;        }&#xA;    }&#xA;&#xA;    if (row.Table.Columns.Contains(&quot;RRN&quot;))&#xA;    {&#xA;        string rrn = row[&quot;RRN&quot;]?.ToString();&#xA;        if (string.IsNullOrWhiteSpace(rrn) || rrn == &quot;000000000000&quot;)&#xA;        {&#xA;            var fallback = regexRRN12Char.Match(narration);&#xA;            if (fallback.Success)&#xA;            {&#xA;                row[&quot;RRN&quot;] = fallback.Value;&#xA;                updatedRRNCount++;&#xA;            }&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;&#xA;Console.WriteLine($&quot;✅ HIST PANs newly filled: {updatedPanCount}&quot;);&#xA;Console.WriteLine($&quot;✅ HIST RRNs updated (from 12-char alphanumeric pattern): {updatedRRNCount}&quot;);&#xA;" DisplayName="Extract C_PAN, STAN, RRN, TERMINAL ID" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_104" Language="CSharp">

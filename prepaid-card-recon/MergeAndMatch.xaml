        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Inputs:&#xA;// dtHistoricalReconTransactionsReport (DataTable) - passed in, already initialized&#xA;// dtHistoricalReconTransactionsReportMatched (DataTable) - passed in, already initialized (same structure)&#xA;// reconCurrency (string) - passed in&#xA;&#xA;void EnsureColumnExists(DataTable table, string columnName, Type type)&#xA;{&#xA;    if (!table.Columns.Contains(columnName))&#xA;        table.Columns.Add(columnName, type);&#xA;}&#xA;&#xA;decimal ParseDecimal(object value)&#xA;{&#xA;    if (value == null || value == DBNull.Value) return 0m;&#xA;    decimal.TryParse(value.ToString(), out decimal result);&#xA;    return Math.Round(result, 2);&#xA;}&#xA;&#xA;decimal SumColumn(DataTable table, string columnName)&#xA;{&#xA;    return Math.Round(&#xA;        table.AsEnumerable()&#xA;            .Where(r =&gt; !r.IsNull(columnName))&#xA;            .Sum(r =&gt; ParseDecimal(r[columnName])),&#xA;        2&#xA;    );&#xA;}&#xA;&#xA;// === Setup ===&#xA;&#xA;EnsureColumnExists(dtHistoricalReconTransactionsReport, &quot;Search Key&quot;, typeof(string));&#xA;&#xA;int totalBefore = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;decimal debitBefore = SumColumn(dtHistoricalReconTransactionsReport, $&quot;Debit ({reconCurrency})&quot;);&#xA;decimal creditBefore = SumColumn(dtHistoricalReconTransactionsReport, $&quot;Credit ({reconCurrency})&quot;);&#xA;&#xA;var keyGroups = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;(StringComparer.OrdinalIgnoreCase);&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string rawKey = row[&quot;Search Key&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string trimmedKey = rawKey.Replace(&quot; &quot;, &quot;&quot;);&#xA;&#xA;    if (string.IsNullOrEmpty(trimmedKey)) continue;&#xA;&#xA;    if (!keyGroups.ContainsKey(trimmedKey))&#xA;        keyGroups[trimmedKey] = new List&lt;DataRow&gt;();&#xA;&#xA;    keyGroups[trimmedKey].Add(row);&#xA;}&#xA;&#xA;var rowsToRemove = new List&lt;DataRow&gt;();&#xA;&#xA;foreach (var kvp in keyGroups)&#xA;{&#xA;    var rows = kvp.Value;&#xA;    if (rows.Count &lt; 2) continue;&#xA;&#xA;    var matchedIndices = new HashSet&lt;int&gt;();&#xA;&#xA;    for (int i = 0; i &lt; rows.Count; i++)&#xA;    {&#xA;        if (matchedIndices.Contains(i)) continue;&#xA;&#xA;        decimal debitI = ParseDecimal(rows[i][$&quot;Debit ({reconCurrency})&quot;]);&#xA;        decimal creditI = ParseDecimal(rows[i][$&quot;Credit ({reconCurrency})&quot;]);&#xA;        decimal amountI = debitI != 0 ? debitI : -creditI;&#xA;&#xA;        for (int j = i + 1; j &lt; rows.Count; j++)&#xA;        {&#xA;            if (matchedIndices.Contains(j)) continue;&#xA;&#xA;            decimal debitJ = ParseDecimal(rows[j][$&quot;Debit ({reconCurrency})&quot;]);&#xA;            decimal creditJ = ParseDecimal(rows[j][$&quot;Credit ({reconCurrency})&quot;]);&#xA;            decimal amountJ = debitJ != 0 ? debitJ : -creditJ;&#xA;&#xA;            decimal sum = Math.Round(amountI + amountJ, 2);&#xA;&#xA;            if (sum == 0m)&#xA;            {&#xA;                dtHistoricalReconTransactionsReportMatched.ImportRow(rows[i]);&#xA;                dtHistoricalReconTransactionsReportMatched.ImportRow(rows[j]);&#xA;&#xA;                matchedIndices.Add(i);&#xA;                matchedIndices.Add(j);&#xA;&#xA;                rowsToRemove.Add(rows[i]);&#xA;                rowsToRemove.Add(rows[j]);&#xA;&#xA;                Console.WriteLine($&quot;✅ Exact Matched Pair -&gt; SearchKey: {kvp.Key}, Amount1: {amountI:0.00}, Amount2: {amountJ:0.00}&quot;);&#xA;                break; // move to next i&#xA;            }&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// Remove matched rows from original table&#xA;foreach (var row in rowsToRemove)&#xA;{&#xA;    dtHistoricalReconTransactionsReport.Rows.Remove(row);&#xA;}&#xA;&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;dtHistoricalReconTransactionsReportMatched.AcceptChanges();&#xA;&#xA;int totalMatched = dtHistoricalReconTransactionsReportMatched.Rows.Count;&#xA;int totalAfter = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;&#xA;decimal debitAfter = SumColumn(dtHistoricalReconTransactionsReport, $&quot;Debit ({reconCurrency})&quot;);&#xA;decimal creditAfter = SumColumn(dtHistoricalReconTransactionsReport, $&quot;Credit ({reconCurrency})&quot;);&#xA;&#xA;decimal debitMatched = SumColumn(dtHistoricalReconTransactionsReportMatched, $&quot;Debit ({reconCurrency})&quot;);&#xA;decimal creditMatched = SumColumn(dtHistoricalReconTransactionsReportMatched, $&quot;Credit ({reconCurrency})&quot;);&#xA;&#xA;Console.WriteLine(&quot;============== Matching Summary ==============&quot;);&#xA;Console.WriteLine($&quot;🔵 Total Rows Before Processing:  {totalBefore}&quot;);&#xA;Console.WriteLine($&quot;🟢 Total Rows Matched (moved out): {totalMatched}&quot;);&#xA;Console.WriteLine($&quot;🟡 Total Rows Remaining After:    {totalAfter}&quot;);&#xA;Console.WriteLine($&quot;✅ Row Check: {totalBefore} == {totalAfter} + {totalMatched} → {(totalBefore == (totalAfter + totalMatched) ? &quot;PASS&quot; : &quot;FAIL&quot;)}&quot;);&#xA;Console.WriteLine();&#xA;Console.WriteLine($&quot;🔵 Debit ({reconCurrency}) Total Before: {debitBefore:0.00}&quot;);&#xA;Console.WriteLine($&quot;🟢 Debit ({reconCurrency}) Matched:      {debitMatched:0.00}&quot;);&#xA;Console.WriteLine($&quot;🟡 Debit ({reconCurrency}) Remaining:    {debitAfter:0.00}&quot;);&#xA;Console.WriteLine($&quot;✅ Debit ({reconCurrency}) Check: {debitBefore:0.00} == {debitMatched:0.00} + {debitAfter:0.00} → {(debitBefore == debitMatched + debitAfter ? &quot;PASS&quot; : &quot;FAIL&quot;)}&quot;);&#xA;Console.WriteLine();&#xA;Console.WriteLine($&quot;🔵 Credit ({reconCurrency}) Total Before: {creditBefore:0.00}&quot;);&#xA;Console.WriteLine($&quot;🟢 Credit ({reconCurrency}) Matched:      {creditMatched:0.00}&quot;);&#xA;Console.WriteLine($&quot;🟡 Credit ({reconCurrency}) Remaining:    {creditAfter:0.00}&quot;);&#xA;Console.WriteLine($&quot;✅ Credit ({reconCurrency}) Check: {creditBefore:0.00} == {creditMatched:0.00} + {creditAfter:0.00} → {(creditBefore == creditMatched + creditAfter ? &quot;PASS&quot; : &quot;FAIL&quot;)}&quot;);&#xA;Console.WriteLine();&#xA;Console.WriteLine($&quot;✅ Matched Debit == Credit: {(debitMatched == creditMatched ? &quot;PASS&quot; : &quot;FAIL&quot;)}&quot;);&#xA;Console.WriteLine(&quot;===============================================&quot;);&#xA;" DisplayName="SELF MATCHING" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_107" Language="CSharp">

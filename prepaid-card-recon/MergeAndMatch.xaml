&quot;AUTHORIZATION_NUMBER&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;AUTHORIZATION_NUMBER&quot;, typeof(string)).DefaultValue = &quot;&quot;;&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;C_NARRATION&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;C_NARRATION&quot;, typeof(string)).DefaultValue = &quot;&quot;;&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;EXTRACTED_TERMINAL_ID&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;EXTRACTED_TERMINAL_ID&quot;, typeof(string)).DefaultValue = &quot;&quot;;&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Search Key&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Search Key&quot;, typeof(string)).DefaultValue = &quot;&quot;;&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;TIME&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;TIME&quot;, typeof(string)).DefaultValue = &quot;&quot;;&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;C_PAN_AMOUNT_DATE_TIME&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;C_PAN_AMOUNT_DATE_TIME&quot;, typeof(string)).DefaultValue = &quot;&quot;;&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;C_PAN_AUTHORIZATION_NUMBER&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;C_PAN_AUTHORIZATION_NUMBER&quot;, typeof(string)).DefaultValue = &quot;&quot;;&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;RRN_GROUP&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;RRN_GROUP&quot;, typeof(string)).DefaultValue = &quot;&quot;;&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;ProductCode&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;ProductCode&quot;, typeof(string)).DefaultValue = &quot;&quot;;&#xA;&#xA;if (!dtHistorical
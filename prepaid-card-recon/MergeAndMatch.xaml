roupSize]++;&#xA;    }&#xA;&#xA;    if (groupSize &gt; 500)&#xA;    {&#xA;        System.Threading.Interlocked.Increment(ref largeGroupsSkipped);&#xA;        return;&#xA;    }&#xA;&#xA;    double allowedTime =&#xA;        groupSize &lt;= 100 ? 10 :&#xA;        groupSize &lt;= 200 ? 18 :&#xA;        groupSize &lt;= 400 ? 30 : 40;&#xA;&#xA;    var cache = rows.Select(r =&gt; new&#xA;    {&#xA;        Row = r,&#xA;        Debit = GetDecimal(r[$&quot;Debit ({localReconCurrency})&quot;]),&#xA;        Credit = GetDecimal(r[$&quot;Credit ({localReconCurrency})&quot;])&#xA;    }).ToList();&#xA;&#xA;    var comboStart = DateTime.Now;&#xA;&#xA;    for (int size = 2; size &lt;= Math.Min(4, cache.Count); size++)&#xA;    {&#xA;        foreach (var combo in GetCombinations(cache.Where(c =&gt; !localUsed.Contains(c.Row)).ToList(), size))&#xA;        {&#xA;            if ((DateTime.Now - comboStart).TotalSeconds &gt; allowedTime)&#xA;            {&#xA;                System.Threading.Interlocked.Increment(ref timedOutGroups);&#xA;                return;&#xA;            }&#xA;&#xA;            decimal debitSum = combo.Sum(c =&gt; c.Debit);&#xA;            decimal creditSum = combo.Sum(c =&gt; c.Credit);&#xA;&#xA;            if (IsAmountMatch(debitSum, creditSum))&#xA;            {&#xA;                foreach (var item in combo)&#xA;                {&#xA;                    lock (item.Row)&#xA;                    {&#xA;                        localUsed.Add(item.Row);&#xA;                        rowSnapshotKeys.Add(GetRowKey(item.Row.ItemArray));&#xA;                    }&#xA;                }&#xA;&#xA;                System.Threading.Interlocked.Add(ref totalMatched, combo.Count);&#xA;                System.Threading.Interlocked.Increment(ref groupMatched);&#xA;                break;&#xA;            }&#xA;        }&#xA;    }&#xA;});&#xA;&#xA;timer.Stop();&#xA;Console.WriteLine($&quot;⚡ Matching Complete (Parallel): {timer.Elapsed.TotalSeconds:N2} sec&quot;);&#xA;&#xA;// === Sync schema ===&#xA;foreach (DataColumn col in schema)&#xA;{&#xA;    if (!dtHistoricalReconTransactionsReportMatched.Columns.Contains(col.ColumnName))&#xA;        dtHistoricalReconTransactionsReportMatched.Columns.Add(col.ColumnName, col.DataType);&#xA;}&#xA;&#xA;// === Move Matched Rows ===&#xA;var rowSnapshotKeySet = new HashSet&lt;string&gt;(rowSnapshotKeys);&#xA;&#xA;foreach (DataRow row in rowCache)&#xA;{&#xA;    string key = GetRowKey(row.ItemArray);&#xA;    if (rowSnapshotKeySet.Contains(key))&#xA;    {&#xA;        var newRow = dtHistoricalReconTransactionsReportMatched.NewRow();&#xA;&#xA;        foreach (DataColumn col in schema)&#xA;        {&#xA;            if (dtHistoricalReconTransactionsReportMatched.Columns.Contains(col.ColumnName))&#xA;            {&#xA;                newRow[col.ColumnName] = row[col.ColumnName];&#xA;            }&#xA;        }&#xA;&#xA;        dtHistoricalReconTransactionsReportMatched.Rows.Add(newRow);&#xA;    }&#xA;}&#xA;&#xA;timer.Stop();&#xA;Console.WriteLine($&quot;📤 Moving Matched Rows Complete: {timer.Elapsed.TotalSeconds:N2} sec&quot;);&#xA;&#xA;timer.Restart();&#xA;&#xA;// === Remove matched rows from original ===&#xA;var toDelete = dtHistoricalReconTransactionsReport.AsEnumerable()&#xA;    .Where(r =&gt; rowSnapshotKeySet.Contains(GetRowKey(r.ItemArray)))&#xA;    .ToList();&#xA;&#xA;foreach (var r in toDelete)&#xA;{&#xA;    if (r.RowState != DataRowState.Detached)&#xA;        r.Delete();&#xA;}&#xA;&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;Console.WriteLine($&quot;📋 Rows Remaining After Match: {dtHistoricalReconTransactionsReport.Rows.Count:N0}&quot;);&#xA;Console.WriteLine($&quot;📋 Rows Matched &amp; Moved:       {dtHistoricalReconTransactionsReportMatched.Rows.Count:N0}&quot;);&#xA;&#xA;timer.Stop();&#xA;totalStopwatch.Stop();&#xA;&#xA;// === Recalculate Totals ===&#xA;totalMovedDebit = dtHistoricalReconTransactionsReportMatched.AsEnumerable()&#xA;    .Sum(r =&gt; GetDecimal(r[$&quot;Debit ({localReconCurrency})&quot;]));&#xA;totalMovedCredit = dtHistoricalReconTransactionsReportMatched.AsEnumerable()&#xA;    .Sum(r =&gt; GetDecimal(r[$&quot;Credit ({localReconCurrency})&quot;]));&#xA;groupRoundingError = totalMovedDebit - totalMovedCredit;&#xA;&#xA;decimal remainingDebit = initialDebit - totalMovedDebit;&#xA;decimal remainingCredit = initialCredit - totalMovedCredit;&#xA;&#xA;// === Summary ===&#xA;Console.WriteLine(&quot;\n=== 🧾 Reconciliation Summary ===&quot;);&#xA;Console.WriteLine($&quot;💳 Initial Total Debit:        {initialDebit:N2}&quot;);&#xA;Console.WriteLine($&quot;💳 Initial Total Credit:       {initialCredit:N2}&quot;);&#xA;Console.WriteLine($&quot;✅ Total Matched Rows:         {totalMatched}&quot;);&#xA;Console.WriteLine($&quot;🔗 Group Matches (≤4 rows):    {groupMatched}&quot;);&#xA;Console.WriteLine($&quot;⏭️ Large Groups Skipped:       {largeGroupsSkipped}&quot;);&#xA;Console.WriteLine($&quot;⏱️ Timeout Groups:              {timedOutGroups}&quot;);&#xA;Console.WriteLine($&quot;💰 Matched Debit:              {totalMovedDebit:N2}&quot;);&#xA;Console.WriteLine($&quot;💰 Matched Credit:             {totalMovedCredit:N2}&quot;);&#xA;Console.WriteLine($&quot;🧾 Remaining Debit:            {remainingDebit:N2}&quot;);&#xA;Console.WriteLine($&quot;🧾 Remaining Credit:           {remainingCredit:N2}&quot;);&#xA;Console.WriteLine($&quot;✅ Matched Debit == Credit?    {(Math.Abs(groupRoundingError) &lt;= 0.01m ? &quot;✔️ YES&quot; : &quot;❌ NO&quot;)}&quot;);&#xA;Console.WriteLine($&quot;⏱️ Total Elapsed Time:         {totalStopwatch.Elapsed.TotalSeconds:N2} sec&quot;);&#xA;&#xA;// === Group Size Histogram ===&#xA;Console.WriteLine($&quot;\n📊 Group Size Distribution:&quot;);&#xA;foreach (var kvp in groupSizeDistribution.OrderBy(k =&gt; k.Key))&#xA;    Console.WriteLine($&quot; - {kvp.Key,2} rows: {kvp.Value:N0} groups&quot;);&#xA;&#xA;#region === Group Rounding Error Analysis ===&#xA;string errorDirection;&#xA;if (Math.Abs(groupRoundingError) &lt;= 0.01m)&#xA;    errorDirection = &quot;⚖️  Balanced (within 0.01)&quot;;&#xA;else if (groupRoundingError &gt; 0)&#xA;    errorDirection = &quot;📈 More Debit matched than Credit → Check Credit side&quot;;&#xA;else&#xA;    errorDirection = &quot;📉 More Credit matched than Debit → Check Debit side&quot;;&#xA;&#xA;Console.WriteLine($&quot;\n=== 🔍 Group Rounding Analysis ===&quot;);&#xA;Console.WriteLine($&quot;🔢 groupRoundingError:         {groupRoundingError:N2}&quot;);&#xA;Console.WriteLine($&quot;📌 Interpretation:             {errorDirection}&quot;);&#xA;#endregion&#xA;&#xA;// --- Combination helper method ---&#xA;IEnumerable&lt;List&lt;T&gt;&gt; GetCombinations&lt;T&gt;(List&lt;T&gt; list, int size)&#xA;{&#xA;    int count = list.Count;&#xA;    if (count &lt; size) yield break;&#xA;&#xA;    var indices = new int[size];&#xA;    for (int i = 0; i &lt; size; i++) indices[i] = i;&#xA;&#xA;    while (true)&#xA;    {&#xA;        yield return indices.Select(i =&gt; list[i]).ToList();&#xA;&#xA;        int i = size - 1;&#xA;        while (i &gt;= 0 &amp;&amp; indices[i] == count - size + i) i--;&#xA;        if (i &lt; 0) break;&#xA;&#xA;        indices[i]++;&#xA;        for (int j = i + 1; j &lt; size; j++)&#xA;            indices[j] = indices[j - 1] + 1;&#xA;    }&#xA;}&#xA;" DisplayName="(Grouped RRN + C_PAN vs RRN + C_PAN sum matching)" sap:VirtualizedContainerService.HintSize="478.4,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_56" Language="CSharp">

          <ui:InvokeCode ContinueOnError="{x:Null}" Code="// EPPlus License Context&#xA;//ExcelPackage.LicenseContext = LicenseContext.NonCommercial;&#xA;&#xA;#region === Helpers ===&#xA;&#xA;void ConvertColumnToDateTimeForce(DataTable dt, string colName)&#xA;{&#xA;    if (!dt.Columns.Contains(colName)) return;&#xA;&#xA;    if (dt.Columns[colName].DataType == typeof(DateTime))&#xA;        return;&#xA;&#xA;    string newCol = colName + &quot;_DT_FIX&quot;;&#xA;    if (dt.Columns.Contains(newCol)) dt.Columns.Remove(newCol);&#xA;    dt.Columns.Add(newCol, typeof(DateTime));&#xA;&#xA;    foreach (DataRow row in dt.Rows)&#xA;    {&#xA;        object val = row[colName];&#xA;        DateTime parsed;&#xA;&#xA;        if (val is DateTime dtVal)&#xA;        {&#xA;            parsed = dtVal;&#xA;        }&#xA;        else if (val is double d)&#xA;        {&#xA;            parsed = DateTime.FromOADate(d);&#xA;        }&#xA;        else&#xA;        {&#xA;            string str = val?.ToString()?.Trim() ?? &quot;&quot;;&#xA;&#xA;            if (double.TryParse(str, out var serial))&#xA;            {&#xA;                parsed = DateTime.FromOADate(serial);&#xA;            }&#xA;            else if (DateTime.TryParseExact(str,&#xA;                new[] { &quot;dd/MM/yyyy HH:mm:ss&quot;, &quot;dd/MM/yyyy&quot;, &quot;MM/dd/yyyy&quot;, &quot;M/d/yyyy&quot;, &quot;yyyy-MM-dd&quot;, &quot;dd-MM-yyyy&quot;, &quot;d-MMM-yy&quot;, &quot;dd-MMM-yyyy&quot; },&#xA;                CultureInfo.InvariantCulture,&#xA;                DateTimeStyles.None,&#xA;                out parsed))&#xA;            {&#xA;                // success&#xA;            }&#xA;            else if (DateTime.TryParse(str, CultureInfo.InvariantCulture, DateTimeStyles.None, out parsed))&#xA;            {&#xA;                // fallback success&#xA;            }&#xA;            else&#xA;            {&#xA;                parsed = DateTime.MinValue;&#xA;            }&#xA;        }&#xA;&#xA;        row[newCol] = parsed;&#xA
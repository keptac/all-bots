        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Inputs:&#xA;// dtHistoricalReconTransactionsReport (DataTable)&#xA;// dtHistoricalReconTransactionsReportMatched (DataTable)&#xA;// exchangeGainOrLossPPS (decimal, passed by reference)&#xA;// reconCurrency (string)&#xA;&#xA;string[] withdrawalKeywords = { &quot;CASH WITHDRAWAL&quot; };&#xA;string[] settlementKeywords = { &quot;PREPAID ATM SETTLEMENT&quot; };&#xA;string[] excludeKeywords = {&#xA;    &quot;TRANSACTION FEE&quot;, &quot;SERVICE TAX&quot;, &quot;TAX ON INCOME&quot;,&#xA;    &quot;Purchase/Auth Completion Transaction Fee&quot;,&#xA;    &quot;PURCHASE/AUTH COMPLETION TRANSACTION FEE&quot;&#xA;};&#xA;&#xA;string NormalizeNarration(string narration) =&gt;&#xA;    Regex.Replace((narration ?? &quot;&quot;).ToUpperInvariant().Trim(), @&quot;\s+&quot;, &quot; &quot;);&#xA;&#xA;// Extract RRN (alphanumeric 12 digits) and C_PAN (masked or full)&#xA;string ExtractRRN(string narration)&#xA;{&#xA;    var match = Regex.Match(narration, @&quot;\b([A-Z0-9]{12})\b&quot;);&#xA;    return match.Success ? match.Value.Trim() : &quot;&quot;;&#xA;}&#xA;&#xA;string ExtractPAN(string narration)&#xA;{&#xA;    var match = Regex.Match(narration, @&quot;\b(550558)[\*Xx0]{6}(\d{4})\b&quot;);&#xA;    return match.Success ? match.Value.Replace(&quot;x&quot;, &quot;X&quot;).Replace(&quot;*&quot;, &quot;X&quot;) : &quot;&quot;;&#xA;}&#xA;&#xA;decimal ParseAmount(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return 0m;&#xA;    var s = val.ToString().Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;).Trim();&#xA;    return decimal.TryParse(s, out var result) ? result : 0m;&#xA;}&#xA;&#xA;// === Group rows ===&#xA;var withdrawalGroups = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;();&#xA;var settlementGroups = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;();&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string narration = NormalizeNarration(row[&quot;Narration&quot;]?.ToString());&#xA;&#xA;    if (excludeKeywords.Any(k =&gt; narration.Contains(k))) continue;&#xA;&#xA;    string rrn = ExtractRRN(narration);&#xA;    string cpan = ExtractPAN(narration);&#xA;    if (string.IsNullOrEmpty(rrn) || string.IsNullOrEmpty(cpan)) continue;&#xA;&#xA;    string key = rrn + &quot;|&quot; + cpan;&#xA;&#xA;    if (withdrawalKeywords.Any(k =&gt; narration.StartsWith(k)))&#xA;    {&#xA;        if (!withdrawalGroups.ContainsKey(key)) withdrawalGroups[key] = new List&lt;DataRow&gt;();&#xA;        withdrawalGroups[key].Add(row);&#xA;    }&#xA;    else if (settlementKeywords.Any(k =&gt; narration.StartsWith(k)))&#xA;    {&#xA;        if (!settlementGroups.ContainsKey(key)) settlementGroups[key] = new List&lt;DataRow&gt;();&#xA;        settlementGroups[key].Add(row);&#xA;    }&#xA;}&#xA;&#xA;// === Match rows ===&#xA;var rowsToRemove = new HashSet&lt;DataRow&gt;();&#xA;int matchCount = 0;&#xA;&#xA;string creditColumn = $&quot;Credit ({reconCurrency})&quot;;&#xA;string debitColumn = $&quot;Debit ({reconCurrency})&quot;;&#xA;&#xA;foreach (var key in withdrawalGroups.Keys)&#xA;{&#xA;    if (!settlementGroups.ContainsKey(key)) continue;&#xA;&#xA;    var withdrawals = withdrawalGroups[key];&#xA;    var settlements = settlementGroups[key];&#xA;&#xA;    decimal withdrawalSum = withdrawals.Sum(r =&gt; ParseAmount(r[creditColumn]));&#xA;    decimal settlementSum = settlements.Sum(r =&gt; ParseAmount(r[debitColumn]));&#xA;    decimal diff = settlementSum - withdrawalSum;&#xA;&#xA;    if (withdrawalSum &gt; 0 &amp;&amp; settlementSum &gt; 0)&#xA;    {&#xA;        foreach (var row in withdrawals.Concat(settlements))&#xA;        {&#xA;            dtHistoricalReconTransactionsReportMatched.ImportRow(row);&#xA;            rowsToRemove.Add(row);&#xA;        }&#xA;&#xA;        exchangeGainOrLossPPS += diff;&#xA;        matchCount++;&#xA;    }&#xA;}&#xA;&#xA;// === Remove matched rows ===&#xA;foreach (var row in rowsToRemove)&#xA;{&#xA;    if (row.Table != null &amp;&amp; row.RowState != DataRowState.Detached)&#xA;        dtHistoricalReconTransactionsReport.Rows.Remove(row);&#xA;}&#xA;&#xA;// === Summary ===&#xA;Console.WriteLine($&quot;✅ Matched {matchCount} Cash Withdrawal ↔ ATM Settlement entries (excluding tax/fees).&quot;);&#xA;Console.WriteLine($&quot;💰 Total Exchange Gain/Loss (ATM): {exchangeGainOrLossPPS:N2}&quot;);&#xA;" DisplayName="PPSA vs Cash Withdrawal- + exchangeGainOrLossPPS" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_112" Language="CSharp">

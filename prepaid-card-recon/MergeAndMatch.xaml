        <ui:InvokeCode ContinueOnError="{x:Null}" Code="&#xA;// Inputs:&#xA;// dtHistoricalReconTransactionsReport (DataTable)&#xA;// dtHistoricalReconTransactionsReportMatched (DataTable)&#xA;// exchangeGainOrLossPPS (decimal, passed by reference)&#xA;&#xA;string[] purchaseNarrationKeywords = { &quot;PURCHASE/AUTH COMPLETION&quot; };&#xA;string[] settlementNarrationKeywords = { &quot;POS PREPAID SETTLEMENT&quot; };&#xA;string[] excludeNarrationKeywords = { &quot;TRANSACTION FEE&quot;, &quot;SERVICE TAX&quot;, &quot;TAX ON INCOME&quot;, &quot;Purchase/Auth Completion Transaction Fee&quot;, &quot;PURCHASE/AUTH COMPLETION TRANSACTION FEE&quot; };&#xA;&#xA;// Helper to normalize narration consistently&#xA;string NormalizeNarration(string narration) =&gt;&#xA;    Regex.Replace((narration ?? &quot;&quot;).ToUpperInvariant(), @&quot;\s*[-–]\s*&quot;, &quot; - &quot;).Trim();&#xA;&#xA;// Helper to normalize PAN into 6 + XXXXXX + 4 format&#xA;string NormalizeCpan(string pan)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(pan)) return &quot;MISSING_PAN&quot;;&#xA;    var cleaned = Regex.Replace(pan, @&quot;[*xX0]&quot;, &quot;X&quot;);&#xA;    var match = Regex.Match(cleaned, @&quot;^(\d{6})X{6}(\d{4})$&quot;);&#xA;    return match.Success ? $&quot;{match.Groups[1].Value}XXXXXX{match.Groups[2].Value}&quot; : cleaned;&#xA;}&#xA;&#xA;// Helper to parse amount safely&#xA;decimal ParseAmount(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return 0m;&#xA;    var s = val.ToString().Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;).Trim();&#xA;    return decimal.TryParse(s, out var result) ? result : 0m;&#xA;}&#xA;&#xA;// Group rows by normalized key: RRN + normalized C_PAN&#xA;var purchaseGroups = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;();&#xA;var settlementGroups = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;();&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string narration = NormalizeNarration(row[&quot;Narration&quot;]?.ToString());&#xA;    string rrn = (row[&quot;RRN&quot;]?.ToString() ?? &quot;&quot;).Trim().PadLeft(12, '0');&#xA;    string rawPan = (row[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;).Trim();&#xA;    string cpan = NormalizeCpan(rawPan);&#xA;&#xA;    if (string.IsNullOrEmpty(rrn) || cpan == &quot;MISSING_PAN&quot;) continue;&#xA;    if (excludeNarrationKeywords.Any(k =&gt; narration.Contains(k))) continue;&#xA;&#xA;    string key = rrn + &quot;|&quot; + cpan;&#xA;&#xA;    if (purchaseNarrationKeywords.Any(k =&gt; narration.StartsWith(k)))&#xA;    {&#xA;        if (!purchaseGroups.ContainsKey(key)) purchaseGroups[key] = new List&lt;DataRow&gt;();&#xA;        purchaseGroups[key].Add(row);&#xA;    }&#xA;    else if (settlementNarrationKeywords.Any(k =&gt; narration.StartsWith(k)))&#xA;    {&#xA;        if (!settlementGroups.ContainsKey(key)) settlementGroups[key] = new List&lt;DataRow&gt;();&#xA;        settlementGroups[key].Add(row);&#xA;    }&#xA;}&#xA;&#xA;// Match purchases ↔ settlements&#xA;var rowsToRemove = new HashSet&lt;DataRow&gt;();&#xA;int matchCount = 0;&#xA;&#xA;foreach (var key in purchaseGroups.Keys)&#xA;{&#xA;    if (!settlementGroups.ContainsKey(key)) continue;&#xA;&#xA;    var purchases = purchaseGroups[key];&#xA;    var settlements = settlementGroups[key];&#xA;&#xA;    decimal purchaseSum = purchases.Sum(r =&gt; ParseAmount(r[&quot;Credit (TZS)&quot;]));&#xA;    decimal settlementSum = settlements.Sum(r =&gt; ParseAmount(r[&quot;Debit (TZS)&quot;]));&#xA;    decimal diff = settlementSum - purchaseSum;&#xA;&#xA;    if (purchaseSum &gt; 0 &amp;&amp; settlementSum &gt; 0)&#xA;    {&#xA;        foreach (var row in purchases.Concat(settlements))&#xA;        {&#xA;            dtHistoricalReconTransactionsReportMatched.ImportRow(row);&#xA;            rowsToRemove.Add(row);&#xA;        }&#xA;&#xA;        exchangeGainOrLossPPS += diff;&#xA;        matchCount++;&#xA;    }&#xA;}&#xA;&#xA;// Remove matched rows from original table&#xA;foreach (var row in rowsToRemove)&#xA;{&#xA;    if (row.Table != null &amp;&amp; row.RowState != DataRowState.Detached)&#xA;        dtHistoricalReconTransactionsReport.Rows.Remove(row);&#xA;}&#xA;&#xA;// 📋 Summary&#xA;Console.WriteLine($&quot;✅ Matched {matchCount} Purchase ↔ Settlement entries (excluding fees/taxes).&quot;);&#xA;Console.WriteLine($&quot;💸 Total Exchange Gain/Loss (PPS): {exchangeGainOrLossPPS:N2}&quot;);&#xA;" DisplayName="PPSP vs Purchase/Auth Completion + exchangeGainOrLossPPS" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_111" Language="CSharp">

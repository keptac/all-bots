      <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ✅ Helpers&#xD;&#xA;string FormatAmount(string amountStr)&#xD;&#xA;{&#xD;&#xA;    if (decimal.TryParse(amountStr.Replace(&quot;,&quot;, &quot;&quot;), out decimal amount))&#xD;&#xA;        return amount.ToString(&quot;N2&quot;);&#xD;&#xA;    return amountStr;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;string Normalize(string input)&#xD;&#xA;{&#xD;&#xA;    if (string.IsNullOrWhiteSpace(input)) return string.Empty;&#xD;&#xA;    return System.Text.RegularExpressions.Regex.Replace(input.Trim(), @&quot;\s+&quot;, &quot; &quot;).ToLowerInvariant();&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// ✅ Normalize reconCurrency once&#xD;&#xA;string reconCurrencyNormalized = Normalize(reconCurrency);&#xD;&#xA;&#xD;&#xA;int reportRowNumber = 2;&#xD;&#xA;&#xD;&#xA;foreach (DataRow row in dtTransactionReport.Rows)&#xD;&#xA;{&#xD;&#xA;    string txnType = row[&quot;Transaction Type&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xD;&#xA;    string normalizedTxnType = Normalize(txnType);&#xD;&#xA;    string txnTypeNormalizedFlat = System.Text.RegularExpressions.Regex.Replace(txnType ?? &quot;&quot;, @&quot;\s+&quot;, &quot;&quot;).ToUpperInvariant();&#xD;&#xA;&#xD;&#xA;    string channel = row[&quot;Channel&quot;]?.ToString()?.Trim().ToUpper() ?? &quot;&quot;;&#xD;&#xA;    string billingCurrency = row[&quot;Billing Currency&quot;]?.ToString()?.Trim().ToUpper() ?? &quot;&quot;;&#xD;&#xA;    string billingCurrencyNormalized = Normalize(billingCurrency);&#xD;&#xA;    string billingAmount = row[&quot;Billing Amount&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xD;&#xA;    string transactionCurrency = row[&quot;Transaction Currency&quot;]?.ToString()?.Trim().ToUpper() ?? &quot;&quot;;&#xD;&#xA;    string transactionAmount = row[&quot;Transaction Amount&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xD;&#xA;    string settlementCurrency = row.Table.Columns.Contains(&quot;Settlement Currency&quot;) ? row[&quot;Settlement Currency&quot;]?.ToString()?.Trim().ToUpper() ?? &quot;&quot; : &quot;&quot;;&#xD;&#xA;    string settlementAmount = row.Table.Columns.Contains(&quot;Settlement Amount&quot;) ? row[&quot;Settlement Amount&quot;]?.ToString()?.Trim() ?? &quot;&quot; : &quot;&quot;;&#xD;&#xA;&#xD;&#xA;    if (string.IsNullOrEmpty(txnType)) continue;&#xD;&#xA;&#xD;&#xA;    // Excel-style formulas&#xD;&#xA;    row[&quot;Aging&quot;] = $&quot;=$H$6-G{reportRowNumber}&quot;;&#xD;&#xA;    row[&quot;Aging Group&quot;] = $&quot;=IF(L{reportRowNumber}&lt;4,\&quot;0-3 Days\&quot;,IF(L{reportRowNumber}&lt;31,\&quot;4-30 Days\&quot;,IF(L{reportRowNumber}&lt;61,\&quot;31-60 Days\&quot;,IF(L{reportRowNumber}&lt;=90,\&quot;61-90 Days\&quot;,IF(L{reportRowNumber}&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xD;&#xA;    row[&quot;BOT Classification&quot;] = $&quot;=IF(J{reportRowNumber}&gt;0,IF(L{reportRowNumber}&lt;30,\&quot;Normal\&quot;,IF(L{reportRowNumber}&lt;60,\&quot;Especially Mentioned\&quot;,IF(L{reportRowNumber}&lt;90,\&quot;Substandard\&quot;,IF(L{reportRowNumber}&lt;=180,\&quot;Doubtful\&quot;,IF(L{reportRowNumber}&gt;180,\&quot;Loss\&quot;,\&quot;0\&quot;))))),\&quot;Not Applicable\&quot;)&quot;;&#xD;&#xA;&#xD;&#xA;    // Foreign currency API logic&#xD;&#xA;    if (billingCurrencyNormalized != reconCurrencyNormalized &amp;&amp; channel == &quot;API&quot;)&#xD;&#xA;    {&#xD;&#xA;        row[&quot;FOREIGN_CURRENCY&quot;] = true;&#xD;&#xA;        row[&quot;Recommended Action&quot;] = $&quot;Debit 101-202030015 ({transactionCurrency} {transactionAmount}) and Credit 101-202030015 ({billingCurrency} {billingAmount})&quot;;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // === Classification logic ===&#xD;&#xA;    if (txnType.Equals(&quot;REFUND&quot;, StringComparison.OrdinalIgnoreCase))&#xD;&#xA;    {&#xD;&#xA;        row[&quot;Root Cause&quot;] = &quot;Refund not yet posted&quot;;&#xD;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xD;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Post the pending refund&quot;;&#xD;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xD;&#xA;    }&#xD;&#xA;    else if (normalizedTxnType.StartsWith(&quot;transfer debit from 3rd party&quot;))&#xD;&#xA;    {&#xD;&#xA;        row[&quot;Root Cause&quot;] = &quot;Wakala updated CMS only&quot;;&#xD;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xD;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Perform MISC ADJUSTMENT CREDIT&quot;;&#xD;&#xA;        row[&quot;Action Owner&quot;] = &quot;Stephen Jilala&quot;;&#xD;&#xA;    }&#xD;&#xA;    else if (txnTypeNormalizedFlat.Contains(&quot;INTRACLIENT-WALLETTOWALLETTRANSFER(DEBIT)&quot;))&#xD;&#xA;    {&#xD;&#xA;        row[&quot;Root Cause&quot;] = &quot;Intra-wallet transfer updated CMS only&quot;;&#xD;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xD;&#xA;&#xD;&#xA;        if (billingCurrencyNormalized != reconCurrencyNormalized)&#xD;&#xA;        {&#xD;&#xA;            if (decimal.TryParse(transactionAmount.Replace(&quot;,&quot;, &quot;&quot;), out decimal txnAmt))&#xD;&#xA;            {&#xD;&#xA;                row[&quot;Billing Amount&quot;] = (-1 * txnAmt).ToString(&quot;F2&quot;);&#xD;&#xA;                billingAmount = row[&quot;Billing Amount&quot;].ToString();&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        string formattedSettlementAmount = FormatAmount(settlementAmount);&#xD;&#xA;        string formattedTransactionAmount = FormatAmount(transactionAmount);&#xD;&#xA;&#xD;&#xA;        row[&quot;Recommended Action&quot;] = $&quot;Debit 101-202030015 ({settlementCurrency} {formattedSettlementAmount}) and Credit 101-202030015 ({transactionCurrency} {formattedTransactionAmount})&quot;;&#xD;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xD;&#xA;    }&#xD;&#xA;    else if (&#xD;&#xA;        channel != &quot;API&quot; &amp;&amp;&#xD;&#xA;        (&#xD;&#xA;            normalizedTxnType.Contains(&quot;fee&quot;) ||&#xD;&#xA;            normalizedTxnType.Contains(&quot;income&quot;) ||&#xD;&#xA;            normalizedTxnType.Contains(&quot;tax on income&quot;)&#xD;&#xA;        )&#xD;&#xA;    )&#xD;&#xA;    {&#xD;&#xA;        row[&quot;Root Cause&quot;] = &quot;Prepaid Card Income updated on CMS only&quot;;&#xD;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xD;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Post the income manually&quot;;&#xD;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Finance&quot;;&#xD;&#xA;    }&#xD;&#xA;    else if (normalizedTxnType.Contains(&quot;money send&quot;))&#xD;&#xA;    {&#xD;&#xA;        row[&quot;Root Cause&quot;] = &quot;MoneySend not yet posted&quot;;&#xD;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xD;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Post the pending MoneySend&quot;;&#xD;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xD;&#xA;    }&#xD;&#xA;    else if (normalizedTxnType.Contains(&quot;miscellaneous debit&quot;) || normalizedTxnType.Contains(&quot;miscellaneous credit&quot;))&#xD;&#xA;    {&#xD;&#xA;        row[&quot;Root Cause&quot;] = &quot;Refund not yet posted&quot;;&#xD;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xD;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Post the pending refund&quot;;&#xD;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xD;&#xA;    }&#xD;&#xA;    else if (normalizedTxnType == &quot;load/reload&quot;)&#xD;&#xA;    {&#xD;&#xA;        row[&quot;Root Cause&quot;] = &quot;Loading updated CMS only&quot;;&#xD;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xD;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Perform MISC ADJUSTMENT DEBIT&quot;;&#xD;&#xA;        row[&quot;Action Owner&quot;] = &quot;Stephen Jilala&quot;;&#xD;&#xA;    }&#xD;&#xA;    else if (&#xD;&#xA;        (normalizedTxnType ==
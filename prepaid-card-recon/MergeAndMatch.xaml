      <ui:InvokeCode ContinueOnError="{x:Null}" Code="&#xA;&#xA;// Ensure type column exists&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;type&quot;))&#xA;{&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;type&quot;, typeof(string));&#xA;}&#xA;&#xA;// Mark existing rows as old&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    row[&quot;type&quot;] = &quot;old&quot;;&#xA;}&#xA;&#xA;int lastSNO = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;&#xA;// Helper: parse GL date to dd-MMM-yyyy&#xA;DateTime ParseGlDate(object obj)&#xA;{&#xA;    if (obj == null || obj == DBNull.Value) return DateTime.MinValue;&#xA;    DateTime dt;&#xA;    if (DateTime.TryParse(obj.ToString(), out dt))&#xA;        return dt;&#xA;    return DateTime.MinValue;&#xA;}&#xA;&#xA;// Helper: parse CMS date to dd-MMM-yyyy&#xA;bool TryParseCmsDate(object obj, out DateTime dt)&#xA;{&#xA;    dt = DateTime.MinValue;&#xA;    if (obj == null || obj == DBNull.Value) return false;&#xA;    string s = obj.ToString();&#xA;    return DateTime.TryParseExact(s, new string[] { &quot;dd/MM/yyyy HH:mm:ss&quot;, &quot;dd/MM/yyyy&quot; }, CultureInfo.InvariantCulture, DateTimeStyles.None, out dt);&#xA;}&#xA;&#xA;// ======================= Merge dtGlStatement =======================&#xA;foreach (DataRow row in dtGlStatement.Rows)&#xA;{&#xA;    var newRow = dtHistoricalReconTransactionsReport.NewRow();&#xA;&#xA;    newRow[&quot;SNO&quot;] = ++lastSNO;&#xA;    newRow[&quot;Branch code&quot;] = &quot;101&quot;;&#xA;    newRow[&quot;GL_Code&quot;] = &quot;202030015&quot;;&#xA;    newRow[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;&#xA;    // Booking / Value Date&#xA;    DateTime bookingDate = ParseGlDate(row[&quot;Booking Date&quot;]);&#xA;    DateTime valueDate   = ParseGlDate(row[&quot;Value Date&quot;]);&#xA;    newRow[&quot;Booking Date&quot;] = bookingDate == DateTime.MinValue ? DBNull.Value : bookingDate.ToString(&quot;dd-MMM-yyyy&quot;);&#xA;    newRow[&quot;Value Date&quot;]   = valueDate == DateTime.MinValue ? DBNull.Value : valueDate.ToString(&quot;dd-MMM-yyyy&quot;);&#xA;&#xA;    // References&#xA;    newRow[&quot;Transaction Ref No:&quot;] = row[&quot;Transaction Ref No:&quot;];&#xA;    newRow[&quot;Narration&quot;]           = row[&quot;Narration&quot;];&#xA;&#xA;    // Debit / Credit&#xA;    decimal debit = 0m, credit = 0m;&#xA;    decimal.TryParse(row[$&quot;Debit ({reconCurrency})&quot;]?.ToString(), out debit);&#xA;    decimal.TryParse(row[$&quot;Credit ({reconCurrency})&quot;]?.ToString(), out credit);&#xA;    newRow[$&quot;Debit ({reconCurrency})&quot;]  = debit;&#xA;    newRow[$&quot;Credit ({reconCurrency})&quot;] = credit;&#xA;&#xA;    // Root cause fields&#xA;    newRow[&quot;Root Cause&quot;]          = row[&quot;Root Cause&quot;];&#xA;    newRow[&quot;Root Cause Category&quot;] = row[&quot;Root Cause Category&quot;];&#xA;    newRow[&quot;Recommended Action&quot;]  = row[&quot;Recommended Action&quot;];&#xA;    newRow[&quot;Action Owner&quot;]        = row[&quot;Action Owner&quot;];&#xA;    newRow[&quot;Aging&quot;]               = row[&quot;Aging&quot;];&#xA;    newRow[&quot;Aging Group&quot;]         = row[&quot;Aging Group&quot;];&#xA;    newRow[&quot;BOT Classification&quot;]  = row[&quot;BOT Classification&quot;];&#xA;&#xA;    // Source and type&#xA;    newRow[&quot;source&quot;] = &quot;GL&quot;;&#xA;    newRow[&quot;type&quot;]   = &quot;new&quot;;&#xA;&#xA;    dtHistoricalReconTransactionsReport.Rows.Add(newRow);&#xA;}&#xA;&#xA;// ======================= Merge dtTransactionReport =======================&#xA;foreach (DataRow row in dtTransactionReport.Rows)&#xA;{&#xA;    var newRow = dtHistoricalReconTransactionsReport.NewRow();&#xA;&#xA;    newRow[&quot;SNO&quot;] = ++lastSNO;&#xA;    newRow[&quot;Branch code&quot;] = &quot;101&quot;;&#xA;    newRow[&quot;GL_Code&quot;] = &quot;202030015&quot;;&#xA;    newRow[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;&#xA;    // Booking / Value Date&#xA;    DateTime txnDate;&#xA;    if (TryParseCmsDate(row[&quot;Transaction Date&quot;], out txnDate))&#xA;    {&#xA;        newRow[&quot;Booking Date&quot;] = txnDate.ToString(&quot;dd-MMM-yyyy&quot;);&#xA;        newRow[&quot;Value Date&quot;]   = txnDate.ToString(&quot;dd-MMM-yyyy&quot;);&#xA;    }&#xA;    else&#xA;    {&#xA;        newRow[&quot;Booking Date&quot;] = DBNull.Value;&#xA;        newRow[&quot;Value Date&quot;]   = DBNull.Value;&#xA;        Console.WriteLine($&quot;[WARNING] Could not parse CMS Transaction Date '{row[&quot;Transaction Date&quot;]}', writing DBNull.&quot;);&#xA;    }&#xA;&#xA;    // References&#xA;    newRow[&quot;Transaction Ref No:&quot;] = row[&quot;Reference Number&quot;];&#xA;&#xA;    // Normalize RRN&#xA;    string rawRrn = row[&quot;RRN&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;    string rrn = string.IsNullOrWhiteSpace(rawRrn)&#xA;        ? &quot;000000000000&quot;&#xA;        : rawRrn.Length &gt;= 12 ? rawRrn[^12..] : rawRrn.PadLeft(12, '0');&#xA;&#xA;    // Narration&#xA;    string maskedPan = row[&quot;C_PAN&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;    string stan = row[&quot;STAN&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;    string auth = row[&quot;AUTHORIZATION_NUMBER&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;    string txnType = row[&quot;Transaction Type&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;&#xA;    newRow[&quot;Narration&quot;] = $&quot;{txnType}-{maskedPan} - {stan} - {rrn} - {auth}&quot;;&#xA;&#xA;    // Debit / Credit&#xA;    decimal billingAmount = 0m;&#xA;    decimal.TryParse(row[&quot;Billing Amount&quot;]?.ToString(), out billingAmount);&#xA;    if (billingAmount &lt; 0)&#xA;    {&#xA;        newRow[$&quot;Debit ({reconCurrency})&quot;]  = Math.Abs(billingAmount);&#xA;        newRow[$&quot;Credit ({reconCurrency})&quot;] = 0m;&#xA;    }&#xA;    else if (billingAmount &gt; 0)&#xA;    {&#xA;        newRow[$&quot;Credit ({reconCurrency})&quot;] = Math.Abs(billingAmount);&#xA;        newRow[$&quot;Debit ({reconCurrency})&quot;]  = 0m;&#xA;    }&#xA;    else&#xA;    {&#xA;        newRow[$&quot;Debit ({reconCurrency})&quot;]  = 0m;&#xA;        newRow[$&quot;Credit ({reconCurrency})&quot;] = 0m;&#xA;    }&#xA;&#xA;    // Root cause fields&#xA;    newRow[&quot;Root Cause&quot;]          = row[&quot;Root Cause&quot;];&#xA;    newRow[&quot;Root Cause Category&quot;] = row[&quot;Root Cause Category&quot;];&#xA;    newRow[&quot;Recommended Action&quot;]  = row[&quot;Recommended Action&quot;];&#xA;    newRow[&quot;Action Owner&quot;]        = row[&quot;Action Owner&quot;];&#xA;    newRow[&quot;Aging&quot;]               = row[&quot;Aging&quot;];&#xA;    newRow[&quot;Aging Group&quot;]         = row[&quot;Aging Group&quot;];&#xA;    newRow[&quot;BOT Classification&quot;]  = row[&quot;BOT Classification&quot;];&#xA;&#xA;    // Source and type&#xA;    newRow[&quot;source&quot;] = &quot;CMS&quot;;&#xA;    newRow[&quot;type&quot;]   = &quot;new&quot;;&#xA;&#xA;    dtHistoricalReconTransactionsReport.Rows.Add(newRow);&#xA;}&#xA;" DisplayName="Merge datatables" sap:VirtualizedContainerService.HintSize="478.4,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_65" Language="CSharp">

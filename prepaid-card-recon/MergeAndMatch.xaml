            <ui:InvokeCode ContinueOnError="{x:Null}" Code="// EPPlus License Context&#xA;//ExcelPackage.LicenseContext = LicenseContext.NonCommercial;&#xA;&#xA;#region === Helpers ===&#xA;&#xA;void ConvertColumnToDateTimeForce(DataTable dt, string colName)&#xA;{&#xA;    if (!dt.Columns.Contains(colName)) return;&#xA;&#xA;    if (dt.Columns[colName].DataType == typeof(DateTime))&#xA;        return;&#xA;&#xA;    string newCol = colName + &quot;_DT_FIX&quot;;&#xA;    if (dt.Columns.Contains(newCol)) dt.Columns.Remove(newCol);&#xA;    dt.Columns.Add(newCol, typeof(DateTime));&#xA;&#xA;    foreach (DataRow row in dt.Rows)&#xA;    {&#xA;        object val = row[colName];&#xA;        DateTime parsed;&#xA;&#xA;        if (val is DateTime dtVal)&#xA;        {&#xA;            parsed = dtVal;&#xA;        }&#xA;        else if (val is double d)&#xA;        {&#xA;            parsed = DateTime.FromOADate(d);&#xA;        }&#xA;        else&#xA;        {&#xA;            string str = val?.ToString()?.Trim() ?? &quot;&quot;;&#xA;&#xA;            if (double.TryParse(str, out var serial))&#xA;            {&#xA;                parsed = DateTime.FromOADate(serial);&#xA;            }&#xA;            else if (DateTime.TryParseExact(str,&#xA;                new[] { &quot;dd/MM/yyyy HH:mm:ss&quot;, &quot;dd/MM/yyyy&quot;, &quot;MM/dd/yyyy&quot;, &quot;M/d/yyyy&quot;, &quot;yyyy-MM-dd&quot;, &quot;dd-MM-yyyy&quot;, &quot;d-MMM-yy&quot;, &quot;dd-MMM-yyyy&quot; },&#xA;                CultureInfo.InvariantCulture,&#xA;                DateTimeStyles.None,&#xA;                out parsed))&#xA;            {&#xA;                // success&#xA;            }&#xA;            else if (DateTime.TryParse(str, CultureInfo.InvariantCulture, DateTimeStyles.None, out parsed))&#xA;            {&#xA;                // fallback success&#xA;            }&#xA;            else&#xA;            {&#xA;                parsed = DateTime.MinValue;&#xA;            }&#xA;        }&#xA;&#xA;        row[newCol] = parsed;&#xA;    }&#xA;&#xA;    dt.Columns.Remove(colName);&#xA;    dt.Columns[newCol].ColumnName = colName;&#xA;}&#xA;&#xA;#endregion&#xA;&#xA;#region === Normalize Dates in Final Table ===&#xA;&#xA;ConvertColumnToDateTimeForce(dtHistoricalReconTransactionsReport, &quot;Booking Date&quot;);&#xA;ConvertColumnToDateTimeForce(dtHistoricalReconTransactionsReport, &quot;Value Date&quot;);&#xA;&#xA;#endregion&#xA;&#xA;#region === Apply Static Columns ===&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    row[&quot;Branch code&quot;] = &quot;101&quot;;&#xA;    row[&quot;GL_Code&quot;] = &quot;202030015&quot;;&#xA;    row[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;}&#xA;&#xA;#endregion&#xA;&#xA;#region === Write to Excel ===&#xA;&#xA;if (dtHistoricalReconTransactionsReport == null || dtHistoricalReconTransactionsReport.Rows.Count == 0)&#xA;    throw new Exception(&quot;DataTable 'dtHistoricalReconTransactionsReport' is null or empty.&quot;);&#xA;&#xA;if (!File.Exists(prepaidCardFileName))&#xA;    throw new FileNotFoundException($&quot;The file '{prepaidCardFileName}' does not exist.&quot;);&#xA;&#xA;int startingRow = 18;&#xA;int rowCount = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;int lastRow = startingRow + rowCount - 1;&#xA;&#xA;Console.WriteLine($&quot;📊 Writing {rowCount:N0} rows starting at row {startingRow}...&quot;);&#xA;&#xA;try&#xA;{&#xA;    using (var package = new ExcelPackage(new FileInfo(prepaidCardFileName)))&#xA;    {&#xA;        var ws = package.Workbook.Worksheets.FirstOrDefault(x =&gt; x.Name.Trim().Equals(&quot;Recon Report&quot;, StringComparison.OrdinalIgnoreCase))&#xA;                 ?? throw new Exception(&quot;Worksheet 'Recon Report' not found.&quot;);&#xA;&#xA;        // Delete old data rows&#xA;        int currentLastRow = ws.Dimension?.End?.Row ?? 0;&#xA;        int rowsToDelete = currentLastRow - startingRow + 1;&#xA;        if (rowsToDelete &gt; 0) ws.DeleteRow(startingRow, rowsToDelete);&#xA;&#xA;        // Insert space&#xA;        ws.InsertRow(startingRow, rowCount);&#xA;&#xA;        for (int i = 0; i &lt; rowCount; i++)&#xA;        {&#xA;            var row = dtHistoricalReconTransactionsReport.Rows[i];&#xA;            int r = startingRow + i;&#xA;&#xA;            for (int col = 2; col &lt;= 18; col++)&#xA;            {&#xA;                var cell = ws.Cells[r, col];&#xA;                cell.Clear();&#xA;                cell.StyleID = 0;&#xA;            }&#xA;&#xA;            ws.Cells[r, 2].Value = i + 1;&#xA;            ws.Cells[r, 3].Value = row[&quot;Branch code&quot;];&#xA;            ws.Cells[r, 4].Value = row[&quot;GL_Code&quot;];&#xA;            ws.Cells[r, 5].Value = row[&quot;GL Description&quot;];&#xA;&#xA;            ws.Cells[r, 6].Value = row[&quot;Booking Date&quot;];&#xA;            ws.Cells[r, 7].Value = row[&quot;Value Date&quot;];&#xA;&#xA;            ws.Cells[r, 8].Value = row[&quot;Transaction Ref No:&quot;];&#xA;            ws.Cells[r, 9].Value = row[&quot;Narration&quot;];&#xA;&#xA;            decimal.TryParse(row[$&quot;Debit ({reconCurrency})&quot;]?.ToString()?.Replace(&quot;,&quot;, &quot;&quot;), out var debit);&#xA;            decimal.TryParse(row[$&quot;Credit ({reconCurrency})&quot;]?.ToString()?.Replace(&quot;,&quot;, &quot;&quot;), out var credit);&#xA;&#xA;            ws.Cells[r, 10].Value = Math.Round(debit, 2);&#xA;            ws.Cells[r, 11].Value = Math.Round(credit, 2);&#xA;&#xA;            ws.Cells[r, 12].Formula = $&quot;$H$6 - G{r}&quot;;&#xA;            ws.Cells[r, 13].Formula = $&quot;IF(L{r}&lt;4,\&quot;0-3 Days\&quot;,IF(L{r}&lt;31,\&quot;4-30 Days\&quot;,IF(L{r}&lt;61,\&quot;31-60 Days\&quot;,IF(L{r}&lt;=90,\&quot;61-90 Days\&quot;,\&quot;Above 90 Days\&quot;))))&quot;;&#xA;            ws.Cells[r, 14].Formula = $&quot;IF(J{r}&gt;0,IF(L{r}&lt;30,\&quot;Normal\&quot;,IF(L{r}&lt;60,\&quot;Especially Mentioned\&quot;,IF(L{r}&lt;90,\&quot;Substandard\&quot;,IF(L{r}&lt;=180,\&quot;Doubtful\&quot;,\&quot;Loss\&quot;)))),\&quot;Not Applicable\&quot;)&quot;;&#xA;&#xA;            ws.Cells[r, 15].Value = row[&quot;Root Cause&quot;];&#xA;            ws.Cells[r, 16].Value = row[&quot;Root Cause Category&quot;];&#xA;            ws.Cells[r, 17].Value = row[&quot;Recommended Action&quot;];&#xA;            ws.Cells[r, 18].Value = row[&quot;Action Owner&quot;];&#xA;&#xA;            if ((i + 1) % 10000 == 0)&#xA;                Console.WriteLine($&quot;  → Written {i + 1:N0} rows...&quot;);&#xA;        }&#xA;&#xA;        ws.Cells[startingRow, 6, lastRow, 7].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;        ws.Cells[startingRow, 10, lastRow, 11].Style.Numberformat.Format = &quot;#,##0.00;[Red]-#,##0.00&quot;;&#xA;&#xA;        ws.Cells[&quot;H6&quot;].Value = reconDate;&#xA;        ws.Cells[&quot;K9&quot;].Value = glClosingBalance;&#xA;        ws.Cells[&quot;K10&quot;].Value = cmsBalance;&#xA;&#xA;        string jRange = $&quot;J{startingRow}:J{lastRow}&quot;;&#xA;        string kRange = $&quot;K{startingRow}:K{lastRow}&quot;;&#xA;        ws.Cells[&quot;J13&quot;].Formula = $&quot;-SUM({jRange})&quot;;&#xA;        ws.Cells[&quot;K13&quot;].Formula = $&quot;SUM({kRange})&quot;;&#xA;        ws.Cells[&quot;J16&quot;].Formula = $&quot;SUM({jRange})&quot;;&#xA;        ws.Cells[&quot;K16&quot;].Formula = $&quot;SUM({kRange})&quot;;&#xA;        ws.Cells[&quot;K14&quot;].Formula = &quot;ROUND((J13+K13),2)&quot;;&#xA;        ws.Cells[&quot;K15&quot;].Formula = &quot;ROUND((K11-K14),2)&quot;;&#xA;&#xA;        package.Workbook.CalcMode = ExcelCalcMode.Automatic;&#xA;        package.Workbook.FullCalcOnLoad = true;&#xA;&#xA;        package.Save();&#xA;    }&#xA;&#xA;    Console.WriteLine($&quot;✅ Written {rowCount:N0} rows.&quot;);&#xA;    Console.WriteLine($&quot;✅ glClosingBalance (K9): {glClosingBalance:N2}&quot;);&#xA;    Console.WriteLine($&quot;✅ cmsBalance (K10): {cmsBalance:N2}&quot;);&#xA;}&#xA;catch (Exception ex)&#xA;{&#xA;    Console.WriteLine($&quot;❌ ERROR: {ex.Message}&quot;);&#xA;}&#xA;&#xA;#endregion&#xA;" DisplayName="Write dtHistoricalReconTransactionsReport and Recon Report Balances" sap:VirtualizedContainerService.HintSize="416,48" sap2010:WorkflowViewState.IdRef="InvokeCode_120" Language="CSharp">

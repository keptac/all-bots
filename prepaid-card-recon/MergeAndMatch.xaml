      <ui:InvokeCode ContinueOnError="{x:Null}" Code="System.Collections.Generic.HashSet&lt;decimal&gt; allowedDebitValues = new System.Collections.Generic.HashSet&lt;decimal&gt; { 1101.69m, 198.31m };&#xA;string[] dateFormatsInternal = { &quot;MM/dd/yyyy&quot;, &quot;M/d/yyyy&quot;, &quot;MM/dd/yy&quot; };&#xA;string[] reconDateFormats = { &quot;dd-MM-yyyy&quot;, &quot;dd-MMM-yyyy&quot;, &quot;d-MMM-yyyy&quot;, &quot;d-MM-yyyy&quot; };&#xA;System.Globalization.CultureInfo invCulture = System.Globalization.CultureInfo.InvariantCulture;&#xA;&#xA;// ✅ Normalize helper&#xA;string Normalize(string input)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(input)) return string.Empty;&#xA;    return System.Text.RegularExpressions.Regex.Replace(input.Trim(), @&quot;\s+&quot;, &quot; &quot;).ToLowerInvariant();&#xA;}&#xA;&#xA;// ✅ Normalize recon currency&#xA;string reconCurrencyNormalized = Normalize(reconCurrency);&#xA;&#xA;// ✅ Parse recon date&#xA;System.DateTime reconDateParsed;&#xA;if (!System.DateTime.TryParseExact(reconDate, reconDateFormats, invCulture, System.Globalization.DateTimeStyles.None, out reconDateParsed))&#xA;    throw new Exception($&quot;❌ Could not parse reconDate: '{reconDate}'&quot;);&#xA;&#xA;int reportRowNumber = 2;&#xA;&#xA;// ✅ Ensure IsLatePosted column&#xA;if (!dtGlStatement.Columns.Contains(&quot;IsLatePosted&quot;))&#xA;    dtGlStatement.Columns.Add(&quot;IsLatePosted&quot;, typeof(bool));&#xA;&#xA;foreach (System.Data.DataRow row in dtGlStatement.Rows)&#xA;{&#xA;    row[&quot;Branch code&quot;] = &quot;101&quot;;&#xA;    row[&quot;GL_Code&quot;] = &quot;202030015&quot;;&#xA;    row[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;    row[&quot;IsLatePosted&quot;] = false;&#xA;&#xA;    // === Format Dates&#xA;    if (System.DateTime.TryParseExact(row[&quot;Value Date&quot;]?.ToString(), dateFormatsInternal, invCulture, System.Globalization.DateTimeStyles.None, out var valueDt))&#xA;        row[&quot;Value Date&quot;] = valueDt.ToString(&quot;dd-MMM-yyyy&quot;, invCulture);&#xA;    if (System.DateTime.TryParseExact(row[&quot;Booking Date&quot;]?.ToString(), dateFormatsInternal, invCulture, System.Globalization.DateTimeStyles.None, out var bookingDt))&#xA;        row[&quot;Booking Date&quot;] = bookingDt.ToString(&quot;dd-MMM-yyyy&quot;, invCulture);&#xA;&#xA;    // === Excel formulas&#xA;    row[&quot;Aging&quot;] = $&quot;=$H$6-G{reportRowNumber}&quot;;&#xA;    row[&quot;Aging Group&quot;] = $&quot;=IF(L{reportRowNumber}&lt;4,\&quot;0-3 Days\&quot;,IF(L{reportRowNumber}&lt;31,\&quot;4-30 Days\&quot;,IF(L{reportRowNumber}&lt;61,\&quot;31-60 Days\&quot;,IF(L{reportRowNumber}&lt;=90,\&quot;61-90 Days\&quot;,IF(L{reportRowNumber}&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;    row[&quot;BOT Classification&quot;] = $&quot;=IF(J{reportRowNumber}&gt;0,IF(L{reportRowNumber}&lt;30,\&quot;Normal\&quot;,IF(L{reportRowNumber}&lt;60,\&quot;Especially Mentioned\&quot;,IF(L{reportRowNumber}&lt;90,\&quot;Substandard\&quot;,IF(L{reportRowNumber}&lt;=180,\&quot;Doubtful\&quot;,IF(L{reportRowNumber}&gt;180,\&quot;Loss\&quot;,\&quot;0\&quot;))))),\&quot;Not Applicable\&quot;)&quot;;&#xA;&#xA;    // === Narration normalization&#xA;    string refNo = row[&quot;Transaction Ref No:&quot;]?.ToString()?.ToUpperInvariant() ?? &quot;&quot;;&#xA;    string narration = row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string narrationLower = narration.ToLowerInvariant();&#xA;    string normalizedNarration = System.Text.RegularExpressions.Regex.Replace(narrationLower, @&quot;[^a-z\s]&quot;, &quot;&quot;);&#xA;    normalizedNarration = System.Text.RegularExpressions.Regex.Replace(normalizedNarration, @&quot;\s+&quot;, &quot; &quot;);&#xA;&#xA;    // === Debit amount&#xA;    decimal.TryParse(row[&quot;Debit (TZS)&quot;]?.ToString(), out decimal debitAmount);&#xA;&#xA;    // === ContainsAny helper&#xA;    bool ContainsAny(string input, params string[] patterns)&#xA;    {&#xA;        foreach (string p in patterns)&#xA;            if (input.IndexOf(p, StringComparison.OrdinalIgnoreCase) &gt;= 0)&#xA;                return true;&#xA;        return false;&#xA;    }&#xA;&#xA;    // === Late posting condition&#xA;    bool isExcludedFromLatePost =&#xA;        ContainsAny(refNo, &quot;PPSP&quot;, &quot;PPSA&quot;) ||&#xA;        narrationLower.Contains(&quot;umoja switch charge&quot;);&#xA;&#xA;    if (System.DateTime.TryParseExact(row[&quot;Value Date&quot;]?.ToString(), &quot;dd-MMM-yyyy&quot;, invCulture, System.Globalization.DateTimeStyles.None, out valueDt))&#xA;    {&#xA;        var dayBeforeRecon = reconDateParsed.AddDays(-1);&#xA;        if ((valueDt == reconDateParsed || valueDt == dayBeforeRecon) &amp;&amp;&#xA;            !normalizedNarration.StartsWith(&quot;journal posting&quot;) &amp;&amp;&#xA;            !isExcludedFromLatePost)&#xA;        {&#xA;            row[&quot;IsLatePosted&quot;] = true;&#xA;        }&#xA;    }&#xA;&#xA;    // === Root Cause Classification&#xA;    if (System.Text.RegularExpressions.Regex.IsMatch(narrationLower, @&quot;\b(for|from)\s?\d{6}(\s?(to|_)\s?\d{6})\b&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase))&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Manually posted income not matching with income from CMS&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Reverse the wrong amount and post the correct one&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Finance&quot;;&#xA;    }&#xA;    else if (ContainsAny(refNo, &quot;PPSP&quot;, &quot;PPSA&quot;))&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Auth dump posted transactions not matched against outstanding remote-on-us txns&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Under investigation&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Reconciliation&quot;;&#xA;        continue;&#xA;    }&#xA;    else if (refNo.Contains(&quot;CWPP&quot;))&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Auth dump posted transactions not matched against outstanding remote-on-us txns&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Under investigation&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Reconciliation&quot;;&#xA;    }&#xA;    else if (refNo.Contains(&quot;UMJP&quot;) &amp;&amp;&#xA;            (narrationLower.Contains(&quot;cash withdraw charge&quot;) ||&#xA;             narrationLower.Contains(&quot;vat payable on comm and fees&quot;) ||&#xA;             narrationLower.Contains(&quot;atm withdrawl prepaid&quot;)))&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Wrong configuration of UBX ATM charges&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Reverse the charges and correctly configure CBS to pass the right charges&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement &amp; Stephen Jilala&quot;;&#xA;    }&#xA;    else if (refNo.Contains(&quot;PPAT&quot;))&#xA;    {&#xA;        decimal amt = System.Math.Round(debitAmount, 2);&#xA;        if (allowedDebitValues.Contains(amt))&#xA;        {&#xA;            row[&quot;Root Cause&quot;] = &quot;Cash withdrawal charges on unsuccessful ATM withdrawal transactions&quot;;&#xA;            row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;            row[&quot;Recommended Action&quot;] = &quot;Reverse the charge&quot;;&#xA;            row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;        }&#xA;        else&#xA;        {&#xA;            row[&quot;Root Cause&quot;] = &quot;__PPAT_PENDING__&quot;;&#xA;        }&#xA;    }&#xA;    else if (ContainsAny(refNo, &quot;PRDP&quot;, &quot;AGR1&quot;, &quot;AGR2&quot;))&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Loading updated CBS only&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Perform MISC ADJUSTMENT CREDIT&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Stephen Jilala&quot;;&#xA;    }&#xA;    else if (refNo.Contains(&quot;AGW&quot;))&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Wakala updated CBS only&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Under investigation&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Stephen Jilala&quot;;&#xA;    }&#xA;    else if (normalizedNarration.Contains(&quot;journal posting miscellaneous&quot;))&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Unmatched manual entries&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;To be manually matched&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Reconciliation&quot;;&#xA;    }&#xA;    else&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Unmatched manual entries&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;To be manually matched&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Reconciliation&quot;;&#xA;    }&#xA;&#xA;    reportRowNumber++;&#xA;}&#xA;&#xA;// === Post-process PPAT grouped rows ===&#xA;var ppats = dtGlStatement.AsEnumerable()&#xA;    .Where(r =&gt; r[&quot;Transaction Ref No:&quot;].ToString().ToUpperInvariant().Contains(&quot;PPAT&quot;))&#xA;    .GroupBy(r =&gt; r[&quot;Transaction Ref No:&quot;].ToString());&#xA;&#xA;foreach (var group in ppats)&#xA;{&#xA;    if (group.Count() != 4)&#xA;    {&#xA;        Console.WriteLine($&quot;❗ Warning: PPAT group with RefNo '{group.Key}' has {group.Count()} rows (expected 4).&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    var pending = group.Where(r =&gt; r[&quot;Root Cause&quot;]?.ToString() == &quot;__PPAT_PENDING__&quot;).ToList();&#xA;    if (pending.Count != 2)&#xA;    {&#xA;        Console.WriteLine($&quot;❗ Warning: PPAT group with RefNo '{group.Key}' has {pending.Count} pending rows (expected 2).&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    var row1 = pending[0];&#xA;    var row2 = pending[1];&#xA;    decimal amt1 = System.Math.Round(Convert.ToDecimal(row1[&quot;Debit (TZS)&quot;]), 2);&#xA;    decimal amt2 = System.Math.Round(Convert.ToDecimal(row2[&quot;Debit (TZS)&quot;]), 2);&#xA;&#xA;    DataRow levyRow = amt1 &lt; amt2 ? row1 : row2;&#xA;    DataRow principalRow = amt1 &gt;= amt2 ? row1 : row2;&#xA;&#xA;    levyRow[&quot;Root Cause&quot;] = &quot;Government levy on unsuccessful ATM withdrawal transactions&quot;;&#xA;    levyRow[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;    levyRow[&quot;Recommended Action&quot;] = &quot;Reverse the levy&quot;;&#xA;    levyRow[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;&#xA;    principalRow[&quot;Root Cause&quot;] = &quot;Unsuccessful ATM withdrawal transaction debited the GL&quot;;&#xA;    principalRow[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;    principalRow[&quot;Recommended Action&quot;] = &quot;Follow up with respective branch to suspend the overages as per process&quot;;&#xA;    principalRow[&quot;Action Owner&quot;] = &quot;ATM Reconciliation Team&quot;;&#xA;}&#xA;" DisplayName="dtGlStatement add Root Cause" sap:VirtualizedContainerService.HintSize="478.4,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_50" Language="CSharp">

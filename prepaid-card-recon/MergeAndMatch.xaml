      <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Inputs:&#xA;// dtHistoricalReconTransactionsReport (System.Data.DataTable)&#xA;// dtHistoricalReconTransactionsReportMatched (System.Data.DataTable)&#xA;// ref decimal bulkRoundingError&#xA;// string reconCurrency (e.g. &quot;USD&quot;, &quot;TZS&quot;)&#xA;&#xA;string creditCol = $&quot;Credit ({reconCurrency})&quot;;&#xA;string debitCol  = $&quot;Debit ({reconCurrency})&quot;;&#xA;&#xA;var feeDirectionMap = new System.Collections.Generic.Dictionary&lt;string, bool&gt;(System.StringComparer.OrdinalIgnoreCase)&#xA;{&#xA;    [&quot;CARD FEES&quot;] = true,&#xA;    [&quot;CASH ADVANCE/ CASH AT POS / CASH OUT TRANSACTION FEE&quot;] = true,&#xA;    [&quot;PURCHASE/AUTH COMPLETION TRANSACTION FEE&quot;] = true,&#xA;    [&quot;CASH WITHDRAWAL TRANSACTION FEE&quot;] = true,&#xA;    [&quot;BALANCE INQUIRY TRANSACTION FEE&quot;] = true,&#xA;    [&quot;RECURRING TRANSACTION TRANSACTION FEE&quot;] = true,&#xA;    [&quot;MINI STATEMENT TRANSACTION FEE&quot;] = true,&#xA;    [&quot;SERVICE TAX/TAX ON INCOME&quot;] = true&#xA;};&#xA;&#xA;var dateRangeRegex = new System.Text.RegularExpressions.Regex(@&quot;(\d{6})\s*(?:[Tt][Oo]|-|\/)?\s*(\d{6})&quot;);&#xA;string[] allowedFormats = { &quot;MM/dd/yyyy HH:mm:ss&quot;, &quot;dd-MMM-yyyy&quot;, &quot;M/d/yyyy&quot; };&#xA;&#xA;// === Step 1: Convert string dates ===&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    foreach (string col in new[] { &quot;Booking Date&quot;, &quot;Value Date&quot; })&#xA;    {&#xA;        if (!dtHistoricalReconTransactionsReport.Columns.Contains(col)) continue;&#xA;&#xA;        var val = row[col];&#xA;        if (val == null || val == System.DBNull.Value) continue;&#xA;&#xA;        if (val is string s)&#xA;        {&#xA;            s = s.Trim();&#xA;            if (System.DateTime.TryParseExact(s, allowedFormats, null, System.Globalization.DateTimeStyles.None, out var parsed))&#xA;            {&#xA;                row[col] = parsed;&#xA;            }&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Helper Functions ===&#xA;System.DateTime ParseBookingDate(object value)&#xA;{&#xA;    if (value == null || value == System.DBNull.Value) return System.DateTime.MinValue;&#xA;    if (value is System.DateTime dt) return dt;&#xA;&#xA;    string str = value.ToString().Trim();&#xA;    if (System.DateTime.TryParseExact(str, allowedFormats, null, System.Globalization.DateTimeStyles.None, out var parsed))&#xA;        return parsed;&#xA;&#xA;    return System.DateTime.MinValue;&#xA;}&#xA;&#xA;System.DateTime ParseCompactDate(string val)&#xA;{&#xA;    return System.DateTime.TryParseExact(val, &quot;ddMMyy&quot;, null, System.Globalization.DateTimeStyles.None, out var parsed)&#xA;        ? parsed&#xA;        : System.DateTime.MinValue;&#xA;}&#xA;&#xA;decimal TryParseDecimal(object val)&#xA;{&#xA;    if (val == null || val == System.DBNull.Value) return 0m;&#xA;    string s = val.ToString().Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;).Trim();&#xA;    return decimal.TryParse(s, out var result) ? result : 0m;&#xA;}&#xA;&#xA;// === Step 3: Narration Matching Logic ===&#xA;System.Console.WriteLine(&quot;===== GL Narration Matching Against Historical Totals =====&quot;);&#xA;&#xA;var glCandidates = dtHistoricalReconTransactionsReport.AsEnumerable().ToList();&#xA;var rowsToRemove = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;bool anyMatches = false;&#xA;&#xA;foreach (System.Data.DataRow row in glCandidates)&#xA;{&#xA;    string narration = row[&quot;Narration&quot;]?.ToString()?.Trim().ToUpperInvariant() ?? &quot;&quot;;&#xA;    if (!narration.Contains(&quot;JOURNAL&quot;)) continue;&#xA;&#xA;    var match = dateRangeRegex.Match(narration);&#xA;    if (!match.Success) continue;&#xA;&#xA;    System.DateTime fromDate = ParseCompactDate(match.Groups[1].Value);&#xA;    System.DateTime toDate = ParseCompactDate(match.Groups[2].Value);&#xA;    if (fromDate == System.DateTime.MinValue || toDate == System.DateTime.MinValue) continue;&#xA;&#xA;    var rule = feeDirectionMap.Keys.FirstOrDefault(k =&gt; narration.Contains(k.ToUpperInvariant()));&#xA;    if (string.IsNullOrEmpty(rule)) continue;&#xA;&#xA;    bool useCredit = feeDirectionMap[rule];&#xA;    string amountCol = useCredit ? creditCol : debitCol;&#xA;    decimal glAmount = TryParseDecimal(row[useCredit ? creditCol : debitCol]);&#xA;&#xA;    var matchedRows = dtHistoricalReconTransactionsReport.AsEnumerable()&#xA;        .Where(r =&gt;&#xA;        {&#xA;            string histNarr = r[&quot;Narration&quot;]?.ToString()?.Trim().ToUpperInvariant() ?? &quot;&quot;;&#xA;            System.DateTime bookDate = ParseBookingDate(r[&quot;Booking Date&quot;]);&#xA;            return histNarr.Contains(rule.ToUpperInvariant()) &amp;&amp; bookDate &gt;= fromDate &amp;&amp; bookDate &lt;= toDate;&#xA;        })&#xA;        .ToList();&#xA;&#xA;    decimal matchedTotal = matchedRows.Sum(r =&gt; TryParseDecimal(r[amountCol]));&#xA;    decimal difference = System.Math.Abs(glAmount - matchedTotal);&#xA;&#xA;    System.Console.WriteLine($&quot;🧾 NARRATION: {narration}&quot;);&#xA;    System.Console.WriteLine($&quot;📅 RANGE: {fromDate:dd-MMM-yyyy} to {toDate:dd-MMM-yyyy}&quot;);&#xA;    System.Console.WriteLine($&quot;💳 GL Amount: {glAmount:N2}&quot;);&#xA;    System.Console.WriteLine($&quot;📊 Matched {rule} Total: {matchedTotal:N2}&quot;);&#xA;&#xA;    if (difference &lt;= 0.01m)&#xA;    {&#xA;        System.Console.WriteLine($&quot;✅ MATCH – Difference within tolerance ({difference:N2}). Moving rows to matched table.&quot;);&#xA;        bulkRoundingError += difference;&#xA;        anyMatches = true;&#xA;&#xA;        dtHistoricalReconTransactionsReportMatched.ImportRow(row);&#xA;        rowsToRemove.Add(row);&#xA;&#xA;        foreach (var histRow in matchedRows)&#xA;        {&#xA;            dtHistoricalReconTransactionsReportMatched.ImportRow(histRow);&#xA;            rowsToRemove.Add(histRow);&#xA;        }&#xA;    }&#xA;    else&#xA;    {&#xA;        System.Console.WriteLine($&quot;❌ MISMATCH – Difference: {difference:N2}. Totals do not match.&quot;);&#xA;    }&#xA;&#xA;    System.Console.WriteLine(&quot;----------------------------------------------------&quot;);&#xA;}&#xA;&#xA;// === Step 4: Remove matched rows ===&#xA;foreach (var r in rowsToRemove.Distinct().ToList())&#xA;{&#xA;    if (r.Table == dtHistoricalReconTransactionsReport &amp;&amp; r.RowState != System.Data.DataRowState.Detached)&#xA;    {&#xA;        dtHistoricalReconTransactionsReport.Rows.Remove(r);&#xA;    }&#xA;}&#xA;&#xA;System.Console.WriteLine(anyMatches&#xA;    ? &quot;✅ Matching completed. One or more groups were matched.&quot;&#xA;    : &quot;❌ No matching groups were found in the dataset.&quot;);&#xA;" DisplayName="(bulkRoundingError) REMOVE GL date Range Fees/Income" sap:VirtualizedContainerService.HintSize="478.4,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_57" Language="CSharp">

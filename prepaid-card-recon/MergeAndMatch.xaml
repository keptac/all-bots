      <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Local copy to avoid CS1628 error&#xA;string reconCurrencyLocal = reconCurrency;&#xA;&#xA;// === Step 1: Normalize Search Keys once and cache amounts ===&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Search Key&quot;))&#xA;        continue;&#xA;&#xA;    if (row[&quot;Search Key&quot;] != null)&#xA;        row[&quot;Search Key&quot;] = row[&quot;Search Key&quot;].ToString().Trim().ToUpperInvariant();&#xA;}&#xA;&#xA;// === Step 2: Index CMS rows with FOREIGN_CURRENCY = true ===&#xA;var cmsMap = new Dictionary&lt;string, DataRow&gt;();&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string source = row[&quot;Source&quot;]?.ToString()?.Trim().ToUpperInvariant() ?? &quot;&quot;;&#xA;    bool isForeign = row[&quot;FOREIGN_CURRENCY&quot;] is bool b &amp;&amp; b;&#xA;&#xA;    if (source == &quot;CMS&quot; &amp;&amp; isForeign)&#xA;    {&#xA;        string key = $&quot;{row[&quot;Search Key&quot;]}|{ParseDecimal(row[$&quot;Debit ({reconCurrencyLocal})&quot;])}|{ParseDecimal(row[$&quot;Credit ({reconCurrencyLocal})&quot;])}&quot;;&#xA;        if (!cmsMap.ContainsKey(key))&#xA;            cmsMap[key] = row; // Only keep first match&#xA;    }&#xA;}&#xA;&#xA;// === Step 3: Update matching GL rows using indexed CMS rows ===&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string source = row[&quot;Source&quot;]?.ToString()?.Trim().ToUpperInvariant() ?? &quot;&quot;;&#xA;    if (source != &quot;GL&quot;) continue;&#xA;&#xA;    string key = $&quot;{row[&quot;Search Key&quot;]}|{ParseDecimal(row[$&quot;Debit ({reconCurrencyLocal})&quot;])}|{ParseDecimal(row[$&quot;Credit ({reconCurrencyLocal})&quot;])}&quot;;&#xA;    if (cmsMap.TryGetValue(key, out DataRow cmsRow))&#xA;    {&#xA;        if (row[&quot;Recommended Action&quot;] == null || row[&quot;Recommended Action&quot;] == DBNull.Value)&#xA;            row[&quot;Recommended Action&quot;] = cmsRow[&quot;Recommended Action&quot;];&#xA;    }&#xA;}&#xA;&#xA;// === Helper: Fast, null-safe decimal parser ===&#xA;decimal ParseDecimal(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return 0m;&#xA;    decimal.TryParse(val.ToString().Replace(&quot;,&quot;, &quot;&quot;), out decimal result);&#xA;    return result;&#xA;}&#xA;" DisplayName="update FX dtHistoricalReconTransactionsReport" sap:VirtualizedContainerService.HintSize="478.4,56.8" sap2010:WorkflowViewState.IdRef="InvokeCode_66" Language="CSharp">

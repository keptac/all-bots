    <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === RECON BOT ALERT: Account Balances &amp; Status + Misc Adjustment Credits (non-TZS) ===&#xA;// Builds emailSubject / emailBody (HTML). Never throws - on failure it emits a fault&#xA;// notice in the body so the Reconciliation Group still receives an alert.&#xA;&#xA;var html = new StringBuilder();&#xA;string baseCcy = string.IsNullOrWhiteSpace(reconCurrency) ? &quot;TZS&quot; : reconCurrency.Trim().ToUpperInvariant();&#xA;string dateLabel = reconDate;&#xA;DateTime reconDateParsed;&#xA;if (DateTime.TryParse(reconDate, out reconDateParsed))&#xA;    dateLabel = reconDateParsed.ToString(&quot;dd-MMM-yyyy&quot;);&#xA;&#xA;// ---------- helpers ----------&#xA;string Enc(object o)&#xA;{&#xA;    string s = o == null || o == DBNull.Value ? &quot;&quot; : o.ToString();&#xA;    return s.Replace(&quot;&amp;&quot;, &quot;&amp;amp;&quot;).Replace(&quot;&lt;&quot;, &quot;&amp;lt;&quot;).Replace(&quot;&gt;&quot;, &quot;&amp;gt;&quot;);&#xA;}&#xA;&#xA;decimal ParseAmount(object input)&#xA;{&#xA;    if (input == null || input == DBNull.Value) return 0m;&#xA;    if (input is decimal dm) return dm;&#xA;    if (input is double db) return (decimal)db;&#xA;&#xA;    string raw = input.ToString().Trim()&#xA;        .Replace(&quot;,&quot;, &quot;&quot;)&#xA;        .Replace(&quot;Cr&quot;, &quot;&quot;, StringComparison.OrdinalIgnoreCase)&#xA;        .Replace(&quot;Dr&quot;, &quot;&quot;, StringComparison.OrdinalIgnoreCase)&#xA;        .Trim();&#xA;&#xA;    if (raw.StartsWith(&quot;(&quot;) &amp;&amp; raw.EndsWith(&quot;)&quot;))&#xA;        raw = &quot;-&quot; + raw.Trim('(', ')');&#xA;&#xA;    decimal result;&#xA;    return decimal.TryParse(raw, NumberStyles.Any, CultureInfo.InvariantCulture, out result) ? result : 0m;&#xA;}&#xA;&#xA;string FindCol(DataTable t, params string[] candidates)&#xA;{&#xA;    if (t == null) return null;&#xA;    foreach (string c in candidates)&#xA;        if (t.Columns.Contains(c)) return c;&#xA;    // fall back to a case / space insensitive match&#xA;    foreach (string c in candidates)&#xA;    {&#xA;        string needle = c.Replace(&quot; &quot;, &quot;&quot;).ToLowerInvariant();&#xA;        foreach (DataColumn dc in t.Columns)&#xA;            if (dc.ColumnName.Replace(&quot; &quot;, &quot;&quot;).ToLowerInvariant() == needle) return dc.ColumnName;&#xA;    }&#xA;    return null;&#xA;}&#xA;&#xA;// Mask a card / wallet identifier: keep first 6 and last 4 only.&#xA;string MaskId(string id)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(id)) return &quot;N/A&quot;;&#xA;    string v = id.Trim();&#xA;    if (v.Length &lt;= 10) return v;&#xA;    return v.Substring(0, 6) + new string('*', v.Length - 10) + v.Substring(v.Length - 4);&#xA;}&#xA;&#xA;html.AppendLine(&quot;&lt;html&gt;&lt;body style='font-family:Segoe UI;font-size:13px;color:#212529;'&gt;&quot;);&#xA;html.AppendLine(&quot;&lt;h2 style='color:#007BFF;margin-bottom:2px;'&gt;PREPAID CARD RECON - BOT ALERT&lt;/h2&gt;&quot;);&#xA;html.AppendLine($&quot;&lt;p style='margin-top:0;'&gt;&lt;strong&gt;Recon Date:&lt;/strong&gt; {Enc(dateLabel)} &amp;nbsp;|&amp;nbsp; &lt;strong&gt;Base Currency:&lt;/strong&gt; {Enc(baseCcy)} &amp;nbsp;|&amp;nbsp; &lt;strong&gt;Generated:&lt;/strong&gt; {DateTime.Now:dd-MMM-yyyy HH:mm}&lt;/p&gt;&quot;);&#xA;&#xA;// =====================================================================&#xA;// SECTION 1 - ACCOUNT BALANCE AND STATUS REPORT&#xA;// =====================================================================&#xA;try&#xA;{&#xA;    DataTable dtBal = dtAccountBalanceAndStatusReport;&#xA;&#xA;    // Fall back to reading the source workbook when the DataTable was not populated upstream.&#xA;    if ((dtBal == null || dtBal.Rows.Count == 0) &amp;&amp; !string.IsNullOrWhiteSpace(accountBalanceAndStatusReportFile) &amp;&amp; File.Exists(accountBalanceAndStatusReportFile))&#xA;    {&#xA;        System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);&#xA;        using (var stream = File.Open(accountBalanceAndStatusReportFile, FileMode.Open, FileAccess.Read))&#xA;        using (var reader = ExcelDataReader.ExcelReaderFactory.CreateReader(stream))&#xA;        {&#xA;            var ds = reader.AsDataSet(new ExcelDataReader.ExcelDataSetConfiguration&#xA;            {&#xA;                ConfigureDataTable = _ =&gt; new ExcelDataReader.ExcelDataTableConfiguration { UseHeaderRow = true }&#xA;            });&#xA;            dtBal = ds.Tables[&quot;Data sheet1&quot;] ?? (ds.Tables.Count &gt; 0 ? ds.Tables[0] : null);&#xA;        }&#xA;        dtAccountBalanceAndStatusReport = dtBal;&#xA;    }&#xA;&#xA;    if (dtBal == null || dtBal.Rows.Count == 0)&#xA;    {&#xA;        html.AppendLine(&quot;&lt;h3 style='color:#dc3545;'&gt;1. Account Balance and Status&lt;/h3&gt;&quot;);&#xA;        html.AppendLine(&quot;&lt;p style='color:#dc3545;'&gt;No Account Balance And Status Report data available for this run.&lt;/p&gt;&quot;);&#xA;    }&#xA;    else&#xA;    {&#xA;        string colCcy    = FindCol(dtBal, &quot;Wallet Currency&quot;, &quot;Currency&quot;, &quot;Account Currency&quot;);&#xA;        string colBal    = FindCol(dtBal, &quot;Closing Balance&quot;, &quot;Balance&quot;, &quot;Available Balance&quot;);&#xA;        string colStatus = FindCol(dtBal, &quot;Wallet Status&quot;, &quot;Status&quot;, &quot;Card Status&quot;, &quot;Account Status&quot;);&#xA;        string colCard   = FindCol(dtBal, &quot;Wallet Number&quot;, &quot;Card Number&quot;, &quot;Device Number&quot;, &quot;Proxy Number&quot;, &quot;Account Number&quot;, &quot;Card No&quot;, &quot;PAN&quot;, &quot;Masked PAN&quot;);&#xA;        string colName   = FindCol(dtBal, &quot;Customer Name&quot;, &quot;Card Holder Name&quot;, &quot;Cardholder Name&quot;, &quot;Account Name&quot;, &quot;Name&quot;);&#xA;&#xA;        if (colCcy == null || colBal == null)&#xA;            throw new Exception(&quot;Required columns 'Wallet Currency' / 'Closing Balance' not found in the Account Balance And Status Report.&quot;);&#xA;&#xA;        var rows = dtBal.AsEnumerable()&#xA;            .Where(r =&gt; !string.IsNullOrWhiteSpace(r[colBal] == DBNull.Value ? &quot;&quot; : r[colBal].ToString()))&#xA;            .Select(r =&gt; new&#xA;            {&#xA;                Ccy     = (r[colCcy] == DBNull.Value ? &quot;&quot; : r[colCcy].ToString()).Trim().ToUpperInvariant(),&#xA;                Balance = ParseAmount(r[colBal]),&#xA;                Status  = colStatus == null ? &quot;&quot; : (r[colStatus] == DBNull.Value ? &quot;&quot; : r[colStatus].ToString()).Trim(),&#xA;                Card    = colCard   == null ? &quot;&quot; : (r[colCard]   == DBNull.Value ? &quot;&quot; : r[colCard].ToString()).Trim(),&#xA;                Holder  = colName   == null ? &quot;&quot; : (r[colName]   == DBNull.Value ? &quot;&quot; : r[colName].ToString()).Trim()&#xA;            })&#xA;            .Where(x =&gt; !string.IsNullOrWhiteSpace(x.Ccy))&#xA;            .ToList();&#xA;&#xA;        // ---- 1a. Summary by wallet currency ----&#xA;        html.AppendLine(&quot;&lt;h3 style='color:#0056b3;margin-bottom:4px;'&gt;1. Account Balance and Status Summary&lt;/h3&gt;&quot;);&#xA;        html.AppendLine(&quot;&lt;table border='1' cellspacing='0' cellpadding='5' style='border-collapse:collapse;font-size:13px;'&gt;&quot;);&#xA;        html.AppendLine(&quot;&lt;thead style='background-color:#f2f2f2;'&gt;&lt;tr&gt;&quot;);&#xA;        html.AppendLine(&quot;&lt;th&gt;Wallet Currency&lt;/th&gt;&lt;th&gt;Accounts&lt;/th&gt;&lt;th&gt;Total Closing Balance&lt;/th&gt;&lt;th&gt;Status Breakdown&lt;/th&gt;&quot;);&#xA;        html.AppendLine(&quot;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&quot;);&#xA;&#xA;        var byCcy = rows.GroupBy(x =&gt; x.Ccy).OrderByDescending(g =&gt; g.Sum(x =&gt; x.Balance)).ToList();&#xA;&#xA;        foreach (var g in byCcy)&#xA;        {&#xA;            decimal total = g.Sum(x =&gt; x.Balance);&#xA;&#xA;            string statusText = &quot;n/a&quot;;&#xA;            if (colStatus != null)&#xA;            {&#xA;                statusText = string.Join(&quot;, &quot;, g.GroupBy(x =&gt; string.IsNullOrWhiteSpace(x.Status) ? &quot;UNKNOWN&quot; : x.Status.ToUpperInvariant())&#xA;                                                .OrderByDescending(s =&gt; s.Count())&#xA;                                                .Select(s =&gt; $&quot;{s.Key}: {s.Count():N0}&quot;));&#xA;            }&#xA;&#xA;            html.AppendLine(&quot;&lt;tr&gt;&quot;);&#xA;            html.AppendLine($&quot;&lt;td&gt;&lt;strong&gt;{Enc(g.Key)}&lt;/strong&gt;&lt;/td&gt;&quot;);&#xA;            html.AppendLine($&quot;&lt;td style='text-align:right;'&gt;{g.Count():N0}&lt;/td&gt;&quot;);&#xA;            html.AppendLine($&quot;&lt;td style='text-align:right;'&gt;{total:N2}&lt;/td&gt;&quot;);&#xA;            html.AppendLine($&quot;&lt;td&gt;{Enc(statusText)}&lt;/td&gt;&quot;);&#xA;            html.AppendLine(&quot;&lt;/tr&gt;&quot;);&#xA;        }&#xA;&#xA;        html.AppendLine(&quot;&lt;tr style='font-weight:bold;background-color:#f2f2f2;'&gt;&quot;);&#xA;        html.AppendLine(&quot;&lt;td&gt;TOTAL&lt;/td&gt;&quot;);&#xA;        html.AppendLine($&quot;&lt;td style='text-align:right;'&gt;{rows.Count:N0}&lt;/td&gt;&quot;);&#xA;        html.AppendLine($&quot;&lt;td style='text-align:right;'&gt;{rows.Sum(x =&gt; x.Balance):N2}&lt;/td&gt;&quot;);&#xA;        html.AppendLine(&quot;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&quot;);&#xA;        html.AppendLine(&quot;&lt;/tr&gt;&quot;);&#xA;        html.AppendLine(&quot;&lt;/tbody&gt;&lt;/table&gt;&quot;);&#xA;        html.AppendLine(&quot;&lt;p style='font-size:11px;color:#6c757d;'&gt;Balances are stated in each wallet's own currency and are not additive across currencies; the TOTAL row is a mixed-currency sum shown for control purposes only.&lt;/p&gt;&quot;);&#xA;&#xA;        // ---- 1b. Top 10 prepaid cards by closing balance, per currency ----&#xA;        html.AppendLine(&quot;&lt;h3 style='color:#0056b3;margin-bottom:4px;'&gt;Top 10 Prepaid Cards by Closing Balance (per currency)&lt;/h3&gt;&quot;);&#xA;&#xA;        foreach (var g in byCcy)&#xA;        {&#xA;            var top = g.OrderByDescending(x =&gt; x.Balance).Take(10).ToList();&#xA;            decimal topTotal = top.Sum(x =&gt; x.Balance);&#xA;            decimal ccyTotal = g.Sum(x =&gt; x.Balance);&#xA;            decimal share = ccyTotal == 0 ? 0 : (topTotal / ccyTotal) * 100m;&#xA;&#xA;            html.AppendLine($&quot;&lt;h4 style='margin-bottom:4px;'&gt;{Enc(g.Key)} &lt;span style='font-weight:normal;font-size:12px;color:#6c757d;'&gt;(top 10 = {topTotal:N2}, {share:N1}% of {ccyTotal:N2})&lt;/span&gt;&lt;/h4&gt;&quot;);&#xA;            html.AppendLine(&quot;&lt;table border='1' cellspacing='0' cellpadding='5' style='border-collapse:collapse;font-size:13px;'&gt;&quot;);&#xA;            html.AppendLine(&quot;&lt;thead style='background-color:#f2f2f2;'&gt;&lt;tr&gt;&quot;);&#xA;            html.AppendLine(&quot;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;Card / Wallet&lt;/th&gt;&lt;th&gt;Card Holder&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;th&gt;Closing Balance&lt;/th&gt;&quot;);&#xA;            html.AppendLine(&quot;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&quot;);&#xA;&#xA;            int rank = 1;&#xA;            foreach (var c in top)&#xA;            {&#xA;                html.AppendLine(&quot;&lt;tr&gt;&quot;);&#xA;                html.AppendLine($&quot;&lt;td style='text-align:right;'&gt;{rank}&lt;/td&gt;&quot;);&#xA;                html.AppendLine($&quot;&lt;td&gt;{Enc(MaskId(c.Card))}&lt;/td&gt;&quot;);&#xA;                html.AppendLine($&quot;&lt;td&gt;{Enc(string.IsNullOrWhiteSpace(c.Holder) ? &quot;-&quot; : c.Holder)}&lt;/td&gt;&quot;);&#xA;                html.AppendLine($&quot;&lt;td&gt;{Enc(string.IsNullOrWhiteSpace(c.Status) ? &quot;-&quot; : c.Status)}&lt;/td&gt;&quot;);&#xA;                html.AppendLine($&quot;&lt;td style='text-align:right;'&gt;{c.Balance:N2}&lt;/td&gt;&quot;);&#xA;                html.AppendLine(&quot;&lt;/tr&gt;&quot;);&#xA;                rank++;&#xA;            }&#xA;&#xA;            html.AppendLine(&quot;&lt;/tbody&gt;&lt;/table&gt;&quot;);&#xA;        }&#xA;    }&#xA;}&#xA;catch (Exception ex)&#xA;{&#xA;    html.AppendLine(&quot;&lt;h3 style='color:#dc3545;'&gt;1. Account Balance and Status&lt;/h3&gt;&quot;);&#xA;    html.AppendLine($&quot;&lt;p style='color:#dc3545;'&gt;Section failed: {Enc(ex.Message)}&lt;/p&gt;&quot;);&#xA;    Console.WriteLine(&quot;Balance section failed: &quot; + ex);&#xA;}&#xA;&#xA;// =====================================================================&#xA;// SECTION 2 - MISCELLANEOUS ADJUSTMENT CREDITS, BILLING CURRENCY &lt;&gt; BASE&#xA;// =====================================================================&#xA;try&#xA;{&#xA;    DataTable dtTxn = dtHistoricalReconTransactionsReport;&#xA;&#xA;    html.AppendLine($&quot;&lt;h3 style='color:#0056b3;margin-bottom:4px;'&gt;2. Miscellaneous Adjustment Credits - Billing Currency other than {Enc(baseCcy)}&lt;/h3&gt;&quot;);&#xA;&#xA;    if (dtTxn == null || dtTxn.Rows.Count == 0)&#xA;    {&#xA;        html.AppendLine(&quot;&lt;p style='color:#dc3545;'&gt;No Historical Recon Transactions Report data available for this run.&lt;/p&gt;&quot;);&#xA;    }&#xA;    else&#xA;    {&#xA;        string colAction    = FindCol(dtTxn, &quot;Recommended Action&quot;);&#xA;        string colTxnType   = FindCol(dtTxn, &quot;Transaction Type&quot;, &quot;Type&quot;);&#xA;        string colNarr      = FindCol(dtTxn, &quot;Narration&quot;, &quot;C_NARRATION&quot;, &quot;Description&quot;);&#xA;        string colBillCcy   = FindCol(dtTxn, &quot;Billing Currency&quot;);&#xA;        string colBillAmt   = FindCol(dtTxn, &quot;Billing Amount&quot;);&#xA;        string colRootCause = FindCol(dtTxn, &quot;Root Cause&quot;);&#xA;        string colOwner     = FindCol(dtTxn, &quot;Action Owner&quot;);&#xA;        string colAging     = FindCol(dtTxn, &quot;Aging Group&quot;, &quot;Aging&quot;);&#xA;&#xA;        // The credit column is currency suffixed in this project, e.g. &quot;Credit (TZS)&quot;.&#xA;        string colCredit = FindCol(dtTxn, &quot;Credit (&quot; + baseCcy + &quot;)&quot;, &quot;Credit&quot;);&#xA;        if (colCredit == null)&#xA;        {&#xA;            var candidate = dtTxn.Columns.Cast&lt;DataColumn&gt;()&#xA;                .FirstOrDefault(c =&gt; c.ColumnName.Trim().StartsWith(&quot;Credit&quot;, StringComparison.OrdinalIgnoreCase));&#xA;            colCredit = candidate == null ? null : candidate.ColumnName;&#xA;        }&#xA;&#xA;        if (colBillCcy == null)&#xA;            throw new Exception(&quot;Column 'Billing Currency' not found in the Historical Recon Transactions Report.&quot;);&#xA;&#xA;        var misc = dtTxn.AsEnumerable()&#xA;            .Select(r =&gt; new&#xA;            {&#xA;                Action  = colAction  == null ? &quot;&quot; : (r[colAction]  == DBNull.Value ? &quot;&quot; : r[colAction].ToString()),&#xA;                TxnType = colTxnType == null ? &quot;&quot; : (r[colTxnType] == DBNull.Value ? &quot;&quot; : r[colTxnType].ToString()),&#xA;                Narr    = colNarr    == null ? &quot;&quot; : (r[colNarr]    == DBNull.Value ? &quot;&quot; : r[colNarr].ToString()),&#xA;                BillCcy = (r[colBillCcy] == DBNull.Value ? &quot;&quot; : r[colBillCcy].ToString()).Trim().ToUpperInvariant(),&#xA;                BillAmt = colBillAmt == null ? 0m : ParseAmount(r[colBillAmt]),&#xA;                Credit  = colCredit  == null ? 0m : ParseAmount(r[colCredit]),&#xA;                Root    = colRootCause == null ? &quot;&quot; : (r[colRootCause] == DBNull.Value ? &quot;&quot; : r[colRootCause].ToString()).Trim(),&#xA;                Owner   = colOwner  == null ? &quot;&quot; : (r[colOwner]  == DBNull.Value ? &quot;&quot; : r[colOwner].ToString()).Trim(),&#xA;                Aging   = colAging  == null ? &quot;&quot; : (r[colAging]  == DBNull.Value ? &quot;&quot; : r[colAging].ToString()).Trim()&#xA;            })&#xA;            // A misc adjustment credit is flagged by the CMS transaction type (&quot;MISCELLANEOUS CREDIT&quot;,&#xA;            // the classification used when these rows are pulled into the recon report), or failing&#xA;            // that by the recommended action or the narration.&#xA;            .Where(x =&gt; x.TxnType.IndexOf(&quot;MISCELLANEOUS CREDIT&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0&#xA;                     || x.Action.IndexOf(&quot;MISC ADJUSTMENT CREDIT&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0&#xA;                     || x.Narr.IndexOf(&quot;miscellaneous credit&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0)&#xA;            // Billing currency other than the recon (base) currency; blanks are excluded.&#xA;            .Where(x =&gt; !string.IsNullOrWhiteSpace(x.BillCcy) &amp;&amp; x.BillCcy != baseCcy)&#xA;            .ToList();&#xA;&#xA;        if (misc.Count == 0)&#xA;        {&#xA;            html.AppendLine($&quot;&lt;p style='color:#28a745;'&gt;No miscellaneous adjustment credits with a billing currency other than {Enc(baseCcy)} were found.&lt;/p&gt;&quot;);&#xA;        }&#xA;        else&#xA;        {&#xA;            html.AppendLine(&quot;&lt;table border='1' cellspacing='0' cellpadding='5' style='border-collapse:collapse;font-size:13px;'&gt;&quot;);&#xA;            html.AppendLine(&quot;&lt;thead style='background-color:#f2f2f2;'&gt;&lt;tr&gt;&quot;);&#xA;            html.AppendLine($&quot;&lt;th&gt;Billing Currency&lt;/th&gt;&lt;th&gt;Items&lt;/th&gt;&lt;th&gt;Total Billing Amount&lt;/th&gt;&lt;th&gt;Total Credit ({Enc(baseCcy)})&lt;/th&gt;&lt;th&gt;Top Root Cause&lt;/th&gt;&lt;th&gt;Action Owner&lt;/th&gt;&quot;);&#xA;            html.AppendLine(&quot;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&quot;);&#xA;&#xA;            foreach (var g in misc.GroupBy(x =&gt; x.BillCcy).OrderByDescending(g2 =&gt; Math.Abs(g2.Sum(x =&gt; x.Credit))))&#xA;            {&#xA;                string topRoot = string.Join(&quot;; &quot;, g.Where(x =&gt; !string.IsNullOrWhiteSpace(x.Root))&#xA;                                                    .GroupBy(x =&gt; x.Root)&#xA;                                                    .OrderByDescending(s =&gt; s.Count())&#xA;                                                    .Take(2)&#xA;                                                    .Select(s =&gt; $&quot;{s.Key} ({s.Count():N0})&quot;));&#xA;                string owners = string.Join(&quot;, &quot;, g.Where(x =&gt; !string.IsNullOrWhiteSpace(x.Owner))&#xA;                                                   .Select(x =&gt; x.Owner).Distinct().Take(3));&#xA;&#xA;                html.AppendLine(&quot;&lt;tr&gt;&quot;);&#xA;                html.AppendLine($&quot;&lt;td&gt;&lt;strong&gt;{Enc(g.Key)}&lt;/strong&gt;&lt;/td&gt;&quot;);&#xA;                html.AppendLine($&quot;&lt;td style='text-align:right;'&gt;{g.Count():N0}&lt;/td&gt;&quot;);&#xA;                html.AppendLine($&quot;&lt;td style='text-align:right;'&gt;{g.Sum(x =&gt; x.BillAmt):N2}&lt;/td&gt;&quot;);&#xA;                html.AppendLine($&quot;&lt;td style='text-align:right;'&gt;{g.Sum(x =&gt; x.Credit):N2}&lt;/td&gt;&quot;);&#xA;                html.AppendLine($&quot;&lt;td&gt;{Enc(string.IsNullOrWhiteSpace(topRoot) ? &quot;-&quot; : topRoot)}&lt;/td&gt;&quot;);&#xA;                html.AppendLine($&quot;&lt;td&gt;{Enc(string.IsNullOrWhiteSpace(owners) ? &quot;-&quot; : owners)}&lt;/td&gt;&quot;);&#xA;                html.AppendLine(&quot;&lt;/tr&gt;&quot;);&#xA;            }&#xA;&#xA;            html.AppendLine(&quot;&lt;tr style='font-weight:bold;background-color:#f2f2f2;'&gt;&quot;);&#xA;            html.AppendLine(&quot;&lt;td&gt;TOTAL&lt;/td&gt;&quot;);&#xA;            html.AppendLine($&quot;&lt;td style='text-align:right;'&gt;{misc.Count:N0}&lt;/td&gt;&quot;);&#xA;            html.AppendLine($&quot;&lt;td style='text-align:right;'&gt;{misc.Sum(x =&gt; x.BillAmt):N2}&lt;/td&gt;&quot;);&#xA;            html.AppendLine($&quot;&lt;td
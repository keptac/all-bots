        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: CMS income/fee/levy tagging (no cash-advance logic) =====&#xA;// Args (In): reconDate (string)  // not used&#xA;// Args (In/Out): dtHistoricalReconTransactionsReport (DataTable)&#xA;&#xA;&#xA;/////////////////////// Helpers ///////////////////////&#xA;&#xA;bool HasCol(System.Data.DataTable dt, string name) =&gt; dt != null &amp;&amp; dt.Columns.Contains(name);&#xA;&#xA;void EnsureTextCol(System.Data.DataTable dt, string name)&#xA;{&#xA;    if (!dt.Columns.Contains(name))&#xA;        dt.Columns.Add(new System.Data.DataColumn(name, typeof(string)) { DefaultValue = &quot;&quot; });&#xA;}&#xA;&#xA;string NormalizeTxnType(string s)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(s)) return &quot;&quot;;&#xA;    return System.Text.RegularExpressions.Regex.Replace(&#xA;        s.Trim().ToLowerInvariant(),&#xA;        @&quot;\s+&quot;,&#xA;        &quot; &quot;&#xA;    );&#xA;}&#xA;&#xA;// Whole-word income keyword checker (similar to narration logic)&#xA;string[] incomeKeywords = new[]&#xA;{&#xA;    &quot;transaction fee&quot;,   // phrase&#xA;    &quot;tax on income&quot;,     // phrase&#xA;    &quot;income&quot;,&#xA;    &quot;fee&quot;,&#xA;    &quot;fees&quot;,&#xA;    &quot;levy&quot;&#xA;};&#xA;&#xA;bool ContainsIncomeKeyword(string text)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(text))&#xA;        return false;&#xA;&#xA;    foreach (var kw in incomeKeywords)&#xA;    {&#xA;        if (string.IsNullOrWhiteSpace(kw))&#xA;            continue;&#xA;&#xA;        // Multi-word phrases: simple substring check is fine on normalized text&#xA;        if (kw.Contains(&quot; &quot;))&#xA;        {&#xA;            if (text.Contains(kw))&#xA;                return true;&#xA;        }&#xA;        else&#xA;        {&#xA;            // Single-word keywords must be whole words, not embedded in codes (e.g. FEEDFZ)&#xA;            var pattern = $@&quot;\b{System.Text.RegularExpressions.Regex.Escape(kw)}\b&quot;;&#xA;            if (System.Text.RegularExpressions.Regex.IsMatch(text, pattern))&#xA;                return true;&#xA;        }&#xA;    }&#xA;&#xA;    return false;&#xA;}&#xA;&#xA;/////////////////////// Ensure output cols ///////////////////////&#xA;&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;Root Cause&quot;);&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;Root Cause Category&quot;);&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;Recommended Action&quot;);&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;Action Owner&quot;);&#xA;&#xA;// NEW COLUMN for processed flags&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;ROOT_CAUSE_PROCESSED&quot;);&#xA;&#xA;/////////////////////// Tag income/fee/levy for CMS new (no channel filter) ///////////////////////&#xA;&#xA;int tagged = 0;&#xA;&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string source  = HasCol(dtHistoricalReconTransactionsReport, &quot;Source&quot;)  ? (row[&quot;Source&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;    string type    = HasCol(dtHistoricalReconTransactionsReport, &quot;Type&quot;)    ? (row[&quot;Type&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;    string txnType = HasCol(dtHistoricalReconTransactionsReport, &quot;Transaction Type&quot;) ? (row[&quot;Transaction Type&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;&#xA;    // Only CMS &quot;new&quot;&#xA;    if (!(source.Equals(&quot;CMS&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;          type.Equals(&quot;new&quot;, StringComparison.OrdinalIgnoreCase)))&#xA;        continue;&#xA;&#xA;    // Don't overwrite if already tagged&#xA;    if (!string.IsNullOrEmpty(row[&quot;Root Cause&quot;]?.ToString()))&#xA;        continue;&#xA;&#xA;    string normalizedTxnType = NormalizeTxnType(txnType);&#xA;&#xA;    // Tag if matches income/fee/levy as whole words&#xA;    if (ContainsIncomeKeyword(normalizedTxnType))&#xA;    {&#xA;        row[&quot;Root Cause&quot;] = &quot;Prepaid Card Income updated on CMS only&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Post the income manually&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Finance&quot;;&#xA;&#xA;        // Mark as processed&#xA;        row[&quot;ROOT_CAUSE_PROCESSED&quot;] = &quot;TRUE&quot;;&#xA;&#xA;        tagged++;&#xA;    }&#xA;}&#xA;&#xA;// Summary only&#xA;System.Console.WriteLine($&quot;CMS income/fee/levy tagging complete. Tagged rows: {tagged} (ROOT_CAUSE_PROCESSED=TRUE).&quot;);&#xA;// End&#xA;" DisplayName="Income, fees, levy and Channel == API" sap:VirtualizedContainerService.HintSize="450,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_102" Language="CSharp">

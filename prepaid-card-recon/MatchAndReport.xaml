              <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code =====&#xA;// Only rows where Source == &quot;CMS&quot; AND Type == &quot;new&quot;&#xA;// Guarantees non-null defaults for Root Cause, Root Cause Category, Recommended Action, Action Owner,&#xA;// but does NOT override if a value already exists. No local functions or lambdas.&#xA;&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport));&#xA;&#xA;// Ensure required columns (types aligned)&#xA;string[] needStringCols = new[]&#xA;{&#xA;    &quot;Aging&quot;,&quot;Aging Group&quot;,&quot;BOT Classification&quot;,&#xA;    &quot;Recommended Action&quot;,&quot;Root Cause&quot;,&quot;Root Cause Category&quot;,&quot;Action Owner&quot;,&#xA;    &quot;Billing Amount&quot;,&quot;Billing Currency&quot;,&quot;Transaction Currency&quot;,&quot;Transaction Amount&quot;,&#xA;    &quot;Settlement Currency&quot;,&quot;Settlement Amount&quot;,&quot;Narration&quot;,&quot;Channel&quot;,&quot;Type&quot;,&quot;Source&quot;&#xA;};&#xA;for (int i = 0; i &lt; needStringCols.Length; i++)&#xA;{&#xA;    string c = needStringCols[i];&#xA;    if (!dtHistoricalReconTransactionsReport.Columns.Contains(c))&#xA;        dtHistoricalReconTransactionsReport.Columns.Add(c, typeof(string));&#xA;}&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;FOREIGN_CURRENCY&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;FOREIGN_CURRENCY&quot;, typeof(bool));&#xA;&#xA;// Normalize recon currency once (lower, single spaces)&#xA;string reconCurrencyNormalized;&#xA;{&#xA;    string s = reconCurrency == null ? &quot;&quot; : reconCurrency.Trim();&#xA;    s = System.Text.RegularExpressions.Regex.Replace(s, @&quot;\s+&quot;, &quot; &quot;);&#xA;    reconCurrencyNormalized = s.ToLowerInvariant();&#xA;}&#xA;&#xA;// Pre-compile extractors (no local funcs)&#xA;var panRegex = new System.Text.RegularExpressions.Regex(@&quot;\b\d{6}X{6}\d{4}\b&quot;, System.Text.RegularExpressions.RegexOptions.Compiled);&#xA;var rrnRegex = new System.Text.RegularExpressions.Regex(@&quot;\b[A-Za-z0-9]{12}\b&quot;, System.Text.RegularExpressions.RegexOptions.Compiled);&#xA;&#xA;// Excel row index for formulas (processed rows only)&#xA;int reportRowNumber = 2;&#xA;&#xA;// Catch-all defaults&#xA;const string DEF_RC   = &quot;Remote-on-us transaction not yet posted&quot;;&#xA;const string DEF_RCAT = &quot;System&quot;;&#xA;const string DEF_ACT  = &quot;Load pending auth dump files&quot;;&#xA;const string DEF_OWN  = &quot;ICT&quot;;&#xA;&#xA;// Pre-pass: index principal Cash Advance rows once (PAN|RRN) instead of rescanning the whole table per row&#xA;var principalIndex = new System.Collections.Generic.HashSet&lt;string&gt;(System.StringComparer.Ordinal);&#xA;foreach (System.Data.DataRow pr in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string pSrc = pr.Table.Columns.Contains(&quot;Source&quot;) &amp;&amp; pr[&quot;Source&quot;] != System.DBNull.Value ? pr[&quot;Source&quot;].ToString().Trim().ToUpperInvariant() : &quot;&quot;;&#xA;    string pTyp = pr.Table.Columns.Contains(&quot;Type&quot;) &amp;&amp; pr[&quot;Type&quot;] != System.DBNull.Value ? System.Text.RegularExpressions.Regex.Replace(pr[&quot;Type&quot;].ToString().Trim(), @&quot;\s+&quot;, &quot; &quot;).ToLowerInvariant() : &quot;&quot;;&#xA;    if (!(pSrc == &quot;CMS&quot; &amp;&amp; pTyp == &quot;new&quot;)) continue;&#xA;&#xA;    string pNarr = pr[&quot;Narration&quot;] == System.DBNull.Value ? &quot;&quot; : pr[&quot;Narration&quot;].ToString();&#xA;    string pNorm = System.Text.RegularExpressions.Regex.Replace(pNarr.Trim().ToLowerInvariant(), @&quot;\s+&quot;, &quot; &quot;);&#xA;    if (!pNorm.StartsWith(&quot;cash advance/ cash at pos / cash out&quot;, System.StringComparison.Ordinal)) continue;&#xA;&#xA;    var pPan = panRegex.Match(pNarr);&#xA;    var pRrn = rrnRegex.Match(pNarr);&#xA;    if (pPan.Success &amp;&amp; pRrn.Success)&#xA;        principalIndex.Add(pPan.Value + &quot;|&quot; + pRrn.Value.ToUpperInvariant());&#xA;}&#xA;&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    // Read Source/Type safely&#xA;    string sourceVal = &quot;&quot;;&#xA;    if (dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Source&quot;) &amp;&amp; row[&quot;Source&quot;] != System.DBNull.Value)&#xA;        sourceVal = row[&quot;Source&quot;].ToString().Trim().ToUpperInvariant();&#xA;&#xA;    string typeVal = &quot;&quot;;&#xA;    if (dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Type&quot;) &amp;&amp; row[&quot;Type&quot;] != System.DBNull.Value)&#xA;    {&#xA;        typeVal = row[&quot;Type&quot;].ToString().Trim();&#xA;        typeVal = System.Text.RegularExpressions.Regex.Replace(typeVal, @&quot;\s+&quot;, &quot; &quot;).ToLowerInvariant();&#xA;    }&#xA;&#xA;    if (!(sourceVal == &quot;CMS&quot; &amp;&amp; typeVal == &quot;new&quot;))&#xA;        continue;&#xA;&#xA;    // Pull fields (safe)&#xA;    string narration = row[&quot;Narration&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Narration&quot;].ToString();&#xA;    string normalizedNarr = narration.Trim();&#xA;    normalizedNarr = System.Text.RegularExpressions.Regex.Replace(normalizedNarr, @&quot;\s+&quot;, &quot; &quot;).ToLowerInvariant();&#xA;&#xA;    string channelUpper = row[&quot;Channel&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Channel&quot;].ToString().Trim().ToUpperInvariant();&#xA;&#xA;    string billingCurrency = row[&quot;Billing Currency&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Billing Currency&quot;].ToString().Trim().ToUpperInvariant();&#xA;    string billingCurrencyNormalized = System.Text.RegularExpressions.Regex.Replace(billingCurrency, @&quot;\s+&quot;, &quot; &quot;).ToLowerInvariant();&#xA;&#xA;    string billingAmount = row[&quot;Billing Amount&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Billing Amount&quot;].ToString().Trim();&#xA;    string transactionCurrency = row[&quot;Transaction Currency&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Transaction Currency&quot;].ToString().Trim().ToUpperInvariant();&#xA;    string transactionAmount = row[&quot;Transaction Amount&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Transaction Amount&quot;].ToString().Trim();&#xA;    string settlementCurrency = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Settlement Currency&quot;) &amp;&amp; row[&quot;Settlement Currency&quot;] != System.DBNull.Value&#xA;        ? row[&quot;Settlement Currency&quot;].ToString().Trim().ToUpperInvariant() : &quot;&quot;;&#xA;    string settlementAmount = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Settlement Amount&quot;) &amp;&amp; row[&quot;Settlement Amount&quot;] != System.DBNull.Value&#xA;        ? row[&quot;Settlement Amount&quot;].ToString().Trim() : &quot;&quot;;&#xA;&#xA;    // Extract PAN/RRN keys (STRICTLY from Narration)&#xA;    string narrationForKey = narration ?? &quot;&quot;;&#xA;    var panMatch = panRegex.Match(narrationForKey);&#xA;    string panKey = panMatch.Success ? panMatch.Value : &quot;&quot;;&#xA;    var rrnMatch = rrnRegex.Match(narrationForKey);&#xA;    string rrnKey = rrnMatch.Success ? rrnMatch.Value.ToUpperInvariant() : &quot;&quot;;&#xA;&#xA;    // Formulas&#xA;    row[&quot;Aging&quot;] = &quot;=$H$6-G&quot; + reportRowNumber;&#xA;    row[&quot;Aging Group&quot;] = &quot;=IF(L&quot; + reportRowNumber + &quot;&lt;4,\&quot;0-3 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;31,\&quot;4-30 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;61,\&quot;31-60 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;=90,\&quot;61-90 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;    row[&quot;BOT Classification&quot;] = &quot;=IF(J&quot; + reportRowNumber + &quot;&gt;0,IF(L&quot; + reportRowNumber
        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: PPSP exchange gain/loss (GL ↔ HIST) — GROUP BY RRN + C_PAN ====&#xA;// Args (In):     string reconCurrency&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport, DataTable dtHistoricalReconTransactionsReportMatched&#xA;// Args (Out):    decimal exchangeGainOrLossPPSP1&#xA;//&#xA;// Behavior:&#xA;// - GL side filter: &quot;Transaction Ref No:&quot; must contain &quot;PPSP&quot;&#xA;// - HIST side filter: Root Cause == &quot;Remote-on-us transaction not yet posted&quot;, exclude fee/tax/income/levy narrations&#xA;// - Matching key: composite (RRN + C_PAN) where:&#xA;//     • RRN  = 12-char alphanumeric, extracted STRICTLY from Narration&#xA;//     • C_PAN = 550558XXXXXX + last 4 of the 550558* word from Narration&#xA;// - STRICT: if RRN is missing OR C_PAN is missing on either side, that row does NOT participate in matching.&#xA;// - On match: import the GL row and all HIST rows in that composite key group to Matched,&#xA;//             remove them from working table (by reference)&#xA;// - Totals logged and Δ identity checked: BEFORE ≈ AFTER + exchangeGainOrLossPPSP1 (within tolerance)&#xA;&#xA;var sw = System.Diagnostics.Stopwatch.StartNew();&#xA;System.Console.WriteLine($&quot;🚀 PPSP exchange gain/loss (GL ↔ HIST | Group by RRN + C_PAN) started at {System.DateTime.Now:yyyy-MM-dd HH:mm:ss}&quot;);&#xA;&#xA;// ===== Guards &amp; setup =====&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport), &quot;Input DataTable cannot be null&quot;);&#xA;&#xA;if (dtHistoricalReconTransactionsReportMatched == null ||&#xA;    dtHistoricalReconTransactionsReportMatched.Columns.Count != dtHistoricalReconTransactionsReport.Columns.Count)&#xA;{&#xA;    dtHistoricalReconTransactionsReportMatched = dtHistoricalReconTransactionsReport.Clone();&#xA;}&#xA;&#xA;string currency = reconCurrency ?? &quot;&quot;;&#xA;string colDebit  = $&quot;Debit ({currency})&quot;;&#xA;string colCredit = $&quot;Credit ({currency})&quot;;&#xA;&#xA;bool hasNarration  = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Narration&quot;);&#xA;bool hasTrnRef     = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Transaction Ref No:&quot;);&#xA;bool hasDebit      = dtHistoricalReconTransactionsReport.Columns.Contains(colDebit);&#xA;bool hasCredit     = dtHistoricalReconTransactionsReport.Columns.Contains(colCredit);&#xA;bool hasRootCause  = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Root Cause&quot;);&#xA;bool hasCPANCol    = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;C_PAN&quot;);&#xA;bool hasRRNCol     = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;RRN&quot;);&#xA;&#xA;// Legacy guard DISABLED — we now rely on Narration + 550558 rule + strict RRN&#xA;bool enforcePanRrnPresence = false;&#xA;&#xA;// Ensure Classification exists on both tables&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Classification&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Classification&quot;))&#xA;    dtHistoricalReconTransactionsReportMatched.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;&#xA;if (!hasNarration) System.Console.WriteLine(&quot;⚠️ Missing column: Narration&quot;);&#xA;if (!hasTrnRef)    System.Console.WriteLine(&quot;⚠️ Missing column: Transaction Ref No:&quot;);&#xA;if (!hasDebit)     System.Console.WriteLine($&quot;⚠️ Missing column: {colDebit}&quot;);&#xA;if (!hasCredit)    System.Console.WriteLine($&quot;⚠️ Missing column: {colCredit}&quot;);&#xA;if (!hasRootCause) System.Console.WriteLine(&quot;⚠️ Missing column: Root Cause (needed for HIST filtering)&quot;);&#xA;if (!hasCPANCol)   System.Console.WriteLine(&quot;ℹ️ Optional column not present: C_PAN&quot;);&#xA;if (!hasRRNCol)    System.Console.WriteLine(&quot;ℹ️ Optional column not present: RRN&quot;);&#xA;&#xA;// ===== Helpers =====&#xA;string S(object o) =&gt; (o == null || o == DBNull.Value) ? &quot;&quot; : o.ToString();&#xA;string T(object o) =&gt; S(o).Trim();&#xA;string U(string s) =&gt; (s ?? &quot;&quot;).ToUpperInvariant();&#xA;&#xA;decimal ParseAmount(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return 0m;&#xA;    string s = val.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;);&#xA;    if (s.Length == 0) return 0m;&#xA;    if (s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;)) s = &quot;-&quot; + s.Substring(1, s.Length - 2);&#xA;    return decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0m;&#xA;}&#xA;&#xA;// ❗ All fee / tax / income tokens must be exact whole words/phrases&#xA;bool HasFeeOrIncomeTokens(string narrationUpper)&#xA;{&#xA;    if (string.IsNullOrEmpty(narrationUpper))&#xA;        return false;&#xA;&#xA;    // Whole word: FEE or FEES&#xA;    if (System.Text.RegularExpressions.Regex.IsMatch(&#xA;            narrationUpper,&#xA;            @&quot;\bFEE(S)?\b&quot;,&#xA;            System.Text.RegularExpressions.RegexOptions.IgnoreCase))&#xA;        return true;&#xA;&#xA;    // Whole word: LEVY&#xA;    if (System.Text.RegularExpressions.Regex.IsMatch(&#xA;            narrationUpper,&#xA;            @&quot;\bLEVY\b&quot;,&#xA;            System.Text.RegularExpressions.RegexOptions.IgnoreCase))&#xA;        return true;&#xA;&#xA;    // Whole phrase: SERVICE TAX&#xA;    if (System.Text.RegularExpressions.Regex.IsMatch(&#xA;            narrationUpper,&#xA;            @&quot;\bSERVICE\s+TAX\b&quot;,&#xA;            System.Text.RegularExpressions.RegexOptions.IgnoreCase))&#xA;        return true;&#xA;&#xA;    // Whole phrase: TAX ON INCOME&#xA;    if (System.Text.RegularExpressions.Regex.IsMatch(&#xA;            narrationUpper,&#xA;            @&quot;\bTAX\s+ON\s+INCOME\b&quot;,&#xA;            System.Text.RegularExpressions.RegexOptions.IgnoreCase))&#xA;        return true;&#xA;&#xA;    // Whole word: INCOME&#xA;    if (System.Text.RegularExpressions.Regex.IsMatch(&#xA;            narrationUpper,&#xA;            @&quot;\bINCOME\b&quot;,&#xA;            System.Text.RegularExpressions.RegexOptions.IgnoreCase))&#xA;        return true;&#xA;&#xA;    return false;&#xA;}&#xA;&#xA;// STRICT C_PAN rule: find the word starting with 550558 and ending with 4 digits,&#xA;// then return 550558XXXXXX + last4.&#xA;string ExtractCpanFromNarration(string narration)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(narration)) return &quot;&quot;;&#xA;&#xA;    var m = System.Text.RegularExpressions.Regex.Match(&#xA;        narration,&#xA;        @&quot;\b(550558)[0-9Xx\*]{0,10}(\d{4})\b&quot;,&#xA;        System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;&#xA;    if (!m.Success) return &quot;&quot;;&#xA;&#xA;    string first6 = m.Groups[1].Value;   // 550558&#xA;    string last4  = m.Groups[2].Value;   // e.g. 7179&#xA;    return first6 + &quot;XXXXXX&quot; + last4;    // 550558XXXXXX7179&#xA;}&#xA;&#xA;// Normalize PAN to 6 + XXXXXX + 4 when possible (generic helper; used in PAN/RRN extractor)&#xA;string NormalizePan(string pan)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(pan)) return &quot;&quot;;&#xA;    var m = System.Text.RegularExpressions.Regex.Match(&#xA;        pan, @&quot;\b(\d{6})[0-9Xx\*]{0,6}(\d{4})\b&quot;,&#xA;        System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;    return m.Success ? (m.Groups[1].Value + &quot;XXXXXX&quot; + m.Groups[2].Value) : pan;&#xA;}&#xA;&#xA;// RRN normalizer: keep only alphanumerics, uppercase, require exact length 12&#xA;string NormalizeRrn(string s)&#xA;{&#xA;    if (string.IsNullOrEmpty(s)) return &quot;&quot;;&#xA;    var chars = new System.Text.StringBuilder(s.Length);&#xA;    for (int i = 0; i &lt; s.Length; i++)&#xA;    {&#xA;        char ch = s[i];&#xA;        if (char.IsLetterOrDigit(ch)) chars.Append(ch);&#xA;    }&#xA;    var cleaned = chars.ToString().ToUpperInvariant();&#xA;    return cleaned.Length == 12 ? cleaned : &quot;&quot;;&#xA;}&#xA;&#xA;// Extract PAN+RRN from Narration ONLY — RRN must be exactly 12 alphanumerics&#xA;bool TryExtractPanRrnFromNarration(string narration, out string pan, out string rrn)&#xA;{&#xA;    pan = &quot;&quot;; rrn = &quot;&quot;;&#xA;    if (string.IsNullOrWhiteSpace(narration)) return false;&#xA;&#xA;    // PAN (masked or plain 16)&#xA;    var panMatch = System.Text.RegularExpressions.Regex.Match(&#xA;        narration,&#xA;        @&quot;\b\d{6}(?:\*{2,12}|X{2,12})\d{4}\b&quot;,&#xA;        System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;    if (panMatch.Success) pan = panMatch.Value;&#xA;    else&#xA;    {&#xA;        var p16 = System.Text.RegularExpressions.Regex.Match(&#xA;            narration,&#xA;            @&quot;\b\d{16}\b&quot;,&#xA;            System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;        if (p16.Success) pan = p16.Value;&#xA;    }&#xA;&#xA;    // RRN: exactly 12 alphanumerics (case-insensitive)&#xA;    var rrnMatch = System.Text.RegularExpressions.Regex.Match(&#xA;        narration,&#xA;        @&quot;\b[A-Za-z0-9]{12}\b&quot;,&#xA;        System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;    if (rrnMatch.Success) rrn = rrnMatch.Value;&#xA;&#xA;    pan = NormalizePan(pan);&#xA;    rrn = NormalizeRrn(rrn);&#xA;&#xA;    // We use RRN from here and PAN from strict 550558 extractor; but we still require RRN to exist.&#xA;    return !string.IsNullOrEmpty(rrn);&#xA;}&#xA;&#xA;bool IsHistEligible(System.Data.DataRow r)&#xA;{&#xA;    if (!hasRootCause) return false;&#xA;    if (!string.Equals(T(r[&quot;Root Cause&quot;]), &quot;Remote-on-us transaction not yet posted&quot;, StringComparison.OrdinalIgnoreCase)) return false;&#xA;    if (HasFeeOrIncomeTokens(U(T(r[&quot;Narration&quot;])))) return false;&#xA;    return true;&#xA;}&#xA;&#xA;decimal PrincipalAmount(System.Data.DataRow r)&#xA;{&#xA;    decimal cr = hasCredit ? ParseAmount(r[colCredit]) : 0m;&#xA;    decimal dr = hasDebit  ? ParseAmount(r[colDebit])  : 0m;&#xA;    return (cr &gt; 0m) ? cr : (dr &gt; 0m ? dr : 0m);&#xA;}&#xA;&#xA;void SumTable(System.Data.DataTable dt, out decimal d, out decimal c)&#xA;{&#xA;    d = 0m; c = 0m;&#xA;    for (int i = 0; i &lt; dt.Rows.Count; i++)&#xA;    {&#xA;        d += hasDebit ? ParseAmount(dt.Rows[i][colDebit]) : 0m;&#xA;        c += hasCredit ? ParseAmount(dt.Rows[i][colCredit]) : 0m;&#xA;    }&#xA;}&#xA;&#xA;// Composite key builder: STRICT — require both RRN and C_PAN.&#xA;// If either is missing/blank, return &quot;&quot; (row does NOT participate).&#xA;string BuildKey(string rrn, string cpan)&#xA;{&#xA;    rrn  = (rrn  ?? &quot;&quot;).Trim().ToUpperInvariant();&#xA;    cpan = (cpan ?? &quot;&quot;).Trim().ToUpperInvariant();&#xA;    if (string.IsNullOrEmpty(rrn) || string.IsNullOrEmpty(cpan))&#xA;        return &quot;&quot;;&#xA;    return rrn + &quot;|&quot; + cpan;&#xA;}&#xA;&#xA;decimal balanceTol = 0.01m;&#xA;&#xA;// ===== BEFORE totals =====&#xA;SumTable(dtHistoricalReconTransactionsReport, out var beforeDebit, out var beforeCredit);&#xA;var beforeDiff = beforeDebit - beforeCredit;&#xA;System.Console.WriteLine($&quot;[BAL] BEFORE — Debit ({currency}): {beforeDebit:N2}, Credit ({currency}): {beforeCredit:N2}, Δ(D−C): {beforeDiff:N2}&quot;);&#xA;&#xA;// ===== Build HIST groups by composite key (RRN + C_PAN) from Narration only =====&#xA;var histGroups = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;(StringComparer.OrdinalIgnoreCase);&#xA;int histGroupKeys = 0;&#xA;&#xA;if (hasNarration)&#xA;{&#xA;    for (int r = 0; r &lt; dtHistoricalReconTransactionsReport.Rows.Count; r++)&#xA;    {&#xA;        var row = dtHistoricalReconTransactionsReport.Rows[r];&#xA;        if (!IsHistEligible(row)) continue;&#xA;&#xA;        if (!TryExtractPanRrnFromNarration(T(row[&quot;Narration&quot;]), out var panN, out var rrnN)) continue;&#xA;        if (string.IsNullOrEmpty(rrnN)) continue; // require RRN for grouping&#xA;&#xA;        // FORCE: HIST C_PAN from 550558 rule&#xA;        string histCpan = &quot;&quot;;&#xA;        if (hasCPANCol)&#xA;        {&#xA;            histCpan = ExtractCpanFromNarration(T(row[&quot;Narration&quot;]));&#xA;            if (!string.IsNullOrEmpty(histCpan))&#xA;                row[&quot;C_PAN&quot;] = histCpan;&#xA;            else&#xA;                histCpan = T(row[&quot;C_PAN&quot;]); // fallback if something already there&#xA;        }&#xA;&#xA;        // STRICT: C_PAN must exist&#xA;        if (string.IsNullOrEmpty(histCpan)) continue;&#xA;&#xA;        // FORCE: HIST RRN column as normalized RRN&#xA;        if (hasRRNCol &amp;&amp; !string.IsNullOrEmpty(rrnN))&#xA;            row[&quot;RRN&quot;] = rrnN;&#xA;&#xA;        decimal principal = PrincipalAmount(row);&#xA;        if (principal &lt;= 0m) continue;&#xA;&#xA;        string key = BuildKey(rrnN, histCpan);&#xA;        if (string.IsNullOrEmpty(key)) continue; // extra safety&#xA;&#xA;        if (!histGroups.TryGetValue(key, out var list))&#xA;        {&#xA;            list = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;            histGroups[key] = list;&#xA;            histGroupKeys++;&#xA;        }&#xA;        list.Add(row);&#xA;    }&#xA;}&#xA;System.Console.WriteLine($&quot;📦 HIST composite groups ready (RC='Remote-on-us ...', STRICT RRN + C_PAN): {histGroupKeys} keys.&quot;);&#xA;&#xA;// ===== Match &amp; MOVE (1 GL → many HIST within same composite key) =====&#xA;int glSeen = 0, glMatched = 0, glNoHist = 0, movedPairs = 0, glSkippedNoRrnOrPan = 0;&#xA;decimal sumGlPrincipal = 0m, sumHistPrincipal = 0m;&#xA;decimal removedDebit = 0m, removedCredit = 0m;&#xA;&#xA;var unmatched = new System.Collections.Generic.List&lt;string&gt;();&#xA;var skippedMissingRrn = new System.Collections.Generic.List&lt;string&gt;();&#xA;&#xA;// We remove rows AFTER the loop to be index-safe&#xA;var rowsToRemove = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var gl = dtHistoricalReconTransactionsReport.Rows[i];&#xA;&#xA;    if (!hasTrnRef || !hasNarration) continue;&#xA;&#xA;    string trn = T(gl[&quot;Transaction Ref No:&quot;]);&#xA;    if (trn.IndexOf(&quot;PPSP&quot;, StringComparison.OrdinalIgnoreCase) &lt; 0 &amp;&amp; trn.IndexOf(&quot;ADPP&quot;, StringComparison.OrdinalIgnoreCase) &lt; 0) continue; // GL PPSP/ADPP only&#xA;    glSeen++;&#xA;&#xA;    string glNarr = T(gl[&quot;Narration&quot;]);&#xA;&#xA;    if (!TryExtractPanRrnFromNarration(glNarr, out var glPanRaw, out var glRrn))&#xA;    {&#xA;        glSkippedNoRrnOrPan++;&#xA;        if (skippedMissingRrn.Count &lt; 20)&#xA;            skippedMissingRrn.Add($&quot;TRN={trn}, PAN=&lt;from narration={glPanRaw}&gt;, RRN=&lt;missing&gt;&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    // STRICT: RRN must exist (already enforced by TryExtractPanRrnFromNarration),&#xA;    // now enforce strict C_PAN.&#xA;    string glCpan = &quot;&quot;;&#xA;    if (hasCPANCol)&#xA;    {&#xA;        glCpan = ExtractCpanFromNarration(glNarr);&#xA;        if (!string.IsNullOrEmpty(glCpan))&#xA;            gl[&quot;C_PAN&quot;] = glCpan;&#xA;        else&#xA;            glCpan = T(gl[&quot;C_PAN&quot;]);&#xA;    }&#xA;&#xA;    if (string.IsNullOrEmpty(glCpan))&#xA;    {&#xA;        glSkippedNoRrnOrPan++;&#xA;        if (skippedMissingRrn.Count &lt; 20)&#xA;            skippedMissingRrn.Add($&quot;TRN={trn}, RRN={glRrn}, C_PAN=&lt;missing strict 550558 token&gt;&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    // FORCE: GL RRN column&#xA;    if (hasRRNCol &amp;&amp; !string.IsNullOrEmpty(glRrn))&#xA;        gl[&quot;RRN&quot;] = glRrn;&#xA;&#xA;    string compositeKey = BuildKey(glRrn, glCpan);&#xA;    if (string.IsNullOrEmpty(compositeKey))&#xA;    {&#xA;        glSkippedNoRrnOrPan++;&#xA;        if (skippedMissingRrn.Count &lt; 20)&#xA;            skippedMissingRrn.Add($&quot;TRN={trn}, RRN={glRrn}, C_PAN={glCpan}, KEY=&lt;empty&gt;&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    System.Console.WriteLine($&quot;🔎 GL PPSP candidate: TRN={trn}, KEY={compositeKey}&quot;);&#xA;&#xA;    decimal glDebit  = hasDebit  ? ParseAmount(gl[colDebit])  : 0m;&#xA;    decimal glCredit = hasCredit ? ParseAmount(gl[colCredit]) : 0m;&#xA;    decimal glPrincipal = (glDebit &gt; 0m) ? glDebit : (glCredit &gt; 0m ? glCredit : 0m);&#xA;    if (glPrincipal &lt;= 0m)&#xA;    {&#xA;        System.Console.WriteLine($&quot;⚠️ GL PPSP zero principal — TRN={trn}, RRN={glRrn}, C_PAN={glCpan}&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    // Match by composite key (RRN + C_PAN)&#xA;    if (!histGroups.TryGetValue(compositeKey, out var histList) || histList == null || histList.Count == 0)&#xA;    {&#xA;        glNoHist++;&#xA;        if (unmatched.Count &lt; 20) unmatched.Add($&quot;KEY={compositeKey}, GL={glPrincipal:N2}, TRN={trn}&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    // Sum HIST group principals and Δ for accurate gain/loss&#xA;    decimal groupHistPrincipal = 0m;&#xA;    decimal groupHistDebit = 0m, groupHistCredit = 0m;&#xA;    foreach (var hist in histList)&#xA;    {&#xA;        groupHistPrincipal += PrincipalAmount(hist);&#xA;        groupHistDebit  += hasDebit  ? ParseAmount(hist[colDebit])  : 0m;&#xA;        groupHistCredit += hasCredit ? ParseAmount(hist[colCredit]) : 0m;&#xA;    }&#xA;&#xA;    // Net Δ removed for this key = (GL D−C) + Σ(HIST D−C)&#xA;    decimal pairNet = (glDebit - glCredit) + (groupHistDebit - groupHistCredit);&#xA;&#xA;    // Mark classification BEFORE importing&#xA;    gl[&quot;Classification&quot;] = &quot;PPSP&quot;;&#xA;    foreach (var hist in histList) hist[&quot;Classification&quot;] = &quot;PPSP&quot;;&#xA;&#xA;    // Accumulate removed totals (authoritative Δ)&#xA;    removedDebit  += glDebit + groupHistDebit;&#xA;    removedCredit += glCredit + groupHistCredit;&#xA;&#xA;    sumGlPrincipal   += glPrincipal;&#xA;    sumHistPrincipal += groupHistPrincipal;&#xA;    glMatched++;&#xA;    movedPairs++;&#xA;&#xA;    // Import GL + all HIST rows into Matched&#xA;    dtHistoricalReconTransactionsReportMatched.ImportRow(gl);&#xA;    foreach (var hist in histList)&#xA;        dtHistoricalReconTransactionsReportMatched.ImportRow(hist);&#xA;&#xA;    // Schedule removals (by reference, index-safe) and consume the composite group&#xA;    rowsToRemove.Add(gl);&#xA;    foreach (var hist in histList) rowsToRemove.Add(hist);&#xA;    histGroups.Remove(compositeKey); // consumed — later GLs with same key will see no HIST group&#xA;}&#xA;&#xA;// ===== Physically remove all matched rows by reference (safe) =====&#xA;if (rowsToRemove.Count &gt; 0)&#xA;{&#xA;    var unique = new System.Collections.Generic.HashSet&lt;System.Data.DataRow&gt;(rowsToRemove);&#xA;    foreach (var r in unique)&#xA;    {&#xA;        if (r != null &amp;&amp; r.Table != null) r.Table.Rows.Remove(r);&#xA;    }&#xA;}&#xA;&#xA;// ===== AFTER totals + Δ identity =====&#xA;SumTable(dtHistoricalReconTransactionsReport, out var afterDebit, out var afterCredit);&#xA;var afterDiff   = afterDebit - afterCredit;&#xA;var removedDiff = removedDebit - removedCredit;&#xA;&#xA;// Return Δ_removed so that: BEFORE ≈ AFTER + Δ_removed&#xA;exchangeGainOrLossPPSP1 = decimal.Round(removedDiff, 2, MidpointRounding.AwayFromZero);&#xA;&#xA;// ===== Logs =====&#xA;System.Console.WriteLine($&quot;📊 GL PPSP seen={glSeen}, matched={glMatched}, no HIST={glNoHist}, moved pairs={movedPairs}, skippedNoRRNOrCpan={glSkippedNoRrnOrPan}&quot;);&#xA;System.Console.WriteLine($&quot;   Principals — GL sum={sumGlPrincipal:N2} | HIST sum={sumHistPrincipal:N2} | Δ(GL−HIST)={(sumGlPrincipal - sumHistPrincipal):N2}&quot;);&#xA;&#xA;if (skippedMissingRrn.Count &gt; 0)&#xA;{&#xA;    System.Console.WriteLine(&quot;⚠️ GL PPSP rows skipped (missing strict RRN and/or C_PAN):&quot;);&#xA;    for (int k = 0; k &lt; skippedMissingRrn.Count; k++)&#xA;        System.Console.WriteLine($&quot;   • {skippedMissingRrn[k]}&quot;);&#xA;}&#xA;&#xA;if (unmatched.Count &gt; 0)&#xA;{&#xA;    System.Console.WriteLine(&quot;🧩 Unmatched GL PPSP (no HIST group by composite key) — up to 20:&quot;);&#xA;    for (int k = 0; k &lt; unmatched.Count; k++)&#xA;        System.Console.WriteLine($&quot;   • {unmatched[k]}&quot;);&#xA;}&#xA;&#xA;// Identity check&#xA;decimal lhs = beforeDiff;&#xA;decimal rhs = afterDiff + exchangeGainOrLossPPSP1;&#xA;decimal gap = Math.Abs(lhs - rhs);&#xA;&#xA;System.Console.WriteLine();&#xA;System.Console.WriteLine(&quot;🔎 Balance check (Δ = Debit − Credit):&quot;);&#xA;System.Console.WriteLine($&quot;  BEFORE:  Debit {beforeDebit:N2}  | Credit {beforeCredit:N2}  | Δ_before = {beforeDiff:N2}&quot;);&#xA;System.Console.WriteLine($&quot;  REMOVED: Debit {removedDebit:N2} | Credit {removedCredit:N2} | Δ_removed (NET) = {removedDiff:N2}&quot;);&#xA;System.Console.WriteLine($&quot;  AFTER:   Debit {afterDebit:N2}  | Credit {afterCredit:N2}  | Δ_after  = {afterDiff:N2}&quot;);&#xA;System.Console.WriteLine($&quot;  💱 exchangeGainOrLossPPSP1 (returned) = {exchangeGainOrLossPPSP1:N2} {currency}&quot;);&#xA;&#xA;if (gap &lt;= balanceTol)&#xA;    System.Console.WriteLine($&quot;✅ Consistency OK: Δ_before ({lhs:N2}) ≈ Δ_after + Δ_removed ({rhs:N2}) within ±{balanceTol:N2}.&quot;);&#xA;else&#xA;{&#xA;    System.Console.WriteLine($&quot;⚠️ Consistency MISMATCH: Δ_before ({lhs:N2}) vs (Δ_after + Δ_removed) ({rhs:N2}); gap = {gap:N2} (&gt; ±{balanceTol:N2}).&quot;);&#xA;    System.Console.WriteLine(&quot;   Tip: verify HIST Root Cause filter, fee/income filtering, and strict RRN + 550558 C_PAN extraction on both sides.&quot;);&#xA;}&#xA;&#xA;System.Console.WriteLine($&quot;⏱️ Completed in {sw.ElapsedMilliseconds} ms&quot;);&#xA;" DisplayName="PPSP + exchangeGainOrLossPPSP1 GL vs HIST" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_75" Language="CSharp">

        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// --- Inputs ---&#xA;// dtHistoricalReconTransactionsReport (DataTable)&#xA;// dtHistoricalReconTransactionsReportMatched (DataTable)  [In/Out]&#xA;// string reconCurrency&#xA;// string reconDate&#xA;&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport), &quot;Input DataTable cannot be null&quot;);&#xA;&#xA;if (dtHistoricalReconTransactionsReportMatched == null)&#xA;    dtHistoricalReconTransactionsReportMatched = dtHistoricalReconTransactionsReport.Clone();&#xA;&#xA;// ===== Helpers =====&#xA;DateTime? ParseDateFlexible(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return null;&#xA;    if (val is DateTime dt) return dt;&#xA;    if (val is double d) { try { return DateTime.FromOADate(d); } catch { } }&#xA;    if (double.TryParse(val?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d2))&#xA;    { try { return DateTime.FromOADate(d2); } catch { } }&#xA;&#xA;    var s = val.ToString().Trim();&#xA;    string[] fmts = { &quot;dd/MM/yyyy HH:mm:ss&quot;,&quot;dd/MM/yyyy HH:mm&quot;,&quot;dd/MM/yyyy&quot;,&quot;yyyy-MM-dd&quot;,&quot;yyyy-MM-dd HH:mm:ss&quot;,&quot;yyyy/MM/dd&quot; };&#xA;    if (DateTime.TryParseExact(s, fmts, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var exact)) return exact;&#xA;    if (DateTime.TryParse(s, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var any)) return any;&#xA;    return null;&#xA;}&#xA;&#xA;string FindFirstExistingColumn(System.Data.DataTable dt, params string[] names)&#xA;{&#xA;    foreach (var n in names) if (!string.IsNullOrEmpty(n) &amp;&amp; dt.Columns.Contains(n)) return n;&#xA;    return null;&#xA;}&#xA;void EnsureColumn(System.Data.DataTable dt, string name)&#xA;{&#xA;    if (!dt.Columns.Contains(name)) dt.Columns.Add(new System.Data.DataColumn(name, typeof(string)) { DefaultValue = &quot;&quot; });&#xA;}&#xA;string GetStr(System.Data.DataRow r, string col)&#xA;{&#xA;    if (!r.Table.Columns.Contains(col)) return &quot;&quot;;&#xA;    var v = r[col]; return (v == null || v == DBNull.Value) ? &quot;&quot; : v.ToString();&#xA;}&#xA;bool HasValue(System.Data.DataRow r, string col)&#xA;{&#xA;    if (!r.Table.Columns.Contains(col)) return false;&#xA;    var v = r[col]; return !(v == null || v == DBNull.Value) &amp;&amp; !string.IsNullOrWhiteSpace(v.ToString());&#xA;}&#xA;void SetIfEmpty(System.Data.DataRow r, string col, string val)&#xA;{&#xA;    if (!r.Table.Columns.Contains(col)) r.Table.Columns.Add(new System.Data.DataColumn(col, typeof(string)) { DefaultValue = &quot;&quot; });&#xA;    if (!HasValue(r, col)) r[col] = val ?? &quot;&quot;;&#xA;}&#xA;string CleanText(string input) =&gt;&#xA;    System.Text.RegularExpressions.Regex.Replace((input ?? &quot;&quot;).Trim(), @&quot;[^\w\s\-/]&quot;, &quot;&quot;).ToUpperInvariant();&#xA;decimal ParseAmount(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return 0m;&#xA;    string s = val.ToString().Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;).Trim();&#xA;    return decimal.TryParse(s, out var result) ? result : 0m;&#xA;}&#xA;void SumDebitCredit(System.Data.DataTable dt, string debitCol, string creditCol, out decimal debitSum, out decimal creditSum)&#xA;{&#xA;    debitSum = 0m; creditSum = 0m;&#xA;    if (dt == null) return;&#xA;    bool hasD = dt.Columns.Contains(debitCol), hasC = dt.Columns.Contains(creditCol);&#xA;    for (int i = 0; i &lt; dt.Rows.Count; i++) { var r = dt.Rows[i]; if (hasD) debitSum += ParseAmount(r[debitCol]); if (hasC) creditSum += ParseAmount(r[creditCol]); }&#xA;}&#xA;&#xA;// === PAN/RRN extractor: PAN normalized + STRICT 12-alphanumeric RRN ===&#xA;string NormalizePanFromNarration(string narr)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(narr)) return &quot;&quot;;&#xA;    var m = System.Text.RegularExpressions.Regex.Match(narr, @&quot;\b(\d{6})[^\dA-Za-z]*([xX\*]{6})[^\dA-Za-z]*(\d{4})\b&quot;);&#xA;    if (!m.Success) return &quot;&quot;;&#xA;    return m.Groups[1].Value + &quot;XXXXXX&quot; + m.Groups[3].Value;&#xA;}&#xA;(bool ok, string pan, string rrn) ExtractPanRrn(object narrObj)&#xA;{&#xA;    string narr = narrObj?.ToString() ?? &quot;&quot;;&#xA;    if (string.IsNullOrWhiteSpace(narr)) return (false, &quot;&quot;, &quot;&quot;);&#xA;    string pan = NormalizePanFromNarration(narr);&#xA;    var rrnMatch = System.Text.RegularExpressions.Regex.Match(narr, @&quot;\b([A-Za-z0-9]{12})\b&quot;);&#xA;    string rrn = rrnMatch.Success ? rrnMatch.Groups[1].Value.ToUpperInvariant() : &quot;&quot;;&#xA;    bool ok = !string.IsNullOrEmpty(pan) || !string.IsNullOrEmpty(rrn); // don't match if BOTH missing&#xA;    return (ok, pan, rrn);&#xA;}&#xA;bool KeysMatch((string pan, string rrn) a, (string pan, string rrn) b)&#xA;{&#xA;    if (!string.IsNullOrEmpty(a.pan) &amp;&amp; !string.IsNullOrEmpty(a.rrn) &amp;&amp;&#xA;        !string.IsNullOrEmpty(b.pan) &amp;&amp; !string.IsNullOrEmpty(b.rrn) &amp;&amp;&#xA;        a.pan == b.pan &amp;&amp; a.rrn == b.rrn) return true;&#xA;&#xA;    if (!string.IsNullOrEmpty(a.rrn) &amp;&amp; a.rrn.Length == 12 &amp;&amp;&#xA;        !string.IsNullOrEmpty(b.rrn) &amp;&amp; b.rrn.Length == 12 &amp;&amp;&#xA;        a.rrn == b.rrn) return true;&#xA;&#xA;    return false;&#xA;}&#xA;string MakeKey((string pan, string rrn) k)&#xA;{&#xA;    if (!string.IsNullOrEmpty(k.pan) &amp;&amp; !string.IsNullOrEmpty(k.rrn)) return $&quot;PAN={k.pan}|RRN={k.rrn}&quot;;&#xA;    if (!string.IsNullOrEmpty(k.rrn)) return $&quot;RRN={k.rrn}&quot;;&#xA;    return &quot;&quot;;&#xA;}&#xA;&#xA;// ===== Ensure needed columns =====&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Classification&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReportMatched, &quot;Classification&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Root Cause&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Root Cause Category&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Recommended Action&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Action Owner&quot;);&#xA;&#xA;// Persisted protection columns (for cross-invoke safety)&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;CashbackLock&quot;); // &quot;1&quot; when we tagged cashback&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;CashbackKey&quot;);  // PAN/RRN key used&#xA;&#xA;// Parse reconDate (for late-posted window)&#xA;DateTime? reconDateParsed = null;&#xA;try { reconDateParsed = ParseDateFlexible(reconDate); } catch { reconDateParsed = null; }&#xA;string valueDateCol = FindFirstExistingColumn(dtHistoricalReconTransactionsReport, &quot;Value Date&quot;, &quot;ValueDate&quot;);&#xA;&#xA;// === Early exit ===&#xA;if (dtHistoricalReconTransactionsReport.Rows.Count == 0) { System.Console.WriteLine(&quot;No rows to process.&quot;); return; }&#xA;&#xA;// === Config &amp; totals BEFORE ===&#xA;string currency = reconCurrency;&#xA;decimal balanceTol = 0.01m;&#xA;string debitCol = $&quot;Debit ({currency})&quot;, creditCol = $&quot;Credit ({currency})&quot;;&#xA;&#xA;decimal beforeDebit = 0m, beforeCredit = 0m;&#xA;SumDebitCredit(dtHistoricalReconTransactionsReport, debitCol, creditCol, out beforeDebit, out beforeCredit);&#xA;decimal beforeDiff = beforeDebit - beforeCredit;&#xA;System.Console.WriteLine($&quot;[BAL] BEFORE — Debit ({currency}): {beforeDebit:N2}, Credit ({currency}): {beforeCredit:N2}, Δ(D−C): {beforeDiff:N2}&quot;);&#xA;&#xA;// --- 1) CWPP fee candidates (debit&gt;0, credit=0, ref contains CWPP) ---&#xA;var cwppFees = dtHistoricalReconTransactionsReport.AsEnumerable()&#xA;    .Where(row =&gt;&#xA;    {&#xA;        string refNo = (row.Table.Columns.Contains(&quot;Transaction Ref No:&quot;) ? row[&quot;Transaction Ref No:&quot;].ToString() : &quot;&quot;).ToUpperInvariant();&#xA;        bool looksCWPP = refNo.Contains(&quot;CWPP&quot;) || refNo.Contains(&quot;PPPC&quot;);&#xA;        decimal debit = ParseAmount(row[debitCol]), credit = ParseAmount(row[creditCol]);&#xA;        return looksCWPP &amp;&amp; debit &gt; 0 &amp;&amp; credit == 0;&#xA;    }).ToList();&#xA;foreach (var fee in cwppFees) fee[&quot;Classification&quot;] = &quot;CWPP&quot;;&#xA;System.Console.WriteLine($&quot;Found {cwppFees.Count} CWPP fee candidate rows (by Transaction Ref No: only).&quot;);&#xA;&#xA;// --- 2) Purchase/Auth Completion candidates (Narration + Channel=API; credit&gt;0) ---&#xA;var purchaseAuths = dtHistoricalReconTransactionsReport.AsEnumerable()&#xA;    .Where(row =&gt;&#xA;    {&#xA;        string narr = row.Table.Columns.Contains(&quot;Narration&quot;) ? (row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;        string clean = CleanText(narr);&#xA;        string channel = row.Table.Columns.Contains(&quot;Channel&quot;) ? (row[&quot;Channel&quot;]?.ToString()?.Trim().ToUpperInvariant() ?? &quot;&quot;) : &quot;&quot;;&#xA;        bool isPurchaseAuth = clean.Contains(&quot;PURCHASE/AUTH COMPLETION&quot;) &amp;&amp; channel == &quot;API&quot;;&#xA;        decimal credit = ParseAmount(row[creditCol]), debit = ParseAmount(row[debitCol]);&#xA;        return isPurchaseAuth &amp;&amp; credit &gt; 0 &amp;&amp; debit == 0;&#xA;    }).ToList();&#xA;foreach (var pac in purchaseAuths) pac[&quot;Classification&quot;] = &quot;CWPP&quot;;&#xA;&#xA;int initialCwppCount = cwppFees.Count, initialPacCount = purchaseAuths.Count;&#xA;System.Console.WriteLine($&quot;Found {purchaseAuths.Count} Purchase/Auth Completion candidate rows (Narration + Channel=API).&quot;);&#xA;&#xA;// --- 3) Match CWPP vs Purchase/Auth Completion ---&#xA;var rowsToRemove = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;int matchedPairs = 0; decimal matchedDebitTotal = 0m, matchedCreditTotal = 0m;&#xA;decimal removedDebitSum = 0m, removedCreditSum = 0m;&#xA;&#xA;// keys of successful matches (to tag cashback + skip late-post)&#xA;var matchedKeySet = new System.Collections.Generic.HashSet&lt;string&gt;(System.StringComparer.OrdinalIgnoreCase);&#xA;&#xA;foreach (var fee in cwppFees.ToList())&#xA;{&#xA;    var feeKeys = ExtractPanRrn(fee[&quot;Narration&quot;]);&#xA;    if (!feeKeys.ok) continue; // don't match iff PAN and RRN are both missing&#xA;&#xA;    decimal feeAmt = ParseAmount(fee[debitCol]);&#xA;    if (feeAmt == 0) continue;&#xA;&#xA;    var match = purchaseAuths.FirstOrDefault(pac =&gt;&#xA;    {&#xA;        var pacKeys = ExtractPanRrn(pac[&quot;Narration&quot;]);&#xA;        if (!pacKeys.ok) return false;&#xA;        decimal pacAmt = ParseAmount(pac[creditCol]); if (pacAmt == 0) return false;&#xA;        return KeysMatch((feeKeys.pan, feeKeys.rrn), (pacKeys.pan, pacKeys.rrn)) &amp;&amp; System.Math.Abs(feeAmt - pacAmt) &lt;= 0.01m;&#xA;    });&#xA;&#xA;    if (match != null)&#xA;    {&#xA;        decimal pacAmt = ParseAmount(match[creditCol]);&#xA;        matchedDebitTotal += feeAmt; matchedCreditTotal += pacAmt;&#xA;        removedDebitSum += feeAmt; removedCreditSum += pacAmt;&#xA;&#xA;        int feeIdx = dtHistoricalReconTransactionsReportMatched.Rows.Count;&#xA;        dtHistoricalReconTransactionsReportMatched.ImportRow(fee);&#xA;        dtHistoricalReconTransactionsReportMatched.Rows[feeIdx][&quot;Classification&quot;] = &quot;CWPP&quot;;&#xA;&#xA;        int pacIdx = dtHistoricalReconTransactionsReportMatched.Rows.Count;&#xA;        dtHistoricalReconTransactionsReportMatched.ImportRow(match);&#xA;        dtHistoricalReconTransactionsReportMatched.Rows[pacIdx][&quot;Classification&quot;] = &quot;CWPP&quot;;&#xA;&#xA;        rowsToRemove.Add(fee); rowsToRemove.Add(match);&#xA;        purchaseAuths.Remove(match);&#xA;        matchedPairs++;&#xA;&#xA;        var feeKey = MakeKey((feeKeys.pan, feeKeys.rrn)); if (!string.IsNullOrEmpty(feeKey)) matchedKeySet.Add(feeKey);&#xA;        var pacKeys = ExtractPanRrn(match[&quot;Narration&quot;]); var pacKey = MakeKey((pacKeys.pan, pacKeys.rrn)); if (!string.IsNullOrEmpty(pacKey)) matchedKeySet.Add(pacKey);&#xA;&#xA;        System.Console.WriteLine($&quot;✅ Matched CWPP fee (Ref: {fee[&quot;Transaction Ref No:&quot;]}) to Purchase/Auth Completion (Ref: {match[&quot;Transaction Ref No:&quot;]}).&quot;);&#xA;    }&#xA;}&#xA;&#xA;// --- 4) Remove matched rows from working table ---&#xA;foreach (var row in rowsToRemove.Distinct())&#xA;{&#xA;    try&#xA;    {&#xA;        if (row != null &amp;&amp; row.Table == dtHistoricalReconTransactionsReport &amp;&amp; row.RowState != System.Data.DataRowState.Detached)&#xA;            dtHistoricalReconTransactionsReport.Rows.Remove(row);&#xA;    }&#xA;    catch { }&#xA;}&#xA;&#xA;// --- 5) Tag OTHER CWPP rows sharing a matched key as Cashback (no overwrite) + LOG + LOCK ---&#xA;int cashbackTaggedCount = 0;&#xA;if (matchedKeySet.Count &gt; 0)&#xA;{&#xA;    foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;    {&#xA;        string refNoUpper = GetStr(row, &quot;Transaction Ref No:&quot;).ToUpperInvariant();&#xA;        if (!refNoUpper.Contains(&quot;CWPP&quot;) &amp;&amp; !refNoUpper.Contains(&quot;PPPC&quot;)) continue;&#xA;&#xA;        var keys = ExtractPanRrn(row[&quot;Narration&quot;]); &#xA;        if (!keys.ok) continue;&#xA;&#xA;        var key = MakeKey((keys.pan, keys.rrn)); &#xA;        if (string.IsNullOrEmpty(key)) continue;&#xA;&#xA;        if (matchedKeySet.Contains(key))&#xA;        {&#xA;            SetIfEmpty(row, &quot;Root Cause&quot;,          &quot;Cashback updated CBS only&quot;);&#xA;            SetIfEmpty(row, &quot;Root Cause Category&quot;, &quot;System&quot;);&#xA;            SetIfEmpty(row, &quot;Recommended Action&quot;,  &quot;Perform MISC ADJUSTMENT CREDIT&quot;);&#xA;            SetIfEmpty(row, &quot;Action Owner&quot;,        &quot;Stephen Jilala&quot;);&#xA;&#xA;            row[&quot;CashbackLock&quot;] = &quot;1&quot;;   // 🔒 persist lock for Invoke 2 / Late-posted&#xA;            row[&quot;CashbackKey&quot;]  = key;   // traceability&#xA;&#xA;            cashbackTaggedCount++;&#xA;&#xA;            System.Console.WriteLine(&#xA;                $&quot;💳 Cashback tagged — RefNo: {GetStr(row, &quot;Transaction Ref No:&quot;)}, Key: {key}, &quot; +&#xA;                $&quot;Debit: {ParseAmount(row[debitCol]):N2}, Credit: {ParseAmount(row[creditCol]):N2}&quot;);&#xA;        }&#xA;    }&#xA;    System.Console.WriteLine($&quot;Cashback rows tagged: {cashbackTaggedCount}&quot;);&#xA;}&#xA;&#xA;// --- 6) GL/new CWPP late-posted vs on-us classification (skip locked/matched keys) ---&#xA;if (reconDateParsed != null &amp;&amp; !string.IsNullOrEmpty(valueDateCol))&#xA;{&#xA;    DateTime startRange = reconDateParsed.Value.AddDays(-2), endRange = reconDateParsed.Value.AddDays(2);&#xA;    foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;    {&#xA;        string refNoUpper = GetStr(row, &quot;Transaction Ref No:&quot;).ToUpperInvariant();&#xA;        if (!refNoUpper.Contains(&quot;CWPP&quot;) &amp;&amp; !refNoUpper.Contains(&quot;PPPC&quot;)) continue;&#xA;&#xA;        // ✅ Skip rows we locked as cashback in this invoke&#xA;        if (GetStr(row, &quot;CashbackLock&quot;) == &quot;1&quot;) continue;&#xA;&#xA;        // ✅ Skip rows whose PAN+RRN/RRN key was matched (protect cashback)&#xA;        var keys = ExtractPanRrn(row[&quot;Narration&quot;]);&#xA;        if (keys.ok)&#xA;        {&#xA;            var key = MakeKey((keys.pan, keys.rrn));&#xA;            if (!string.IsNullOrEmpty(key) &amp;&amp; matchedKeySet.Contains(key)) continue;&#xA;        }&#xA;&#xA;        bool passesSource = true, passesType = true;&#xA;        if (row.Table.Columns.Contains(&quot;Source&quot;)) passesSource = GetStr(row, &quot;Source&quot;).Trim().ToUpperInvariant() == &quot;GL&quot;;&#xA;        if (row.Table.Columns.Contains(&quot;Type&quot;))   passesType   = GetStr(row, &quot;Type&quot;).Trim().ToUpperInvariant() == &quot;NEW&quot;;&#xA;        if (!passesSource || !passesType) continue;&#xA;&#xA;        var valueDate = ParseDateFlexible(row[valueDateCol]); if (valueDate == null) continue;&#xA;        if (valueDate.Value &gt;= startRange &amp;&amp; valueDate.Value &lt;= endRange)&#xA;        {&#xA;            SetIfEmpty(row, &quot;Root Cause&quot;,          &quot;Late posted transaction&quot;);&#xA;            SetIfEmpty(row, &quot;Root Cause Category&quot;, &quot;System&quot;);&#xA;            SetIfEmpty(row, &quot;Recommended Action&quot;,  &quot;Check if updates CMS on the following date&quot;);&#xA;            SetIfEmpty(row, &quot;Action Owner&quot;,        &quot;Card Reconciliation&quot;);&#xA;        }&#xA;        else&#xA;        {&#xA;            SetIfEmpty(row, &quot;Root Cause&quot;,          &quot;On-us purchase transaction updated CBS only&quot;);&#xA;            SetIfEmpty(row, &quot;Root Cause Category&quot;, &quot;System&quot;);&#xA;            SetIfEmpty(row, &quot;Recommended Action&quot;,  &quot;To request debit authority to debit the merchant account&quot;);&#xA;            SetIfEmpty(row, &quot;Action Owner&quot;,        &quot;Card Reconciliation&quot;);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// --- 7) Summary &amp; balance identity ---&#xA;System.Console.WriteLine();&#xA;System.Console.WriteLine(&quot;📝 Summary:&quot;);&#xA;System.Console.WriteLine($&quot;CWPP fee candidates: {initialCwppCount}&quot;);&#xA;System.Console.WriteLine($&quot;Purchase/Auth Completion candidates (Narration + Channel=API): {initialPacCount}&quot;);&#xA;System.Console.WriteLine($&quot;Matched pairs: {matchedPairs}&quot;);&#xA;System.Console.WriteLine($&quot;Matched Debit ({currency}):  {matchedDebitTotal:N2}&quot;);&#xA;System.Console.WriteLine($&quot;Matched Credit ({currency}): {matchedCreditTotal:N2}&quot;);&#xA;&#xA;decimal afterDebit = 0m, afterCredit = 0m; SumDebitCredit(dtHistoricalReconTransactionsReport, debitCol, creditCol, out afterDebit, out afterCredit);&#xA;decimal afterDiff = afterDebit - afterCredit;&#xA;&#xA;decimal matchedDebit = 0m, matchedCredit = 0m; SumDebitCredit(dtHistoricalReconTransactionsReportMatched, debitCol, creditCol, out matchedDebit, out matchedCredit);&#xA;decimal removedDiff = removedDebitSum - removedCreditSum;&#xA;&#xA;System.Console.WriteLine();&#xA;System.Console.WriteLine(&quot;🔎 Balance check (Δ = Debit − Credit):&quot;);&#xA;System.Console.WriteLine($&quot;  BEFORE:  Debit {beforeDebit:N2}  | Credit {beforeCredit:N2}  | Δ_before = {beforeDiff:N2}&quot;);&#xA;System.Console.WriteLine($&quot;  REMOVED: Debit {removedDebitSum:N2} | Credit {removedCreditSum:N2} | Δ_removed = {removedDiff:N2}&quot;);&#xA;System.Console.WriteLine($&quot;  AFTER:   Debit {afterDebit:N2}   | Credit {afterCredit:N2}   | Δ_after  = {afterDiff:N2}&quot;);&#xA;&#xA;decimal lhs = beforeDiff, rhs = afterDiff + removedDiff, gap = System.Math.Abs(lhs - rhs);&#xA;if (gap &lt;= balanceTol)&#xA;    System.Console.WriteLine($&quot;✅ Consistency OK: Δ_before ({lhs:N2}) ≈ Δ_after + Δ_removed ({rhs:N2}) within ±{balanceTol:N2}.&quot;);&#xA;else&#xA;{&#xA;    System.Console.WriteLine($&quot;⚠️ Consistency MISMATCH: Δ_before ({lhs:N2}) vs (Δ_after + Δ_removed) ({rhs:N2}); gap = {gap:N2} (&gt; ±{balanceTol:N2}).&quot;);&#xA;    System.Console.WriteLine(&quot;   Tip: check CWPP/PAC rows with missing keys or unusual amount formats.&quot;);&#xA;}&#xA;&#xA;System.Console.WriteLine();&#xA;System.Console.WriteLine(&quot;📦 Matched table totals (for reference):&quot;);&#xA;System.Console.WriteLine($&quot;  Matched Debit ({currency}):  {matchedDebit:N2}&quot;);&#xA;System.Console.WriteLine($&quot;  Matched Credit ({currency}): {matchedCredit:N2}&quot;);&#xA;" DisplayName="CWPP + Purchase/Auth Completion" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_41" La
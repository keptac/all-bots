        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: PPSA exchange gain/loss (GL ↔ HIST | RRN-only) — fee-excluded, moves pairs, removes BOTH (by reference) ====&#xA;// Args (In):     string reconCurrency&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport, DataTable dtHistoricalReconTransactionsReportMatched&#xA;// Args (Out):    decimal exchangeGainOrLossPPSA1&#xA;//&#xA;// Behavior (UPDATED):&#xA;// - GL side filter: &quot;Transaction Ref No:&quot; must contain &quot;PPSA&quot;&#xA;// - HIST side filter: Root Cause == &quot;Remote-on-us transaction not yet posted&quot;, exclude fee/tax/income narrations&#xA;// - Strict C_PAN rule: from Narration, find token starting with 550558 and ending with 4 digits → 550558XXXXXX####,&#xA;//   and FORCE that into C_PAN for both GL PPSA rows and HIST rows (when found).&#xA;// - Matching key: RRN ONLY&#xA;//   • HIST side RRN: 12 alphanumeric from the RRN column (first exact 12-char token, uppercased)&#xA;//   • GL side RRN:   12 alphanumeric extracted STRICTLY from Narration&#xA;// - On match: both rows are imported into Matched table and removed from working table (by DataRow reference — index safe)&#xA;// - Totals logged and Δ identity checked: BEFORE == AFTER + exchangeGainOrLossPPSA1 (≈ within tolerance)&#xA;&#xA;var sw = System.Diagnostics.Stopwatch.StartNew();&#xA;System.Console.WriteLine($&quot;🚀 PPSA exchange gain/loss (GL ↔ HIST | RC=Remote-on-us | RRN-only) started at {System.DateTime.Now:yyyy-MM-dd HH:mm:ss}&quot;);&#xA;&#xA;// ===== Guards &amp; setup =====&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport), &quot;Input DataTable cannot be null&quot;);&#xA;&#xA;if (dtHistoricalReconTransactionsReportMatched == null ||&#xA;    dtHistoricalReconTransactionsReportMatched.Columns.Count != dtHistoricalReconTransactionsReport.Columns.Count)&#xA;{&#xA;    dtHistoricalReconTransactionsReportMatched = dtHistoricalReconTransactionsReport.Clone();&#xA;}&#xA;&#xA;string currency = reconCurrency ?? &quot;&quot;;&#xA;string colDebit  = $&quot;Debit ({currency})&quot;;&#xA;string colCredit = $&quot;Credit ({currency})&quot;;&#xA;&#xA;bool hasNarration  = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Narration&quot;);&#xA;bool hasTrnRef     = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Transaction Ref No:&quot;);&#xA;bool hasDebit      = dtHistoricalReconTransactionsReport.Columns.Contains(colDebit);&#xA;bool hasCredit     = dtHistoricalReconTransactionsReport.Columns.Contains(colCredit);&#xA;bool hasRootCause  = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Root Cause&quot;);&#xA;bool hasCPANCol    = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;C_PAN&quot;);&#xA;bool hasRRNCol     = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;RRN&quot;);&#xA;&#xA;// Enforce skip when RRN column exists but value is blank (RRN-only matching)&#xA;bool enforceRrnPresence = hasRRNCol;&#xA;&#xA;// Ensure Classification exists on both tables&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Classification&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Classification&quot;))&#xA;    dtHistoricalReconTransactionsReportMatched.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;&#xA;if (!hasNarration) System.Console.WriteLine(&quot;⚠️ Missing column: Narration&quot;);&#xA;if (!hasTrnRef)    System.Console.WriteLine(&quot;⚠️ Missing column: Transaction Ref No:&quot;);&#xA;if (!hasDebit)     System.Console.WriteLine($&quot;⚠️ Missing column: {colDebit}&quot;);&#xA;if (!hasCredit)    System.Console.WriteLine($&quot;⚠️ Missing column: {colCredit}&quot;);&#xA;if (!hasRootCause) System.Console.WriteLine(&quot;⚠️ Missing column: Root Cause (needed for HIST filtering)&quot;);&#xA;if (!hasCPANCol)   System.Console.WriteLine(&quot;ℹ️ Optional column not present: C_PAN&quot;);&#xA;if (!hasRRNCol)    System.Console.WriteLine(&quot;ℹ️ Optional column not present: RRN&quot;);&#xA;&#xA;// ===== Helpers =====&#xA;string S(object o) =&gt; (o == null || o == DBNull.Value) ? &quot;&quot; : o.ToString();&#xA;string T(object o) =&gt; S(o).Trim();&#xA;string U(string s) =&gt; (s ?? &quot;&quot;).ToUpperInvariant();&#xA;&#xA;decimal ParseAmount(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return 0m;&#xA;    string s = val.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;);&#xA;    if (s.Length == 0) return 0m;&#xA;    if (s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;)) s = &quot;-&quot; + s.Substring(1, s.Length - 2);&#xA;    return decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0m;&#xA;}&#xA;&#xA;// === Exact word/phrase fee/income detection (no FEETZ, etc.) ===&#xA;bool HasFeeOrIncomeTokens(string narr)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(narr)) return false;&#xA;    string u = narr.ToUpperInvariant();&#xA;&#xA;    // Phrase matches&#xA;    if (u.Contains(&quot;SERVICE TAX&quot;) || u.Contains(&quot;TAX ON INCOME&quot;))&#xA;        return true;&#xA;&#xA;    // Tokenized word matches: FEE, FEES, INCOME&#xA;    var tokens = System.Text.RegularExpressions.Regex.Split(u, @&quot;[^A-Z0-9]+&quot;);&#xA;    for (int i = 0; i &lt; tokens.Length; i++)&#xA;    {&#xA;        var t = tokens[i];&#xA;        if (t == &quot;FEE&quot; || t == &quot;FEES&quot; || t == &quot;INCOME&quot;)&#xA;            return true;&#xA;    }&#xA;    return false;&#xA;}&#xA;&#xA;// Strict C_PAN from Narration: token starting with 550558 and ending with 4 digits → 550558XXXXXX####.&#xA;string ExtractStrictPanFromNarration(string narr)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(narr)) return &quot;&quot;;&#xA;    var m = System.Text.RegularExpressions.Regex.Match(&#xA;        narr,&#xA;        @&quot;\b(550558)[0-9Xx\*]{6}(\d{4})\b&quot;&#xA;    );&#xA;    if (!m.Success) return &quot;&quot;;&#xA;    return m.Groups[1].Value + &quot;XXXXXX&quot; + m.Groups[2].Value;&#xA;}&#xA;&#xA;// RRN 12-char extractor: first exact 12 [A-Za-z0-9] token in text, uppercased.&#xA;string ExtractRrn12(string text)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(text)) return &quot;&quot;;&#xA;    var m = System.Text.RegularExpressions.Regex.Match(text, @&quot;\b[A-Za-z0-9]{12}\b&quot;);&#xA;    return m.Success ? m.Value.ToUpperInvariant() : &quot;&quot;;&#xA;}&#xA;&#xA;// HIST eligibility: exact Root Cause text + exclude fee/tax/income&#xA;bool IsHistEligible(System.Data.DataRow r)&#xA;{&#xA;    if (!hasRootCause) return false;&#xA;    if (!string.Equals(T(r[&quot;Root Cause&quot;]), &quot;Remote-on-us transaction not yet posted&quot;, StringComparison.OrdinalIgnoreCase)) return false;&#xA;&#xA;    if (HasFeeOrIncomeTokens(T(r[&quot;Narration&quot;]))) return false;&#xA;    return true;&#xA;}&#xA;&#xA;decimal PrincipalAmount(System.Data.DataRow r)&#xA;{&#xA;    decimal cr = hasCredit ? ParseAmount(r[colCredit]) : 0m;&#xA;    decimal dr = hasDebit  ? ParseAmount(r[colDebit])  : 0m;&#xA;    return (cr &gt; 0m) ? cr : (dr &gt; 0m ? dr : 0m);&#xA;}&#xA;&#xA;void SumTable(System.Data.DataTable dt, out decimal d, out decimal c)&#xA;{&#xA;    d = 0m; c = 0m;&#xA;    for (int i = 0; i &lt; dt.Rows.Count; i++)&#xA;    {&#xA;        d += hasDebit ? ParseAmount(dt.Rows[i][colDebit]) : 0m;&#xA;        c += hasCredit ? ParseAmount(dt.Rows[i][colCredit]) : 0m;&#xA;    }&#xA;}&#xA;&#xA;decimal balanceTol = 0.01m;&#xA;&#xA;// ===== BEFORE totals =====&#xA;SumTable(dtHistoricalReconTransactionsReport, out var beforeDebit, out var beforeCredit);&#xA;var beforeDiff = beforeDebit - beforeCredit;&#xA;System.Console.WriteLine($&quot;[BAL] BEFORE — Debit ({currency}): {beforeDebit:N2}, Credit ({currency}): {beforeCredit:N2}, Δ(D−C): {beforeDiff:N2}&quot;);&#xA;&#xA;// ===== Build HIST index (RRN-only; force C_PAN from Narration) =====&#xA;var histIndex = new System.Collections.Generic.Dictionary&lt;string, System.Data.DataRow&gt;(StringComparer.OrdinalIgnoreCase);&#xA;int histKeys = 0;&#xA;&#xA;if (hasNarration &amp;&amp; hasRRNCol)&#xA;{&#xA;    for (int r = 0; r &lt; dtHistoricalReconTransactionsReport.Rows.Count; r++)&#xA;    {&#xA;        var row = dtHistoricalReconTransactionsReport.Rows[r];&#xA;        if (!IsHistEligible(row)) continue;&#xA;&#xA;        // Enforce RRN presence (RRN-only matching)&#xA;        if (enforceRrnPresence &amp;&amp; string.IsNullOrWhiteSpace(T(row[&quot;RRN&quot;])))&#xA;        {&#xA;            continue;&#xA;        }&#xA;&#xA;        string narr = T(row[&quot;Narration&quot;]);&#xA;&#xA;        // Force C_PAN from Narration when we can find a strict 550558 token&#xA;        if (hasCPANCol)&#xA;        {&#xA;            var panStrict = ExtractStrictPanFromNarration(narr);&#xA;            if (!string.IsNullOrEmpty(panStrict))&#xA;                row[&quot;C_PAN&quot;] = panStrict;&#xA;        }&#xA;&#xA;        // RRN key from HIST RRN column&#xA;        string rrnKey = ExtractRrn12(T(row[&quot;RRN&quot;]));&#xA;        if (string.IsNullOrEmpty(rrnKey)) continue;&#xA;&#xA;        var principal = PrincipalAmount(row);&#xA;        if (principal &lt;= 0m) continue;&#xA;&#xA;        if (histIndex.TryGetValue(rrnKey, out var exist))&#xA;        {&#xA;            if (principal &gt; PrincipalAmount(exist)) histIndex[rrnKey] = row;&#xA;        }&#xA;        else&#xA;        {&#xA;            histIndex[rrnKey] = row;&#xA;            histKeys++;&#xA;        }&#xA;    }&#xA;}&#xA;System.Console.WriteLine($&quot;📦 HIST index ready (Root Cause='Remote-on-us ...', RRN-only): {histKeys} keys.&quot;);&#xA;&#xA;// ===== Match &amp; MOVE =====&#xA;int glSeen = 0, glMatched = 0, glNoHist = 0, movedPairs = 0;&#xA;decimal sumGlPrincipal = 0m, sumHistPrincipal = 0m;&#xA;decimal removedDebit = 0m, removedCredit = 0m;&#xA;var unmatched = new System.Collections.Generic.List&lt;string&gt;();&#xA;&#xA;// Remove-by-reference (index-safe)&#xA;var rowsToRemove = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var gl = dtHistoricalReconTransactionsReport.Rows[i];&#xA;&#xA;    if (!hasTrnRef || !hasNarration) continue;&#xA;&#xA;    string trn = T(gl[&quot;Transaction Ref No:&quot;]);&#xA;    if (trn.IndexOf(&quot;PPSA&quot;, StringComparison.OrdinalIgnoreCase) &lt; 0 &amp;&amp; trn.IndexOf(&quot;ADPC&quot;, StringComparison.OrdinalIgnoreCase) &lt; 0) continue; // GL PPSA/ADPC only&#xA;    glSeen++;&#xA;&#xA;    string glNarr = T(gl[&quot;Narration&quot;]);&#xA;&#xA;    // Force GL C_PAN from Narration (strict 550558 token)&#xA;    string glPanStrict = hasCPANCol ? ExtractStrictPanFromNarration(glNarr) : &quot;&quot;;&#xA;    if (hasCPANCol &amp;&amp; !string.IsNullOrEmpty(glPanStrict))&#xA;        gl[&quot;C_PAN&quot;] = glPanStrict;&#xA;&#xA;    // Extract GL RRN from Narration (12-char alnum)&#xA;    string glRrn = ExtractRrn12(glNarr);&#xA;&#xA;    // Helpful diag per GL:&#xA;    System.Console.WriteLine($&quot;🔎 GL PPSA candidate: TRN={trn}, PAN={glPanStrict}, RRN={glRrn}&quot;);&#xA;&#xA;    // We match by RRN ONLY; if GL has no valid RRN, leave it in table.&#xA;    if (string.IsNullOrEmpty(glRrn))&#xA;    {&#xA;        if (unmatched.Count &lt; 15) unmatched.Add($&quot;(no GL RRN) RRN=&lt;missing&gt;, TRN={trn}&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    decimal glDebit  = hasDebit  ? ParseAmount(gl[colDebit])  : 0m;&#xA;    decimal glCredit = hasCredit ? ParseAmount(gl[colCredit]) : 0m;&#xA;    decimal glPrincipal = (glDebit &gt; 0m) ? glDebit : (glCredit &gt; 0m ? glCredit : 0m);&#xA;    if (glPrincipal &lt;= 0m)&#xA;    {&#xA;        System.Console.WriteLine($&quot;⚠️ GL PPSA zero principal — TRN={trn}, RRN={glRrn}&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    string key = glRrn; // RRN-only key&#xA;    if (!histIndex.TryGetValue(key, out var hist))&#xA;    {&#xA;        glNoHist++;&#xA;        if (unmatched.Count &lt; 15) unmatched.Add($&quot;RRN={glRrn}, GL={glPrincipal:N2}, TRN={trn}&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    // Double-check HIST is still non-fee&#xA;    if (HasFeeOrIncomeTokens(T(hist[&quot;Narration&quot;])))&#xA;    {&#xA;        glNoHist++;&#xA;        if (unmatched.Count &lt; 15) unmatched.Add($&quot;(fee-skip HIST) RRN={glRrn}, GL={glPrincipal:N2}, TRN={trn}&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    decimal histDebit  = hasDebit  ? ParseAmount(hist[colDebit])  : 0m;&#xA;    decimal histCredit = hasCredit ? ParseAmount(hist[colCredit]) : 0m;&#xA;    decimal histPrincipal = (histCredit &gt; 0m) ? histCredit : (histDebit &gt; 0m ? histDebit : 0m);&#xA;    if (histPrincipal &lt;= 0m)&#xA;    {&#xA;        glNoHist++;&#xA;        if (unmatched.Count &lt; 15) unmatched.Add($&quot;(zero HIST) RRN={glRrn}, GL={glPrincipal:N2}, TRN={trn}&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    // Classification mark BEFORE moving&#xA;    gl[&quot;Classification&quot;]   = &quot;PPSA&quot;;&#xA;    hist[&quot;Classification&quot;] = &quot;PPSA&quot;;&#xA;&#xA;    // Accumulate removed totals (authoritative Δ)&#xA;    removedDebit  += glDebit  + histDebit;&#xA;    removedCredit += glCredit + histCredit;&#xA;&#xA;    // Import both rows to matched&#xA;    dtHistoricalReconTransactionsReportMatched.ImportRow(gl);&#xA;    dtHistoricalReconTransactionsReportMatched.ImportRow(hist);&#xA;&#xA;    // Track for removal by reference (index-safe)&#xA;    rowsToRemove.Add(gl);&#xA;    rowsToRemove.Add(hist);&#xA;&#xA;    // Update stats&#xA;    histIndex.Remove(key);&#xA;    sumGlPrincipal   += glPrincipal;&#xA;    sumHistPrincipal += histPrincipal;&#xA;    glMatched++;&#xA;    movedPairs++;&#xA;}&#xA;&#xA;// ===== Physically remove all matched rows by reference (safe) =====&#xA;if (rowsToRemove.Count &gt; 0)&#xA;{&#xA;    var unique = new System.Collections.Generic.HashSet&lt;System.Data.DataRow&gt;(rowsToRemove);&#xA;    foreach (var r in unique)&#xA;    {&#xA;        if (r != null &amp;&amp; r.Table != null) r.Table.Rows.Remove(r);&#xA;    }&#xA;}&#xA;&#xA;// ===== AFTER totals + Δ identity =====&#xA;SumTable(dtHistoricalReconTransactionsReport, out var afterDebit, out var afterCredit);&#xA;var afterDiff   = afterDebit - afterCredit;&#xA;var removedDiff = removedDebit - removedCredit;&#xA;&#xA;// Return Δ_removed so that: BEFORE ≈ AFTER + Δ_removed&#xA;exchangeGainOrLossPPSA1 = decimal.Round(removedDiff, 2, MidpointRounding.AwayFromZero);&#xA;&#xA;// ===== Logs =====&#xA;System.Console.WriteLine($&quot;📊 GL PPSA seen={glSeen}, matched={glMatched}, no HIST={glNoHist}, moved pairs={movedPairs}&quot;);&#xA;System.Console.WriteLine($&quot;🧮 Principal totals — GL={sumGlPrincipal:N2} | HIST={sumHistPrincipal:N2} | Δ(GL−HIST)={(sumGlPrincipal - sumHistPrincipal):N2}&quot;);&#xA;if (unmatched.Count &gt; 0)&#xA;{&#xA;    System.Console.WriteLine(&quot;🧩 Unmatched GL PPSA (up to 15):&quot;);&#xA;    for (int k = 0; k &lt; unmatched.Count; k++) System.Console.WriteLine($&quot;   • {unmatched[k]}&quot;);&#xA;}&#xA;&#xA;// Identity check&#xA;decimal lhs = beforeDiff;&#xA;decimal rhs = afterDiff + exchangeGainOrLossPPSA1;&#xA;decimal gap = Math.Abs(lhs - rhs);&#xA;&#xA;System.Console.WriteLine();&#xA;System.Console.WriteLine(&quot;🔎 Balance check (Δ = Debit − Credit):&quot;);&#xA;System.Console.WriteLine($&quot;  BEFORE:  Debit {beforeDebit:N2}  | Credit {beforeCredit:N2}  | Δ_before = {beforeDiff:N2}&quot;);&#xA;System.Console.WriteLine($&quot;  REMOVED: Debit {removedDebit:N2} | Credit {removedCredit:N2} | Δ_removed (NET) = {removedDiff:N2}&quot;);&#xA;System.Console.WriteLine($&quot;  AFTER:   Debit {afterDebit:N2}  | Credit {afterCredit:N2}  | Δ_after  = {afterDiff:N2}&quot;);&#xA;System.Console.WriteLine($&quot;  💱 exchangeGainOrLossPPSA1 (returned) = {exchangeGainOrLossPPSA1:N2} {currency}&quot;);&#xA;&#xA;if (gap &lt;= balanceTol)&#xA;    System.Console.WriteLine($&quot;✅ Consistency OK: Δ_before ({lhs:N2}) ≈ Δ_after + Δ_removed ({rhs:N2}) within ±{balanceTol:N2}.&quot;);&#xA;else&#xA;{&#xA;    System.Console.WriteLine($&quot;⚠️ Consistency MISMATCH: Δ_before ({lhs:N2}) vs (Δ_after + Δ_removed) ({rhs:N2}); gap = {gap:N2} (&gt; ±{balanceTol:N2}).&quot;);&#xA;    System.Console.WriteLine(&quot;   Tip: verify HIST Root Cause filter, fee/income filtering, and RRN extraction on both sides.&quot;);&#xA;}&#xA;&#xA;System.Console.WriteLine($&quot;⏱️ Completed in {sw.ElapsedMilliseconds} ms&quot;);&#xA;" DisplayName="PPSA + exchangeGainOrLossPPSA1 GL vs HIST" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_70" Language="CSharp">

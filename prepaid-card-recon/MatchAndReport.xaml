        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: Build &quot;MANUAL_ENTRY&quot; sheet from matched rows =====&#xA;// Args (In): dtHistoricalReconTransactionsReportMatched (DataTable), prepaidCardWorkingsFileName (string)&#xA;&#xA;int manualRowCount = 0;&#xA;&#xA;// ---------- Helper: Flexible Date Parser ----------&#xA;System.DateTime? TryParseDate(object v)&#xA;{&#xA;    if (v == null || v == System.DBNull.Value) return null;&#xA;    var s = v.ToString().Trim();&#xA;    if (string.IsNullOrEmpty(s)) return null;&#xA;&#xA;    var formats = new[] { &quot;dd/MM/yyyy HH:mm:ss&quot;, &quot;dd/MM/yyyy HH:mm&quot;, &quot;dd/MM/yyyy&quot; };&#xA;    if (System.DateTime.TryParseExact(s, formats, System.Globalization.CultureInfo.InvariantCulture,&#xA;                                      System.Globalization.DateTimeStyles.None, out var dt)) return dt;&#xA;    if (System.DateTime.TryParse(s, out dt)) return dt;&#xA;&#xA;    if (v is System.DateTime dtObj) return dtObj;&#xA;    if (double.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var oa))&#xA;    {&#xA;        try { return System.DateTime.FromOADate(oa); } catch { }&#xA;    }&#xA;    return null;&#xA;}&#xA;&#xA;// ---------- Start Excel write ----------&#xA;using (var package = new OfficeOpenXml.ExcelPackage(new System.IO.FileInfo(prepaidCardWorkingsFileName)))&#xA;{&#xA;    Console.WriteLine(&quot;🔄 Opening Excel package: &quot; + prepaidCardWorkingsFileName);&#xA;&#xA;    // Ensure fresh MANUAL_ENTRY sheet&#xA;    var ws = package.Workbook.Worksheets&#xA;        .FirstOrDefault(w =&gt; w.Name != null &amp;&amp; w.Name.Trim().Equals(&quot;MANUAL_ENTRY&quot;, System.StringComparison.OrdinalIgnoreCase));&#xA;    if (ws != null)&#xA;    {&#xA;        Console.WriteLine(&quot;ℹ️ Found existing 'MANUAL_ENTRY' sheet — deleting it.&quot;);&#xA;        package.Workbook.Worksheets.Delete(ws);&#xA;    }&#xA;    ws = package.Workbook.Worksheets.Add(&quot;MANUAL_ENTRY&quot;);&#xA;    Console.WriteLine(&quot;✅ Created new 'MANUAL_ENTRY' worksheet.&quot;);&#xA;&#xA;    // ---- Filter MANUAL_ENTRY rows ----&#xA;    Func&lt;System.Data.DataRow, string&gt; clsOf = r =&gt;&#xA;        r.Table.Columns.Contains(&quot;BOT Classification&quot;) ? (r[&quot;BOT Classification&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;&#xA;    var manualRows = dtHistoricalReconTransactionsReportMatched&#xA;        .AsEnumerable()&#xA;        .Where(r =&gt; clsOf(r).Trim().Equals(&quot;MANUAL_ENTRY&quot;, StringComparison.OrdinalIgnoreCase))&#xA;        .ToList();&#xA;&#xA;    manualRowCount = manualRows.Count;&#xA;    Console.WriteLine($&quot;🔎 Total MANUAL_ENTRY rows to write: {manualRowCount:N0}&quot;);&#xA;&#xA;    int totalCols = dtHistoricalReconTransactionsReportMatched.Columns.Count;&#xA;&#xA;    // ---- Write headers ----&#xA;    for (int c = 0; c &lt; totalCols; c++)&#xA;        ws.Cells[1, c + 1].Value = dtHistoricalReconTransactionsReportMatched.Columns[c].ColumnName;&#xA;    ws.Cells[1, 1, 1, totalCols].Style.Font.Bold = true;&#xA;    ws.View.FreezePanes(2, 1);&#xA;&#xA;    // Speed up calculations&#xA;    var prevCalcMode = package.Workbook.CalcMode;&#xA;    package.Workbook.CalcMode = OfficeOpenXml.ExcelCalcMode.Manual;&#xA;&#xA;    if (manualRowCount &gt; 0)&#xA;    {&#xA;        Console.WriteLine(&quot;⬇️ Writing MANUAL_ENTRY data to Excel...&quot;);&#xA;&#xA;        int bookingColIdx = dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Booking Date&quot;)&#xA;            ? dtHistoricalReconTransactionsReportMatched.Columns[&quot;Booking Date&quot;].Ordinal&#xA;            : -1;&#xA;        int valueColIdx = dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Value Date&quot;)&#xA;            ? dtHistoricalReconTransactionsReportMatched.Columns[&quot;Value Date&quot;].Ordinal&#xA;            : -1;&#xA;&#xA;        var values = new object[manualRowCount, totalCols];&#xA;&#xA;        for (int r = 0; r &lt; manualRowCount; r++)&#xA;        {&#xA;            var src = manualRows[r];&#xA;            for (int c = 0; c &lt; totalCols; c++)&#xA;            {&#xA;                var raw = src[c];&#xA;                if (c == bookingColIdx || c == valueColIdx)&#xA;                {&#xA;                    var d = TryParseDate(raw);&#xA;                    values[r, c] = d.HasValue ? (object)d.Value : (raw == System.DBNull.Value ? &quot;&quot; : raw);&#xA;                }&#xA;                else&#xA;                {&#xA;                    values[r, c] = raw == System.DBNull.Value ? &quot;&quot; : raw;&#xA;                }&#xA;            }&#xA;        }&#xA;&#xA;        ws.Cells[2, 1, manualRowCount + 1, totalCols].Value = values;&#xA;        Console.WriteLine($&quot;✅ Wrote {manualRowCount:N0} MANUAL_ENTRY rows to Excel.&quot;);&#xA;&#xA;        if (bookingColIdx &gt;= 0)&#xA;        {&#xA;            int excelCol = bookingColIdx + 1;&#xA;            ws.Cells[2, excelCol, manualRowCount + 1, excelCol].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;            Console.WriteLine(&quot;📅 Applied date formatting to 'Booking Date'.&quot;);&#xA;        }&#xA;        if (valueColIdx &gt;= 0)&#xA;        {&#xA;            int excelCol = valueColIdx + 1;&#xA;            ws.Cells[2, excelCol, manualRowCount + 1, excelCol].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;            Console.WriteLine(&quot;📅 Applied date formatting to 'Value Date'.&quot;);&#xA;        }&#xA;    }&#xA;    else&#xA;    {&#xA;        Console.WriteLine(&quot;⚠️ No MANUAL_ENTRY rows found. Sheet will contain only headers.&quot;);&#xA;    }&#xA;&#xA;    // Restore calc mode and save&#xA;    package.Workbook.CalcMode = prevCalcMode;&#xA;    package.Save();&#xA;    Console.WriteLine(&quot;💾 Excel package saved with MANUAL_ENTRY sheet.&quot;);&#xA;}&#xA;&#xA;Console.WriteLine($&quot;✅ MANUAL_ENTRY sheet saved with {manualRowCount:N0} rows.&quot;);&#xA;" 
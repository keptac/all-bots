        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: PPSA-only classification via Transaction Ref No: (GL/new) =====&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport&#xA;&#xA;/////////////////////// Helpers ///////////////////////&#xA;&#xA;void PPSA_EnsureColumn(System.Data.DataTable dt, string name)&#xA;{&#xA;    if (!dt.Columns.Contains(name))&#xA;        dt.Columns.Add(new System.Data.DataColumn(name, typeof(string)) { DefaultValue = &quot;&quot; });&#xA;}&#xA;&#xA;string PPSA_GetStr(System.Data.DataRow r, string col)&#xA;{&#xA;    if (!r.Table.Columns.Contains(col)) return &quot;&quot;;&#xA;    var v = r[col];&#xA;    return (v == null || v == System.DBNull.Value) ? &quot;&quot; : v.ToString();&#xA;}&#xA;&#xA;bool PPSA_IsEmpty(string s) =&gt; string.IsNullOrWhiteSpace(s);&#xA;&#xA;bool PPSA_ClassificationLooksPPS(string s)&#xA;{&#xA;    if (PPSA_IsEmpty(s)) return true;&#xA;    s = s.Trim().ToUpperInvariant();&#xA;    return (s == &quot;PPS&quot; || s == &quot;PPSA&quot;);&#xA;}&#xA;&#xA;bool PPSA_IsGLNew(System.Data.DataRow r)&#xA;{&#xA;    if (!r.Table.Columns.Contains(&quot;Source&quot;) || !r.Table.Columns.Contains(&quot;Type&quot;))&#xA;        return false;&#xA;&#xA;    string src = PPSA_GetStr(r, &quot;Source&quot;);&#xA;    string typ = PPSA_GetStr(r, &quot;Type&quot;);&#xA;&#xA;    return src.Equals(&quot;GL&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;           typ.Equals(&quot;new&quot;, StringComparison.OrdinalIgnoreCase);&#xA;}&#xA;&#xA;void PPSA_SetTemplate(System.Data.DataRow row)&#xA;{&#xA;    if (PPSA_IsEmpty(PPSA_GetStr(row, &quot;Root Cause&quot;)))&#xA;        row[&quot;Root Cause&quot;] = &quot;Auth dump posted transactions not matched against outstanding remote-on-us txns&quot;;&#xA;&#xA;    if (PPSA_IsEmpty(PPSA_GetStr(row, &quot;Root Cause Category&quot;)))&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;&#xA;    if (PPSA_IsEmpty(PPSA_GetStr(row, &quot;Recommended Action&quot;)))&#xA;        row[&quot;Recommended Action&quot;] = &quot;Under investigation&quot;;&#xA;&#xA;    if (PPSA_IsEmpty(PPSA_GetStr(row, &quot;Action Owner&quot;)))&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Reconciliation&quot;;&#xA;}&#xA;&#xA;/////////////////////// Ensure Columns ///////////////////////&#xA;&#xA;PPSA_EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Root Cause&quot;);&#xA;PPSA_EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Root Cause Category&quot;);&#xA;PPSA_EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Recommended Action&quot;);&#xA;PPSA_EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Action Owner&quot;);&#xA;&#xA;// NEW HARD-LOCK FLAG&#xA;PPSA_EnsureColumn(dtHistoricalReconTransactionsReport, &quot;ROOT_CAUSE_PROCESSED&quot;);&#xA;&#xA;const string txnRefCol = &quot;Transaction Ref No:&quot;;&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(txnRefCol))&#xA;{&#xA;    System.Console.WriteLine($&quot;⚠️ Column '{txnRefCol}' not found — PPSA classification skipped.&quot;);&#xA;    return;&#xA;}&#xA;&#xA;/////////////////////// Counters ///////////////////////&#xA;&#xA;int totalRefPPSA = 0;&#xA;int totalRefPPSA_GLnew = 0;&#xA;int setCount = 0;&#xA;&#xA;int skippedAlreadyProcessed = 0;&#xA;int skippedSourceType = 0;&#xA;int skippedClass = 0;&#xA;int skippedAllFilled = 0;&#xA;&#xA;/////////////////////// Main Loop ///////////////////////&#xA;&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    // 🔥🔥🔥 STRICT SKIP IF ALREADY PROCESSED 🔥🔥🔥&#xA;    if (PPSA_GetStr(row, &quot;ROOT_CAUSE_PROCESSED&quot;).Equals(&quot;TRUE&quot;, StringComparison.OrdinalIgnoreCase))&#xA;    {&#xA;        skippedAlreadyProcessed++;&#xA;        continue;&#xA;    }&#xA;&#xA;    string txnRef = PPSA_GetStr(row, txnRefCol);&#xA;    if (PPSA_IsEmpty(txnRef)) continue;&#xA;&#xA;    bool hasPPSA = txnRef.IndexOf(&quot;PPSA&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0 || txnRef.IndexOf(&quot;ADPC&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0;&#xA;    if (!hasPPSA) continue;&#xA;&#xA;    totalRefPPSA++;&#xA;&#xA;    // Only apply to GL-new rows&#xA;    if (!PPSA_IsGLNew(row))&#xA;    {&#xA;        skippedSourceType++;&#xA;        continue;&#xA;    }&#xA;&#xA;    totalRefPPSA_GLnew++;&#xA;&#xA;    // classification gating&#xA;    string cls = PPSA_GetStr(row, &quot;Classification&quot;);&#xA;    if (!PPSA_ClassificationLooksPPS(cls))&#xA;    {&#xA;        skippedClass++;&#xA;        continue;&#xA;    }&#xA;&#xA;    bool allFilled =&#xA;        !PPSA_IsEmpty(PPSA_GetStr(row, &quot;Root Cause&quot;)) &amp;&amp;&#xA;        !PPSA_IsEmpty(PPSA_GetStr(row, &quot;Root Cause Category&quot;)) &amp;&amp;&#xA;        !PPSA_IsEmpty(PPSA_GetStr(row, &quot;Recommended Action&quot;)) &amp;&amp;&#xA;        !PPSA_IsEmpty(PPSA_GetStr(row, &quot;Action Owner&quot;));&#xA;&#xA;    if (allFilled)&#xA;    {&#xA;        skippedAllFilled++;&#xA;        continue;&#xA;    }&#xA;&#xA;    // Apply the template&#xA;    PPSA_SetTemplate(row);&#xA;&#xA;    // 🔥🔥🔥 NEW FLAG TO BLOCK FUTURE PROCESSING 🔥🔥🔥&#xA;    row[&quot;ROOT_CAUSE_PROCESSED&quot;] = &quot;TRUE&quot;;&#xA;&#xA;    setCount++;&#xA;}&#xA;&#xA;/////////////////////// Logs ///////////////////////&#xA;&#xA;System.Console.WriteLine($&quot;📊 PPSA refs found: {totalRefPPSA}&quot;);&#xA;System.Console.WriteLine($&quot;📦 GL/new PPSA refs: {totalRefPPSA_GLnew}&quot;);&#xA;System.Console.WriteLine($&quot;✅ PPSA template applied: {setCount}&quot;);&#xA;System.Console.WriteLine($&quot;🛑 Skipped (already ROOT_CAUSE_PROCESSED=TRUE): {skippedAlreadyProcessed}&quot;);&#xA;System.Console.WriteLine($&quot;⛔ Skipped (not GL/new): {skippedSourceType}&quot;);&#xA;System.Console.WriteLine($&quot;⛔ Skipped (classification not PPS/PPSA): {skippedClass}&quot;);&#xA;System.Console.WriteLine($&quot;⛔ Skipped (all fields already filled): {skippedAllFilled}&quot;);&#xA;" DisplayName="Root Cause GL " sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_71" Language="CSharp">

        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Inputs ===&#xA;// DataTable dtHistoricalReconTransactionsReport&#xA;// DataTable dtHistoricalReconTransactionsReportMatched&#xA;// string reconCurrency&#xA;&#xA;// ====== Guard + prep ======&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport), &quot;Input DataTable cannot be null.&quot;);&#xA;&#xA;if (dtHistoricalReconTransactionsReportMatched == null)&#xA;    dtHistoricalReconTransactionsReportMatched = dtHistoricalReconTransactionsReport.Clone();&#xA;&#xA;// Ensure &quot;Classification&quot; column exists (string) on BOTH tables&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Classification&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Classification&quot;))&#xA;    dtHistoricalReconTransactionsReportMatched.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;&#xA;string currency = reconCurrency ?? &quot;&quot;;&#xA;const decimal AMT_TOL = 0.01m;&#xA;decimal balanceTol = 0.01m;&#xA;&#xA;string debitCol  = $&quot;Debit ({currency})&quot;;&#xA;string creditCol = $&quot;Credit ({currency})&quot;;&#xA;&#xA;// ====== Helpers ======&#xA;string ToUpperSafe(object v) =&gt; (v == null ? &quot;&quot; : v.ToString()).Trim().ToUpperInvariant();&#xA;&#xA;decimal ParseAmount(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return 0m;&#xA;    string s = val.ToString().Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;).Trim();&#xA;    return decimal.TryParse(s, out var x) ? x : 0m;&#xA;}&#xA;&#xA;bool OneSided(decimal d, decimal c) =&gt; (d &gt; 0m &amp;&amp; c == 0m) || (c &gt; 0m &amp;&amp; d == 0m);&#xA;&#xA;// Normalize any PAN-ish value to masked key: FIRST6 + &quot;XXXXXX&quot; + LAST4&#xA;string NormalizePanKey(string raw)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(raw)) return &quot;&quot;;&#xA;&#xA;    string s = raw.Trim().ToUpperInvariant();&#xA;&#xA;    // 1) Already masked like 550558XXXXXX3041 or 550558******3041&#xA;    var mMasked = System.Text.RegularExpressions.Regex.Match(&#xA;        s, @&quot;\b(?&lt;first6&gt;\d{6})(?:\*{6}|X{6})(?&lt;last4&gt;\d{4})\b&quot;);&#xA;    if (mMasked.Success)&#xA;        return mMasked.Groups[&quot;first6&quot;].Value + &quot;XXXXXX&quot; + mMasked.Groups[&quot;last4&quot;].Value;&#xA;&#xA;    // 2) If we have 10-19 consecutive digits, re-mask to first6 + XXXXXX + last4&#xA;    var mDigits = System.Text.RegularExpressions.Regex.Match(s, @&quot;\b(?&lt;digits&gt;\d{10,19})\b&quot;);&#xA;    if (mDigits.Success)&#xA;    {&#xA;        var digits = mDigits.Groups[&quot;digits&quot;].Value;&#xA;        if (digits.Length &gt;= 10)&#xA;            return digits.Substring(0, 6) + &quot;XXXXXX&quot; + digits.Substring(digits.Length - 4, 4);&#xA;    }&#xA;&#xA;    return &quot;&quot;;&#xA;}&#xA;&#xA;string ExtractPANKeyFromNarration(string narr)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(narr)) return &quot;&quot;;&#xA;    // Try masked first (most GL narrations are masked)&#xA;    var mMasked = System.Text.RegularExpressions.Regex.Match(&#xA;        narr, @&quot;\b(?&lt;first6&gt;\d{6})(?:\*{6}|X{6})(?&lt;last4&gt;\d{4})\b&quot;,&#xA;        System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;    if (mMasked.Success)&#xA;        return mMasked.Groups[&quot;first6&quot;].Value + &quot;XXXXXX&quot; + mMasked.Groups[&quot;last4&quot;].Value;&#xA;&#xA;    // Fallback: any 10-19 consecutive digits&#xA;    var mDigits = System.Text.RegularExpressions.Regex.Match(&#xA;        narr, @&quot;\b(?&lt;digits&gt;\d{10,19})\b&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;    if (mDigits.Success)&#xA;    {&#xA;        var digits = mDigits.Groups[&quot;digits&quot;].Value;&#xA;        if (digits.Length &gt;= 10)&#xA;            return digits.Substring(0, 6) + &quot;XXXXXX&quot; + digits.Substring(digits.Length - 4, 4);&#xA;    }&#xA;&#xA;    return &quot;&quot;;&#xA;}&#xA;&#xA;// Prefer C_PAN (CMS); fallback to Narration extract&#xA;string GetCmsPanKey(System.Data.DataRow cms)&#xA;{&#xA;    string cpan = &quot;&quot;;&#xA;    if (cms.Table.Columns.Contains(&quot;C_PAN&quot;))&#xA;        cpan = cms[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;;&#xA;&#xA;    string key = NormalizePanKey(cpan);&#xA;    if (!string.IsNullOrEmpty(key)) return key;&#xA;&#xA;    // Fallback to Narration if C_PAN missing/empty&#xA;    string narr = cms.Table.Columns.Contains(&quot;Narration&quot;) ? (cms[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;    return ExtractPANKeyFromNarration(narr);&#xA;}&#xA;&#xA;// CMS Value Date only (±1 day tolerance used in matching)&#xA;bool TryGetValueDate(System.Data.DataRow row, out System.DateTime dateOnly)&#xA;{&#xA;    dateOnly = System.DateTime.MinValue;&#xA;    if (row == null || !row.Table.Columns.Contains(&quot;Value Date&quot;)) return false;&#xA;&#xA;    object v = row[&quot;Value Date&quot;];&#xA;    if (v is System.DateTime dt) { dateOnly = dt.Date; return true; }&#xA;&#xA;    if (v is double d)&#xA;    { try { dateOnly = System.DateTime.FromOADate(d).Date; return true; } catch { } }&#xA;&#xA;    if (v != null &amp;&amp; double.TryParse(v.ToString(), System.Globalization.NumberStyles.Float,&#xA;                                     System.Globalization.CultureInfo.InvariantCulture, out var d2))&#xA;    { try { dateOnly = System.DateTime.FromOADate(d2).Date; return true; } catch { } }&#xA;&#xA;    if (v != null &amp;&amp; System.DateTime.TryParse(v.ToString(), out var p))&#xA;    { dateOnly = p.Date; return true; }&#xA;&#xA;    return false;&#xA;}&#xA;&#xA;// Extract a date from GL Narration — many formats incl. &quot;DD...&quot; and messy times&#xA;bool TryExtractDateFromText(string text, out System.DateTime dateOnly)&#xA;{&#xA;    dateOnly = System.DateTime.MinValue;&#xA;    if (string.IsNullOrWhiteSpace(text)) return false;&#xA;&#xA;    var ci = System.Globalization.CultureInfo.InvariantCulture;&#xA;    var styles = System.Globalization.DateTimeStyles.AllowWhiteSpaces;&#xA;&#xA;    System.Text.RegularExpressions.Match m;&#xA;&#xA;    // 1) &quot;DD&quot; + d M yyyy  (e.g., &quot;DD17 02 2024&quot; or &quot;DD 17 02 2024&quot;)&#xA;    m = System.Text.RegularExpressions.Regex.Match(text, @&quot;\bDD\s*(?&lt;d&gt;\d{1,2})\s+(?&lt;m&gt;\d{1,2})\s+(?&lt;y&gt;\d{4})\b&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;    if (m.Success &amp;&amp; System.DateTime.TryParseExact($&quot;{m.Groups[&quot;d&quot;].Value} {m.Groups[&quot;m&quot;].Value} {m.Groups[&quot;y&quot;].Value}&quot;, &quot;d M yyyy&quot;, ci, styles, out var ddNum))&#xA;    { dateOnly = ddNum.Date; return true; }&#xA;&#xA;    // 2) &quot;DD&quot; + ISO (e.g., &quot;DD 2024-09-05&quot;)&#xA;    m = System.Text.RegularExpressions.Regex.Match(text, @&quot;\bDD\s*(?&lt;y&gt;\d{4})-(?&lt;m&gt;\d{2})-(?&lt;d&gt;\d{2})\b&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;    if (m.Success &amp;&amp; System.DateTime.TryParseExact($&quot;{m.Groups[&quot;y&quot;].Value}-{m.Groups[&quot;m&quot;].Value}-{m.Groups[&quot;d&quot;].Value}&quot;, &quot;yyyy-MM-dd&quot;, ci, styles, out var ddIso))&#xA;    { dateOnly = ddIso.Date; return true; }&#xA;&#xA;    // 3) &quot;DD&quot; + dd.MM.yyyy (e.g., &quot;DD 30.05.2025&quot;)&#xA;    m = System.Text.RegularExpressions.Regex.Match(text, @&quot;\bDD\s*(?&lt;d&gt;\d{1,2})\.(?&lt;m&gt;\d{1,2})\.(?&lt;y&gt;\d{4})\b&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;    if (m.Success &amp;&amp; System.DateTime.TryParseExact($&quot;{m.Groups[&quot;d&quot;].Value}.{m.Groups[&quot;m&quot;].Value}.{m.Groups[&quot;y&quot;].Value}&quot;, &quot;d.M.yyyy&quot;, ci, styles, out var ddDot))&#xA;    { dateOnly = ddDot.Date; return true; }&#xA;&#xA;    // 4) ISO date (optionally followed by spaced time): &quot;2024-09-05 00 00 00 0&quot;&#xA;    m = System.Text.RegularExpressions.Regex.Match(text, @&quot;\b(?&lt;y&gt;\d{4})-(?&lt;m&gt;\d{2})-(?&lt;d&gt;\d{2})(?:[ T]\d{2}(?::?\s?\d{2}){1,2}(?:\s?\d{1,3})?)?\b&quot;);&#xA;    if (m.Success &amp;&amp; System.DateTime.TryParseExact($&quot;{m.Groups[&quot;y&quot;].Value}-{m.Groups[&quot;m&quot;].Value}-{m.Groups[&quot;d&quot;].Value}&quot;, &quot;yyyy-MM-dd&quot;, ci, styles, out var iso))&#xA;    { dateOnly = iso.Date; return true; }&#xA;&#xA;    // 5) dd.MM.yyyy&#xA;    m = System.Text.RegularExpressions.Regex.Match(text, @&quot;\b(?&lt;d&gt;\d{1,2})\.(?&lt;m&gt;\d{1,2})\.(?&lt;y&gt;\d{4})\b&quot;);&#xA;    if (m.Success &amp;&amp; System.DateTime.TryParseExact($&quot;{m.Groups[&quot;d&quot;].Value}.{m.Groups[&quot;m&quot;].Value}.{m.Groups[&quot;y&quot;].Value}&quot;, &quot;d.M.yyyy&quot;, ci, styles, out var dotDMY))&#xA;    { dateOnly = dotDMY.Date; return true; }&#xA;&#xA;    // 6) d/M/yyyy or M/d/yyyy&#xA;    m = System.Text.RegularExpressions.Regex.Match(text, @&quot;\b\d{1,2}/\d{1,2}/\d{4}\b&quot;);&#xA;    if (m.Success &amp;&amp; System.DateTime.TryParseExact(m.Value,&#xA;            new[] { &quot;d/M/yyyy&quot;, &quot;M/d/yyyy&quot;, &quot;dd/MM/yyyy&quot;, &quot;MM/dd/yyyy&quot; }, ci, styles, out var slash))&#xA;    { dateOnly = slash.Date; return true; }&#xA;&#xA;    // 7) d-M-yyyy / dd-MM-yyyy (and US M-d)&#xA;    m = System.Text.RegularExpressions.Regex.Match(text, @&quot;\b\d{1,2}-\d{1,2}-\d{4}\b&quot;);&#xA;    if (m.Success &amp;&amp; System.DateTime.TryParseExact(m.Value,&#xA;            new[] { &quot;d-M-yyyy&quot;, &quot;dd-MM-yyyy&quot;, &quot;M-d-yyyy&quot;, &quot;MM-dd-yyyy&quot; }, ci, styles, out var dashDMY))&#xA;    { dateOnly = dashDMY.Date; return true; }&#xA;&#xA;    // 8) 10-May-2025 / 10 May 2025 / May 10, 2025&#xA;    m = System.Text.RegularExpressions.Regex.Match(text, @&quot;\b\d{1,2}-[A-Za-z]{3}-\d{4}\b&quot;);&#xA;    if (m.Success &amp;&amp; System.DateTime.TryParseExact(m.Value, new[] { &quot;d-MMM-yyyy&quot;, &quot;dd-MMM-yyyy&quot; }, ci, styles, out var dmyText))&#xA;    { dateOnly = dmyText.Date; return true; }&#xA;&#xA;    m = System.Text.RegularExpressions.Regex.Match(text, @&quot;\b\d{1,2}\s+[A-Za-z]{3,}\s+\d{4}\b&quot;);&#xA;    if (m.Success &amp;&amp; System.DateTime.TryParseExact(m.Value, new[] { &quot;d MMM yyyy&quot;, &quot;dd MMM yyyy&quot;, &quot;d MMMM yyyy&quot;, &quot;dd MMMM yyyy&quot; }, ci, styles, out var dmyWords))&#xA;    { dateOnly = dmyWords.Date; return true; }&#xA;&#xA;    m = System.Text.RegularExpressions.Regex.Match(text, @&quot;\b[A-Za-z]{3,}\s+\d{1,2},\s*\d{4}\b&quot;);&#xA;    if (m.Success &amp;&amp; System.DateTime.TryParseExact(m.Value, new[] { &quot;MMM d, yyyy&quot;, &quot;MMMM d, yyyy&quot;, &quot;MMM dd, yyyy&quot;, &quot;MMMM dd, yyyy&quot; }, ci, styles, out var mdyWords))&#xA;    { dateOnly = mdyWords.Date; return true; }&#xA;&#xA;    // 9) Compact yyyymmdd&#xA;    m = System.Text.RegularExpressions.Regex.Match(text, @&quot;\b(20\d{2})(\d{2})(\d{2})\b&quot;);&#xA;    if (m.Success &amp;&amp; System.DateTime.TryParseExact($&quot;{m.Groups[1].Value}{m.Groups[2].Value}{m.Groups[3].Value}&quot;, &quot;yyyyMMdd&quot;, ci, styles, out var ymd))&#xA;    { dateOnly = ymd.Date; return true; }&#xA;&#xA;    // 10) Bare &quot;17 02 2024&quot;&#xA;    m = System.Text.RegularExpressions.Regex.Match(text, @&quot;\b(?&lt;d&gt;\d{1,2})\s+(?&lt;m&gt;\d{1,2})\s+(?&lt;y&gt;\d{4})\b&quot;);&#xA;    if (m.Success &amp;&amp; System.DateTime.TryParseExact($&quot;{m.Groups[&quot;d&quot;].Value} {m.Groups[&quot;m&quot;].Value} {m.Groups[&quot;y&quot;].Value}&quot;, &quot;d M yyyy&quot;, ci, styles, out var bareDMY))&#xA;    { dateOnly = bareDMY.Date; return true; }&#xA;&#xA;    // Final loose parse&#xA;    if (System.DateTime.TryParse(text, ci, styles, out var any))&#xA;    { dateOnly = any.Date; return true; }&#xA;&#xA;    return false;&#xA;}&#xA;&#xA;bool HasDateInText(string text) =&gt; TryExtractDateFromText(text, out _);&#xA;&#xA;// Amount accessors bound to selected currency columns&#xA;System.Func&lt;System.Data.DataRow, decimal&gt; Debit = row =&gt;&#xA;    row.Table.Columns.Contains(debitCol) ? ParseAmount(row[debitCol]) : 0m;&#xA;System.Func&lt;System.Data.DataRow, decimal&gt; Credit = row =&gt;&#xA;    row.Table.Columns.Contains(creditCol) ? ParseAmount(row[creditCol]) : 0m;&#xA;&#xA;// ---- BEFORE totals (for Δ identity) ----&#xA;decimal beforeDebit = 0m, beforeCredit = 0m;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    beforeDebit  += Debit(r);&#xA;    beforeCredit += Credit(r);&#xA;}&#xA;decimal beforeDiff = beforeDebit - beforeCredit;&#xA;System.Console.WriteLine($&quot;[BAL] BEFORE — Debit ({currency}): {beforeDebit:N2}, Credit ({currency}): {beforeCredit:N2}, Δ(D−C): {beforeDiff:N2}&quot;);&#xA;&#xA;// ====== Build candidate lists (Narration-only for GL; CMS from Narration but PAN prefers C_PAN) ======&#xA;var glCandidates = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;var cmsCandidates = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var row = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    if (!row.Table.Columns.Contains(&quot;Narration&quot;)) continue;&#xA;&#xA;    string narr = row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string narrUpper = ToUpperSafe(narr);&#xA;&#xA;    decimal d = Debit(row);&#xA;    decimal c = Credit(row);&#xA;    if (!OneSided(d, c)) continue;&#xA;&#xA;    // GL: Narration starts with &quot;Journal&quot; and has a date in Narration&#xA;    if (narrUpper.StartsWith(&quot;JOURNAL&quot;) &amp;&amp; HasDateInText(narr))&#xA;        glCandidates.Add(row);&#xA;    // CMS: Narration starts with &quot;Refund&quot;&#xA;    else if (narrUpper.StartsWith(&quot;REFUND&quot;))&#xA;        cmsCandidates.Add(row);&#xA;}&#xA;&#xA;System.Console.WriteLine($&quot;GL refund candidates: {glCandidates.Count}&quot;);&#xA;System.Console.WriteLine($&quot;CMS refund candidates: {cmsCandidates.Count}&quot;);&#xA;&#xA;// ====== Index CMS by (C_PAN (preferred) or Narration PAN key, ValueDate) ======&#xA;var cmsIndex = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;var consumedCms = new System.Collections.Generic.HashSet&lt;System.Data.DataRow&gt;();&#xA;&#xA;for (int i = 0; i &lt; cmsCandidates.Count; i++)&#xA;{&#xA;    var cms = cmsCandidates[i];&#xA;&#xA;    string panKey = GetCmsPanKey(cms); // &lt;-- C_PAN preferred&#xA;    if (string.IsNullOrEmpty(panKey)) continue;&#xA;&#xA;    if (!TryGetValueDate(cms, out var cmsValueDate)) continue;&#xA;&#xA;    string key = panKey + &quot;|&quot; + cmsValueDate.ToString(&quot;yyyy-MM-dd&quot;);&#xA;    if (!cmsIndex.TryGetValue(key, out var list))&#xA;        cmsIndex[key] = list = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;    list.Add(cms);&#xA;}&#xA;&#xA;// ====== Match loop (GL PAN key from Narration + GL date vs CMS Value Date ±1 day) ======&#xA;var rowsToRemove = new System.Collections.Generic.HashSet&lt;System.Data.DataRow&gt;();&#xA;int matchedPairs = 0;&#xA;decimal matchedDebitTotal = 0m;&#xA;decimal matchedCreditTotal = 0m;&#xA;&#xA;for (int i = 0; i &lt; glCandidates.Count; i++)&#xA;{&#xA;    var gl = glCandidates[i];&#xA;    string glNarr = gl[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;;&#xA;    string glPanKey = ExtractPANKeyFromNarration(glNarr);&#xA;    if (string.IsNullOrEmpty(glPanKey)) continue;&#xA;&#xA;    if (!TryExtractDateFromText(glNarr, out var glNarrDate)) continue;&#xA;&#xA;    decimal glD = Debit(gl);&#xA;    decimal glC = Credit(gl);&#xA;    bool glIsDebit = glD &gt; 0m;&#xA;    decimal glAmtAbs = glIsDebit ? glD : glC;&#xA;    if (glAmtAbs &lt;= 0m) continue;&#xA;&#xA;    bool matched = false;&#xA;    for (int offset = -1; offset &lt;= 1 &amp;&amp; !matched; offset++)&#xA;    {&#xA;        var dt = glNarrDate.Date.AddDays(offset).ToString(&quot;yyyy-MM-dd&quot;);&#xA;        string key = glPanKey + &quot;|&quot; + dt;&#xA;&#xA;        if (!cmsIndex.TryGetValue(key, out var bucket)) continue;&#xA;&#xA;        for (int k = 0; k &lt; bucket.Count &amp;&amp; !matched; k++)&#xA;        {&#xA;            var cms = bucket[k];&#xA;            if (consumedCms.Contains(cms)) continue;&#xA;&#xA;            decimal cmsD = Debit(cms);&#xA;            decimal cmsC = Credit(cms);&#xA;            bool cmsIsDebit = cmsD &gt; 0m;&#xA;            if (glIsDebit == cmsIsDebit) continue; // opposite sides&#xA;&#xA;            decimal cmsAmtAbs = cmsIsDebit ? cmsD : cmsC;&#xA;            if (System.Math.Abs(glAmtAbs - cmsAmtAbs) &gt; AMT_TOL) continue;&#xA;&#xA;            // MATCH FOUND — copy both rows and tag&#xA;            int glIdx = dtHistoricalReconTransactionsReportMatched.Rows.Count;&#xA;            dtHistoricalReconTransactionsReportMatched.ImportRow(gl);&#xA;            dtHistoricalReconTransactionsReportMatched.Rows[glIdx][&quot;Classification&quot;] = &quot;REFUND&quot;;&#xA;&#xA;            int cmsIdx = dtHistoricalReconTransactionsReportMatched.Rows.Count;&#xA;            dtHistoricalReconTransactionsReportMatched.ImportRow(cms);&#xA;            dtHistoricalReconTransactionsReportMatched.Rows[cmsIdx][&quot;Classification&quot;] = &quot;REFUND&quot;;&#xA;&#xA;            // Totals&#xA;            if (glIsDebit)&#xA;            {&#xA;                matchedDebitTotal  += glAmtAbs;&#xA;                matchedCreditTotal += cmsIsDebit ? cmsD : cmsC;&#xA;            }&#xA;            else&#xA;            {&#xA;                matchedCreditTotal += glAmtAbs;&#xA;                matchedDebitTotal  += cmsIsDebit ? cmsD : cmsC;&#xA;            }&#xA;&#xA;            rowsToRemove.Add(gl);&#xA;            rowsToRemove.Add(cms);&#xA;            consumedCms.Add(cms);&#xA;            matchedPairs++;&#xA;&#xA;            matched = true;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// ====== Post-pass: tag unmatched GL candidates ======&#xA;for (int i = 0; i &lt; glCandidates.Count; i++)&#xA;{&#xA;    var gl = glCandidates[i];&#xA;    if (!rowsToRemove.Contains(gl))&#xA;    {&#xA;        try&#xA;        {&#xA;            var cur = gl.Table.Columns.Contains(&quot;Classification&quot;) ? (gl[&quot;Classification&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;            if (string.IsNullOrWhiteSpace(cur))&#xA;                gl[&quot;Classification&quot;] = &quot;REFUND_UNMATCHED_GL&quot;;&#xA;        }&#xA;        catch { /* ignore */ }&#xA;    }&#xA;}&#xA;&#xA;// ---- REMOVED totals (compute BEFORE physical removal) ----&#xA;decimal removedDebit = 0m, removedCredit = 0m;&#xA;foreach (var r in rowsToRemove)&#xA;{&#xA;    removedDebit  += Debit(r);&#xA;    removedCredit += Credit(r);&#xA;}&#xA;&#xA;// ====== Remove matched rows from working table ======&#xA;foreach (var row in rowsToRemove)&#xA;{&#xA;    try&#xA;    {&#xA;        if (row != null &amp;&amp;&#xA;            row.Table == dtHistoricalReconTransactionsReport &amp;&amp;&#xA;            row.RowState != System.Data.DataRowState.Detached)&#xA;        {&#xA;            dtHistoricalReconTransactionsReport.Rows.Remove(row);&#xA;        }&#xA;    }&#xA;    catch { /* ignore */ }&#xA;}&#xA;&#xA;// ---- AFTER totals + Δ identity check ----&#xA;decimal afterDebit = 0m, afterCredit = 0m;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    afterDebit  += Debit(r);&#xA;    afterCredit += Credit(r);&#xA;}&#xA;decimal afterDiff   = afterDebit - afterCredit;&#xA;decimal removedDiff = removedDebit - removedCredit;&#xA;decimal lhs = beforeDiff;&#xA;decimal rhs = afterDiff + removedDiff;&#xA;decimal gap = System.Math.Abs(lhs - rhs);&#xA;&#xA;// ====== Summary ======&#xA;System.Console.WriteLine();&#xA;System.Console.WriteLine(&quot;📝 Summary (Refunds via Narration/C_PAN + CMS Value Date ±1 day):&quot;);&#xA;System.Console.WriteLine($&quot;GL refund candidates: {glCandidates.Count}&quot;);&#xA;System.Console.WriteLine($&quot;CMS refund candidates: {cmsCandidates.Count}&quot;);&#xA;System.Console.WriteLine($&quot;Matched pairs: {matchedPairs}&quot;);&#xA;System.Console.WriteLine($&quot;Matched Debit ({currency}):  {matchedDebitTotal:N2}&quot;);&#xA;System.Console.WriteLine($&quot;Matched Credit ({currency}): {matchedCreditTotal:N2}&quot;);&#xA;System.Console.WriteLine($&quot;Unmatched GL tagged as REFUND_UNMATCHED_GL: {glCandidates.Count - rowsToRemove.Count(r =&gt; glCandidates.Contains(r))}&quot;);&#xA;&#xA;System.Console.WriteLine();&#xA;System.Console.WriteLine(&quot;🔎 Balance check (Δ = Debit − Credit):&quot;);&#xA;System.Console.WriteLine($&quot;  BEFORE:  Debit {beforeDebit:N2}  | Credit {beforeCredit:N2}  | Δ_before = {beforeDiff:N2}&quot;);&#xA;System.Console.WriteLine($&quot;  REMOVED: Debit {removedDebit:N2} | Credit {removedCredit:N2} | Δ_removed = {removedDiff:N2}&quot;);&#xA;System.Console.WriteLine($&quot;  AFTER:   Debit {afterDebit:N2}  | Credit {afterCredit:N2}  | Δ_after  = {afterDiff:N2}&quot;);&#xA;&#xA;if (gap &lt;= balanceTol)&#xA;    System.Console.WriteLine($&quot;✅ Consistency OK: Δ_before ({lhs:N2}) ≈ Δ_after + Δ_removed ({rhs:N2}) within ±{balanceTol:N2}.&quot;);&#xA;else&#xA;{&#xA;    System.Console.WriteLine($&quot;⚠️ Consistency MISMATCH: Δ_before ({lhs:N2}) vs (Δ_after + Δ_removed) ({rhs:N2}); gap = {gap:N2} (&gt; ±{balanceTol:N2}).&quot;);&#xA;    System.Console.WriteLine(&quot;   Tip: verify GL date extraction, CMS Value Date, and PAN key normalization.&quot;);&#xA;}&#xA;" DisplayName="Refund" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_45" Language="CSharp">

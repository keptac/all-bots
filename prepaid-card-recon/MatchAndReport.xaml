        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: Build &quot;PPSP&quot; sheet from matched rows (PPSP only, LINQ-free) =====&#xA;// Args (In): dtHistoricalReconTransactionsReportMatched (DataTable), prepaidCardWorkingsFileName (string)&#xA;&#xA;int ppsaRowCount = 0;&#xA;&#xA;// EPPlus license (safe to set)&#xA;OfficeOpenXml.ExcelPackage.LicenseContext = OfficeOpenXml.LicenseContext.NonCommercial;&#xA;&#xA;// --- Open Excel (shared across all classification-sheet writers; opened once, saved once at end of pipeline) ---&#xA;if (sharedWorkingsPackage == null)&#xA;{&#xA;    sharedWorkingsPackage = new OfficeOpenXml.ExcelPackage(new System.IO.FileInfo(prepaidCardWorkingsFileName));&#xA;    sharedWorkingsPackage.Workbook.CalcMode = OfficeOpenXml.ExcelCalcMode.Manual;&#xA;}&#xA;var package = sharedWorkingsPackage;&#xA;{&#xA;    // --- Delete 'PPSP' sheet BY NAME (no numeric index access anywhere) ---&#xA;    try&#xA;    {&#xA;        var existing = package.Workbook.Worksheets[&quot;PPSP&quot;]; // string indexer is safe; returns null if not found&#xA;        if (existing != null)&#xA;        {&#xA;            System.Console.WriteLine(&quot;ℹ️ Found existing 'PPSP' sheet — deleting it.&quot;);&#xA;            package.Workbook.Worksheets.Delete(&quot;PPSP&quot;); // delete by name, NOT by index&#xA;        }&#xA;    }&#xA;    catch (System.Exception exDel)&#xA;    {&#xA;        System.Console.WriteLine(&quot;⚠️ Couldn't delete 'PPSP' by name: &quot; + exDel.Message);&#xA;        // Keep going; we'll still add a fresh one.&#xA;    }&#xA;&#xA;    // --- Add fresh 'PPSP' sheet ---&#xA;    var wsRaw = package.Workbook.Worksheets.Add(&quot;PPSP&quot;);&#xA;    System.Console.WriteLine(&quot;✅ Created new 'PPSP' worksheet.&quot;);&#xA;&#xA;    // --- Safety checks ---&#xA;    if (dtHistoricalReconTransactionsReportMatched == null)&#xA;    {&#xA;        System.Console.WriteLine(&quot;⚠️ dtHistoricalReconTransactionsReportMatched is null. Aborting.&quot;);&#xA;        return;&#xA;    }&#xA;&#xA;    int totalCols = dtHistoricalReconTransactionsReportMatched.Columns.Count;&#xA;&#xA;    // --- Headers&#xA;    for (int c = 0; c &lt; totalCols; c++)&#xA;        wsRaw.Cells[1, c + 1].Value = dtHistoricalReconTransactionsReportMatched.Columns[c].ColumnName;&#xA;    System.Console.WriteLine(&quot;📝 Headers written.&quot;);&#xA;&#xA;    // --- Filter strictly to PPSP rows (no LINQ)&#xA;    bool hasClassification = dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Classification&quot;);&#xA;    if (!hasClassification)&#xA;        System.Console.WriteLine(&quot;⚠️ Column 'Classification' not found. No rows will be selected.&quot;);&#xA;&#xA;    var matchedRows = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;&#xA;    // Diagnostics: classification distribution&#xA;    var classCounts = new System.Collections.Generic.Dictionary&lt;string, int&gt;(System.StringComparer.OrdinalIgnoreCase);&#xA;&#xA;    for (int i = 0; i &lt; dtHistoricalReconTransactionsReportMatched.Rows.Count; i++)&#xA;    {&#xA;        var row = dtHistoricalReconTransactionsReportMatched.Rows[i];&#xA;&#xA;        string cls = &quot;&quot;;&#xA;        if (hasClassification) cls = row[&quot;Classification&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Classification&quot;].ToString();&#xA;&#xA;        string clsTrim = (cls ?? &quot;&quot;).Trim();&#xA;        string clsNorm = clsTrim.ToUpperInvariant();&#xA;&#xA;        if (clsTrim.Length &gt; 0)&#xA;        {&#xA;            if (!classCounts.ContainsKey(clsTrim)) classCounts[clsTrim] = 0;&#xA;            classCounts[clsTrim]++;&#xA;        }&#xA;&#xA;        if (clsNorm == &quot;PPSP&quot;)&#xA;            matchedRows.Add(row);&#xA;    }&#xA;&#xA;    if (classCounts.Count == 0)&#xA;        System.Console.WriteLine(&quot;ℹ️ No non-empty Classification values found in matched table.&quot;);&#xA;    else&#xA;    {&#xA;        System.Console.WriteLine(&quot;📊 Classification distribution in matched table:&quot;);&#xA;        foreach (var kv in classCounts)&#xA;            System.Console.WriteLine(&quot;   • '&quot; + kv.Key + &quot;': &quot; + kv.Value);&#xA;    }&#xA;&#xA;    ppsaRowCount = matchedRows.Count;&#xA;    System.Console.WriteLine(&quot;🔍 Selected &quot; + ppsaRowCount.ToString(&quot;N0&quot;) + &quot; PPSP rows for sheet.&quot;);&#xA;&#xA;    // --- Speed: turn off calc while we bulk-write ---&#xA;    package.Workbook.CalcMode = OfficeOpenXml.ExcelCalcMode.Manual;&#xA;&#xA;    if (ppsaRowCount &gt; 0)&#xA;    {&#xA;        System.Console.WriteLine(&quot;⬇️ Writing row data to Excel...&quot;);&#xA;&#xA;        int bookingColIdx = dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Booking Date&quot;)&#xA;            ? dtHistoricalReconTransactionsReportMatched.Columns[&quot;Booking Date&quot;].Ordinal&#xA;            : -1;&#xA;        int valueColIdx = dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Value Date&quot;)&#xA;            ? dtHistoricalReconTransactionsReportMatched.Columns[&quot;Value Date&quot;].Ordinal&#xA;            : -1;&#xA;&#xA;        var values = new object[ppsaRowCount, totalCols];&#xA;        var formats = new string[] { &quot;dd/MM/yyyy HH:mm:ss&quot;, &quot;dd/MM/yyyy HH:mm&quot;, &quot;dd/MM/yyyy&quot; };&#xA;&#xA;        for (int r = 0; r &lt; ppsaRowCount; r++)&#xA;        {&#xA;            var src = matchedRows[r];&#xA;&#xA;            for (int c = 0; c &lt; totalCols; c++)&#xA;            {&#xA;                object raw = src[c];&#xA;                bool isDateCol = (c == bookingColIdx || c == valueColIdx);&#xA;&#xA;                if (!isDateCol)&#xA;                {&#xA;                    values[r, c] = (raw == System.DBNull.Value ? &quot;&quot; : raw);&#xA;                    continue;&#xA;                }&#xA;&#xA;                // --- Coerce date&#xA;                if (raw == null || raw == System.DBNull.Value)&#xA;                {&#xA;                    values[r, c] = &quot;&quot;;&#xA;                }&#xA;                else if (raw is System.DateTime)&#xA;                {&#xA;                    values[r, c] = (System.DateTime)raw;&#xA;                }&#xA;                else&#xA;                {&#xA;                    string s = raw.ToString().Trim();&#xA;                    if (s.Length == 0)&#xA;                    {&#xA;                        values[r, c] = &quot;&quot;;&#xA;                    }&#xA;                    else&#xA;                    {&#xA;                        System.DateTime dt;&#xA;                        if (System.DateTime.TryParseExact(&#xA;                                s, formats,&#xA;                                System.Globalization.CultureInfo.InvariantCulture,&#xA;                                System.Globalization.DateTimeStyles.None,&#xA;                                out dt))&#xA;                        {&#xA;                            values[r, c] = dt;&#xA;                        }&#xA;                        else if (System.DateTime.TryParse(s, out dt))&#xA;                        {&#xA;                            values[r, c] = dt;&#xA;                        }&#xA;                        else&#xA;                        {&#xA;                            double oa;&#xA;                            if (double.TryParse(&#xA;                                    s,&#xA;                                    System.Globalization.NumberStyles.Any,&#xA;                                    System.Globalization.CultureInfo.InvariantCulture,&#xA;                                    out oa))&#xA;                            {&#xA;                                try { values[r, c] = System.DateTime.FromOADate(oa); }&#xA;                                catch { values[r, c] = s; }&#xA;                            }&#xA;                            else&#xA;                            {&#xA;                                values[r, c] = s;&#xA;                            }&#xA;                        }&#xA;                    }&#xA;                }&#xA;            }&#xA;        }&#xA;&#xA;        wsRaw.Cells[2, 1, ppsaRowCount + 1, totalCols].Value = values;&#xA;        System.Console.WriteLine(&quot;✅ Wrote &quot; + ppsaRowCount.ToString(&quot;N0&quot;) + &quot; rows into sheet.&quot;);&#xA;&#xA;        // --- Date formats&#xA;        if (bookingColIdx &gt;= 0)&#xA;            wsRaw.Cells[2, bookingColIdx + 1, ppsaRowCount + 1, bookingColIdx + 1].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;        if (valueColIdx &gt;= 0)&#xA;            wsRaw.Cells[2, valueColIdx + 1, ppsaRowCount + 1, valueColIdx + 1].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;    }&#xA;    else&#xA;    {&#xA;        System.Console.WriteLine(&quot;⚠️ No PPSP rows found. Sheet will contain only headers.&quot;);&#xA;    }&#xA;&#xA;    // --- Cosmetics&#xA;    wsRaw.View.FreezePanes(2, 1);&#xA;    wsRaw.Cells[1, 1, 1, totalCols].Style.Font.Bold = true;&#xA;&#xA;}&#xA;&#xA;// Final summary log&#xA;System.Console.WriteLine(&quot;✅ PPSP sheet built with &quot; + ppsaRowCount.ToString(&quot;N0&quot;) + &quot; rows (save deferred to end of pipeline).&quot;);&#xA;" DisplayName="Write PSSP" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_78" Language="CSharp">

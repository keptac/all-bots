        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: Build &quot;AGW&quot; sheet from matched rows (EXACT + FX) =====&#xA;// Args (In): dtHistoricalReconTransactionsReportMatched (DataTable), prepaidCardWorkingsFileName (string)&#xA;&#xA;int agwRowCount = 0;&#xA;&#xA;System.DateTime? TryParseDate(object v)&#xA;{&#xA;    if (v == null || v == System.DBNull.Value) return null;&#xA;    var s = v.ToString().Trim();&#xA;    if (string.IsNullOrEmpty(s)) return null;&#xA;&#xA;    var formats = new[] { &quot;dd/MM/yyyy HH:mm:ss&quot;, &quot;dd/MM/yyyy HH:mm&quot;, &quot;dd/MM/yyyy&quot; };&#xA;    if (System.DateTime.TryParseExact(s, formats, System.Globalization.CultureInfo.InvariantCulture,&#xA;                                      System.Globalization.DateTimeStyles.None, out var dt)) return dt;&#xA;    if (System.DateTime.TryParse(s, out dt)) return dt;&#xA;&#xA;    if (v is System.DateTime dtObj) return dtObj;&#xA;    if (double.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var oa))&#xA;    {&#xA;        try { return System.DateTime.FromOADate(oa); } catch { }&#xA;    }&#xA;    return null;&#xA;}&#xA;&#xA;using (var package = new OfficeOpenXml.ExcelPackage(new System.IO.FileInfo(prepaidCardWorkingsFileName)))&#xA;{&#xA;    Console.WriteLine(&quot;🔄 Opening Excel package: &quot; + prepaidCardWorkingsFileName);&#xA;&#xA;    // Ensure fresh sheet&#xA;    var ws = package.Workbook.Worksheets&#xA;        .FirstOrDefault(w =&gt; w.Name != null &amp;&amp; w.Name.Trim().Equals(&quot;AGW&quot;, System.StringComparison.OrdinalIgnoreCase));&#xA;    if (ws != null)&#xA;    {&#xA;        Console.WriteLine(&quot;ℹ️ Found existing 'AGW' sheet — deleting it.&quot;);&#xA;        package.Workbook.Worksheets.Delete(ws);&#xA;    }&#xA;    ws = package.Workbook.Worksheets.Add(&quot;AGW&quot;);&#xA;    Console.WriteLine(&quot;✅ Created new 'AGW' worksheet.&quot;);&#xA;&#xA;    // ---- Filter rows: Classification in {AGW, AGW_EXACT, AGW_FX} ----&#xA;    Func&lt;System.Data.DataRow, string&gt; clsOf = r =&gt;&#xA;        r.Table.Columns.Contains(&quot;Classification&quot;) ? (r[&quot;Classification&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;&#xA;    var matchedAgwRows = dtHistoricalReconTransactionsReportMatched&#xA;        .AsEnumerable()&#xA;        .Where(r =&gt; {&#xA;            var cls = clsOf(r).Trim();&#xA;            return cls.Equals(&quot;AGW&quot;, System.StringComparison.OrdinalIgnoreCase)&#xA;                || cls.Equals(&quot;AGW_EXACT&quot;, System.StringComparison.OrdinalIgnoreCase)&#xA;                || cls.Equals(&quot;AGW_FX&quot;, System.StringComparison.OrdinalIgnoreCase);&#xA;        })&#xA;        .ToList();&#xA;&#xA;    // Diagnostics by class&#xA;    int cntAGW      = dtHistoricalReconTransactionsReportMatched.AsEnumerable().Count(r =&gt; clsOf(r).Trim().Equals(&quot;AGW&quot;, StringComparison.OrdinalIgnoreCase));&#xA;    int cntAGWExact = dtHistoricalReconTransactionsReportMatched.AsEnumerable().Count(r =&gt; clsOf(r).Trim().Equals(&quot;AGW_EXACT&quot;, StringComparison.OrdinalIgnoreCase));&#xA;    int cntAGWFX    = dtHistoricalReconTransactionsReportMatched.AsEnumerable().Count(r =&gt; clsOf(r).Trim().Equals(&quot;AGW_FX&quot;, StringComparison.OrdinalIgnoreCase));&#xA;&#xA;    agwRowCount = matchedAgwRows.Count;&#xA;    Console.WriteLine($&quot;🔍 Found by class — AGW: {cntAGW:N0}, AGW_EXACT: {cntAGWExact:N0}, AGW_FX: {cntAGWFX:N0}&quot;);&#xA;    Console.WriteLine($&quot;🔎 Total rows to write to 'AGW': {agwRowCount:N0}&quot;);&#xA;&#xA;    int totalCols = dtHistoricalReconTransactionsReportMatched.Columns.Count;&#xA;&#xA;    // Headers&#xA;    for (int c = 0; c &lt; totalCols; c++)&#xA;        ws.Cells[1, c + 1].Value = dtHistoricalReconTransactionsReportMatched.Columns[c].ColumnName;&#xA;    ws.Cells[1, 1, 1, totalCols].Style.Font.Bold = true;&#xA;    ws.View.FreezePanes(2, 1);&#xA;&#xA;    // Speed up&#xA;    var prevCalcMode = package.Workbook.CalcMode;&#xA;    package.Workbook.CalcMode = OfficeOpenXml.ExcelCalcMode.Manual;&#xA;&#xA;    if (agwRowCount &gt; 0)&#xA;    {&#xA;        Console.WriteLine(&quot;⬇️ Writing row data to Excel...&quot;);&#xA;&#xA;        int bookingColIdx = dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Booking Date&quot;)&#xA;            ? dtHistoricalReconTransactionsReportMatched.Columns[&quot;Booking Date&quot;].Ordinal&#xA;            : -1;&#xA;        int valueColIdx = dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Value Date&quot;)&#xA;            ? dtHistoricalReconTransactionsReportMatched.Columns[&quot;Value Date&quot;].Ordinal&#xA;            : -1;&#xA;&#xA;        var values = new object[agwRowCount, totalCols];&#xA;&#xA;        for (int r = 0; r &lt; agwRowCount; r++)&#xA;        {&#xA;            var src = matchedAgwRows[r];&#xA;&#xA;            for (int c = 0; c &lt; totalCols; c++)&#xA;            {&#xA;                var raw = src[c];&#xA;&#xA;                if (c == bookingColIdx || c == valueColIdx)&#xA;                {&#xA;                    var d = TryParseDate(raw);&#xA;                    values[r, c] = d.HasValue ? (object)d.Value : (raw == System.DBNull.Value ? &quot;&quot; : raw);&#xA;                }&#xA;                else&#xA;                {&#xA;                    values[r, c] = raw == System.DBNull.Value ? &quot;&quot; : raw;&#xA;                }&#xA;            }&#xA;        }&#xA;&#xA;        ws.Cells[2, 1, agwRowCount + 1, totalCols].Value = values;&#xA;        Console.WriteLine($&quot;✅ Wrote {agwRowCount:N0} rows into 'AGW'.&quot;);&#xA;        &#xA;        if (bookingColIdx &gt;= 0)&#xA;        {&#xA;            int excelCol = bookingColIdx + 1;&#xA;            ws.Cells[2, excelCol, agwRowCount + 1, excelCol].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;            Console.WriteLine(&quot;📅 Applied date formatting to 'Booking Date'.&quot;);&#xA;        }&#xA;        if (valueColIdx &gt;= 0)&#xA;        {&#xA;            int excelCol = valueColIdx + 1;&#xA;            ws.Cells[2, excelCol, agwRowCount + 1, excelCol].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;            Console.WriteLine(&quot;📅 Applied date formatting to 'Value Date'.&quot;);&#xA;        }&#xA;    }&#xA;    else&#xA;    {&#xA;        Console.WriteLine(&quot;⚠️ No AGW/AGW_EXACT/AGW_FX rows found. Sheet will contain only headers.&quot;);&#xA;    }&#xA;&#xA;    // Restore calc mode and save&#xA;    package.Workbook.CalcMode = prevCalcMode;&#xA;    package.Save();&#xA;    Console.WriteLine(&quot;💾 Excel package saved.&quot;);&#xA;}&#xA;&#xA;// Final summary&#xA;Console.WriteLine($&quot;✅ AGW sheet saved with {agwRowCount:N0} rows.&quot;);&#xA;" DisplayName="Write AGW" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_11" Language="CSharp">

        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: Exact UTLP ↔ Purchase/Auth Completion Matching ====&#xA;// FINAL OPTION A — Matching Key = RRN + AMOUNT&#xA;// No STAN, No PAN, No strong/weak passes&#xA;// Mark MATCHED rows: Classification = &quot;UTLP&quot;&#xA;// Keep unmatched Classification unchanged&#xA;&#xA;// ============================================================================&#xA;// SAFETY&#xA;// ============================================================================&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport));&#xA;&#xA;System.Data.DataTable matchedTable = dtHistoricalReconTransactionsReportMatched;&#xA;&#xA;if (matchedTable == null ||&#xA;    matchedTable.Columns.Count != dtHistoricalReconTransactionsReport.Columns.Count)&#xA;{&#xA;    matchedTable = dtHistoricalReconTransactionsReport.Clone();&#xA;}&#xA;&#xA;// Ensure Classification column exists&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Classification&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;if (!matchedTable.Columns.Contains(&quot;Classification&quot;))&#xA;    matchedTable.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;&#xA;// ============================================================================&#xA;// CONFIG + REGEX&#xA;// ============================================================================&#xA;string currency = reconCurrency;&#xA;var invariant = System.Globalization.CultureInfo.InvariantCulture;&#xA;&#xA;System.Text.RegularExpressions.Regex rrn12Rx =&#xA;    new System.Text.RegularExpressions.Regex(@&quot;\b\d{12}\b&quot;,&#xA;        System.Text.RegularExpressions.RegexOptions.Compiled);&#xA;&#xA;// ============================================================================&#xA;// HELPERS&#xA;// ============================================================================&#xA;string NarrUpper(object o)&#xA;{&#xA;    if (o == null || o == DBNull.Value) return &quot;&quot;;&#xA;    return o.ToString().ToUpperInvariant();&#xA;}&#xA;&#xA;decimal ParseAmt(object v)&#xA;{&#xA;    if (v == null || v == DBNull.Value) return 0m;&#xA;    string s = v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;);&#xA;    if (s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;))&#xA;        s = &quot;-&quot; + s.Substring(1, s.Length - 2);&#xA;    decimal d;&#xA;    return decimal.TryParse(s, out d) ? d : 0m;&#xA;}&#xA;&#xA;decimal R2(decimal v) =&gt;&#xA;    decimal.Round(v, 2, MidpointRounding.AwayFromZero);&#xA;&#xA;string ExtractRRN(string narrUpper)&#xA;{&#xA;    if (string.IsNullOrEmpty(narrUpper)) return &quot;&quot;;&#xA;    var m = rrn12Rx.Match(narrUpper);&#xA;    return m.Success ? m.Value : &quot;&quot;;&#xA;}&#xA;&#xA;string RowRef(System.Data.DataRow r)&#xA;{&#xA;    if (r.Table.Columns.Contains(&quot;SNO&quot;))&#xA;        return &quot;SNO=&quot; + (r[&quot;SNO&quot;]?.ToString() ?? &quot;&quot;);&#xA;    if (r.Table.Columns.Contains(&quot;Transaction Ref No:&quot;))&#xA;        return &quot;TRN=&quot; + (r[&quot;Transaction Ref No:&quot;]?.ToString() ?? &quot;&quot;);&#xA;    return &quot;IDX=&quot; + r.Table.Rows.IndexOf(r);&#xA;}&#xA;&#xA;string FindCol(System.Data.DataTable dt, string col)&#xA;{&#xA;    if (dt.Columns.Contains(col)) return col;&#xA;&#xA;    // Case-insensitive exact&#xA;    foreach (System.Data.DataColumn c in dt.Columns)&#xA;        if (string.Equals(c.ColumnName, col, StringComparison.OrdinalIgnoreCase))&#xA;            return c.ColumnName;&#xA;&#xA;    return null;&#xA;}&#xA;&#xA;string MakeKey(string rrn, decimal amt) =&gt;&#xA;    rrn + &quot;|&quot; + amt.ToString(&quot;F2&quot;, invariant);&#xA;&#xA;// Add to dictionary safely&#xA;void AddToDict(&#xA;    System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt; dict,&#xA;    string key,&#xA;    System.Data.DataRow row)&#xA;{&#xA;    if (string.IsNullOrEmpty(key)) return;&#xA;    if (!dict.TryGetValue(key, out var list))&#xA;    {&#xA;        list = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;        dict[key] = list;&#xA;    }&#xA;    list.Add(row);&#xA;}&#xA;&#xA;// ============================================================================&#xA;// DETECT COLUMNS&#xA;// ============================================================================&#xA;string debitCol = FindCol(dtHistoricalReconTransactionsReport, &quot;Debit (&quot; + currency + &quot;)&quot;);&#xA;string creditCol = FindCol(dtHistoricalReconTransactionsReport, &quot;Credit (&quot; + currency + &quot;)&quot;);&#xA;&#xA;if (debitCol == null &amp;&amp; creditCol == null)&#xA;{&#xA;    System.Console.WriteLine(&quot;❌ No Debit/Credit columns found.&quot;);&#xA;    dtHistoricalReconTransactionsReportMatched = matchedTable;&#xA;    return;&#xA;}&#xA;&#xA;System.Console.WriteLine($&quot;[INFO] Using DR='{debitCol}', CR='{creditCol}'&quot;);&#xA;&#xA;// ============================================================================&#xA;// IDENTIFY UTLP AND PURCHASE/AUTH COMPLETION ROWS&#xA;// ============================================================================&#xA;bool IsUTLPRow(System.Data.DataRow r)&#xA;{&#xA;    if (!r.Table.Columns.Contains(&quot;Transaction Ref No:&quot;)) return false;&#xA;    string s = r[&quot;Transaction Ref No:&quot;]?.ToString().ToUpperInvariant() ?? &quot;&quot;;&#xA;    return s.Contains(&quot;UTLP&quot;);&#xA;}&#xA;&#xA;bool IsPurchaseAuthRow(System.Data.DataRow r)&#xA;{&#xA;    string n = NarrUpper(r[&quot;Narration&quot;]);&#xA;    return n.Contains(&quot;PURCHASE&quot;) &amp;&amp; n.Contains(&quot;AUTH&quot;) &amp;&amp; n.Contains(&quot;COMPLETION&quot;);&#xA;}&#xA;&#xA;var utlpRows = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;var pauthRows = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;&#xA;foreach (System.Data.DataRow r in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    if (IsUTLPRow(r))&#xA;    {&#xA;        r[&quot;Classification&quot;] = r[&quot;Classification&quot;]; // keep original unless matched later&#xA;        utlpRows.Add(r);&#xA;    }&#xA;    if (IsPurchaseAuthRow(r))&#xA;    {&#xA;        r[&quot;Classification&quot;] = r[&quot;Classification&quot;];&#xA;        pauthRows.Add(r);&#xA;    }&#xA;}&#xA;&#xA;System.Console.WriteLine($&quot;[INFO] UTLP Rows = {utlpRows.Count}, P/Auth Rows = {pauthRows.Count}&quot;);&#xA;&#xA;// ============================================================================&#xA;// BUILD INDEXES BY KEY = RRN + &quot;|&quot; + AMOUNT&#xA;// ============================================================================&#xA;var utlpCredit = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;var utlpDebit  = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;&#xA;var pauthCredit = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;var pauthDebit  = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;&#xA;int badRRN_U = 0, badRRN_P = 0, dual_U = 0, dual_P = 0;&#xA;&#xA;// ---- UTLP side&#xA;foreach (var r in utlpRows)&#xA;{&#xA;    string rrn = ExtractRRN(NarrUpper(r[&quot;Narration&quot;]));&#xA;    if (string.IsNullOrEmpty(rrn)) { badRRN_U++; continue; }&#xA;&#xA;    decimal dr = debitCol  != null ? R2(ParseAmt(r[debitCol]))  : 0m;&#xA;    decimal cr = creditCol != null ? R2(ParseAmt(r[creditCol])) : 0m;&#xA;&#xA;    if (dr &gt; 0m &amp;&amp; cr &gt; 0m) { dual_U++; continue; }&#xA;    if (dr == 0m &amp;&amp; cr == 0m) continue;&#xA;&#xA;    decimal amt = dr &gt; 0m ? dr : cr;&#xA;    string key = MakeKey(rrn, amt);&#xA;&#xA;    if (cr &gt; 0m)&#xA;        AddToDict(utlpCredit, key, r);&#xA;    else&#xA;        AddToDict(utlpDebit, key, r);&#xA;}&#xA;&#xA;// ---- P/Auth side&#xA;foreach (var r in pauthRows)&#xA;{&#xA;    string rrn = ExtractRRN(NarrUpper(r[&quot;Narration&quot;]));&#xA;    if (string.IsNullOrEmpty(rrn)) { badRRN_P++; continue; }&#xA;&#xA;    decimal dr = debitCol  != null ? R2(ParseAmt(r[debitCol]))  : 0m;&#xA;    decimal cr = creditCol != null ? R2(ParseAmt(r[creditCol])) : 0m;&#xA;&#xA;    if (dr &gt; 0m &amp;&amp; cr &gt; 0m) { dual_P++; continue; }&#xA;    if (dr == 0m &amp;&amp; cr == 0m) continue;&#xA;&#xA;    decimal amt = dr &gt; 0m ? dr : cr;&#xA;    string key = MakeKey(rrn, amt);&#xA;&#xA;    if (cr &gt; 0m)&#xA;        AddToDict(pauthCredit, key, r);&#xA;    else&#xA;        AddToDict(pauthDebit, key, r);&#xA;}&#xA;&#xA;System.Console.WriteLine($&quot;[IDX] UTLP badRRN={badRRN_U}, dual={dual_U}&quot;);&#xA;System.Console.WriteLine($&quot;[IDX] P/Auth badRRN={badRRN_P}, dual={dual_P}&quot;);&#xA;&#xA;// ============================================================================&#xA;// MATCHING — SINGLE PASS: RRN + AMOUNT&#xA;// ============================================================================&#xA;var rowsToRemove = new System.Collections.Generic.HashSet&lt;System.Data.DataRow&gt;();&#xA;int matchCount = 0;&#xA;decimal removedDr = 0m, removedCr = 0m;&#xA;&#xA;// UTLP Credit ↔ P/Auth Debit&#xA;foreach (var kv in utlpCredit)&#xA;{&#xA;    string key = kv.Key;&#xA;    if (!pauthDebit.TryGetValue(key, out var listB)) continue;&#xA;&#xA;    foreach (var a in kv.Value)&#xA;    {&#xA;        if (rowsToRemove.Contains(a)) continue;&#xA;&#xA;        System.Data.DataRow b = null;&#xA;        foreach (var x in listB)&#xA;            if (!rowsToRemove.Contains(x)) { b = x; break; }&#xA;&#xA;        if (b == null) continue;&#xA;&#xA;        decimal aCr = R2(ParseAmt(a[creditCol]));&#xA;        decimal bDr = R2(ParseAmt(b[debitCol]));&#xA;&#xA;        if (aCr == bDr &amp;&amp; aCr &gt; 0m)&#xA;        {&#xA;            // ==== IMPORT + MARK UTLP ====&#xA;            var newA = matchedTable.NewRow();&#xA;            newA.ItemArray = a.ItemArray.Clone() as object[];&#xA;            newA[&quot;Classification&quot;] = &quot;UTLP&quot;;&#xA;            matchedTable.Rows.Add(newA);&#xA;&#xA;            var newB = matchedTable.NewRow();&#xA;            newB.ItemArray = b.ItemArray.Clone() as object[];&#xA;            newB[&quot;Classification&quot;] = &quot;UTLP&quot;;&#xA;            matchedTable.Rows.Add(newB);&#xA;&#xA;            rowsToRemove.Add(a);&#xA;            rowsToRemove.Add(b);&#xA;&#xA;            removedCr += aCr;&#xA;            removedDr += bDr;&#xA;            matchCount++;&#xA;&#xA;            System.Console.WriteLine($&quot;✅ MATCH {key} | {RowRef(a)} ↔ {RowRef(b)}&quot;);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// UTLP Debit ↔ P/Auth Credit&#xA;foreach (var kv in utlpDebit)&#xA;{&#xA;    string key = kv.Key;&#xA;    if (!pauthCredit.TryGetValue(key, out var listB)) continue;&#xA;&#xA;    foreach (var a in kv.Value)&#xA;    {&#xA;        if (rowsToRemove.Contains(a)) continue;&#xA;&#xA;        System.Data.DataRow b = null;&#xA;        foreach (var x in listB)&#xA;            if (!rowsToRemove.Contains(x)) { b = x; break; }&#xA;&#xA;        if (b == null) continue;&#xA;&#xA;        decimal aDr = R2(ParseAmt(a[debitCol]));&#xA;        decimal bCr = R2(ParseAmt(b[creditCol]));&#xA;&#xA;        if (aDr == bCr &amp;&amp; aDr &gt; 0m)&#xA;        {&#xA;            // ==== IMPORT + MARK UTLP ====&#xA;            var newA = matchedTable.NewRow();&#xA;            newA.ItemArray = a.ItemArray.Clone() as object[];&#xA;            newA[&quot;Classification&quot;] = &quot;UTLP&quot;;&#xA;            matchedTable.Rows.Add(newA);&#xA;&#xA;            var newB = matchedTable.NewRow();&#xA;            newB.ItemArray = b.ItemArray.Clone() as object[];&#xA;            newB[&quot;Classification&quot;] = &quot;UTLP&quot;;&#xA;            matchedTable.Rows.Add(newB);&#xA;&#xA;            rowsToRemove.Add(a);&#xA;            rowsToRemove.Add(b);&#xA;&#xA;            removedDr += aDr;&#xA;            removedCr += bCr;&#xA;            matchCount++;&#xA;&#xA;            System.Console.WriteLine($&quot;✅ MATCH {key} | {RowRef(a)} ↔ {RowRef(b)}&quot;);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// ============================================================================&#xA;// REMOVE MATCHED ROWS&#xA;// ============================================================================&#xA;int removedCount = 0;&#xA;foreach (var r in rowsToRemove)&#xA;{&#xA;    if (r.RowState != System.Data.DataRowState.Detached &amp;&amp;&#xA;        r.Table == dtHistoricalReconTransactionsReport)&#xA;    {&#xA;        dtHistoricalReconTransactionsReport.Rows.Remove(r);&#xA;        removedCount++;&#xA;    }&#xA;}&#xA;&#xA;System.Console.WriteLine($&quot;[INFO] Removed rows: {removedCount}&quot;);&#xA;System.Console.WriteLine($&quot;[INFO] Matched pairs: {matchCount}&quot;);&#xA;&#xA;// ============================================================================&#xA;// SAVE&#xA;// ============================================================================&#xA;dtHistoricalReconTransactionsReportMatched = matchedTable;&#xA;" DisplayName="UTLP  + Purchase/Auth Completion" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_107" Language="CSharp">

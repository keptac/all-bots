        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: ClosedXML (no EPPlus) — chunked write + logging + atomic save (instant formulas) =====&#xD;&#xA;// In/Out: DataTable dtHistoricalReconTransactionsReport&#xD;&#xA;// In    : string prepaidCardFileName, string reconDate, string reconCurrency,&#xD;&#xA;//         decimal glClosingBalance, decimal cmsBalance&#xD;&#xA;&#xD;&#xA;// --------------------------- Helpers ---------------------------&#xD;&#xA;System.DateTime ParseReconDateUs(string s)&#xD;&#xA;{&#xD;&#xA;    if (string.IsNullOrWhiteSpace(s)) return System.DateTime.Today;&#xD;&#xA;    string[] fmts = {&#xD;&#xA;        &quot;MM/dd/yyyy&quot;,&quot;M/d/yyyy&quot;,&quot;MM-dd-yyyy&quot;,&quot;M-d-yyyy&quot;,&#xD;&#xA;        &quot;yyyy-MM-dd&quot;,&quot;yyyy-MM-dd HH:mm:ss&quot;,&quot;yyyy-MM-dd'T'HH:mm:ss&quot;,&#xD;&#xA;        &quot;dd-MMM-yyyy&quot;,&quot;d-MMM-yyyy&quot;&#xD;&#xA;    };&#xD;&#xA;    System.DateTime dt;&#xD;&#xA;    if (System.DateTime.TryParseExact(&#xD;&#xA;            s.Trim(),&#xD;&#xA;            fmts,&#xD;&#xA;            System.Globalization.CultureInfo.InvariantCulture,&#xD;&#xA;            System.Globalization.DateTimeStyles.None,&#xD;&#xA;            out dt))&#xD;&#xA;        return dt.Date;&#xD;&#xA;    return System.DateTime.Today;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;decimal ParseAmountInvariant(object val)&#xD;&#xA;{&#xD;&#xA;    if (val == null || val == System.DBNull.Value) return 0m;&#xD;&#xA;    var s = val.ToString().Trim();&#xD;&#xA;    bool neg = s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;);&#xD;&#xA;    if (neg) s = s.Substring(1, s.Length - 2);&#xD;&#xA;    s = s.Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot; &quot;, &quot;&quot;);&#xD;&#xA;    decimal d;&#xD;&#xA;    return decimal.TryParse(&#xD;&#xA;               s,&#xD;&#xA;               System.Globalization.NumberStyles.AllowDecimalPoint |&#xD;&#xA;               System.Globalization.NumberStyles.AllowLeadingSign,&#xD;&#xA;               System.Globalization.CultureInfo.InvariantCulture,&#xD;&#xA;               out d)&#xD;&#xA;        ? (neg ? -d : d)&#xD;&#xA;        : 0m;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;void EnsureStringCol(System.Data.DataTable dt, string name)&#xD;&#xA;{&#xD;&#xA;    if (!dt.Columns.Contains(name)) dt.Columns.Add(name, typeof(string));&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;void EnsureNotNullOrBlank(System.Data.DataRow r, string col, string defVal)&#xD;&#xA;{&#xD;&#xA;    if (!r.Table.Columns.Contains(col)) return;&#xD;&#xA;    var v = r[col];&#xD;&#xA;    if (v == null || v == System.DBNull.Value || string.IsNullOrWhiteSpace(v.ToString()))&#xD;&#xA;        r[col] = defVal;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;string GetOrDefault(System.Data.DataRow r, string col, string defVal)&#xD;&#xA;{&#xD;&#xA;    if (!r.Table.Columns.Contains(col)) return defVal;&#xD;&#xA;    var v = r[col];&#xD;&#xA;    if (v == null || v == System.DBNull.Value) return defVal;&#xD;&#xA;    var s = v.ToString();&#xD;&#xA;    return string.IsNullOrWhiteSpace(s) ? defVal : s;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Normalize any Booking/Value Date cell to a pure DateTime date (no time),&#xD;&#xA;// handling Excel serials (e.g. 45963), DateTime, numeric and string dates.&#xD;&#xA;object NormalizeDateCell(object v)&#xD;&#xA;{&#xD;&#xA;    if (v == null || v == System.DBNull.Value) return null;&#xD;&#xA;&#xD;&#xA;    // Already DateTime&#xD;&#xA;    if (v is System.DateTime dt)&#xD;&#xA;        return dt.Date;&#xD;&#xA;&#xD;&#xA;    // Excel serial as double/float/decimal&#xD;&#xA;    if (v is double dNum)&#xD;&#xA;        return System.DateTime.FromOADate(dNum).Date;&#xD;&#xA;&#xD;&#xA;    if (v is float fNum)&#xD;&#xA;        return System.DateTime.FromOADate((double)fNum).Date;&#xD;&#xA;&#xD;&#xA;    if (v is decimal decNum)&#xD;&#xA;        return System.DateTime.FromOADate((double)decNum).Date;&#xD;&#xA;&#xD;&#xA;    // As string&#xD;&#xA;    var s = v.ToString().Trim();&#xD;&#xA;    if (string.IsNullOrEmpty(s)) return null;&#xD;&#xA;&#xD;&#xA;    // Pure numeric string =&gt; very likely OADate (e.g. &quot;45963&quot;)&#xD;&#xA;    double oa;&#xD;&#xA;    if (double.TryParse(&#xD;&#xA;            s,&#xD;&#xA;            System.Globalization.NumberStyles.Any,&#xD;&#xA;            System.Globalization.CultureInfo.InvariantCulture,&#xD;&#xA;            out oa))&#xD;&#xA;    {&#xD;&#xA;        // Basic guard range for Excel dates&#xD;&#xA;        if (oa &gt; 20000 &amp;&amp; oa &lt; 60000)&#xD;&#xA;            return System.DateTime.FromOADate(oa).Date;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // Try parse as date with common formats (GL/CMS style)&#xD;&#xA;    System.DateTime parsed;&#xD;&#xA;    string[] fmts = new[]&#xD;&#xA;    {&#xD;&#xA;        &quot;dd/MM/yyyy&quot;,&#xD;&#xA;        &quot;dd/MM/yyyy HH:mm:ss&quot;,&#xD;&#xA;        &quot;MM/dd/yyyy&quot;,&#xD;&#xA;        &quot;MM/dd/yyyy HH:mm:ss&quot;,&#xD;&#xA;        &quot;M/d/yyyy&quot;,&#xD;&#xA;        &quot;M/d/yyyy HH:mm:ss&quot;,&#xD;&#xA;        &quot;yyyy-MM-dd&quot;,&#xD;&#xA;        &quot;yyyy-MM-dd HH:mm:ss&quot;,&#xD;&#xA;        &quot;dd-MMM-yyyy&quot;,&#xD;&#xA;        &quot;d-MMM-yyyy&quot;,&#xD;&#xA;        &quot;dd-MM-yyyy&quot;,&#xD;&#xA;        &quot;dd-MM-yyyy HH:mm:ss&quot;&#xD;&#xA;    };&#xD;&#xA;&#xD;&#xA;    if (System.DateTime.TryParseExact(&#xD;&#xA;            s,&#xD;&#xA;            fmts,&#xD;&#xA;            System.Globalization.CultureInfo.InvariantCulture,&#xD;&#xA;            System.Globalization.DateTimeStyles.None,&#xD;&#xA;            out parsed))&#xD;&#xA;        return parsed.Date;&#xD;&#xA;&#xD;&#xA;    // Last resort: generic parse&#xD;&#xA;    if (System.DateTime.TryParse(&#xD;&#xA;            s,&#xD;&#xA;            System.Globalization.CultureInfo.InvariantCulture,&#xD;&#xA;            System.Globalization.DateTimeStyles.None,&#xD;&#xA;            out parsed))&#xD;&#xA;        return parsed.Date;&#xD;&#xA;&#xD;&#xA;    // If everything fails, keep original string (so we don't lose data)&#xD;&#xA;    return s;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// --------------------------- Validate ---------------------------&#xD;&#xA;if (dtHistoricalReconTransactionsReport == null || dtHistoricalReconTransactionsReport.Rows.Count == 0)&#xD;&#xA;    throw new System.Exception(&quot;DataTable 'dtHistoricalReconTransactionsReport' is null or empty.&quot;);&#xD;&#xA;&#xD;&#xA;for (int iRow = 0; iRow &lt; dtHistoricalReconTransactionsReport.Rows.Count; iRow++)&#xD;&#xA;{&#xD;&#xA;    var row = dtHistoricalReconTransactionsReport.Rows[iRow];&#xD;&#xA;    row[&quot;Branch code&quot;]    = &quot;101&quot;;&#xD;&#xA;    row[&quot;GL_Code&quot;]        = &quot;202030015&quot;;&#xD;&#xA;    row[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;EnsureStringCol(dtHistoricalReconTransactionsReport, &quot;Root Cause&quot;);&#xD;&#xA;EnsureStringCol(dtHistoricalReconTransactionsReport, &quot;Root Cause Category&quot;);&#xD;&#xA;EnsureStringCol(dtHistoricalReconTransactionsReport, &quot;Recommended Action&quot;);&#xD;&#xA;EnsureStringCol(dtHistoricalReconTransactionsReport, &quot;Action Owner&quot;);&#xD;&#xA;&#xD;&#xA;const string DEF_RC   = &quot;Not Applicable&quot;;&#xD;&#xA;const string DEF_RCAT = &quot;Not Applicable&quot;;&#xD;&#xA;const string DEF_ACT  = &quot;Not Applicable&quot;;&#xD;&#xA;const string DEF_OWN  = &quot;Card Reconciliation&quot;;&#xD;&#xA;&#xD;&#xA;foreach (System.Data.DataRow r in dtHistoricalReconTransactionsReport.Rows)&#xD;&#xA;{&#xD;&#xA;    EnsureNotNullOrBlank(r, &quot;Root Cause&quot;, DEF_RC);&#xD;&#xA;    EnsureNotNullOrBlank(r, &quot;Root Cause Category&quot;, DEF_RCAT);&#xD;&#xA;    EnsureNotNullOrBlank(r, &quot;Recommended Action&quot;, DEF_ACT);&#xD;&#xA;    EnsureNotNullOrBlank(r, &quot;Action Owner&quot;, DEF_OWN);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (!System.IO.File.Exists(prepaidCardFileName))&#xD;&#xA;    throw new System.IO.FileNotFoundException(&quot;File not found: &quot; + prepaidCardFileName);&#xD;&#xA;&#xD;&#xA;// --------------------------- Layout ---------------------------&#xD;&#xA;const int EXCEL_MAX_ROWS = 1048576;&#xD;&#xA;int startingRow = 18;&#xD;&#xA;int totalRows   = dtHistoricalReconTransactionsReport.Rows.Count;&#xD;&#xA;int maxWritable = System.Math.Max(0, EXCEL_MAX_ROWS - startingRow + 1);&#xD;&#xA;if (totalRows &gt; maxWritable)&#xD;&#xA;{&#xD;&#xA;    System.Console.WriteLine($&quot;[WARN] Truncating write from {totalRows:N0} to {maxWritable:N0} rows (Excel row limit).&quot;);&#xD;&#xA;    totalRows = maxWritable;&#xD;&#xA;}&#xD;&#xA;bool hasRows = totalRows &gt; 0;&#xD;&#xA;int lastRow = hasRows ? (startingRow + totalRows - 1) : startingRow;&#xD;&#xA;&#xD;&#xA;string debitColName  = &quot;Debit (&quot;  + reconCurrency + &quot;)&quot;;&#xD;&#xA;string creditColName = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xD;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(debitColName))  throw new System.Exception(&quot;Column not found: &quot; + debitColName);&#xD;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(creditColName)) throw new System.Exception(&quot;Column not found: &quot; + creditColName);&#xD;&#xA;&#xD;&#xA;System.Console.WriteLine($&quot;[BEGIN] Writing {totalRows:N0} rows to '{prepaidCardFileName}' starting at row {startingRow} ...&quot;);&#xD;&#xA;var sw = System.Diagnostics.Stopwatch.StartNew();&#xD;&#xA;&#xD;&#xA;// --------------------------- Write ---------------------------&#xD;&#xA;try&#xD;&#xA;{&#xD;&#xA;    using (var wb = new ClosedXML.Excel.XLWorkbook(prepaidCardFileName))&#xD;&#xA;    {&#xD;&#xA;        var ws = wb.Worksheet(&quot;Recon Report&quot;);&#xD;&#xA;        if (ws == null) throw new System.Exception(&quot;Worksheet 'Recon Report' not found.&quot;);&#xD;&#xA;&#xD;&#xA;        // Global font&#xD;&#xA;        ws.Style.Font.SetFontName(&quot;Tahoma&quot;);&#xD;&#xA;        ws.Style.Font.SetFontSize(8);&#xD;&#xA;&#xD;&#xA;        // H6 recon date (display only)&#xD;&#xA;        var reconDt = ParseReconDateUs(reconDate);&#xD;&#xA;        ws.Cell(&quot;H6&quot;).Value = reconDt;&#xD;&#xA;        ws.Cell(&quot;H6&quot;).Style.DateFormat.Format = &quot;dd-MMM-yyyy&quot;;&#xD;&#xA;&#xD;&#xA;        // Clear previous B..R block contents&#xD;&#xA;        int sheetLast = ws.LastRowUsed() != null ? ws.LastRowUsed().RowNumber() : 0;&#xD;&#xA;        if (sheetLast &gt;= startingRow)&#xD;&#xA;        {&#xD;&#xA;            int clearEnd = System.Math.Min(sheetLast, EXCEL_MAX_ROWS);&#xD;&#xA;            ws.Range(startingRow, 2, clearEnd, 18).Clear(ClosedXML.Excel.XLClearOptions.Contents);&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        if (hasRows)&#xD;&#xA;        {&#xD;&#xA;            int batchSize = 10000;&#xD;&#xA;            int written = 0;&#xD;&#xA;            int batchNo = 0;&#xD;&#xA;            int curRow  = startingRow;&#xD;&#xA;&#xD;&#xA;            bool hasTxnRef = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Transaction Ref No:&quot;);&#xD;&#xA;            bool hasNarr   = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Narration&quot;);&#xD;&#xA;&#xD;&#xA;            while (written &lt; totalRows)&#xD;&#xA;            {&#xD;&#xA;                batchNo++;&#xD;&#xA;                int take = System.Math.Min(batchSize, totalRows - written);&#xD;&#xA;&#xD;&#xA;                var rows = new System.Collections.Generic.List&lt;object[]&gt;(take);&#xD;&#xA;&#xD;&#xA;                for (int i = 0; i &lt; take; i++)&#xD;&#xA;                {&#xD;&#xA;                    var dr = dtHistoricalReconTransactionsReport.Rows[written + i];&#xD;&#xA;&#xD;&#xA;                    // Normalize dates to pure DateTime (no time) for Excel&#xD;&#xA;                    object bDateRaw = dr.Table.Columns.Contains(&quot;Booking Date&quot;) ? dr[&quot;Booking Date&quot;] : null; // F&#xD;&#xA;                    object vDateRaw = dr.Table.Columns.Contains(&quot;Value Date&quot;)   ? dr[&quot;Value Date&quot;]   : null; // G&#xD;&#xA;&#xD;&#xA;                    object bDate = NormalizeDateCell(bDateRaw);&#xD;&#xA;                    object vDate = NormalizeDateCell(vDateRaw);&#xD;&#xA;&#xD;&#xA;                    var debit  = System.Math.Round(ParseAmountInvariant(dr[debitColName]), 2);&#xD;&#xA;                    var credit = System.Math.Round(ParseAmountInvariant(dr[creditColName]), 2);&#xD;&#xA;&#xD;&#xA;                    string rc   = GetOrDefault(dr, &quot;Root Cause&quot;, DEF_RC);&#xD;&#xA;                    string rcat = GetOrDefault(dr, &quot;Root Cause Category&quot;, DEF_RCAT);&#xD;&#xA;                    string act  = GetOrDefault(dr, &quot;Recommended Action&quot;, DEF_ACT);&#xD;&#xA;                    string own  = GetOrDefault(dr, &quot;Action Owner&quot;, DEF_OWN);&#xD;&#xA;&#xD;&#xA;                    var rowArr = new object[17];&#xD;&#xA;                    int c = 0;&#xD;&#xA;                    rowArr[c++] = written + i + 1;                              // B (SNO)&#xD;&#xA;                    rowArr[c++] = dr[&quot;Branch code&quot;];                            // C&#xD;&#xA;                    rowArr[c++] = dr[&quot;GL_Code&quot;];                                // D&#xD;&#xA;                    rowArr[c++] = dr[&quot;GL Description&quot;];                         // E&#xD;&#xA;                    rowArr[c++] = bDate;                                        // F (Booking Date) - normalized date&#xD;&#xA;                    rowArr[c++] = vDate;                                        // G (Value Date)   - normalized date&#xD;&#xA;                    rowArr[c++] = hasTxnRef ? dr[&quot;Transaction Ref No:&quot;] : null; // H&#xD;&#xA;                    rowArr[c++] = hasNarr   ? dr[&quot;Narration&quot;] : null;           // I&#xD;&#xA;                    rowArr[c++] = debit;                                        // J&#xD;&#xA;                    rowArr[c++] = credit;                                       // K&#xD;&#xA;                    rowArr[c++] = null;                                         // L (formula later)&#xD;&#xA;                    rowArr[c++] = null;                                         // M (formula later)&#xD;&#xA;                    rowArr[c++] = null;                                         // N (formula later)&#xD;&#xA;                    rowArr[c++] = rc;                                           // O&#xD;&#xA;                    rowArr[c++] = rcat;                                         // P&#xD;&#xA;                    rowArr[c++] = act;                                          // Q&#xD;&#xA;                    rowArr[c++] = own;                                          // R&#xD;&#xA;&#xD;&#xA;                    rows.Add(rowArr);&#xD;&#xA;                }&#xD;&#xA;&#xD;&#xA;                // Dump this chunk (starting at B = col 2)&#xD;&#xA;                ws.Cell(curRow, 2).InsertData(rows);&#xD;&#xA;&#xD;&#xA;                // Display formats (non-destructive)&#xD;&#xA;                ws.Range(curRow, 6, curRow + take - 1, 7).Style.DateFormat.Format = &quot;dd-MMM-yyyy&quot;; // F..G display&#xD;&#xA;                ws.Range(curRow,10, curRow + take - 1, 11).Style.NumberFormat.Format = &quot;#,##0.00&quot;; // J..K&#xD;&#xA;&#xD;&#xA;                // ===== L/M/N formulas via R1C1 on ranges (instant calc) =====&#xD;&#xA;&#xD;&#xA;                // L = $H$6 - G{row}  -&gt; R1C1: =R6C8 - RC[-5]&#xD;&#xA;                var rngL = ws.Range(curRow, 12, curRow + take - 1, 12);&#xD;&#xA;                rngL.Clear(ClosedXML.Excel.XLClearOptions.All);&#xD;&#xA;                rngL.Style.NumberFormat.NumberFormatId = 0; // General&#xD;&#xA;                rngL.Style.NumberFormat.Format = &quot;&quot;;&#xD;&#xA;                rngL.FormulaR1C1 = &quot;=R6C8 - RC[-5]&quot;;&#xD;&#xA;&#xD;&#xA;                // M = Aging Group based on L (one column to the left): RC[-1]&#xD;&#xA;                var rngM = ws.Range(curRow, 13, curRow + take - 1, 13);&#xD;&#xA;                rngM.Clear(ClosedXML.Excel.XLClearOptions.All);&#xD;&#xA;                rngM.Style.NumberFormat.NumberFormatId = 0;&#xD;&#xA;                rngM.Style.NumberFormat.Format = &quot;&quot;;&#xD;&#xA;                rngM.FormulaR1C1 =&#xD;&#xA;                    &quot;=IF(RC[-1]&lt;4,\&quot;0-3 Days\&quot;,IF(RC[-1]&lt;31,\&quot;4-30 Days\&quot;,IF(RC[-1]&lt;61,\&quot;31-60 Days\&quot;,IF(RC[-1]&lt;=90,\&quot;61-90 Days\&quot;,\&quot;Above 90 Days\&quot;))))&quot;;&#xD;&#xA;&#xD;&#xA;                // N = BOT Classification based on J (4 left) and L (2 left): RC[-4], RC[-2]&#xD;&#xA;                var rngN = ws.Range(curRow, 14, curRow + take - 1, 14);&#xD;&#xA;                rngN.Clear(ClosedXML.Excel.XLClearOptions.All);&#xD;&#xA;                rngN.Style.NumberFormat.NumberFormatId = 0;&#xD;&#xA;                rngN.Style.NumberFormat.Format = &quot;&quot;;&#xD;&#xA;                rngN.FormulaR1C1 =&#xD;&#xA;                    &quot;=IF(RC[-4]&gt;0,IF(RC[-2]&lt;30,\&quot;Normal\&quot;,IF(RC[-2]&lt;60,\&quot;Especially Mentioned\&quot;,IF(RC[-2]&lt;90,\&quot;Substandard\&quot;,IF(RC[-2]&lt;=180,\&quot;Doubtful\&quot;,\&quot;Loss\&quot;)))),\&quot;Not Applicable\&quot;)&quot;;&#xD;&#xA;&#xD;&#xA;                // Per-chunk logging&#xD;&#xA;                int batchStartSno = written + 1;&#xD;&#xA;                int batchEndSno   = written + take;&#xD;&#xA;                System.Console.WriteLine(&#xD;&#xA;                    $&quot;[BATCH {batchNo}] Wrote {take:N0} rows (SNO {batchStartSno:N0}..{batchEndSno:N0}) &quot; +&#xD;&#xA;                    $&quot;to Excel rows {curRow:N0}..{(curRow + take - 1):N0}. Cumulative: {(written + take):N0}/{totalRows:N0}&quot;);&#xD;&#xA;&#xD;&#xA;                written += take;&#xD;&#xA;                curRow  += take;&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;        else&#xD;&#xA;        {&#xD;&#xA;            System.Console.WriteLine(&quot;[INFO] No rows to write; leaving block empty.&quot;);&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        // Totals &amp; headers (ensure not Text)&#xD;&#xA;        ws.Cell(&quot;K9&quot;).Value  = glClosingBalance;&#xD;&#xA;        ws.Cell(&quot;K10&quot;).Value = cmsBalance;&#xD;&#xA;&#xD;&#xA;        foreach (var addr in new[] { &quot;J13&quot;, &quot;K13&quot;, &quot;J16&quot;, &quot;K16&quot;, &quot;K11&quot;, &quot;K14&quot;, &quot;K15&quot; })&#xD;&#xA;        {&#xD;&#xA;            var c = ws.Cell(addr);&#xD;&#xA;            c.Clear(ClosedXML.Excel.XLClearOptions.All);&#xD;&#xA;            c.Style.NumberFormat.NumberFormatId = 0; // General&#xD;&#xA;            c.Style.NumberFormat.Format = &quot;&quot;;&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        string jRange = hasRows ? $&quot;J{startingRow}:J{lastRow}&quot; : &quot;J999:J999&quot;;&#xD;&#xA;        string kRange = hasRows ? $&quot;K{startingRow}:K{lastRow}&quot; : &quot;K999:K999&quot;;&#xD;&#xA;&#xD;&#xA;        ws.Cell(&quot;K11&quot;).FormulaA1 = &quot;ROUND((K9-K10),2)&quot;;&#xD;&#xA;        ws.Cell(&quot;J13&quot;).FormulaA1 = $&quot;-SUM({jRange})&quot;;&#xD;&#xA;        ws.Cell(&quot;K13&quot;).FormulaA1 = $&quot;SUM({kRange})&quot;;&#xD;&#xA;        ws.Cell(&quot;J16&quot;).FormulaA1 = $&quot;SUM({jRange})&quot;;&#xD;&#xA;        ws.Cell(&quot;K16&quot;).FormulaA1 = $&quot;SUM({kRange})&quot;;&#xD;&#xA;        ws.Cell(&quot;K14&quot;).FormulaA1 = &quot;ROUND((J13+K13),2)&quot;;&#xD;&#xA;        ws.Cell(&quot;K15&quot;).FormulaA1 = &quot;ROUND((K11-K14),2)&quot;;&#xD;&#xA;&#xD;&#xA;        ws.Range(&quot;K9:K11&quot;).Style.NumberFormat.Format = &quot;#,##0.00&quot;;&#xD;&#xA;&#xD;&#xA;        // Named range ReconData&#xD;&#xA;        try&#xD;&#xA;        {&#xD;&#xA;            var rng = hasRows&#xD;&#xA;                ? ws.Range(startingRow, 2, lastRow, 18)&#xD;&#xA;                : ws.Range(startingRow, 2, startingRow, 18);&#xD;&#xA;&#xD;&#xA;            var existing = wb.NamedRanges.NamedRange(&quot;ReconData&quot;);&#xD;&#xA;            if (existing != null) existing.Delete();&#xD;&#xA;            wb.NamedRanges.Add(&quot;ReconData&quot;, rng);&#xD;&#xA;        }&#xD;&#xA;        catch { /* ignore named range issues */ }&#xD;&#xA;&#xD;&#xA;        // Font color black for content block&#xD;&#xA;        {&#xD;&#xA;            int endRow = ws.LastRowUsed() != null ? ws.LastRowUsed().RowNumber() : startingRow;&#xD;&#xA;            int endCol = ws.LastColumnUsed() != null ? ws.LastColumnUsed().ColumnNumber() : 18;&#xD;&#xA;            if (endRow &lt; startingRow) endRow = startingRow;&#xD;&#xA;            if (endCol &lt; 1) endCol = 18;&#xD;&#xA;            ws.Range(startingRow, 1, endRow, endCol).Style.Font.FontColor = ClosedXML.Excel.XLColor.Black;&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        // Bold rows 1..16, non-bold 17..end&#xD;&#xA;        {&#xD;&#xA;            int endCol = ws.LastColumnUsed() != null ? ws.LastColumnUsed().ColumnNumber() : 18;&#xD;&#xA;            if (endCol &lt; 1) endCol = 18;&#xD;&#xA;&#xD;&#xA;            ws.Range(1, 1, 16, endCol).Style.Font.SetBold(true);&#xD;&#xA;&#xD;&#xA;            int endRow = ws.LastRowUsed() != null ? ws.LastRowUsed().RowNumber() : startingRow;&#xD;&#xA;            if (endRow &lt; 17) endRow = 17;&#xD;&#xA;            ws.Range(17, 1, endRow, endCol).Style.Font.SetBold(false);&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        // ===== Force recalc behavior =====&#xD;&#xA;        wb.CalculateMode = ClosedXML.Excel.XLCalculateMode.Auto;&#xD;&#xA;        wb.ForceFullCalculation = true;&#xD;&#xA;        wb.FullCalculationOnLoad = true;&#xD;&#xA;&#xD;&#xA;        // Volatile trigger (hidden) to force recalc on open even if app is Manual&#xD;&#xA;        var _trigger = ws.Cell(&quot;A1&quot;);&#xD;&#xA;        _trigger.FormulaA1 = &quot;NOW()&quot;;&#xD;&#xA;        _trigger.Style.NumberFormat.Format = &quot;;;;&quot;;&#xD;&#xA;&#xD;&#xA;        // REMOVED: wb.RecalculateAllFormulas() cost ~280s on 124,086 rows x 3 formula columns.&#xA;        // Safe to skip: wb.CalculateMode = XLCalculateMode.Auto (set above) makes Excel recalculate&#xA;        // on open, and nothing in the live workflow reads the cached formula values -&#xA;        // the only blocks that did are inside Comment Out containers.&#xD;&#xA;&#xD;&#xA;        // ===== Atomic save: temp → replace =====&#xD;&#xA;        var dir  = System.IO.Path.GetDirectoryName(prepaidCardFileName);&#xD;&#xA;        var name = System.IO.Path.GetFileNameWithoutExtension(prepaidCardFileName);&#xD;&#xA;        var ext  = System.IO.Path.GetExtension(prepaidCardFileName);&#xD;&#xA;        var tmp  = System.IO.Path.Combine(dir, name + &quot;.tmp_write&quot; + ext);&#xD;&#xA;&#xD;&#xA;        wb.SaveAs(tmp);&#xD;&#xA;        System.IO.File.Copy(tmp, prepaidCardFileName, true);&#xD;&#xA;        try { System.IO.File.Delete(tmp); } catch { }&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    sw.Stop();&#xD;&#xA;    System.Console.WriteLine($&quot;[DONE] Wrote {totalRows:N0} rows in {sw.Elapsed.TotalSeconds:F1}s (ClosedXML)&quot;);&#xD;&#xA;    System.Console.WriteLine(&quot;       glClosingBalance (K9): &quot; + glClosingBalance.ToString(&quot;N2&quot;));&#xD;&#xA;    System.Console.WriteLine(&quot;       cmsBalance      (K10): &quot; + cmsBalance.ToString(&quot;N2&quot;));&#xD;&#xA;}&#xD;&#xA;catch (System.Exception ex)&#xD;&#xA;{&#xD;&#xA;    System.Console.WriteLine(&quot;ERROR: &quot; + ex.Message);&#xD;&#xA;    if (ex.InnerException != null) System.Console.WriteLine(&quot;Inner: &quot; + ex.InnerException.Message);&#xD;&#xA;}&#xD;&#xA;" DisplayName="FINAL dtHistoricalReconTransactionsReport and Recon Report Balances" sap:VirtualizedContainerService.HintSize="450,188" sap2010:WorkflowViewState.IdRef="InvokeCode_65" Language="CSharp">

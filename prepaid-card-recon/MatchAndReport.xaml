              <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: PPAT reconciliation (principal-only, fees ignored, no LINQ/local funcs) ====&#xA;// Args (In): string reconCurrency&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport, DataTable dtHistoricalReconTransactionsReportMatched&#xA;// Args (Out): decimal roundingErrorPPAT&#xA;&#xA;var sw = System.Diagnostics.Stopwatch.StartNew();&#xA;System.Console.WriteLine($&quot;🚀 PPAT reconciliation (principal-only) started at {System.DateTime.Now:yyyy-MM-dd HH:mm:ss}&quot;);&#xA;&#xA;// ---------- Config (tighter) ----------&#xA;decimal absTol = 0.50m;   // absolute tolerance (≈ cents)&#xA;decimal relTol = 0.001m;  // 0.10% tolerance&#xA;&#xA;// ---------- Helpers ----------&#xA;bool WithinTol(decimal a, decimal b)&#xA;{&#xA;    var diff = System.Math.Abs(a - b);&#xA;    var scale = System.Math.Max(System.Math.Abs(a), System.Math.Abs(b));&#xA;    var allowed = (scale == 0m) ? absTol : System.Math.Max(absTol, scale * relTol);&#xA;    return diff &lt;= allowed;&#xA;}&#xA;&#xA;decimal ParseAmount(object v)&#xA;{&#xA;    if (v == null || v == System.DBNull.Value) return 0m;&#xA;    var s = v.ToString().Trim();&#xA;    if (string.IsNullOrEmpty(s)) return 0m;&#xA;    s = s.Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;);&#xA;    decimal d;&#xA;    return decimal.TryParse(s, out d) ? d : 0m;&#xA;}&#xA;&#xA;// Use magnitude so GL vs CMS sign conventions don't inflate deltas&#xA;decimal AmountMagnitude(System.Data.DataRow r, string debitCol, string creditCol)&#xA;{&#xA;    var d = ParseAmount(r[debitCol]);&#xA;    var c = ParseAmount(r[creditCol]);&#xA;    // Usually one column is zero; this also safely handles oddities&#xA;    return System.Math.Abs(d) + System.Math.Abs(c);&#xA;}&#xA;&#xA;// PAN &amp; RRN (from Narration only)&#xA;string ExtractMaskedPan(string narration)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(narration)) return &quot;&quot;;&#xA;    var m1 = System.Text.RegularExpressions.Regex.Match(narration, @&quot;Card\s*No:\s*(\d{6})\*+(\d{4})&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;    if (m1.Success) return m1.Groups[1].Value + &quot;XXXXXX&quot; + m1.Groups[2].Value;&#xA;    var m2 = System.Text.RegularExpressions.Regex.Match(narration, @&quot;\b(\d{6}X{6}\d{4})\b&quot;);&#xA;    if (m2.Success) return m2.Groups[1].Value;&#xA;    var m3 = System.Text.RegularExpressions.Regex.Match(narration, @&quot;\b(\d{6})\*{6}(\d{4})\b&quot;);&#xA;    if (m3.Success) return m3.Groups[1].Value + &quot;XXXXXX&quot; + m3.Groups[2].Value;&#xA;    return &quot;&quot;;&#xA;}&#xA;&#xA;string ExtractRrn(string narration)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(narration)) return &quot;&quot;;&#xA;    var mPs = System.Text.RegularExpressions.Regex.Match(narration, @&quot;\bPS\d{10}\b&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;    if (mPs.Success) return mPs.Value.ToUpperInvariant();&#xA;    var mNum = System.Text.RegularExpressions.Regex.Match(narration, @&quot;\d{12,}&quot;);&#xA;    if (mNum.Success)&#xA;    {&#xA;        var s = mNum.Value;&#xA;        return s.Substring(s.Length - 12, 12);&#xA;    }&#xA;    return &quot;&quot;;&#xA;}&#xA;&#xA;// Stricter fee/tax detection to keep PPAT truly &quot;principal-only&quot;&#xA;bool IsFeeNarration(string narrU)&#xA;{&#xA;    if (string.IsNullOrEmpty(narrU)) return false;&#xA;&#xA;    // include plurals/abbrev &amp; common fee/tax words&#xA;    string[] hits = new[] {&#xA;        &quot;TRANSACTION FEE&quot;,&quot; FEES&quot;,&quot; FEE&quot;,&quot; CHARGE &quot;,&quot; CHARGES&quot;,&quot; CHG&quot;,&quot; CHGS&quot;,&#xA;        &quot;COMMISSION&quot;,&quot;DUTY&quot;,&quot;STAMP DUTY&quot;,&quot;VAT&quot;,&quot; TAX&quot;,&quot;WHT&quot;,&quot;WITHHOLDING TAX&quot;,&#xA;        &quot;EXCISE&quot;,&quot;LEVY&quot;,&quot;SURCHARGE&quot;,&quot;SERVICE CHARGE&quot;,&quot;PENALTY&quot;&#xA;    };&#xA;&#xA;    for (int i = 0; i &lt; hits.Length; i++)&#xA;        if (narrU.Contains(hits[i])) return true;&#xA;&#xA;    // edge: leading/trailing&#xA;    if (narrU.EndsWith(&quot; FEE&quot;) || narrU.EndsWith(&quot; FEE.&quot;) || narrU.EndsWith(&quot; CHARGE&quot;) || narrU.EndsWith(&quot; CHARGES&quot;))&#xA;        return true;&#xA;&#xA;    return false;&#xA;}&#xA;&#xA;// ---------- Guard: required columns ----------&#xA;string creditCol = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xA;string debitCol  = &quot;Debit (&quot; + reconCurrency + &quot;)&quot;;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Narration&quot;))   throw new System.Exception(&quot;Missing column: Narration&quot;);&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Source&quot;))      throw new System.Exception(&quot;Missing column: Source&quot;);&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Type&quot;))        throw new System.Exception(&quot;Missing column: Type&quot;);&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(creditCol))     throw new System.Exception(&quot;Missing column: &quot; + creditCol);&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(debitCol))      throw new System.Exception(&quot;Missing column: &quot; + debitCol);&#xA;&#xA;// ---------- Ensure columns exist ----------&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;C_PAN&quot;)) dtHistoricalReconTransactionsReport.Columns.Add(&quot;C_PAN&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;RRN&quot;))   dtHistoricalReconTransactionsReport.Columns.Add(&quot;RRN&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Classification&quot;)) dtHistoricalReconTransactionsReport.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;&#xA;if (!dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;C_PAN&quot;)) dtHistoricalReconTransactionsReportMatched.Columns.Add(&quot;C_PAN&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;RRN&quot;))   dtHistoricalReconTransactionsReportMatched.Columns.Add(&quot;RRN&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Classification&quot;)) dtHistoricalReconTransactionsReportMatched.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;&#xA;// Mirror schema into matched&#xA;for (int c = 0; c &lt; dtHistoricalReconTransactionsReport.Columns.Count; c++)&#xA;{&#xA;    var srcCol = dtHistoricalReconTransactionsReport.Columns[c];&#xA;    if (!dtHistoricalReconTransactionsReportMatched.Columns.Contains(srcCol.ColumnName))&#xA;        dtHistoricalReconTransactionsReportMatched.Columns.Add(srcCol.ColumnName, srcCol.DataType);&#xA;}&#xA;&#xA;// ---------- Backfill identifiers (Narration-only) ----------&#xA;int glPanFilled = 0, glRrnFilled = 0, cmsPanFilled = 0, cmsRrnFilled = 0;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var row = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    string narration = row[&quot;Narration&quot;] == null ? &quot;&quot; : row[&quot;Narration&quot;].ToString();&#xA;    string source = row[&quot;Source&quot;] == null ? &quot;&quot; : row[&quot;Source&quot;].ToString();&#xA;&#xA;    if (string.IsNullOrWhiteSpace(row[&quot;C_PAN&quot;] == null ? &quot;&quot; : row[&quot;C_PAN&quot;].ToString()))&#xA;    {&#xA;        var pan = ExtractMaskedPan(narration);&#xA;        if (!string.IsNullOrEmpty(pan))&#xA;        {&#xA;            row[&quot;C_PAN&quot;] = pan;&#xA;            if (source.Equals(&quot;GL&quot;, System.StringComparison.OrdinalIgnoreCase)) glPanFilled++;&#xA;            else if (source.Equals(&quot;CMS&quot;, System.StringComparison.OrdinalIgnoreCase)) cmsPanFilled++;&#xA;        }&#xA;    }&#xA;    if (string.IsNullOrWhiteSpace(row[&quot;RRN&quot;] == null ? &quot;&quot; : row[&quot;RRN&quot;].ToString()))&#xA;    {&#xA;        var rrn = ExtractRrn(narration);&#xA;        if (!string.IsNullOrEmpty(rrn))&#xA;        {&#xA;            row[&quot;RRN&quot;] = rrn;&#xA;            if (source.Equals(&quot;GL&quot;, System.StringComparison.OrdinalIgnoreCase)) glRrnFilled++;&#xA;            else if (source.Equals(&quot;CMS&quot;, System.StringComparison.OrdinalIgnoreCase)) cmsRrnFilled++;&#xA;        }&#xA;    }&#xA;}&#xA;System.Console.WriteLine($&quot;🪪 Filled identifiers → GL: C_PAN {glPanFilled}, RRN {glRrnFilled} | CMS: C_PAN {cmsPanFilled}, RRN {cmsRrnFilled}&quot;);&#xA;&#xA;// ---------- Build RRN indexes ----------&#xA;var glByRRN = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;int&gt;&gt;(System.StringComparer.OrdinalIgnoreCase);&#xA;var cmsByRRN = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;int&gt;&gt;(System.StringComparer.OrdinalIgnoreCase);&#xA;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var row = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    var source = (row[&quot;Source&quot;] == null ? &quot;&quot; : row[&quot;Source&quot;].ToString());&#xA;    var type = (row[&quot;Type&quot;] == null ? &quot;&quot; : row[&quot;Type&quot;].ToString());&#xA;    if (!source.Equals(&quot;GL&quot;, System.StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;        !source.Equals(&quot;CMS&quot;, System.StringComparison.OrdinalIgnoreCase)) continue;&#xA;    if (!type.Equals(&quot;new&quot;, System.StringComparison.OrdinalIgnoreCase)) continue;&#xA;&#xA;    var rrn = (row[&quot;RRN&quot;] == null ? &quot;&quot; : row[&quot;RRN&quot;].ToString());&#xA;    if (string.IsNullOrWhiteSpace(rrn)) continue;&#xA;&#xA;    if (source.Equals(&quot;GL&quot;, System.StringComparison.OrdinalIgnoreCase))&#xA;    {&#xA;        if (!glByRRN.ContainsKey(rrn)) glByRRN[rrn] = new System.Collections.Generic.List&lt;int&gt;();&#xA;        glByRRN[rrn].Add(i);&#xA;    }&#xA;    else&#xA;    {&#xA;        if (!cmsByRRN.ContainsKey(rrn)) cmsByRRN[rrn] = new System.Collections.Generic.List&lt;int&gt;();&#xA;        cmsByRRN[rrn].Add(i);&#xA;    }&#xA;}&#xA;&#xA;// ---------- Reconcile (principal-only) ----------&#xA;roundingErrorPPAT = 0m;&#xA;int groupsMatchedRRN = 0, groupsSkippedRRNNoPrincipal = 0, rowsMovedRRN = 0;&#xA;&#xA;// For diagnostics: capture contributing deltas&#xA;var deltaSamples = new System.Collections.Generic.List&lt;(string rrn, decimal gl, decimal cms, decimal delta)&gt;();&#xA;&#xA;var rrnKeys = new System.Collections.Generic.List&lt;string&gt;();&#xA;foreach (var kv in glByRRN) if (cmsByRRN.ContainsKey(kv.Key)) rrnKeys.Add(kv.Key);&#xA;&#xA;var toRemoveRowRefs = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;&#xA;for (int k = 0; k &lt; rrnKeys.Count; k++)&#xA;{&#xA;    string rrn = rrnKeys[k];&#xA;    var glIdxs = glByRRN[rrn];&#xA;    var cmsIdxs = cmsByRRN[rrn];&#xA;&#xA;    decimal glPrincipal = 0m, cmsPrincipal = 0m;&#xA;&#xA;    // Sum GL principal magnitudes (skip fees)&#xA;    for (int a = 0; a &lt; glIdxs.Count; a++)&#xA;    {&#xA;        var r = dtHistoricalReconTransactionsReport.Rows[glIdxs[a]];&#xA;        string narrU = (r[&quot;Narration&quot;] == null ? &quot;&quot; : r[&quot;Narration&quot;].ToString()).ToUpperInvariant();&#xA;        if (IsFeeNarration(narrU)) continue;&#xA;        glPrincipal += AmountMagnitude(r, debitCol, creditCol);&#xA;    }&#xA;&#xA;    // Sum CMS principal magnitudes (skip fees)&#xA;    for (int b = 0; b &lt; cmsIdxs.Count; b++)&#xA;    {&#xA;        var r = dtHistoricalReconTransactionsReport.Rows[cmsIdxs[b]];&#xA;        string narrU = (r[&quot;Narration&quot;] == null ? &quot;&quot; : r[&quot;Narration&quot;].ToString()).ToUpperInvariant();&#xA;        if (IsFeeNarration(narrU)) continue;&#xA;        cmsPrincipal += AmountMagnitude(r, debitCol, creditCol);&#xA;    }&#xA;&#xA;    if (glPrincipal == 0m &amp;&amp; cmsPrincipal == 0m)&#xA;    {&#xA;        groupsSkippedRRNNoPrincipal++;&#xA;        continue;&#xA;    }&#xA;&#xA;    var delta = glPrincipal - cmsPrincipal;&#xA;    System.Console.WriteLine($&quot;🔑 RRN={rrn} → GL Principal={glPrincipal:N2} | CMS Principal={cmsPrincipal:N2} | Δ={delta:N2}&quot;);&#xA;&#xA;    if (WithinTol(glPrincipal, cmsPrincipal))&#xA;    {&#xA;        // Move GL principal rows&#xA;        for (int a = 0; a &lt; glIdxs.Count; a++)&#xA;        {&#xA;            var src = dtHistoricalReconTransactionsReport.Rows[glIdxs[a]];&#xA;            string narrU = (src[&quot;Narration&quot;] == null ? &quot;&quot; : src[&quot;Narration&quot;].ToString()).ToUpperInvariant();&#xA;            if (IsFeeNarration(narrU)) continue;&#xA;&#xA;            var dest = dtHistoricalReconTransactionsReportMatched.NewRow();&#xA;            for (int c = 0; c &lt; dtHistoricalReconTransactionsReportMatched.Columns.Count; c++)&#xA;            {&#xA;                var col = dtHistoricalReconTransactionsReportMatched.Columns[c];&#xA;                if (dtHistoricalReconTransactionsReport.Columns.Contains(col.ColumnName))&#xA;                    dest[col.ColumnName] = src[col.ColumnName];&#xA;            }&#xA;            dest[&quot;Classification&quot;] = &quot;PPAT&quot;;&#xA;            dtHistoricalReconTransactionsReportMatched.Rows.Add(dest);&#xA;            toRemoveRowRefs.Add(src);&#xA;            rowsMovedRRN++;&#xA;        }&#xA;&#xA;        // Move CMS principal rows&#xA;        for (int b = 0; b &lt; cmsIdxs.Count; b++)&#xA;        {&#xA;            var src = dtHistoricalReconTransactionsReport.Rows[cmsIdxs[b]];&#xA;            string narrU = (src[&quot;Narration&quot;] == null ? &quot;&quot; : src[&quot;Narration&quot;].ToString()).ToUpperInvariant();&#xA;            if (IsFeeNarration(narrU)) continue;&#xA;&#xA;            var dest = dtHistoricalReconTransactionsReportMatched.NewRow();&#xA;            for (int c = 0; c &lt; dtHistoricalReconTransactionsReportMatched.Columns.Count; c++)&#xA;            {&#xA;                var col = dtHistoricalReconTransactionsReportMatched.Columns[c];&#xA;                if (dtHistoricalReconTransactionsReport.Columns.Contains(col.ColumnName))&#xA;                    dest[col.ColumnName] = src[col.ColumnName];&#xA;            }&#xA;            dest[&quot;Classification&quot;] = &quot;PPAT&quot;;&#xA;            dtHistoricalReconTransactionsReportMatched.Rows.Add(dest);&#xA;            toRemoveRowRefs.Add(src);&#xA;            rowsMovedRRN++;&#xA;        }&#xA;&#xA;        roundingErrorPPAT += delta; // signed; will be tiny under new tolerance&#xA;        groupsMatchedRRN++;&#xA;&#xA;        // record sample for diagnostics&#xA;        if (delta != 0m) deltaSamples.Add((rrn, glPrincipal, cmsPrincipal, delta));&#xA;&#xA;        System.Console.WriteLine($&quot;✅ MATCH (PPAT principal) by RRN — Δ={delta:N2}&quot;);&#xA;    }&#xA;    else&#xA;    {&#xA;        System.Console.WriteLine(&quot;❌ NO MATCH — Principal outside tolerance (RRN pass)&quot;);&#xA;    }&#xA;}&#xA;&#xA;// ---------- Remove moved rows from source ----------&#xA;int removedRRN = 0;&#xA;for (int i = 0; i &lt; toRemoveRowRefs.Count; i++)&#xA;{&#xA;    var r = toRemoveRowRefs[i];&#xA;    if (r != null &amp;&amp; r.Table == dtHistoricalReconTransactionsReport &amp;&amp; r.RowState != System.Data.DataRowState.Detached)&#xA;    {&#xA;        dtHistoricalReconTransactionsReport.Rows.Remove(r);&#xA;        removedRRN++;&#xA;    }&#xA;}&#xA;&#xA;// ---------- Finalize ----------&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;dtHistoricalReconTransactionsReportMatched.AcceptChanges();&#xA;&#xA;sw.Stop();&#xA;System.Console.WriteLine($&quot;📦 PASS#1 (RRN) → Groups matched: {groupsMatchedRRN}, Rows moved: {rowsMovedRRN}, Groups skipped (no principal): {groupsSkippedRRNNoPrincipal}, Rows removed: {removedRRN}&quot;);&#xA;System.Console.WriteLine($&quot;🧮 roundingErrorPPAT (principal-only total): {roundingErrorPPAT:N2}&quot;);&#xA;if (deltaSamples.Count &gt; 0)&#xA;{&#xA;    // Show top 10 absolute contributors (should be tiny if tolerance is tight)&#xA;    deltaSamples.Sort((x,y) =&gt; System.Math.Abs(y.delta).CompareTo(System.Math.Abs(x.delta)));&#xA;    int show = System.Math.Min(10, deltaSamples.Count);&#xA;    System.Console.WriteLine(&quot;🔎 Top rounding contributors (Δ):&quot;);&#xA;    for (int i = 0; i &lt; show; i++)&#xA;        System.Console.WriteLine($&quot;   {i+1}. RRN={deltaSamples[i].rrn} | GL={deltaSamples[i].gl:N2} | CMS={deltaSamples[i].cms:N2} | Δ={deltaSamples[i].delta:N2}&quot;);&#xA;}&#xA;System.Console.WriteLine($&quot;🏁 Finished at {System.DateTime.Now:yyyy-MM-dd HH:mm:ss} | ⏱ {sw.Elapsed.TotalSeconds:N1}s&quot;);&#xA;" DisplayName="PPAT + roundingErrorPPAT" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_84" Language="CSharp">

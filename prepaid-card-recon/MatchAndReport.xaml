        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: ALL GL ROWS — CWPP label + Strict 16-char Auto Rules + Strict 16-char Late Posted + Integrity Sweep =====&#xA;// OPTION A: STRICT MODE — All Auto Rules + Late Posted ONLY apply when Transaction Ref No (cleaned) is exactly 16 characters.&#xA;//&#xA;// In/Out: DataTable dtHistoricalReconTransactionsReport&#xA;// In    : DataTable dtHistoricalReconTransactionsReportMatched (optional)&#xA;// In    : string reconDate&#xA;&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport));&#xA;&#xA;var swAll = System.Diagnostics.Stopwatch.StartNew();&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// Helpers&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;void EnsureCol(System.Data.DataTable dt, string name)&#xA;{&#xA;    if (!dt.Columns.Contains(name))&#xA;        dt.Columns.Add(name, typeof(string));&#xA;}&#xA;&#xA;string GetStr(System.Data.DataRow r, string col)&#xA;{&#xA;    if (!r.Table.Columns.Contains(col)) return &quot;&quot;;&#xA;    var v = r[col];&#xA;    return (v == null || v == System.DBNull.Value) ? &quot;&quot; : v.ToString();&#xA;}&#xA;&#xA;bool SetIfEmpty(System.Data.DataRow r, string col, string val)&#xA;{&#xA;    EnsureCol(r.Table, col);&#xA;    if (string.IsNullOrWhiteSpace(GetStr(r, col)))&#xA;    {&#xA;        r[col] = val ?? &quot;&quot;;&#xA;        return true;&#xA;    }&#xA;    return false;&#xA;}&#xA;&#xA;DateTime? ParseDateFlexible(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return null;&#xA;&#xA;    if (val is DateTime dt) return dt;&#xA;&#xA;    if (val is double d)&#xA;    {&#xA;        try { return DateTime.FromOADate(d); } catch { }&#xA;    }&#xA;&#xA;    double d2;&#xA;    if (double.TryParse(&#xA;            Convert.ToString(val),&#xA;            System.Globalization.NumberStyles.Float,&#xA;            System.Globalization.CultureInfo.InvariantCulture,&#xA;            out d2))&#xA;    {&#xA;        try { return DateTime.FromOADate(d2); } catch { }&#xA;    }&#xA;&#xA;    string s = Convert.ToString(val).Trim();&#xA;    string[] fmts =&#xA;    {&#xA;        &quot;dd/MM/yyyy&quot;,&quot;dd/MM/yyyy HH:mm:ss&quot;,&quot;dd/MM/yyyy HH:mm&quot;,&#xA;        &quot;yyyy-MM-dd&quot;,&quot;yyyy-MM-dd HH:mm:ss&quot;,&quot;yyyy/MM/dd&quot;&#xA;    };&#xA;&#xA;    DateTime exact;&#xA;    if (DateTime.TryParseExact(&#xA;            s,&#xA;            fmts,&#xA;            System.Globalization.CultureInfo.InvariantCulture,&#xA;            System.Globalization.DateTimeStyles.None,&#xA;            out exact))&#xA;        return exact;&#xA;&#xA;    DateTime any;&#xA;    if (DateTime.TryParse(s, out any)) return any;&#xA;&#xA;    return null;&#xA;}&#xA;&#xA;// Compute cleaned reference string&#xA;string CleanRef(string refRaw)&#xA;{&#xA;    return (refRaw ?? &quot;&quot;)&#xA;        .Replace(&quot; &quot;, &quot;&quot;)&#xA;        .Trim()&#xA;        .ToUpperInvariant();&#xA;}&#xA;&#xA;// TRUE only if cleaned ref is 16 chars&#xA;bool Is16CharRef(string refRaw)&#xA;{&#xA;    return CleanRef(refRaw).Length == 16;&#xA;}&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// Integrity &amp; classification recognizers&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;bool IsUMJP_UbxLabel(System.Data.DataRow r)&#xA;{&#xA;    return GetStr(r,&quot;Root Cause&quot;)          == &quot;Wrong configuration of UBX ATM charges&quot; &amp;&amp;&#xA;           GetStr(r,&quot;Root Cause Category&quot;) == &quot;People&quot; &amp;&amp;&#xA;           GetStr(r,&quot;Recommended Action&quot;)  == &quot;Reverse the charges and correctly configure CBS to pass the right charges&quot; &amp;&amp;&#xA;           GetStr(r,&quot;Action Owner&quot;)        == &quot;Card Settlement &amp; Stephen Jilala&quot;;&#xA;}&#xA;&#xA;bool IsCashbackLabel(System.Data.DataRow r)&#xA;{&#xA;    return GetStr(r,&quot;Root Cause&quot;)          == &quot;Cashback updated CBS only&quot; &amp;&amp;&#xA;           GetStr(r,&quot;Root Cause Category&quot;) == &quot;System&quot; &amp;&amp;&#xA;           GetStr(r,&quot;Recommended Action&quot;)  == &quot;Perform MISC ADJUSTMENT CREDIT&quot; &amp;&amp;&#xA;           GetStr(r,&quot;Action Owner&quot;)        == &quot;Stephen Jilala&quot;;&#xA;}&#xA;&#xA;bool IsCashbackLocked(System.Data.DataRow r)&#xA;{&#xA;    return GetStr(r, &quot;CashbackLock&quot;) == &quot;1&quot;;&#xA;}&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// GLOBAL PROTECTED ROOT CAUSES — SKIP ALL PROCESSING IN THIS MODULE&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// Add any Root Cause text here that must never be touched by this module.&#xA;var protectedRootCauses = new System.Collections.Generic.HashSet&lt;string&gt;(System.StringComparer.OrdinalIgnoreCase)&#xA;{&#xA;    &quot;Wakala withdrawal debited TZS instead of FX GL&quot;,&#xA;    &quot;FX billed withdrawal posted as TZS debit&quot;&#xA;    // &lt;&lt;&lt; ADD MORE ROOT CAUSE TEXTS HERE AS NEEDED&#xA;};&#xA;&#xA;bool IsProtectedRootCause(System.Data.DataRow r)&#xA;{&#xA;    string rc = GetStr(r, &quot;Root Cause&quot;);&#xA;    if (string.IsNullOrWhiteSpace(rc)) return false;&#xA;    return protectedRootCauses.Contains(rc.Trim());&#xA;}&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// Strict Late Posted logic — only 16-char references allowed&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;DateTime? reconParsed = ParseDateFlexible(reconDate);&#xA;&#xA;bool ShouldMarkLatePosted(System.Data.DataRow row)&#xA;{&#xA;    // STRICT MODE: Late Posted ONLY if 16-char reference&#xA;    if (!Is16CharRef(GetStr(row, &quot;Transaction Ref No:&quot;)))&#xA;        return false;&#xA;&#xA;    if (reconParsed == null) return false;&#xA;&#xA;    if (!row.Table.Columns.Contains(&quot;Value Date&quot;))&#xA;        return false;&#xA;&#xA;    DateTime? v = ParseDateFlexible(row[&quot;Value Date&quot;]);&#xA;    if (v == null) return false;&#xA;&#xA;    DateTime start = reconParsed.Value.AddDays(-2).Date;&#xA;    DateTime end   = reconParsed.Value.AddDays(+2).Date;&#xA;&#xA;    return v.Value.Date &gt;= start &amp;&amp; v.Value.Date &lt;= end;&#xA;}&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// Ensure required columns&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;string[] needCols = {&#xA;    &quot;Branch code&quot;,&quot;GL_Code&quot;,&quot;GL Description&quot;,&#xA;    &quot;Transaction Ref No:&quot;,&quot;Narration&quot;,&#xA;    &quot;Root Cause&quot;,&quot;Root Cause Category&quot;,&quot;Recommended Action&quot;,&quot;Action Owner&quot;,&#xA;    &quot;Aging&quot;,&quot;Aging Group&quot;,&quot;BOT Classification&quot;,&#xA;    &quot;Type&quot;,&quot;Source&quot;,&quot;CashbackLock&quot;,&quot;CashbackKey&quot;,&#xA;    &quot;ROOT_CAUSE_PROCESSED&quot;   // &lt;= globally respected flag (but NOT for Late Posted)&#xA;};&#xA;foreach (string c in needCols) EnsureCol(dtHistoricalReconTransactionsReport, c);&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// Default GL rule values&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;const string DEF_RC_GL   = &quot;Unmatched manual entries&quot;;&#xA;const string DEF_RCAT_GL = &quot;System&quot;;&#xA;const string DEF_ACT_GL  = &quot;To be manually matched&quot;;&#xA;const string DEF_OWN_GL  = &quot;Card Reconciliation&quot;;&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// Build CWPP set from Matched table&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;var cwppSet = new System.Collections.Generic.HashSet&lt;string&gt;(System.StringComparer.OrdinalIgnoreCase);&#xA;&#xA;if (dtHistoricalReconTransactionsReportMatched != null &amp;&amp;&#xA;    dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Transaction Ref No:&quot;))&#xA;{&#xA;    foreach (System.Data.DataRow m in dtHistoricalReconTransactionsReportMatched.Rows)&#xA;    {&#xA;        string rc = CleanRef(GetStr(m, &quot;Transaction Ref No:&quot;));&#xA;        if (rc.Contains(&quot;CWPP&quot;) || rc.Contains(&quot;PPPC&quot;))&#xA;            cwppSet.Add(rc);&#xA;    }&#xA;}&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// PASS A — GL classification with strict 16-char gating&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    // GLOBAL SKIP: if protected Root Cause, this module must not touch it at all&#xA;    if (IsProtectedRootCause(row))&#xA;        continue;&#xA;&#xA;    // GLOBAL SKIP: if already processed by any other module (PPAT, PPSA, PPSP, AGW FX, etc.)&#xA;    string processedFlag = GetStr(row, &quot;ROOT_CAUSE_PROCESSED&quot;).Trim().ToUpperInvariant();&#xA;    if (processedFlag == &quot;TRUE&quot;)&#xA;        continue;&#xA;&#xA;    if (!GetStr(row, &quot;Source&quot;).Equals(&quot;GL&quot;, StringComparison.OrdinalIgnoreCase))&#xA;        continue;&#xA;&#xA;    // Static GL values&#xA;    row[&quot;Branch code&quot;]    = &quot;101&quot;;&#xA;    row[&quot;GL_Code&quot;]        = &quot;202030015&quot;;&#xA;    row[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;&#xA;    string refRaw   = GetStr(row, &quot;Transaction Ref No:&quot;);&#xA;    string refClean = CleanRef(refRaw);&#xA;    bool is16       = (refClean.Length == 16);&#xA;&#xA;    string narr = GetStr(row, &quot;Narration&quot;).ToLowerInvariant();&#xA;&#xA;    // Preserve any rows that already have sensitive labels&#xA;    bool preserve =&#xA;        IsCashbackLabel(row) ||&#xA;        IsCashbackLocked(row) ||&#xA;        IsUMJP_UbxLabel(row);&#xA;        // Protected root causes already skipped above&#xA;&#xA;    // ========= AUTO RULES REQUIRE 16-CHAR REFERENCE =========&#xA;    bool hasCWPP = refClean.Contains(&quot;CWPP&quot;) || refClean.Contains(&quot;PPPC&quot;);&#xA;    bool hasUMJP = refClean.Contains(&quot;UMJP&quot;) || refClean.Contains(&quot;AWPU&quot;);&#xA;    bool hasUBX  = refClean.Contains(&quot;UBX&quot;);&#xA;    bool hasAGW  = refClean.Contains(&quot;AGW&quot;) || refClean.Contains(&quot;CHWD&amp;AGPS&quot;);&#xA;    bool hasPRDP = refClean.Contains(&quot;PRDP&quot;) || refClean.Contains(&quot;PRTP&quot;);&#xA;    bool hasAGR1 = refClean.Contains(&quot;AGR1&quot;);&#xA;    bool hasAGR2 = refClean.Contains(&quot;AGR2&quot;);&#xA;    bool hasAGR3 = refClean.Contains(&quot;AGR3&quot;);&#xA;&#xA;    // ========= NON-OVERRIDING RULES =========&#xA;    if (!preserve)&#xA;    {&#xA;        // 1. Narration date-range rule (DOES NOT require 16 chars)&#xA;        if (System.Text.RegularExpressions.Regex.IsMatch(&#xA;                narr,&#xA;                @&quot;\b(for|from)\s?\d{6}(\s?(to|_)\s?\d{6})\b&quot;))&#xA;        {&#xA;            row[&quot;Root Cause&quot;]          = &quot;Manually posted income not matching with income from CMS&quot;;&#xA;            row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;            row[&quot;Recommended Action&quot;]  = &quot;Reverse the wrong amount and post the correct one&quot;;&#xA;            row[&quot;Action Owner&quot;]        = &quot;Card Finance&quot;;&#xA;        }&#xA;        // 2. All other auto rules require strict 16-char ref&#xA;        else if (is16)&#xA;        {&#xA;            // CWPP&#xA;            if (hasCWPP &amp;&amp; cwppSet.Contains(refClean))&#xA;            {&#xA;                row[&quot;Root Cause&quot;]          = &quot;Cashback updated CBS only&quot;;&#xA;                row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;                row[&quot;Recommended Action&quot;]  = &quot;Perform MISC ADJUSTMENT CREDIT&quot;;&#xA;                row[&quot;Action Owner&quot;]        = &quot;Stephen Jilala&quot;;&#xA;                row[&quot;CashbackLock&quot;]        = &quot;1&quot;;&#xA;                row[&quot;CashbackKey&quot;]         = &quot;REFNO=&quot; + refClean;&#xA;            }&#xA;            // UMJP (UBX mischarges)&#xA;            else if (hasUMJP &amp;&amp;&#xA;                     (narr.Contains(&quot;cash withdraw charge&quot;) ||&#xA;                      narr.Contains(&quot;vat payable on comm and fees&quot;) ||&#xA;                      narr.Contains(&quot;atm withdrawl prepaid&quot;)))&#xA;            {&#xA;                row[&quot;Root Cause&quot;]          = &quot;Wrong configuration of UBX ATM charges&quot;;&#xA;                row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;                row[&quot;Recommended Action&quot;]  = &quot;Reverse the charges and correctly configure CBS to pass the right charges&quot;;&#xA;                row[&quot;Action Owner&quot;]        = &quot;Card Settlement &amp; Stephen Jilala&quot;;&#xA;            }&#xA;            // UBX&#xA;            else if (hasUBX)&#xA;            {&#xA;                row[&quot;Root Cause&quot;]          = &quot;UBX fee updated CBS only&quot;;&#xA;                row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;                row[&quot;Recommended Action&quot;]  = &quot;Perform adjustment in CBS&quot;;&#xA;                row[&quot;Action Owner&quot;]        = &quot;Card Settlement&quot;;&#xA;            }&#xA;            // AGW&#xA;            else if (hasAGW)&#xA;            {&#xA;                row[&quot;Root Cause&quot;]          = &quot;Wakala updated CBS only&quot;;&#xA;                row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;                row[&quot;Recommended Action&quot;]  = &quot;Under investigation&quot;;&#xA;                row[&quot;Action Owner&quot;]        = &quot;Stephen Jilala&quot;;&#xA;            }&#xA;            // PRDP / AGR1 / AGR2&#xA;            else if (hasPRDP || hasAGR1 || hasAGR2 || hasAGR3)&#xA;            {&#xA;                row[&quot;Root Cause&quot;]          = &quot;Loading updated CBS only&quot;;&#xA;                row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;                row[&quot;Recommended Action&quot;]  = &quot;Perform MISC ADJUSTMENT CREDIT&quot;;&#xA;                row[&quot;Action Owner&quot;]        = &quot;Stephen Jilala&quot;;&#xA;            }&#xA;            else&#xA;            {&#xA;                // DEFAULT GL&#xA;                row[&quot;Root Cause&quot;]          = DEF_RC_GL;&#xA;                row[&quot;Root Cause Category&quot;] = DEF_RCAT_GL;&#xA;                row[&quot;Recommended Action&quot;]  = DEF_ACT_GL;&#xA;                row[&quot;Action Owner&quot;]        = DEF_OWN_GL;&#xA;            }&#xA;        }&#xA;        else&#xA;        {&#xA;            // NOT 16 chars → Strict default GL ONLY&#xA;            row[&quot;Root Cause&quot;]          = DEF_RC_GL;&#xA;            row[&quot;Root Cause Category&quot;] = DEF_RCAT_GL;&#xA;            row[&quot;Recommended Action&quot;]  = DEF_ACT_GL;&#xA;            row[&quot;Action Owner&quot;]        = DEF_OWN_GL;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// PASS B — STRICT 16-CHAR LATE POSTED  (ONLY thing allowed to override processed rows)&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string src = GetStr(row, &quot;Source&quot;).Trim().ToUpperInvariant();&#xA;    if (src != &quot;GL&quot;) continue;&#xA;&#xA;    // Never touch globally protected root causes&#xA;    if (IsProtectedRootCause(row))&#xA;        continue;&#xA;&#xA;    // Never alter cashback&#xA;    if (IsCashbackLabel(row) || IsCashbackLocked(row))&#xA;        continue;&#xA;&#xA;    // STRICT MODE: Late Posted ONLY IF 16-char reference&#xA;    if (!Is16CharRef(GetStr(row, &quot;Transaction Ref No:&quot;)))&#xA;        continue;&#xA;&#xA;    if (ShouldMarkLatePosted(row))&#xA;    {&#xA;        // Still non-overriding on text (SetIfEmpty),&#xA;        // but this pass is NOT blocked by ROOT_CAUSE_PROCESSED&#xA;        SetIfEmpty(row, &quot;Root Cause&quot;,          &quot;Late posted transaction&quot;);&#xA;        SetIfEmpty(row, &quot;Root Cause Category&quot;, &quot;System&quot;);&#xA;        SetIfEmpty(row, &quot;Recommended Action&quot;,  &quot;Check if updates CMS on the following date&quot;);&#xA;        SetIfEmpty(row, &quot;Action Owner&quot;,        &quot;Card Reconciliation&quot;);&#xA;        // We intentionally do NOT touch ROOT_CAUSE_PROCESSED here.&#xA;    }&#xA;}&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// FINAL — Cashback Integrity Sweep (still respects ROOT_CAUSE_PROCESSED)&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    // Skip globally protected root causes&#xA;    if (IsProtectedRootCause(row))&#xA;        continue;&#xA;&#xA;    string processedFlag = GetStr(row, &quot;ROOT_CAUSE_PROCESSED&quot;).Trim().ToUpperInvariant();&#xA;    if (processedFlag == &quot;TRUE&quot;)&#xA;        continue;&#xA;&#xA;    if (GetStr(row, &quot;CashbackLock&quot;) == &quot;1&quot;)&#xA;    {&#xA;        if (!IsCashbackLabel(row))&#xA;        {&#xA;            row[&quot;Root Cause&quot;]          = &quot;Cashback updated CBS only&quot;;&#xA;            row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;            row[&quot;Recommended Action&quot;]  = &quot;Perform MISC ADJUSTMENT CREDIT&quot;;&#xA;            row[&quot;Action Owner&quot;]        = &quot;Stephen Jilala&quot;;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;swAll.Stop();&#xA;System.Console.WriteLine(&#xA;    &quot;Completed GL Classification — STRICT 16-char Auto Rules &amp; Late Posted logic applied &quot; +&#xA;    &quot;(Late Posted not blocked by ROOT_CAUSE_PROCESSED, protected Root Causes fully skipped).&quot;);&#xA;" DisplayName="PPS SAFE GUARD" sap:VirtualizedContainerService.HintSize="450,57.333333333333336" sap2010:WorkflowViewState.IdRef="InvokeCode_101" Language="CSharp">
          <ui:InvokeCode.Arguments>
            <InOutArgument x:TypeArguments="x:String" x:Key="prepaidCardFileName">[prepaidCardFileName]</InOutArgument>
            <InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtHistoricalReconTransactionsReport">[dtHistoricalReconTransactionsReport]</InOutArgument>
            <InOutArgument x:TypeArguments="x:Decimal" x:Key="glClosingBalance">[glClosingBalance]</InOutArgument>
            <InOutArgument x:TypeArguments="x:Decimal" x:Key="cmsBalance">[cmsBalance]</InOutArgument>
            <InOutArgument x:TypeArguments="x:String" x:Key="reconDate">[reconDate]</InOutArgument>
            <InOutArgument x:TypeArguments="x:String" x:Key="reconCurrency">[reconCurrency]</InOutArgument>
            <InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtHistoricalReconTransactionsReportMatched">[dtHistoricalReconTransactionsReportMatched]</InOutArgument>
          </ui:InvokeCode.Arguments>
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsPinned">False</x:Boolean>
              <x:Boolean x:Key="IsExpanded">False</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>

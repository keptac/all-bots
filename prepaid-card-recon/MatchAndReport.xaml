              <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: GL new classification (no PPAT, no DR/CR changes) =====&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport&#xA;&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport));&#xA;&#xA;// Ensure needed columns exist&#xA;string[] needStringCols = new[]&#xA;{&#xA;    &quot;Branch code&quot;,&quot;GL_Code&quot;,&quot;GL Description&quot;,&quot;Transaction Ref No:&quot;,&quot;Narration&quot;,&#xA;    &quot;Root Cause&quot;,&quot;Root Cause Category&quot;,&quot;Recommended Action&quot;,&quot;Action Owner&quot;,&#xA;    &quot;Aging&quot;,&quot;Aging Group&quot;,&quot;BOT Classification&quot;,&quot;Type&quot;,&quot;Source&quot;&#xA;};&#xA;for (int i = 0; i &lt; needStringCols.Length; i++)&#xA;{&#xA;    string c = needStringCols[i];&#xA;    if (!dtHistoricalReconTransactionsReport.Columns.Contains(c))&#xA;        dtHistoricalReconTransactionsReport.Columns.Add(c, typeof(string));&#xA;}&#xA;&#xA;// Defaults for GL if blank&#xA;const string DEF_RC_GL   = &quot;Unmatched manual entries&quot;;&#xA;const string DEF_RCAT_GL = &quot;System&quot;;&#xA;const string DEF_ACT_GL  = &quot;To be manually matched&quot;;&#xA;const string DEF_OWN_GL  = &quot;Card Reconciliation&quot;;&#xA;&#xA;// Excel row counter (for formulas)&#xA;int reportRowNumber = 2;&#xA;&#xA;// Pass: classify GL rows&#xA;for (int r = 0; r &lt; dtHistoricalReconTransactionsReport.Rows.Count; r++)&#xA;{&#xA;    var row = dtHistoricalReconTransactionsReport.Rows[r];&#xA;&#xA;    // Only act on GL/new&#xA;    string src = (row[&quot;Source&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Source&quot;].ToString().Trim().ToUpperInvariant());&#xA;    string typ = (row[&quot;Type&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Type&quot;].ToString().Trim().ToLowerInvariant());&#xA;    if (!(src == &quot;GL&quot; &amp;&amp; typ == &quot;new&quot;))&#xA;        continue;&#xA;&#xA;    // Static values&#xA;    row[&quot;Branch code&quot;]    = &quot;101&quot;;&#xA;    row[&quot;GL_Code&quot;]        = &quot;202030015&quot;;&#xA;    row[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;&#xA;    // Formulas&#xA;    row[&quot;Aging&quot;] = &quot;=$H$6-G&quot; + reportRowNumber;&#xA;    row[&quot;Aging Group&quot;] = &quot;=IF(L&quot; + reportRowNumber + &quot;&lt;4,\&quot;0-3 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;31,\&quot;4-30 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;61,\&quot;31-60 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;=90,\&quot;61-90 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;    row[&quot;BOT Classification&quot;] = &quot;=IF(J&quot; + reportRowNumber + &quot;&gt;0,IF(L&quot; + reportRowNumber + &quot;&lt;30,\&quot;Normal\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;60,\&quot;Especially Mentioned\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;90,\&quot;Substandard\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;=180,\&quot;Doubtful\&quot;,IF(L&quot; + reportRowNumber + &quot;&gt;180,\&quot;Loss\&quot;,\&quot;0\&quot;)))))),\&quot;Not Applicable\&quot;)&quot;;&#xA;&#xA;    // Safe text lowers/uppers&#xA;    string refNo = (row[&quot;Transaction Ref No:&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Transaction Ref No:&quot;].ToString()).ToUpperInvariant();&#xA;    string narration = (row[&quot;Narration&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Narration&quot;].ToString());&#xA;    string narrationLower = narration.ToLowerInvariant();&#xA;&#xA;    // Normalized narration (letters only, spaces collapsed)&#xA;    string normalizedNarration = System.Text.RegularExpressions.Regex.Replace(narrationLower, @&quot;[^a-z\s]&quot;, &quot;&quot;);&#xA;    normalizedNarration = System.Text.RegularExpressions.Regex.Replace(normalizedNarration, @&quot;\s+&quot;, &quot; &quot;);&#xA;&#xA;    // Flags&#xA;    bool refContainsPPSP = refNo.Contains(&quot;PPSP&quot;);&#xA;    bool refContainsPPSA = refNo.Contains(&quot;PPSA&quot;);&#xA;    bool refContainsPRDP = refNo.Contains(&quot;PRDP&quot;);&#xA;    bool refContainsAGR1 = refNo.Contains(&quot;AGR1&quot;);&#xA;    bool refContainsAGR2 = refNo.Contains(&quot;AGR2&quot;);&#xA;    bool refContainsAGW  = refNo.Contains(&quot;AGW&quot;);&#xA;    bool refContainsCWPP = refNo.Contains(&quot;CWPP&quot;);&#xA;&#xA;    // Existing values&#xA;    string curRC   = row[&quot;Root Cause&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Root Cause&quot;].ToString();&#xA;    string curRCat = row[&quot;Root Cause Category&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Root Cause Category&quot;].ToString();&#xA;    string curAct  = row[&quot;Recommended Action&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Recommended Action&quot;].ToString();&#xA;    string curOwn  = row[&quot;Action Owner&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Action Owner&quot;].ToString();&#xA;&#xA;    bool hasRC   = !string.IsNullOrWhiteSpace(curRC);&#xA;    bool hasRCat = !string.IsNullOrWhiteSpace(curRCat);&#xA;    bool hasAct  = !string.IsNullOrWhiteSpace(curAct);&#xA;    bool hasOwn  = !string.IsNullOrWhiteSpace(curOwn);&#xA;&#xA;    // === Classification rules ===&#xA;    if (System.Text.RegularExpressions.Regex.IsMatch(narrationLower, @&quot;\b(for|from)\s?\d{6}(\s?(to|_)\s?\d{6})\b&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase))&#xA;    {&#xA;        if (!hasRC)   row[&quot;Root Cause&quot;] = &quot;Manually posted income not matching with income from CMS&quot;;&#xA;        if (!hasRCat) row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        if (!hasAct)  row[&quot;Recommended Action&quot;] = &quot;Reverse the wrong amount and post the correct one&quot;;&#xA;        if (!hasOwn)  row[&quot;Action Owner&quot;] = &quot;Card Finance&quot;;&#xA;    }&#xA;    else if (refContainsPPSP || refContainsPPSA)&#xA;    {&#xA;        if (!hasRC)   row[&quot;Root Cause&quot;] = &quot;Auth dump posted transactions not matched against outstanding remote-on-us txns&quot;;&#xA;        if (!hasRCat) row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        if (!hasAct)  row[&quot;Recommended Action&quot;] = &quot;Under investigation&quot;;&#xA;        if (!hasOwn)  row[&quot;Action Owner&quot;] = &quot;Card Reconciliation&quot;;&#xA;        reportRowNumber++;&#xA;        continue;&#xA;    }&#xA;    else if (refContainsCWPP)&#xA;    {&#xA;        if (!hasRC)   row[&quot;Root Cause&quot;] = &quot;Auth dump posted transactions not matched against outstanding remote-on-us txns&quot;;&#xA;        if (!hasRCat) row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        if (!hasAct)  row[&quot;Recommended Action&quot;] = &quot;Under investigation&quot;;&#xA;        if (!hasOwn)  row[&quot;Action Owner&quot;] = &quot;Card Reconciliation&quot;;&#xA;    }&#xA;    else if (refNo.Contains(&quot;UMJP&quot;) &amp;&amp;&#xA;            (narrationLower.Contains(&quot;cash withdraw charge&quot;) ||&#xA;             narrationLower.Contains(&quot;vat payable on comm and fees&quot;) ||&#xA;             narrationLower.Contains(&quot;atm withdrawl prepaid&quot;)))&#xA;    {&#xA;        if (!hasRC)   row[&quot;Root Cause&quot;] = &quot;Wrong configuration of UBX ATM charges&quot;;&#xA;        if (!hasRCat) row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        if (!hasAct)  row[&quot;Recommended Action&quot;] = &quot;Reverse the charges and correctly configure CBS to pass the right charges&quot;;&#xA;        if (!hasOwn)  row[&quot;Action Owner&quot;] = &quot;Card Settlement &amp; Stephen Jilala&quot;;&#xA;    }&#xA;    else if (refContainsPRDP || refContainsAGR1 || refContainsAGR2)&#xA;    {&#xA;        if (!hasRC)   row[&quot;Root Cause&quot;] = &quot;Loading updated CBS only&quot;;&#xA;        if (!hasRCat) row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        if (!hasAct)  row[&quot;Recommended Action&quot;] = &quot;Perform MISC ADJUSTMENT CREDIT&quot;;&#xA;        if (!hasOwn)  row[&quot;Action Owner&quot;] = &quot;Stephen Jilala&quot;;&#xA;    }&#xA;    else if (refContainsAGW)&#xA;    {&#xA;        if (!hasRC)   row[&quot;Root Cause&quot;] = &quot;Wakala updated CBS only&quot;;&#xA;        if (!hasRCat) row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        if (!hasAct)  row[&quot;Recommended Action&quot;] = &quot;Under investigation&quot;;&#xA;        if (!hasOwn)  row[&quot;Action Owner&quot;] = &quot;Stephen Jilala&quot;;&#xA;    }&#xA;    else if (normalizedNarration.Contains(&quot;journal posting miscellaneous&quot;))&#xA;    {&#xA;        if (!hasRC)   row[&quot;Root Cause&quot;] = DEF_RC_GL;&#xA;        if (!hasRCat) row[&quot;Root Cause Category&quot;] = DEF_RCAT_GL;&#xA;        if (!hasAct)  row[&quot;Recommended Action&quot;] = DEF_ACT_GL;&#xA;        if (!hasOwn)  row[&quot;Action Owner&quot;] = DEF_OWN_GL;&#xA;    }&#xA;&#xA;    // Final safety: ensure defaults if still blank&#xA;    if (!hasRC)   row[&quot;Root Cause&quot;] = DEF_RC_GL;&#xA;    if (!hasRCat) row[&quot;Root Cause Category&quot;] = DEF_RCAT_GL;&#xA;    if (!hasAct)  row[&quot;Recommended Action&quot;] = DEF_ACT_GL;&#xA;    if (!hasOwn)  row[&quot;Action Owner&quot;] = DEF_OWN_GL;&#xA;&#xA;    reportRowNumber++;&#xA;}&#xA;" DisplayName="Source = GL" sap:VirtualizedContainerService.HintSize="452.6666666666667,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_59" Language="CSharp">

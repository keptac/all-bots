          <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: AGW FX Root Causes (CMS-Driven, Unicode-Clean, Heavy Logging) ====&#xA;//&#xA;// In/Out: DataTable dtHistoricalReconTransactionsReport&#xA;// In    : DataTable dtTransactionReportForeignCurrencyTZS&#xA;// In    : string reconCurrency&#xA;//&#xA;// This version fixes ALL matching issues:&#xA;//   ✓ Unicode-cleaning for GL Narration&#xA;//   ✓ C_PAN normalized to FIRST6 + &quot;XXXXXX&quot; + LAST4&#xA;//   ✓ CMS-driven matching using Reference Number&#xA;//   ✓ GL grouped by PAN and summed to match CMS Transaction Amount&#xA;//   ✓ Works for your sample (AGW 9556.00)&#xA;//&#xA;// --------------------------------------------------------------------&#xA;&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport));&#xA;&#xA;System.Data.DataTable t = dtHistoricalReconTransactionsReport;&#xA;&#xA;// --------------------------------------------------------------&#xA;// Logger&#xA;// --------------------------------------------------------------&#xA;System.Action&lt;string&gt; Log = msg =&gt; System.Console.WriteLine(msg);&#xA;Log(&quot;=== AGW FX PROCESSING START (CMS-Driven; Unicode-Clean) ===&quot;);&#xA;&#xA;// --------------------------------------------------------------&#xA;// Dynamic GL debit/credit columns&#xA;// --------------------------------------------------------------&#xA;string debitCol  = &quot;Debit (&quot;  + reconCurrency + &quot;)&quot;;&#xA;string creditCol = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xA;&#xA;if (!t.Columns.Contains(debitCol))  throw new Exception(&quot;Missing column: &quot; + debitCol);&#xA;if (!t.Columns.Contains(creditCol)) throw new Exception(&quot;Missing column: &quot; + creditCol);&#xA;&#xA;// --------------------------------------------------------------&#xA;// Ensure required GL columns exist&#xA;// --------------------------------------------------------------&#xA;string[] cols = {&#xA;    &quot;C_PAN&quot;,&quot;PS_RRN&quot;,&#xA;    &quot;Root Cause&quot;,&quot;Root Cause Category&quot;,&quot;Recommended Action&quot;,&quot;Action Owner&quot;,&#xA;    &quot;ROOT_CAUSE_PROCESSED&quot;,&quot;Source&quot;&#xA;};&#xA;&#xA;foreach (string c in cols)&#xA;    if (!t.Columns.Contains(c))&#xA;        t.Columns.Add(c, typeof(string));&#xA;&#xA;// --------------------------------------------------------------&#xA;// Helpers&#xA;// --------------------------------------------------------------&#xA;string SafeStr(object v)&#xA;{&#xA;    return (v == null || v == DBNull.Value) ? &quot;&quot; : v.ToString();&#xA;}&#xA;&#xA;// Remove ALL invisible Unicode characters&#xA;string CleanUnicode(string s)&#xA;{&#xA;    if (string.IsNullOrEmpty(s)) return &quot;&quot;;&#xA;    return new string(s.Where(ch =&gt;&#xA;        ch != '\u200B' &amp;&amp;  // zero-width space&#xA;        ch != '\u200C' &amp;&amp;  // zero-width non-joiner&#xA;        ch != '\u200D' &amp;&amp;  // zero-width joiner&#xA;        ch != '\uFEFF' &amp;&amp;  // zero-width no-break space&#xA;        ch != '\u00A0'     // non-breaking space&#xA;    ).ToArray());&#xA;}&#xA;&#xA;decimal ParseAmt(object v)&#xA;{&#xA;    if (v == null || v == DBNull.Value) return 0m;&#xA;    string s = CleanUnicode(Convert.ToString(v).Trim());&#xA;    if (s == &quot;&quot;) return 0m;&#xA;&#xA;    bool negParen = s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;);&#xA;    if (negParen) s = s.Substring(1, s.Length - 2);&#xA;&#xA;    s = s.Replace(&quot;,&quot;, &quot;&quot;);&#xA;&#xA;    decimal d;&#xA;    if (!decimal.TryParse(s, System.Globalization.NumberStyles.Any,&#xA;            System.Globalization.CultureInfo.InvariantCulture, out d))&#xA;    {&#xA;        decimal.TryParse(s, System.Globalization.NumberStyles.Any,&#xA;            System.Globalization.CultureInfo.CurrentCulture, out d);&#xA;    }&#xA;&#xA;    if (negParen) d = -Math.Abs(d);&#xA;    return d;&#xA;}&#xA;&#xA;decimal Round2(decimal d)&#xA;{&#xA;    return Math.Round(d, 2, MidpointRounding.AwayFromZero);&#xA;}&#xA;&#xA;// C_PAN normalization: FIRST6 + &quot;XXXXXX&quot; + LAST4&#xA;string StandardMaskPan(string input)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(input)) return &quot;&quot;;&#xA;&#xA;    input = CleanUnicode(input);&#xA;&#xA;    var digits = new System.Text.StringBuilder();&#xA;    foreach (char ch in input)&#xA;        if (char.IsDigit(ch)) digits.Append(ch);&#xA;&#xA;    string all = digits.ToString();&#xA;    if (all.Length &lt; 10) return all;&#xA;&#xA;    string first6 = all.Substring(0, 6);&#xA;    string last4  = all.Substring(all.Length - 4);&#xA;    return first6 + &quot;XXXXXX&quot; + last4;&#xA;}&#xA;&#xA;// --------------------------------------------------------------&#xA;// Regexes (precompiled)&#xA;// --------------------------------------------------------------&#xA;var rgCardPan = new System.Text.RegularExpressions.Regex(&#xA;    @&quot;Card\s*No:?\s*([0-9]{6}[\*\sxX#\-\._0-9\?]{3,20}[0-9]{4})&quot;,&#xA;    System.Text.RegularExpressions.RegexOptions.IgnoreCase |&#xA;    System.Text.RegularExpressions.RegexOptions.Compiled&#xA;);&#xA;&#xA;var rgPanFlexible = new System.Text.RegularExpressions.Regex(&#xA;    @&quot;([0-9]{6})([\*\sxX#\-\._0-9\?]{3,20})([0-9]{4})&quot;,&#xA;    System.Text.RegularExpressions.RegexOptions.Compiled&#xA;);&#xA;&#xA;var rgPS = new System.Text.RegularExpressions.Regex(&#xA;    @&quot;PS\d{10}&quot;,&#xA;    System.Text.RegularExpressions.RegexOptions.Compiled&#xA;);&#xA;&#xA;// Extract a normalized C_PAN from GL narration&#xA;string ExtractStandardPan(string narration)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(narration)) return &quot;&quot;;&#xA;    narration = CleanUnicode(narration);&#xA;&#xA;    var m1 = rgCardPan.Match(narration);&#xA;    if (m1.Success)&#xA;        return StandardMaskPan(m1.Groups[1].Value);&#xA;&#xA;    var m2 = rgPanFlexible.Match(narration);&#xA;    if (m2.Success)&#xA;        return m2.Groups[1].Value + &quot;XXXXXX&quot; + m2.Groups[3].Value;&#xA;&#xA;    return &quot;&quot;;&#xA;}&#xA;&#xA;// --------------------------------------------------------------&#xA;// PRE-FILL GL: C_PAN + PS_RRN&#xA;// --------------------------------------------------------------&#xA;for (int i = 0; i &lt; t.Rows.Count; i++)&#xA;{&#xA;    var row = t.Rows[i];&#xA;    string narr = CleanUnicode(SafeStr(row[&quot;Narration&quot;]));&#xA;&#xA;    string pan = ExtractStandardPan(narr);&#xA;    if (!string.IsNullOrEmpty(pan))&#xA;        row[&quot;C_PAN&quot;] = StandardMaskPan(pan);&#xA;&#xA;    var mps = rgPS.Match(narr);&#xA;    if (mps.Success)&#xA;        row[&quot;PS_RRN&quot;] = mps.Value;&#xA;}&#xA;&#xA;// --------------------------------------------------------------&#xA;// CMS-DRIVEN MATCHING&#xA;// --------------------------------------------------------------&#xA;int cmsTotal = dtTransactionReportForeignCurrencyTZS?.Rows.Count ?? 0;&#xA;int cmsConsidered = 0;&#xA;int cmsMatched = 0;&#xA;int updatedAGW = 0;&#xA;&#xA;if (dtTransactionReportForeignCurrencyTZS != null)&#xA;{&#xA;    for (int ci = 0; ci &lt; dtTransactionReportForeignCurrencyTZS.Rows.Count; ci++)&#xA;    {&#xA;        var cms = dtTransactionReportForeignCurrencyTZS.Rows[ci];&#xA;&#xA;        string refRaw = SafeStr(cms[&quot;Reference Number&quot;]);&#xA;        string refCms = CleanUnicode(refRaw).Trim();&#xA;&#xA;        decimal cmsAmt = Round2(Math.Abs(ParseAmt(cms[&quot;Transaction Amount&quot;])));&#xA;&#xA;        string cmsDevice = SafeStr(cms[&quot;Device Number&quot;]);&#xA;        string cmsPan = StandardMaskPan(cmsDevice);&#xA;&#xA;        // ---- CMS DEBUG ----&#xA;        Log(&quot;&quot;);&#xA;        Log(&quot;========== CMS ROW #&quot; + ci + &quot; ==========&quot;);&#xA;        Log(&quot;CMS Ref Raw      : [&quot; + refRaw + &quot;]&quot;);&#xA;        Log(&quot;CMS Ref Clean    : [&quot; + refCms + &quot;]&quot;);&#xA;        Log(&quot;CMS PAN Raw      : [&quot; + cmsDevice + &quot;]&quot;);&#xA;        Log(&quot;CMS PAN Masked   : [&quot; + cmsPan + &quot;]&quot;);&#xA;        Log(&quot;CMS Txn Amount   : &quot; + cmsAmt);&#xA;        Log(&quot;========================================&quot;);&#xA;&#xA;        if (string.IsNullOrEmpty(refCms)) { Log(&quot;SKIP: CMS Ref empty.&quot;); continue; }&#xA;        if (!rgPS.IsMatch(refCms))       { Log(&quot;SKIP: CMS Ref not PS+10.&quot;); continue; }&#xA;        if (cmsAmt &lt;= 0)                 { Log(&quot;SKIP: CMS Amount zero.&quot;); continue; }&#xA;&#xA;        cmsConsidered++;&#xA;&#xA;        // ------------------------------------------------------&#xA;        // FIND GL rows whose CLEANED narration contains this PS&#xA;        // ------------------------------------------------------&#xA;        var glCandidates = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;        string refKey = CleanUnicode(refCms);&#xA;&#xA;        for (int gi = 0; gi &lt; t.Rows.Count; gi++)&#xA;        {&#xA;            var gl = t.Rows[gi];&#xA;&#xA;            string narrRaw = SafeStr(gl[&quot;Narration&quot;]);&#xA;            string narr = CleanUnicode(narrRaw);&#xA;&#xA;            if (narr.Contains(refKey))&#xA;            {&#xA;                glCandidates.Add(gl);&#xA;&#xA;                Log(&quot;---- GL HIT ----&quot;);&#xA;                Log(&quot;GL RefNo    : &quot; + SafeStr(gl[&quot;Transaction Ref No:&quot;]));&#xA;                Log(&quot;NARR RAW    : [&quot; + narrRaw + &quot;]&quot;);&#xA;                Log(&quot;NARR CLEAN  : [&quot; + narr + &quot;]&quot;);&#xA;                Log(&quot;GL PAN      : &quot; + SafeStr(gl[&quot;C_PAN&quot;]));&#xA;                Log(&quot;----------------&quot;);&#xA;            }&#xA;        }&#xA;&#xA;        if (glCandidates.Count == 0)&#xA;        {&#xA;            Log(&quot;❌ NO GL rows containing PS: &quot; + refKey);&#xA;            continue;&#xA;        }&#xA;&#xA;        Log(&quot;GL candidates = &quot; + glCandidates.Count);&#xA;&#xA;        // ------------------------------------------------------&#xA;        // GROUP GL by PAN&#xA;        // ------------------------------------------------------&#xA;        var groups = new System.Collections.Generic.Dictionary&lt;string,&#xA;            System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;&#xA;        foreach (var gl in glCandidates)&#xA;        {&#xA;            string pan = StandardMaskPan(SafeStr(gl[&quot;C_PAN&quot;]));&#xA;&#xA;            if (string.IsNullOrEmpty(pan)) continue;&#xA;&#xA;            decimal d = ParseAmt(gl[debitCol]);&#xA;            decimal c = ParseAmt(gl[creditCol]);&#xA;            decimal amt = Math.Abs(d) &gt; 0 ? Math.Abs(d) : Math.Abs(c);&#xA;            if (amt == 0) continue;&#xA;&#xA;            if (!groups.ContainsKey(pan))&#xA;                groups[pan] = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;&#xA;            groups[pan].Add(gl);&#xA;&#xA;            Log($&quot;PAN GROUPING: {pan} | Amt={amt}&quot;);&#xA;        }&#xA;&#xA;        if (groups.Count == 0)&#xA;        {&#xA;            Log(&quot;❌ GL candidates have NO usable PAN+Amount.&quot;);&#xA;            continue;&#xA;        }&#xA;&#xA;        // ------------------------------------------------------&#xA;        // MATCH GROUP TOTAL TO CMS AMOUNT&#xA;        // ------------------------------------------------------&#xA;        bool matchedThisCMS = false;&#xA;&#xA;        foreach (var kvp in groups)&#xA;        {&#xA;            string panKey = kvp.Key;&#xA;            var rows = kvp.Value;&#xA;&#xA;            decimal total = 0;&#xA;            foreach (var gl in rows)&#xA;            {&#xA;                decimal d = ParseAmt(gl[debitCol]);&#xA;                decimal c = ParseAmt(gl[creditCol]);&#xA;                total += Math.Abs(d) &gt; 0 ? Math.Abs(d) : Math.Abs(c);&#xA;            }&#xA;            total = Round2(total);&#xA;&#xA;            Log($&quot;PAN={panKey} | GLTotal={total} | CMS={cmsAmt}&quot;);&#xA;&#xA;            if (total == cmsAmt)&#xA;            {&#xA;                matchedThisCMS = true;&#xA;                cmsMatched++;&#xA;&#xA;                Log($&quot;✅ MATCH FOUND FOR PS={refCms}, PAN={panKey}, Total={total}&quot;);&#xA;&#xA;                // APPLY ROOT CAUSE&#xA;                foreach (var gl in rows)&#xA;                {&#xA;                    gl[&quot;C_PAN&quot;] = panKey;&#xA;                    gl[&quot;Root Cause&quot;] = &quot;Wakala withdrawal debited TZS instead of FX GL&quot;;&#xA;                    gl[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;&#xA;                    gl[&quot;Recommended Action&quot;] =&#xA;                        $&quot;DR: 202030015 (USD {SafeStr(cms[&quot;Billing Amount&quot;])}) &quot; +&#xA;                        $&quot;CR: 202030015 (TZS {SafeStr(cms[&quot;Transaction Amount&quot;])})&quot;;&#xA;&#xA;                    gl[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;                    gl[&quot;ROOT_CAUSE_PROCESSED&quot;] = &quot;TRUE&quot;;&#xA;&#xA;                    updatedAGW++;&#xA;                }&#xA;&#xA;                break; // only first match&#xA;            }&#xA;        }&#xA;&#xA;        if (!matchedThisCMS)&#xA;        {&#xA;            Log($&quot;❌ No matching PAN group for CMS Ref={refCms} | CMS Amount={cmsAmt}&quot;);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// --------------------------------------------------------------&#xA;// SUMMARY&#xA;// --------------------------------------------------------------&#xA;Log(&quot;&quot;);&#xA;Log(&quot;=== AGW FX SUMMARY ===&quot;);&#xA;Log(&quot;CMS Total Rows   : &quot; + cmsTotal);&#xA;Log(&quot;CMS Considered   : &quot; + cmsConsidered);&#xA;Log(&quot;CMS Matched      : &quot; + cmsMatched);&#xA;Log(&quot;GL Rows Updated  : &quot; + updatedAGW);&#xA;Log(&quot;=== END AGW FX PROCESSING ===&quot;);&#xA;" DisplayName="FXWAKALA" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_97" Language="CSharp">
            <ui:InvokeCode.Arguments>
              <InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtHistoricalReconTransactionsReport">[dtHistoricalReconTransactionsReport]</InOutArgument>
              <InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtTransactionReportForeignCurrencyTZS">[dtTransactionReportForeignCurrencyTZS]</InOutArgument>
              <InOutArgument x:TypeArguments="x:String" x:Key="reconCurrency">[reconCurrency]</InOutArgument>
            </ui:InvokeCode.Arguments>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                <x:Boolean x:Key="IsPinned">False</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </ui:InvokeCode>
        </Sequence>
        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: PPAT classification CLEANUP =====&#xA;// Phase 1: GL-only PPAT classification (narration-based, NO late-post here)&#xA;// Phase 2: Cleanup any PPAT still with &quot;Unmatched manual entries&quot; (narration-based)&#xA;// Phase 3: FINAL OVERRIDE — Late posted (±2 days) applied LAST on ALL PPAT&#xA;//&#xA;// Args (In):     string reconDate&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport&#xA;&#xA;/////////////////////// Helpers ///////////////////////&#xA;void EnsureColumn(System.Data.DataTable dt, string name)&#xA;{&#xA;    if (!dt.Columns.Contains(name))&#xA;        dt.Columns.Add(new System.Data.DataColumn(name, typeof(string)) { DefaultValue = &quot;&quot; });&#xA;}&#xA;&#xA;// --- NEW: robust column name normalizer (handles spaces, NBSP, colons, case) ---&#xA;string NormalizeColName(string name)&#xA;{&#xA;    if (name == null) return &quot;&quot;;&#xA;    name = name.Replace('\u00A0', ' '); // NBSP -&gt; normal space&#xA;    name = name.Trim();&#xA;    name = name.ToUpperInvariant();&#xA;    // collapse multiple spaces&#xA;    name = System.Text.RegularExpressions.Regex.Replace(name, @&quot;\s+&quot;, &quot; &quot;);&#xA;    // drop colon&#xA;    name = name.Replace(&quot;:&quot;, &quot;&quot;);&#xA;    return name;&#xA;}&#xA;&#xA;string FindFirstExistingColumn(System.Data.DataTable dt, params string[] names)&#xA;{&#xA;    if (dt == null) return null;&#xA;&#xA;    // Build a normalized map of existing columns&#xA;    var map = new System.Collections.Generic.Dictionary&lt;string, string&gt;();&#xA;    foreach (System.Data.DataColumn c in dt.Columns)&#xA;    {&#xA;        var norm = NormalizeColName(c.ColumnName);&#xA;        if (!map.ContainsKey(norm))&#xA;            map[norm] = c.ColumnName; // keep real name&#xA;    }&#xA;&#xA;    foreach (var n in names)&#xA;    {&#xA;        if (string.IsNullOrEmpty(n)) continue;&#xA;        var normWanted = NormalizeColName(n);&#xA;        if (map.TryGetValue(normWanted, out var real))&#xA;            return real;&#xA;    }&#xA;&#xA;    return null;&#xA;}&#xA;&#xA;DateTime? ParseDateFlexible(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return null;&#xA;&#xA;    if (val is DateTime dt) return dt;&#xA;&#xA;    if (val is double d)&#xA;    {&#xA;        try { return DateTime.FromOADate(d); } catch { }&#xA;    }&#xA;&#xA;    if (double.TryParse(val.ToString(),&#xA;        System.Globalization.NumberStyles.Float,&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xA;        out var d2))&#xA;    {&#xA;        try { return DateTime.FromOADate(d2); } catch { }&#xA;    }&#xA;&#xA;    string s = val.ToString().Trim();&#xA;    string[] fmts = new[]&#xA;    {&#xA;        &quot;dd/MM/yyyy HH:mm:ss&quot;,&quot;dd/MM/yyyy HH:mm&quot;,&quot;dd/MM/yyyy&quot;,&#xA;        &quot;yyyy-MM-dd HH:mm:ss&quot;,&quot;yyyy-MM-dd&quot;,&quot;yyyy/MM/dd&quot;,&#xA;        &quot;dd-MMM-yyyy&quot;,&quot;d-MMM-yyyy&quot; // added for things like 02-Nov-2025&#xA;    };&#xA;&#xA;    if (DateTime.TryParseExact(s, fmts,&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xA;        System.Globalization.DateTimeStyles.None,&#xA;        out var exact))&#xA;        return exact;&#xA;&#xA;    if (DateTime.TryParse(s,&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xA;        System.Globalization.DateTimeStyles.None,&#xA;        out var any))&#xA;        return any;&#xA;&#xA;    return null;&#xA;}&#xA;&#xA;string U(string s) =&gt; (s ?? &quot;&quot;).Trim().ToUpperInvariant();&#xA;&#xA;string NormalizeSoft(string s)&#xA;{&#xA;    var x = U(s);&#xA;    x = System.Text.RegularExpressions.Regex.Replace(x, @&quot;[-_]+&quot;, &quot; &quot;);&#xA;    x = System.Text.RegularExpressions.Regex.Replace(x, @&quot;\s+&quot;, &quot; &quot;);&#xA;    return x;&#xA;}&#xA;&#xA;bool ContainsAny(string hay, params string[] needles)&#xA;{&#xA;    hay = NormalizeSoft(hay);&#xA;    foreach (var n in needles)&#xA;    {&#xA;        var nn = NormalizeSoft(n);&#xA;        if (hay.Contains(nn)) return true;&#xA;    }&#xA;    return false;&#xA;}&#xA;&#xA;// Detect GL default classification that we want to &quot;fix&quot; for PPAT rows&#xA;bool IsGlDefault(System.Data.DataRow row)&#xA;{&#xA;    string rc   = (row.Table.Columns.Contains(&quot;Root Cause&quot;)          ? row[&quot;Root Cause&quot;]          : null)?.ToString().Trim() ?? &quot;&quot;;&#xA;    string rcat = (row.Table.Columns.Contains(&quot;Root Cause Category&quot;) ? row[&quot;Root Cause Category&quot;] : null)?.ToString().Trim() ?? &quot;&quot;;&#xA;    string act  = (row.Table.Columns.Contains(&quot;Recommended Action&quot;)  ? row[&quot;Recommended Action&quot;]  : null)?.ToString().Trim() ?? &quot;&quot;;&#xA;    string own  = (row.Table.Columns.Contains(&quot;Action Owner&quot;)        ? row[&quot;Action Owner&quot;]        : null)?.ToString().Trim() ?? &quot;&quot;;&#xA;&#xA;    return rc.Equals(&quot;Unmatched manual entries&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;           rcat.Equals(&quot;System&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;           act.Equals(&quot;To be manually matched&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;           own.Equals(&quot;Card Reconciliation&quot;, StringComparison.OrdinalIgnoreCase);&#xA;}&#xA;&#xA;void ForcePpat(System.Data.DataRow row)&#xA;{&#xA;    if (row.Table.Columns.Contains(&quot;Classification&quot;))&#xA;        row[&quot;Classification&quot;] = &quot;PPAT&quot;;&#xA;}&#xA;&#xA;void SetPpatTemplate(System.Data.DataRow row)&#xA;{&#xA;    ForcePpat(row);&#xA;    row[&quot;Root Cause&quot;] = &quot;Unsuccessful ATM withdrawal transaction debited the GL&quot;;&#xA;    row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;    row[&quot;Recommended Action&quot;] = &quot;Follow up with respective branch to suspend the overages as per process&quot;;&#xA;    row[&quot;Action Owner&quot;] = &quot;ATM Reconciliation Team&quot;;&#xA;}&#xA;&#xA;void SetLatePosted(System.Data.DataRow row)&#xA;{&#xA;    ForcePpat(row);&#xA;    row[&quot;Root Cause&quot;] = &quot;Late posted transaction&quot;;&#xA;    row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;    row[&quot;Recommended Action&quot;] = &quot;Check if updates CMS on the following date&quot;;&#xA;    row[&quot;Action Owner&quot;] = &quot;Card Reconciliation&quot;;&#xA;}&#xA;&#xA;// Shared narration-based PPAT classification helper&#xA;void ClassifyPpatByNarration(System.Data.DataRow row)&#xA;{&#xA;    string narration = row.Table.Columns.Contains(&quot;Narration&quot;)&#xA;        ? (row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;)&#xA;        : &quot;&quot;;&#xA;&#xA;    // 1) Principal ATM withdrawal&#xA;    if (ContainsAny(narration,&#xA;        &quot;ATM WITHDRAWL PREPAID&quot;, &quot;ATM WITHDRAWAL PREPAID&quot;,&#xA;        &quot;ATM WITHDRAWL&quot;, &quot;ATM WITHDRAWAL&quot;))&#xA;    {&#xA;        SetPpatTemplate(row);&#xA;        return;&#xA;    }&#xA;&#xA;    // 2) Government levy&#xA;    if (ContainsAny(narration, &quot;GOVERNMENT LEVY&quot;, &quot; LEVY&quot;))&#xA;    {&#xA;        ForcePpat(row);&#xA;        row[&quot;Root Cause&quot;] = &quot;Government levy on unsuccessful ATM withdrawal transactions&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Reverse the levy&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;        return;&#xA;    }&#xA;&#xA;    // 3) Charges / fees / VAT&#xA;    if (ContainsAny(narration,&#xA;        &quot;CASH WITHDRAW CHARGE&quot;, &quot;CASH WITHDRAWAL CHARGE&quot;,&#xA;        &quot;CASH WITHDRAWAL TRANSACTION FEE&quot;, &quot;TRANSACTION FEE&quot;,&#xA;        &quot;VAT PAYABLE ON COMM AND FEES&quot;, &quot;VAT PAYABLE&quot;, &quot;VAT&quot;))&#xA;    {&#xA;        ForcePpat(row);&#xA;        row[&quot;Root Cause&quot;] = &quot;Cash withdrawal charges on unsuccessful ATM withdrawal transactions&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Reverse the charge&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;        return;&#xA;    }&#xA;&#xA;    // 4) Fallback PPAT default&#xA;    SetPpatTemplate(row);&#xA;}&#xA;&#xA;/////////////////////// Setup ///////////////////////&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport));&#xA;&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Classification&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Root Cause&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Root Cause Category&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Recommended Action&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Action Owner&quot;);&#xA;&#xA;// Using the NEW robust FindFirstExistingColumn&#xA;string txnRefCol = FindFirstExistingColumn(&#xA;    dtHistoricalReconTransactionsReport,&#xA;    &quot;Transaction Ref No:&quot;, &quot;Transaction Ref No&quot;, &quot;Transaction Reference No&quot;,&#xA;    &quot;Transaction Reference Number&quot;, &quot;Txn Ref No&quot;&#xA;);&#xA;&#xA;string valueDateCol = FindFirstExistingColumn(&#xA;    dtHistoricalReconTransactionsReport,&#xA;    &quot;Value Date&quot;, &quot;ValueDate&quot;&#xA;);&#xA;&#xA;// reconDate used for late-posted rule (final pass)&#xA;DateTime? reconDateParsed = ParseDateFlexible(reconDate);&#xA;&#xA;// Counters for logging&#xA;int totalRows              = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;int totalGlRows            = 0;&#xA;int totalGlPpatRows        = 0;&#xA;&#xA;int setNarrPrincipal_GL    = 0;&#xA;int setNarrLevy_GL         = 0;&#xA;int setNarrFee_GL          = 0;&#xA;int setTxnRefOnly_GL       = 0;&#xA;&#xA;int skippedNonPPAT_GL      = 0;&#xA;int skippedNonGL           = 0;&#xA;int fixedFromGlDefault     = 0;&#xA;&#xA;int forcedNarrOverride     = 0;  // Phase 2&#xA;int finalLateOverrides     = 0;  // Phase 3&#xA;&#xA;/////////////////////// PHASE 1: GL-only PPAT classification (NO late-post here) ///////////////////////&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    // Must be GL for phase 1&#xA;    string source = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Source&quot;)&#xA;        ? (row[&quot;Source&quot;]?.ToString() ?? &quot;&quot;)&#xA;        : &quot;&quot;;&#xA;&#xA;    if (!source.Equals(&quot;GL&quot;, StringComparison.OrdinalIgnoreCase))&#xA;    {&#xA;        skippedNonGL++;&#xA;        continue;&#xA;    }&#xA;&#xA;    totalGlRows++;&#xA;&#xA;    // TxnRef must contain PPAT&#xA;    string txnRef = (!string.IsNullOrEmpty(txnRefCol) &amp;&amp;&#xA;                     dtHistoricalReconTransactionsReport.Columns.Contains(txnRefCol))&#xA;                    ? (row[txnRefCol]?.ToString() ?? &quot;&quot;)&#xA;                    : &quot;&quot;;&#xA;&#xA;    bool txnHasPPAT =&#xA;        !string.IsNullOrWhiteSpace(txnRef) &amp;&amp;&#xA;        (txnRef.IndexOf(&quot;PPAT&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0 || txnRef.IndexOf(&quot;AWPC&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0);&#xA;&#xA;    if (!txnHasPPAT)&#xA;    {&#xA;        skippedNonPPAT_GL++;&#xA;        continue;&#xA;    }&#xA;&#xA;    totalGlPpatRows++;&#xA;&#xA;    // We may overwrite GL default; track that&#xA;    bool wasGlDefault = IsGlDefault(row);&#xA;&#xA;    // Narration bucketing (GL-only phase)&#xA;    string narration = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Narration&quot;)&#xA;        ? (row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;)&#xA;        : &quot;&quot;;&#xA;&#xA;    // 1) Principal ATM withdrawal&#xA;    if (ContainsAny(narration,&#xA;        &quot;ATM WITHDRAWL PREPAID&quot;, &quot;ATM WITHDRAWAL PREPAID&quot;,&#xA;        &quot;ATM WITHDRAWL&quot;, &quot;ATM WITHDRAWAL&quot;))&#xA;    {&#xA;        if (wasGlDefault) fixedFromGlDefault++;&#xA;        SetPpatTemplate(row);&#xA;        setNarrPrincipal_GL++;&#xA;        continue;&#xA;    }&#xA;&#xA;    // 2) Government levy&#xA;    if (ContainsAny(narration, &quot;GOVERNMENT LEVY&quot;, &quot; LEVY&quot;))&#xA;    {&#xA;        if (wasGlDefault) fixedFromGlDefault++;&#xA;        ForcePpat(row);&#xA;        row[&quot;Root Cause&quot;] = &quot;Government levy on unsuccessful ATM withdrawal transactions&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Reverse the levy&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;        setNarrLevy_GL++;&#xA;        continue;&#xA;    }&#xA;&#xA;    // 3) Charges / fees / VAT&#xA;    if (ContainsAny(narration,&#xA;        &quot;CASH WITHDRAW CHARGE&quot;, &quot;CASH WITHDRAWAL CHARGE&quot;,&#xA;        &quot;CASH WITHDRAWAL TRANSACTION FEE&quot;, &quot;TRANSACTION FEE&quot;,&#xA;        &quot;VAT PAYABLE ON COMM AND FEES&quot;, &quot;VAT PAYABLE&quot;, &quot;VAT&quot;))&#xA;    {&#xA;        if (wasGlDefault) fixedFromGlDefault++;&#xA;        ForcePpat(row);&#xA;        row[&quot;Root Cause&quot;] = &quot;Cash withdrawal charges on unsuccessful ATM withdrawal transactions&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Reverse the charge&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;        setNarrFee_GL++;&#xA;        continue;&#xA;    }&#xA;&#xA;    // 4) Fallback PPAT default (GL)&#xA;    if (wasGlDefault) fixedFromGlDefault++;&#xA;    SetPpatTemplate(row);&#xA;    setTxnRefOnly_GL++;&#xA;}&#xA;&#xA;/////////////////////// PHASE 2: Cleanup any PPAT still = &quot;Unmatched manual entries&quot; ///////////////////////&#xA;// Use narration-based PPAT classification for these.&#xA;if (!string.IsNullOrEmpty(txnRefCol) &amp;&amp;&#xA;    dtHistoricalReconTransactionsReport.Columns.Contains(txnRefCol))&#xA;{&#xA;    foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;    {&#xA;        string txnRef = row[txnRefCol]?.ToString() ?? &quot;&quot;;&#xA;        if (string.IsNullOrWhiteSpace(txnRef) ||&#xA;            (txnRef.IndexOf(&quot;PPAT&quot;, StringComparison.OrdinalIgnoreCase) &lt; 0 &amp;&amp; txnRef.IndexOf(&quot;AWPC&quot;, StringComparison.OrdinalIgnoreCase) &lt; 0))&#xA;            continue;&#xA;&#xA;        string rcNow = row.Table.Columns.Contains(&quot;Root Cause&quot;)&#xA;            ? (row[&quot;Root Cause&quot;]?.ToString() ?? &quot;&quot;)&#xA;            : &quot;&quot;;&#xA;&#xA;        // --- NEW: tolerant check for &quot;Unmatched manual entries&quot; (trims, NBSP, extra spaces) ---&#xA;        string rcNorm = NormalizeSoft(rcNow);&#xA;        if (!rcNorm.Contains(&quot;UNMATCHED MANUAL ENTRIES&quot;))&#xA;            continue;&#xA;&#xA;        // Override old GL default using narration-based PPAT classification.&#xA;        ClassifyPpatByNarration(row);&#xA;        forcedNarrOverride++;&#xA;    }&#xA;}&#xA;&#xA;/////////////////////// PHASE 3: FINAL LATE-POSTED OVERRIDE (applies LAST on ALL PPAT) ///////////////////////&#xA;// If any PPAT row (any Source) is within ±2 days of reconDate (or ValueDate = null),&#xA;// it will be marked as &quot;Late posted transaction&quot;, overriding any existing PPAT classification.&#xA;if (reconDateParsed != null &amp;&amp;&#xA;    !string.IsNullOrEmpty(txnRefCol) &amp;&amp;&#xA;    dtHistoricalReconTransactionsReport.Columns.Contains(txnRefCol) &amp;&amp;&#xA;    !string.IsNullOrEmpty(valueDateCol) &amp;&amp;&#xA;    dtHistoricalReconTransactionsReport.Columns.Contains(valueDateCol))&#xA;{&#xA;    DateTime startRange = reconDateParsed.Value.AddDays(-2);&#xA;    DateTime endRange   = reconDateParsed.Value.AddDays(+2);&#xA;&#xA;    foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;    {&#xA;        string txnRef = row[txnRefCol]?.ToString() ?? &quot;&quot;;&#xA;        if (string.IsNullOrWhiteSpace(txnRef) ||&#xA;            (txnRef.IndexOf(&quot;PPAT&quot;, StringComparison.OrdinalIgnoreCase) &lt; 0 &amp;&amp; txnRef.IndexOf(&quot;AWPC&quot;, StringComparison.OrdinalIgnoreCase) &lt; 0))&#xA;            continue;&#xA;&#xA;        DateTime? vDate = ParseDateFlexible(row[valueDateCol]);&#xA;&#xA;        bool isLate;&#xA;&#xA;        if (vDate == null)&#xA;        {&#xA;            // Business rule: treat NULL ValueDate as late&#xA;            isLate = true;&#xA;        }&#xA;        else&#xA;        {&#xA;            var d = vDate.Value.Date;&#xA;            isLate = (d &gt;= startRange.Date &amp;&amp; d &lt;= endRange.Date);&#xA;        }&#xA;&#xA;        if (!isLate)&#xA;            continue;&#xA;&#xA;        // FINAL override: Late posted MUST be the last to apply on all PPAT&#xA;        SetLatePosted(row);&#xA;        finalLateOverrides++;&#xA;    }&#xA;}&#xA;&#xA;// DEBUG: show how our PPAT row ended after all phases&#xA;if (!string.IsNullOrEmpty(txnRefCol) &amp;&amp;&#xA;    dtHistoricalReconTransactionsReport.Columns.Contains(txnRefCol))&#xA;{&#xA;    foreach (System.Data.DataRow r in dtHistoricalReconTransactionsReport.Rows)&#xA;    {&#xA;        string tr = r[txnRefCol]?.ToString() ?? &quot;&quot;;&#xA;        if (tr.Contains(&quot;101PPAT253060256&quot;)) // or &quot;253060255&quot; if you want the other one&#xA;        {&#xA;            System.Console.WriteLine(&#xA;                &quot;DEBUG_PPAT_ROW =&gt; TxnRef={0}, RC={1}, Cat={2}, Act={3}, Owner={4}, Class={5}&quot;,&#xA;                tr,&#xA;                r[&quot;Root Cause&quot;],&#xA;                r[&quot;Root Cause Category&quot;],&#xA;                r[&quot;Recommended Action&quot;],&#xA;                r[&quot;Action Owner&quot;],&#xA;                r[&quot;Classification&quot;]&#xA;            );&#xA;            break;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// Summary diagnostics&#xA;System.Console.WriteLine(&#xA;    &quot;PPAT CLEANUP SUMMARY: &quot; +&#xA;    $&quot;TotalRows={totalRows}, &quot; +&#xA;    $&quot;TotalGL={totalGlRows}, &quot; +&#xA;    $&quot;TotalGL_PPAT={totalGlPpatRows}, &quot; +&#xA;    $&quot;GL_Principal={setNarrPrincipal_GL}, &quot; +&#xA;    $&quot;GL_Levy={setNarrLevy_GL}, &quot; +&#xA;    $&quot;GL_Fee={setNarrFee_GL}, &quot; +&#xA;    $&quot;GL_DefaultPPAT={setTxnRefOnly_GL}, &quot; +&#xA;    $&quot;ForcedNarrOverride_Unmatched={forcedNarrOverride}, &quot; +&#xA;    $&quot;FinalLateOverrides_ALL_PPAT={finalLateOverrides}, &quot; +&#xA;    $&quot;FixedFromGLDefault={fixedFromGlDefault}, &quot; +&#xA;    $&quot;SkippedNonPPAT_GL={skippedNonPPAT_GL}, &quot; +&#xA;    $&quot;SkippedNonGL={skippedNonGL}&quot;);&#xA;" DisplayName="PPAT SAFE GUARD" sap:VirtualizedContainerService.HintSize="450,57.333333333333336" sap2010:WorkflowViewState.IdRef="InvokeCode_100" Language="CSharp">
          <ui:InvokeCode.Arguments>
            <InOutArgument x:TypeArguments="x:String" x:Key="prepaidCardFileName">[prepaidCardFileName]</InOutArgument>
            <InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtHistoricalReconTransactionsReport">[dtHistoricalReconTransactionsReport]</InOutArgument>
            <InOutArgument x:TypeArguments="x:Decimal" x:Key="glClosingBalance">[glClosingBalance]</InOutArgument>
            <InOutArgument x:TypeArguments="x:Decimal" x:Key="cmsBalance">[cmsBalance]</InOutArgument>
            <InOutArgument x:TypeArguments="x:String" x:Key="reconDate">[reconDate]</InOutArgument>
            <InOutArgument x:TypeArguments="x:String" x:Key="reconCurrency">[reconCurrency]</InOutArgument>
            <InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtHistoricalReconTransactionsReportMatched">[dtHistoricalReconTransactionsReportMatched]</InOutArgument>
          </ui:InvokeCode.Arguments>
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsPinned">False</x:Boolean>
              <x:Boolean x:Key="IsExpanded">False</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>

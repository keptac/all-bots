        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// === Robust parse for reconDate, display as dd-MMM-yyyy ===&#xA;if (reconDate == null) throw new ArgumentNullException(nameof(reconDate));&#xA;&#xA;DateTime parsedReconDate;&#xA;string[] formats = {&#xA;    &quot;dd-MMM-yyyy&quot;, &quot;yyyy-MM-dd&quot;, &quot;dd/MM/yyyy&quot;, &quot;yyyy/MM/dd&quot;,&#xA;    &quot;dd-MM-yyyy&quot;, &quot;MM/dd/yyyy&quot;, &quot;dd MMM yyyy&quot;&#xA;};&#xA;&#xA;if (!DateTime.TryParseExact(&#xA;        reconDate.Trim(),&#xA;        formats,&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xA;        System.Globalization.DateTimeStyles.None,&#xA;        out parsedReconDate))&#xA;{&#xA;    // fallback to loose parse&#xA;    if (!DateTime.TryParse(reconDate, out parsedReconDate))&#xA;        throw new ArgumentException(&quot;Invalid reconDate format: &quot; + reconDate);&#xA;}&#xA;&#xA;// === Get last SNO from the DataTable ===&#xA;int lastSNO = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;SNO&quot;)&#xA;    ? dtHistoricalReconTransactionsReport.AsEnumerable()&#xA;        .Select(r =&gt; r[&quot;SNO&quot;]?.ToString())&#xA;        .Where(s =&gt; !string.IsNullOrWhiteSpace(s) &amp;&amp; int.TryParse(s, out _))&#xA;        .Select(s =&gt; int.Parse(s))&#xA;        .DefaultIfEmpty(0)&#xA;        .Max()&#xA;    : 0;&#xA;&#xA;int newSNO = lastSNO + 1;&#xA;&#xA;// === Create and populate new DataRow ===&#xA;DataRow newRow = dtHistoricalReconTransactionsReport.NewRow();&#xA;&#xA;newRow[&quot;SNO&quot;] = newSNO;&#xA;newRow[&quot;Branch code&quot;] = &quot;101&quot;;&#xA;newRow[&quot;GL_Code&quot;] = &quot;202030015&quot;;&#xA;newRow[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;&#xA;// store as DateTime → Excel will render dd-MMM-yyyy if formatted&#xA;newRow[&quot;Booking Date&quot;] = parsedReconDate;&#xA;newRow[&quot;Value Date&quot;] = parsedReconDate;&#xA;&#xA;newRow[&quot;Transaction Ref No:&quot;] = DBNull.Value;&#xA;// 👇 dd-MMM-yyyy for Narration&#xA;newRow[&quot;Narration&quot;] = $&quot;Balance movement not explained by posted transactions {parsedReconDate:dd-MMM-yyyy}&quot;;&#xA;&#xA;// === Excel formula placeholders (as string) ===&#xA;int excelRow = newSNO + 5;&#xA;int prevRow = newSNO + 4;&#xA;&#xA;newRow[&quot;Aging&quot;] = &quot;=$H$6-G&quot; + excelRow;&#xA;newRow[&quot;Aging Group&quot;] =&#xA;    &quot;=IF(L&quot; + prevRow + &quot;&lt;4,\&quot;0-3 Days\&quot;,IF(L&quot; + prevRow + &quot;&lt;31,\&quot;4-30 Days\&quot;,IF(L&quot; + prevRow + &quot;&lt;61,\&quot;31-60 Days\&quot;,IF(L&quot; + prevRow + &quot;&lt;=90,\&quot;61-90 Days\&quot;,IF(L&quot; + prevRow + &quot;&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;&#xA;// ✅ BOT Classification with balanced parens&#xA;newRow[&quot;BOT Classification&quot;] =&#xA;    &quot;=IF(J&quot; + prevRow + &quot;&gt;0,&quot; +&#xA;        &quot;IF(L&quot; + prevRow + &quot;&lt;30,\&quot;Normal\&quot;,&quot; +&#xA;            &quot;IF(L&quot; + prevRow + &quot;&lt;60,\&quot;Especially Mentioned\&quot;,&quot; +&#xA;                &quot;IF(L&quot; + prevRow + &quot;&lt;90,\&quot;Substandard\&quot;,&quot; +&#xA;                    &quot;IF(L&quot; + prevRow + &quot;&lt;=180,\&quot;Doubtful\&quot;,&quot; +&#xA;                        &quot;IF(L&quot; + prevRow + &quot;&gt;180,\&quot;Loss\&quot;,\&quot;0\&quot;)&quot; +&#xA;                    &quot;)&quot; +&#xA;                &quot;)&quot; +&#xA;            &quot;)&quot; +&#xA;        &quot;)&quot; +&#xA;    &quot;,\&quot;Not Applicable\&quot;)&quot;;&#xA;&#xA;// === Classification/Action Fields ===&#xA;newRow[&quot;Root Cause&quot;] = &quot;Not yet established&quot;;&#xA;newRow[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;newRow[&quot;Recommended Action&quot;] = &quot;Follow up with PTS has been made&quot;;&#xA;newRow[&quot;Action Owner&quot;] = &quot;Card Reconciliation&quot;;&#xA;&#xA;// === Debit/Credit Assignment ===&#xA;decimal absMovement = Math.Abs(Convert.ToDecimal(balanceMovement));&#xA;string creditCol = $&quot;Credit ({reconCurrency})&quot;;&#xA;string debitCol  = $&quot;Debit ({reconCurrency})&quot;;&#xA;&#xA;if (balanceMovement &lt; 0)&#xA;{&#xA;    newRow[debitCol]  = absMovement;&#xA;    newRow[creditCol] = DBNull.Value;&#xA;}&#xA;else if (balanceMovement &gt; 0)&#xA;{&#xA;    newRow[creditCol] = absMovement;&#xA;    newRow[debitCol]  = DBNull.Value;&#xA;}&#xA;else&#xA;{&#xA;    newRow[debitCol]  = DBNull.Value;&#xA;    newRow[creditCol] = DBNull.Value;&#xA;}&#xA;&#xA;// === Add to DataTable ===&#xA;dtHistoricalReconTransactionsReport.Rows.Add(newRow);&#xA;&#xA;Console.WriteLine($&quot;✅ New row inserted with SNO {newSNO}, ReconDate {parsedReconDate:dd-MMM-yyyy}&quot;);&#xA;" DisplayName="Posted movement" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_4" Language="CSharp">

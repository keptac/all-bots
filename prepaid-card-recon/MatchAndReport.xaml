        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: PPSP exchange gain/loss — GROUP BY RRN + C_PAN ====&#xA;// Args (In):     string reconCurrency&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport, DataTable dtHistoricalReconTransactionsReportMatched&#xA;// Args (Out):    decimal exchangeGainOrLossPPSP&#xA;//&#xA;// Rules &amp; Notes:&#xA;// - GL side (only rows where &quot;Transaction Ref No:&quot; contains &quot;PPSP&quot;):&#xA;//   • Extract RRN STRICTLY from Narration (12 alnum).&#xA;//   • C_PAN forced from Narration using 550558 rule: 550558XXXXXX + last 4 digits.&#xA;//   • Matching key = RRN + &quot;|&quot; + C_PAN (both required; if either missing, skip).&#xA;// - CMS side (eligible “principal-like” rows only; exclude income/fees/levy/service tax/tax on income):&#xA;//   • RRN taken from RRN column; must be 12 alphanumeric.&#xA;//   • C_PAN forced from Narration using 550558 rule; if missing, row not grouped.&#xA;//   • Group ALL eligible CMS rows by composite key (RRN + C_PAN).&#xA;// - On match:&#xA;//   • Import the GL row and all CMS rows in that composite-key group into the *Matched* table,&#xA;//     set Classification=&quot;PPSP&quot;, remove all matched rows from the working table by reference.&#xA;// - exchangeGainOrLossPPSP equals net removed Δ (rounded to 2dp).&#xA;&#xA;var sw = System.Diagnostics.Stopwatch.StartNew();&#xA;System.Console.WriteLine($&quot;🚀 PPSP exchange gain/loss (group by RRN + C_PAN) started at {System.DateTime.Now:yyyy-MM-dd HH:mm:ss}&quot;);&#xA;&#xA;// ===== Guards &amp; setup =====&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport), &quot;Input DataTable cannot be null&quot;);&#xA;&#xA;if (dtHistoricalReconTransactionsReportMatched == null ||&#xA;    dtHistoricalReconTransactionsReportMatched.Columns.Count != dtHistoricalReconTransactionsReport.Columns.Count)&#xA;{&#xA;    dtHistoricalReconTransactionsReportMatched = dtHistoricalReconTransactionsReport.Clone();&#xA;}&#xA;&#xA;string currency = reconCurrency;&#xA;string colDebit  = $&quot;Debit ({currency})&quot;;&#xA;string colCredit = $&quot;Credit ({currency})&quot;;&#xA;&#xA;bool hasNarration = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Narration&quot;);&#xA;bool hasTrnRef    = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Transaction Ref No:&quot;);&#xA;bool hasChannel   = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Channel&quot;);&#xA;bool hasCpan      = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;C_PAN&quot;);&#xA;bool hasRrn       = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;RRN&quot;);&#xA;bool hasDebit     = dtHistoricalReconTransactionsReport.Columns.Contains(colDebit);&#xA;bool hasCredit    = dtHistoricalReconTransactionsReport.Columns.Contains(colCredit);&#xA;&#xA;// Ensure Classification exists on both tables&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Classification&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Classification&quot;))&#xA;    dtHistoricalReconTransactionsReportMatched.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;&#xA;// ===== Helpers =====&#xA;string Val(object o) =&gt; (o == null || o == DBNull.Value) ? &quot;&quot; : o.ToString();&#xA;&#xA;decimal ParseAmountSafe(System.Data.DataRow r, string colName)&#xA;{&#xA;    if (r == null || string.IsNullOrEmpty(colName)) return 0m;&#xA;    if (!r.Table.Columns.Contains(colName)) return 0m;&#xA;    var v = r[colName];&#xA;    if (v == null || v == DBNull.Value) return 0m;&#xA;    var s = v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;);&#xA;    if (s.Length == 0) return 0m;&#xA;    if (s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;)) s = &quot;-&quot; + s.Substring(1, s.Length - 2);&#xA;    return decimal.TryParse(s, System.Globalization.NumberStyles.Any,&#xA;        System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0m;&#xA;}&#xA;&#xA;bool StartsWithIgnore(string text, string prefix) =&gt;&#xA;    text != null &amp;&amp; text.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);&#xA;bool EqualsIgnore(string a, string b) =&gt;&#xA;    string.Equals(a ?? &quot;&quot;, b ?? &quot;&quot;, System.StringComparison.OrdinalIgnoreCase);&#xA;string ToUpperStr(string s) =&gt; (s ?? &quot;&quot;).ToUpperInvariant();&#xA;&#xA;void SumDebitCreditTable(System.Data.DataTable dt, out decimal d, out decimal c)&#xA;{&#xA;    d = 0m; c = 0m;&#xA;    for (int i = 0; i &lt; dt.Rows.Count; i++)&#xA;    {&#xA;        d += ParseAmountSafe(dt.Rows[i], colDebit);&#xA;        c += ParseAmountSafe(dt.Rows[i], colCredit);&#xA;    }&#xA;}&#xA;&#xA;// ❗ Exclude ALL CMS rows whose narration mentions fee / fees / levy / service tax / tax on income / income&#xA;//     using exact words/phrases (no FEETZ, INCOMEZ, etc.)&#xA;bool HasFeeOrIncomeTokens(string narrU)&#xA;{&#xA;    if (string.IsNullOrEmpty(narrU))&#xA;        return false;&#xA;&#xA;    // Whole word: FEE or FEES&#xA;    if (System.Text.RegularExpressions.Regex.IsMatch(&#xA;            narrU,&#xA;            @&quot;\bFEE(S)?\b&quot;,&#xA;            System.Text.RegularExpressions.RegexOptions.IgnoreCase))&#xA;        return true;&#xA;&#xA;    // Whole word: LEVY&#xA;    if (System.Text.RegularExpressions.Regex.IsMatch(&#xA;            narrU,&#xA;            @&quot;\bLEVY\b&quot;,&#xA;            System.Text.RegularExpressions.RegexOptions.IgnoreCase))&#xA;        return true;&#xA;&#xA;    // Whole phrase: SERVICE TAX&#xA;    if (System.Text.RegularExpressions.Regex.IsMatch(&#xA;            narrU,&#xA;            @&quot;\bSERVICE\s+TAX\b&quot;,&#xA;            System.Text.RegularExpressions.RegexOptions.IgnoreCase))&#xA;        return true;&#xA;&#xA;    // Whole phrase: TAX ON INCOME&#xA;    if (System.Text.RegularExpressions.Regex.IsMatch(&#xA;            narrU,&#xA;            @&quot;\bTAX\s+ON\s+INCOME\b&quot;,&#xA;            System.Text.RegularExpressions.RegexOptions.IgnoreCase))&#xA;        return true;&#xA;&#xA;    // Whole word: INCOME&#xA;    if (System.Text.RegularExpressions.Regex.IsMatch(&#xA;            narrU,&#xA;            @&quot;\bINCOME\b&quot;,&#xA;            System.Text.RegularExpressions.RegexOptions.IgnoreCase))&#xA;        return true;&#xA;&#xA;    return false;&#xA;}&#xA;&#xA;// STRICT C_PAN rule: find the word starting with 550558 and ending with 4 digits,&#xA;// then return 550558XXXXXX + last4.&#xA;string ExtractCpanFromNarration(string narration)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(narration)) return &quot;&quot;;&#xA;&#xA;    // Examples:&#xA;    //   550558******7179&#xA;    //   550558XXXXXX7179&#xA;    //   5505581234567890&#xA;    var m = System.Text.RegularExpressions.Regex.Match(&#xA;        narration,&#xA;        @&quot;\b(550558)[0-9Xx\*]{0,10}(\d{4})\b&quot;,&#xA;        System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;&#xA;    if (!m.Success) return &quot;&quot;;&#xA;&#xA;    string first6 = m.Groups[1].Value;   // 550558&#xA;    string last4  = m.Groups[2].Value;   // e.g. 7179&#xA;    return first6 + &quot;XXXXXX&quot; + last4;    // 550558XXXXXX7179&#xA;}&#xA;&#xA;// STRICTLY from GL Narration — RRN (12 alnum) only (PAN here just for logging)&#xA;void ExtractPanRrnFromGlNarration(string narr, out string pan, out string rrn)&#xA;{&#xA;    pan = &quot;&quot;; rrn = &quot;&quot;;&#xA;    if (string.IsNullOrWhiteSpace(narr)) return;&#xA;&#xA;    var panM = System.Text.RegularExpressions.Regex.Match(&#xA;        narr,&#xA;        @&quot;\b\d{6}(?:\*{2,12}|X{2,12})\d{4}\b&quot;,&#xA;        System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;    if (panM.Success)&#xA;    {&#xA;        pan = panM.Value;&#xA;    }&#xA;    else&#xA;    {&#xA;        var plain16 = System.Text.RegularExpressions.Regex.Match(&#xA;            narr,&#xA;            @&quot;\b\d{16}\b&quot;,&#xA;            System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;        if (plain16.Success) pan = plain16.Value;&#xA;    }&#xA;&#xA;    var rrnM = System.Text.RegularExpressions.Regex.Match(&#xA;        narr,&#xA;        @&quot;\b[A-Za-z0-9]{12}\b&quot;,&#xA;        System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;    if (rrnM.Success) rrn = rrnM.Value.ToUpperInvariant();&#xA;}&#xA;&#xA;bool IsCmsEligible(System.Data.DataRow r)&#xA;{&#xA;    string narr = Val(r[&quot;Narration&quot;]);&#xA;    string chan = hasChannel ? Val(r[&quot;Channel&quot;]) : &quot;&quot;;&#xA;    if (HasFeeOrIncomeTokens(ToUpperStr(narr))) return false;&#xA;&#xA;    return (StartsWithIgnore(narr, &quot;Cash Withdrawal&quot;) &amp;&amp; !EqualsIgnore(chan, &quot;API&quot;)) ||&#xA;           (StartsWithIgnore(narr, &quot;Purchase/Auth Completion&quot;) &amp;&amp; !EqualsIgnore(chan, &quot;API&quot;)) ||&#xA;           (StartsWithIgnore(narr, &quot;Unique Txn&quot;) &amp;&amp; !EqualsIgnore(chan, &quot;API&quot;)) ||&#xA;           (StartsWithIgnore(narr, &quot;Recurring Transaction&quot;) &amp;&amp; !EqualsIgnore(chan, &quot;API&quot;));&#xA;}&#xA;&#xA;decimal CmsPrincipalAmount(System.Data.DataRow r)&#xA;{&#xA;    decimal cr = ParseAmountSafe(r, colCredit);&#xA;    decimal dr = ParseAmountSafe(r, colDebit);&#xA;    return (cr &gt; 0m) ? cr : (dr &gt; 0m ? dr : 0m);&#xA;}&#xA;&#xA;bool TryGetCmsRrn(System.Data.DataRow r, out string rrn)&#xA;{&#xA;    rrn = &quot;&quot;;&#xA;    if (!hasRrn) return false;&#xA;    var raw = Val(r[&quot;RRN&quot;]).Trim();&#xA;    if (raw.Length == 12 &amp;&amp; System.Text.RegularExpressions.Regex.IsMatch(raw, @&quot;^[A-Za-z0-9]{12}$&quot;))&#xA;    {&#xA;        rrn = raw.ToUpperInvariant();&#xA;        return true;&#xA;    }&#xA;    return false;&#xA;}&#xA;&#xA;// Composite key builder: RRN + '|' + C_PAN (both must be non-empty)&#xA;string BuildKey(string rrn, string cpan)&#xA;{&#xA;    rrn  = (rrn  ?? &quot;&quot;).Trim().ToUpperInvariant();&#xA;    cpan = (cpan ?? &quot;&quot;).Trim().ToUpperInvariant();&#xA;    if (string.IsNullOrEmpty(rrn) || string.IsNullOrEmpty(cpan)) return &quot;&quot;;&#xA;    return rrn + &quot;|&quot; + cpan;&#xA;}&#xA;&#xA;// ===== BEFORE totals =====&#xA;SumDebitCreditTable(dtHistoricalReconTransactionsReport, out var beforeDebit, out var beforeCredit);&#xA;var beforeDiff = beforeDebit - beforeCredit;&#xA;System.Console.WriteLine($&quot;[BAL] BEFORE — Debit {beforeDebit:N2}, Credit {beforeCredit:N2}, Δ(D−C): {beforeDiff:N2}&quot;);&#xA;&#xA;// ===== Build CMS groups by composite key (RRN + C_PAN) =====&#xA;var cmsGroups = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;(System.StringComparer.OrdinalIgnoreCase);&#xA;&#xA;if (hasRrn)&#xA;{&#xA;    for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;    {&#xA;        var row = dtHistoricalReconTransactionsReport.Rows[i];&#xA;        if (!IsCmsEligible(row)) continue;&#xA;&#xA;        // FORCE CMS C_PAN from its own Narration&#xA;        string cmsCpan = &quot;&quot;;&#xA;        if (hasCpan)&#xA;        {&#xA;            cmsCpan = ExtractCpanFromNarration(Val(row[&quot;Narration&quot;]));&#xA;            if (!string.IsNullOrEmpty(cmsCpan))&#xA;                row[&quot;C_PAN&quot;] = cmsCpan;&#xA;            else&#xA;                cmsCpan = Val(row[&quot;C_PAN&quot;]);&#xA;        }&#xA;&#xA;        if (!TryGetCmsRrn(row, out var rrn)) continue;&#xA;&#xA;        // 🚫 If C_PAN or RRN missing, DO NOT group&#xA;        string key = BuildKey(rrn, cmsCpan);&#xA;        if (string.IsNullOrEmpty(key)) continue;&#xA;&#xA;        decimal principal = CmsPrincipalAmount(row);&#xA;        if (principal &lt;= 0m) continue;&#xA;&#xA;        if (!cmsGroups.TryGetValue(key, out var list))&#xA;        {&#xA;            list = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;            cmsGroups[key] = list;&#xA;        }&#xA;        list.Add(row);&#xA;    }&#xA;}&#xA;System.Console.WriteLine($&quot;📦 CMS composite groups ready (RRN + C_PAN): {cmsGroups.Count} keys&quot;);&#xA;&#xA;// ===== Match &amp; MOVE (by composite key) =====&#xA;exchangeGainOrLossPPSP = 0m;&#xA;int glSeen = 0, glMatched = 0, glNoCms = 0, movedPairs = 0;&#xA;int glSkippedNoKey = 0;&#xA;decimal sumGlMatched = 0m, sumCmsMatched = 0m;&#xA;decimal removedDebit = 0m, removedCredit = 0m;&#xA;&#xA;var unmatchedSnippets = new System.Collections.Generic.List&lt;string&gt;();&#xA;var skippedMissingKey = new System.Collections.Generic.List&lt;string&gt;();&#xA;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var gl = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    if (!hasTrnRef || !hasNarration) continue;&#xA;&#xA;    string trn = Val(gl[&quot;Transaction Ref No:&quot;]);&#xA;    if (trn.IndexOf(&quot;PPSP&quot;, System.StringComparison.OrdinalIgnoreCase) &lt; 0 &amp;&amp; trn.IndexOf(&quot;ADPP&quot;, System.StringComparison.OrdinalIgnoreCase) &lt; 0) continue; // only GL PPSP/ADPP&#xA;    glSeen++;&#xA;&#xA;    // Extract RRN from GL Narration (PAN here for logging only)&#xA;    ExtractPanRrnFromGlNarration(Val(gl[&quot;Narration&quot;]), out var glPanRaw, out var glRrnRaw);&#xA;    string glRrn = string.IsNullOrEmpty(glRrnRaw) ? &quot;&quot; : glRrnRaw.ToUpperInvariant();&#xA;&#xA;    // Strict: GL C_PAN from its own Narration token starting with 550558&#xA;    string glCpan = hasCpan ? ExtractCpanFromNarration(Val(gl[&quot;Narration&quot;])) : &quot;&quot;;&#xA;    if (hasCpan &amp;&amp; !string.IsNullOrEmpty(glCpan))&#xA;        gl[&quot;C_PAN&quot;] = glCpan;&#xA;&#xA;    // 🚫 If C_PAN or RRN missing, DO NOT match&#xA;    string key = BuildKey(glRrn, glCpan);&#xA;    if (string.IsNullOrEmpty(key))&#xA;    {&#xA;        glSkippedNoKey++;&#xA;        if (skippedMissingKey.Count &lt; 20)&#xA;            skippedMissingKey.Add($&quot;TRN={trn}, C_PAN={glCpan}, RRN={glRrn}&lt;missing-part&gt;&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    decimal glDebit = ParseAmountSafe(gl, colDebit);&#xA;    decimal glCredit = ParseAmountSafe(gl, colCredit);&#xA;    decimal glPrincipal = glDebit &gt; 0 ? glDebit : (glCredit &gt; 0 ? glCredit : 0);&#xA;    if (glPrincipal &lt;= 0m) continue;&#xA;&#xA;    if (!cmsGroups.TryGetValue(key, out var cmsList) || cmsList == null || cmsList.Count == 0)&#xA;    {&#xA;        glNoCms++;&#xA;        if (unmatchedSnippets.Count &lt; 20)&#xA;            unmatchedSnippets.Add($&quot;KEY={key}, GL={glPrincipal:N2}, TRN={trn}&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    // Sum CMS group principals and net (Δ) for accurate gain/loss &amp; totals removal&#xA;    decimal groupCmsPrincipal = 0m;&#xA;    decimal groupCmsDebit = 0m, groupCmsCredit = 0m;&#xA;    foreach (var cmsRow in cmsList)&#xA;    {&#xA;        groupCmsPrincipal += CmsPrincipalAmount(cmsRow);&#xA;        groupCmsDebit  += ParseAmountSafe(cmsRow, colDebit);&#xA;        groupCmsCredit += ParseAmountSafe(cmsRow, colCredit);&#xA;    }&#xA;&#xA;    decimal pairNet = (glDebit - glCredit) + (groupCmsDebit - groupCmsCredit);&#xA;&#xA;    exchangeGainOrLossPPSP += pairNet;&#xA;    sumGlMatched  += glPrincipal;&#xA;    sumCmsMatched += groupCmsPrincipal;&#xA;    glMatched++;&#xA;&#xA;    gl[&quot;Classification&quot;] = &quot;PPSP&quot;;&#xA;    foreach (var cmsRow in cmsList) cmsRow[&quot;Classification&quot;] = &quot;PPSP&quot;;&#xA;&#xA;    removedDebit  += glDebit + groupCmsDebit;&#xA;    removedCredit += glCredit + groupCmsCredit;&#xA;&#xA;    dtHistoricalReconTransactionsReportMatched.ImportRow(gl);&#xA;    foreach (var cmsRow in cmsList)&#xA;        dtHistoricalReconTransactionsReportMatched.ImportRow(cmsRow);&#xA;&#xA;    cmsGroups.Remove(key);&#xA;    foreach (var cmsRow in cmsList)&#xA;        dtHistoricalReconTransactionsReport.Rows.Remove(cmsRow);&#xA;&#xA;    dtHistoricalReconTransactionsReport.Rows.Remove(gl);&#xA;    i--;&#xA;    movedPairs++;&#xA;}&#xA;&#xA;// ===== AFTER totals &amp; wrap =====&#xA;SumDebitCreditTable(dtHistoricalReconTransactionsReport, out var afterDebit, out var afterCredit);&#xA;var afterDiff   = afterDebit - afterCredit;&#xA;var removedDiff = removedDebit - removedCredit;&#xA;&#xA;exchangeGainOrLossPPSP = decimal.Round(removedDiff, 2, System.MidpointRounding.AwayFromZero);&#xA;&#xA;// ===== Logs =====&#xA;System.Console.WriteLine($&quot;📊 GL PPSP seen={glSeen}, matched={glMatched}, noCMS={glNoCms}, movedPairs={movedPairs}, skippedNoKey={glSkippedNoKey}&quot;);&#xA;System.Console.WriteLine($&quot;   Matched principals — GL sum={sumGlMatched:N2}, CMS sum={sumCmsMatched:N2}&quot;);&#xA;System.Console.WriteLine($&quot;🧮 Totals — Δ_before={beforeDiff:N2}, Δ_removed={removedDiff:N2}, Δ_after={afterDiff:N2}&quot;);&#xA;System.Console.WriteLine($&quot;💱 Final exchangeGainOrLossPPSP = {exchangeGainOrLossPPSP:N2} {currency}&quot;);&#xA;&#xA;if (skippedMissingKey.Count &gt; 0)&#xA;{&#xA;    System.Console.WriteLine(&quot;⚠️ GL PPSP rows skipped (C_PAN or RRN missing for key):&quot;);&#xA;    for (int k = 0; k &lt; skippedMissingKey.Count; k++)&#xA;        System.Console.WriteLine($&quot;   • {skippedMissingKey[k]}&quot;);&#xA;}&#xA;&#xA;if (unmatchedSnippets.Count &gt; 0)&#xA;{&#xA;    System.Console.WriteLine(&quot;🧩 Unmatched GL PPSP rows (no CMS composite group for key) — up to 20:&quot;);&#xA;    for (int k = 0; k &lt; unmatchedSnippets.Count; k++)&#xA;        System.Console.WriteLine($&quot;   • {unmatchedSnippets[k]}&quot;);&#xA;}&#xA;&#xA;System.Console.WriteLine($&quot;⏱️ Completed in {sw.ElapsedMilliseconds} ms&quot;);&#xA;" DisplayName="PPSP + exchangeGainOrLossPPSP GL vs CMS" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_74" Language="CSharp">

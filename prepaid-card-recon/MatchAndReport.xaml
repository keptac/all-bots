        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: Exact PRDP/AGR ↔ LOAD/RELOAD Matching (C_PAN|RRN|AMOUNT) ====&#xA;// Rule: DO NOT FORCE or SANITIZE amounts. We only import pairs that naturally net to 0.00&#xA;//       AND where each participating row is single-sided (only Dr or only Cr &gt; 0).&#xA;//       Dual-sided rows are skipped (logged) and NOT imported.&#xA;// In/Out: DataTable dtHistoricalReconTransactionsReport&#xA;// In/Out: DataTable dtHistoricalReconTransactionsReportMatched&#xA;// In    : string reconCurrency&#xA;&#xA;// ---- Guards ----&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport), &quot;Input DataTable cannot be null&quot;);&#xA;&#xA;if (dtHistoricalReconTransactionsReportMatched == null ||&#xA;    dtHistoricalReconTransactionsReportMatched.Columns.Count != dtHistoricalReconTransactionsReport.Columns.Count)&#xA;{&#xA;    dtHistoricalReconTransactionsReportMatched = dtHistoricalReconTransactionsReport.Clone();&#xA;}&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Classification&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Classification&quot;))&#xA;    dtHistoricalReconTransactionsReportMatched.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;&#xA;// ---- Config ----&#xA;string currency = reconCurrency;&#xA;decimal balanceTol = 0.01m;&#xA;string[] glProductCodes = { &quot;PRDP&quot;, &quot;PRTP&quot;, &quot;AGR1&quot;, &quot;AGR2&quot;, &quot;AGR3&quot;, &quot;CHWD&amp;AGPS&quot; };&#xA;var invariant = System.Globalization.CultureInfo.InvariantCulture;&#xA;&#xA;// ---- Regex &amp; helpers ----&#xA;System.Text.RegularExpressions.Regex rrn12Rx = new System.Text.RegularExpressions.Regex(@&quot;\b\d{12}\b&quot;, System.Text.RegularExpressions.RegexOptions.Compiled);&#xA;System.Text.RegularExpressions.Regex panTightRx = new System.Text.RegularExpressions.Regex(@&quot;\b\d{6}[*X]{4,12}\d{4}\b&quot;, System.Text.RegularExpressions.RegexOptions.Compiled);&#xA;&#xA;decimal ParseAmount(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return 0m;&#xA;    string s = val.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;);&#xA;    if (s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;)) s = &quot;-&quot; + s.Substring(1, s.Length - 2);&#xA;    decimal d;&#xA;    return decimal.TryParse(s, out d) ? d : 0m;&#xA;}&#xA;decimal Round2(decimal v) =&gt; decimal.Round(v, 2, MidpointRounding.AwayFromZero);&#xA;&#xA;string CleanTextInline(string input)&#xA;{&#xA;    string s = (input ?? &quot;&quot;).Trim();&#xA;    s = System.Text.RegularExpressions.Regex.Replace(s, @&quot;[^\w\s\-]&quot;, &quot;&quot;);&#xA;    return s.ToUpperInvariant();&#xA;}&#xA;string CollapseNarr(object narrObj)&#xA;{&#xA;    string narr = narrObj == DBNull.Value ? &quot;&quot; : narrObj.ToString();&#xA;    string up = (narr ?? &quot;&quot;).ToUpperInvariant();&#xA;    return up.Replace(&quot; &quot;, &quot;&quot;).Replace(&quot;-&quot;, &quot;&quot;);&#xA;}&#xA;string NormalizePanForKey(string panRaw, string narrationRawUpper)&#xA;{&#xA;    string s = (panRaw ?? &quot;&quot;).ToUpperInvariant().Replace(&quot; &quot;, &quot;&quot;).Replace(&quot;-&quot;, &quot;&quot;).Replace(&quot;*&quot;, &quot;X&quot;);&#xA;    var m = panTightRx.Match(s);&#xA;    if (!m.Success)&#xA;        // Column value was empty or didn&apos;t contain a PAN: fall back to the RAW narration.&#xA;        // Must use the UNcollapsed narration - stripping hyphens/spaces first merges adjacent&#xA;        // numeric segments (e.g. PAN-RRN-CODE) and destroys the \b boundaries this regex needs.&#xA;        m = panTightRx.Match(narrationRawUpper ?? &quot;&quot;);&#xA;    if (m.Success)&#xA;    {&#xA;        string v = m.Value; // 6d + X{4..12} + 4d&#xA;        return v.Substring(0, 6) + &quot;XXXXXX&quot; + v.Substring(v.Length - 4);&#xA;    }&#xA;    return &quot;&quot;;&#xA;}&#xA;string NormalizeRrn(string rawRrn, string narrationUpperCollapsed)&#xA;{&#xA;    string r = (rawRrn ?? &quot;&quot;).Replace(&quot; &quot;, &quot;&quot;).Replace(&quot;-&quot;, &quot;&quot;);&#xA;    long _;&#xA;    if (r.Length == 12 &amp;&amp; long.TryParse(r, out _)) return r;&#xA;    var m1 = rrn12Rx.Match(r);&#xA;    if (m1.Success) return m1.Value;&#xA;    var m2 = rrn12Rx.Match(narrationUpperCollapsed);&#xA;    if (m2.Success) return m2.Value;&#xA;    return &quot;&quot;;&#xA;}&#xA;string FindCol(System.Data.DataTable dt, string prefer)&#xA;{&#xA;    if (dt.Columns.Contains(prefer)) return prefer;&#xA;    for (int i = 0; i &lt; dt.Columns.Count; i++)&#xA;    {&#xA;        string n = dt.Columns[i].ColumnName?.Trim();&#xA;        if (string.Equals(n, prefer, StringComparison.OrdinalIgnoreCase)) return dt.Columns[i].ColumnName;&#xA;    }&#xA;    bool wantDebit = prefer.StartsWith(&quot;Debit (&quot;, StringComparison.OrdinalIgnoreCase);&#xA;    for (int i = 0; i &lt; dt.Columns.Count; i++)&#xA;    {&#xA;        string n = dt.Columns[i].ColumnName?.Trim();&#xA;        if (n == null) continue;&#xA;        if (wantDebit)&#xA;        {&#xA;            if (n.StartsWith(&quot;Debit (&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp; n.EndsWith(&quot;)&quot;)) return n;&#xA;        }&#xA;        else&#xA;        {&#xA;            if (n.StartsWith(&quot;Credit (&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp; n.EndsWith(&quot;)&quot;)) return n;&#xA;        }&#xA;    }&#xA;    return null;&#xA;}&#xA;void SumDebitCredit(System.Data.DataTable dt, string debitCol, string creditCol, out decimal dSum, out decimal cSum)&#xA;{&#xA;    dSum = 0m; cSum = 0m;&#xA;    if (dt == null) return;&#xA;    bool hasD = !string.IsNullOrEmpty(debitCol) &amp;&amp; dt.Columns.Contains(debitCol);&#xA;    bool hasC = !string.IsNullOrEmpty(creditCol) &amp;&amp; dt.Columns.Contains(creditCol);&#xA;    for (int i = 0; i &lt; dt.Rows.Count; i++)&#xA;    {&#xA;        var r = dt.Rows[i];&#xA;        if (hasD) dSum += ParseAmount(r[debitCol]);&#xA;        if (hasC) cSum += ParseAmount(r[creditCol]);&#xA;    }&#xA;}&#xA;string MakeKey(string pan, string rrn, decimal amt2dp)&#xA;{&#xA;    return pan + &quot;|&quot; + rrn + &quot;|&quot; + amt2dp.ToString(&quot;F2&quot;, invariant);&#xA;}&#xA;string RowRef(System.Data.DataRow r)&#xA;{&#xA;    string sn = r.Table.Columns.Contains(&quot;SNO&quot;) ? (r[&quot;SNO&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;    string tr = r.Table.Columns.Contains(&quot;Transaction Ref No:&quot;) ? (r[&quot;Transaction Ref No:&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;    if (!string.IsNullOrEmpty(sn)) return $&quot;SNO={sn}&quot;;&#xA;    if (!string.IsNullOrEmpty(tr)) return $&quot;TRN={tr}&quot;;&#xA;    return $&quot;IDX={r.Table.Rows.IndexOf(r)}&quot;;&#xA;}&#xA;&#xA;// ---- Early exit &amp; amount columns ----&#xA;if (dtHistoricalReconTransactionsReport.Rows.Count == 0)&#xA;{&#xA;    System.Console.WriteLine(&quot;No rows to process.&quot;);&#xA;    return;&#xA;}&#xA;string effectiveDebitCol  = FindCol(dtHistoricalReconTransactionsReport, &quot;Debit (&quot; + currency + &quot;)&quot;);&#xA;string effectiveCreditCol = FindCol(dtHistoricalReconTransactionsReport, &quot;Credit (&quot; + currency + &quot;)&quot;);&#xA;if (effectiveDebitCol == null &amp;&amp; effectiveCreditCol == null)&#xA;{&#xA;    System.Console.WriteLine(&quot;❌ No Debit/Credit columns found. Aborting.&quot;);&#xA;    return;&#xA;}&#xA;System.Console.WriteLine($&quot;[INFO] Using columns → Debit: '{effectiveDebitCol ?? &quot;N/A&quot;}', Credit: '{effectiveCreditCol ?? &quot;N/A&quot;}'&quot;);&#xA;&#xA;// ---- BEFORE totals ----&#xA;decimal beforeDr=0m, beforeCr=0m;&#xA;SumDebitCredit(dtHistoricalReconTransactionsReport, effectiveDebitCol, effectiveCreditCol, out beforeDr, out beforeCr);&#xA;System.Console.WriteLine($&quot;[BAL] BEFORE — Debit ({currency}): {beforeDr:N2}, Credit ({currency}): {beforeCr:N2}, Δ(D−C): {(beforeDr-beforeCr):N2}&quot;);&#xA;&#xA;// ---- Candidate detection ----&#xA;bool IsGL(System.Data.DataRow r)&#xA;{&#xA;    string refNo = r.Table.Columns.Contains(&quot;Transaction Ref No:&quot;) &amp;&amp; r[&quot;Transaction Ref No:&quot;] != DBNull.Value&#xA;                   ? r[&quot;Transaction Ref No:&quot;].ToString().ToUpperInvariant() : &quot;&quot;;&#xA;    if (string.IsNullOrEmpty(refNo)) return false;&#xA;    for (int i = 0; i &lt; glProductCodes.Length; i++) if (refNo.Contains(glProductCodes[i])) return true;&#xA;    return false;&#xA;}&#xA;bool IsFee(System.Data.DataRow r)&#xA;{&#xA;    string narr = r.Table.Columns.Contains(&quot;Narration&quot;) &amp;&amp; r[&quot;Narration&quot;] != DBNull.Value&#xA;                  ? CleanTextInline(r[&quot;Narration&quot;].ToString()) : &quot;&quot;;&#xA;    if (string.IsNullOrEmpty(narr)) return false;&#xA;    return narr.Contains(&quot;LOAD RELOAD&quot;) || narr.Contains(&quot;LOADRELOAD&quot;) || (narr.Contains(&quot;LOAD&quot;) &amp;&amp; narr.Contains(&quot;RELOAD&quot;));&#xA;}&#xA;&#xA;var glRows  = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;var feeRows = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    if (IsGL(r))  { r[&quot;Classification&quot;] = &quot;PRDPAGR&quot;; glRows.Add(r); }&#xA;    if (IsFee(r)) { r[&quot;Classification&quot;] = &quot;PRDPAGR&quot;; feeRows.Add(r); }&#xA;}&#xA;System.Console.WriteLine($&quot;[INFO] GL candidates: {glRows.Count}, Fee candidates: {feeRows.Count}&quot;);&#xA;&#xA;// ---- Build key indexes — SKIP dual-sided rows entirely ----&#xA;var glCreditByKey = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;var glDebitByKey  = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;var feeCreditByKey= new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;var feeDebitByKey = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;&#xA;int missKeysGL=0, missKeysFee=0, bothSideGL=0, bothSideFee=0, zeroAmtGL=0, zeroAmtFee=0;&#xA;int dualSideLogged = 0;&#xA;&#xA;for (int i = 0; i &lt; glRows.Count; i++)&#xA;{&#xA;    var r = glRows[i];&#xA;    string narrCol = CollapseNarr(r[&quot;Narration&quot;]);&#xA;    string narrRaw = (r[&quot;Narration&quot;] == DBNull.Value || r[&quot;Narration&quot;] == null) ? &quot;&quot; : r[&quot;Narration&quot;].ToString().ToUpperInvariant();&#xA;    string pan = NormalizePanForKey(r.Table.Columns.Contains(&quot;C_PAN&quot;) ? (r[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;, narrRaw);&#xA;    string rrn = NormalizeRrn(r.Table.Columns.Contains(&quot;RRN&quot;) ? (r[&quot;RRN&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;, narrRaw);&#xA;    if (r.Table.Columns.Contains(&quot;C_PAN&quot;) &amp;&amp; string.IsNullOrWhiteSpace(r[&quot;C_PAN&quot;]?.ToString())) r[&quot;C_PAN&quot;] = pan;&#xA;    if (r.Table.Columns.Contains(&quot;RRN&quot;)   &amp;&amp; string.IsNullOrWhiteSpace(r[&quot;RRN&quot;]?.ToString()))   r[&quot;RRN&quot;]   = rrn;&#xA;&#xA;    if (string.IsNullOrEmpty(pan) || string.IsNullOrEmpty(rrn)) { missKeysGL++; continue; }&#xA;&#xA;    decimal dr = effectiveDebitCol  != null ? Round2(ParseAmount(r[effectiveDebitCol]))  : 0m;&#xA;    decimal cr = effectiveCreditCol != null ? Round2(ParseAmount(r[effectiveCreditCol])) : 0m;&#xA;&#xA;    if (dr == 0m &amp;&amp; cr == 0m) { zeroAmtGL++; continue; }&#xA;    if (dr &gt; 0m &amp;&amp; cr &gt; 0m) { bothSideGL++; if (dualSideLogged &lt; 50) { System.Console.WriteLine($&quot;[WARN] Dual-sided GL row skipped ({RowRef(r)}): Dr={dr:N2}, Cr={cr:N2}&quot;); dualSideLogged++; } continue; }&#xA;&#xA;    if (cr &gt; 0m)&#xA;    {&#xA;        string k = MakeKey(pan, rrn, cr);&#xA;        if (!glCreditByKey.TryGetValue(k, out var list)) { list = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;(); glCreditByKey[k] = list; }&#xA;        list.Add(r);&#xA;    }&#xA;    else if (dr &gt; 0m)&#xA;    {&#xA;        string k = MakeKey(pan, rrn, dr);&#xA;        if (!glDebitByKey.TryGetValue(k, out var list)) { list = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;(); glDebitByKey[k] = list; }&#xA;        list.Add(r);&#xA;    }&#xA;}&#xA;for (int i = 0; i &lt; feeRows.Count; i++)&#xA;{&#xA;    var r = feeRows[i];&#xA;    string narrCol = CollapseNarr(r[&quot;Narration&quot;]);&#xA;    string narrRaw = (r[&quot;Narration&quot;] == DBNull.Value || r[&quot;Narration&quot;] == null) ? &quot;&quot; : r[&quot;Narration&quot;].ToString().ToUpperInvariant();&#xA;    string pan = NormalizePanForKey(r.Table.Columns.Contains(&quot;C_PAN&quot;) ? (r[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;, narrRaw);&#xA;    string rrn = NormalizeRrn(r.Table.Columns.Contains(&quot;RRN&quot;) ? (r[&quot;RRN&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;, narrRaw);&#xA;    if (r.Table.Columns.Contains(&quot;C_PAN&quot;) &amp;&amp; string.IsNullOrWhiteSpace(r[&quot;C_PAN&quot;]?.ToString())) r[&quot;C_PAN&quot;] = pan;&#xA;    if (r.Table.Columns.Contains(&quot;RRN&quot;)   &amp;&amp; string.IsNullOrWhiteSpace(r[&quot;RRN&quot;]?.ToString()))   r[&quot;RRN&quot;]   = rrn;&#xA;&#xA;    if (string.IsNullOrEmpty(pan) || string.IsNullOrEmpty(rrn)) { missKeysFee++; continue; }&#xA;&#xA;    decimal dr = effectiveDebitCol  != null ? Round2(ParseAmount(r[effectiveDebitCol]))  : 0m;&#xA;    decimal cr = effectiveCreditCol != null ? Round2(ParseAmount(r[effectiveCreditCol])) : 0m;&#xA;&#xA;    if (dr == 0m &amp;&amp; cr == 0m) { zeroAmtFee++; continue; }&#xA;    if (dr &gt; 0m &amp;&amp; cr &gt; 0m) { bothSideFee++; if (dualSideLogged &lt; 50) { System.Console.WriteLine($&quot;[WARN] Dual-sided FEE row skipped ({RowRef(r)}): Dr={dr:N2}, Cr={cr:N2}&quot;); dualSideLogged++; } continue; }&#xA;&#xA;    if (cr &gt; 0m)&#xA;    {&#xA;        string k = MakeKey(pan, rrn, cr);&#xA;        if (!feeCreditByKey.TryGetValue(k, out var list)) { list = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;(); feeCreditByKey[k] = list; }&#xA;        list.Add(r);&#xA;    }&#xA;    else if (dr &gt; 0m)&#xA;    {&#xA;        string k = MakeKey(pan, rrn, dr);&#xA;        if (!feeDebitByKey.TryGetValue(k, out var list)) { list = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;(); feeDebitByKey[k] = list; }&#xA;        list.Add(r);&#xA;    }&#xA;}&#xA;&#xA;System.Console.WriteLine($&quot;[IDX] GL:   keys(CR)={glCreditByKey.Count}, keys(DR)={glDebitByKey.Count}, missingKeys={missKeysGL}, zeroAmt={zeroAmtGL}, dual-sided skipped={bothSideGL}&quot;);&#xA;System.Console.WriteLine($&quot;[IDX] FEE:  keys(CR)={feeCreditByKey.Count}, keys(DR)={feeDebitByKey.Count}, missingKeys={missKeysFee}, zeroAmt={zeroAmtFee}, dual-sided skipped={bothSideFee}&quot;);&#xA;&#xA;// ---- Matching (ONLY natural net-zero, single-sided pairs are imported) ----&#xA;var rowsToRemove = new System.Collections.Generic.HashSet&lt;System.Data.DataRow&gt;();&#xA;int matchedPairs = 0;&#xA;decimal removedDr = 0m, removedCr = 0m;&#xA;&#xA;// Pass A: GL Credit ↔ Fee Debit (Cr == Dr), ensure single-sided participation&#xA;foreach (var kv in glCreditByKey)&#xA;{&#xA;    string key = kv.Key;&#xA;    if (!feeDebitByKey.TryGetValue(key, out var feeList)) continue;&#xA;    var glList = kv.Value;&#xA;&#xA;    for (int i = 0; i &lt; glList.Count; i++)&#xA;    {&#xA;        var a = glList[i];&#xA;        if (rowsToRemove.Contains(a)) continue;&#xA;&#xA;        System.Data.DataRow b = null;&#xA;        for (int j = 0; j &lt; feeList.Count; j++)&#xA;        {&#xA;            if (rowsToRemove.Contains(feeList[j])) continue;&#xA;            b = feeList[j]; break;&#xA;        }&#xA;        if (b == null) continue;&#xA;&#xA;        decimal aDr = effectiveDebitCol  != null ? Round2(ParseAmount(a[effectiveDebitCol]))  : 0m;&#xA;        decimal aCr = effectiveCreditCol != null ? Round2(ParseAmount(a[effectiveCreditCol])) : 0m;&#xA;        decimal bDr = effectiveDebitCol  != null ? Round2(ParseAmount(b[effectiveDebitCol]))  : 0m;&#xA;        decimal bCr = effectiveCreditCol != null ? Round2(ParseAmount(b[effectiveCreditCol])) : 0m;&#xA;&#xA;        bool singleSidedOK = (aCr &gt; 0m &amp;&amp; aDr == 0m &amp;&amp; bDr &gt; 0m &amp;&amp; bCr == 0m);&#xA;        bool netZero = (aCr == bDr &amp;&amp; aCr &gt; 0m);&#xA;        if (!(singleSidedOK &amp;&amp; netZero))&#xA;        {&#xA;            System.Console.WriteLine($&quot;[SKIP-GLCR↔FEEDR] key='{key}' a({RowRef(a)} Dr={aDr:N2},Cr={aCr:N2}) b({RowRef(b)} Dr={bDr:N2},Cr={bCr:N2})&quot;);&#xA;            continue;&#xA;        }&#xA;&#xA;        dtHistoricalReconTransactionsReportMatched.ImportRow(a);&#xA;        dtHistoricalReconTransactionsReportMatched.ImportRow(b);&#xA;        rowsToRemove.Add(a);&#xA;        rowsToRemove.Add(b);&#xA;&#xA;        removedDr += aDr + bDr;&#xA;        removedCr += aCr + bCr;&#xA;        matchedPairs++;&#xA;&#xA;    }&#xA;}&#xA;&#xA;// Pass B: GL Debit ↔ Fee Credit (Dr == Cr), ensure single-sided participation&#xA;foreach (var kv in glDebitByKey)&#xA;{&#xA;    string key = kv.Key;&#xA;    if (!feeCreditByKey.TryGetValue(key, out var feeList)) continue;&#xA;    var glList = kv.Value;&#xA;&#xA;    for (int i = 0; i &lt; glList.Count; i++)&#xA;    {&#xA;        var a = glList[i];&#xA;        if (rowsToRemove.Contains(a)) continue;&#xA;&#xA;        System.Data.DataRow b = null;&#xA;        for (int j = 0; j &lt; feeList.Count; j++)&#xA;        {&#xA;            if (rowsToRemove.Contains(feeList[j])) continue;&#xA;            b = feeList[j]; break;&#xA;        }&#xA;        if (b == null) continue;&#xA;&#xA;        decimal aDr = effectiveDebitCol  != null ? Round2(ParseAmount(a[effectiveDebitCol]))  : 0m;&#xA;        decimal aCr = effectiveCreditCol != null ? Round2(ParseAmount(a[effectiveCreditCol])) : 0m;&#xA;        decimal bDr = effectiveDebitCol  != null ? Round2(ParseAmount(b[effectiveDebitCol]))  : 0m;&#xA;        decimal bCr = effectiveCreditCol != null ? Round2(ParseAmount(b[effectiveCreditCol])) : 0m;&#xA;&#xA;        bool singleSidedOK = (aDr &gt; 0m &amp;&amp; aCr == 0m &amp;&amp; bCr &gt; 0m &amp;&amp; bDr == 0m);&#xA;        bool netZero = (aDr == bCr &amp;&amp; aDr &gt; 0m);&#xA;        if (!(singleSidedOK &amp;&amp; netZero))&#xA;        {&#xA;            System.Console.WriteLine($&quot;[SKIP-GLDR↔FEECR] key='{key}' a({RowRef(a)} Dr={aDr:N2},Cr={aCr:N2}) b({RowRef(b)} Dr={bDr:N2},Cr={bCr:N2})&quot;);&#xA;            continue;&#xA;        }&#xA;&#xA;        dtHistoricalReconTransactionsReportMatched.ImportRow(a);&#xA;        dtHistoricalReconTransactionsReportMatched.ImportRow(b);&#xA;        rowsToRemove.Add(a);&#xA;        rowsToRemove.Add(b);&#xA;&#xA;        removedDr += aDr + bDr;&#xA;        removedCr += aCr + bCr;&#xA;        matchedPairs++;&#xA;&#xA;    }&#xA;}&#xA;&#xA;// ---- Remove matched rows from working table ----&#xA;int removedRows = 0;&#xA;foreach (var r in rowsToRemove)&#xA;{&#xA;    if (r != null &amp;&amp;&#xA;        r.Table == dtHistoricalReconTransactionsReport &amp;&amp;&#xA;        r.RowState != System.Data.DataRowState.Detached)&#xA;    {&#xA;        dtHistoricalReconTransactionsReport.Rows.Remove(r);&#xA;        removedRows++;&#xA;    }&#xA;}&#xA;System.Console.WriteLine($&quot;[INFO] Removed matched rows from working table: {removedRows}&quot;);&#xA;&#xA;// ---- Summary &amp; balance checks ----&#xA;decimal afterDr=0m, afterCr=0m;&#xA;SumDebitCredit(dtHistoricalReconTransactionsReport, effectiveDebitCol, effectiveCreditCol, out afterDr, out afterCr);&#xA;&#xA;System.Console.WriteLine();&#xA;System.Console.WriteLine(&quot;📝 Summary:&quot;);&#xA;System.Console.WriteLine($&quot;Matched pairs imported: {matchedPairs}&quot;);&#xA;System.Console.WriteLine($&quot;Removed Dr sum: {removedDr:N2} | Removed Cr sum: {removedCr:N2}&quot;);&#xA;System.Console.WriteLine();&#xA;System.Console.WriteLine(&quot;🔎 Balance check (Δ = Debit − Credit):&quot;);&#xA;System.Console.WriteLine($&quot;  BEFORE:  Dr {beforeDr:N2} | Cr {beforeCr:N2} | Δ_before = {(beforeDr-beforeCr):N2}&quot;);&#xA;System.Console.WriteLine($&quot;  REMOVED: Dr {removedDr:N2} | Cr {removedCr:N2} | Δ_removed = {(removedDr-removedCr):N2}&quot;);&#xA;System.Console.WriteLine($&quot;  AFTER:   Dr {afterDr:N2}  | Cr {afterCr:N2}  | Δ_after  = {(afterDr-afterCr):N2}&quot;);&#xA;&#xA;decimal lhs = (beforeDr - beforeCr);&#xA;decimal rhs = (afterDr - afterCr) + (removedDr - removedCr);&#xA;decimal gap = System.Math.Abs(lhs - rhs);&#xA;&#xA;if (gap &lt;= balanceTol)&#xA;    System.Console.WriteLine($&quot;✅ Consistency OK: Δ_before ≈ Δ_after + Δ_removed (gap={gap:N2} ≤ {balanceTol:N2}).&quot;);&#xA;else&#xA;    System.Console.WriteLine($&quot;⚠️ Consistency MISMATCH: gap={gap:N2} (&gt; {balanceTol:N2}).&quot;);&#xA;&#xA;System.Console.WriteLine();&#xA;System.Console.WriteLine(&quot;📦 Matched table totals (should be equal for exact single-sided pairs):&quot;);&#xA;decimal matchedDr=0m, matchedCr=0m;&#xA;SumDebitCredit(dtHistoricalReconTransactionsReportMatched, effectiveDebitCol, effectiveCreditCol, out matchedDr, out matchedCr);&#xA;System.Console.WriteLine($&quot;  Matched Debit ({currency}):  {matchedDr:N2}&quot;);&#xA;System.Console.WriteLine($&quot;  Matched Credit ({currency}): {matchedCr:N2}&quot;);&#xA;decimal matchedDelta = Round2(matchedCr - matchedDr);&#xA;if (matchedDelta == 0m)&#xA;    System.Console.WriteLine(&quot;✅ Matched totals are equal (Cr − Dr = 0.00).&quot;);&#xA;else&#xA;    System.Console.WriteLine($&quot;❗ Matched totals differ by {matchedDelta:N2} — investigate skipped dual-sided rows or key collisions.&quot;);&#xA;&#xA;// ================================================================================================&#xA;// PASS C: CBS Prepaid Card TOPUP  &lt;-&gt;  CMS Load/Reload      (key = CARD NUMBER | AMOUNT, no RRN)&#xA;// ------------------------------------------------------------------------------------------------&#xA;// Why this pass exists (permanent CBS behaviour):&#xA;//   CBS posts prepaid top-ups down two different paths, and the path decides whether PRTP is&#xA;//   stamped on &quot;Transaction Ref No:&quot;.&#xA;//     1) &quot;Premium Payment  Prepaid Card Top-up&quot; -&gt; ref carries 101PRTP..., narration carries&#xA;//        &quot;| C_PAN:... RRN:...&quot;.  Already matched by the PRTP/RRN passes above. NOT touched here.&#xA;//     2) &quot;Cash Withdrawal&quot; (OBTLR teller path)  -&gt; ref is a bare 16-digit number. No PRTP anywhere,&#xA;//        no RRN anywhere. These can never be keyed on RRN, so they are matched here on&#xA;//        Card Number + Amount only.&#xA;//   Discriminator: narration contains &quot;PREPAID CARD TOPUP&quot; AND ref does NOT contain &quot;PRTP&quot;.&#xA;//   Because the PRTP passes above require PRTP in the ref, this pass can never claim a row they&#xA;//   already handled - the two candidate sets are disjoint by construction.&#xA;//&#xA;//   &quot;Journal Posting-Miscellaneous&quot; rows also carry the top-up narration, but they are CBS-internal&#xA;//   contras that reverse a top-up rather than settle one. They are excluded explicitly.&#xA;//&#xA;// Sides: CBS top-up is Credit-only, CMS Load/Reload is Debit-only. Both are enforced, not assumed.&#xA;// ================================================================================================&#xA;&#xA;System.Text.RegularExpressions.Regex tuPanCbsRx = new System.Text.RegularExpressions.Regex(@&quot;PREPAID\s+CARD\s+TOPUP\s+Ref\s+(\d{6}[X\*]{4,12}\d{4})&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;System.Text.RegularExpressions.Regex tuPanCmsRx = new System.Text.RegularExpressions.Regex(@&quot;LOAD\s*/\s*RELOAD\s*-\s*(\d{6}[X\*]{4,12}\d{4})&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;System.Text.RegularExpressions.Regex tuPanBinRx = new System.Text.RegularExpressions.Regex(@&quot;(550558)[0-9Xx\*]{0,10}(\d{4})&quot;);&#xA;&#xA;string TuGet(System.Data.DataRow r, string col)&#xA;{&#xA;    if (!r.Table.Columns.Contains(col)) return &quot;&quot;;&#xA;    var v = r[col];&#xA;    return (v == null || v == DBNull.Value) ? &quot;&quot; : v.ToString();&#xA;}&#xA;&#xA;// Normalise any card token to FIRST6 + XXXXXX + LAST4 so masked and unmasked forms key identically.&#xA;string TuExtractPan(string narration)&#xA;{&#xA;    string s = narration ?? &quot;&quot;;&#xA;    var m = tuPanCbsRx.Match(s);&#xA;    if (m.Success) { string v = m.Groups[1].Value; return v.Substring(0, 6) + &quot;XXXXXX&quot; + v.Substring(v.Length - 4); }&#xA;    m = tuPanCmsRx.Match(s);&#xA;    if (m.Success) { string v = m.Groups[1].Value; return v.Substring(0, 6) + &quot;XXXXXX&quot; + v.Substring(v.Length - 4); }&#xA;    m = tuPanBinRx.Match(s.Replace(&quot; &quot;, &quot;&quot;));&#xA;    if (m.Success) return m.Groups[1].Value + &quot;XXXXXX&quot; + m.Groups[2].Value;&#xA;    return &quot;&quot;;&#xA;}&#xA;&#xA;bool TuIsCbsTopup(System.Data.DataRow r)&#xA;{&#xA;    string narr = TuGet(r, &quot;Narration&quot;);&#xA;    if (narr.Length == 0) return false;&#xA;    string up = narr.ToUpperInvariant();&#xA;    if (up.IndexOf(&quot;PREPAID CARD TOPUP&quot;, StringComparison.Ordinal) &lt; 0) return false;&#xA;    if (up.TrimStart().StartsWith(&quot;JOURNAL POSTING&quot;, StringComparison.Ordinal)) return false;&#xA;    // NOTE: previously excluded any ref containing &quot;PRTP&quot;, assuming the PRTP/RRN passes above&#xA;    // (Pass A/B) always claim those rows first. In practice many PRTP-ref GL rows carry no RRN&#xA;    // anywhere in their narration, so Pass A/B can&apos;t key them and they were falling through&#xA;    // unmatched. Pass C runs after Pass A/B and only sees rows A/B didn&apos;t already remove, so it&apos;s&#xA;    // safe to also pick up leftover PRTP rows here via PAN+Amount.&#xA;    return true;&#xA;}&#xA;&#xA;bool TuIsCmsLoadReload(System.Data.DataRow r)&#xA;{&#xA;    string narr = TuGet(r, &quot;Narration&quot;);&#xA;    if (narr.Length == 0) return false;&#xA;    return narr.ToUpperInvariant().Replace(&quot; &quot;, &quot;&quot;).StartsWith(&quot;LOAD/RELOAD&quot;, StringComparison.Ordinal);&#xA;}&#xA;&#xA;var tuCbsByKey = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;var tuCmsByKey = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;int tuCbsSeen = 0, tuCmsSeen = 0, tuCbsNoPan = 0, tuCmsNoPan = 0, tuCbsBadSide = 0, tuCmsBadSide = 0, tuBothSides = 0;&#xA;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    bool isCbs = TuIsCbsTopup(r);&#xA;    bool isCms = TuIsCmsLoadReload(r);&#xA;    if (isCbs &amp;&amp; isCms) { tuBothSides++; continue; }&#xA;    if (!isCbs &amp;&amp; !isCms) continue;&#xA;&#xA;    string pan = TuExtractPan(TuGet(r, &quot;Narration&quot;));&#xA;    decimal dr = effectiveDebitCol  != null ? Round2(ParseAmount(r[effectiveDebitCol]))  : 0m;&#xA;    decimal cr = effectiveCreditCol != null ? Round2(ParseAmount(r[effectiveCreditCol])) : 0m;&#xA;&#xA;    if (isCbs)&#xA;    {&#xA;        tuCbsSeen++;&#xA;        if (string.IsNullOrEmpty(pan)) { tuCbsNoPan++; continue; }&#xA;        if (!(cr &gt; 0m &amp;&amp; dr == 0m)) { tuCbsBadSide++; continue; }&#xA;        if (r.Table.Columns.Contains(&quot;C_PAN&quot;) &amp;&amp; string.IsNullOrWhiteSpace(TuGet(r, &quot;C_PAN&quot;))) r[&quot;C_PAN&quot;] = pan;&#xA;        string k = pan + &quot;|&quot; + cr.ToString(&quot;F2&quot;, invariant);&#xA;        System.Collections.Generic.List&lt;System.Data.DataRow&gt; l;&#xA;        if (!tuCbsByKey.TryGetValue(k, out l)) { l = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;(); tuCbsByKey[k] = l; }&#xA;        l.Add(r);&#xA;    }&#xA;    else&#xA;    {&#xA;        tuCmsSeen++;&#xA;        if (string.IsNullOrEmpty(pan)) { tuCmsNoPan++; continue; }&#xA;        if (!(dr &gt; 0m &amp;&amp; cr == 0m)) { tuCmsBadSide++; continue; }&#xA;        if (r.Table.Columns.Contains(&quot;C_PAN&quot;) &amp;&amp; string.IsNullOrWhiteSpace(TuGet(r, &quot;C_PAN&quot;))) r[&quot;C_PAN&quot;] = pan;&#xA;        string k = pan + &quot;|&quot; + dr.ToString(&quot;F2&quot;, invariant);&#xA;        System.Collections.Generic.List&lt;System.Data.DataRow&gt; l;&#xA;        if (!tuCmsByKey.TryGetValue(k, out l)) { l = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;(); tuCmsByKey[k] = l; }&#xA;        l.Add(r);&#xA;    }&#xA;}&#xA;&#xA;System.Console.WriteLine();&#xA;System.Console.WriteLine(&quot;[TOPUP] ===== Pass C: CBS Prepaid Card TOPUP &lt;-&gt; CMS Load/Reload (PAN|Amount) =====&quot;);&#xA;System.Console.WriteLine($&quot;[TOPUP] CBS candidates: seen={tuCbsSeen}, keys={tuCbsByKey.Count}, noPan={tuCbsNoPan}, wrongSide={tuCbsBadSide}&quot;);&#xA;System.Console.WriteLine($&quot;[TOPUP] CMS candidates: seen={tuCmsSeen}, keys={tuCmsByKey.Count}, noPan={tuCmsNoPan}, wrongSide={tuCmsBadSide}&quot;);&#xA;if (tuBothSides &gt; 0) System.Console.WriteLine($&quot;[TOPUP][WARN] {tuBothSides} row(s) matched BOTH side predicates and were skipped.&quot;);&#xA;&#xA;var tuRemove = new System.Collections.Generic.HashSet&lt;System.Data.DataRow&gt;();&#xA;int tuPairs = 0, tuMultiMismatch = 0;&#xA;decimal tuMatchedCr = 0m, tuMatchedDr = 0m;&#xA;&#xA;foreach (var kv in tuCbsByKey)&#xA;{&#xA;    System.Collections.Generic.List&lt;System.Data.DataRow&gt; cmsList;&#xA;    if (!tuCmsByKey.TryGetValue(kv.Key, out cmsList)) continue;&#xA;    var cbsList = kv.Value;&#xA;&#xA;    if (cbsList.Count != cmsList.Count)&#xA;    {&#xA;        tuMultiMismatch++;&#xA;        System.Console.WriteLine($&quot;[TOPUP][WARN] multiplicity mismatch key={kv.Key} CBS={cbsList.Count} CMS={cmsList.Count} -&gt; pairing {System.Math.Min(cbsList.Count, cmsList.Count)}&quot;);&#xA;    }&#xA;&#xA;    int n = System.Math.Min(cbsList.Count, cmsList.Count);&#xA;    for (int i = 0; i &lt; n; i++)&#xA;    {&#xA;        var a = cbsList[i];&#xA;        var b = cmsList[i];&#xA;        if (tuRemove.Contains(a) || tuRemove.Contains(b)) continue;&#xA;&#xA;        decimal aCr = effectiveCreditCol != null ? Round2(ParseAmount(a[effectiveCreditCol])) : 0m;&#xA;        decimal bDr = effectiveDebitCol  != null ? Round2(ParseAmount(b[effectiveDebitCol]))  : 0m;&#xA;        if (aCr &lt;= 0m || aCr != bDr)&#xA;        {&#xA;            System.Console.WriteLine($&quot;[TOPUP][SKIP] key={kv.Key} a({RowRef(a)} Cr={aCr:N2}) b({RowRef(b)} Dr={bDr:N2})&quot;);&#xA;            continue;&#xA;        }&#xA;&#xA;        a[&quot;Classification&quot;] = &quot;PRDPAGR&quot;;&#xA;        b[&quot;Classification&quot;] = &quot;PRDPAGR&quot;;&#xA;&#xA;        dtHistoricalReconTransactionsReportMatched.ImportRow(a);&#xA;        dtHistoricalReconTransactionsReportMatched.ImportRow(b);&#xA;        tuRemove.Add(a);&#xA;        tuRemove.Add(b);&#xA;        tuMatchedCr += aCr;&#xA;        tuMatchedDr += bDr;&#xA;        tuPairs++;&#xA;    }&#xA;}&#xA;&#xA;int tuRemoved = 0;&#xA;foreach (var r in tuRemove)&#xA;{&#xA;    if (r != null &amp;&amp; r.Table == dtHistoricalReconTransactionsReport &amp;&amp; r.RowState != System.Data.DataRowState.Detached)&#xA;    {&#xA;        dtHistoricalReconTransactionsReport.Rows.Remove(r);&#xA;        tuRemoved++;&#xA;    }&#xA;}&#xA;&#xA;int tuCbsLeft = 0, tuCmsLeft = 0;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    if (TuIsCbsTopup(r)) tuCbsLeft++;&#xA;    else if (TuIsCmsLoadReload(r)) tuCmsLeft++;&#xA;}&#xA;&#xA;System.Console.WriteLine($&quot;[TOPUP] Matched pairs: {tuPairs} | rows removed: {tuRemoved} | key multiplicity mismatches: {tuMultiMismatch}&quot;);&#xA;System.Console.WriteLine($&quot;[TOPUP] Matched amounts -&gt; CBS Cr {tuMatchedCr:N2} | CMS Dr {tuMatchedDr:N2} | delta {(tuMatchedCr - tuMatchedDr):N2}&quot;);&#xA;System.Console.WriteLine($&quot;[TOPUP] Left unmatched -&gt; CBS top-up rows: {tuCbsLeft} | CMS Load/Reload rows: {tuCmsLeft}&quot;);&#xA;if (Round2(tuMatchedCr - tuMatchedDr) != 0m)&#xA;    System.Console.WriteLine(&quot;[TOPUP][ERROR] Matched Cr and Dr totals differ - investigate before trusting this pass.&quot;);&#xA;else&#xA;    System.Console.WriteLine(&quot;[TOPUP] OK: matched Cr and Dr totals are equal.&quot;);&#xA;&#xA;" DisplayName="PRDP/AGR + Load/Reload" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_7" Language="CSharp">

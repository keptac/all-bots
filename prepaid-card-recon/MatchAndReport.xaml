        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: CMS classification using Narration =====&#xA;// Args (In/Out): dtHistoricalReconTransactionsReport (DataTable)&#xA;&#xA;//////////////// Helpers //////////////////&#xA;bool HasCol(System.Data.DataTable dt, string name) =&gt; dt != null &amp;&amp; dt.Columns.Contains(name);&#xA;&#xA;string GetStr(System.Data.DataRow r, string col)&#xA;{&#xA;    if (!HasCol(r.Table, col)) return &quot;&quot;;&#xA;    var v = r[col];&#xA;    return (v == null || v == System.DBNull.Value) ? &quot;&quot; : v.ToString();&#xA;}&#xA;&#xA;void EnsureTextCol(System.Data.DataTable dt, string name)&#xA;{&#xA;    if (!dt.Columns.Contains(name))&#xA;        dt.Columns.Add(new System.Data.DataColumn(name, typeof(string)) { DefaultValue = &quot;&quot; });&#xA;}&#xA;&#xA;// Normalize narration: lower + collapse spaces&#xA;string NormalizeNarr(string s)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(s)) return &quot;&quot;;&#xA;    return System.Text.RegularExpressions.Regex.Replace(s.Trim().ToLowerInvariant(), @&quot;\s+&quot;, &quot; &quot;);&#xA;}&#xA;&#xA;//////////////// Ensure output cols //////////////////&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;Root Cause&quot;);&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;Root Cause Category&quot;);&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;Recommended Action&quot;);&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;Action Owner&quot;);&#xA;&#xA;//////////////// Main //////////////////&#xA;int affected = 0;&#xA;&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    var source = GetStr(row, &quot;Source&quot;);&#xA;    var type   = GetStr(row, &quot;Type&quot;);&#xA;&#xA;    // Must be CMS + new&#xA;    if (!(source.Equals(&quot;CMS&quot;, System.StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;          type.Equals(&quot;new&quot;, System.StringComparison.OrdinalIgnoreCase)))&#xA;        continue;&#xA;&#xA;    // Channel gate: only skip if Channel exists AND equals &quot;API&quot;&#xA;    string channel = GetStr(row, &quot;Channel&quot;);&#xA;    if (!string.IsNullOrEmpty(channel) &amp;&amp; channel.Equals(&quot;API&quot;, System.StringComparison.OrdinalIgnoreCase))&#xA;        continue;&#xA;&#xA;    // Narration gate&#xA;    string narrationNorm = NormalizeNarr(GetStr(row, &quot;Narration&quot;));&#xA;    if (!(narrationNorm.StartsWith(&quot;cash withdrawal&quot;) ||&#xA;          narrationNorm.StartsWith(&quot;purchase/auth completion&quot;) ||&#xA;          narrationNorm.StartsWith(&quot;unique txn&quot;) ||&#xA;          narrationNorm.StartsWith(&quot;recurring transaction&quot;)))&#xA;        continue;&#xA;&#xA;    // ---- Apply new CMS template ----&#xA;    row[&quot;Root Cause&quot;] = &quot;Remote-on-us transaction not yet posted&quot;;&#xA;    row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;    row[&quot;Recommended Action&quot;] = &quot;Load pending auth dump files&quot;;&#xA;    row[&quot;Action Owner&quot;] = &quot;ICT&quot;;&#xA;    affected++;&#xA;}&#xA;&#xA;System.Console.WriteLine($&quot;✅ CMS Narration classification applied to {affected} rows (Source=CMS, Type=new, Narration match, Channel!=API).&quot;);&#xA;" DisplayName="Root Cause CMS" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_77" Language="CSharp">

        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Inputs:&#xA;// dtHistoricalReconTransactionsReport (System.Data.DataTable)&#xA;// dtHistoricalReconTransactionsReportMatched (System.Data.DataTable)&#xA;// string reconCurrency (e.g. &quot;USD&quot;, &quot;TZS&quot;)&#xA;&#xA;string creditCol = $&quot;Credit ({reconCurrency})&quot;;&#xA;string debitCol  = $&quot;Debit ({reconCurrency})&quot;;&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Narration&quot;))&#xA;    throw new Exception(&quot;Missing column: Narration&quot;);&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Booking Date&quot;))&#xA;    throw new Exception(&quot;Missing column: Booking Date&quot;);&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(creditCol))&#xA;    throw new Exception($&quot;Missing column: {creditCol}&quot;);&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(debitCol))&#xA;    throw new Exception($&quot;Missing column: {debitCol}&quot;);&#xA;&#xA;// ---- Balance helpers &amp; BEFORE totals ----&#xA;decimal TryParseDecimal(object val)&#xA;{&#xA;    if (val == null || val == System.DBNull.Value) return 0m;&#xA;    string s = val.ToString().Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;).Trim();&#xA;    return decimal.TryParse(s, out var result) ? result : 0m;&#xA;}&#xA;&#xA;void SumDebitCreditTable(System.Data.DataTable dt, out decimal dSum, out decimal cSum)&#xA;{&#xA;    dSum = 0m; cSum = 0m;&#xA;    for (int i = 0; i &lt; dt.Rows.Count; i++)&#xA;    {&#xA;        var r = dt.Rows[i];&#xA;        dSum += TryParseDecimal(r[debitCol]);&#xA;        cSum += TryParseDecimal(r[creditCol]);&#xA;    }&#xA;}&#xA;void SumDebitCreditRows(System.Collections.Generic.IEnumerable&lt;System.Data.DataRow&gt; rows, out decimal dSum, out decimal cSum)&#xA;{&#xA;    dSum = 0m; cSum = 0m;&#xA;    foreach (var r in rows)&#xA;    {&#xA;        dSum += TryParseDecimal(r[debitCol]);&#xA;        cSum += TryParseDecimal(r[creditCol]);&#xA;    }&#xA;}&#xA;&#xA;decimal beforeDebit = 0m, beforeCredit = 0m;&#xA;SumDebitCreditTable(dtHistoricalReconTransactionsReport, out beforeDebit, out beforeCredit);&#xA;decimal beforeDiff = beforeDebit - beforeCredit;&#xA;decimal balanceTol = 0.01m;&#xA;&#xA;System.Console.WriteLine($&quot;[BAL] BEFORE — Debit ({reconCurrency}): {beforeDebit:N2}, Credit ({reconCurrency}): {beforeCredit:N2}, Δ(D−C): {beforeDiff:N2}&quot;);&#xA;&#xA;var feeDirectionMap = new System.Collections.Generic.Dictionary&lt;string, bool&gt;(System.StringComparer.OrdinalIgnoreCase)&#xA;{&#xA;    [&quot;CARD FEES&quot;] = true,&#xA;    [&quot;CASH ADVANCE/ CASH AT POS / CASH OUT TRANSACTION FEE&quot;] = true,&#xA;    [&quot;PURCHASE/AUTH COMPLETION TRANSACTION FEE&quot;] = true,&#xA;    [&quot;CASH WITHDRAWAL TRANSACTION FEE&quot;] = true,&#xA;    [&quot;BALANCE INQUIRY TRANSACTION FEE&quot;] = true,&#xA;    [&quot;RECURRING TRANSACTION TRANSACTION FEE&quot;] = true,&#xA;    [&quot;MINI STATEMENT TRANSACTION FEE&quot;] = true,&#xA;    [&quot;SERVICE TAX/TAX ON INCOME&quot;] = true&#xA;};&#xA;&#xA;var dateRangeRegex = new System.Text.RegularExpressions.Regex(@&quot;(\d{6})\s*(?:[Tt][Oo]|-|\/)?\s*(\d{6})&quot;);&#xA;string[] allowedFormats = { &quot;MM/dd/yyyy HH:mm:ss&quot;, &quot;dd-MMM-yyyy&quot;, &quot;M/d/yyyy&quot; };&#xA;&#xA;// === Step 1: Convert string dates (if needed) ===&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    foreach (string col in new[] { &quot;Booking Date&quot;, &quot;Value Date&quot; })&#xA;    {&#xA;        if (!dtHistoricalReconTransactionsReport.Columns.Contains(col)) continue;&#xA;&#xA;        var val = row[col];&#xA;        if (val == null || val == System.DBNull.Value) continue;&#xA;&#xA;        if (val is string s)&#xA;        {&#xA;            s = s.Trim();&#xA;            if (System.DateTime.TryParseExact(s, allowedFormats, null, System.Globalization.DateTimeStyles.None, out var parsed))&#xA;            {&#xA;                row[col] = parsed;&#xA;            }&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Helper Functions ===&#xA;System.DateTime ParseBookingDate(object value)&#xA;{&#xA;    if (value == null || value == System.DBNull.Value) return System.DateTime.MinValue;&#xA;    if (value is System.DateTime dt) return dt;&#xA;&#xA;    string str = value.ToString().Trim();&#xA;    if (System.DateTime.TryParseExact(str, allowedFormats, null, System.Globalization.DateTimeStyles.None, out var parsed))&#xA;        return parsed;&#xA;&#xA;    if (System.DateTime.TryParse(str, out parsed)) return parsed;&#xA;&#xA;    return System.DateTime.MinValue;&#xA;}&#xA;&#xA;System.DateTime ParseCompactDate(string val)&#xA;{&#xA;    return System.DateTime.TryParseExact(val, &quot;ddMMyy&quot;, null, System.Globalization.DateTimeStyles.None, out var parsed)&#xA;        ? parsed&#xA;        : System.DateTime.MinValue;&#xA;}&#xA;&#xA;// === Step 3: Narration Matching Logic (Exact totals only) ===&#xA;System.Console.WriteLine(&quot;===== GL Narration Matching Against Historical Totals (Exact Match) =====&quot;);&#xA;&#xA;var glCandidates = dtHistoricalReconTransactionsReport.AsEnumerable().ToList();&#xA;var rowsToRemove = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;bool anyMatches = false;&#xA;&#xA;foreach (System.Data.DataRow row in glCandidates)&#xA;{&#xA;    string narration = row[&quot;Narration&quot;]?.ToString()?.Trim() ?? &quot;&quot;;&#xA;    string narrationUpper = narration.ToUpperInvariant();&#xA;    if (!narrationUpper.Contains(&quot;JOURNAL&quot;)) continue;&#xA;&#xA;    var match = dateRangeRegex.Match(narrationUpper);&#xA;    if (!match.Success) continue;&#xA;&#xA;    System.DateTime fromDate = ParseCompactDate(match.Groups[1].Value);&#xA;    System.DateTime toDate   = ParseCompactDate(match.Groups[2].Value);&#xA;    if (fromDate == System.DateTime.MinValue || toDate == System.DateTime.MinValue) continue;&#xA;&#xA;    var rule = feeDirectionMap.Keys.FirstOrDefault(k =&gt; narrationUpper.Contains(k.ToUpperInvariant()));&#xA;    if (string.IsNullOrEmpty(rule)) continue;&#xA;&#xA;    bool useCredit = feeDirectionMap[rule];&#xA;    string amountCol = useCredit ? creditCol : debitCol;&#xA;&#xA;    // If GL row has zero in both amount columns, skip&#xA;    decimal glAmount = TryParseDecimal(row[useCredit ? creditCol : debitCol]);&#xA;    if (glAmount == 0m) continue;&#xA;&#xA;    // Collect matching historical rows (exclude the GL &quot;JOURNAL&quot; row itself)&#xA;    var matchedRows = dtHistoricalReconTransactionsReport.AsEnumerable()&#xA;        .Where(r =&gt;&#xA;        {&#xA;            if (object.ReferenceEquals(r, row)) return false; // exclude the GL row itself&#xA;            string histNarr = r[&quot;Narration&quot;]?.ToString()?.Trim().ToUpperInvariant() ?? &quot;&quot;;&#xA;            if (histNarr.Contains(&quot;JOURNAL&quot;)) return false;   // exclude other summary/journal lines&#xA;            System.DateTime bookDate = ParseBookingDate(r[&quot;Booking Date&quot;]);&#xA;            return histNarr.Contains(rule.ToUpperInvariant()) &amp;&amp; bookDate &gt;= fromDate &amp;&amp; bookDate &lt;= toDate;&#xA;        })&#xA;        .ToList();&#xA;&#xA;    decimal matchedTotal = matchedRows.Sum(r =&gt; TryParseDecimal(r[amountCol]));&#xA;&#xA;    System.Console.WriteLine($&quot;🧾 NARRATION: {narration}&quot;);&#xA;    System.Console.WriteLine($&quot;📅 RANGE: {fromDate:dd-MMM-yyyy} to {toDate:dd-MMM-yyyy}&quot;);&#xA;    System.Console.WriteLine($&quot;💳 GL Amount ({(useCredit ? &quot;Credit&quot; : &quot;Debit&quot;)}): {glAmount:N2}&quot;);&#xA;    System.Console.WriteLine($&quot;📊 Matched {rule} Total: {matchedTotal:N2}&quot;);&#xA;&#xA;    // === Exact match required ===&#xA;    if (glAmount == matchedTotal)&#xA;    {&#xA;        System.Console.WriteLine(&quot;✅ MATCH – Totals match exactly. Moving rows to matched table.&quot;);&#xA;        anyMatches = true;&#xA;&#xA;        // Move the GL row&#xA;        dtHistoricalReconTransactionsReportMatched.ImportRow(row);&#xA;        rowsToRemove.Add(row);&#xA;&#xA;        // Move all contributing rows&#xA;        foreach (var histRow in matchedRows)&#xA;        {&#xA;            dtHistoricalReconTransactionsReportMatched.ImportRow(histRow);&#xA;            rowsToRemove.Add(histRow);&#xA;        }&#xA;    }&#xA;    else&#xA;    {&#xA;        System.Console.WriteLine($&quot;❌ MISMATCH – Difference: {(glAmount - matchedTotal):N2}. Totals do not match exactly.&quot;);&#xA;    }&#xA;&#xA;    System.Console.WriteLine(&quot;----------------------------------------------------&quot;);&#xA;}&#xA;&#xA;// === Step 4: Remove matched rows from source ===&#xA;// Compute REMOVED totals before removing&#xA;var rowsToRemoveDistinct = rowsToRemove.Distinct().ToList();&#xA;decimal removedDebit = 0m, removedCredit = 0m;&#xA;SumDebitCreditRows(rowsToRemoveDistinct, out removedDebit, out removedCredit);&#xA;&#xA;foreach (var r in rowsToRemoveDistinct)&#xA;{&#xA;    if (r.Table == dtHistoricalReconTransactionsReport &amp;&amp; r.RowState != System.Data.DataRowState.Detached)&#xA;        dtHistoricalReconTransactionsReport.Rows.Remove(r);&#xA;}&#xA;&#xA;System.Console.WriteLine(anyMatches&#xA;    ? &quot;✅ Matching completed. One or more groups were matched.&quot;&#xA;    : &quot;❌ No matching groups were found in the dataset (exact totals required).&quot;);&#xA;&#xA;// ---- AFTER totals + Δ identity check ----&#xA;decimal afterDebit = 0m, afterCredit = 0m;&#xA;SumDebitCreditTable(dtHistoricalReconTransactionsReport, out afterDebit, out afterCredit);&#xA;decimal afterDiff = afterDebit - afterCredit;&#xA;&#xA;decimal removedDiff = removedDebit - removedCredit;&#xA;decimal lhs = beforeDiff;&#xA;decimal rhs = afterDiff + removedDiff;&#xA;decimal gap = System.Math.Abs(lhs - rhs);&#xA;&#xA;System.Console.WriteLine();&#xA;System.Console.WriteLine(&quot;🔎 Balance check (Δ = Debit − Credit):&quot;);&#xA;System.Console.WriteLine($&quot;  BEFORE:  Debit {beforeDebit:N2}  | Credit {beforeCredit:N2}  | Δ_before = {beforeDiff:N2}&quot;);&#xA;System.Console.WriteLine($&quot;  REMOVED: Debit {removedDebit:N2} | Credit {removedCredit:N2} | Δ_removed = {removedDiff:N2}&quot;);&#xA;System.Console.WriteLine($&quot;  AFTER:   Debit {afterDebit:N2}  | Credit {afterCredit:N2}  | Δ_after  = {afterDiff:N2}&quot;);&#xA;&#xA;if (gap &lt;= balanceTol)&#xA;{&#xA;    System.Console.WriteLine($&quot;✅ Consistency OK: Δ_before ({lhs:N2}) ≈ Δ_after + Δ_removed ({rhs:N2}) within ±{balanceTol:N2}.&quot;);&#xA;}&#xA;else&#xA;{&#xA;    System.Console.WriteLine($&quot;⚠️ Consistency MISMATCH: Δ_before ({lhs:N2}) vs (Δ_after + Δ_removed) ({rhs:N2}); gap = {gap:N2} (&gt; ±{balanceTol:N2}).&quot;);&#xA;    System.Console.WriteLine(&quot;   Tip: check date parsing, duplicate inclusions, or unexpected narration tokens within the range.&quot;);&#xA;}&#xA;" DisplayName=" REMOVE GL Date Range VS Fees/Income" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_23" Language="CSharp">

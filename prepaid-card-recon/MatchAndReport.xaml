        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: Build &quot;PPAT&quot; sheet from matched rows (Option 2) =====&#xA;// Args (In): dtHistoricalReconTransactionsReportMatched (DataTable), prepaidCardWorkingsFileName (string)&#xA;&#xA;int agwRowCount = 0;&#xA;&#xA;// --- Small helper: safe date parse to DateTime? ---&#xA;System.DateTime? TryParseDate(object v)&#xA;{&#xA;    if (v == null || v == System.DBNull.Value) return null;&#xA;    var s = v.ToString().Trim();&#xA;    if (string.IsNullOrEmpty(s)) return null;&#xA;&#xA;    // Try strict formats first, then a general parse as a fallback.&#xA;    var formats = new[] { &quot;dd/MM/yyyy HH:mm:ss&quot;, &quot;dd/MM/yyyy HH:mm&quot;, &quot;dd/MM/yyyy&quot; };&#xA;    if (System.DateTime.TryParseExact(s, formats, System.Globalization.CultureInfo.InvariantCulture,&#xA;                                      System.Globalization.DateTimeStyles.None, out var dt)) return dt;&#xA;    if (System.DateTime.TryParse(s, out dt)) return dt;&#xA;&#xA;    // If it's already a DateTime or OADate double&#xA;    if (v is System.DateTime dtObj) return dtObj;&#xA;    if (double.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var oa))&#xA;    {&#xA;        try { return System.DateTime.FromOADate(oa); } catch { }&#xA;    }&#xA;    return null;&#xA;}&#xA;&#xA;if (sharedWorkingsPackage == null)&#xA;{&#xA;    sharedWorkingsPackage = new OfficeOpenXml.ExcelPackage(new System.IO.FileInfo(prepaidCardWorkingsFileName));&#xA;    sharedWorkingsPackage.Workbook.CalcMode = OfficeOpenXml.ExcelCalcMode.Manual;&#xA;}&#xA;var package = sharedWorkingsPackage;&#xA;{&#xA;    // --- Ensure/replace &quot;PPAT&quot; worksheet ---&#xA;    var wsRaw = package.Workbook.Worksheets&#xA;        .FirstOrDefault(w =&gt; w.Name != null &amp;&amp; w.Name.Trim().Equals(&quot;PPAT&quot;, System.StringComparison.OrdinalIgnoreCase));&#xA;    if (wsRaw != null)&#xA;    {&#xA;        Console.WriteLine(&quot;ℹ️ Found existing 'PPAT' sheet — deleting it.&quot;);&#xA;        package.Workbook.Worksheets.Delete(wsRaw);&#xA;    }&#xA;    wsRaw = package.Workbook.Worksheets.Add(&quot;PPAT&quot;);&#xA;    Console.WriteLine(&quot;✅ Created new 'PPAT' worksheet.&quot;);&#xA;&#xA;    // --- Filter rows: Classification == &quot;PPAT&quot; (trim + case-insensitive) ---&#xA;    var matchedAgwRows = dtHistoricalReconTransactionsReportMatched&#xA;        .AsEnumerable()&#xA;        .Where(r =&gt;&#xA;        {&#xA;            var cls = r.Table.Columns.Contains(&quot;Classification&quot;)&#xA;                ? (r[&quot;Classification&quot;]?.ToString() ?? &quot;&quot;)&#xA;                : &quot;&quot;;&#xA;            return cls.Trim().Equals(&quot;PPAT&quot;, System.StringComparison.OrdinalIgnoreCase);&#xA;        })&#xA;        .ToList();&#xA;&#xA;    agwRowCount = matchedAgwRows.Count;&#xA;    Console.WriteLine($&quot;🔍 Found {agwRowCount:N0} rows classified as 'PPAT'.&quot;);&#xA;&#xA;    int totalCols = dtHistoricalReconTransactionsReportMatched.Columns.Count;&#xA;&#xA;    // --- Write headers (row 1) ---&#xA;    for (int c = 0; c &lt; totalCols; c++)&#xA;        wsRaw.Cells[1, c + 1].Value = dtHistoricalReconTransactionsReportMatched.Columns[c].ColumnName;&#xA;    Console.WriteLine(&quot;📝 Headers written.&quot;);&#xA;&#xA;    // --- Speed: turn off calc while we bulk-write ---&#xA;    package.Workbook.CalcMode = OfficeOpenXml.ExcelCalcMode.Manual;&#xA;&#xA;    if (agwRowCount &gt; 0)&#xA;    {&#xA;        Console.WriteLine(&quot;⬇️ Writing row data to Excel...&quot;);&#xA;&#xA;        int bookingColIdx = dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Booking Date&quot;)&#xA;            ? dtHistoricalReconTransactionsReportMatched.Columns[&quot;Booking Date&quot;].Ordinal&#xA;            : -1;&#xA;        int valueColIdx = dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Value Date&quot;)&#xA;            ? dtHistoricalReconTransactionsReportMatched.Columns[&quot;Value Date&quot;].Ordinal&#xA;            : -1;&#xA;&#xA;        var values = new object[agwRowCount, totalCols];&#xA;&#xA;        for (int r = 0; r &lt; agwRowCount; r++)&#xA;        {&#xA;            var src = matchedAgwRows[r];&#xA;&#xA;            for (int c = 0; c &lt; totalCols; c++)&#xA;            {&#xA;                var raw = src[c];&#xA;&#xA;                if (c == bookingColIdx || c == valueColIdx)&#xA;                {&#xA;                    var d = TryParseDate(raw);&#xA;                    values[r, c] = d.HasValue ? (object)d.Value : (raw == System.DBNull.Value ? &quot;&quot; : raw);&#xA;                }&#xA;                else&#xA;                {&#xA;                    values[r, c] = raw == System.DBNull.Value ? &quot;&quot; : raw;&#xA;                }&#xA;            }&#xA;        }&#xA;&#xA;        wsRaw.Cells[2, 1, agwRowCount + 1, totalCols].Value = values;&#xA;        Console.WriteLine($&quot;✅ Wrote {agwRowCount:N0} rows into sheet.&quot;);&#xA;&#xA;        if (bookingColIdx &gt;= 0)&#xA;        {&#xA;            int excelCol = bookingColIdx + 1;&#xA;            wsRaw.Cells[2, excelCol, agwRowCount + 1, excelCol].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;            Console.WriteLine(&quot;📅 Applied date formatting to 'Booking Date'.&quot;);&#xA;        }&#xA;        if (valueColIdx &gt;= 0)&#xA;        {&#xA;            int excelCol = valueColIdx + 1;&#xA;            wsRaw.Cells[2, excelCol, agwRowCount + 1, excelCol].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;            Console.WriteLine(&quot;📅 Applied date formatting to 'Value Date'.&quot;);&#xA;        }&#xA;    }&#xA;    else&#xA;    {&#xA;        Console.WriteLine(&quot;⚠️ No PPAT rows found. Sheet will contain only headers.&quot;);&#xA;    }&#xA;&#xA;    wsRaw.View.FreezePanes(2, 1);&#xA;    wsRaw.Cells[1, 1, 1, totalCols].Style.Font.Bold = true;&#xA;&#xA;}&#xA;&#xA;// Final summary log&#xA;Console.WriteLine($&quot;✅ PPAT sheet built with {agwRowCount:N0} rows (save deferred to end of pipeline).&quot;);&#xA;" DisplayName="Write PPAT" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_87" Language="CSharp">

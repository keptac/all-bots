        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: PPSP-only classification via Transaction Ref No: (GL/new) [HARD-LOCKED COL] =====&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport&#xA;&#xA;/////////////////////// Helpers (names are prefixed to avoid collisions) ///////////////////////&#xA;&#xA;void PPSP_EnsureColumn(System.Data.DataTable dt, string name)&#xA;{&#xA;    if (!dt.Columns.Contains(name))&#xA;        dt.Columns.Add(new System.Data.DataColumn(name, typeof(string)) { DefaultValue = &quot;&quot; });&#xA;}&#xA;&#xA;string PPSP_GetStr(System.Data.DataRow r, string col)&#xA;{&#xA;    if (!r.Table.Columns.Contains(col)) return &quot;&quot;;&#xA;    var v = r[col];&#xA;    return (v == null || v == System.DBNull.Value) ? &quot;&quot; : v.ToString();&#xA;}&#xA;&#xA;bool PPSP_IsEmpty(string s) =&gt; string.IsNullOrWhiteSpace(s);&#xA;&#xA;bool PPSP_ClassificationLooksPPS(string s)&#xA;{&#xA;    if (PPSP_IsEmpty(s)) return true; // allow empty if Ref says PPSP&#xA;    s = s.Trim().ToUpperInvariant();&#xA;    // Accept &quot;PPS&quot; or &quot;PPSP&quot; (covers most of your PPS buckets)&#xA;    return s == &quot;PPS&quot; || s == &quot;PPSP&quot;;&#xA;}&#xA;&#xA;bool PPSP_IsGLNew(System.Data.DataRow r)&#xA;{&#xA;    var hasSource = r.Table.Columns.Contains(&quot;Source&quot;);&#xA;    var hasType   = r.Table.Columns.Contains(&quot;Type&quot;);&#xA;    if (!hasSource || !hasType) return false; // strict: require both to assert GL/new&#xA;    var src  = PPSP_GetStr(r, &quot;Source&quot;);&#xA;    var typ  = PPSP_GetStr(r, &quot;Type&quot;);&#xA;    return src.Equals(&quot;GL&quot;, System.StringComparison.OrdinalIgnoreCase)&#xA;        &amp;&amp; typ.Equals(&quot;new&quot;, System.StringComparison.OrdinalIgnoreCase);&#xA;}&#xA;&#xA;void PPSP_SetTemplate(System.Data.DataRow row)&#xA;{&#xA;    // Only set if empty to avoid overwriting prior decisions&#xA;    if (PPSP_IsEmpty(PPSP_GetStr(row, &quot;Root Cause&quot;)))&#xA;        row[&quot;Root Cause&quot;] = &quot;Auth dump posted transactions not matched against outstanding remote-on-us txns&quot;;&#xA;    if (PPSP_IsEmpty(PPSP_GetStr(row, &quot;Root Cause Category&quot;)))&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;    if (PPSP_IsEmpty(PPSP_GetStr(row, &quot;Recommended Action&quot;)))&#xA;        row[&quot;Recommended Action&quot;] = &quot;Under investigation&quot;;&#xA;    if (PPSP_IsEmpty(PPSP_GetStr(row, &quot;Action Owner&quot;)))&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Reconciliation&quot;;&#xA;}&#xA;&#xA;/////////////////////// Setup ///////////////////////&#xA;&#xA;// Ensure output columns exist (no renames)&#xA;PPSP_EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Root Cause&quot;);&#xA;PPSP_EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Root Cause Category&quot;);&#xA;PPSP_EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Recommended Action&quot;);&#xA;PPSP_EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Action Owner&quot;);&#xA;&#xA;// NEW: ensure ROOT_CAUSE_PROCESSED flag exists&#xA;PPSP_EnsureColumn(dtHistoricalReconTransactionsReport, &quot;ROOT_CAUSE_PROCESSED&quot;);&#xA;&#xA;// HARD-LOCKED column name per your instruction&#xA;const string txnRefCol = &quot;Transaction Ref No:&quot;;&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(txnRefCol))&#xA;{&#xA;    System.Console.WriteLine($&quot;⚠️ Column '{txnRefCol}' not found — PPSP classification skipped.&quot;);&#xA;    return;&#xA;}&#xA;&#xA;/////////////////////// Main ///////////////////////&#xA;&#xA;int totalRefPPSP = 0;            // rows whose Transaction Ref contains &quot;PPSP&quot;&#xA;int totalRefPPSP_GLnew = 0;      // of those, GL/new rows&#xA;int setCount = 0;                 // actually applied the template&#xA;&#xA;int skippedAlreadyProcessed = 0; // ROOT_CAUSE_PROCESSED already TRUE&#xA;int skippedSourceType = 0;       // not GL/new (or missing Source/Type)&#xA;int skippedNonPPSClass = 0;      // Classification not in {empty,PPS,PPSP}&#xA;int skippedAlreadyFilled = 0;    // all four fields already non-empty&#xA;&#xA;int sampleLimit = 5;&#xA;var sampleSkippedSourceType = new System.Collections.Generic.List&lt;string&gt;();&#xA;var sampleSkippedNonPPSClass = new System.Collections.Generic.List&lt;string&gt;();&#xA;var sampleAlreadyFilled      = new System.Collections.Generic.List&lt;string&gt;();&#xA;&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    // 🔥 SKIP COMPLETELY IF ALREADY PROCESSED ANYWHERE&#xA;    string processedFlag = PPSP_GetStr(row, &quot;ROOT_CAUSE_PROCESSED&quot;);&#xA;    if (processedFlag.Equals(&quot;TRUE&quot;, System.StringComparison.OrdinalIgnoreCase))&#xA;    {&#xA;        skippedAlreadyProcessed++;&#xA;        continue;&#xA;    }&#xA;&#xA;    string txnRef = PPSP_GetStr(row, txnRefCol);&#xA;    if (PPSP_IsEmpty(txnRef)) continue;&#xA;&#xA;    // PPSP-only via Transaction Ref&#xA;    bool hasPPSP = txnRef.IndexOf(&quot;PPSP&quot;, System.StringComparison.OrdinalIgnoreCase) &gt;= 0 || txnRef.IndexOf(&quot;ADPP&quot;, System.StringComparison.OrdinalIgnoreCase) &gt;= 0;&#xA;    if (!hasPPSP) continue;&#xA;&#xA;    totalRefPPSP++;&#xA;&#xA;    // Enforce GL/new if columns exist&#xA;    bool isGLnew = PPSP_IsGLNew(row);&#xA;    if (!isGLnew)&#xA;    {&#xA;        skippedSourceType++;&#xA;        if (sampleSkippedSourceType.Count &lt; sampleLimit)&#xA;            sampleSkippedSourceType.Add($&quot;Ref={txnRef}, Source={PPSP_GetStr(row, &quot;Source&quot;)}, Type={PPSP_GetStr(row, &quot;Type&quot;)}&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    totalRefPPSP_GLnew++;&#xA;&#xA;    // Classification gate: accept (empty, PPS, PPSP)&#xA;    string classification = PPSP_GetStr(row, &quot;Classification&quot;);&#xA;    if (!PPSP_ClassificationLooksPPS(classification))&#xA;    {&#xA;        skippedNonPPSClass++;&#xA;        if (sampleSkippedNonPPSClass.Count &lt; sampleLimit)&#xA;            sampleSkippedNonPPSClass.Add($&quot;Ref={txnRef}, Classification='{classification}'&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    // Only apply if at least one of the four is empty&#xA;    bool alreadyHasAll =&#xA;        !PPSP_IsEmpty(PPSP_GetStr(row, &quot;Root Cause&quot;)) &amp;&amp;&#xA;        !PPSP_IsEmpty(PPSP_GetStr(row, &quot;Root Cause Category&quot;)) &amp;&amp;&#xA;        !PPSP_IsEmpty(PPSP_GetStr(row, &quot;Recommended Action&quot;)) &amp;&amp;&#xA;        !PPSP_IsEmpty(PPSP_GetStr(row, &quot;Action Owner&quot;));&#xA;&#xA;    if (alreadyHasAll)&#xA;    {&#xA;        skippedAlreadyFilled++;&#xA;        if (sampleAlreadyFilled.Count &lt; sampleLimit)&#xA;            sampleAlreadyFilled.Add($&quot;Ref={txnRef}&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    // Apply PPSP template&#xA;    PPSP_SetTemplate(row);&#xA;&#xA;    // Mark as processed so all other modules can skip&#xA;    row[&quot;ROOT_CAUSE_PROCESSED&quot;] = &quot;TRUE&quot;;&#xA;&#xA;    setCount++;&#xA;}&#xA;&#xA;/////////////////////// Logs ///////////////////////&#xA;&#xA;System.Console.WriteLine($&quot;📊 Total rows with '{txnRefCol}' containing 'PPSP': {totalRefPPSP:N0}&quot;);&#xA;System.Console.WriteLine($&quot;📦 Of these, GL/new rows: {totalRefPPSP_GLnew:N0}&quot;);&#xA;System.Console.WriteLine($&quot;✅ PPSP template set on {setCount:N0} GL/new rows (Classification in {{empty,PPS,PPSP}}).&quot;);&#xA;System.Console.WriteLine($&quot;🛑 Skipped (already ROOT_CAUSE_PROCESSED=TRUE): {skippedAlreadyProcessed:N0}&quot;);&#xA;&#xA;// Skips (with small samples)&#xA;System.Console.WriteLine($&quot;⛔ Skipped (not GL/new or missing Source/Type): {skippedSourceType:N0}&quot;);&#xA;for (int i = 0; i &lt; sampleSkippedSourceType.Count; i++)&#xA;    System.Console.WriteLine($&quot;   - {sampleSkippedSourceType[i]}&quot;);&#xA;&#xA;System.Console.WriteLine($&quot;⛔ Skipped (Classification not PPS/PPSP): {skippedNonPPSClass:N0}&quot;);&#xA;for (int 
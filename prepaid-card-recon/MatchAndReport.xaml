              <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: Insert Foreign-Currency CMS rows into HIST (strict, LINQ-free) ====&#xA;// Args (In):      string reconCurrency&#xA;// Args (In/Out):  DataTable dtHistoricalReconTransactionsReport, DataTable dtTransactionReportForeignCurrencyTZS&#xA;&#xA;// ---------------------------&#xA;// Basic helpers&#xA;// ---------------------------&#xA;DateTime? ParseDate_Fallback(object obj)&#xA;{&#xA;    if (obj == null || obj == DBNull.Value) return null;&#xA;    var s = obj.ToString().Trim();&#xA;    if (string.IsNullOrEmpty(s)) return null;&#xA;    DateTime any;&#xA;    return DateTime.TryParse(s, out any) ? (DateTime?)any : null;&#xA;}&#xA;&#xA;decimal SafeParseAmount(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return 0m;&#xA;    string s = val.ToString().Trim();&#xA;    if (string.IsNullOrEmpty(s)) return 0m;&#xA;    bool neg = s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;);&#xA;    s = s.Replace(&quot;(&quot;, &quot;&quot;).Replace(&quot;)&quot;, &quot;&quot;).Replace(&quot;,&quot;, &quot;&quot;);&#xA;    decimal d;&#xA;    if (!decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out d))&#xA;        decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.CurrentCulture, out d);&#xA;    return neg ? -Math.Abs(d) : d;&#xA;}&#xA;&#xA;string SafeStr(object v) { return v == null || v == DBNull.Value ? string.Empty : v.ToString().Trim(); }&#xA;&#xA;void EnsureColumns(DataTable dt, string[] cols, string currency)&#xA;{&#xA;    for (int i = 0; i &lt; cols.Length; i++)&#xA;    {&#xA;        string col = cols[i];&#xA;        if (!dt.Columns.Contains(col))&#xA;        {&#xA;            Type type =&#xA;                (col.IndexOf(&quot;Date&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0) ? typeof(DateTime) :&#xA;                (col == (&quot;Debit (&quot; + currency + &quot;)&quot;) || col == (&quot;Credit (&quot; + currency + &quot;)&quot;)) ? typeof(decimal) :&#xA;                (col == &quot;FOREIGN_CURRENCY&quot;) ? typeof(bool) :&#xA;                typeof(string);&#xA;            dt.Columns.Add(col, type);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;string KeepLast12Chars(string raw)&#xA;{&#xA;    string s = SafeStr(raw);&#xA;    if (s.Length &lt;= 12) return s;&#xA;    return s.Substring(s.Length - 12);&#xA;}&#xA;&#xA;// ---------------------------&#xA;// Required columns&#xA;// ---------------------------&#xA;string[] baseCols = new string[] {&#xA;    &quot;SNO&quot;, &quot;Branch code&quot;, &quot;GL_Code&quot;, &quot;GL Description&quot;,&#xA;    &quot;Booking Date&quot;, &quot;Value Date&quot;, &quot;Transaction Ref No:&quot;,&#xA;    &quot;C_PAN&quot;, &quot;RRN&quot;, &quot;STAN&quot;, &quot;FLEXREF&quot;, &quot;Narration&quot;,&#xA;    &quot;Source&quot;, &quot;Type&quot;, &quot;Root Cause&quot;, &quot;Root Cause Category&quot;,&#xA;    &quot;Recommended Action&quot;, &quot;Action Owner&quot;, &quot;Aging&quot;, &quot;Aging Group&quot;,&#xA;    &quot;BOT Classification&quot;, &quot;AUTH&quot;, &quot;Transaction Type&quot;, &quot;Transaction Date&quot;,&#xA;    &quot;Billing Amount&quot;, &quot;Device Number&quot;, &quot;ARN&quot;, &quot;Channel&quot;, &quot;Classification&quot;,&#xA;    // needed by CMS/CMD classifier:&#xA;    &quot;FOREIGN_CURRENCY&quot;,&#xA;    &quot;Billing Currency&quot;, &quot;Transaction Currency&quot;, &quot;Transaction Amount&quot;,&#xA;    &quot;Settlement Currency&quot;, &quot;Settlement Amount&quot;&#xA;};&#xA;string debitCol = &quot;Debit (&quot; + reconCurrency + &quot;)&quot;;&#xA;string creditCol = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xA;string[] addCols = new string[] { debitCol, creditCol };&#xA;&#xA;string[] histCols = new string[baseCols.Length + addCols.Length];&#xA;for (int i = 0; i &lt; baseCols.Length; i++) histCols[i] = baseCols[i];&#xA;for (int i = 0; i &lt; addCols.Length; i++) histCols[baseCols.Length + i] = addCols[i];&#xA;&#xA;EnsureColumns(dtHistoricalReconTransactionsReport, histCols, reconCurrency);&#xA;EnsureColumns(dtTransactionReportForeignCurrencyTZS, histCols, reconCurrency);&#xA;&#xA;// ---------------------------&#xA;// Strict date formats (CMS + HIST)&#xA;// ---------------------------&#xA;string[] CMS_DATE_FORMATS = new string[] {&#xA;    &quot;dd-MMM-yyyy HH:mm:ss&quot;, &quot;dd-MMM-yyyy HH:mm&quot;,&#xA;    &quot;dd-MMM-yyyy&quot;,          &quot;d-MMM-yyyy&quot;,&#xA;    &quot;yyyy-MM-dd HH:mm:ss&quot;,  &quot;yyyy-MM-dd HH:mm&quot;, &quot;yyyy-MM-dd&quot;,&#xA;    &quot;dd/MM/yyyy HH:mm:ss&quot;,  &quot;dd/MM/yyyy HH:mm&quot;, &quot;dd/MM/yyyy&quot;,&#xA;    &quot;d/M/yyyy HH:mm:ss&quot;,    &quot;d/M/yyyy HH:mm&quot;,   &quot;d/M/yyyy&quot;,&#xA;    &quot;dd-MMM-yy&quot;&#xA;};&#xA;&#xA;string[] HIST_DATE_FORMATS = new string[] {&#xA;    &quot;dd-MMM-yyyy HH:mm:ss&quot;, &quot;dd-MMM-yyyy HH:mm&quot;, &quot;dd-MMM-yyyy&quot;, &quot;d-MMM-yyyy&quot;,&#xA;    &quot;yyyy-MM-dd HH:mm:ss&quot;,  &quot;yyyy-MM-dd HH:mm&quot;,  &quot;yyyy-MM-dd&quot;,&#xA;    &quot;dd/MM/yyyy HH:mm:ss&quot;,  &quot;dd/MM/yyyy HH:mm&quot;,  &quot;dd/MM/yyyy&quot;,&#xA;    &quot;d/M/yyyy HH:mm:ss&quot;,    &quot;d/M/yyyy HH:mm&quot;,    &quot;d/M/yyyy&quot;,&#xA;    &quot;dd-MMM-yy&quot;, &quot;yyyy-MMM-dd&quot;, &quot;M/d/yy&quot;, &quot;MM/dd/yy&quot;&#xA;};&#xA;&#xA;DateTime? ParseDateExact(object obj, string[] formats)&#xA;{&#xA;    if (obj == null || obj == DBNull.Value) return null;&#xA;    string s = obj.ToString().Trim();&#xA;    if (string.IsNullOrEmpty(s)) return null;&#xA;    DateTime dt;&#xA;    if (DateTime.TryParseExact(s, formats,&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xA;        System.Globalization.DateTimeStyles.None, out dt)) return dt;&#xA;    return ParseDate_Fallback(s);&#xA;}&#xA;&#xA;void CoerceToDateTime(DataTable dt, string colName, string[] formats)&#xA;{&#xA;    if (!dt.Columns.Contains(colName)) return;&#xA;&#xA;    if (dt.Columns[colName].DataType == typeof(DateTime))&#xA;    {&#xA;        for (int i = 0; i &lt; dt.Rows.Count; i++)&#xA;        {&#xA;            object v = dt.Rows[i][colName];&#xA;            if (v is string)&#xA;            {&#xA;                DateTime? p = ParseDateExact(v, formats);&#xA;                dt.Rows[i][colName] = p.HasValue ? (object)p.Value : DBNull.Value;&#xA;            }&#xA;        }&#xA;        return;&#xA;    }&#xA;&#xA;    string tmp = colName + &quot;__DT&quot;;&#xA;    if (!dt.Columns.Contains(tmp)) dt.Columns.Add(tmp, typeof(DateTime));&#xA;&#xA;    for (int i = 0; i &lt; dt.Rows.Count; i++)&#xA;    {&#xA;        DateTime? p = ParseDateExact(dt.Rows[i][colName], formats);&#xA;        dt.Rows[i][tmp] = p.HasValue ? (object)p.Value : DBNull.Value;&#xA;    }&#xA;&#xA;    int ordinal = dt.Columns[colName].Ordinal;&#xA;    dt.Columns.Remove(colName);&#xA;    dt.Columns[tmp].ColumnName = colName;&#xA;    dt.Columns[colName].SetOrdinal(ordinal);&#xA;}&#xA;&#xA;// ---------------------------&#xA;// Normalize existing HIST rows&#xA;// ---------------------------&#xA;int histBefore = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    DataRow r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    r[&quot;Source&quot;] = &quot;HIST&quot;;&#xA;    if (r.Table.Columns.Contains(&quot;Classification&quot;))&#xA;    {&#xA;        var v = r[&quot;Classification&quot;];&#xA;        if (v == DBNull.Value || SafeStr(v) == &quot;&quot;) r[&quot;Classification&quot;] = &quot;&quot;;&#xA;    }&#xA;}&#xA;CoerceToDateTime(dtHistoricalReconTransactionsReport, &quot;Booking Date&quot;,     HIST_DATE_FORMATS);&#xA;CoerceToDateTime(dtHistoricalReconTransactionsReport, &quot;Value Date&quot;,       HIST_DATE_FORMATS);&#xA;CoerceToDateTime(dtHistoricalReconTransactionsReport, &quot;Transaction Date&quot;, HIST_DATE_FORMATS);&#xA;&#xA;// ---------------------------&#xA;// Prepare CMS table&#xA;// ---------------------------&#xA;if (!dtTransactionReportForeignCurrencyTZS.Columns.Contains(&quot;RRN&quot;))     dtTransactionReportForeignCurrencyTZS.Columns.Add(&quot;RRN&quot;,  typeof(string));&#xA;if (!dtTransactionReportForeignCurrencyTZS.Columns.Contains(&quot;STAN&quot;))    dtTransactionReportForeignCurrencyTZS.Columns.Add(&quot;STAN&quot;, typeof(string));&#xA;if (!dtTransactionReportForeignCurrencyTZS.Columns.Contains(&quot;AUTH&quot;))    dtTransactionReportForeignCurrencyTZS.Columns.Add(&quot;AUTH&quot;, typeof(string));&#xA;if (!dtTransactionReportForeignCurrencyTZS.Columns.Contains(&quot;C_PAN&quot;))   dtTransactionReportForeignCurrencyTZS.Columns.Add(&quot;C_PAN&quot;, typeof(string));&#xA;if (!dtTransactionReportForeignCurrencyTZS.Columns.Contains(&quot;Transaction Ref No:&quot;)) dtTransactionReportForeignCurrencyTZS.Columns.Add(&quot;Transaction Ref No:&quot;, typeof(string));&#xA;if (!dtTransactionReportForeignCurrencyTZS.Columns.Contains(&quot;Narration&quot;))           dtTransactionReportForeignCurrencyTZS.Columns.Add(&quot;Narration&quot;, typeof(string));&#xA;if (!dtTransactionReportForeignCurrencyTZS.Columns.Contains(&quot;Channel&quot;))             dtTransactionReportForeignCurrencyTZS.Columns.Add(&quot;Channel&quot;, typeof(string));&#xA;if (!dtTransactionReportForeignCurrencyTZS.Columns.Contains(&quot;Classification&quot;))      dtTransactionReportForeignCurrencyTZS.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;if (!dtTransactionReportForeignCurrencyTZS.Columns.Contains(&quot;DR/CR to Cardholder&quot;)) dtTransactionReportForeignCurrencyTZS.Columns.Add(&quot;DR/CR to Cardholder&quot;, typeof(string));&#xA;&#xA;string cmsStanSrc  = dtTransactionReportForeignCurrencyTZS.Columns.Contains(&quot;Trace Audit Number&quot;)   ? &quot;Trace Audit Number&quot;   : (dtTransactionReportForeignCurrencyTZS.Columns.Contains(&quot;STAN&quot;) ? &quot;STAN&quot; : null);&#xA;string cmsRrnSrc   = dtTransactionReportForeignCurrencyTZS.Columns.Contains(&quot;Reference Number&quot;)     ? &quot;Reference Number&quot;     : (dtTransactionReportForeignCurrencyTZS.Columns.Contains(&quot;RRN&quot;)  ? &quot;RRN&quot;  : null);&#xA;string cmsAuthSrc  = dtTransactionReportForeignCurrencyTZS.Columns.Contains(&quot;Authorization Number&quot;) ? &quot;Authorization Number&quot; : (dtTransactionReportForeignCurrencyTZS.Columns.Contains(&quot;AUTH&quot;) ? &quot;AUTH&quot; : null);&#xA;&#xA;// Enforce CMS date formats&#xA;CoerceToDateTime(dtTransactionReportForeignCurrencyTZS, &quot;Transaction Date&quot;, CMS_DATE_FORMATS);&#xA;CoerceToDateTime(dtTransactionReportForeignCurrencyTZS, &quot;Booking Date&quot;,     CMS_DATE_FORMATS);&#xA;CoerceToDateTime(dtTransactionReportForeignCurrencyTZS, &quot;Value Date&quot;,       CMS_DATE_FORMATS);&#xA;&#xA;// Normalize CMS rows&#xA;for (int i = 0; i &lt; dtTransactionReportForeignCurrencyTZS.Rows.Count; i++)&#xA;{&#xA;    DataRow row = dtTransactionReportForeignCurrencyTZS.Rows[i];&#xA;&#xA;    if (!string.IsNullOrEmpty(cmsStanSrc)) row[&quot;STAN&quot;] = SafeStr(row[cmsStanSrc]);&#xA;    if (!string.IsNullOrEmpty(cmsRrnSrc))  row[&quot;RRN&quot;]  = KeepLast12Chars(SafeStr(row[cmsRrnSrc]));&#xA;    if (!string.IsNullOrEmpty(cmsAuthSrc)) row[&quot;AUTH&quot;] = SafeStr(row[cmsAuthSrc]);&#xA;&#xA;    if (dtTransactionReportForeignCurrencyTZS.Columns.Contains(&quot;ARN&quot;))&#xA;    {&#xA;        string arn = SafeStr(row[&quot;ARN&quot;]);&#xA;        row[&quot;Transaction Ref No:&quot;] = arn.Length &gt;= 23 ? arn.Substring(0, 23) : arn;&#xA;    }&#xA;&#xA;    string deviceNumber = SafeStr(row[&quot;Device Number&quot;]);&#xA;    if (!string.IsNullOrEmpty(deviceNumber) &amp;&amp; deviceNumber.Length &gt;= 16)&#xA;        row[&quot;C_PAN&quot;] = deviceNumber.Substring(0, 6) + &quot;XXXXXX&quot; + deviceNumber.Substring(deviceNumber.Length - 4);&#xA;    else&#xA;        row[&quot;C_PAN&quot;] = string.Empty;&#xA;&#xA;    string txnType = SafeStr(row[&quot;Transaction Type&quot;]);&#xA;    string stan    = SafeStr(row[&quot;STAN&quot;]);&#xA;    string rrn     = SafeStr(row[&quot;RRN&quot;]);&#xA;    string auth    = SafeStr(row[&quot;AUTH&quot;]);&#xA;    row[&quot;Narration&quot;] = txnType + &quot;-&quot; + row[&quot;C_PAN&quot;] + &quot;-&quot; + stan + &quot;-&quot; + rrn + &quot;-&quot; + auth;&#xA;&#xA;    var vClass = row[&quot;Classification&quot;];&#xA;    if (vClass == DBNull.Value || SafeStr(vClass) == &quot;&quot;) row[&quot;Classification&quot;] = &quot;&quot;;&#xA;}&#xA;&#xA;// ---------------------------&#xA;// Merge CMS into Historical (Foreign Currency -&gt; TZS GL)&#xA;// ---------------------------&#xA;int beforeCount = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;int lastSNO = beforeCount;&#xA;int reportOffset = 17;&#xA;int cmsAdded = 0;&#xA;int glAdded = 0; // no GL here; keep for logging parity&#xA;&#xA;var inv = System.Globalization.CultureInfo.InvariantCulture;&#xA;&#xA;for (int i = 0; i &lt; dtTransactionReportForeignCurrencyTZS.Rows.Count; i++)&#xA;{&#xA;    DataRow row = dtTransactionReportForeignCurrencyTZS.Rows[i];&#xA;    DataRow newRow = dtHistoricalReconTransactionsReport.NewRow();&#xA;    newRow[&quot;SNO&quot;] = ++lastSNO;&#xA;    int reportRowNumber = lastSNO + reportOffset;&#xA;&#xA;    newRow[&quot;Branch code&quot;]    = &quot;101&quot;;&#xA;    newRow[&quot;GL_Code&quot;]        = &quot;202030015&quot;;&#xA;    newRow[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;&#xA;    // Use CMS Transaction Date for both booking/value&#xA;    object cmsDt = (row.Table.Columns.Contains(&quot;Transaction Date&quot;) &amp;&amp; row[&quot;Transaction Date&quot;] is DateTime) ? row[&quot;Transaction Date&quot;] : (object)DBNull.Value;&#xA;    newRow[&quot;Booking Date&quot;] = cmsDt;&#xA;    newRow[&quot;Value Date&quot;]   = cmsDt;&#xA;&#xA;    newRow[&quot;Transaction Ref No:&quot;] = SafeStr(row[&quot;Transaction Ref No:&quot;]);&#xA;    newRow[&quot;C_PAN&quot;]               = SafeStr(row[&quot;C_PAN&quot;]);&#xA;    newRow[&quot;RRN&quot;]                 = SafeStr(row[&quot;RRN&quot;]);&#xA;    newRow[&quot;STAN&quot;]                = SafeStr(row[&quot;STAN&quot;]);&#xA;    newRow[&quot;AUTH&quot;]                = SafeStr(row[&quot;AUTH&quot;]);&#xA;    newRow[&quot;Narration&quot;]           = SafeStr(row[&quot;Narration&quot;]);&#xA;    newRow[&quot;FLEXREF&quot;]             = SafeStr(row[&quot;FLEXREF&quot;]);&#xA;    newRow[&quot;Transaction Type&quot;]    = SafeStr(row[&quot;Transaction Type&quot;]);&#xA;    newRow[&quot;Billing Amount&quot;]      = SafeStr(row[&quot;Billing Amount&quot;]);&#xA;    newRow[&quot;Device Number&quot;]       = SafeStr(row[&quot;Device Number&quot;]);&#xA;    newRow[&quot;ARN&quot;]                 = SafeStr(row[&quot;ARN&quot;]);&#xA;    newRow[&quot;Channel&quot;]             = SafeStr(row[&quot;Channel&quot;]);&#xA;    newRow[&quot;Classification&quot;]      = &quot;&quot;;&#xA;&#xA;    // Carry currency/amount fields from CMS&#xA;    string txnCur  = SafeStr(row[&quot;Transaction Currency&quot;]);&#xA;    string setCur  = SafeStr(row[&quot;Settlement Currency&quot;]);&#xA;    string billCur = SafeStr(row[&quot;Billing Currency&quot;]);&#xA;&#xA;    decimal txnAmt = SafeParseAmount(row[&quot;Transaction Amount&quot;]);&#xA;    decimal setAmt = SafeParseAmount(row[&quot;Settlement Amount&quot;]);&#xA;    decimal billAmt= SafeParseAmount(row[&quot;Billing Amount&quot;]);&#xA;&#xA;    newRow[&quot;Transaction Currency&quot;] = txnCur;&#xA;    newRow[&quot;Settlement Currency&quot;]  = setCur;&#xA;    newRow[&quot;Billing Currency&quot;]     = billCur;&#xA;    newRow[&quot;Transaction Amount&quot;]   = txnAmt.ToString(&quot;N2&quot;, inv);&#xA;    newRow[&quot;Settlement Amount&quot;]    = (setCur == &quot;&quot; &amp;&amp; setAmt == 0m) ? &quot;&quot; : setAmt.ToString(&quot;N2&quot;, inv);&#xA;    newRow[&quot;Billing Amount&quot;]       = billAmt.ToString(&quot;N2&quot;, inv);&#xA;&#xA;    // Mark as foreign currency if any currency != reconCurrency&#xA;    bool foreign = (!string.IsNullOrEmpty(billCur) &amp;&amp; !billCur.Equals(reconCurrency, StringComparison.OrdinalIgnoreCase))&#xA;                   || (!string.IsNullOrEmpty(txnCur) &amp;&amp; !txnCur.Equals(reconCurrency, StringComparison.OrdinalIgnoreCase))&#xA;                   || (!string.IsNullOrEmpty(setCur) &amp;&amp; !setCur.Equals(reconCurrency, StringComparison.OrdinalIgnoreCase));&#xA;    newRow[&quot;FOREIGN_CURRENCY&quot;] = foreign;&#xA;&#xA;    // Map Billing Amount into dr/cr in recon currency using DR/CR column (vice versa, abs)&#xA;    string drcr = row.Table.Columns.Contains(&quot;DR/CR to Cardholder&quot;) ? SafeStr(row[&quot;DR/CR to Cardholder&quot;]).ToUpper() : &quot;&quot;;&#xA;    decimal billingAbs = Math.Abs(billAmt);&#xA;&#xA;    if (drcr == &quot;DR&quot;)&#xA;    {&#xA;        // DR -&gt; Credit&#xA;        newRow[creditCol] = billingAbs;&#xA;        newRow[debitCol]  = 0m;&#xA;    }&#xA;    else if (drcr == &quot;CR&quot;)&#xA;    {&#xA;        // CR -&gt; Debit&#xA;        newRow[debitCol]  = billingAbs;&#xA;        newRow[creditCol] = 0m;&#xA;    }&#xA;    else&#xA;    {&#xA;        newRow[creditCol] = 0m;&#xA;        newRow[debitCol]  = 0m;&#xA;    }&#xA;&#xA;    // Source &amp; classification fields you specified&#xA;    newRow[&quot;Source&quot;]              = &quot;CMS&quot;;&#xA;    newRow[&quot;Type&quot;]                = &quot;new&quot;;&#xA;    newRow[&quot;Root Cause&quot;]          = &quot;FX Billed transaction debited TZS GL&quot;;&#xA;    newRow[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;    newRow[&quot;Action Owner&quot;]        = &quot;Card Settlement&quot;;&#xA;&#xA;    // Build Recommended Action from the six columns exactly as per examples:&#xA;    // &quot;Debit 101-202030015 (USD 18.87) and Credit 101-202030015 (TZS 50000)&quot;&#xA;    string billPart = (string.IsNullOrEmpty(billCur) ? &quot;&quot; : billCur + &quot; &quot;) + Math.Abs(billAmt).ToString(&quot;N2&quot;, inv);&#xA;    string txnPart  = (string.IsNullOrEmpty(txnCur)  ? &quot;&quot; : txnCur  + &quot; &quot;) + Math.Abs(txnAmt).ToString(&quot;N2&quot;, inv);&#xA;&#xA;    // Remove trailing &quot;.00&quot; formatting for integers if you want to mimic samples without decimals on TZS&#xA;    // (Keeping N2 for consistency; uncomment to strip .00)&#xA;    // if (txnPart.EndsWith(&quot;.00&quot;)) txnPart = txnPart.Substring(0, txnPart.Length - 3);&#xA;&#xA;    newRow[&quot;Recommended Action&quot;] = &quot;Debit 101-202030015 (&quot; + billPart + &quot;) and Credit 101-202030015 (&quot; + txnPart + &quot;)&quot;;&#xA;&#xA;    // Excel formulas&#xA;    newRow[&quot;Aging&quot;]             = &quot;=$H$6-G&quot; + reportRowNumber;&#xA;    newRow[&quot;Aging Group&quot;]       = &quot;=IF(L&quot; + reportRowNumber + &quot;&lt;4,\&quot;0-3 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;31,\&quot;4-30 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;61,\&quot;31-60 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;=90,\&quot;61-90 Days\&quot;,IF(L&quot; + reportRowNumber + &quot;&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;    newRow[&quot;BOT Classification&quot;] = &quot;=IF(J&quot; + reportRowNumber + &quot;&gt;0,IF(L&quot; + reportRowNumber + &quot;&lt;30,\&quot;Normal\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;60,\&quot;Especially Mentioned\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;90,\&quot;Substandard\&quot;,IF(L&quot; + reportRowNumber + &quot;&lt;=180,\&quot;Doubtful\&quot;,IF(L&quot; + reportRowNumber + &quot;&gt;180,\&quot;Loss\&quot;,\&quot;0\&quot;))))),\&quot;Not Applicable\&quot;)&quot;;&#xA;&#xA;    dtHistoricalReconTransactionsReport.Rows.Add(newRow);&#xA;    cmsAdded++;&#xA;}&#xA;&#xA;// ---------------------------&#xA;// Commit &amp; diagnostics&#xA;// ---------------------------&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;&#xA;int afterCount = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;Console.WriteLine(&quot;[HIST] Existing rows normalized: &quot; + histBefore);&#xA;Console.WriteLine(&quot;[Merge] CMS rows in: &quot; + dtTransactionReportForeignCurrencyTZS.Rows.Count);&#xA;Console.WriteLine(&quot;[Merge] Added CMS: &quot; + cmsAdded);&#xA;Console.WriteLine(&quot;[Merge] HRecon before: &quot; + beforeCount + &quot;, after: &quot; + afterCount + &quot;, delta: &quot; + (afterCount - beforeCount));&#xA;" DisplayName="dtTransactionReportForeignCurrencyTZS" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_62" Language="CSharp">

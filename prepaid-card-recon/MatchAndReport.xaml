        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== Insert Exchange Gain/Loss Adjustment (UiPath Invoke Code safe) ====&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport&#xA;// Args (In): string reconDate, string reconCurrency, decimal exchangeLossWakala, decimal exchangeGainWakala&#xA;&#xA;// --- Nothing to do? ---&#xA;if ((exchangeLossWakala == 0m) &amp;&amp; (exchangeGainWakala == 0m))&#xA;{&#xA;    System.Console.WriteLine(&quot;✅ No exchange gain or loss to record.&quot;);&#xA;    return;&#xA;}&#xA;&#xA;// --- Parse reconDate robustly (no local funcs) ---&#xA;System.DateTime parsedDate;&#xA;string[] formats = new string[]&#xA;{&#xA;    &quot;dd-MMM-yyyy&quot;,  // 29-Jul-2025&#xA;    &quot;yyyy-MM-dd&quot;,   // 2025-07-29&#xA;    &quot;dd/MM/yyyy&quot;,&#xA;    &quot;yyyy/MM/dd&quot;,&#xA;    &quot;dd-MM-yyyy&quot;,&#xA;    &quot;MM/dd/yyyy&quot;,&#xA;    &quot;dd MMM yyyy&quot;&#xA;};&#xA;&#xA;if (string.IsNullOrWhiteSpace(reconDate) ||&#xA;    !System.DateTime.TryParseExact(&#xA;        reconDate.Trim(),&#xA;        formats,&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xA;        System.Globalization.DateTimeStyles.None,&#xA;        out parsedDate))&#xA;{&#xA;    throw new System.ArgumentException(&#xA;        &quot;reconDate is null/empty or not in an accepted format. Received: '&quot; + (reconDate ?? &quot;&lt;null&gt;&quot;)&#xA;        + &quot;'. Try one of: &quot; + string.Join(&quot;, &quot;, formats));&#xA;}&#xA;&#xA;string dateStrIso = parsedDate.ToString(&quot;yyyy-MM-dd&quot;);&#xA;&#xA;// --- Ensure amount columns exist ---&#xA;string creditCol = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xA;string debitCol  = &quot;Debit (&quot; + reconCurrency + &quot;)&quot;;&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(creditCol))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(creditCol, typeof(decimal));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(debitCol))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(debitCol, typeof(decimal));&#xA;&#xA;// --- Ensure other required columns exist (no local functions) ---&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;SNO&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;SNO&quot;, typeof(int));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Branch code&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Branch code&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;GL_Code&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;GL_Code&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;GL Description&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;GL Description&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Booking Date&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Booking Date&quot;, typeof(object));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Value Date&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Value Date&quot;, typeof(object));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Transaction Ref No:&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Transaction Ref No:&quot;, typeof(object));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Aging&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Aging&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Aging Group&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Aging Group&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;BOT Classification&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;BOT Classification&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Narration&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Narration&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Root Cause&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Root Cause&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Root Cause Category&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Root Cause Category&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Recommended Action&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Recommended Action&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Action Owner&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Action Owner&quot;, typeof(string));&#xA;&#xA;// --- Compute next SNO = max existing + 1 (no LINQ) ---&#xA;int currentMaxSno = 0;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    object snoObj = dtHistoricalReconTransactionsReport.Rows[i][&quot;SNO&quot;];&#xA;    if (snoObj != null &amp;&amp; snoObj != System.DBNull.Value)&#xA;    {&#xA;        int s;&#xA;        if (int.TryParse(snoObj.ToString(), out s))&#xA;        {&#xA;            if (s &gt; currentMaxSno) currentMaxSno = s;&#xA;        }&#xA;    }&#xA;}&#xA;int nextSNO = currentMaxSno + 1;&#xA;&#xA;// =======================&#xA;// Insert LOSS row (if any)&#xA;// =======================&#xA;if (exchangeLossWakala &gt; 0m)&#xA;{&#xA;    System.Data.DataRow newRowLoss = dtHistoricalReconTransactionsReport.NewRow();&#xA;&#xA;    int thisSNO = nextSNO;&#xA;    nextSNO++;&#xA;    int excelRow = thisSNO + 5;&#xA;&#xA;    newRowLoss[&quot;SNO&quot;] = thisSNO;&#xA;    newRowLoss[&quot;Branch code&quot;] = &quot;101&quot;;&#xA;    newRowLoss[&quot;GL_Code&quot;] = &quot;202030015&quot;;&#xA;    newRowLoss[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;    newRowLoss[&quot;Booking Date&quot;] = parsedDate;&#xA;    newRowLoss[&quot;Value Date&quot;] = parsedDate;&#xA;    newRowLoss[&quot;Transaction Ref No:&quot;] = System.DBNull.Value;&#xA;&#xA;    newRowLoss[&quot;Aging&quot;] = &quot;=$H$6-G&quot; + excelRow.ToString();&#xA;    newRowLoss[&quot;Aging Group&quot;] =&#xA;        &quot;=IF(L&quot; + excelRow + &quot;&lt;4,\&quot;0-3 Days\&quot;,IF(L&quot; + excelRow + &quot;&lt;31,\&quot;4-30 Days\&quot;,IF(L&quot; + excelRow + &quot;&lt;61,\&quot;31-60 Days\&quot;,IF(L&quot; + excelRow + &quot;&lt;=90,\&quot;61-90 Days\&quot;,IF(L&quot; + excelRow + &quot;&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;    newRowLoss[&quot;BOT Classification&quot;] =&#xA;        &quot;=IF(J&quot; + excelRow + &quot;&gt;0,IF(L&quot; + excelRow + &quot;&lt;30,\&quot;Normal\&quot;,IF(L&quot; + excelRow + &quot;&lt;60,\&quot;Especially Mentioned\&quot;,IF(L&quot; + excelRow + &quot;&lt;90,\&quot;Substandard\&quot;,IF(L&quot; + excelRow + &quot;&lt;=180,\&quot;Doubtful\&quot;,IF(L&quot; + excelRow + &quot;&gt;180,\&quot;Loss\&quot;,\&quot;0\&quot;)))))),\&quot;Not Applicable\&quot;)&quot;;&#xA;&#xA;    // Loss: CBS (GL) debits &gt; CMS credits → DEBIT entry&#xA;    newRowLoss[debitCol]  = exchangeLossWakala;&#xA;    newRowLoss[creditCol] = System.DBNull.Value;&#xA;    newRowLoss[&quot;Narration&quot;] = &quot;CBS charging more amount than CMS on Wakala withdrawal &quot; + dateStrIso;&#xA;    newRowLoss[&quot;Root Cause&quot;] = &quot;CBS charging more amount than CMS on Wakala withdrawal&quot;;&#xA;    newRowLoss[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;    newRowLoss[&quot;Recommended Action&quot;] = &quot;To be realized as other expense&quot;;&#xA;    newRowLoss[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;&#xA;    dtHistoricalReconTransactionsReport.Rows.Add(newRowLoss);&#xA;&#xA;    System.Console.WriteLine(&quot;📉 Loss row inserted — SNO: &quot; + thisSNO.ToString()&#xA;        + &quot;, Amount: &quot; + exchangeLossWakala.ToString(&quot;N2&quot;)&#xA;        + &quot;, Date: &quot; + parsedDate.ToString(&quot;dd-MMM-yyyy&quot;));&#xA;}&#xA;&#xA;// =======================&#xA;// Insert GAIN row (if any)&#xA;// =======================&#xA;if (exchangeGainWakala &gt; 0m)&#xA;{&#xA;    System.Data.DataRow newRowGain = dtHistoricalReconTransactionsReport.NewRow();&#xA;&#xA;    int thisSNO = nextSNO;&#xA;    nextSNO++;&#xA;    int excelRow = thisSNO + 5;&#xA;&#xA;    newRowGain[&quot;SNO&quot;] = thisSNO;&#xA;    newRowGain[&quot;Branch code&quot;] = &quot;101&quot;;&#xA;    newRowGain[&quot;GL_Code&quot;] = &quot;202030015&quot;;&#xA;    newRowGain[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;    newRowGain[&quot;Booking Date&quot;] = parsedDate;&#xA;    newRowGain[&quot;Value Date&quot;] = parsedDate;&#xA;    newRowGain[&quot;Transaction Ref No:&quot;] = System.DBNull.Value;&#xA;&#xA;    newRowGain[&quot;Aging&quot;] = &quot;=$H$6-G&quot; + excelRow.ToString();&#xA;    newRowGain[&quot;Aging Group&quot;] =&#xA;        &quot;=IF(L&quot; + excelRow + &quot;&lt;4,\&quot;0-3 Days\&quot;,IF(L&quot; + excelRow + &quot;&lt;31,\&quot;4-30 Days\&quot;,IF(L&quot; + excelRow + &quot;&lt;61,\&quot;31-60 Days\&quot;,IF(L&quot; + excelRow + &quot;&lt;=90,\&quot;61-90 Days\&quot;,IF(L&quot; + excelRow + &quot;&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;    newRowGain[&quot;BOT Classification&quot;] =&#xA;        &quot;=IF(J&quot; + excelRow + &quot;&gt;0,IF(L&quot; + excelRow + &quot;&lt;30,\&quot;Normal\&quot;,IF(L&quot; + excelRow + &quot;&lt;60,\&quot;Especially Mentioned\&quot;,IF(L&quot; + excelRow + &quot;&lt;90,\&quot;Substandard\&quot;,IF(L&quot; + excelRow + &quot;&lt;=180,\&quot;Doubtful\&quot;,IF(L&quot; + excelRow + &quot;&gt;180,\&quot;Loss\&quot;,\&quot;0\&quot;)))))),\&quot;Not Applicable\&quot;)&quot;;&#xA;&#xA;    // Gain: CMS credits &gt; CBS (GL) debits → CREDIT entry&#xA;    newRowGain[creditCol] = exchangeGainWakala;&#xA;    newRowGain[debitCol]  = System.DBNull.Value;&#xA;    newRowGain[&quot;Narration&quot;] = &quot;CMS charging more amount than CBS on Wakala withdrawal &quot; + dateStrIso;&#xA;    newRowGain[&quot;Root Cause&quot;] = &quot;CMS charging more amount than CBS on Wakala withdrawal&quot;;&#xA;    newRowGain[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;    newRowGain[&quot;Recommended Action&quot;] = &quot;To be realized as other income&quot;;&#xA;    newRowGain[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;&#xA;    dtHistoricalReconTransactionsReport.Rows.Add(newRowGain);&#xA;&#xA;    System.Console.WriteLine(&quot;📈 Gain row inserted — SNO: &quot; + thisSNO.ToString()&#xA;        + &quot;, Amount: &quot; + exchangeGainWakala.ToString(&quot;N2&quot;)&#xA;        + &quot;, Date: &quot; + parsedDate.ToString(&quot;dd-MMM-yyyy&quot;));&#xA;}&#xA;&#xA;System.Console.WriteLine(&quot;✅ Exchange adjustment rows complete.&quot;);&#xA;" DisplayName="exchangeGainWakala + exchangeLossWakala" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_14" Language="CSharp">

        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: FINAL OVERRIDE FOR PREPAID INCOME FEES (CMS only) ====&#xA;// In/Out: DataTable dtHistoricalReconTransactionsReport&#xA;&#xA;&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport));&#xA;&#xA;// Helper to normalize narration&#xA;string Norm(string s) =&gt;&#xA;    string.IsNullOrWhiteSpace(s)&#xA;        ? &quot;&quot;&#xA;        : Regex.Replace(&#xA;              s.Trim().ToLowerInvariant(),&#xA;              @&quot;\s+&quot;,&#xA;              &quot; &quot;&#xA;          );&#xA;&#xA;// STRICT heads that must start with:&#xA;string[] incomeHeads = new[]&#xA;{&#xA;    &quot;cash withdrawal transaction fee&quot;,&#xA;    &quot;purchase/auth completion transaction fee&quot;,&#xA;    &quot;balance inquiry transaction fee&quot;&#xA;};&#xA;&#xA;// GENERAL income keywords (contained anywhere, but as WHOLE WORDS)&#xA;string[] incomeKeywords = new[]&#xA;{&#xA;    &quot;transaction fee&quot;,   // phrase&#xA;    &quot;income&quot;,&#xA;    &quot;fee&quot;,&#xA;    &quot;fees&quot;,&#xA;    &quot;levy&quot;&#xA;};&#xA;&#xA;// Target values&#xA;const string RC   = &quot;Prepaid Card Income updated on CMS only&quot;;&#xA;const string RCAT = &quot;System&quot;;&#xA;const string ACT  = &quot;Post the income manually&quot;;&#xA;const string OWN  = &quot;Card Finance&quot;;&#xA;&#xA;int overridden = 0;&#xA;&#xA;// Helper: check if text contains any income keyword as whole word&#xA;bool ContainsIncomeKeyword(string text)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(text))&#xA;        return false;&#xA;&#xA;    foreach (var kw in incomeKeywords)&#xA;    {&#xA;        if (string.IsNullOrWhiteSpace(kw))&#xA;            continue;&#xA;&#xA;        // For multi-word phrases (e.g., &quot;transaction fee&quot;), simple Contains is fine&#xA;        if (kw.Contains(&quot; &quot;))&#xA;        {&#xA;            if (text.Contains(kw))&#xA;                return true;&#xA;        }&#xA;        else&#xA;        {&#xA;            // Single-word keywords must match as a whole word, not inside codes like &quot;FEEDFZ&quot;&#xA;            var pattern = $@&quot;\b{Regex.Escape(kw)}\b&quot;;&#xA;            if (Regex.IsMatch(text, pattern))&#xA;                return true;&#xA;        }&#xA;    }&#xA;&#xA;    return false;&#xA;}&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    // Only apply to CMS&#xA;    string src = row.Table.Columns.Contains(&quot;Source&quot;) &amp;&amp; row[&quot;Source&quot;] != null&#xA;        ? row[&quot;Source&quot;].ToString().Trim().ToUpperInvariant()&#xA;        : &quot;&quot;;&#xA;&#xA;    if (src != &quot;CMS&quot;)&#xA;        continue;&#xA;&#xA;    string narr = row.Table.Columns.Contains(&quot;Narration&quot;) &amp;&amp; row[&quot;Narration&quot;] != null&#xA;        ? row[&quot;Narration&quot;].ToString()&#xA;        : &quot;&quot;;&#xA;&#xA;    string normNarr = Norm(narr);&#xA;    if (string.IsNullOrEmpty(normNarr))&#xA;        continue;&#xA;&#xA;    bool match = false;&#xA;&#xA;    // 1️⃣ STRICT HEADS — narration must start with these&#xA;    foreach (var head in incomeHeads)&#xA;    {&#xA;        if (normNarr.StartsWith(head))&#xA;        {&#xA;            match = true;&#xA;            break;&#xA;        }&#xA;    }&#xA;&#xA;    // 2️⃣ GENERAL INCOME KEYWORDS — anywhere in narration, but with word boundaries&#xA;    if (!match &amp;&amp; ContainsIncomeKeyword(normNarr))&#xA;        match = true;&#xA;&#xA;    if (!match)&#xA;        continue;&#xA;&#xA;    // FORCE override to income mapping&#xA;    if (row.Table.Columns.Contains(&quot;Root Cause&quot;))&#xA;        row[&quot;Root Cause&quot;] = RC;&#xA;    if (row.Table.Columns.Contains(&quot;Root Cause Category&quot;))&#xA;        row[&quot;Root Cause Category&quot;] = RCAT;&#xA;    if (row.Table.Columns.Contains(&quot;Recommended Action&quot;))&#xA;        row[&quot;Recommended Action&quot;] = ACT;&#xA;    if (row.Table.Columns.Contains(&quot;Action Owner&quot;))&#xA;        row[&quot;Action Owner&quot;] = OWN;&#xA;&#xA;    overridden++;&#xA;}&#xA;&#xA;// ONLY SUMMARY (no individual logs)&#xA;System.Console.WriteLine($&quot;[INCOME OVERRIDE FINAL] CMS rows overridden: {overridden}&quot;);&#xA;" DisplayName="Income, fees, levy and Channel == API" sap:VirtualizedContainerService.HintSize="450,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_103" Language="CSharp">

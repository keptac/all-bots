        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: Fresh normalize PAN/RRN + detect 1C+4D AGW and move to Matched (SUMMARY LOGS ONLY) =====&#xA;// Args (In):     string reconCurrency&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport, DataTable dtHistoricalReconTransactionsReportMatched&#xA;// Args (Out):    decimal exchangeLossWakala, decimal exchangeGainWakala&#xA;//&#xA;// Behavior:&#xA;// 1) Freshly extracts RRN (PS##########) and masked PAN (######XXXXXX####) from Narration for all rows.&#xA;// 2) Normalizes to strict uppercase formats and sets AGW_GroupKey = RRN (EC/PS reference) only (both normalized).&#xA;// 3) Groups by AGW_GroupKey.&#xA;// 4) For each group, finds ONE bundle of 1 Credit + 4 Debits:&#xA;//    - Prefers an EXACT match (sum of 4 debits == that credit).&#xA;//    - If no exact combination found, takes first 4 debits by row order (FX case).&#xA;// 5) Sets &quot;Classification&quot; = AGW_EXACT or AGW_FX, fills &quot;AGW Bundle ID&quot;, &quot;AGW Diff (Abs)&quot;, &quot;AGW Diff (Signed)&quot;.&#xA;// 6) Moves those 5 rows to dtHistoricalReconTransactionsReportMatched and removes them from source.&#xA;// 7) Sums FX differences into exchangeLossWakala (diff&gt;0 =&gt; CBS&gt;CMS) and exchangeGainWakala (diff&lt;0 =&gt; CMS&gt;CBS).&#xA;&#xA;// ---------- Guards ----------&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport));&#xA;if (dtHistoricalReconTransactionsReportMatched == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReportMatched));&#xA;if (string.IsNullOrWhiteSpace(reconCurrency))&#xA;    throw new ArgumentNullException(nameof(reconCurrency));&#xA;&#xA;var _sw = System.Diagnostics.Stopwatch.StartNew();&#xA;&#xA;// ---------- Helpers ----------&#xA;bool HasCol(System.Data.DataTable dt, string col) =&gt; dt.Columns.Contains(col);&#xA;&#xA;void EnsureCol(System.Data.DataTable dt, string name, System.Type t, object defaultValue = null)&#xA;{&#xA;    if (!dt.Columns.Contains(name))&#xA;    {&#xA;        var col = new System.Data.DataColumn(name, t);&#xA;        if (defaultValue != null) col.DefaultValue = defaultValue;&#xA;        dt.Columns.Add(col);&#xA;        // backfill for existing rows&#xA;        foreach (System.Data.DataRow r in dt.Rows)&#xA;        {&#xA;            r[name] = defaultValue ?? (t == typeof(string) ? &quot;&quot; : (object)System.DBNull.Value);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;string S(object v) =&gt; (v == null || v == System.DBNull.Value) ? &quot;&quot; : v.ToString();&#xA;&#xA;string NormRRN(string s)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(s)) return &quot;&quot;;&#xA;    return s.Trim().ToUpperInvariant();&#xA;}&#xA;&#xA;string NormPAN(string s)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(s)) return &quot;&quot;;&#xA;    s = s.Trim().ToUpperInvariant();&#xA;    var m = System.Text.RegularExpressions.Regex.Match(s, @&quot;\d{6}X{6}\d{4}&quot;);&#xA;    return m.Success ? m.Value : &quot;&quot;;&#xA;}&#xA;&#xA;decimal SafeToDecimal(object v)&#xA;{&#xA;    if (v == null || v == System.DBNull.Value) return 0m;&#xA;    var s = v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;);&#xA;    decimal d;&#xA;    return decimal.TryParse(&#xA;        s,&#xA;        System.Globalization.NumberStyles.Any,&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xA;        out d&#xA;    ) ? d : 0m;&#xA;}&#xA;&#xA;// Exact 4-combo finder (tries to find 4 debits that exactly sum to the credit).&#xA;// Returns indices of chosen debits within 'debits' list, or null if none.&#xA;int[] FindFourDebitsExact(System.Collections.Generic.List&lt;System.Data.DataRow&gt; debits, string debitCol, decimal target)&#xA;{&#xA;    int n = debits.Count;&#xA;    if (n &lt; 4) return null;&#xA;&#xA;    // Cap exhaustive search to reasonable size&#xA;    int maxN = (n &gt; 12) ? 12 : n; // keep compute light&#xA;    // Prefetch amounts&#xA;    var amt = new decimal[maxN];&#xA;    for (int i = 0; i &lt; maxN; i++) amt[i] = SafeToDecimal(debits[i][debitCol]);&#xA;&#xA;    for (int i = 0; i &lt; maxN - 3; i++)&#xA;    for (int j = i + 1; j &lt; maxN - 2; j++)&#xA;    for (int k = j + 1; k &lt; maxN - 1; k++)&#xA;    for (int l = k + 1; l &lt; maxN; l++)&#xA;    {&#xA;        decimal sum = amt[i] + amt[j] + amt[k] + amt[l];&#xA;        if (sum == target)&#xA;            return new int[] { i, j, k, l };&#xA;    }&#xA;    return null;&#xA;}&#xA;&#xA;// Finds a subset of &apos;debits&apos; that sums exactly to &apos;target&apos; by excluding exactly one row&#xA;// (handles a separate statutory levy/charge leg that is not part of this GL entry).&#xA;// Returns the indices of the KEPT rows; outputs the index of the EXCLUDED row (-1 if none found).&#xA;int[] FindSubsetExcludingOne(System.Collections.Generic.List&lt;System.Data.DataRow&gt; debits, string debitCol, decimal target, out int excludedIndex)&#xA;{&#xA;    excludedIndex = -1;&#xA;    int n = debits.Count;&#xA;    if (n &lt; 2) return null;&#xA;    var amt = new decimal[n];&#xA;    decimal total = 0m;&#xA;    for (int i = 0; i &lt; n; i++) { amt[i] = SafeToDecimal(debits[i][debitCol]); total += amt[i]; }&#xA;    for (int skip = 0; skip &lt; n; skip++)&#xA;    {&#xA;        if (total - amt[skip] == target)&#xA;        {&#xA;            excludedIndex = skip;&#xA;            var keep = new System.Collections.Generic.List&lt;int&gt;();&#xA;            for (int i = 0; i &lt; n; i++) if (i != skip) keep.Add(i);&#xA;            return keep.ToArray();&#xA;        }&#xA;    }&#xA;    return null;&#xA;}&#xA;&#xA;// ---------- Ensure required columns in BOTH tables ----------&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Narration&quot;, typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;C_PAN&quot;, typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;RRN&quot;, typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;C_PAN_NORMALIZED&quot;, typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;RRN_NORMALIZED&quot;, typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;AGW_GroupKey&quot;, typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Classification&quot;, typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;AGW Bundle ID&quot;, typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;AGW Diff (Abs)&quot;, typeof(decimal), 0m);&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;AGW Diff (Signed)&quot;, typeof(decimal), 0m);&#xA;&#xA;EnsureCol(dtHistoricalReconTransactionsReportMatched, &quot;Narration&quot;, typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReportMatched, &quot;C_PAN&quot;, typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReportMatched, &quot;RRN&quot;, typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReportMatched, &quot;C_PAN_NORMALIZED&quot;, typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReportMatched, &quot;RRN_NORMALIZED&quot;, typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReportMatched, &quot;AGW_GroupKey&quot;, typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReportMatched, &quot;Classification&quot;, typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReportMatched, &quot;AGW Bundle ID&quot;, typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReportMatched, &quot;AGW Diff (Abs)&quot;, typeof(decimal), 0m);&#xA;EnsureCol(dtHistoricalReconTransactionsReportMatched, &quot;AGW Diff (Signed)&quot;, typeof(decimal), 0m);&#xA;&#xA;// Currency columns&#xA;string debitCol  = $&quot;Debit ({reconCurrency})&quot;;&#xA;string creditCol = $&quot;Credit ({reconCurrency})&quot;;&#xA;if (!HasCol(dtHistoricalReconTransactionsReport, debitCol))  throw new Exception($&quot;Missing column: {debitCol}&quot;);&#xA;if (!HasCol(dtHistoricalReconTransactionsReport, creditCol)) throw new Exception($&quot;Missing column: {creditCol}&quot;);&#xA;if (!HasCol(dtHistoricalReconTransactionsReportMatched, debitCol))  dtHistoricalReconTransactionsReportMatched.Columns.Add(debitCol, typeof(string));&#xA;if (!HasCol(dtHistoricalReconTransactionsReportMatched, creditCol)) dtHistoricalReconTransactionsReportMatched.Columns.Add(creditCol, typeof(string));&#xA;&#xA;// ---------- Regex extractors ----------&#xA;var rxRRN = new System.Text.RegularExpressions.Regex(@&quot;\b(?:PS\d{10}|EC[A-Za-z0-9]{10})\b&quot;,&#xA;    System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Compiled);&#xA;var rxPAN = new System.Text.RegularExpressions.Regex(@&quot;\b\d{6}[xX]{6}\d{4}\b&quot;,&#xA;    System.Text.RegularExpressions.RegexOptions.Compiled);&#xA;&#xA;// ---------- Pass 1: Fresh refill &amp; normalization ----------&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    string narr = S(r[&quot;Narration&quot;]);&#xA;&#xA;    string rrnFound = &quot;&quot;;&#xA;    var mRRN = rxRRN.Match(narr);&#xA;    if (mRRN.Success) rrnFound = mRRN.Value;&#xA;&#xA;    string panFound = &quot;&quot;;&#xA;    var mPAN = rxPAN.Match(narr);&#xA;    if (mPAN.Success) panFound = mPAN.Value;&#xA;&#xA;    var rrnNorm = NormRRN(rrnFound);&#xA;    var panNorm = NormPAN(panFound);&#xA;&#xA;    r[&quot;RRN&quot;] = rrnNorm;&#xA;    r[&quot;C_PAN&quot;] = panNorm;&#xA;    r[&quot;RRN_NORMALIZED&quot;] = rrnNorm;&#xA;    r[&quot;C_PAN_NORMALIZED&quot;] = panNorm;&#xA;    // AGW_GroupKey = RRN only (the EC/PS transaction reference).&#xA;    // PAN used to be part of this key, which silently broke EVERY Agency Banking match:&#xA;    // the CMS leg (Transfer Debit from 3rd party - API-...-EC...-...) carries a masked PAN, but the&#xA;    // four CBS legs (Cash Withdrawal Agency Banking / Cash Withdraw charge / Government Levy /&#xA;    // VAT Payable on Comm and Fees) do not - they only carry @EC... - so the two sides produced&#xA;    // different keys (EC...|550558XXXXXX1234 vs EC...|) and could never land in the same group.&#xA;    // Rows with an empty RRN are already skipped at grouping time, so RRN alone is safe.&#xA;    r[&quot;AGW_GroupKey&quot;] = rrnNorm;&#xA;}&#xA;&#xA;// ---------- Group rows by AGW_GroupKey ----------&#xA;var groupMap = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    var key = S(r[&quot;AGW_GroupKey&quot;]);&#xA;    // Only groups with a non-empty RRN are valid&#xA;    var rrn = S(r[&quot;RRN_NORMALIZED&quot;]);&#xA;    if (string.IsNullOrEmpty(rrn)) continue;&#xA;&#xA;    if (!groupMap.ContainsKey(key))&#xA;        groupMap[key] = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;    groupMap[key].Add(r);&#xA;}&#xA;&#xA;// ---------- Try to match 1C+4D and move ----------&#xA;decimal totalGain = 0m, totalLoss = 0m;&#xA;int analyzedGroups = 0;&#xA;int bundlesMoved = 0;&#xA;int leviesExcluded = 0;&#xA;&#xA;var rowsToMove = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;var rowsToRemove = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;&#xA;foreach (var kv in groupMap)&#xA;{&#xA;    var key = kv.Key;&#xA;    var list = kv.Value;&#xA;    if (list == null || list.Count == 0) continue;&#xA;&#xA;    analyzedGroups++;&#xA;&#xA;    // Identify credits and debits in the group&#xA;    var creditRows = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;    var debitRows  = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;    for (int i = 0; i &lt; list.Count; i++)&#xA;    {&#xA;        var r = list[i];&#xA;        var cAmt = SafeToDecimal(r[creditCol]);&#xA;        var dAmt = SafeToDecimal(r[debitCol]);&#xA;        if (cAmt &gt; 0m) creditRows.Add(r);&#xA;        if (dAmt &gt; 0m) debitRows.Add(r);&#xA;    }&#xA;&#xA;    // Must have at least 1 credit and 4 debits to form a bundle&#xA;    if (creditRows.Count == 0 || debitRows.Count &lt; 4) continue;&#xA;&#xA;    var rrn = S(list[0][&quot;RRN_NORMALIZED&quot;]);&#xA;    var pan = S(list[0][&quot;C_PAN_NORMALIZED&quot;]);&#xA;&#xA;    // Try each credit to find best 4-debit exact match; otherwise fallback to first 4 debits&#xA;    bool matchedThisGroup = false;&#xA;    for (int cIdx = 0; cIdx &lt; creditRows.Count &amp;&amp; !matchedThisGroup; cIdx++)&#xA;    {&#xA;        var cRow = creditRows[cIdx];&#xA;        decimal cAmt = SafeToDecimal(cRow[creditCol]);&#xA;&#xA;        // Try exact 4-combo&#xA;        int[] combo = FindFourDebitsExact(debitRows, debitCol, cAmt);&#xA;        System.Collections.Generic.List&lt;System.Data.DataRow&gt; chosenDebs;&#xA;        System.Data.DataRow excludedDebRow = null;&#xA;&#xA;        if (combo != null)&#xA;        {&#xA;            chosenDebs = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;(4);&#xA;            for (int ii = 0; ii &lt; 4; ii++) chosenDebs.Add(debitRows[combo[ii]]);&#xA;        }&#xA;        else&#xA;        {&#xA;            // Try leaving exactly one debit out (e.g. a separate statutory levy/charge leg&#xA;            // that is not part of this GL entry, so the remaining debits sum exactly to the credit).&#xA;            int excludedIdx;&#xA;            int[] subsetIdx = FindSubsetExcludingOne(debitRows, debitCol, cAmt, out excludedIdx);&#xA;            if (subsetIdx != null)&#xA;            {&#xA;                chosenDebs = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;(subsetIdx.Length);&#xA;                for (int ii = 0; ii &lt; subsetIdx.Length; ii++) chosenDebs.Add(debitRows[subsetIdx[ii]]);&#xA;                excludedDebRow = debitRows[excludedIdx];&#xA;            }&#xA;            else&#xA;            {&#xA;                // Fallback: first four debits by original order&#xA;                chosenDebs = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;(4);&#xA;                for (int ii = 0; ii &lt; 4; ii++) chosenDebs.Add(debitRows[ii]);&#xA;            }&#xA;        }&#xA;&#xA;        // Compute diff for the chosen 1C+4D set&#xA;        decimal dSum = 0m;&#xA;        for (int ii = 0; ii &lt; chosenDebs.Count; ii++) dSum += SafeToDecimal(chosenDebs[ii][debitCol]);&#xA;        decimal diff = dSum - cAmt;&#xA;        decimal abs  = System.Math.Abs(diff);&#xA;&#xA;        string bundleId = rrn + &quot;|#1&quot;; // deterministic per RRN&#xA;        string cls = (abs == 0m) ? &quot;AGW_EXACT&quot; : &quot;AGW_FX&quot;;&#xA;&#xA;        // Write bundle metadata on all 5 rows&#xA;        cRow[&quot;AGW Bundle ID&quot;]      = bundleId;&#xA;        cRow[&quot;AGW Diff (Abs)&quot;]     = abs;&#xA;        cRow[&quot;AGW Diff (Signed)&quot;]  = diff;&#xA;        cRow[&quot;Classification&quot;]     = cls;&#xA;&#xA;        for (int ii = 0; ii &lt; chosenDebs.Count; ii++)&#xA;        {&#xA;            var dRow = chosenDebs[ii];&#xA;            dRow[&quot;AGW Bundle ID&quot;]     = bundleId;&#xA;            dRow[&quot;AGW Diff (Abs)&quot;]    = abs;&#xA;            dRow[&quot;AGW Diff (Signed)&quot;] = diff;&#xA;            dRow[&quot;Classification&quot;]    = cls;&#xA;        }&#xA;&#xA;        // If one debit leg was excluded to reach an exact match, tag it as its own distinct&#xA;        // item (e.g. statutory levy) instead of leaving it mislabeled by the generic fallback.&#xA;        if (excludedDebRow != null)&#xA;        {&#xA;            excludedDebRow[&quot;Classification&quot;] = &quot;AGW_LEVY_EXCLUDED&quot;;&#xA;            excludedDebRow[&quot;AGW Bundle ID&quot;] = bundleId;&#xA;            if (excludedDebRow.Table.Columns.Contains(&quot;Root Cause&quot;))&#xA;                excludedDebRow[&quot;Root Cause&quot;] = &quot;Wakala/Agency Banking statutory levy - not part of this GL entry&quot;;&#xA;            if (excludedDebRow.Table.Columns.Contains(&quot;Root Cause Category&quot;))&#xA;                excludedDebRow[&quot;Root Cause Category&quot;] = &quot;Regulatory&quot;;&#xA;            if (excludedDebRow.Table.Columns.Contains(&quot;Recommended Action&quot;))&#xA;                excludedDebRow[&quot;Recommended Action&quot;] = &quot;Route/match against the Government Levy GL account&quot;;&#xA;            if (excludedDebRow.Table.Columns.Contains(&quot;Action Owner&quot;))&#xA;                excludedDebRow[&quot;Action Owner&quot;] = &quot;Card Reconciliation&quot;;&#xA;            leviesExcluded++;&#xA;        }&#xA;&#xA;        // FX accounting&#xA;        if (diff &gt; 0m) totalLoss += abs;&#xA;        else if (diff &lt; 0m) totalGain += abs;&#xA;&#xA;        // Queue rows to move &amp; remove&#xA;        rowsToMove.Add(cRow);&#xA;        rowsToRemove.Add(cRow);&#xA;        for (int ii = 0; ii &lt; chosenDebs.Count; ii++)&#xA;        {&#xA;            rowsToMove.Add(chosenDebs[ii]);&#xA;            rowsToRemove.Add(chosenDebs[ii]);&#xA;        }&#xA;&#xA;        bundlesMoved++;&#xA;        matchedThisGroup = true;&#xA;        // Only move one bundle per group in this pass&#xA;    }&#xA;}&#xA;&#xA;// ---------- Move &amp; remove ----------&#xA;for (int i = 0; i &lt; rowsToMove.Count; i++)&#xA;    dtHistoricalReconTransactionsReportMatched.ImportRow(rowsToMove[i]);&#xA;for (int i = 0; i &lt; rowsToRemove.Count; i++)&#xA;    dtHistoricalReconTransactionsReport.Rows.Remove(rowsToRemove[i]);&#xA;&#xA;dtHistoricalReconTransactionsReport.AcceptChanges(
        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath Invoke Code: Scalable Rounding Error Inserter =====&#xA;// Works now with only roundingErrorPPAT. Add future components by appending to `components` list.&#xA;&#xA;// Args (In/Out): dtHistoricalReconTransactionsReport (DataTable)&#xA;// Args (In): reconDate (object), reconCurrency (string), roundingErrorPPAT (decimal)&#xA;&#xA;// ---------- Helpers ----------&#xA;System.DateTime? ParseDateFlexible(object val)&#xA;{&#xA;    if (val == null || val == System.DBNull.Value) return null;&#xA;    if (val is System.DateTime dt) return dt;&#xA;&#xA;    if (val is double d) { try { return System.DateTime.FromOADate(d); } catch { } }&#xA;&#xA;    var s = val.ToString().Trim();&#xA;    if (string.IsNullOrEmpty(s)) return null;&#xA;&#xA;    if (double.TryParse(s, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d2))&#xA;    { try { return System.DateTime.FromOADate(d2); } catch { } }&#xA;&#xA;    string[] fmts = new string[]&#xA;    {&#xA;        &quot;dd-MMM-yyyy&quot;,  // 29-Jul-2025&#xA;        &quot;yyyy-MM-dd&quot;,   // 2025-07-29&#xA;        &quot;dd/MM/yyyy&quot;,&#xA;        &quot;yyyy/MM/dd&quot;,&#xA;        &quot;dd-MM-yyyy&quot;,&#xA;        &quot;MM/dd/yyyy&quot;,&#xA;        &quot;dd MMM yyyy&quot;&#xA;    };&#xA;&#xA;    if (System.DateTime.TryParseExact(s, fmts, System.Globalization.CultureInfo.InvariantCulture,&#xA;        System.Globalization.DateTimeStyles.None, out var exact)) return exact;&#xA;&#xA;    if (System.DateTime.TryParse(s, System.Globalization.CultureInfo.InvariantCulture,&#xA;        System.Globalization.DateTimeStyles.None, out var flex)) return flex;&#xA;&#xA;    return null;&#xA;}&#xA;&#xA;void EnsureColumn(System.Data.DataTable t, string name, System.Type type, object defaultValue)&#xA;{&#xA;    if (!t.Columns.Contains(name))&#xA;    {&#xA;        var col = new System.Data.DataColumn(name, type);&#xA;        if (defaultValue != null) col.DefaultValue = defaultValue;&#xA;        t.Columns.Add(col);&#xA;        if (defaultValue != null)&#xA;            foreach (System.Data.DataRow r in t.Rows) r[name] = defaultValue;&#xA;    }&#xA;}&#xA;&#xA;int GetNextSNO(System.Data.DataTable t)&#xA;{&#xA;    if (!t.Columns.Contains(&quot;SNO&quot;)) return 1;&#xA;    int max = 0;&#xA;    foreach (System.Data.DataRow r in t.Rows)&#xA;    {&#xA;        var v = r[&quot;SNO&quot;];&#xA;        if (v == null || v == System.DBNull.Value) continue;&#xA;        if (v is int i) { if (i &gt; max) max = i; }&#xA;        else if (int.TryParse(v.ToString(), out var parsed) &amp;&amp; parsed &gt; max) max = parsed;&#xA;    }&#xA;    return max + 1;&#xA;}&#xA;&#xA;// ---------- Main ----------&#xA;{&#xA;    // 1) Define all rounding components here. Start with PPAT; add more later.&#xA;    var components = new System.Collections.Generic.List&lt;System.Tuple&lt;string, decimal&gt;&gt;&#xA;    {&#xA;        System.Tuple.Create(&quot;roundingErrorPPAT&quot;, roundingErrorPPAT),&#xA;    };&#xA;&#xA;    // 2) Filter to only non-zero (beyond tolerance) components for logging/classification&#xA;    decimal tol = 0.0005m; // tiny numerical noise filter&#xA;    var nonZero = new System.Collections.Generic.List&lt;System.Tuple&lt;string, decimal&gt;&gt;();&#xA;    foreach (var c in components)&#xA;        if (System.Math.Abs(c.Item2) &gt; tol) nonZero.Add(c);&#xA;&#xA;    // 3) Compute total rounding error&#xA;    decimal totalRoundingError = 0m;&#xA;    foreach (var c in components) totalRoundingError += c.Item2;&#xA;&#xA;    // 4) Build a readable breakdown (for logs &amp; narration)&#xA;    string breakdown = nonZero.Count == 0&#xA;        ? &quot;none&quot;&#xA;        : string.Join(&quot;, &quot;, nonZero.ConvertAll(x =&gt; $&quot;{x.Item1}={x.Item2:N2}&quot;));&#xA;&#xA;    // 5) Log&#xA;    System.Console.WriteLine(&quot;\n=== 🔍 Rounding Error Summary (Scalable) ===&quot;);&#xA;    foreach (var c in components)&#xA;        System.Console.WriteLine($&quot;↳ {c.Item1,-36} {c.Item2,12:N2}&quot;);&#xA;    System.Console.WriteLine($&quot;🧮 Total Rounding Error:                 {totalRoundingError:N2}&quot;);&#xA;&#xA;    // 6) Date parsing (store DateTime; display as dd-MMM-yyyy)&#xA;    var rd = ParseDateFlexible(reconDate) ?? System.DateTime.Today;&#xA;    string dateStrDisplay = rd.ToString(&quot;dd-MMM-yyyy&quot;);&#xA;&#xA;    // 7) Ensure required columns&#xA;    string creditCol = $&quot;Credit ({reconCurrency})&quot;;&#xA;    string debitCol  = $&quot;Debit ({reconCurrency})&quot;;&#xA;&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, &quot;SNO&quot;, typeof(int), null);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Branch code&quot;, typeof(string), &quot;&quot;);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, &quot;GL_Code&quot;, typeof(string), &quot;&quot;);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, &quot;GL Description&quot;, typeof(string), &quot;&quot;);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Booking Date&quot;, typeof(System.DateTime), System.DateTime.MinValue);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Value Date&quot;, typeof(System.DateTime), System.DateTime.MinValue);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Transaction Ref No:&quot;, typeof(string), &quot;&quot;);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Narration&quot;, typeof(string), &quot;&quot;);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, creditCol, typeof(decimal), 0m);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, debitCol,  typeof(decimal), 0m);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Root Cause&quot;, typeof(string), &quot;&quot;);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Root Cause Category&quot;, typeof(string), &quot;&quot;);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Recommended Action&quot;, typeof(string), &quot;&quot;);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Action Owner&quot;, typeof(string), &quot;&quot;);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Classification&quot;, typeof(string), &quot;&quot;);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Aging&quot;, typeof(string), &quot;&quot;);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Aging Group&quot;, typeof(string), &quot;&quot;);&#xA;    EnsureColumn(dtHistoricalReconTransactionsReport, &quot;BOT Classification&quot;, typeof(string), &quot;&quot;);&#xA;&#xA;    // 8) Only insert when outside tolerance&#xA;    if (System.Math.Abs(totalRoundingError) &gt; 0.005m)&#xA;    {&#xA;        var row = dtHistoricalReconTransactionsReport.NewRow();&#xA;&#xA;        int newSNO = GetNextSNO(dtHistoricalReconTransactionsReport);&#xA;        row[&quot;SNO&quot;] = newSNO;&#xA;        row[&quot;Branch code&quot;] = &quot;101&quot;;&#xA;        row[&quot;GL_Code&quot;] = &quot;202030015&quot;;&#xA;        row[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;&#xA;        row[&quot;Booking Date&quot;] = rd;&#xA;        row[&quot;Value Date&quot;] = rd;&#xA;&#xA;        row[&quot;Transaction Ref No:&quot;] = System.DBNull.Value;&#xA;&#xA;        // Narration with dd-MMM-yyyy&#xA;        row[&quot;Narration&quot;] = $&quot;Rounding error on CMS taxes and charge {dateStrDisplay} (components: {breakdown})&quot;;&#xA;&#xA;        // Excel-position based formulas&#xA;        int excelRow = newSNO + 5;&#xA;        row[&quot;Aging&quot;] = &quot;=$H$6-G&quot; + excelRow;&#xA;        row[&quot;Aging Group&quot;] =&#xA;            &quot;=IF(L&quot; + excelRow + &quot;&lt;4,\&quot;0-3 Days\&quot;,IF(L&quot; + excelRow + &quot;&lt;31,\&quot;4-30 Days\&quot;,IF(L&quot; + excelRow + &quot;&lt;61,\&quot;31-60 Days\&quot;,IF(L&quot; + excelRow + &quot;&lt;=90,\&quot;61-90 Days\&quot;,IF(L&quot; + excelRow + &quot;&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;        row[&quot;BOT Classification&quot;] =&#xA;            &quot;=IF(J&quot; + excelRow + &quot;&gt;0,IF(L&quot; + excelRow + &quot;&lt;30,\&quot;Normal\&quot;,IF(L&quot; + excelRow + &quot;&lt;60,\&quot;Especially Mentioned\&quot;,IF(L&quot; + excelRow + &quot;&lt;90,\&quot;Substandard\&quot;,IF(L&quot; + excelRow + &quot;&lt;=180,\&quot;Doubtful\&quot;,IF(L&quot; + excelRow + &quot;&gt;180,\&quot;Loss\&quot;,\&quot;0\&quot;)))))),\&quot;Not Applicable\&quot;)&quot;;&#xA;&#xA;        // Always DEBIT only&#xA;        row[debitCol] = System.Math.Abs(totalRoundingError);&#xA;        row[creditCol] = 0m;&#xA;&#xA;        row[&quot;Root Cause&quot;] = &quot;Rounding Error&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;To be realized as other expense&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;&#xA;        string classification = (nonZero.Count == 1) ? nonZero[0].Item1 : &quot;roundingError:MIXED&quot;;&#xA;        row[&quot;Classification&quot;] = classification;&#xA;&#xA;        dtHistoricalReconTransactionsReport.Rows.Add(row);&#xA;&#xA;        System.Console.WriteLine(&quot;\n📋 Inserted Rounding Correction Row:&quot;);&#xA;        System.Console.WriteLine($&quot; - Date:         {rd:dd-MMM-yyyy}&quot;);&#xA;        System.Console.WriteLine($&quot; - Components:   {breakdown}&quot;);&#xA;        System.Console.WriteLine($&quot; - Debit ({reconCurrency}):  {row[debitCol]}&quot;);&#xA;        System.Console.WriteLine($&quot; - Credit ({reconCurrency}): {row[creditCol]}&quot;);&#xA;        System.Console.WriteLine($&quot; - Classification: {classification}&quot;);&#xA;        System.Console.WriteLine($&quot; - Excel row:    {excelRow}&quot;);&#xA;    }&#xA;    else&#xA;    {&#xA;        System.Console.WriteLine(&quot;✅ No rounding error adjustment needed (
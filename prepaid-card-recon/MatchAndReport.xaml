        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: PPAT Reconciliation (NO LOGS) ====&#xA;// Args (In):      string reconCurrency&#xA;// Args (In/Out):  DataTable dtHistoricalReconTransactionsReport, DataTable dtHistoricalReconTransactionsReportMatched&#xA;// Args (Out):     decimal roundingErrorPPAT&#xA;&#xA;var sw = System.Diagnostics.Stopwatch.StartNew();&#xA;&#xA;// ---------------- Config ----------------&#xA;decimal absTol     = 0.10m;  // match if |PPAT_total − CMS_total| &lt;= absTol&#xA;decimal balanceTol = 0.01m;  // identity tolerance&#xA;&#xA;// ---------------- Helpers ----------------&#xA;bool WithinTol(decimal a, decimal b) =&gt; System.Math.Abs(a - b) &lt;= absTol;&#xA;&#xA;decimal ParseAmount(object v)&#xA;{&#xA;    if (v == null || v == System.DBNull.Value) return 0m;&#xA;    var s = v.ToString().Trim();&#xA;    if (string.IsNullOrEmpty(s)) return 0m;&#xA;    s = s.Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;);&#xA;    decimal d;&#xA;    return decimal.TryParse(s, out d) ? d : 0m;&#xA;}&#xA;&#xA;string Left(string s, int n)&#xA;{&#xA;    if (s == null) return &quot;&quot;;&#xA;    return s.Length &lt;= n ? s : s.Substring(0, n);&#xA;}&#xA;&#xA;decimal RowMagnitude(System.Data.DataRow r, string debitCol, string creditCol)&#xA;{&#xA;    var d = ParseAmount(r[debitCol]);&#xA;    var c = ParseAmount(r[creditCol]);&#xA;    return System.Math.Abs(d) + System.Math.Abs(c);&#xA;}&#xA;&#xA;// Normalize masked PANs in narration -&gt; 6 digits + XXXXXX + last4&#xA;string NormalizeMaskedPansInText(string text)&#xA;{&#xA;    if (string.IsNullOrEmpty(text)) return text;&#xA;    string replaced = System.Text.RegularExpressions.Regex.Replace(&#xA;        text, @&quot;\b(?&lt;bin&gt;\d{6})\D{4,10}(?&lt;last4&gt;\d{4})\b&quot;,&#xA;        m =&gt; m.Groups[&quot;bin&quot;].Value + &quot;XXXXXX&quot; + m.Groups[&quot;last4&quot;].Value);&#xA;&#xA;    replaced = System.Text.RegularExpressions.Regex.Replace(&#xA;        replaced, @&quot;\b(?&lt;bin&gt;\d{6})[Xx]{6}(?&lt;last4&gt;\d{4})\b&quot;,&#xA;        m =&gt; m.Groups[&quot;bin&quot;].Value + &quot;XXXXXX&quot; + m.Groups[&quot;last4&quot;].Value);&#xA;&#xA;    return replaced;&#xA;}&#xA;&#xA;// == RRN extractors ==&#xA;string AlnumUpper(string raw)&#xA;{&#xA;    if (string.IsNullOrEmpty(raw)) return &quot;&quot;;&#xA;    System.Text.StringBuilder alnum = new System.Text.StringBuilder(raw.Length);&#xA;    for (int i = 0; i &lt; raw.Length; i++)&#xA;    {&#xA;        char ch = raw[i];&#xA;        if ((ch &gt;= '0' &amp;&amp; ch &lt;= '9') ||&#xA;            (ch &gt;= 'A' &amp;&amp; ch &lt;= 'Z') ||&#xA;            (ch &gt;= 'a' &amp;&amp; ch &lt;= 'z'))&#xA;            alnum.Append(char.ToUpperInvariant(ch));&#xA;    }&#xA;    return alnum.ToString();&#xA;}&#xA;&#xA;string Last12Alnum(string raw)&#xA;{&#xA;    string s = AlnumUpper(raw);&#xA;    if (s.Length &gt;= 12) return s.Substring(s.Length - 12, 12);&#xA;    return s;&#xA;}&#xA;&#xA;string ExtractRrnFromNarr_Smart(string narrationRaw)&#xA;{&#xA;    string narration = narrationRaw ?? &quot;&quot;;&#xA;&#xA;    var hy = System.Text.RegularExpressions.Regex.Matches(narration, @&quot;(?&lt;=-)[A-Za-z0-9]{12}(?=-)&quot;);&#xA;    if (hy.Count &gt; 0)&#xA;    {&#xA;        for (int i = hy.Count - 1; i &gt;= 0; i--)&#xA;        {&#xA;            var v = hy[i].Value.ToUpperInvariant();&#xA;            if (System.Text.RegularExpressions.Regex.IsMatch(v, @&quot;^\d{12}$&quot;)) return v;&#xA;        }&#xA;        return hy[hy.Count - 1].Value.ToUpperInvariant();&#xA;    }&#xA;&#xA;    var tok = System.Text.RegularExpressions.Regex.Matches(narration, @&quot;\b([A-Za-z0-9]{12})\b&quot;);&#xA;    if (tok.Count &gt; 0)&#xA;    {&#xA;        for (int i = tok.Count - 1; i &gt;= 0; i--)&#xA;        {&#xA;            var v = tok[i].Groups[1].Value.ToUpperInvariant();&#xA;            if (System.Text.RegularExpressions.Regex.IsMatch(v, @&quot;^\d{12}$&quot;)) return v;&#xA;        }&#xA;        return tok[tok.Count - 1].Groups[1].Value.ToUpperInvariant();&#xA;    }&#xA;&#xA;    var run = System.Text.RegularExpressions.Regex.Matches(narration, @&quot;[A-Za-z0-9]{12,}&quot;);&#xA;    if (run.Count &gt; 0)&#xA;    {&#xA;        string last = run[run.Count - 1].Value.ToUpperInvariant();&#xA;        var digs = System.Text.RegularExpressions.Regex.Matches(last, @&quot;\d{12}&quot;);&#xA;        if (digs.Count &gt; 0) return digs[digs.Count - 1].Value;&#xA;        return last.Substring(last.Length - 12, 12);&#xA;    }&#xA;&#xA;    return &quot;&quot;;&#xA;}&#xA;&#xA;// == Classification rules ==&#xA;bool IsPpatSide(string trn) =&gt;&#xA;    !string.IsNullOrEmpty(trn) &amp;&amp;&#xA;    (trn.IndexOf(&quot;PPAT&quot;, System.StringComparison.OrdinalIgnoreCase) &gt;= 0 || trn.IndexOf(&quot;AWPC&quot;, System.StringComparison.OrdinalIgnoreCase) &gt;= 0);&#xA;&#xA;int CmsPrefixId(string narration)&#xA;{&#xA;    if (string.IsNullOrEmpty(narration)) return 0;&#xA;    string n = narration.Trim();&#xA;&#xA;    if (n.StartsWith(&quot;Cash Advance/ Cash at POS / Cash Out Transaction Fee&quot;,&#xA;        System.StringComparison.OrdinalIgnoreCase)) return 2;&#xA;&#xA;    if (n.StartsWith(&quot;Cash Advance/ Cash at POS / Cash Out&quot;,&#xA;        System.StringComparison.OrdinalIgnoreCase)) return 1;&#xA;&#xA;    if (n.StartsWith(&quot;Service Tax/Tax On Income&quot;,&#xA;        System.StringComparison.OrdinalIgnoreCase)) return 3;&#xA;&#xA;    return 0;&#xA;}&#xA;&#xA;bool IsCmsSide(string narration) =&gt; CmsPrefixId(narration) != 0;&#xA;&#xA;&#xA;// ---------------- Guards ----------------&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport));&#xA;&#xA;string debitCol  = &quot;Debit (&quot; + reconCurrency + &quot;)&quot;;&#xA;string creditCol = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(debitCol))&#xA;    throw new Exception(&quot;Missing column: &quot; + debitCol);&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(creditCol))&#xA;    throw new Exception(&quot;Missing column: &quot; + creditCol);&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Narration&quot;))&#xA;    throw new Exception(&quot;Missing column: Narration&quot;);&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Transaction Ref No:&quot;))&#xA;    throw new Exception(&quot;Missing column: Transaction Ref No:&quot;);&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;RRN&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;RRN&quot;, typeof(string));&#xA;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Classification&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;&#xA;if (dtHistoricalReconTransactionsReportMatched == null ||&#xA;    dtHistoricalReconTransactionsReportMatched.Columns.Count != dtHistoricalReconTransactionsReport.Columns.Count)&#xA;{&#xA;    dtHistoricalReconTransactionsReportMatched = dtHistoricalReconTransactionsReport.Clone();&#xA;}&#xA;&#xA;if (!dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Classification&quot;))&#xA;    dtHistoricalReconTransactionsReportMatched.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;&#xA;// ---------------- BEFORE totals ----------------&#xA;decimal beforeDebit = 0m, beforeCredit = 0m;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    beforeDebit  += ParseAmount(r[debitCol]);&#xA;    beforeCredit += ParseAmount(r[creditCol]);&#xA;}&#xA;decimal beforeDiff = beforeDebit - beforeCredit;&#xA;&#xA;// ---------------- Prepass: PAN normalisation + RRN computation ----------------&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var row = dtHistoricalReconTransactionsReport.Rows[i];&#xA;&#xA;    string narrRaw = row[&quot;Narration&quot;] == null ? &quot;&quot; : row[&quot;Narration&quot;].ToString();&#xA;    row[&quot;Narration&quot;] = NormalizeMaskedPansInText(narrRaw);&#xA;&#xA;    var rrnCellRaw = row[&quot;RRN&quot;] == null ? &quot;&quot; : row[&quot;RRN&quot;].ToString().Trim();&#xA;    string rrnCell12 = &quot;&quot;;&#xA;&#xA;    if (!string.IsNullOrEmpty(rrnCellRaw))&#xA;    {&#xA;        if (System.Text.RegularExpressions.Regex.IsMatch(rrnCellRaw, @&quot;^[A-Za-z0-9]{12}$&quot;))&#xA;            rrnCell12 = rrnCellRaw.ToUpperInvariant();&#xA;        else&#xA;            rrnCell12 = Last12Alnum(rrnCellRaw);&#xA;    }&#xA;&#xA;    string rrnNarr12 = ExtractRrnFromNarr_Smart(row[&quot;Narration&quot;].ToString());&#xA;&#xA;    string rrnFinal =&#xA;        (!string.IsNullOrEmpty(rrnCell12) &amp;&amp; rrnCell12.Length == 12) ? rrnCell12 :&#xA;        (!string.IsNullOrEmpty(rrnNarr12) &amp;&amp; rrnNarr12.Length == 12) ? rrnNarr12 :&#xA;        Last12Alnum(!string.IsNullOrEmpty(rrnCell12) ? rrnCell12 : rrnNarr12);&#xA;&#xA;    row[&quot;RRN&quot;] = rrnFinal;&#xA;}&#xA;&#xA;// ---------------- Build groups (RRN → row indexes) ----------------&#xA;var groups = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;int&gt;&gt;(&#xA;    System.StringComparer.OrdinalIgnoreCase);&#xA;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var row = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    string rrn = row[&quot;RRN&quot;] == null ? &quot;&quot; : row[&quot;RRN&quot;].ToString();&#xA;    string trn = row[&quot;Transaction Ref No:&quot;] == null ? &quot;&quot; : row[&quot;Transaction Ref No:&quot;].ToString();&#xA;    string narr = row[&quot;Narration&quot;] == null ? &quot;&quot; : row[&quot;Narration&quot;].ToString();&#xA;&#xA;    bool take = IsPpatSide(trn) || IsCmsSide(narr);&#xA;    if (!take) continue;&#xA;&#xA;    if (string.IsNullOrEmpty(rrn) || rrn.Length != 12) continue;&#xA;&#xA;    if (!groups.ContainsKey(rrn))&#xA;        groups[rrn] = new System.Collections.Generic.List&lt;int&gt;();&#xA;&#xA;    groups[rrn].Add(i);&#xA;}&#xA;&#xA;// ---------------- Reconcile per RRN ----------------&#xA;roundingErrorPPAT = 0m;&#xA;var toRemove = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;&#xA;foreach (var kv in groups)&#xA;{&#xA;    var rrn = kv.Key;&#xA;    var idxs = kv.Value;&#xA;&#xA;    decimal leftTotal = 0m, rightTotal = 0m;&#xA;    int leftCnt = 0, rightCnt = 0;&#xA;&#xA;    for (int k = 0; k &lt; idxs.Count; k++)&#xA;    {&#xA;        var r = dtHistoricalReconTransactionsReport.Rows[idxs[k]];&#xA;        var trn  = r[&quot;Transaction Ref No:&quot;] == null ? &quot;&quot; : r[&quot;Transaction Ref No:&quot;].ToString();&#xA;        var narr = r[&quot;Narration&quot;] == null ? &quot;&quot; : r[&quot;Narration&quot;].ToString();&#xA;        var d = ParseAmount(r[debitCol]);&#xA;        var c = ParseAmount(r[creditCol]);&#xA;        var mag = System.Math.Abs(d) + System.Math.Abs(c);&#xA;&#xA;        int pfxId = CmsPrefixId(narr);&#xA;&#xA;        if (IsPpatSide(trn))&#xA;        {&#xA;            leftTotal += mag;&#xA;            leftCnt++;&#xA;        }&#xA;        else if (pfxId != 0)&#xA;        {&#xA;            rightTotal += mag;&#xA;            rightCnt++;&#xA;        }&#xA;    }&#xA;&#xA;    if (leftCnt == 0 || rightCnt == 0)&#xA;        continue;&#xA;&#xA;    var delta = leftTotal - rightTotal;&#xA;&#xA;    if (WithinTol(leftTotal, rightTotal))&#xA;    {&#xA;        for (int k = 0; k &lt; idxs.Count; k++)&#xA;        {&#xA;            var srcRow = dtHistoricalReconTransactionsReport.Rows[idxs[k]];&#xA;            var trn  = srcRow[&quot;Transaction Ref No:&quot;].ToString();&#xA;            var narr = srcRow[&quot;Narration&quot;].ToString();&#xA;&#xA;            if (!(IsPpatSide(trn) || IsCmsSide(narr)))&#xA;                continue;&#xA;&#xA;            var dest = dtHistoricalReconTransactionsReportMatched.NewRow();&#xA;            for (int j = 0; j &lt; dtHistoricalReconTransactionsReportMatched.Columns.Count; j++)&#xA;            {&#xA;                var col = dtHistoricalReconTransactionsReportMatched.Columns[j];&#xA;                if (dtHistoricalReconTransactionsReport.Columns.Contains(col.ColumnName))&#xA;                    dest[col.ColumnName] = srcRow[col.ColumnName];&#xA;            }&#xA;            dest[&quot;Classification&quot;] = &quot;PPAT&quot;;&#xA;&#xA;            dtHistoricalReconTransactionsReportMatched.Rows.Add(dest);&#xA;            toRemove.Add(srcRow);&#xA;        }&#xA;&#xA;        roundingErrorPPAT += delta;&#xA;    }&#xA;}&#xA;&#xA;// ---------------- REMOVED totals ----------------&#xA;decimal removedDebit = 0m, removedCredit = 0m;&#xA;for (int i = 0; i &lt; toRemove.Count; i++)&#xA;{&#xA;    var r = toRemove[i];&#xA;    removedDebit  += ParseAmount(r[debitCol]);&#xA;    removedCredit += ParseAmount(r[creditCol]);&#xA;}&#xA;decimal removedDiff = removedDebit - removedCredit;&#xA;&#xA;// ---------------- Remove matched rows ----------------&#xA;for (int i = 0; i &lt; toRemove.Count; i++)&#xA;{&#xA;    var r = toRemove[i];&#xA;    if (r != null &amp;&amp;&#xA;        r.Table == dtHistoricalReconTransactionsReport &amp;&amp;&#xA;        r.RowState != System.Data.DataRowState.Detached)&#xA;    {&#xA;        dtHistoricalReconTransactionsReport.Rows.Remove(r);&#xA;    }&#xA;}&#xA;&#xA;dtHistoricalReconTransactionsReport.AcceptChanges();&#xA;dtHistoricalReconTransactionsReportMatched.AcceptChanges();&#xA;&#xA;// ---------------- AFTER totals ----------------&#xA;decimal afterDebit = 0m, afterCredit = 0m;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    afterDebit  += ParseAmount(r[debitCol]);&#xA;    afterCredit += ParseAmount(r[creditCol]);&#xA;}&#xA;&#xA;decimal afterDiff = afterDebit - afterCredit;&#xA;&#xA;// authoritative: rounding error = net removed&#xA;roundingErrorPPAT = decimal.Round(removedDiff, 2, System.MidpointRounding.AwayFromZero);&#xA;&#xA;sw.Stop();&#xA;" DisplayName="PPAT + roundingErrorPPAT" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_83" Language="CSharp">
          <ui:InvokeCode.Arguments>
            <InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtHistoricalReconTransactionsReport">[dtHistoricalReconTransactionsReport]</InOutArgument>

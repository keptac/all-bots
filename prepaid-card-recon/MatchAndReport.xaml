        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ==== UiPath C# Invoke Code: PPSA exchange gain/loss (RRN-only) — fee-excluded, moves pairs (±2-day Value Date window) ====&#xA;// Args (In):     string reconCurrency&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport, DataTable dtHistoricalReconTransactionsReportMatched&#xA;// Args (Out):    decimal exchangeGainOrLossPPSA&#xA;//&#xA;// Notes:&#xA;// - PAN &amp; RRN are extracted STRICTLY from Narration (per your rule).&#xA;// - Strict C_PAN rule: from Narration, find token starting with 550558 and ending with 4 digits&#xA;//   and normalize to 550558XXXXXX####.&#xA;// - C_PAN is FORCED from Narration for both GL PPSA rows and CMS principal rows (when found).&#xA;// - Matching key is RRN ONLY (12 [A-Za-z0-9] from CMS RRN column).&#xA;// - GL side uses RRN extracted from Narration to look up that RRN key.&#xA;// - A match REQUIRES CMS.Value Date within ±2 days of GL.Value Date.&#xA;// - On match: both rows are IMPORTed into *Matched* table and REMOVEd from the working table.&#xA;// - Fee/Income rows are excluded from CMS principal index using exact word/phrase detection.&#xA;// - Totals &amp; Δ checks logged; exchangeGainOrLossPPSA is net removed Δ, rounded to 2dp.&#xA;&#xA;var sw = System.Diagnostics.Stopwatch.StartNew();&#xA;System.Console.WriteLine($&quot;🚀 PPSA exchange gain/loss started at {System.DateTime.Now:yyyy-MM-dd HH:mm:ss}&quot;);&#xA;&#xA;// ===== Guards &amp; setup =====&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport), &quot;Input DataTable cannot be null&quot;);&#xA;&#xA;if (dtHistoricalReconTransactionsReportMatched == null ||&#xA;    dtHistoricalReconTransactionsReportMatched.Columns.Count != dtHistoricalReconTransactionsReport.Columns.Count)&#xA;{&#xA;    dtHistoricalReconTransactionsReportMatched = dtHistoricalReconTransactionsReport.Clone();&#xA;}&#xA;&#xA;// Column wiring&#xA;string currency = reconCurrency;&#xA;string colDebit  = $&quot;Debit ({currency})&quot;;&#xA;string colCredit = $&quot;Credit ({currency})&quot;;&#xA;&#xA;bool hasNarration = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Narration&quot;);&#xA;bool hasTrnRef    = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Transaction Ref No:&quot;);&#xA;bool hasChannel   = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Channel&quot;);&#xA;bool hasCpan      = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;C_PAN&quot;);&#xA;bool hasRrn       = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;RRN&quot;);&#xA;bool hasDebit     = dtHistoricalReconTransactionsReport.Columns.Contains(colDebit);&#xA;bool hasCredit    = dtHistoricalReconTransactionsReport.Columns.Contains(colCredit);&#xA;bool hasValueDate = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Value Date&quot;);&#xA;&#xA;// Ensure Classification exists (source &amp; matched tables)&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Classification&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Classification&quot;))&#xA;    dtHistoricalReconTransactionsReportMatched.Columns.Add(&quot;Classification&quot;, typeof(string));&#xA;&#xA;// ===== Helpers =====&#xA;string Val(object o) =&gt; (o == null || o == DBNull.Value) ? &quot;&quot; : o.ToString();&#xA;&#xA;decimal ParseAmountSafe(System.Data.DataRow r, string colName)&#xA;{&#xA;    if (r == null || string.IsNullOrEmpty(colName)) return 0m;&#xA;    if (!r.Table.Columns.Contains(colName)) return 0m;&#xA;    var v = r[colName];&#xA;    if (v == null || v == DBNull.Value) return 0m;&#xA;    var s = v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;);&#xA;    if (s.Length == 0) return 0m;&#xA;    if (s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;)) s = &quot;-&quot; + s.Substring(1, s.Length - 2);&#xA;    return decimal.TryParse(s, System.Globalization.NumberStyles.Any,&#xA;        System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0m;&#xA;}&#xA;&#xA;bool StartsWithIgnore(string text, string prefix) =&gt;&#xA;    text != null &amp;&amp; text.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);&#xA;bool EqualsIgnore(string a, string b) =&gt;&#xA;    string.Equals(a ?? &quot;&quot;, b ?? &quot;&quot;, System.StringComparison.OrdinalIgnoreCase);&#xA;string ToUpperStr(string s) =&gt; (s ?? &quot;&quot;).ToUpperInvariant();&#xA;&#xA;void SumDebitCreditTable(System.Data.DataTable dt, out decimal d, out decimal c)&#xA;{&#xA;    d = 0m; c = 0m;&#xA;    for (int i = 0; i &lt; dt.Rows.Count; i++)&#xA;    {&#xA;        d += ParseAmountSafe(dt.Rows[i], colDebit);&#xA;        c += ParseAmountSafe(dt.Rows[i], colCredit);&#xA;    }&#xA;}&#xA;&#xA;// === Exact word/phrase fee/income detection (no FEETZ, etc.) ===&#xA;bool HasFeeOrIncomeTokens(string narr)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(narr)) return false;&#xA;    string u = narr.ToUpperInvariant();&#xA;&#xA;    // Phrase matches&#xA;    if (u.Contains(&quot;SERVICE TAX&quot;) || u.Contains(&quot;TAX ON INCOME&quot;))&#xA;        return true;&#xA;&#xA;    // Tokenized word matches: FEE, FEES, INCOME&#xA;    var tokens = System.Text.RegularExpressions.Regex.Split(u, @&quot;[^A-Z0-9]+&quot;);&#xA;    for (int i = 0; i &lt; tokens.Length; i++)&#xA;    {&#xA;        var t = tokens[i];&#xA;        if (t == &quot;FEE&quot; || t == &quot;FEES&quot; || t == &quot;INCOME&quot;)&#xA;            return true;&#xA;    }&#xA;    return false;&#xA;}&#xA;&#xA;// Strict C_PAN from Narration: token starting with 550558 and ending with 4 digits → 550558XXXXXX####.&#xA;string ExtractStrictPanFromNarration(string narr)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(narr)) return &quot;&quot;;&#xA;    var m = System.Text.RegularExpressions.Regex.Match(&#xA;        narr,&#xA;        @&quot;\b(550558)[0-9Xx\*]{6}(\d{4})\b&quot;&#xA;    );&#xA;    if (!m.Success) return &quot;&quot;;&#xA;    return m.Groups[1].Value + &quot;XXXXXX&quot; + m.Groups[2].Value;&#xA;}&#xA;&#xA;// RRN extractor: first exact 12 [A-Za-z0-9] token, uppercased.&#xA;string ExtractRrn12(string text)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(text)) return &quot;&quot;;&#xA;    var m = System.Text.RegularExpressions.Regex.Match(text, @&quot;\b[A-Za-z0-9]{12}\b&quot;);&#xA;    return m.Success ? m.Value.ToUpperInvariant() : &quot;&quot;;&#xA;}&#xA;&#xA;// Date parser tolerant to DateTime, OADate doubles/strings, and common string formats&#xA;System.DateTime? ParseDateFlexible(object val)&#xA;{&#xA;    if (val == null || val == System.DBNull.Value) return null;&#xA;&#xA;    if (val is System.DateTime dt) return dt.Date;&#xA;&#xA;    if (val is double d)&#xA;    {&#xA;        try { return System.DateTime.FromOADate(d).Date; } catch { /* ignore */ }&#xA;    }&#xA;    if (double.TryParse(val.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d2))&#xA;    {&#xA;        try { return System.DateTime.FromOADate(d2).Date; } catch { /* ignore */ }&#xA;    }&#xA;&#xA;    var s = val.ToString().Trim();&#xA;    if (s.Length == 0) return null;&#xA;&#xA;    string[] fmts = new[] {&#xA;        &quot;dd/MM/yyyy HH:mm:ss&quot;,&quot;dd/MM/yyyy HH:mm&quot;,&quot;dd/MM/yyyy&quot;,&#xA;        &quot;yyyy-MM-dd HH:mm:ss&quot;,&quot;yyyy-MM-dd&quot;,&quot;yyyy/MM/dd&quot;,&#xA;        &quot;dd-MMM-yyyy&quot;,&quot;d-MMM-yyyy&quot;,&quot;MM/dd/yyyy&quot;,&quot;M/d/yyyy&quot;&#xA;    };&#xA;    if (System.DateTime.TryParseExact(s, fmts, System.Globalization.CultureInfo.InvariantCulture,&#xA;                                      System.Globalization.DateTimeStyles.None, out var exact))&#xA;        return exact.Date;&#xA;&#xA;    // last resort&#xA;    if (System.DateTime.TryParse(s, out var looser)) return looser.Date;&#xA;    return null;&#xA;}&#xA;&#xA;bool IsCmsEligible(System.Data.DataRow r)&#xA;{&#xA;    string narr = Val(r[&quot;Narration&quot;]);&#xA;    string chan = hasChannel ? Val(r[&quot;Channel&quot;]) : &quot;&quot;;&#xA;&#xA;    if (HasFeeOrIncomeTokens(narr)) return false; // exact word/phrase-based&#xA;&#xA;    // principal-like CMS rows (common types)&#xA;    return (StartsWithIgnore(narr, &quot;Cash Withdrawal&quot;) &amp;&amp; !EqualsIgnore(chan, &quot;API&quot;)) ||&#xA;           (StartsWithIgnore(narr, &quot;Purchase/Auth Completion&quot;) &amp;&amp; !EqualsIgnore(chan, &quot;API&quot;)) ||&#xA;           (StartsWithIgnore(narr, &quot;Unique Txn&quot;) &amp;&amp; !EqualsIgnore(chan, &quot;API&quot;)) ||&#xA;           (StartsWithIgnore(narr, &quot;Recurring Transaction&quot;) &amp;&amp; !EqualsIgnore(chan, &quot;API&quot;));&#xA;}&#xA;&#xA;decimal CmsPrincipalAmount(System.Data.DataRow r)&#xA;{&#xA;    decimal cr = ParseAmountSafe(r, colCredit);&#xA;    decimal dr = ParseAmountSafe(r, colDebit);&#xA;    return (cr &gt; 0m) ? cr : (dr &gt; 0m ? dr : 0m);&#xA;}&#xA;&#xA;int AbsDays(System.DateTime a, System.DateTime b)&#xA;{&#xA;    return System.Math.Abs((a - b).Days);&#xA;}&#xA;&#xA;// ===== BEFORE totals =====&#xA;SumDebitCreditTable(dtHistoricalReconTransactionsReport, out var beforeDebit, out var beforeCredit);&#xA;var beforeDiff = beforeDebit - beforeCredit;&#xA;System.Console.WriteLine($&quot;[BAL] BEFORE — Debit {beforeDebit:N2}, Credit {beforeCredit:N2}, Δ(D−C): {beforeDiff:N2}&quot;);&#xA;&#xA;// ===== Build CMS index (RRN -&gt; list of candidate principal rows) =====&#xA;var cmsIndex = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;(System.StringComparer.OrdinalIgnoreCase);&#xA;if (hasRrn)&#xA;{&#xA;    for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;    {&#xA;        var row = dtHistoricalReconTransactionsReport.Rows[i];&#xA;        if (!IsCmsEligible(row)) continue;&#xA;&#xA;        string narr = hasNarration ? Val(row[&quot;Narration&quot;]) : &quot;&quot;;&#xA;&#xA;        // Force C_PAN from Narration when we can find a strict 550558 token&#xA;        if (hasCpan)&#xA;        {&#xA;            var panStrict = ExtractStrictPanFromNarration(narr);&#xA;            if (!string.IsNullOrEmpty(panStrict))&#xA;                row[&quot;C_PAN&quot;] = panStrict;&#xA;        }&#xA;&#xA;        string rrnRaw = Val(row[&quot;RRN&quot;]);&#xA;        string rrnKey = ExtractRrn12(rrnRaw);   // RRN ONLY, from CMS column&#xA;        if (string.IsNullOrEmpty(rrnKey)) continue;&#xA;&#xA;        decimal principal = CmsPrincipalAmount(row);&#xA;        if (principal &lt;= 0m) continue;&#xA;&#xA;        if (!cmsIndex.TryGetValue(rrnKey, out var list))&#xA;        {&#xA;            list = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;            cmsIndex[rrnKey] = list;&#xA;        }&#xA;        list.Add(row);&#xA;    }&#xA;}&#xA;System.Console.WriteLine($&quot;📦 CMS PPSA index ready (RRN-only): {cmsIndex.Count} keys&quot;);&#xA;&#xA;// ===== Match &amp; MOVE (remove BOTH rows from source) =====&#xA;exchangeGainOrLossPPSA = 0m;&#xA;int glSeen = 0, glMatched = 0, glNoCms = 0, movedPairs = 0, glDateMissing = 0, glDateNoWindow = 0;&#xA;decimal sumGlMatched = 0m, sumCmsMatched = 0m;&#xA;decimal removedDebit = 0m, removedCredit = 0m;&#xA;var unmatchedSnippets = new System.Collections.Generic.List&lt;string&gt;();&#xA;var skippedRrnMissing = new System.Collections.Generic.List&lt;string&gt;();&#xA;var rejectedByDateWindow = new System.Collections.Generic.List&lt;string&gt;();&#xA;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var gl = dtHistoricalReconTransactionsReport.Rows[i];&#xA;&#xA;    if (!hasTrnRef || !hasNarration) continue;&#xA;&#xA;    string trn = Val(gl[&quot;Transaction Ref No:&quot;]);&#xA;    if (trn.IndexOf(&quot;PPSA&quot;, System.StringComparison.OrdinalIgnoreCase) &lt; 0 &amp;&amp; trn.IndexOf(&quot;ADPC&quot;, System.StringComparison.OrdinalIgnoreCase) &lt; 0) continue;  // only PPSA/ADPC GLs&#xA;    glSeen++;&#xA;&#xA;    string narr = Val(gl[&quot;Narration&quot;]);&#xA;&#xA;    // Force GL C_PAN from Narration (strict 550558 token)&#xA;    string glPanStrict = ExtractStrictPanFromNarration(narr);&#xA;    if (hasCpan &amp;&amp; !string.IsNullOrEmpty(glPanStrict))&#xA;        gl[&quot;C_PAN&quot;] = glPanStrict;&#xA;&#xA;    // Extract GL RRN 12-char from Narration (for matching)&#xA;    string glRrn = ExtractRrn12(narr);&#xA;&#xA;    // Diagnostics per GL&#xA;    System.Console.WriteLine($&quot;🔎 PPSA GL seen: TRN={trn}, PAN={glPanStrict}, RRN={glRrn}&quot;);&#xA;&#xA;    // We match by RRN ONLY; if GL has no valid RRN, leave it in table.&#xA;    if (string.IsNullOrEmpty(glRrn))&#xA;    {&#xA;        skippedRrnMissing.Add($&quot;TRN={trn}, RRN=&lt;missing from Narration&gt;&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    // Get GL Value Date (required for ±2-day window)&#xA;    if (!hasValueDate)&#xA;    {&#xA;        glDateMissing++;&#xA;        rejectedByDateWindow.Add($&quot;TRN={trn}, reason=Missing 'Value Date' column&quot;);&#xA;        continue;&#xA;    }&#xA;    var glVDOpt = ParseDateFlexible(gl[&quot;Value Date&quot;]);&#xA;    if (glVDOpt == null)&#xA;    {&#xA;        glDateMissing++;&#xA;        rejectedByDateWindow.Add($&quot;TRN={trn}, reason=GL Value Date missing/invalid&quot;);&#xA;        continue;&#xA;    }&#xA;    var glVD = glVDOpt.Value;&#xA;&#xA;    decimal glDebit = ParseAmountSafe(gl, colDebit);&#xA;    decimal glCredit = ParseAmountSafe(gl, colCredit);&#xA;    decimal glPrincipal = glDebit &gt; 0 ? glDebit : (glCredit &gt; 0 ? glCredit : 0);&#xA;    if (glPrincipal &lt;= 0m) continue;&#xA;&#xA;    string key = glRrn; // RRN-only key&#xA;    if (!cmsIndex.TryGetValue(key, out var cmsList) || cmsList == null || cmsList.Count == 0)&#xA;    {&#xA;        glNoCms++;&#xA;        if (unmatchedSnippets.Count &lt; 15)&#xA;            unmatchedSnippets.Add($&quot;RRN={glRrn}, GL={glPrincipal:N2}, TRN={trn}&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    // Find a CMS candidate within ±2 days of GL Value Date&#xA;    System.Data.DataRow cmsRow = null;&#xA;    int cmsIdx = -1;&#xA;    for (int j = 0; j &lt; cmsList.Count; j++)&#xA;    {&#xA;        var candidate = cmsList[j];&#xA;        var cmsVDOpt = ParseDateFlexible(candidate[&quot;Value Date&quot;]);&#xA;        if (cmsVDOpt == null) continue; // skip CMS with no date&#xA;        if (AbsDays(glVD, cmsVDOpt.Value) &lt;= 2)&#xA;        {&#xA;            cmsRow = candidate;&#xA;            cmsIdx = j;&#xA;            break;&#xA;        }&#xA;    }&#xA;&#xA;    if (cmsRow == null)&#xA;    {&#xA;        glDateNoWindow++;&#xA;        if (rejectedByDateWindow.Count &lt; 20)&#xA;        {&#xA;            int best = 9999;&#xA;            for (int j = 0; j &lt; cmsList.Count; j++)&#xA;            {&#xA;                var cmsVDOpt2 = ParseDateFlexible(cmsList[j][&quot;Value Date&quot;]);&#xA;                if (cmsVDOpt2 != null)&#xA;                {&#xA;                    int dd = AbsDays(glVD, cmsVDOpt2.Value);&#xA;                    if (dd &lt; best) best = dd;&#xA;                }&#xA;            }&#xA;            var bestTxt = (best == 9999) ? &quot;no CMS dates&quot; : $&quot;closest diff={best}d&quot;;&#xA;            rejectedByDateWindow.Add($&quot;TRN={trn}, RRN={key}, GL VD={glVD:dd-MMM-yyyy}, reason=No CMS within ±2d ({bestTxt})&quot;);&#xA;        }&#xA;        continue;&#xA;    }&#xA;&#xA;    // For the matched CMS row, also force C_PAN from its Narration (if not already set)&#xA;    if (hasNarration &amp;&amp; hasCpan)&#xA;    {&#xA;        string cmsNarr = Val(cmsRow[&quot;Narration&quot;]);&#xA;        var cmsPanStrict = ExtractStrictPanFromNarration(cmsNarr);&#xA;        if (!string.IsNullOrEmpty(cmsPanStrict))&#xA;            cmsRow[&quot;C_PAN&quot;] = cmsPanStrict;&#xA;    }&#xA;&#xA;    decimal cmsPrincipal = CmsPrincipalAmount(cmsRow);&#xA;    if (cmsPrincipal &lt;= 0m)&#xA;    {&#xA;        // shouldn't happen for eligible, but guard&#xA;        continue;&#xA;    }&#xA;&#xA;    // compute pair net (GL sign + CMS sign); fee-excluded&#xA;    decimal cmsDebit = ParseAmountSafe(cmsRow, colDebit);&#xA;    decimal cmsCredit = ParseAmountSafe(cmsRow, colCredit);&#xA;    decimal pairNet = (glDebit - glCredit) + (cmsDebit - cmsCredit);&#xA;&#xA;    exchangeGainOrLossPPSA += pairNet;&#xA;    sumGlMatched += glPrincipal;&#xA;    sumCmsMatched += cmsPrincipal;&#xA;    glMatched++;&#xA;&#xA;    gl[&quot;Classification&quot;] = &quot;PPSA&quot;;&#xA;    cmsRow[&quot;Classification&quot;] = &quot;PPSA&quot;;&#xA;&#xA;    removedDebit  += glDebit  + cmsDebit;&#xA;    removedCredit += glCredit + cmsCredit;&#xA;&#xA;    // Move to matched table&#xA;    dtHistoricalReconTransactionsReportMatched.ImportRow(gl);&#xA;    dtHistoricalReconTransactionsReportMatched.ImportRow(cmsRow);&#xA;&#xA;    // Remove matched CMS from its list; drop key if empty&#xA;    cmsList.RemoveAt(cmsIdx);&#xA;    if (cmsList.Count == 0) cmsIndex.Remove(key);&#xA;&#xA;    // Remove BOTH rows from source table&#xA;    dtHistoricalReconTransactionsReport.Rows.Remove(cmsRow); // remove CMS by reference (index-safe)&#xA;    dtHistoricalReconTransactionsReport.Rows.Remove(gl);     // remove current GL by reference (index-safe)&#xA;    i--; // adjust iterator because current row (gl) is removed&#xA;    movedPairs++;&#xA;}&#xA;&#xA;// ===== AFTER totals &amp; wrap =====&#xA;SumDebitCreditTable(dtHistoricalReconTransactionsReport, out var afterDebit, out var afterCredit);&#xA;var afterDiff   = afterDebit - afterCredit;&#xA;var removedDiff = removedDebit - removedCredit;&#xA;&#xA;// “Exchange gain/loss” equals the net removed Δ, rounded to 2dp&#xA;exchangeGainOrLossPPSA = decimal.Round(removedDiff, 2, System.MidpointRounding.AwayFromZero);&#xA;&#xA;// ===== Logs =====&#xA;System.Console.WriteLine($&quot;📊 GL PPSA seen={glSeen}, matched={glMatched}, noCMS={glNoCms}, movedPairs={movedPairs}&quot;);&#xA;System.Console.WriteLine($&quot;   Matched principals — GL sum={sumGlMatched:N2}, CMS sum={sumCmsMatched:N2}&quot;);&#xA;System.Console.WriteLine($&quot;🧮 Totals — Δ_before={beforeDiff:N2}, Δ_removed={removedDiff:N2}, Δ_after={afterDiff:N2}&quot;);&#xA;System.Console.WriteLine($&quot;💱 Final exchangeGainOrLossPPSA = {exchangeGainOrLossPPSA:N2} {currency}&quot;);&#xA;&#xA;// Diagnostics for skipped rows&#xA;if (skippedRrnMissing.Count &gt; 0)&#xA;{&#xA;    System.Console.WriteLine(&quot;⚠️ GL PPSA rows skipped due to missing 12-char RRN in Narration:&quot;);&#xA;    for (int k = 0; k &lt; skippedRrnMissing.Count; k++)&#xA;        System.Console.WriteLine($&quot;   • {skippedRrnMissing[k]}&quot;);&#xA;}&#xA;&#xA;// Diagnostics for date-window rejections&#xA;if (rejectedByDateWindow.Count &gt; 0)&#xA;{&#xA;    System.Console.WriteLine(&quot;⏳ GL PPSA rows rejected by ±2-day Value Date window:&quot;);&#xA;    for (int k = 0; k &lt; rejectedByDateWindow.Count; k++)&#xA;        System.Console.WriteLine($&quot;   • {rejectedByDateWindow[k]}&quot;);&#xA;}&#xA;&#xA;if (unmatchedSnippets.Count &gt; 0)&#xA;{&#xA;    System.Console.WriteLine(&quot;🧩 Unmatched GL PPSA rows (no CMS principal) — showing up to 15:&quot;);&#xA;    for (int k = 0; k &lt; unmatchedSnippets.Count; k++)&#xA;        System.Console.WriteLine($&quot;   • {unmatchedSnippets[k]}&quot;);&#xA;}&#xA;&#xA;System.Console.WriteLine($&quot;⏱️ Completed in {sw.ElapsedMilliseconds} ms&quot;);&#xA;" DisplayName="PPSA + exchangeGainOrLossPPSA GL vs CMS" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_69" Language="CSharp">

        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== Robust helpers (no external usings needed) =====&#xA;DateTime? ParseDateFlexible(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return null;&#xA;    if (val is DateTime dt) return dt;&#xA;&#xA;    if (val is double d) { try { return DateTime.FromOADate(d); } catch { /* ignore */ } }&#xA;&#xA;    if (double.TryParse(val.ToString(), System.Globalization.NumberStyles.Float,&#xA;                        System.Globalization.CultureInfo.InvariantCulture, out var d2))&#xA;    {&#xA;        try { return DateTime.FromOADate(d2); } catch { /* ignore */ }&#xA;    }&#xA;&#xA;    var s = val.ToString().Trim();&#xA;    string[] fmts = new[] {&#xA;        &quot;dd/MM/yyyy HH:mm:ss&quot;,&quot;dd/MM/yyyy HH:mm&quot;,&quot;dd/MM/yyyy&quot;,&#xA;        &quot;yyyy-MM-dd&quot;,&quot;yyyy-MM-dd HH:mm:ss&quot;,&quot;yyyy/MM/dd&quot;&#xA;    };&#xA;    if (DateTime.TryParseExact(s, fmts,&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xA;        System.Globalization.DateTimeStyles.None, out var exact)) return exact;&#xA;&#xA;    if (DateTime.TryParse(s,&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xA;        System.Globalization.DateTimeStyles.None, out var any)) return any;&#xA;&#xA;    return null;&#xA;}&#xA;&#xA;string FindFirstExistingColumn(System.Data.DataTable dt, params string[] names)&#xA;{&#xA;    foreach (var name in names)&#xA;        if (!string.IsNullOrEmpty(name) &amp;&amp; dt.Columns.Contains(name)) return name;&#xA;    return null;&#xA;}&#xA;&#xA;void EnsureColumn(System.Data.DataTable dt, string name)&#xA;{&#xA;    if (!dt.Columns.Contains(name))&#xA;        dt.Columns.Add(new System.Data.DataColumn(name, typeof(string)) { DefaultValue = &quot;&quot; });&#xA;}&#xA;&#xA;bool IsNullOrEmptyCell(System.Data.DataRow r, string col)&#xA;{&#xA;    if (!r.Table.Columns.Contains(col)) return true;&#xA;    var v = r[col];&#xA;    return v == null || v == System.DBNull.Value || string.IsNullOrWhiteSpace(v.ToString());&#xA;}&#xA;&#xA;void SetIfEmpty(System.Data.DataRow r, string col, string val)&#xA;{&#xA;    EnsureColumn(r.Table, col);&#xA;    if (IsNullOrEmptyCell(r, col)) r[col] = val;&#xA;}&#xA;&#xA;// Remove spaces and check if starts with load/reload&#xA;bool NarrationStartsWithLoadReload(string narration)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(narration)) return false;&#xA;    string noSpaces = narration.Replace(&quot; &quot;, &quot;&quot;).Trim();  // strip all spaces&#xA;    return noSpaces.StartsWith(&quot;Load/Reload&quot;, StringComparison.OrdinalIgnoreCase);&#xA;}&#xA;&#xA;// ===== Ensure the 4 output columns exist =====&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Root Cause&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Root Cause Category&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Recommended Action&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Action Owner&quot;);&#xA;&#xA;// NOTE: Late-posted logic removed — no reconDate parsing or date-range checks.&#xA;// Keep Value Date detection only if you still need it elsewhere; otherwise it can be removed.&#xA;string valueDateCol = FindFirstExistingColumn(dtHistoricalReconTransactionsReport, &quot;Value Date&quot;, &quot;ValueDate&quot;);&#xA;&#xA;// ===== Main loop =====&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string source = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Source&quot;)&#xA;        ? (row[&quot;Source&quot;] == null || row[&quot;Source&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Source&quot;].ToString())&#xA;        : &quot;&quot;;&#xA;&#xA;    string type = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Type&quot;)&#xA;        ? (row[&quot;Type&quot;] == null || row[&quot;Type&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Type&quot;].ToString())&#xA;        : &quot;&quot;;&#xA;&#xA;    string narration = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Narration&quot;)&#xA;        ? (row[&quot;Narration&quot;] == null || row[&quot;Narration&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Narration&quot;].ToString())&#xA;        : &quot;&quot;;&#xA;&#xA;    // Filter: Source = CMS + Type = new + Narration starts with Load/Reload (ignoring spaces)&#xA;    bool isCMS = source.Equals(&quot;CMS&quot;, StringComparison.OrdinalIgnoreCase);&#xA;    bool isNew = type.Equals(&quot;new&quot;, StringComparison.OrdinalIgnoreCase);&#xA;    bool narrationIsLoadReload = NarrationStartsWithLoadReload(narration);&#xA;&#xA;    if (!(isCMS &amp;&amp; isNew &amp;&amp; narrationIsLoadReload))&#xA;        continue;&#xA;&#xA;    // Always classify as &quot;Loading updated CMS only&quot;&#xA;    SetIfEmpty(row, &quot;Root Cause&quot;, &quot;Loading updated CMS only&quot;);&#xA;    SetIfEmpty(row, &quot;Root Cause Category&quot;, &quot;System&quot;);&#xA;    SetIfEmpty(row, &quot;Recommended Action&quot;, &quot;Perform MISC ADJUSTMENT CREDIT&quot;);&#xA;    SetIfEmpty(row, &quot;Action Owner&quot;, &quot;Stephen Jilala&quot;);&#xA;}&#xA;" DisplayName="Root Cause CMS" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_13" Language="CSharp">

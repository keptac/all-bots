ingCol].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;        wsRaw.Cells[2, valueCol, totalRows + 1, valueCol].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;    }&#xA;&#xA;    package.Save();&#xA;}&#xA;&#xA;Console.WriteLine(&#xA;    $&quot;✅ CWPP sheet saved with {dtHistoricalReconTransactionsReportMatched.AsEnumerable().Count(r =&gt; r[&quot;Classification&quot;]?.ToString() == &quot;CWPP&quot;):N0} rows.&quot;);&#xA;" DisplayName="Write CWPP" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_44" Language="CSharp">

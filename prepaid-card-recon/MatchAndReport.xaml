        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: CMS Cash Advance + related fee/income grouping (PPAT-only scope) =====&#xA;// Overwrites RC fields for CMS/new rows we classify (Parent or Related).&#xA;// Skips rows classified as UMJP.&#xA;// Groups by key = C_PAN|RRN.&#xA;//&#xA;// Args (In):     string reconDate   // (unused here; retained for consistency)&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport&#xA;&#xA;/////////////////////// Helpers ///////////////////////&#xA;&#xA;bool HasCol(System.Data.DataTable dt, string name) =&gt; dt != null &amp;&amp; dt.Columns.Contains(name);&#xA;&#xA;void EnsureTextCol(System.Data.DataTable dt, string name)&#xA;{&#xA;    if (!dt.Columns.Contains(name))&#xA;        dt.Columns.Add(new System.Data.DataColumn(name, typeof(string)) { DefaultValue = &quot;&quot; });&#xA;}&#xA;&#xA;// Normalize narration: uppercase, collapse dashes/underscores, collapse spaces&#xA;string NormalizeNarr(string s)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(s)) return &quot;&quot;;&#xA;    var x = s.ToUpperInvariant();&#xA;    x = System.Text.RegularExpressions.Regex.Replace(x, @&quot;[-_]&quot;, &quot; &quot;);&#xA;    x = System.Text.RegularExpressions.Regex.Replace(x, @&quot;\s+&quot;, &quot; &quot;);&#xA;    return x.Trim();&#xA;}&#xA;&#xA;// Parent = Cash Advance / Cash at POS / Cash Out (accept common variants)&#xA;bool IsCashAdvanceParent(string narration)&#xA;{&#xA;    var n = NormalizeNarr(narration);&#xA;    return n.Contains(&quot;CASH ADVANCE / CASH AT POS / CASH OUT&quot;)&#xA;        || n.Contains(&quot;CASH ADVANCE/CASH AT POS/CASH OUT&quot;)&#xA;        || n.Contains(&quot;CASH ADVANCE CASH AT POS CASH OUT&quot;)&#xA;        || n.StartsWith(&quot;CASH ADVANCE &quot;);&#xA;}&#xA;&#xA;// Related = fee / charge / levy / VAT / tax / income (broad but scoped to rows sharing the same key)&#xA;bool IsRelatedFeeOrIncome(string narration)&#xA;{&#xA;    var n = NormalizeNarr(narration);&#xA;    if (string.IsNullOrEmpty(n)) return false;&#xA;&#xA;    // strong phrases&#xA;    if (n.Contains(&quot;TRANSACTION FEE&quot;)) return true;&#xA;    if (n.Contains(&quot;SERVICE TAX&quot;)) return true;&#xA;    if (n.Contains(&quot;TAX ON INCOME&quot;)) return true;&#xA;    if (n.Contains(&quot;VAT PAYABLE&quot;)) return true;&#xA;    if (n.Contains(&quot;GOVERNMENT LEVY&quot;)) return true;&#xA;&#xA;    // generic tokens (keep broad to catch bank-specific naming)&#xA;    if (n.Contains(&quot; FEE &quot;)) return true;&#xA;    if (n.EndsWith(&quot; FEE&quot;) || n.StartsWith(&quot;FEE &quot;)) return true;&#xA;    if (n.Contains(&quot; CHARGE&quot;)) return true;&#xA;    if (n.Contains(&quot; LEVY&quot;)) return true;&#xA;    if (n.Equals(&quot;VAT&quot;) || n.Contains(&quot; VAT &quot;)) return true;&#xA;    if (n.Contains(&quot; INCOME&quot;)) return true; // e.g., fee income postings&#xA;&#xA;    return false;&#xA;}&#xA;&#xA;string KeyForRow(System.Data.DataRow r)&#xA;{&#xA;    string pan = HasCol(r.Table, &quot;C_PAN&quot;) ? (r[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;    string rrn = HasCol(r.Table, &quot;RRN&quot;)   ? (r[&quot;RRN&quot;]?.ToString()   ?? &quot;&quot;) : &quot;&quot;;&#xA;    return $&quot;{pan}|{rrn}&quot;;&#xA;}&#xA;&#xA;void SetCmsRootCauseOverwrite(System.Data.DataRow row)&#xA;{&#xA;    row[&quot;Root Cause&quot;] = &quot;Unsuccessful ATM withdrawal transaction and charges updated CMS only&quot;;&#xA;    row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;    row[&quot;Recommended Action&quot;] = &quot;Process MISC ADJUSTMENT CREDIT&quot;;&#xA;    row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;}&#xA;&#xA;bool IsUmjp(System.Data.DataRow row)&#xA;{&#xA;    if (!HasCol(row.Table, &quot;Classification&quot;)) return false;&#xA;    var c = (row[&quot;Classification&quot;]?.ToString() ?? &quot;&quot;).Trim();&#xA;    return c.Equals(&quot;UMJP&quot;, System.StringComparison.OrdinalIgnoreCase);&#xA;}&#xA;&#xA;/////////////////////// Ensure output cols ///////////////////////&#xA;&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;Root Cause&quot;);&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;Root Cause Category&quot;);&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;Recommended Action&quot;);&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;Action Owner&quot;);&#xA;&#xA;// Audit/grouping columns&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;CMS Group Key&quot;);&#xA;EnsureTextCol(dtHistoricalReconTransactionsReport, &quot;CMS Relation&quot;); // &quot;Parent&quot; | &quot;Related&quot;&#xA;&#xA;/////////////////////// Pass 1: find Cash Advance parents (skip UMJP) ///////////////////////&#xA;&#xA;var parents = new System.Collections.Generic.Dictionary&lt;string, System.Data.DataRow&gt;();&#xA;int parentsFound = 0, skippedUmjpParents = 0;&#xA;&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    if (IsUmjp(row)) { skippedUmjpParents++; continue; }&#xA;&#xA;    string source = HasCol(dtHistoricalReconTransactionsReport, &quot;Source&quot;) ? (row[&quot;Source&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;    string type   = HasCol(dtHistoricalReconTransactionsReport, &quot;Type&quot;)   ? (row[&quot;Type&quot;]?.ToString()   ?? &quot;&quot;) : &quot;&quot;;&#xA;    if (!(source.Equals(&quot;CMS&quot;, System.StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;          type.Equals(&quot;new&quot;, System.StringComparison.OrdinalIgnoreCase))) continue;&#xA;&#xA;    string narration = HasCol(dtHistoricalReconTransactionsReport, &quot;Narration&quot;) ? (row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;    if (!IsCashAdvanceParent(narration)) continue;&#xA;&#xA;    var key = KeyForRow(row);&#xA;    if (string.IsNullOrWhiteSpace(key) || key == &quot;|&quot;) continue; // require both PAN and RRN&#xA;&#xA;    if (!parents.ContainsKey(key))&#xA;    {&#xA;        parents[key] = row;&#xA;        row[&quot;CMS Group Key&quot;] = key;&#xA;        row[&quot;CMS Relation&quot;] = &quot;Parent&quot;;&#xA;        SetCmsRootCauseOverwrite(row); // overwrite RC fields for CMS Parent&#xA;        parentsFound++;&#xA;    }&#xA;}&#xA;&#xA;/////////////////////// Pass 2: attach related fee/income (skip UMJP) ///////////////////////&#xA;&#xA;int relatedLinked = 0, skippedUmjpRelated = 0;&#xA;&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    if (IsUmjp(row)) { skippedUmjpRelated++; continue; }&#xA;&#xA;    string source = HasCol(dtHistoricalReconTransactionsReport, &quot;Source&quot;) ? (row[&quot;Source&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;    string type   = HasCol(dtHistoricalReconTransactionsReport, &quot;Type&quot;)   ? (row[&quot;Type&quot;]?.ToString()   ?? &quot;&quot;) : &quot;&quot;;&#xA;    if (!(source.Equals(&quot;CMS&quot;, System.StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;          type.Equals(&quot;new&quot;, System.StringComparison.OrdinalIgnoreCase))) continue;&#xA;&#xA;    string key = KeyForRow(row);&#xA;    if (string.IsNullOrWhiteSpace(key) || key == &quot;|&quot;) continue;&#xA;    if (!parents.ContainsKey(key)) continue; // must share key with a discovered Cash Advance parent&#xA;&#xA;    // If already Parent, ensure overwrite (idempotent), else consider as Related if it looks like fee/income&#xA;    if ((row[&quot;CMS Relation&quot;]?.ToString() ?? &quot;&quot;).Equals(&quot;Parent&quot;, System.StringComparison.OrdinalIgnoreCase))&#xA;    {&#xA;        SetCmsRootCauseOverwrite(row);&#xA;        continue;&#xA;    }&#xA;&#xA;    string narration = HasCol(dtHistoricalReconTransactionsReport, &quot;Narration&quot;) ? (row[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;    if (!IsRelatedFeeOrIncome(narration)) continue;&#xA;&#xA;    row[&quot;CMS Group Key&quot;] = key;&#xA;    row[&quot;CMS Relation&quot;] = &quot;Related&quot;;&#xA;    SetCmsRootCauseOverwrite(row); // overwrite RC fields for CMS Related&#xA;    relatedLinked++;&#xA;}&#xA;&#xA;System.Console.WriteLine(&#xA;    $&quot;✅ CMS CashAdvance+Related grouping complete. Parents: {parentsFound}, Related linked: {relatedLinked} — &quot; +&#xA;    $&quot;Skipped UMJP (parents scan): {skippedUmjpParents}, Skipped UMJP (related scan): {skippedUmjpRelated}.&quot;&#xA;);&#xA;// End&#xA;" DisplayName="Root Cause CMS" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_86" Language="CSharp">

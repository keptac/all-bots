lOrWhiteSpace(v.ToString());&#xA;}&#xA;&#xA;void SetIfEmpty(System.Data.DataRow r, string col, string val)&#xA;{&#xA;    EnsureColumn(r.Table, col);&#xA;    if (IsNullOrEmptyCell(r, col)) r[col] = val;&#xA;}&#xA;&#xA;// Case-insensitive contains for &quot;Purchase/Auth Completion&quot;&#xA;bool NarrationHasPurchaseAuthCompletion(string narration)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(narration)) return false;&#xA;    return narration.IndexOf(&quot;Purchase/Auth Completion&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0;&#xA;}&#xA;&#xA;// ===== Ensure the 4 output columns exist =====&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Root Cause&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Root Cause Category&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Recommended Action&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Action Owner&quot;);&#xA;&#xA;// NOTE: Late-posted logic removed. We no longer parse reconDate or compare Value Date ranges.&#xA;&#xA;// ===== Main loop =====&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string source = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Source&quot;)&#xA;        ? (row[&quot;Source&quot;] == null || row[&quot;Source&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Source&quot;].ToString())&#xA;        : &quot;&quot;;&#xA;&#xA;    string type = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Type&quot;)&#xA;        ? (row[&quot;Type&quot;] == null || row[&quot;Type&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Type&quot;].ToString())&#xA;        : &quot;&quot;;&#xA;&#xA;    string narration = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Narration&quot;)&#xA;        ? (row[&quot;Narration&quot;] == null || row[&quot;Narration&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Narration&quot;].ToString())&#xA;        : &quot;&quot;;&#xA;&#xA;    string channel = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Channel&quot;)&#xA;        ? (row[&quot;Channel&quot;] == null || row[&quot;Channel&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Channel&quot;].ToString())&#xA;        : &quot;&quot;;&#xA;&#xA;    // Filter: Source = CMS + Type = new + Narration has &quot;Purchase/Auth Completion&quot; + Channel = API&#xA;    bool isCMS  = source.Equals(&quot;CMS&quot;, StringComparison.OrdinalIgnoreCase);&#xA;    bool isNew  = type.Equals(&quot;new&quot;, StringComparison.OrdinalIgnoreCase);&#xA;    bool hasPAC = NarrationHasPurchaseAuthCompletion(narration);&#xA;    bool isAPI  = channel.Trim().Equals(&quot;API&quot;, StringComparison.OrdinalIgnoreCase);&#xA;&#xA;    if (!(isCMS &amp;&amp; isNew &amp;&amp; hasPAC &amp;&amp; isAPI))&#xA;        continue;&#xA;&#xA;    // Always classify as &quot;On-us purchases updated CMS only&quot; (no late-post check)&#xA;    SetIfEmpty(row, &quot;Root Cause&quot;, &quot;On-us purchases updated CMS only&quot;);&#xA;    SetIfEmpty(row, &quot;Root Cause Category&quot;, &quot;People&quot;);&#xA;    SetIfEmpty(row, &quot;Recommended Action&quot;, &quot;Under Investigation&quot;);&#xA;    SetIfEmpty(row, &quot;Action Owner&quot;, &quot;Card Reconciliation&quot;);&#xA;}&#xA;" DisplayName="Root Cause CMS" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_43" Language="CSharp">

        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code (Optimized; Load/Reload logging; NO override for fee/fees/income/levy) =====&#xA;// In/Out: dtHistoricalReconTransactionsReport (DataTable)&#xA;// In:     reconCurrency (string), reconDate (string)&#xA;&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport));&#xA;&#xA;// Ensure required columns exist&#xA;string[] needStringCols = new[]&#xA;{&#xA;    &quot;Aging&quot;,&quot;Aging Group&quot;,&quot;BOT Classification&quot;,&#xA;    &quot;Recommended Action&quot;,&quot;Root Cause&quot;,&quot;Root Cause Category&quot;,&quot;Action Owner&quot;,&#xA;    &quot;Billing Amount&quot;,&quot;Billing Currency&quot;,&quot;Transaction Currency&quot;,&quot;Transaction Amount&quot;,&#xA;    &quot;Settlement Currency&quot;,&quot;Settlement Amount&quot;,&quot;Narration&quot;,&quot;Channel&quot;,&quot;Type&quot;,&quot;Source&quot;,&#xA;    &quot;Booking Date&quot;,&quot;Value Date&quot;,&quot;Transaction Ref No:&quot;&#xA;};&#xA;foreach (string c in needStringCols)&#xA;    if (!dtHistoricalReconTransactionsReport.Columns.Contains(c))&#xA;        dtHistoricalReconTransactionsReport.Columns.Add(c, typeof(string));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;FOREIGN_CURRENCY&quot;))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;FOREIGN_CURRENCY&quot;, typeof(bool));&#xA;&#xA;// (Recon date parsing retained but NOT used for CMS late-posted anymore)&#xA;var invCulture = System.Globalization.CultureInfo.InvariantCulture;&#xA;string[] reconDateFormats = new[]&#xA;{&#xA;    &quot;dd-MMM-yyyy&quot;, &quot;yyyy-MM-dd&quot;, &quot;dd/MM/yyyy&quot;, &quot;yyyy/MM/dd&quot;,&#xA;    &quot;dd-MM-yyyy&quot;, &quot;MM/dd/yyyy&quot;, &quot;dd MMM yyyy&quot;&#xA;};&#xA;System.DateTime reconDateParsed = System.DateTime.MinValue;&#xA;bool hasReconDate = false;&#xA;if (!string.IsNullOrWhiteSpace(reconDate))&#xA;{&#xA;    string rd = reconDate.Trim();&#xA;    hasReconDate =&#xA;        System.DateTime.TryParseExact(&#xA;            rd, reconDateFormats, invCulture,&#xA;            System.Globalization.DateTimeStyles.None, out reconDateParsed)&#xA;        || System.DateTime.TryParse(rd, out reconDateParsed);&#xA;    if (!hasReconDate)&#xA;        System.Console.WriteLine($&quot;[WARN] reconDate '{rd}' could not be parsed. (No impact: CMS late-posted disabled)&quot;);&#xA;}&#xA;&#xA;// Normalize recon currency&#xA;string reconCurrencyNormalized = System.Text.RegularExpressions.Regex&#xA;    .Replace((reconCurrency ?? &quot;&quot;).Trim(), @&quot;\s+&quot;, &quot; &quot;)&#xA;    .ToLowerInvariant();&#xA;&#xA;// Pre-compile regexes&#xA;var panRegex = new System.Text.RegularExpressions.Regex(&#xA;    @&quot;\b\d{6}X{6}\d{4}\b&quot;,&#xA;    System.Text.RegularExpressions.RegexOptions.Compiled);&#xA;&#xA;var rrnRegex = new System.Text.RegularExpressions.Regex(&#xA;    @&quot;\b[A-Za-z0-9]{12}\b&quot;,&#xA;    System.Text.RegularExpressions.RegexOptions.Compiled);&#xA;&#xA;var loadReloadHead = new System.Text.RegularExpressions.Regex(&#xA;    @&quot;^\s*load\s*/\s*reload\b&quot;,&#xA;    System.Text.RegularExpressions.RegexOptions.IgnoreCase |&#xA;    System.Text.RegularExpressions.RegexOptions.Compiled);&#xA;&#xA;// Defaults&#xA;const string DEF_RC   = &quot;Remote-on-us transaction not yet posted&quot;;&#xA;const string DEF_RCAT = &quot;System&quot;;&#xA;const string DEF_ACT  = &quot;Load pending auth dump files&quot;;&#xA;const string DEF_OWN  = &quot;ICT&quot;;&#xA;&#xA;// Helpers&#xA;bool IsNullOrWhite(object v) =&gt;&#xA;    v == null || v == System.DBNull.Value || string.IsNullOrWhiteSpace(v.ToString());&#xA;&#xA;string Str(object v) =&gt;&#xA;    v == null || v == System.DBNull.Value ? &quot;&quot; : v.ToString();&#xA;&#xA;string NormLower(string s) =&gt;&#xA;    System.Text.RegularExpressions.Regex.Replace(&#xA;        (s ?? &quot;&quot;).Trim().ToLowerInvariant(), @&quot;\s+&quot;, &quot; &quot;);&#xA;&#xA;// Income keyword definitions (whole-word support for narration)&#xA;string[] incomeKeywords = new[]&#xA;{&#xA;    &quot;transaction fee&quot;,&#xA;    &quot;tax on income&quot;,&#xA;    &quot;income&quot;,&#xA;    &quot;fee&quot;,&#xA;    &quot;fees&quot;,&#xA;    &quot;levy&quot;&#xA;};&#xA;&#xA;bool HasFeeIncomeLevy(string normNarr)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(normNarr))&#xA;        return false;&#xA;&#xA;    foreach (var kw in incomeKeywords)&#xA;    {&#xA;        if (string.IsNullOrWhiteSpace(kw))&#xA;            continue;&#xA;&#xA;        // Phrases – use simple Contains on normalized narration&#xA;        if (kw.Contains(&quot; &quot;))&#xA;        {&#xA;            if (normNarr.Contains(kw))&#xA;                return true;&#xA;        }&#xA;        else&#xA;        {&#xA;            // Single words – whole-word regex so we don't match FEEDFZ etc.&#xA;            var pattern = $@&quot;\b{System.Text.RegularExpressions.Regex.Escape(kw)}\b&quot;;&#xA;            if (System.Text.RegularExpressions.Regex.IsMatch(normNarr, pattern))&#xA;                return true;&#xA;        }&#xA;    }&#xA;&#xA;    return false;&#xA;}&#xA;&#xA;bool LegacyHasAny(System.Data.DataRow r)&#xA;{&#xA;    return !IsNullOrWhite(r[&quot;Root Cause&quot;]) ||&#xA;           !IsNullOrWhite(r[&quot;Root Cause Category&quot;]) ||&#xA;           !IsNullOrWhite(r[&quot;Recommended Action&quot;]) ||&#xA;           !IsNullOrWhite(r[&quot;Action Owner&quot;]);&#xA;}&#xA;&#xA;// ===== PASS 1: Build principal index for Cash Advance matches =====&#xA;var principalIndex = new System.Collections.Generic.HashSet&lt;string&gt;(System.StringComparer.Ordinal);&#xA;int rowsScanned = 0;&#xA;foreach (System.Data.DataRow r in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string src = Str(r[&quot;Source&quot;]).Trim().ToUpperInvariant();&#xA;    string typ = NormLower(Str(r[&quot;Type&quot;]));&#xA;    if (src != &quot;CMS&quot; || typ != &quot;new&quot;)&#xA;    {&#xA;        rowsScanned++;&#xA;        continue;&#xA;    }&#xA;&#xA;    string narr = Str(r[&quot;Narration&quot;]);&#xA;    string norm = NormLower(narr);&#xA;    if (!norm.StartsWith(&quot;cash advance/ cash at pos / cash out&quot;))&#xA;    {&#xA;        rowsScanned++;&#xA;        continue;&#xA;    }&#xA;&#xA;    var mPan = panRegex.Match(narr);&#xA;    var mRrn = rrnRegex.Match(narr);&#xA;    if (mPan.Success &amp;&amp; mRrn.Success)&#xA;        principalIndex.Add(mPan.Value + &quot;|&quot; + mRrn.Value.ToUpperInvariant());&#xA;    rowsScanned++;&#xA;}&#xA;System.Console.WriteLine($&quot;[PASS1] Done. Principal keys indexed: {principalIndex.Count}&quot;);&#xA;&#xA;// ===== PASS 2: Main classification =====&#xA;int processed = 0, reportRowNumber = 2;&#xA;int loadReloadCount = 0;&#xA;var sw = System.Diagnostics.Stopwatch.StartNew();&#xA;&#xA;// Value Date parsing formats (used for logging only)&#xA;string[] valueDateFormats = new[]&#xA;{&#xA;    &quot;dd-MMM-yyyy&quot;, &quot;yyyy-MM-dd&quot;, &quot;dd/MM/yyyy&quot;, &quot;yyyy/MM/dd&quot;,&#xA;    &quot;dd-MM-yyyy&quot;, &quot;MM/dd/yyyy&quot;, &quot;dd MMM yyyy&quot;&#xA;};&#xA;&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string src = Str(row[&quot;Source&quot;]).Trim().ToUpperInvariant();&#xA;    string typ = NormLower(Str(row[&quot;Type&quot;]));&#xA;    if (src != &quot;CMS&quot; || typ != &quot;new&quot;) continue;&#xA;&#xA;    string narration = Str(row[&quot;Narration&quot;]);&#xA;    string normNarr  = NormLower(narration);&#xA;&#xA;    string channelUpper          = Str(row[&quot;Channel&quot;]).Trim().ToUpperInvariant();&#xA;    string billingCurrency       = Str(row[&quot;Billing Currency&quot;]).Trim().ToUpperInvariant();&#xA;    string billingCurrencyNorm   = NormLower(billingCurrency);&#xA;    string billingAmount         = Str(row[&quot;Billing Amount&quot;]).Trim();&#xA;    string transactionCurrency   = Str(row[&quot;Transaction Currency&quot;]).Trim().ToUpperInvariant();&#xA;    string transactionAmount     = Str(row[&quot;Transaction Amount&quot;]).Trim();&#xA;    string settlementCurrency    = Str(row[&quot;Settlement Currency&quot;]).Trim().ToUpperInvariant();&#xA;    string settlementAmount      = Str(row[&quot;Settlement Amount&quot;]).Trim();&#xA;&#xA;    var rrnMatch = rrnRegex.Match(narration ?? &quot;&quot;);&#xA;    string rrnKey = rrnMatch.Success ? rrnMatch.Value.ToUpperInvariant() : &quot;&quot;;&#xA;&#xA;    // Excel formulas&#xA;    row[&quot;Aging&quot;] = &quot;=$H$6-G&quot; + reportRowNumber;&#xA;    row[&quot;Aging Group&quot;] =&#xA;        &quot;=IF(L&quot; + reportRowNumber + &quot;&lt;4,\&quot;0-3 Days\&quot;,&quot;&#xA;      + &quot;IF(L&quot; + reportRowNumber + &quot;&lt;31,\&quot;4-30 Days\&quot;,&quot;&#xA;      + &quot;IF(L&quot; + reportRowNumber + &quot;&lt;61,\&quot;31-60 Days\&quot;,&quot;&#xA;      + &quot;IF(L&quot; + reportRowNumber + &quot;&lt;=90,\&quot;61-90 Days\&quot;,&quot;&#xA;      + &quot;IF(L&quot; + reportRowNumber + &quot;&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;&#xA;    row[&quot;BOT Classification&quot;] =&#xA;        &quot;=IF(J&quot; + reportRowNumber + &quot;&gt;0,&quot;&#xA;      + &quot;IF(L&quot; + reportRowNumber + &quot;&lt;30,\&quot;Normal\&quot;,&quot;&#xA;      + &quot;IF(L&quot; + reportRowNumber + &quot;&lt;60,\&quot;Especially Mentioned\&quot;,&quot;&#xA;      + &quot;IF(L&quot; + reportRowNumber + &quot;&lt;90,\&quot;Substandard\&quot;,&quot;&#xA;      + &quot;IF(L&quot; + reportRowNumber + &quot;&lt;=180,\&quot;Doubtful\&quot;,&quot;&#xA;      + &quot;IF(L&quot; + reportRowNumber + &quot;&gt;180,\&quot;Loss\&quot;,\&quot;0\&quot;)))))),&quot; &#xA;      + &quot;\&quot;Not Applicable\&quot;)&quot;;&#xA;&#xA;    // --- FX (API only) – still marks FOREIGN_CURRENCY, but RA may be overridden elsewhere ---&#xA;    if (billingCurrencyNorm != reconCurrencyNormalized &amp;&amp; channelUpper == &quot;API&quot;)&#xA;    {&#xA;        row[&quot;FOREIGN_CURRENCY&quot;] = true;&#xA;        if (IsNullOrWhite(row[&quot;Recommended Action&quot;]))&#xA;        {&#xA;            row[&quot;Recommended Action&quot;] =&#xA;                $&quot;Debit 101-202030015 ({transactionCurrency} {transactionAmount}) and &quot;&#xA;              + $&quot;Credit 101-202030015 ({billingCurrency} {billingAmount})&quot;;&#xA;        }&#xA;    }&#xA;    else&#xA;    {&#xA;        row[&quot;FOREIGN_CURRENCY&quot;] = false;&#xA;    }&#xA;&#xA;    // Determine legacy lock, but allow overriding the auto FX RA (Debit 101-202030015 ...)&#xA;    bool fxAutoRA = !IsNullOrWhite(row[&quot;Recommended Action&quot;]) &amp;&amp;&#xA;                    Str(row[&quot;Recommended Action&quot;]).StartsWith(&quot;Debit 101-202030015&quot;, StringComparison.OrdinalIgnoreCase);&#xA;    bool legacyLocked = LegacyHasAny(row) &amp;&amp; !fxAutoRA;&#xA;&#xA;    // ⚠ If narration contains income/fee/levy (whole-word), skip this block entirely&#xA;    bool isIncomeLike = HasFeeIncomeLevy(normNarr);&#xA;    if (isIncomeLike)&#xA;    {&#xA;        reportRowNumber++;&#xA;        processed++;&#xA;        if (processed % 50000 == 0)&#xA;            System.Console.WriteLine($&quot;[PASS2] (Skipped income/fee/levy) Processed {processed} CMS/new rows so far...&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    // ==== Load/Reload (override legacy; CMS late-posted disabled) ====&#xA;    if (loadReloadHead.IsMatch(narration))&#xA;    {&#xA;        loadReloadCount++;&#xA;&#xA;        // FX correction for Billing Amount (same behavior)&#xA;        if (billingCurrencyNorm != reconCurrencyNormalized)&#xA;        {&#xA;            decimal txnAmtVal;&#xA;            string txClean = (transactionAmount ?? &quot;&quot;).Replace(&quot;,&quot;, &quot;&quot;).Trim();&#xA;            if (decimal.TryParse(txClean, out txnAmtVal))&#xA;            {&#xA;                row[&quot;Billing Amount&quot;] = (-1m * txnAmtVal).ToString(&quot;F2&quot;);&#xA;                billingAmount = row[&quot;Billing Amount&quot;].ToString();&#xA;            }&#xA;        }&#xA;&#xA;        // Always apply NORMAL Load/Reload labels (no late-post checks on CMS)&#xA;        row[&quot;Root Cause&quot;]          = &quot;Loading updated CMS only&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;]  = &quot;Perform MISC ADJUSTMENT DEBIT&quot;;&#xA;        row[&quot;Action Owner&quot;]        = &quot;Stephen Jilala&quot;;&#xA;&#xA;        // Logging (Value Date just for visibility)&#xA;        string valueDateStr = Str(row[&quot;Value Date&quot;]).Trim();&#xA;        System.DateTime valueDate;&#xA;        bool parsedVD =&#xA;            System.DateTime.TryParseExact(&#xA;                valueDateStr, valueDateFormats, invCulture,&#xA;                System.Globalization.DateTimeStyles.None, out valueDate)&#xA;            || System.DateTime.TryParse(valueDateStr, out valueDate);&#xA;&#xA;        string vdStr = parsedVD ? valueDate.ToString(&quot;dd-MMM-yyyy&quot;) : &quot;&lt;no value date&gt;&quot;;&#xA;&#xA;        string txnRef = Str(row[&quot;Transaction Ref No:&quot;]);&#xA;        if (string.IsNullOrWhiteSpace(txnRef)) txnRef = &quot;&lt;no ref&gt;&quot;;&#xA;&#xA;        System.Console.WriteLine(&#xA;            $&quot;[Load/Reload] Normal | ValueDate={vdStr} | {txnRef} | RC='{row[&quot;Root Cause&quot;]}' | RA='{row[&quot;Recommended Action&quot;]}' | Owner='{row[&quot;Action Owner&quot;]}'&quot;);&#xA;&#xA;        reportRowNumber++;&#xA;        processed++;&#xA;        if (processed % 50000 == 0)&#xA;            System.Console.WriteLine($&quot;[PASS2] Processed {processed} CMS/new rows so far...&quot;);&#xA;        continue;&#xA;    }&#xA;&#xA;    // ===== Other classifications (legacy-safe except where we explicitly override FX auto) =====&#xA;&#xA;    // Refund&#xA;    if (!legacyLocked &amp;&amp; normNarr.IndexOf(&quot;refund&quot;, System.StringComparison.Ordinal) &gt;= 0)&#xA;    {&#xA;        row[&quot;Root Cause&quot;]          = &quot;Refund not yet posted&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;]  = &quot;Post the pending refund&quot;;&#xA;        row[&quot;Action Owner&quot;]        = &quot;Card Settlement&quot;;&#xA;    }&#xA;    // Wakala (guarded so it never grabs Load/Reload)&#xA;    else if (!legacyLocked &amp;&amp;&#xA;             normNarr.StartsWith(&quot;transfer debit from 3rd party&quot;, System.StringComparison.Ordinal))&#xA;    {&#xA;        row[&quot;Root Cause&quot;]          = &quot;Wakala updated CMS only&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;]  = &quot;Perform MISC ADJUSTMENT CREDIT&quot;;&#xA;        row[&quot;Action Owner&quot;]        = &quot;Stephen Jilala&quot;;&#xA;    }&#xA;    // Intra-wallet / intraclient&#xA;    else if (!legacyLocked &amp;&amp;&#xA;            (normNarr.IndexOf(&quot;intraclient&quot;, System.StringComparison.Ordinal) &gt;= 0 ||&#xA;             normNarr.IndexOf(&quot;wallet to wallet&quot;, System.StringComparison.Ordinal) &gt;= 0))&#xA;    {&#xA;        row[&quot;Root Cause&quot;]          = &quot;Intra-wallet transfer updated CMS only&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;&#xA;        if (billingCurrencyNorm != reconCurrencyNormalized)&#xA;        {&#xA;            decimal txnAmtVal;&#xA;            string txClean = (transactionAmount ?? &quot;&quot;).Replace(&quot;,&quot;, &quot;&quot;).Trim();&#xA;            if (decimal.TryParse(txClean, out txnAmtVal))&#xA;            {&#xA;                row[&quot;Billing Amount&quot;] = (-1m * txnAmtVal).ToString(&quot;F2&quot;);&#xA;                billingAmount = row[&quot;Billing Amount&quot;].ToString();&#xA;            }&#xA;        }&#xA;&#xA;        string sa2 = &quot;0.00&quot;;&#xA;        {&#xA;            string s4 = (settlementAmount ?? &quot;&quot;).Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;).Trim();&#xA;            decimal d4;&#xA;            sa2 = decimal.TryParse(s4, out d4) ? d4.ToString(&quot;F2&quot;) : &quot;0.00&quot;;&#xA;        }&#xA;        string ta2 = &quot;0.00&quot;;&#xA;        {&#xA;            string s5 = (transactionAmount ?? &quot;&quot;).Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;).Trim();&#xA;            decimal d5;&#xA;            ta2 = decimal.TryParse(s5, out d5) ? d5.ToString(&quot;F2&quot;) : &quot;0.00&quot;;&#xA;        }&#xA;&#xA;        row[&quot;Recommended Action&quot;] =&#xA;            &quot;Debit 101-202030015 (&quot; + settlementCurrency + &quot; &quot; + sa2 + &quot;) and &quot;&#xA;          + &quot;Credit 101-202030015 (&quot; + transactionCurrency + &quot; &quot; + ta2 + &quot;)&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;    }&#xA;    // Cash Advance unsuccessful ATM / related charges (principal + charges)&#xA;    else if (!legacyLocked &amp;&amp;&#xA;        (normNarr.StartsWith(&quot;cash advance/ cash at pos / cash out&quot;, System.StringComparison.Ordinal) ||&#xA;         normNarr.StartsWith(&quot;cash advance/ cash at pos / cash out transaction fee&quot;, System.StringComparison.Ordinal) ||&#xA;         normNarr.StartsWith(&quot;service tax/tax on income&quot;, System.StringComparison.Ordinal) ||&#xA;         normNarr.IndexOf(&quot;transaction fee&quot;, System.StringComparison.Ordinal) &gt;= 0))&#xA;    {&#xA;        bool isPrincipalCashAdvance =&#xA;            normNarr.StartsWith(&quot;cash advance/ cash at pos / cash out&quot;, System.StringComparison.Ordinal);&#xA;&#xA;        bool hasMatchingPrincipal = false;&#xA;        if (isPrincipalCashAdvance)&#xA;        {&#xA;            hasMatchingPrincipal = true; // principal row itself&#xA;        }&#xA;        else&#xA;        {&#xA;            var mPan2 = panRegex.Match(narration ?? &quot;&quot;);&#xA;            var mRrn2 = rrnRegex.Match(narration ?? &quot;&quot;);&#xA;            if (mPan2.Success &amp;&amp; mRrn2.Success)&#xA;            {&#xA;                string key = mPan2.Value + &quot;|&quot; + mRrn2.Value.ToUpperInvariant();&#xA;                hasMatchingPrincipal = principalIndex.Contains(key);&#xA;            }&#xA;        }&#xA;&#xA;        if (hasMatchingPrincipal)&#xA;        {&#xA;            row[&quot;Root Cause&quot;]          = &quot;Unsuccessful ATM withdrawal transaction and charges updated CMS only&quot;;&#xA;            row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;            row[&quot;Recommended Action&quot;]  = &quot;Process MISC ADJUSTMENT CREDIT&quot;;&#xA;            row[&quot;Action Owner&quot;]        = &quot;Stephen Jilala&quot;;&#xA;        }&#xA;        else&#xA;        {&#xA;            row[&quot;Root Cause&quot;]          = &quot;Prepaid Card Income updated on CMS only&quot;;&#xA;            row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;            row[&quot;Recommended Action&quot;]  = &quot;Post the income manually&quot;;&#xA;            row[&quot;Action Owner&quot;]        = &quot;Card Finance&quot;;&#xA;        }&#xA;    }&#xA;    // MoneySend&#xA;    else if (!legacyLocked &amp;&amp;&#xA;             (normNarr.IndexOf(&quot;moneysend&quot;, System.StringComparison.Ordinal) &gt;= 0 ||&#xA;              normNarr.IndexOf(&quot;money send&quot;, System.StringComparison.Ordinal) &gt;= 0))&#xA;    {&#xA;        row[&quot;Root Cause&quot;]          = &quot;MoneySend not yet posted&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;]  = &quot;Post the pending MoneySend&quot;;&#xA;        row[&quot;Action Owner&quot;]        = &quot;Card Settlement&quot;;&#xA;    }&#xA;    // Misc debit/credit&#xA;    else if (!legacyLocked &amp;&amp;&#xA;            (normNarr.IndexOf(&quot;miscellaneous debit&quot;, System.StringComparison.Ordinal) &gt;= 0 ||&#xA;             normNarr.IndexOf(&quot;miscellaneous credit&quot;, System.StringComparison.Ordinal) &gt;= 0))&#xA;    {&#xA;        row[&quot;Root Cause&quot;]          = &quot;Unmatched manual entries&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;]  = &quot;To be manually matched&quot;;&#xA;        row[&quot;Action Owner&quot;]        = &quot;Card Reconciliation&quot;;&#xA;    }&#xA;    // NON-API remote-on-us patterns (but NOT income/fees — already skipped earlier)&#xA;    else if (!legacyLocked &amp;&amp;&#xA;             channelUpper != &quot;API&quot; &amp;&amp;&#xA;             (normNarr.StartsWith(&quot;cash withdrawal&quot;, System.StringComparison.Ordinal) ||&#xA;              normNarr.StartsWith(&quot;purchase/auth completion&quot;, System.StringComparison.Ordinal) ||&#xA;              normNarr.StartsWith(&quot;unique txn&quot;, System.StringComparison.Ordinal) ||&#xA;              normNarr.StartsWith(&quot;recurring transaction&quot;, System.StringComparison.Ordinal)))&#xA;    {&#xA;        row[&quot;Root Cause&quot;]          = DEF_RC;&#xA;        row[&quot;Root Cause Category&quot;] = DEF_RCAT;&#xA;        row[&quot;Recommended Action&quot;]  = DEF_ACT;&#xA;        row[&quot;Action Owner&quot;]        = DEF_OWN;&#xA;    }&#xA;    else&#xA;    {&#xA;        if (!legacyLocked)&#xA;        {&#xA;            row[&quot;Root Cause&quot;]          = DEF_RC;&#xA;            row[&quot;Root Cause Category&quot;] = DEF_RCAT;&#xA;            row[&quot;Recommended Action&quot;]  = DEF_ACT;&#xA;            row[&quot;Action Owner&quot;]        = DEF_OWN;&#xA;        }&#xA;    }&#xA;&#xA;    // Final safety: fill blanks with defaults (does not change legacy text)&#xA;    if (IsNullOrWhite(row[&quot;Root Cause&quot;]))          row[&quot;Root Cause&quot;]          = DEF_RC;&#xA;    if (IsNullOrWhite(row[&quot;Root Cause Category&quot;])) row[&quot;Root Cause Category&quot;] = DEF_RCAT;&#xA;    if (IsNullOrWhite(row[&quot;Recommended Action&quot;]))  row[&quot;Recommended Action&quot;]  = DEF_ACT;&#xA;    if (IsNullOrWhite(row[&quot;Action Owner&quot;]))        row[&quot;Action Owner&quot;]        = DEF_OWN;&#xA;&#xA;    reportRowNumber++;&#xA;    processed++;&#xA;    if (processed % 50000 == 0)&#xA;        System.Console.WriteLine($&quot;[PASS2] Processed {processed} CMS/new rows so far...&quot;);&#xA;}&#xA;&#xA;sw.Stop();&#xA;System.Console.WriteLine($&quot;[PASS2] Done in {sw.Elapsed}. CMS/new processed: {processed}. Load/Reload seen: {loadReloadCount}.&quot;);&#xA;" DisplayName="Source = CMS" sap:VirtualizedContainerService.HintSize="450,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_49" Language="CSharp">

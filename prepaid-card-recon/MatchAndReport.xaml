        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Arguments:&#xA;// In/Out: DataTable dtHistoricalReconTransactionsReport&#xA;// In: string reconDate&#xA;&#xA;string[] reconDateFormats = { &quot;dd-MM-yyyy&quot;, &quot;dd-MMM-yyyy&quot;, &quot;d-MMM-yyyy&quot;, &quot;d-MM-yyyy&quot; };&#xA;string[] valueDateFormats = { &quot;dd-MMM-yyyy&quot;, &quot;MM/dd/yyyy&quot;, &quot;M/d/yyyy&quot;, &quot;MM/dd/yyyy HH:mm:ss&quot; };&#xA;System.Globalization.CultureInfo invCulture = System.Globalization.CultureInfo.InvariantCulture;&#xA;&#xA;System.DateTime reconDateParsed;&#xA;if (!System.DateTime.TryParseExact(reconDate, reconDateFormats, invCulture, System.Globalization.DateTimeStyles.None, out reconDateParsed))&#xA;    throw new Exception($&quot;❌ Could not parse reconDate: '{reconDate}'&quot;);&#xA;&#xA;// ---------- Helpers ----------&#xA;decimal ParseAmount(object v)&#xA;{&#xA;    if (v == null || v == System.DBNull.Value) return 0m;&#xA;    string s = v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;);&#xA;    if (s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;)) s = &quot;-&quot; + s.Substring(1, s.Length - 2);&#xA;    decimal d;&#xA;    return decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out d) ? d : 0m;&#xA;}&#xA;&#xA;// Find likely Debit/Credit columns&#xA;var debitCols  = new System.Collections.Generic.List&lt;string&gt;();&#xA;var creditCols = new System.Collections.Generic.List&lt;string&gt;();&#xA;&#xA;foreach (System.Data.DataColumn col in dtHistoricalReconTransactionsReport.Columns)&#xA;{&#xA;    var name = col.ColumnName.Trim();&#xA;    if (name.StartsWith(&quot;Debit (&quot;,  System.StringComparison.OrdinalIgnoreCase) &amp;&amp; name.EndsWith(&quot;)&quot;))&#xA;        debitCols.Add(name);&#xA;    if (name.StartsWith(&quot;Credit (&quot;, System.StringComparison.OrdinalIgnoreCase) &amp;&amp; name.EndsWith(&quot;)&quot;))&#xA;        creditCols.Add(name);&#xA;}&#xA;&#xA;// Sum helpers across multiple Debit/Credit columns&#xA;decimal SumDebit(System.Data.DataRow r)&#xA;{&#xA;    decimal s = 0m;&#xA;    for (int i = 0; i &lt; debitCols.Count; i++)&#xA;        s += ParseAmount(r[debitCols[i]]);&#xA;    return s;&#xA;}&#xA;decimal SumCredit(System.Data.DataRow r)&#xA;{&#xA;    decimal s = 0m;&#xA;    for (int i = 0; i &lt; creditCols.Count; i++)&#xA;        s += ParseAmount(r[creditCols[i]]);&#xA;    return s;&#xA;}&#xA;&#xA;// Ensure writable columns exist&#xA;void EnsureCol(System.Data.DataTable dt, string name, System.Type t, object def = null)&#xA;{&#xA;    if (!dt.Columns.Contains(name))&#xA;    {&#xA;        var c = new System.Data.DataColumn(name, t);&#xA;        if (def != null) c.DefaultValue = def;&#xA;        dt.Columns.Add(c);&#xA;        if (def != null)&#xA;            foreach (System.Data.DataRow rr in dt.Rows) rr[name] = def;&#xA;    }&#xA;}&#xA;&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Root Cause&quot;,            typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Root Cause Category&quot;,   typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Recommended Action&quot;,    typeof(string), &quot;&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Action Owner&quot;,          typeof(string), &quot;&quot;);&#xA;&#xA;// ---------- BEFORE balance snapshot ----------&#xA;decimal beforeDebit = 0m, beforeCredit = 0m;&#xA;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    beforeDebit  += SumDebit(r);&#xA;    beforeCredit += SumCredit(r);&#xA;}&#xA;&#xA;decimal beforeDiff = beforeDebit - beforeCredit;&#xA;System.Console.WriteLine($&quot;[BAL] BEFORE — Debit: {beforeDebit:N2} | Credit: {beforeCredit:N2} | Δ(D−C): {beforeDiff:N2}&quot;);&#xA;&#xA;// ---------- Main Logic ----------&#xA;int latePostedCount = 0;&#xA;&#xA;string[] latePostPatterns = { &quot;PPAT&quot;, &quot;AWPC&quot;, &quot;AGW&quot;, &quot;AGR&quot;, &quot;CHWD&amp;AGPS&quot;, &quot;PRDP&quot;, &quot;PRTP&quot;, &quot;CWPP&quot;, &quot;PPPC&quot;, &quot;PPSP&quot;, &quot;ADPP&quot;, &quot;PPSA&quot;, &quot;ADPC&quot;, &quot;CCSA&quot;, &quot;CCSP&quot;, &quot;UMJP&quot;, &quot;AWPU&quot; };&#xA;&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string refNo = row.Table.Columns.Contains(&quot;Transaction Ref No:&quot;)&#xA;        ? (row[&quot;Transaction Ref No:&quot;]?.ToString()?.ToUpperInvariant() ?? &quot;&quot;)&#xA;        : &quot;&quot;;&#xA;&#xA;    string valueDateStr = row.Table.Columns.Contains(&quot;Value Date&quot;)&#xA;        ? (row[&quot;Value Date&quot;]?.ToString() ?? &quot;&quot;)&#xA;        : &quot;&quot;;&#xA;&#xA;    // Must contain any pattern&#xA;    bool matchFound = false;&#xA;    for (int p = 0; p &lt; latePostPatterns.Length &amp;&amp; !matchFound; p++)&#xA;        if (!string.IsNullOrEmpty(refNo) &amp;&amp; refNo.Contains(latePostPatterns[p]))&#xA;            matchFound = true;&#xA;&#xA;    if (!matchFound) continue;&#xA;&#xA;    System.DateTime valueDate;&#xA;    bool parsed = System.DateTime.TryParseExact(valueDateStr, valueDateFormats, invCulture, System.Globalization.DateTimeStyles.None, out valueDate)&#xA;               || System.DateTime.TryParse(valueDateStr, out valueDate);&#xA;&#xA;    if (parsed)&#xA;    {&#xA;        // Allow ±2 days window&#xA;        var startRange = reconDateParsed.AddDays(-2);&#xA;        var endRange   = reconDateParsed.AddDays( 2);&#xA;&#xA;        if (valueDate &gt;= startRange &amp;&amp; valueDate &lt;= endRange)&#xA;        {&#xA;            row[&quot;Root Cause&quot;]          = &quot;Late posted transaction&quot;;&#xA;            row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;            row[&quot;Recommended Action&quot;]  = &quot;Check if updates CMS on the following date&quot;;&#xA;            row[&quot;Action Owner&quot;]        = &quot;Card Reconciliation&quot;;&#xA;            latePostedCount++;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;System.Console.WriteLine($&quot;✅ Late posted override complete. Total late-posted rows: {latePostedCount}&quot;);&#xA;&#xA;// ---------- AFTER balance snapshot ----------&#xA;decimal afterDebit = 0m, afterCredit = 0m;&#xA;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    afterDebit  += SumDebit(r);&#xA;    afterCredit += SumCredit(r);&#xA;}&#xA;&#xA;decimal afterDiff = afterDebit - afterCredit;&#xA;&#xA;System.Console.WriteLine($&quot;[BAL] AFTER  — Debit: {afterDebit:N2} | Credit: {afterCredit:N2} | Δ(D−C): {afterDiff:N2}&quot;);&#xA;&#xA;const decimal BAL_TOL = 0.01m;&#xA;decimal gap = System.Math.Abs(beforeDiff - afterDiff);&#xA;&#xA;if (gap &lt;= BAL_TOL)&#xA;    System.Console.WriteLine($&quot;✅ Consistency OK: Δ_before ({beforeDiff:N2}) ≈ Δ_after ({afterDiff:N2}) within ±{BAL_TOL:N2}.&quot;);&#xA;else&#xA;    System.Console.WriteLine($&quot;⚠️ Consistency MISMATCH: Δ_before ({beforeDiff:N2}) vs Δ_after ({afterDiff:N2}); gap = {gap:N2} (&gt; ±{BAL_TOL:N2}).&quot;);&#xA;&#xA;// ---------- SUMMARY BLOCK ----------&#xA;System.Console.WriteLine(&quot;========== LATE POSTED SUMMARY ==========&quot;);&#xA;System.Console.WriteLine($&quot;Total rows scanned: {dtHistoricalReconTransactionsReport.Rows.Count}&quot;);&#xA;System.Console.WriteLine($&quot;Late-posted rows identified: {latePostedCount}&quot;);&#xA;&#xA;System.Console.WriteLine();&#xA;System.Console.WriteLine(&quot;----- Balance Summary -----&quot;);&#xA;System.Console.WriteLine($&quot;Before  -&gt; Debit: {beforeDebit:N2} | Credit: {beforeCredit:N2} | Δ(D−C): {beforeDiff:N2}&quot;);&#xA;System.Console.WriteLine($&quot;After   -&gt; Debit: {afterDebit:N2} | Credit: {afterCredit:N2} | Δ(D−C): {afterDiff:N2}&quot;);&#xA;System.Console.WriteLine($&quot;Change  -&gt; Gap: {gap:N2} (Tolerance ±{BAL_TOL:N2})&quot;);&#xA;System.Console.WriteLine(&quot;=========================================&quot;);&#xA;" DisplayName="dtHistoricalReconTransactionsReport Late Posted Classification " sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_24" Language="CSharp">

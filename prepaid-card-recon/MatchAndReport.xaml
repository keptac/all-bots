        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: ALL GL ROWS — CWPP label + Strict 16-char Auto Rules + Strict 16-char Late Posted + Integrity Sweep + UTLP + PPAT CLEANUP =====&#xA;// OPTION A: STRICT MODE — All Auto Rules + Late Posted ONLY apply when Transaction Ref No (cleaned) is exactly 16 characters (for GL rules).&#xA;// PPAT CLEANUP: narration-based PPAT classification + Unmatched cleanup + FINAL PPAT Late Posted override (±2 days).&#xA;//&#xA;// In/Out: DataTable dtHistoricalReconTransactionsReport&#xA;// In    : DataTable dtHistoricalReconTransactionsReportMatched (optional)&#xA;// In    : string reconDate&#xA;&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport));&#xA;&#xA;var swAll = System.Diagnostics.Stopwatch.StartNew();&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// Helpers (shared)&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;void EnsureCol(System.Data.DataTable dt, string name)&#xA;{&#xA;    if (!dt.Columns.Contains(name))&#xA;        dt.Columns.Add(name, typeof(string));&#xA;}&#xA;&#xA;string GetStr(System.Data.DataRow r, string col)&#xA;{&#xA;    if (!r.Table.Columns.Contains(col)) return &quot;&quot;;&#xA;    var v = r[col];&#xA;    return (v == null || v == System.DBNull.Value) ? &quot;&quot; : v.ToString();&#xA;}&#xA;&#xA;bool SetIfEmpty(System.Data.DataRow r, string col, string val)&#xA;{&#xA;    EnsureCol(r.Table, col);&#xA;    if (string.IsNullOrWhiteSpace(GetStr(r, col)))&#xA;    {&#xA;        r[col] = val ?? &quot;&quot;;&#xA;        return true;&#xA;    }&#xA;    return false;&#xA;}&#xA;&#xA;DateTime? ParseDateFlexible(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return null;&#xA;&#xA;    if (val is DateTime dt) return dt;&#xA;&#xA;    if (val is double d)&#xA;    {&#xA;        try { return DateTime.FromOADate(d); } catch { }&#xA;    }&#xA;&#xA;    double d2;&#xA;    if (double.TryParse(&#xA;            Convert.ToString(val),&#xA;            System.Globalization.NumberStyles.Float,&#xA;            System.Globalization.CultureInfo.InvariantCulture,&#xA;            out d2))&#xA;    {&#xA;        try { return DateTime.FromOADate(d2); } catch { }&#xA;    }&#xA;&#xA;    string s = Convert.ToString(val).Trim();&#xA;    string[] fmts =&#xA;    {&#xA;        &quot;dd/MM/yyyy&quot;,&quot;dd/MM/yyyy HH:mm:ss&quot;,&quot;dd/MM/yyyy HH:mm&quot;,&#xA;        &quot;yyyy-MM-dd&quot;,&quot;yyyy-MM-dd HH:mm:ss&quot;,&quot;yyyy/MM/dd&quot;,&#xA;        &quot;dd-MMM-yyyy&quot;,&quot;d-MMM-yyyy&quot; // added for 02-Nov-2025 style dates&#xA;    };&#xA;&#xA;    DateTime exact;&#xA;    if (DateTime.TryParseExact(&#xA;            s,&#xA;            fmts,&#xA;            System.Globalization.CultureInfo.InvariantCulture,&#xA;            System.Globalization.DateTimeStyles.None,&#xA;            out exact))&#xA;        return exact;&#xA;&#xA;    DateTime any;&#xA;    if (DateTime.TryParse(s, out any)) return any;&#xA;&#xA;    return null;&#xA;}&#xA;&#xA;// Compute cleaned reference string&#xA;string CleanRef(string refRaw)&#xA;{&#xA;    return (refRaw ?? &quot;&quot;)&#xA;        .Replace(&quot; &quot;, &quot;&quot;)&#xA;        .Trim()&#xA;        .ToUpperInvariant();&#xA;}&#xA;&#xA;// TRUE only if cleaned ref is 16 chars&#xA;bool Is16CharRef(string refRaw)&#xA;{&#xA;    return CleanRef(refRaw).Length == 16;&#xA;}&#xA;&#xA;// Column-name normalizer for robust lookup&#xA;string NormalizeColName(string name)&#xA;{&#xA;    if (name == null) return &quot;&quot;;&#xA;    name = name.Replace('\u00A0', ' '); // NBSP -&gt; space&#xA;    name = name.Trim();&#xA;    name = name.ToUpperInvariant();&#xA;    name = System.Text.RegularExpressions.Regex.Replace(name, @&quot;\s+&quot;, &quot; &quot;); // collapse spaces&#xA;    name = name.Replace(&quot;:&quot;, &quot;&quot;); // drop colon&#xA;    return name;&#xA;}&#xA;&#xA;string FindFirstExistingColumn(System.Data.DataTable dt, params string[] names)&#xA;{&#xA;    if (dt == null) return null;&#xA;&#xA;    var map = new System.Collections.Generic.Dictionary&lt;string, string&gt;();&#xA;    foreach (System.Data.DataColumn c in dt.Columns)&#xA;    {&#xA;        var norm = NormalizeColName(c.ColumnName);&#xA;        if (!map.ContainsKey(norm))&#xA;            map[norm] = c.ColumnName; // original&#xA;    }&#xA;&#xA;    foreach (var n in names)&#xA;    {&#xA;        if (string.IsNullOrEmpty(n)) continue;&#xA;        var normWanted = NormalizeColName(n);&#xA;        if (map.TryGetValue(normWanted, out var real))&#xA;            return real;&#xA;    }&#xA;&#xA;    return null;&#xA;}&#xA;&#xA;string U(string s) =&gt; (s ?? &quot;&quot;).Trim().ToUpperInvariant();&#xA;&#xA;string NormalizeSoft(string s)&#xA;{&#xA;    var x = U(s);&#xA;    x = System.Text.RegularExpressions.Regex.Replace(x, @&quot;[-_]+&quot;, &quot; &quot;);&#xA;    x = System.Text.RegularExpressions.Regex.Replace(x, @&quot;\s+&quot;, &quot; &quot;);&#xA;    return x;&#xA;}&#xA;&#xA;bool ContainsAny(string hay, params string[] needles)&#xA;{&#xA;    hay = NormalizeSoft(hay);&#xA;    foreach (var n in needles)&#xA;    {&#xA;        var nn = NormalizeSoft(n);&#xA;        if (hay.Contains(nn)) return true;&#xA;    }&#xA;    return false;&#xA;}&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// Integrity &amp; classification recognizers (GL)&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;bool IsUMJP_UbxLabel(System.Data.DataRow r)&#xA;{&#xA;    return GetStr(r,&quot;Root Cause&quot;)          == &quot;Wrong configuration of UBX ATM charges&quot; &amp;&amp;&#xA;           GetStr(r,&quot;Root Cause Category&quot;) == &quot;People&quot; &amp;&amp;&#xA;           GetStr(r,&quot;Recommended Action&quot;)  == &quot;Reverse the charges and correctly configure CBS to pass the right charges&quot; &amp;&amp;&#xA;           GetStr(r,&quot;Action Owner&quot;)        == &quot;Card Settlement &amp; Stephen Jilala&quot;;&#xA;}&#xA;&#xA;bool IsCashbackLabel(System.Data.DataRow r)&#xA;{&#xA;    return GetStr(r,&quot;Root Cause&quot;)          == &quot;Cashback updated CBS only&quot; &amp;&amp;&#xA;           GetStr(r,&quot;Root Cause Category&quot;) == &quot;System&quot; &amp;&amp;&#xA;           GetStr(r,&quot;Recommended Action&quot;)  == &quot;Perform MISC ADJUSTMENT CREDIT&quot; &amp;&amp;&#xA;           GetStr(r,&quot;Action Owner&quot;)        == &quot;Stephen Jilala&quot;;&#xA;}&#xA;&#xA;bool IsCashbackLocked(System.Data.DataRow r)&#xA;{&#xA;    return GetStr(r, &quot;CashbackLock&quot;) == &quot;1&quot;;&#xA;}&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// GLOBAL PROTECTED ROOT CAUSES — SKIP ALL PROCESSING IN THIS MODULE&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;var protectedRootCauses = new System.Collections.Generic.HashSet&lt;string&gt;(System.StringComparer.OrdinalIgnoreCase)&#xA;{&#xA;    &quot;Wakala withdrawal debited TZS instead of FX GL&quot;,&#xA;    &quot;FX billed withdrawal posted as TZS debit&quot;&#xA;    // &lt;&lt;&lt; ADD MORE ROOT CAUSE TEXTS HERE AS NEEDED&#xA;};&#xA;&#xA;bool IsProtectedRootCause(System.Data.DataRow r)&#xA;{&#xA;    string rc = GetStr(r, &quot;Root Cause&quot;);&#xA;    if (string.IsNullOrWhiteSpace(rc)) return false;&#xA;    return protectedRootCauses.Contains(rc.Trim());&#xA;}&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// Strict Late Posted logic — only 16-char references allowed (GL rules)&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;DateTime? reconParsed = ParseDateFlexible(reconDate);&#xA;&#xA;bool ShouldMarkLatePosted(System.Data.DataRow row)&#xA;{&#xA;    // STRICT MODE: Late Posted ONLY if 16-char reference&#xA;    if (!Is16CharRef(GetStr(row, &quot;Transaction Ref No:&quot;)))&#xA;        return false;&#xA;&#xA;    if (reconParsed == null) return false;&#xA;&#xA;    if (!row.Table.Columns.Contains(&quot;Value Date&quot;))&#xA;        return false;&#xA;&#xA;    DateTime? v = ParseDateFlexible(row[&quot;Value Date&quot;]);&#xA;    if (v == null) return false;&#xA;&#xA;    DateTime start = reconParsed.Value.AddDays(-2).Date;&#xA;    DateTime end   = reconParsed.Value.AddDays(+2).Date;&#xA;&#xA;    return v.Value.Date &gt;= start &amp;&amp; v.Value.Date &lt;= end;&#xA;}&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// Ensure required columns&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;string[] needCols = {&#xA;    &quot;Branch code&quot;,&quot;GL_Code&quot;,&quot;GL Description&quot;,&#xA;    &quot;Transaction Ref No:&quot;,&quot;Narration&quot;,&#xA;    &quot;Root Cause&quot;,&quot;Root Cause Category&quot;,&quot;Recommended Action&quot;,&quot;Action Owner&quot;,&#xA;    &quot;Aging&quot;,&quot;Aging Group&quot;,&quot;BOT Classification&quot;,&#xA;    &quot;Type&quot;,&quot;Source&quot;,&quot;CashbackLock&quot;,&quot;CashbackKey&quot;,&#xA;    &quot;ROOT_CAUSE_PROCESSED&quot;,&quot;Classification&quot;&#xA;};&#xA;foreach (string c in needCols) EnsureCol(dtHistoricalReconTransactionsReport, c);&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// Default GL rule values&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;const string DEF_RC_GL   = &quot;Unmatched manual entries&quot;;&#xA;const string DEF_RCAT_GL = &quot;System&quot;;&#xA;const string DEF_ACT_GL  = &quot;To be manually matched&quot;;&#xA;const string DEF_OWN_GL  = &quot;Card Reconciliation&quot;;&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// Build CWPP set from Matched table&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;var cwppSet = new System.Collections.Generic.HashSet&lt;string&gt;(System.StringComparer.OrdinalIgnoreCase);&#xA;&#xA;if (dtHistoricalReconTransactionsReportMatched != null &amp;&amp;&#xA;    dtHistoricalReconTransactionsReportMatched.Columns.Contains(&quot;Transaction Ref No:&quot;))&#xA;{&#xA;    foreach (System.Data.DataRow m in dtHistoricalReconTransactionsReportMatched.Rows)&#xA;    {&#xA;        string rc = CleanRef(GetStr(m, &quot;Transaction Ref No:&quot;));&#xA;        if (rc.Contains(&quot;CWPP&quot;) || rc.Contains(&quot;PPPC&quot;))&#xA;            cwppSet.Add(rc);&#xA;    }&#xA;}&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// PASS A — GL classification with strict 16-char gating (UTLP forced away from default)&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    // GLOBAL SKIP: protected Root Causes&#xA;    if (IsProtectedRootCause(row))&#xA;        continue;&#xA;&#xA;    // GLOBAL SKIP: already processed elsewhere (PPAT, PPSA, PPSP, etc.)&#xA;    string processedFlag = GetStr(row, &quot;ROOT_CAUSE_PROCESSED&quot;).Trim().ToUpperInvariant();&#xA;    if (processedFlag == &quot;TRUE&quot;)&#xA;        continue;&#xA;&#xA;    if (!GetStr(row, &quot;Source&quot;).Equals(&quot;GL&quot;, StringComparison.OrdinalIgnoreCase))&#xA;        continue;&#xA;&#xA;    // Static GL values&#xA;    row[&quot;Branch code&quot;]    = &quot;101&quot;;&#xA;    row[&quot;GL_Code&quot;]        = &quot;202030015&quot;;&#xA;    row[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;&#xA;    string refRaw   = GetStr(row, &quot;Transaction Ref No:&quot;);&#xA;    string refClean = CleanRef(refRaw);&#xA;    bool is16       = (refClean.Length == 16);&#xA;&#xA;    string narr = GetStr(row, &quot;Narration&quot;).ToLowerInvariant();&#xA;&#xA;    // Preserve any rows that already have sensitive labels&#xA;    bool preserve =&#xA;        IsCashbackLabel(row) ||&#xA;        IsCashbackLocked(row) ||&#xA;        IsUMJP_UbxLabel(row);&#xA;        // Protected root causes already skipped above&#xA;&#xA;    // Flags from reference&#xA;    bool hasCWPP = refClean.Contains(&quot;CWPP&quot;) || refClean.Contains(&quot;PPPC&quot;);&#xA;    bool hasUMJP = refClean.Contains(&quot;UMJP&quot;) || refClean.Contains(&quot;AWPU&quot;);&#xA;    bool hasUBX  = refClean.Contains(&quot;UBX&quot;);&#xA;    bool hasAGW  = refClean.Contains(&quot;AGW&quot;) || refClean.Contains(&quot;CHWD&amp;AGPS&quot;);&#xA;    bool hasPRDP = refClean.Contains(&quot;PRDP&quot;) || refClean.Contains(&quot;PRTP&quot;);&#xA;    bool hasAGR1 = refClean.Contains(&quot;AGR1&quot;);&#xA;    bool hasAGR2 = refClean.Contains(&quot;AGR2&quot;);&#xA;    bool hasAGR3 = refClean.Contains(&quot;AGR3&quot;);&#xA;    bool hasUTLP = refClean.Contains(&quot;UTLP&quot;);  // 16-char automatic UTLP ref&#xA;&#xA;    if (!preserve)&#xA;    {&#xA;        // 1. UTLP — automatic transaction, must NEVER be &quot;Unmatched manual entries&quot;&#xA;        //    Only valid inside 16-char regime.&#xA;        if (is16 &amp;&amp; hasUTLP)&#xA;        {&#xA;            row[&quot;Root Cause&quot;]           = &quot;Entries not yet established&quot;;&#xA;            row[&quot;Root Cause Category&quot;]  = &quot;People&quot;;&#xA;            row[&quot;Recommended Action&quot;]   = &quot;To advise&quot;;&#xA;            row[&quot;Action Owner&quot;]         = &quot;ICT&quot;;&#xA;            row[&quot;ROOT_CAUSE_PROCESSED&quot;] = &quot;TRUE&quot;;&#xA;        }&#xA;        // 2. Narration date-range rule (DOES NOT require 16-char reference)&#xA;        else if (System.Text.RegularExpressions.Regex.IsMatch(&#xA;                     narr,&#xA;                     @&quot;\b(for|from)\s?\d{6}(\s?(to|_)\s?\d{6})\b&quot;))&#xA;        {&#xA;            row[&quot;Root Cause&quot;]          = &quot;Manually posted income not matching with income from CMS&quot;;&#xA;            row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;            row[&quot;Recommended Action&quot;]  = &quot;Reverse the wrong amount and post the correct one&quot;;&#xA;            row[&quot;Action Owner&quot;]        = &quot;Card Finance&quot;;&#xA;        }&#xA;        // 3. All other auto rules require strict 16-char ref&#xA;        else if (is16)&#xA;        {&#xA;            // CWPP&#xA;            if (hasCWPP &amp;&amp; cwppSet.Contains(refClean))&#xA;            {&#xA;                row[&quot;Root Cause&quot;]          = &quot;Cashback updated CBS only&quot;;&#xA;                row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;                row[&quot;Recommended Action&quot;]  = &quot;Perform MISC ADJUSTMENT CREDIT&quot;;&#xA;                row[&quot;Action Owner&quot;]        = &quot;Stephen Jilala&quot;;&#xA;                row[&quot;CashbackLock&quot;]        = &quot;1&quot;;&#xA;                row[&quot;CashbackKey&quot;]         = &quot;REFNO=&quot; + refClean;&#xA;            }&#xA;            // UMJP (UBX mischarges)&#xA;            else if (hasUMJP &amp;&amp;&#xA;                     (narr.Contains(&quot;cash withdraw charge&quot;) ||&#xA;                      narr.Contains(&quot;vat payable on comm and fees&quot;) ||&#xA;                      narr.Contains(&quot;atm withdrawl prepaid&quot;)))&#xA;            {&#xA;                row[&quot;Root Cause&quot;]          = &quot;Wrong configuration of UBX ATM charges&quot;;&#xA;                row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;                row[&quot;Recommended Action&quot;]  = &quot;Reverse the charges and correctly configure CBS to pass the right charges&quot;;&#xA;                row[&quot;Action Owner&quot;]        = &quot;Card Settlement &amp; Stephen Jilala&quot;;&#xA;            }&#xA;            // UBX&#xA;            else if (hasUBX)&#xA;            {&#xA;                row[&quot;Root Cause&quot;]          = &quot;UBX fee updated CBS only&quot;;&#xA;                row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;                row[&quot;Recommended Action&quot;]  = &quot;Perform adjustment in CBS&quot;;&#xA;                row[&quot;Action Owner&quot;]        = &quot;Card Settlement&quot;;&#xA;            }&#xA;            // AGW&#xA;            else if (hasAGW)&#xA;            {&#xA;                row[&quot;Root Cause&quot;]          = &quot;Wakala updated CBS only&quot;;&#xA;                row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;                row[&quot;Recommended Action&quot;]  = &quot;Under investigation&quot;;&#xA;                row[&quot;Action Owner&quot;]        = &quot;Stephen Jilala&quot;;&#xA;            }&#xA;            // PRDP / AGR1 / AGR2&#xA;            else if (hasPRDP || hasAGR1 || hasAGR2 || hasAGR3)&#xA;            {&#xA;                row[&quot;Root Cause&quot;]          = &quot;Loading updated CBS only&quot;;&#xA;                row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;                row[&quot;Recommended Action&quot;]  = &quot;Perform MISC ADJUSTMENT CREDIT&quot;;&#xA;                row[&quot;Action Owner&quot;]        = &quot;Stephen Jilala&quot;;&#xA;            }&#xA;            else&#xA;            {&#xA;                // DEFAULT GL for 16-char refs not matching any pattern (and NOT UTLP)&#xA;                row[&quot;Root Cause&quot;]          = DEF_RC_GL;&#xA;                row[&quot;Root Cause Category&quot;] = DEF_RCAT_GL;&#xA;                row[&quot;Recommended Action&quot;]  = DEF_ACT_GL;&#xA;                row[&quot;Action Owner&quot;]        = DEF_OWN_GL;&#xA;            }&#xA;        }&#xA;        else&#xA;        {&#xA;            // NOT 16 chars → Strict default GL ONLY&#xA;            row[&quot;Root Cause&quot;]          = DEF_RC_GL;&#xA;            row[&quot;Root Cause Category&quot;] = DEF_RCAT_GL;&#xA;            row[&quot;Recommended Action&quot;]  = DEF_ACT_GL;&#xA;            row[&quot;Action Owner&quot;]        = DEF_OWN_GL;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// PASS B — STRICT 16-CHAR LATE POSTED  (GL-side; ONLY thing allowed to override processed rows)&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    string src = GetStr(row, &quot;Source&quot;).Trim().ToUpperInvariant();&#xA;    if (src != &quot;GL&quot;) continue;&#xA;&#xA;    // Never touch globally protected root causes&#xA;    if (IsProtectedRootCause(row))&#xA;        continue;&#xA;&#xA;    // Never alter cashback&#xA;    if (IsCashbackLabel(row) || IsCashbackLocked(row))&#xA;        continue;&#xA;&#xA;    // STRICT MODE: Late Posted ONLY IF 16-char reference&#xA;    if (!Is16CharRef(GetStr(row, &quot;Transaction Ref No:&quot;)))&#xA;        continue;&#xA;&#xA;    if (ShouldMarkLatePosted(row))&#xA;    {&#xA;        // GL late posted is non-overriding: only fill if empty&#xA;        SetIfEmpty(row, &quot;Root Cause&quot;,          &quot;Late posted transaction&quot;);&#xA;        SetIfEmpty(row, &quot;Root Cause Category&quot;, &quot;System&quot;);&#xA;        SetIfEmpty(row, &quot;Recommended Action&quot;,  &quot;Check if updates CMS on the following date&quot;);&#xA;        SetIfEmpty(row, &quot;Action Owner&quot;,        &quot;Card Reconciliation&quot;);&#xA;        // We intentionally do NOT touch ROOT_CAUSE_PROCESSED here.&#xA;    }&#xA;}&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// FINAL GL — Cashback Integrity Sweep (still respects ROOT_CAUSE_PROCESSED)&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    // Skip globally protected root causes&#xA;    if (IsProtectedRootCause(row))&#xA;        continue;&#xA;&#xA;    string processedFlag = GetStr(row, &quot;ROOT_CAUSE_PROCESSED&quot;).Trim().ToUpperInvariant();&#xA;    if (processedFlag == &quot;TRUE&quot;)&#xA;        continue;&#xA;&#xA;    if (GetStr(row, &quot;CashbackLock&quot;) == &quot;1&quot;)&#xA;    {&#xA;        if (!IsCashbackLabel(row))&#xA;        {&#xA;            row[&quot;Root Cause&quot;]          = &quot;Cashback updated CBS only&quot;;&#xA;            row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;            row[&quot;Recommended Action&quot;]  = &quot;Perform MISC ADJUSTMENT CREDIT&quot;;&#xA;            row[&quot;Action Owner&quot;]        = &quot;Stephen Jilala&quot;;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;// PPAT CLEANUP MODULE — runs AFTER GL classification (3 phases)&#xA;////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;&#xA;// Detect GL default classification for PPAT rows&#xA;bool IsGlDefault(System.Data.DataRow row)&#xA;{&#xA;    string rc   = GetStr(row, &quot;Root Cause&quot;).Trim();&#xA;    string rcat = GetStr(row, &quot;Root Cause Category&quot;).Trim();&#xA;    string act  = GetStr(row, &quot;Recommended Action&quot;).Trim();&#xA;    string own  = GetStr(row, &quot;Action Owner&quot;).Trim();&#xA;&#xA;    return rc.Equals(DEF_RC_GL,   StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;           rcat.Equals(DEF_RCAT_GL, StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;           act.Equals(DEF_ACT_GL, StringComparison.OrdinalIgnoreCase) &amp;&amp;&#xA;           own.Equals(DEF_OWN_GL, StringComparison.OrdinalIgnoreCase);&#xA;}&#xA;&#xA;void ForcePpat(System.Data.DataRow row)&#xA;{&#xA;    row[&quot;Classification&quot;] = &quot;PPAT&quot;;&#xA;}&#xA;&#xA;void SetPpatTemplate(System.Data.DataRow row)&#xA;{&#xA;    ForcePpat(row);&#xA;    row[&quot;Root Cause&quot;]           = &quot;Unsuccessful ATM withdrawal transaction debited the GL&quot;;&#xA;    row[&quot;Root Cause Category&quot;]  = &quot;System&quot;;&#xA;    row[&quot;Recommended Action&quot;]   = &quot;Follow up with respective branch to suspend the overages as per process&quot;;&#xA;    row[&quot;Action Owner&quot;]         = &quot;ATM Reconciliation Team&quot;;&#xA;}&#xA;&#xA;void SetLatePostedPPAT(System.Data.DataRow row)&#xA;{&#xA;    ForcePpat(row);&#xA;    row[&quot;Root Cause&quot;]           = &quot;Late posted transaction&quot;;&#xA;    row[&quot;Root Cause Category&quot;]  = &quot;System&quot;;&#xA;    row[&quot;Recommended Action&quot;]   = &quot;Check if updates CMS on the following date&quot;;&#xA;    row[&quot;Action Owner&quot;]         = &quot;Card Reconciliation&quot;;&#xA;}&#xA;&#xA;// Shared narration-based PPAT classification helper&#xA;void ClassifyPpatByNarration(System.Data.DataRow row)&#xA;{&#xA;    string narration = GetStr(row, &quot;Narration&quot;);&#xA;&#xA;    // 1) Principal ATM withdrawal&#xA;    if (ContainsAny(narration,&#xA;        &quot;ATM WITHDRAWL PREPAID&quot;, &quot;ATM WITHDRAWAL PREPAID&quot;,&#xA;        &quot;ATM WITHDRAWL&quot;, &quot;ATM WITHDRAWAL&quot;))&#xA;    {&#xA;        SetPpatTemplate(row);&#xA;        return;&#xA;    }&#xA;&#xA;    // 2) Government levy&#xA;    if (ContainsAny(narration, &quot;GOVERNMENT LEVY&quot;, &quot; LEVY&quot;))&#xA;    {&#xA;        ForcePpat(row);&#xA;        row[&quot;Root Cause&quot;]          = &quot;Government levy on unsuccessful ATM withdrawal transactions&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        row[&quot;Recommended Action&quot;]  = &quot;Reverse the levy&quot;;&#xA;        row[&quot;Action Owner&quot;]        = &quot;Card Settlement&quot;;&#xA;        return;&#xA;    }&#xA;&#xA;    // 3) Charges / fees / VAT&#xA;    if (ContainsAny(narration,&#xA;        &quot;CASH WITHDRAW CHARGE&quot;, &quot;CASH WITHDRAWAL CHARGE&quot;,&#xA;        &quot;CASH WITHDRAWAL TRANSACTION FEE&quot;, &quot;TRANSACTION FEE&quot;,&#xA;        &quot;VAT PAYABLE ON COMM AND FEES&quot;, &quot;VAT PAYABLE&quot;, &quot;VAT&quot;))&#xA;    {&#xA;        ForcePpat(row);&#xA;        row[&quot;Root Cause&quot;]          = &quot;Cash withdrawal charges on unsuccessful ATM withdrawal transactions&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        row[&quot;Recommended Action&quot;]  = &quot;Reverse the charge&quot;;&#xA;        row[&quot;Action Owner&quot;]        = &quot;Card Settlement&quot;;&#xA;        return;&#xA;    }&#xA;&#xA;    // 4) Fallback PPAT default&#xA;    SetPpatTemplate(row);&#xA;}&#xA;&#xA;// --- PPAT setup &amp; counters ---&#xA;string txnRefCol = FindFirstExistingColumn(&#xA;    dtHistoricalReconTransactionsReport,&#xA;    &quot;Transaction Ref No:&quot;, &quot;Transaction Ref No&quot;, &quot;Transaction Reference No&quot;,&#xA;    &quot;Transaction Reference Number&quot;, &quot;Txn Ref No&quot;&#xA;);&#xA;&#xA;string valueDateCol = FindFirstExistingColumn(&#xA;    dtHistoricalReconTransactionsReport,&#xA;    &quot;Value Date&quot;, &quot;ValueDate&quot;&#xA;);&#xA;&#xA;int totalRowsPPAT          = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;int totalGlRowsPPAT        = 0;&#xA;int totalGlPpatRows        = 0;&#xA;&#xA;int setNarrPrincipal_GL    = 0;&#xA;int setNarrLevy_GL         = 0;&#xA;int setNarrFee_GL          = 0;&#xA;int setTxnRefOnly_GL       = 0;&#xA;&#xA;int skippedNonPPAT_GL      = 0;&#xA;int skippedNonGL_PPAT      = 0;&#xA;int fixedFromGlDefault     = 0;&#xA;&#xA;int forcedNarrOverride     = 0;  // Phase 2&#xA;int finalLateOverridesPPAT = 0;  // Phase 3&#xA;&#xA;// PHASE 1: GL-only PPAT classification (NO late-post here)&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    // Must be GL for phase 1&#xA;    string source = GetStr(row, &quot;Source&quot;);&#xA;    if (!source.Equals(&quot;GL&quot;, StringComparison.OrdinalIgnoreCase))&#xA;    {&#xA;        skippedNonGL_PPAT++;&#xA;        continue;&#xA;    }&#xA;&#xA;    totalGlRowsPPAT++;&#xA;&#xA;    // TxnRef must contain PPAT&#xA;    string txnRef = (!string.IsNullOrEmpty(txnRefCol) &amp;&amp;&#xA;                     row.Table.Columns.Contains(txnRefCol))&#xA;                    ? GetStr(row, txnRefCol)&#xA;                    : &quot;&quot;;&#xA;&#xA;    bool txnHasPPAT =&#xA;        !string.IsNullOrWhiteSpace(txnRef) &amp;&amp;&#xA;        (txnRef.IndexOf(&quot;PPAT&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0 || txnRef.IndexOf(&quot;AWPC&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0);&#xA;&#xA;    if (!txnHasPPAT)&#xA;    {&#xA;        skippedNonPPAT_GL++;&#xA;        continue;&#xA;    }&#xA;&#xA;    totalGlPpatRows++;&#xA;&#xA;    bool wasGlDefault = IsGlDefault(row);&#xA;&#xA;    string narration = GetStr(row, &quot;Narration&quot;);&#xA;&#xA;    // 1) Principal ATM withdrawal&#xA;    if (ContainsAny(narration,&#xA;        &quot;ATM WITHDRAWL PREPAID&quot;, &quot;ATM WITHDRAWAL PREPAID&quot;,&#xA;        &quot;ATM WITHDRAWL&quot;, &quot;ATM WITHDRAWAL&quot;))&#xA;    {&#xA;        if (wasGlDefault) fixedFromGlDefault++;&#xA;        SetPpatTemplate(row);&#xA;        setNarrPrincipal_GL++;&#xA;        continue;&#xA;    }&#xA;&#xA;    // 2) Government levy&#xA;    if (ContainsAny(narration, &quot;GOVERNMENT LEVY&quot;, &quot; LEVY&quot;))&#xA;    {&#xA;        if (wasGlDefault) fixedFromGlDefault++;&#xA;        ForcePpat(row);&#xA;        row[&quot;Root Cause&quot;]          = &quot;Government levy on unsuccessful ATM withdrawal transactions&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        row[&quot;Recommended Action&quot;]  = &quot;Reverse the levy&quot;;&#xA;        row[&quot;Action Owner&quot;]        = &quot;Card Settlement&quot;;&#xA;        setNarrLevy_GL++;&#xA;        continue;&#xA;    }&#xA;&#xA;    // 3) Charges / fees / VAT&#xA;    if (ContainsAny(narration,&#xA;        &quot;CASH WITHDRAW CHARGE&quot;, &quot;CASH WITHDRAWAL CHARGE&quot;,&#xA;        &quot;CASH WITHDRAWAL TRANSACTION FEE&quot;, &quot;TRANSACTION FEE&quot;,&#xA;        &quot;VAT PAYABLE ON COMM AND FEES&quot;, &quot;VAT PAYABLE&quot;, &quot;VAT&quot;))&#xA;    {&#xA;        if (wasGlDefault) fixedFromGlDefault++;&#xA;        ForcePpat(row);&#xA;        row[&quot;Root Cause&quot;]          = &quot;Cash withdrawal charges on unsuccessful ATM withdrawal transactions&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;        row[&quot;Recommended Action&quot;]  = &quot;Reverse the charge&quot;;&#xA;        row[&quot;Action Owner&quot;]        = &quot;Card Settlement&quot;;&#xA;        setNarrFee_GL++;&#xA;        continue;&#xA;    }&#xA;&#xA;    // 4) Fallback PPAT default (GL)&#xA;    if (wasGlDefault) fixedFromGlDefault++;&#xA;    SetPpatTemplate(row);&#xA;    setTxnRefOnly_GL++;&#xA;}&#xA;&#xA;// PHASE 2: Cleanup any PPAT still = &quot;Unmatched manual entries&quot; (narration-based override)&#xA;if (!string.IsNullOrEmpty(txnRefCol) &amp;&amp;&#xA;    dtHistoricalReconTransactionsReport.Columns.Contains(txnRefCol))&#xA;{&#xA;    foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;    {&#xA;        string txnRef = GetStr(row, txnRefCol);&#xA;        if (string.IsNullOrWhiteSpace(txnRef) ||&#xA;            (txnRef.IndexOf(&quot;PPAT&quot;, StringComparison.OrdinalIgnoreCase) &lt; 0 &amp;&amp; txnRef.IndexOf(&quot;AWPC&quot;, StringComparison.OrdinalIgnoreCase) &lt; 0))&#xA;            continue;&#xA;&#xA;        string rcNow = GetStr(row, &quot;Root Cause&quot;);&#xA;        string rcNorm = NormalizeSoft(rcNow);&#xA;&#xA;        if (!rcNorm.Contains(&quot;UNMATCHED MANUAL ENTRIES&quot;))&#xA;            continue;&#xA;&#xA;        // Override &quot;Unmatched manual entries&quot; using narration-based PPAT template.&#xA;        ClassifyPpatByNarration(row);&#xA;        forcedNarrOverride++;&#xA;    }&#xA;}&#xA;&#xA;// PHASE 3: FINAL PPAT LATE-POSTED OVERRIDE (applies LAST on ALL PPAT, any Source)&#xA;// If any PPAT row is within ±2 days of reconDate (or ValueDate = null),&#xA;// it will be marked as &quot;Late posted transaction&quot;, overriding any existing PPAT classification.&#xA;if (reconParsed != null &amp;&amp;&#xA;    !string.IsNullOrEmpty(txnRefCol) &amp;&amp;&#xA;    dtHistoricalReconTransactionsReport.Columns.Contains(txnRefCol) &amp;&amp;&#xA;    !string.IsNullOrEmpty(valueDateCol) &amp;&amp;&#xA;    dtHistoricalReconTransactionsReport.Columns.Contains(valueDateCol))&#xA;{&#xA;    DateTime startRange = reconParsed.Value.AddDays(-2);&#xA;    DateTime endRange   = reconParsed.Value.AddDays(+2);&#xA;&#xA;    foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;    {&#xA;        string txnRef = GetStr(row, txnRefCol);&#xA;        if (string.IsNullOrWhiteSpace(txnRef) ||&#xA;            (txnRef.IndexOf(&quot;PPAT&quot;, StringComparison.OrdinalIgnoreCase) &lt; 0 &amp;&amp; txnRef.IndexOf(&quot;AWPC&quot;, StringComparison.OrdinalIgnoreCase) &lt; 0))&#xA;            continue;&#xA;&#xA;        DateTime? vDate = ParseDateFlexible(row[valueDateCol]);&#xA;&#xA;        bool isLate;&#xA;        if (vDate == null)&#xA;        {&#xA;            // Business rule: treat NULL ValueDate as late&#xA;            isLate = true;&#xA;        }&#xA;        else&#xA;        {&#xA;            var d = vDate.Value.Date;&#xA;            isLate = (d &gt;= startRange.Date &amp;&amp; d &lt;= endRange.Date);&#xA;        }&#xA;&#xA;        if (!isLate)&#xA;            continue;&#xA;&#xA;        // FINAL override: Late posted MUST be the last to apply on all PPAT&#xA;        SetLatePostedPPAT(row);&#xA;        finalLateOverridesPPAT++;&#xA;    }&#xA;}&#xA;&#xA;// DEBUG: show how the specific PPAT row ended after ALL phases&#xA;if (!string.IsNullOrEmpty(txnRefCol) &amp;&amp;&#xA;    dtHistoricalReconTransactionsReport.Columns.Contains(txnRefCol))&#xA;{&#xA;    foreach (System.Data.DataRow r in dtHistoricalReconTransactionsReport.Rows)&#xA;    {&#xA;        string tr = GetStr(r, txnRefCol);&#xA;        if (tr.Contains(&quot;101PPAT253060256&quot;))  // target your problematic PPAT&#xA;        {&#xA;            System.Console.WriteLine(&#xA;                &quot;DEBUG_PPAT_ROW =&gt; TxnRef={0}, RC={1}, Cat={2}, Act={3}, Owner={4}, Class={5}&quot;,&#xA;                tr,&#xA;                GetStr(r, &quot;Root Cause&quot;),&#xA;                GetStr(r, &quot;Root Cause Category&quot;),&#xA;                GetStr(r, &quot;Recommended Action&quot;),&#xA;                GetStr(r, &quot;Action Owner&quot;),&#xA;                GetStr(r, &quot;Classification&quot;)&#xA;            );&#xA;            break;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;swAll.Stop();&#xA;&#xA;// GL summary&#xA;System.Console.WriteLine(&#xA;    &quot;Completed GL Classification — STRICT 16-char Auto Rules (incl. UTLP special handling), Late Posted logic &amp; Cashback Integrity Sweep applied.&quot;);&#xA;&#xA;// PPAT summary&#xA;System.Console.WriteLine(&#xA;    &quot;PPAT CLEANUP SUMMARY: &quot; +&#xA;    $&quot;TotalRows={totalRowsPPAT}, &quot; +&#xA;    $&quot;TotalGL={totalGlRowsPPAT}, &quot; +&#xA;    $&quot;TotalGL_PPAT={totalGlPpatRows}, &quot; +&#xA;    $&quot;GL_Principal={setNarrPrincipal_GL}, &quot; +&#xA;    $&quot;GL_Levy={setNarrLevy_GL}, &quot; +&#xA;    $&quot;GL_Fee={setNarrFee_GL}, &quot; +&#xA;    $&quot;GL_DefaultPPAT={setTxnRefOnly_GL}, &quot; +&#xA;    $&quot;ForcedNarrOverride_Unmatched={forcedNarrOverride}, &quot; +&#xA;    $&quot;FinalLateOverrides_ALL_PPAT={finalLateOverridesPPAT}, &quot; +&#xA;    $&quot;FixedFromGLDefault={fixedFromGlDefault}, &quot; +&#xA;    $&quot;SkippedNonPPAT_GL={skippedNonPPAT_GL}, &quot; +&#xA;    $&quot;SkippedNonGL={skippedNonGL_PPAT}&quot;);&#xA;" DisplayName="Source = GL" sap:VirtualizedContainerService.HintSize="450,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_50" Language="CSharp">

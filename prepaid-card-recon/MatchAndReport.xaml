        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== Robust helpers (no external usings needed) =====&#xA;DateTime? ParseDateFlexible(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return null;&#xA;&#xA;    // Already a DateTime?&#xA;    if (val is DateTime dt) return dt;&#xA;&#xA;    // Excel serial (OADate) as double?&#xA;    if (val is double d) &#xA;    {&#xA;        try { return DateTime.FromOADate(d); } catch { /* ignore */ }&#xA;    }&#xA;    // Numeric string that might be OADate&#xA;    if (double.TryParse(val.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d2))&#xA;    {&#xA;        try { return DateTime.FromOADate(d2); } catch { /* ignore */ }&#xA;    }&#xA;&#xA;    // Try common exact formats first&#xA;    var s = val.ToString().Trim();&#xA;    string[] fmts = new[] { &quot;dd/MM/yyyy HH:mm:ss&quot;, &quot;dd/MM/yyyy HH:mm&quot;, &quot;dd/MM/yyyy&quot;, &quot;yyyy-MM-dd&quot;, &quot;yyyy-MM-dd HH:mm:ss&quot;, &quot;yyyy/MM/dd&quot; };&#xA;    if (DateTime.TryParseExact(s, fmts, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var exact))&#xA;        return exact;&#xA;&#xA;    // Fallback: general parse (culture-invariant)&#xA;    if (DateTime.TryParse(s, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var any))&#xA;        return any;&#xA;&#xA;    return null;&#xA;}&#xA;&#xA;string FindFirstExistingColumn(System.Data.DataTable dt, params string[] names)&#xA;{&#xA;    foreach (var name in names)&#xA;    {&#xA;        if (!string.IsNullOrEmpty(name) &amp;&amp; dt.Columns.Contains(name)) return name;&#xA;    }&#xA;    return null;&#xA;}&#xA;&#xA;void EnsureColumn(System.Data.DataTable dt, string name)&#xA;{&#xA;    if (!dt.Columns.Contains(name))&#xA;        dt.Columns.Add(new System.Data.DataColumn(name, typeof(string)) { DefaultValue = &quot;&quot; });&#xA;}&#xA;&#xA;// ===== Ensure the 4 output columns exist =====&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Root Cause&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Root Cause Category&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Recommended Action&quot;);&#xA;EnsureColumn(dtHistoricalReconTransactionsReport, &quot;Action Owner&quot;);&#xA;&#xA;// ===== Parse the reconDate argument (string) once =====&#xA;var reconDateParsed = ParseDateFlexible(reconDate);&#xA;if (reconDateParsed == null)&#xA;{&#xA;    // If reconDate arg is invalid, nothing to do; exit gracefully.&#xA;    return;&#xA;}&#xA;&#xA;// Identify Value Date column (support both spellings)&#xA;string valueDateCol = FindFirstExistingColumn(dtHistoricalReconTransactionsReport, &quot;Value Date&quot;, &quot;ValueDate&quot;);&#xA;if (valueDateCol == null)&#xA;{&#xA;    // If there is no value date column, nothing to classify; exit gracefully.&#xA;    return;&#xA;}&#xA;&#xA;// ===== Main loop =====&#xA;foreach (System.Data.DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    // Read fields safely, preserving the user's exact column names&#xA;    string refNo = &quot;&quot;;&#xA;    if (dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Transaction Ref No:&quot;))&#xA;        refNo = (row[&quot;Transaction Ref No:&quot;] == null || row[&quot;Transaction Ref No:&quot;] == System.DBNull.Value) ? &quot;&quot; : row[&quot;Transaction Ref No:&quot;].ToString();&#xA;&#xA;    string source = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Source&quot;)&#xA;        ? (row[&quot;Source&quot;] == null || row[&quot;Source&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Source&quot;].ToString())&#xA;        : &quot;&quot;;&#xA;&#xA;    string type = dtHistoricalReconTransactionsReport.Columns.Contains(&quot;Type&quot;)&#xA;        ? (row[&quot;Type&quot;] == null || row[&quot;Type&quot;] == System.DBNull.Value ? &quot;&quot; : row[&quot;Type&quot;].ToString())&#xA;        : &quot;&quot;;&#xA;&#xA;    string refNoUpper = (refNo ?? &quot;&quot;).ToUpperInvariant();&#xA;&#xA;    // Filter: PRDP/AGR1/AGR2 + Source = GL + Type = new&#xA;    bool isTargetRef = refNoUpper.Contains(&quot;PRDP&quot;) || refNoUpper.Contains(&quot;PRTP&quot;) || refNoUpper.Contains(&quot;AGR1&quot;) || refNoUpper.Contains(&quot;AGR2&quot;) || refNoUpper.Contains(&quot;AGR3&quot;) || refNoUpper.Contains(&quot;CHWD&amp;AGPS&quot;);&#xA;    bool isGL = source != null &amp;&amp; source.Equals(&quot;GL&quot;, System.StringComparison.OrdinalIgnoreCase);&#xA;    bool isNew = type != null &amp;&amp; type.Equals(&quot;new&quot;, System.StringComparison.OrdinalIgnoreCase);&#xA;&#xA;    if (!(isTargetRef &amp;&amp; isGL &amp;&amp; isNew))&#xA;        continue;&#xA;&#xA;    // Parse ValueDate from the detected column&#xA;    var valueDate = ParseDateFlexible(row[valueDateCol]);&#xA;    if (valueDate == null)&#xA;    {&#xA;        // If ValueDate is missing/unparsable, skip classification for this row&#xA;        continue;&#xA;    }&#xA;&#xA;    // ±2 day window around reconDate&#xA;    DateTime startRange = reconDateParsed.Value.AddDays(-2);&#xA;    DateTime endRange   = reconDateParsed.Value.AddDays( 2);&#xA;&#xA;    if (valueDate.Value &gt;= startRange &amp;&amp; valueDate.Value &lt;= endRange)&#xA;    {&#xA;        // Late posted bucket&#xA;        row[&quot;Root Cause&quot;] = &quot;Late posted transaction&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Check if updates CMS on the following date&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Card Reconciliation&quot;;&#xA;    }&#xA;    else&#xA;    {&#xA;        // Loading updated CBS only bucket&#xA;        row[&quot;Root Cause&quot;] = &quot;Loading updated CBS only&quot;;&#xA;        row[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;        row[&quot;Recommended Action&quot;] = &quot;Perform MISC ADJUSTMENT CREDIT&quot;;&#xA;        row[&quot;Action Owner&quot;] = &quot;Stephen Jilala&quot;;&#xA;    }&#xA;}&#xA;" DisplayName="Root Cause GL" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_8" Language="CSharp">

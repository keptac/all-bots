        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: Detect &amp; Move Journal Manual-Posting Pairs (Label = MANUAL_ENTRY) =====&#xA;// In/Out: DataTable dtHistoricalReconTransactionsReport&#xA;// In/Out: DataTable dtHistoricalReconTransactionsReportMatched&#xA;// In    : string reconCurrency&#xA;&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport));&#xA;if (dtHistoricalReconTransactionsReportMatched == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReportMatched));&#xA;if (string.IsNullOrWhiteSpace(reconCurrency))&#xA;    reconCurrency = &quot;TZS&quot;;&#xA;&#xA;// ---------- Helpers ----------&#xA;string GetStr(System.Data.DataRow r, string col)&#xA;{&#xA;    if (!r.Table.Columns.Contains(col)) return &quot;&quot;;&#xA;    var v = r[col];&#xA;    return (v == null || v == System.DBNull.Value) ? &quot;&quot; : v.ToString().Trim();&#xA;}&#xA;&#xA;decimal ParseDec(object val)&#xA;{&#xA;    if (val == null || val == System.DBNull.Value) return 0m;&#xA;    if (val is decimal d) return d;&#xA;    if (val is double db) return (decimal)db;&#xA;    var s = val.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;);&#xA;    decimal x;&#xA;    return decimal.TryParse(s, out x) ? x : 0m;&#xA;}&#xA;&#xA;DateTime? TryParseDateFlexible(object v)&#xA;{&#xA;    if (v == null || v == System.DBNull.Value) return null;&#xA;    if (v is DateTime dt0) return dt0;&#xA;    var s = v.ToString().Trim();&#xA;    DateTime dt;&#xA;    string[] fmts = { &quot;yyyy-MM-dd&quot;,&quot;dd-MMM-yyyy&quot;,&quot;dd/MM/yyyy&quot;,&quot;dd-MM-yyyy&quot;,&quot;M/d/yyyy&quot;,&quot;yyyyMMdd&quot; };&#xA;    if (DateTime.TryParseExact(s, fmts, System.Globalization.CultureInfo.InvariantCulture,&#xA;        System.Globalization.DateTimeStyles.None, out dt)) return dt;&#xA;    if (DateTime.TryParse(s, out dt)) return dt;&#xA;    return null;&#xA;}&#xA;&#xA;DateTime? ExtractRefDateFromNarration(string narr)&#xA;{&#xA;    var m1 = System.Text.RegularExpressions.Regex.Match(narr, @&quot;\bDD\s+(\d{4}-\d{2}-\d{2})\b&quot;);&#xA;    if (m1.Success &amp;&amp; DateTime.TryParseExact(m1.Groups[1].Value, &quot;yyyy-MM-dd&quot;,&#xA;        System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d1))&#xA;        return d1;&#xA;&#xA;    var m2 = System.Text.RegularExpressions.Regex.Match(narr, @&quot;\b(\d{4}-\d{2}-\d{2})\b&quot;);&#xA;    if (m2.Success &amp;&amp; DateTime.TryParseExact(m2.Groups[1].Value, &quot;yyyy-MM-dd&quot;,&#xA;        System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d2))&#xA;        return d2;&#xA;&#xA;    return null;&#xA;}&#xA;&#xA;string ExtractPanMaskedOrLast4(string narr)&#xA;{&#xA;    var m = System.Text.RegularExpressions.Regex.Match(narr, @&quot;550558X+(\d{0,6})(\d{4})&quot;);&#xA;    if (m.Success) return m.Groups[2].Value;&#xA;    m = System.Text.RegularExpressions.Regex.Match(narr, @&quot;(\d{12,16})&quot;);&#xA;    if (m.Success)&#xA;    {&#xA;        var s = m.Groups[1].Value;&#xA;        return s.Substring(s.Length - 4);&#xA;    }&#xA;    return &quot;&quot;;&#xA;}&#xA;&#xA;bool PanEndsWithSame4(string last4, string fullPan)&#xA;{&#xA;    if (string.IsNullOrEmpty(last4) || string.IsNullOrEmpty(fullPan)) return false;&#xA;    string last4B = fullPan.Length &gt;= 4 ? fullPan.Substring(fullPan.Length - 4) : fullPan;&#xA;    return last4 == last4B;&#xA;}&#xA;&#xA;decimal GetMagnitudeAmount(System.Data.DataRow r, string currency)&#xA;{&#xA;    string debitCol = &quot;Debit (&quot; + currency + &quot;)&quot;;&#xA;    string creditCol = &quot;Credit (&quot; + currency + &quot;)&quot;;&#xA;    decimal d = r.Table.Columns.Contains(debitCol) ? ParseDec(r[debitCol]) : 0m;&#xA;    decimal c = r.Table.Columns.Contains(creditCol) ? ParseDec(r[creditCol]) : 0m;&#xA;    return d &gt; 0 ? d : (c &gt; 0 ? c : 0m);&#xA;}&#xA;&#xA;bool NarrationStartsWithJournal(string narr)&#xA;{&#xA;    return !string.IsNullOrEmpty(narr) &amp;&amp; narr.StartsWith(&quot;Journal&quot;, StringComparison.OrdinalIgnoreCase);&#xA;}&#xA;&#xA;void LabelManual(System.Data.DataRow r)&#xA;{&#xA;    if (!r.Table.Columns.Contains(&quot;Root Cause&quot;)) r.Table.Columns.Add(&quot;Root Cause&quot;, typeof(string));&#xA;    if (!r.Table.Columns.Contains(&quot;Root Cause Category&quot;)) r.Table.Columns.Add(&quot;Root Cause Category&quot;, typeof(string));&#xA;    if (!r.Table.Columns.Contains(&quot;Recommended Action&quot;)) r.Table.Columns.Add(&quot;Recommended Action&quot;, typeof(string));&#xA;    if (!r.Table.Columns.Contains(&quot;Action Owner&quot;)) r.Table.Columns.Add(&quot;Action Owner&quot;, typeof(string));&#xA;    if (!r.Table.Columns.Contains(&quot;BOT Classification&quot;)) r.Table.Columns.Add(&quot;BOT Classification&quot;, typeof(string));&#xA;&#xA;    r[&quot;Root Cause&quot;] = &quot;Manual entry adjustment&quot;;&#xA;    r[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;    r[&quot;Recommended Action&quot;] = &quot;Verify manual posting and exclude from recon&quot;;&#xA;    r[&quot;Action Owner&quot;] = &quot;Card Reconciliation&quot;;&#xA;    r[&quot;BOT Classification&quot;] = &quot;MANUAL_ENTRY&quot;;&#xA;}&#xA;&#xA;// ---------- Find Journal entries ----------&#xA;var journalRows = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;foreach (System.Data.DataRow r in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    if (NarrationStartsWithJournal(GetStr(r, &quot;Narration&quot;)))&#xA;        journalRows.Add(r);&#xA;}&#xA;&#xA;const decimal AMT_TOL = 1m;&#xA;var taken = new System.Collections.Generic.HashSet&lt;int&gt;();&#xA;var rowsToMove = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;&#xA;foreach (var jr in journalRows)&#xA;{&#xA;    string narr = GetStr(jr, &quot;Narration&quot;);&#xA;    string last4 = ExtractPanMaskedOrLast4(narr);&#xA;    DateTime? refDate = ExtractRefDateFromNarration(narr);&#xA;    if (string.IsNullOrEmpty(last4) || !refDate.HasValue)&#xA;        continue;&#xA;&#xA;    decimal jAmt = GetMagnitudeAmount(jr, reconCurrency);&#xA;    if (jAmt &lt;= 0) continue;&#xA;&#xA;    // ---- 1:1 match ----&#xA;    System.Data.DataRow one = null;&#xA;    foreach (System.Data.DataRow cand in dtHistoricalReconTransactionsReport.Rows)&#xA;    {&#xA;        if (object.ReferenceEquals(cand, jr)) continue;&#xA;        if (NarrationStartsWithJournal(GetStr(cand, &quot;Narration&quot;))) continue;&#xA;&#xA;        if (!PanEndsWithSame4(last4, GetStr(cand, &quot;C_PAN&quot;))) continue;&#xA;&#xA;        DateTime? d = TryParseDateFlexible(cand[&quot;Booking Date&quot;]);&#xA;        if (!d.HasValue) d = TryParseDateFlexible(cand[&quot;Value Date&quot;]);&#xA;        if (!d.HasValue || d.Value.Date != refDate.Value.Date) continue;&#xA;&#xA;        decimal a = GetMagnitudeAmount(cand, reconCurrency);&#xA;        if (a &lt;= 0) continue;&#xA;&#xA;        if (System.Math.Abs(a - jAmt) &lt;= AMT_TOL &amp;&amp; !taken.Contains(cand.GetHashCode()))&#xA;        {&#xA;            one = cand;&#xA;            break;&#xA;        }&#xA;    }&#xA;&#xA;    if (one != null)&#xA;    {&#xA;        LabelManual(jr);&#xA;        LabelManual(one);&#xA;        rowsToMove.Add(jr);&#xA;        rowsToMove.Add(one);&#xA;        taken.Add(one.GetHashCode());&#xA;        continue;&#xA;    }&#xA;&#xA;    // ---- 1:2 combo ----&#xA;    System.Data.DataRow first = null, second = null;&#xA;    var all = dtHistoricalReconTransactionsReport.Rows;&#xA;    for (int i = 0; i &lt; all.Count; i++)&#xA;    {&#xA;        var r1 = all[i];&#xA;        if (object.ReferenceEquals(r1, jr)) continue;&#xA;        if (NarrationStartsWithJournal(GetStr(r1, &quot;Narration&quot;))) continue;&#xA;        if (!PanEndsWithSame4(last4, GetStr(r1, &quot;C_PAN&quot;))) continue;&#xA;&#xA;        DateTime? d1 = TryParseDateFlexible(r1[&quot;Booking Date&quot;]) ?? TryParseDateFlexible(r1[&quot;Value Date&quot;]);&#xA;        if (!d1.HasValue || d1.Value.Date != refDate.Value.Date) continue;&#xA;&#xA;        decimal a1 = GetMagnitudeAmount(r1, reconCurrency);&#xA;        if (a1 &lt;= 0 || taken.Contains(r1.GetHashCode())) continue;&#xA;&#xA;        for (int j = i + 1; j &lt; all.Count; j++)&#xA;        {&#xA;            var r2 = all[j];&#xA;            if (object.ReferenceEquals(r2, jr)) continue;&#xA;            if (NarrationStartsWithJournal(GetStr(r2, &quot;Narration&quot;))) continue;&#xA;            if (!PanEndsWithSame4(last4, GetStr(r2, &quot;C_PAN&quot;))) continue;&#xA;&#xA;            DateTime? d2 = TryParseDateFlexible(r2[&quot;Booking Date&quot;]) ?? TryParseDateFlexible(r2[&quot;Value Date&quot;]);&#xA;            if (!d2.HasValue || d2.Value.Date != refDate.Value.Date) continue;&#xA;&#xA;            decimal a2 = GetMagnitudeAmount(r2, reconCurrency);&#xA;            if (a2 &lt;= 0 || taken.Contains(r2.GetHashCode())) continue;&#xA;&#xA;            if (System.Math.Abs((a1 + a2) - jAmt) &lt;= AMT_TOL)&#xA;            {&#xA;                first = r1; second = r2;&#xA;                break;&#xA;            }&#xA;        }&#xA;        if (first != null) break;&#xA;    }&#xA;&#xA;    if (first != null &amp;&amp; second != null)&#xA;    {&#xA;        LabelManual(jr);&#xA;        LabelManual(first);&#xA;        LabelManual(second);&#xA;        rowsToMove.Add(jr);&#xA;        rowsToMove.Add(first);&#xA;        rowsToMove.Add(second);&#xA;        taken.Add(first.GetHashCode());&#xA;        taken.Add(second.GetHashCode());&#xA;    }&#xA;}&#xA;&#xA;// ---------- Move and remove ----------&#xA;foreach (var r in rowsToMove)&#xA;    dtHistoricalReconTransactionsReportMatched.ImportRow(r);&#xA;&#xA;foreach (var r in rowsToMove)&#xA;    dtHistoricalReconTransactionsReport.Rows.Remove(r);&#xA;&#xA;System.Diagnostics.Debug.WriteLine($&quot;✅ MANUAL_ENTRY pairs moved: {(rowsToMove.Count / 2)} | rows moved: {rowsToMove.Count} | Currency: {reconCurrency}&quot;);&#xA;" DisplayName="MANUAL_ENTRY" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_92" Language="CSharp">

              <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Inputs:&#xA;// - DataTable dtHistoricalReconTransactionsReport&#xA;// - string reconDate (&quot;dd-MMM-yyyy&quot;)&#xA;// - decimal exchangeGainOrLossPPSA, exchangeGainOrLossPPSP&#xA;// - string reconCurrency&#xA;&#xA;// === Basic guards ===&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport), &quot;Input DataTable cannot be null.&quot;);&#xA;&#xA;// === Helpers ===&#xA;void EnsureCol(System.Data.DataTable dt, string name, System.Type t)&#xA;{&#xA;    if (!dt.Columns.Contains(name)) dt.Columns.Add(name, t);&#xA;}&#xA;decimal ParseAmount(object v)&#xA;{&#xA;    if (v == null || v == System.DBNull.Value) return 0m;&#xA;    string s = v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;);&#xA;    if (s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;)) s = &quot;-&quot; + s.Substring(1, s.Length - 2);&#xA;    return decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0m;&#xA;}&#xA;&#xA;// Ensure columns we write exist (avoids schema errors)&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;SNO&quot;, typeof(int));&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Branch code&quot;, typeof(string));&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;GL_Code&quot;, typeof(string));&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;GL Description&quot;, typeof(string));&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Booking Date&quot;, typeof(System.DateTime));&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Value Date&quot;, typeof(System.DateTime));&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Transaction Ref No:&quot;, typeof(string));&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Aging&quot;, typeof(string));&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Aging Group&quot;, typeof(string));&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;BOT Classification&quot;, typeof(string));&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Narration&quot;, typeof(string));&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Root Cause&quot;, typeof(string));&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Root Cause Category&quot;, typeof(string));&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Recommended Action&quot;, typeof(string));&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Action Owner&quot;, typeof(string));&#xA;&#xA;string debitCol  = &quot;Debit (&quot;  + reconCurrency + &quot;)&quot;;&#xA;string creditCol = &quot;Credit (&quot; + reconCurrency + &quot;)&quot;;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(debitCol))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(debitCol, typeof(decimal));&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(creditCol))&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(creditCol, typeof(decimal));&#xA;&#xA;// === Parse reconDate ===&#xA;var parsedDate = DateTime.ParseExact(&#xA;    reconDate,&#xA;    &quot;dd-MMM-yyyy&quot;,&#xA;    System.Globalization.CultureInfo.InvariantCulture&#xA;);&#xA;string dateStr = parsedDate.ToString(&quot;yyyy-MM-dd&quot;);&#xA;&#xA;Console.WriteLine($&quot;📅 Recon date parsed: {parsedDate:yyyy-MM-dd} (input='{reconDate}')&quot;);&#xA;&#xA;// === BEFORE balance snapshot on the chosen currency columns ===&#xA;decimal beforeDebit = 0m, beforeCredit = 0m;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    beforeDebit  += ParseAmount(r[debitCol]);&#xA;    beforeCredit += ParseAmount(r[creditCol]);&#xA;}&#xA;decimal beforeDiff = beforeDebit - beforeCredit;&#xA;Console.WriteLine($&quot;[BAL] BEFORE — Debit ({reconCurrency}): {beforeDebit:N2} | Credit ({reconCurrency}): {beforeCredit:N2} | Δ(D−C)={beforeDiff:N2}&quot;);&#xA;&#xA;// === Total PPSA + PPSP (with logging) ===&#xA;Console.WriteLine($&quot;🔎 Raw inputs: PPSA={exchangeGainOrLossPPSA}, PPSP={exchangeGainOrLossPPSP}&quot;);&#xA;decimal exchangeGainOrLossPPS = exchangeGainOrLossPPSA + exchangeGainOrLossPPSP;&#xA;Console.WriteLine($&quot;🔎 Combined PPS (PPSA+PPSP) = {exchangeGainOrLossPPS}&quot;);&#xA;&#xA;decimal roundedAt2 = Math.Round(exchangeGainOrLossPPS, 2, MidpointRounding.AwayFromZero);&#xA;Console.WriteLine($&quot;🔎 Rounded (2dp) PPS total = {roundedAt2}&quot;);&#xA;&#xA;// === If effectively zero at 2dp, don't insert ===&#xA;if (roundedAt2 == 0m)&#xA;{&#xA;    Console.WriteLine(&quot;✅ No exchange gain or loss to record (rounded to 0.00). Skipping insert.&quot;);&#xA;    // AFTER = BEFORE since nothing was inserted&#xA;    Console.WriteLine($&quot;[BAL] AFTER  — Debit ({reconCurrency}): {beforeDebit:N2} | Credit ({reconCurrency}): {beforeCredit:N2} | Δ(D−C)={beforeDiff:N2}&quot;);&#xA;    Console.WriteLine(&quot;✅ Consistency OK: no changes applied.&quot;);&#xA;    return;&#xA;}&#xA;&#xA;// === Compute next SNO (no external helper) ===&#xA;int newSNO = 1;&#xA;if (dtHistoricalReconTransactionsReport.Rows.Count &gt; 0)&#xA;{&#xA;    int maxSNO = 0;&#xA;    foreach (System.Data.DataRow r in dtHistoricalReconTransactionsReport.Rows)&#xA;    {&#xA;        if (int.TryParse(r[&quot;SNO&quot;]?.ToString(), out int sno) &amp;&amp; sno &gt; maxSNO)&#xA;            maxSNO = sno;&#xA;    }&#xA;    newSNO = maxSNO + 1;&#xA;}&#xA;Console.WriteLine($&quot;🧮 Next SNO determined: {newSNO}&quot;);&#xA;&#xA;Console.WriteLine($&quot;🧾 Using columns -&gt; Debit: '{debitCol}', Credit: '{creditCol}'&quot;);&#xA;&#xA;// === Build row exactly like your GL inserts ===&#xA;var newRow = dtHistoricalReconTransactionsReport.NewRow();&#xA;newRow[&quot;SNO&quot;] = newSNO;&#xA;newRow[&quot;Branch code&quot;] = &quot;101&quot;;&#xA;newRow[&quot;GL_Code&quot;] = &quot;202030015&quot;;&#xA;newRow[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;newRow[&quot;Booking Date&quot;] = parsedDate;&#xA;newRow[&quot;Value Date&quot;]   = parsedDate;&#xA;newRow[&quot;Transaction Ref No:&quot;] = DBNull.Value;&#xA;&#xA;int excelRow = newSNO + 5;&#xA;newRow[&quot;Aging&quot;] = $&quot;=$H$6-G{excelRow}&quot;;&#xA;newRow[&quot;Aging Group&quot;] =&#xA;    $&quot;=IF(L{excelRow}&lt;4,\&quot;0-3 Days\&quot;,IF(L{excelRow}&lt;31,\&quot;4-30 Days\&quot;,IF(L{excelRow}&lt;61,\&quot;31-60 Days\&quot;,IF(L{excelRow}&lt;=90,\&quot;61-90 Days\&quot;,IF(L{excelRow}&gt;90,\&quot;Above 90 Days\&quot;,\&quot;0\&quot;)))))&quot;;&#xA;// Fixed trailing parenthesis:&#xA;newRow[&quot;BOT Classification&quot;] =&#xA;    $&quot;=IF(J{excelRow}&gt;0,IF(L{excelRow}&lt;30,\&quot;Normal\&quot;,IF(L{excelRow}&lt;60,\&quot;Especially Mentioned\&quot;,IF(L{excelRow}&lt;90,\&quot;Substandard\&quot;,IF(L{excelRow}&lt;=180,\&quot;Doubtful\&quot;,IF(L{excelRow}&gt;180,\&quot;Loss\&quot;,\&quot;0\&quot;)))))),\&quot;Not Applicable\&quot;)&quot;;&#xA;&#xA;// === Assign Amount &amp; Narration (sign logic) ===&#xA;decimal absValue = Math.Abs(roundedAt2); // use rounded value to match Excel display&#xA;decimal insertedDebit = 0m, insertedCredit = 0m;&#xA;&#xA;if (roundedAt2 &gt; 0)&#xA;{&#xA;    // Exchange Loss -&gt; Debit&#xA;    newRow[debitCol]  = absValue;&#xA;    newRow[creditCol] = DBNull.Value;&#xA;    newRow[&quot;Narration&quot;] = $&quot;Exchange Loss {dateStr}&quot;;&#xA;    newRow[&quot;Root Cause&quot;] = &quot;Exchange Loss&quot;;&#xA;    newRow[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;    newRow[&quot;Recommended Action&quot;] = &quot;To be realized as other expense&quot;;&#xA;&#xA;    insertedDebit = absValue;&#xA;    Console.WriteLine($&quot;💸 Posting LOSS (debit) {absValue:N2} {reconCurrency} to '{debitCol}'&quot;);&#xA;}&#xA;else&#xA;{&#xA;    // Exchange Gain -&gt; Credit&#xA;    newRow[creditCol] = absValue;&#xA;    newRow[debitCol]  = DBNull.Value;&#xA;    newRow[&quot;Narration&quot;] = $&quot;Exchange Gain {dateStr}&quot;;&#xA;    newRow[&quot;Root Cause&quot;] = &quot;Exchange Gain&quot;;&#xA;    newRow[&quot;Root Cause Category&quot;] = &quot;System&quot;;&#xA;    newRow[&quot;Recommended Action&quot;] = &quot;To be realized as other income&quot;;&#xA;&#xA;    insertedCredit = absValue;&#xA;    Console.WriteLine($&quot;💰 Posting GAIN (credit) {absValue:N2} {reconCurrency} to '{creditCol}'&quot;);&#xA;}&#xA;&#xA;newRow[&quot;Action Owner&quot;] = &quot;Card Settlement&quot;;&#xA;&#xA;// === Insert the Row ===&#xA;dtHistoricalReconTransactionsReport.Rows.Add(newRow);&#xA;&#xA;Console.WriteLine($&quot;✅ Inserted exchange adjustment row. SNO: {newSNO}, Amount: {absValue:N2} {reconCurrency} (PPSA+PPSP), Date: {dateStr}&quot;);&#xA;&#xA;// === AFTER balance snapshot + identity check ===&#xA;decimal afterDebit = 0m, afterCredit = 0m;&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;{&#xA;    var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    afterDebit  += ParseAmount(r[debitCol]);&#xA;    afterCredit += ParseAmount(r[creditCol]);&#xA;}&#xA;decimal afterDiff = afterDebit - afterCredit;&#xA;&#xA;decimal insertedDiff = insertedDebit - insertedCredit;&#xA;decimal lhs = beforeDiff + insertedDiff;&#xA;decimal rhs = afterDiff;&#xA;decimal gap = Math.Abs(lhs - rhs);&#xA;const decimal BAL_TOL = 0.01m;&#xA;&#xA;Console.WriteLine();&#xA;Console.WriteLine(&quot;🔎 Balance check (Δ = Debit − Credit):&quot;);&#xA;Console.WriteLine($&quot;  BEFORE:   Debit {beforeDebit:N2} | Credit {beforeCredit:N2} | Δ_before   = {beforeDiff:N2}&quot;);&#xA;Console.WriteLine($&quot;  INSERTED: Debit {insertedDebit:N2} | Credit {insertedCredit:N2} | Δ_inserted = {insertedDiff:N2}&quot;);&#xA;Console.WriteLine($&quot;  AFTER:    Debit {afterDebit:N2}  | Credit {afterCredit:N2}  | Δ_after    = {afterDiff:N2}&quot;);&#xA;&#xA;if (gap &lt;= BAL_TOL)&#xA;    Console.WriteLine($&quot;✅ Consistency OK: Δ_before + Δ_inserted ({lhs:N2}) ≈ Δ_after ({rhs:N2}) within ±{BAL_TOL:N2}.&quot;);&#xA;else&#xA;    Console.WriteLine($&quot;⚠️ Consistency MISMATCH: (Δ_before + Δ_inserted) = {lhs:N2} vs Δ_after = {rhs:N2}; gap = {gap:N2} (&gt; ±{BAL_TOL:N2}).&quot;);&#xA;" DisplayName="exchangeGainOrLossPPSA+exchangeGainOrLossPPSP" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_68" Language="CSharp">

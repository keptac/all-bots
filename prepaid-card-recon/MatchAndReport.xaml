              <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: US date policy (MM/dd), strip time, Excel shows dd-MMM-yyyy =====&#xA;// Inputs (In/Out as you use them):&#xA;// - DataTable dtHistoricalReconTransactionsReport&#xA;// - string prepaidCardFileName&#xA;// - string reconDate                  // e.g., &quot;07/30/2025&quot; (MM/dd/yyyy) or &quot;2025-07-30&quot;&#xA;// - string reconCurrency              // used for &quot;Debit (XXX)&quot; / &quot;Credit (XXX)&quot;&#xA;// - decimal glClosingBalance&#xA;// - decimal cmsBalance&#xA;&#xA;&#xA;&#xA;// If needed, uncomment:&#xA;// ExcelPackage.LicenseContext = LicenseContext.NonCommercial;&#xA;&#xA;#region === Strict MM/dd parser (removes time) ===&#xA;&#xA;DateTime? ParseUsDateOnly(object v)&#xA;{&#xA;    if (v == null || v == DBNull.Value) return null;&#xA;&#xA;    // Already DateTime -&gt; strip time&#xA;    if (v is DateTime d) return d.Date;&#xA;&#xA;    // OA serials / numerics&#xA;    try&#xA;    {&#xA;        if (v is double od) return DateTime.FromOADate(od).Date;&#xA;        if (v is float  of) return DateTime.FromOADate(of).Date;&#xA;        if (v is decimal om) return DateTime.FromOADate((double)om).Date;&#xA;        if (v is int    oi) return DateTime.FromOADate(oi).Date;&#xA;        if (v is long   ol) return DateTime.FromOADate(ol).Date;&#xA;    } catch { /* ignore */ }&#xA;&#xA;    var s = v.ToString()?.Trim();&#xA;    if (string.IsNullOrEmpty(s)) return null;&#xA;&#xA;    // Numeric string OA?&#xA;    if (double.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out var oa))&#xA;    {&#xA;        try { return DateTime.FromOADate(oa).Date; } catch { }&#xA;    }&#xA;&#xA;    // Normalize weird spaced time &quot;HH mm ss 0&quot; -&gt; &quot;HH:mm:ss&quot;&#xA;    s = Regex.Replace(s, @&quot;(\d{1,2})\s+(\d{2})\s+(\d{2})(?:\s+\d+)?$&quot;, &quot;$1:$2:$3&quot;);&#xA;&#xA;    // 1) ISO accepted&#xA;    string[] iso = { &quot;yyyy-MM-dd HH:mm:ss&quot;, &quot;yyyy-MM-dd HH:mm&quot;, &quot;yyyy-MM-dd'T'HH:mm:ss&quot;, &quot;yyyy-MM-dd&quot; };&#xA;    if (DateTime.TryParseExact(s, iso, CultureInfo.InvariantCulture, DateTimeStyles.None, out var isoDt))&#xA;        return isoDt.Date;&#xA;&#xA;    // 2) dd-MMM accepted (unambiguous)&#xA;    string[] dmon = { &quot;dd-MMM-yyyy HH:mm:ss&quot;, &quot;dd-MMM-yyyy HH:mm&quot;, &quot;dd-MMM-yyyy&quot;, &quot;d-MMM-yyyy HH:mm:ss&quot;, &quot;d-MMM-yyyy HH:mm&quot;, &quot;d-MMM-yyyy&quot; };&#xA;    if (DateTime.TryParseExact(s, dmon, CultureInfo.InvariantCulture, DateTimeStyles.None, out var dmonDt))&#xA;        return dmonDt.Date;&#xA;&#xA;    // 3) STRICT US policy for slashed/dashed dates: MM/dd[/yyyy][ time]&#xA;    //    Ambiguous slashes are ALWAYS MM/dd.&#xA;    string[] us = {&#xA;        &quot;MM/dd/yyyy HH:mm:ss&quot;,&quot;MM/dd/yyyy HH:mm&quot;,&quot;MM/dd/yyyy&quot;,&#xA;        &quot;M/d/yyyy HH:mm:ss&quot;,&quot;M/d/yyyy HH:mm&quot;,&quot;M/d/yyyy&quot;,&#xA;        &quot;MM-dd-yyyy HH:mm:ss&quot;,&quot;MM-dd-yyyy HH:mm&quot;,&quot;MM-dd-yyyy&quot;,&#xA;        &quot;M-d-yyyy HH:mm:ss&quot;,&quot;M-d-yyyy HH:mm&quot;,&quot;M-d-yyyy&quot;&#xA;    };&#xA;    if (DateTime.TryParseExact(s, us, CultureInfo.InvariantCulture, DateTimeStyles.None, out var usDt))&#xA;        return usDt.Date;&#xA;&#xA;    // NO culture fallback (prevents accidental dd/MM)&#xA;    return null;&#xA;}&#xA;&#xA;void ConvertColumnToUsDateOnly(DataTable dt, string colName, out int blanks)&#xA;{&#xA;    blanks = 0;&#xA;    if (dt == null || !dt.Columns.Contains(colName)) return;&#xA;&#xA;    // If it's already DateTime, we still need to strip any time part.&#xA;    bool alreadyDT = dt.Columns[colName].DataType == typeof(DateTime);&#xA;&#xA;    string tmp = colName + &quot;_DATE_ONLY&quot;;&#xA;    if (dt.Columns.Contains(tmp)) dt.Columns.Remove(tmp);&#xA;    var nc = dt.Columns.Add(tmp, typeof(DateTime));&#xA;&#xA;    foreach (DataRow r in dt.Rows)&#xA;    {&#xA;        DateTime? parsed;&#xA;        if (alreadyDT)&#xA;        {&#xA;            parsed = (r[colName] == DBNull.Value) ? (DateTime?)null : ((DateTime)r[colName]).Date;&#xA;        }&#xA;        else&#xA;        {&#xA;            parsed = ParseUsDateOnly(r[colName]);&#xA;        }&#xA;&#xA;        if (parsed.HasValue) r[tmp] = parsed.Value;&#xA;        else { r[tmp] = DBNull.Value; blanks++; }&#xA;    }&#xA;&#xA;    int ord = dt.Columns[colName].Ordinal;&#xA;    dt.Columns.Remove(colName);&#xA;    nc.ColumnName = colName;&#xA;    dt.Columns[colName].SetOrdinal(ord);&#xA;}&#xA;&#xA;DateTime ParseReconDateUs(string s)&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(s)) return DateTime.Today;&#xA;&#xA;    // Try strict US and a few unambiguous patterns&#xA;    string[] fmts = {&#xA;        &quot;MM/dd/yyyy&quot;,&quot;M/d/yyyy&quot;,&#xA;        &quot;MM-dd-yyyy&quot;,&quot;M-d-yyyy&quot;,&#xA;        &quot;yyyy-MM-dd&quot;,&quot;yyyy-MM-dd HH:mm:ss&quot;,&quot;yyyy-MM-dd'T'HH:mm:ss&quot;,&#xA;        &quot;dd-MMM-yyyy&quot;,&quot;d-MMM-yyyy&quot;&#xA;    };&#xA;    if (DateTime.TryParseExact(s.Trim(), fmts, CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt))&#xA;        return dt.Date;&#xA;&#xA;    // Last resort: avoid culture flips; use Today&#xA;    return DateTime.Today;&#xA;}&#xA;&#xA;#endregion&#xA;&#xA;#region === Amount parsing (invariant; supports parentheses) ===&#xA;&#xA;decimal ParseAmountInvariant(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return 0m;&#xA;    var s = val.ToString().Trim();&#xA;    bool neg = s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;);&#xA;    if (neg) s = s.Substring(1, s.Length - 2);&#xA;    s = s.Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot; &quot;, &quot;&quot;);&#xA;    return decimal.TryParse(s, NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out var d)&#xA;        ? (neg ? -d : d)&#xA;        : 0m;&#xA;}&#xA;&#xA;#endregion&#xA;&#xA;#region === 1) Normalize DT dates once (US mm/dd policy), strip time ===&#xA;&#xA;if (dtHistoricalReconTransactionsReport == null || dtHistoricalReconTransactionsReport.Rows.Count == 0)&#xA;    throw new Exception(&quot;DataTable 'dtHistoricalReconTransactionsReport' is null or empty.&quot;);&#xA;&#xA;ConvertColumnToUsDateOnly(dtHistoricalReconTransactionsReport, &quot;Booking Date&quot;, out var blanksBooking);&#xA;ConvertColumnToUsDateOnly(dtHistoricalReconTransactionsReport, &quot;Value Date&quot;,   out var blanksValue);&#xA;&#xA;System.Console.WriteLine($&quot;🧹 Dates normalized → Booking blanks={blanksBooking}, Value blanks={blanksValue} (MM/dd policy, time removed)&quot;);&#xA;&#xA;#endregion&#xA;&#xA;#region === 2) Static columns (unchanged names) ===&#xA;&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    row[&quot;Branch code&quot;] = &quot;101&quot;;&#xA;    row[&quot;GL_Code&quot;] = &quot;202030015&quot;;&#xA;    row[&quot;GL Description&quot;] = &quot;Pool account-Prepaid card&quot;;&#xA;}&#xA;&#xA;#endregion&#xA;&#xA;#region === 3) Bulk write to 'Recon Report' (preserves DateTime types), show dd-MMM-yyyy ===&#xA;&#xA;if (!File.Exists(prepaidCardFileName))&#xA;    throw new FileNotFoundException($&quot;The file '{prepaidCardFileName}' does not exist.&quot;);&#xA;&#xA;int startingRow = 18;&#xA;int totalRows = dtHistoricalReconTransactionsReport.Rows.Count;&#xA;int lastRow = startingRow + totalRows - 1;&#xA;&#xA;string debitColName = $&quot;Debit ({reconCurrency})&quot;;&#xA;string creditColName = $&quot;Credit ({reconCurrency})&quot;;&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(debitColName))&#xA;    throw new Exception($&quot;Column '{debitColName}' not found.&quot;);&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(creditColName))&#xA;    throw new Exception($&quot;Column '{creditColName}' not found.&quot;);&#xA;&#xA;System.Console.WriteLine($&quot;📊 Writing {totalRows:N0} rows starting at row {startingRow} into '{prepaidCardFileName}'...&quot;);&#xA;&#xA;var sw = System.Diagnostics.Stopwatch.StartNew();&#xA;&#xA;try&#xA;{&#xA;    using (var package = new ExcelPackage(new FileInfo(prepaidCardFileName)))&#xA;    {&#xA;        var ws = package.Workbook.Worksheets.FirstOrDefault(x =&gt; x.Name.Trim().Equals(&quot;Recon Report&quot;, StringComparison.OrdinalIgnoreCase))&#xA;                 ?? throw new Exception(&quot;Worksheet 'Recon Report' not found.&quot;);&#xA;&#xA;        // Clear old block and insert new&#xA;        int currentLast = ws.Dimension?.End?.Row ?? 0;&#xA;        if (currentLast &gt;= startingRow) ws.DeleteRow(startingRow, currentLast - startingRow + 1);&#xA;        if (totalRows &gt; 0) ws.InsertRow(startingRow, totalRows);&#xA;&#xA;        // H6 anchor: parse with US policy and strip time&#xA;        DateTime reconDt = ParseReconDateUs(reconDate);&#xA;        ws.Cells[&quot;H6&quot;].Value = reconDt;&#xA;        ws.Cells[&quot;H6&quot;].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;&#xA;        // Build one object[,] for columns B..R (2..18)&#xA;        var block = new object[totalRows, 17];&#xA;&#xA;        for (int i = 0; i &lt; totalRows; i++)&#xA;        {&#xA;            var dr = dtHistoricalReconTransactionsReport.Rows[i];&#xA;&#xA;            // Dates are already DateTime (date-only) or DBNull&#xA;            object bDate = dr[&quot;Booking Date&quot;] is DateTime bd ? (object)bd : (dr[&quot;Booking Date&quot;] == DBNull.Value ? null : null);&#xA;            object vDate = dr[&quot;Value Date&quot;]   is DateTime vd ? (object)vd : (dr[&quot;Value Date&quot;]   == DBNull.Value ? null : null);&#xA;&#xA;            var debit  = Math.Round(ParseAmountInvariant(dr[debitColName]), 2);&#xA;            var credit = Math.Round(ParseAmountInvariant(dr[creditColName]), 2);&#xA;&#xA;            int c = 0;&#xA;            block[i, c++] = i + 1; // 2 S/N&#xA;            block[i, c++] = dr[&quot;Branch code&quot;];&#xA;            block[i, c++] = dr[&quot;GL_Code&quot;];&#xA;            block[i, c++] = dr[&quot;GL Description&quot;];&#xA;            block[i, c++] = bDate; // 6 Booking Date (DateTime/null)&#xA;            block[i, c++] = vDate; // 7 Value Date   (DateTime/null)&#xA;            block[i, c++] = dr.Table.Columns.Contains(&quot;Transaction Ref No:&quot;) ? dr[&quot;Transaction Ref No:&quot;] : null; // 8&#xA;            block[i, c++] = dr.Table.Columns.Contains(&quot;Narration&quot;) ? dr[&quot;Narration&quot;] : null; // 9&#xA;            block[i, c++] = debit;  // 10&#xA;            block[i, c++] = credit; // 11&#xA;            block[i, c++] = null;   // 12 formula later&#xA;            block[i, c++] = null;   // 13 formula later&#xA;            block[i, c++] = null;   // 14 formula later&#xA;            block[i, c++] = dr.Table.Columns.Contains(&quot;Root Cause&quot;) ? dr[&quot;Root Cause&quot;] : null;                   // 15&#xA;            block[i, c++] = dr.Table.Columns.Contains(&quot;Root Cause Category&quot;) ? dr[&quot;Root Cause Category&quot;] : null; // 16&#xA;            block[i, c++] = dr.Table.Columns.Contains(&quot;Recommended Action&quot;) ? dr[&quot;Recommended Action&quot;] : null;   // 17&#xA;            block[i, c++] = dr.Table.Columns.Contains(&quot;Action Owner&quot;) ? dr[&quot;Action Owner&quot;] : null;               // 18&#xA;        }&#xA;&#xA;        if (totalRows &gt; 0)&#xA;        {&#xA;            ws.Cells[startingRow, 2, lastRow, 18].Value = block;&#xA;&#xA;            // Row formulas (12..14)&#xA;            for (int r = startingRow; r &lt;= lastRow; r++)&#xA;            {&#xA;                ws.Cells[r, 12].Formula = $&quot;$H$6 - G{r}&quot;;&#xA;                ws.Cells[r, 13].Formula = $&quot;IF(L{r}&lt;4,\&quot;0-3 Days\&quot;,IF(L{r}&lt;31,\&quot;4-30 Days\&quot;,IF(L{r}&lt;61,\&quot;31-60 Days\&quot;,IF(L{r}&lt;=90,\&quot;61-90 Days\&quot;,\&quot;Above 90 Days\&quot;))))&quot;;&#xA;                ws.Cells[r, 14].Formula = $&quot;IF(J{r}&gt;0,IF(L{r}&lt;30,\&quot;Normal\&quot;,IF(L{r}&lt;60,\&quot;Especially Mentioned\&quot;,IF(L{r}&lt;90,\&quot;Substandard\&quot;,IF(L{r}&lt;=180,\&quot;Doubtful\&quot;,\&quot;Loss\&quot;)))),\&quot;Not Applicable\&quot;)&quot;;&#xA;            }&#xA;&#xA;            // Formats: show dates as dd-MMM-yyyy; amounts as #,##0.00&#xA;            ws.Cells[startingRow, 6, lastRow, 7].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;            ws.Cells[startingRow,10, lastRow,11].Style.Numberformat.Format = &quot;#,##0.00;[Red]-#,##0.00&quot;;&#xA;            ws.Cells[&quot;H6&quot;].Style.Numberformat.Format = &quot;dd-MMM-yyyy&quot;;&#xA;        }&#xA;&#xA;        // Totals and headers&#xA;        ws.Cells[&quot;K9&quot;].Value  = glClosingBalance;&#xA;        ws.Cells[&quot;K10&quot;].Value = cmsBalance;&#xA;&#xA;        string jRange = (totalRows &gt; 0) ? $&quot;J{startingRow}:J{lastRow}&quot; : &quot;J999:J999&quot;;&#xA;        string kRange = (totalRows &gt; 0) ? $&quot;K{startingRow}:K{lastRow}&quot; : &quot;K999:K999&quot;;&#xA;        ws.Cells[&quot;J13&quot;].Formula = $&quot;-SUM({jRange})&quot;;&#xA;        ws.Cells[&quot;K13&quot;].Formula = $&quot;SUM({kRange})&quot;;&#xA;        ws.Cells[&quot;J16&quot;].Formula = $&quot;SUM({jRange})&quot;;&#xA;        ws.Cells[&quot;K16&quot;].Formula = $&quot;SUM({kRange})&quot;;&#xA;        ws.Cells[&quot;K14&quot;].Formula = &quot;ROUND((J13+K13),2)&quot;;&#xA;        ws.Cells[&quot;K15&quot;].Formula = &quot;ROUND((K11-K14),2)&quot;;&#xA;&#xA;        package.Workbook.CalcMode = ExcelCalcMode.Automatic;&#xA;        package.Workbook.FullCalcOnLoad = true;&#xA;        package.Save();&#xA;    }&#xA;&#xA;    sw.Stop();&#xA;    System.Console.WriteLine($&quot;✅ Written {totalRows:N0} rows in {sw.Elapsed.TotalSeconds:F1}s&quot;);&#xA;    System.Console.WriteLine($&quot;✅ glClosingBalance (K9): {glClosingBalance:N2}&quot;);&#xA;    System.Console.WriteLine($&quot;✅ cmsBalance (K10): {cmsBalance:N2}&quot;);&#xA;}&#xA;catch (Exception ex)&#xA;{&#xA;    System.Console.WriteLine($&quot;❌ ERROR: {ex.Message}&quot;);&#xA;    if (ex.InnerException != null) System.Console.WriteLine($&quot;   ↳ {ex.InnerException.Message}&quot;);&#xA;}&#xA;&#xA;#endregion&#xA;" DisplayName="FINAL dtHistoricalReconTransactionsReport and Recon Report Balances" sap:VirtualizedContainerService.HintSize="452.6666666666667,188" sap2010:WorkflowViewState.IdRef="InvokeCode_61" Language="CSharp">

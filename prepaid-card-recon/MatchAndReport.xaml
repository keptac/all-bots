        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// ===== UiPath C# Invoke Code: UMJP principal + compound charges (key = C_PAN|RRN) — Remove matched principal; label non-tally charges =====&#xA;// Args (In):     string reconCurrency&#xA;// Args (In/Out): DataTable dtHistoricalReconTransactionsReport, DataTable dtHistoricalReconTransactionsReportMatched&#xA;&#xA;if (dtHistoricalReconTransactionsReport == null)&#xA;    throw new ArgumentNullException(nameof(dtHistoricalReconTransactionsReport), &quot;Input DataTable cannot be null&quot;);&#xA;&#xA;if (dtHistoricalReconTransactionsReportMatched == null ||&#xA;    dtHistoricalReconTransactionsReportMatched.Columns.Count != dtHistoricalReconTransactionsReport.Columns.Count)&#xA;{&#xA;    dtHistoricalReconTransactionsReportMatched = dtHistoricalReconTransactionsReport.Clone();&#xA;}&#xA;&#xA;// ---------- Ensure columns ----------&#xA;void EnsureCol(System.Data.DataTable dt, string name)&#xA;{&#xA;    if (!dt.Columns.Contains(name)) dt.Columns.Add(name, typeof(string));&#xA;}&#xA;void EnsureBoolCol(System.Data.DataTable dt, string name)&#xA;{&#xA;    if (!dt.Columns.Contains(name))&#xA;    {&#xA;        var c = new System.Data.DataColumn(name, typeof(bool)) { DefaultValue = false };&#xA;        dt.Columns.Add(c);&#xA;    }&#xA;}&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Classification&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReportMatched, &quot;Classification&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Root Cause&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Root Cause Category&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Recommended Action&quot;);&#xA;EnsureCol(dtHistoricalReconTransactionsReport, &quot;Action Owner&quot;);&#xA;EnsureBoolCol(dtHistoricalReconTransactionsReport, &quot;UMJP Charges Mismatch&quot;);&#xA;EnsureBoolCol(dtHistoricalReconTransactionsReportMatched, &quot;UMJP Charges Mismatch&quot;);&#xA;&#xA;// ---------- Config ----------&#xA;string currency = reconCurrency;&#xA;decimal balanceTol = 0.01m;  // for Δ(D−C) diagnostics&#xA;decimal chargeTol  = 0.10m;  // charges tolerance&#xA;&#xA;const string cmsPrincipalPrefixRaw = &quot;CASH ADVANCE/ CASH AT POS / CASH OUT&quot;;&#xA;const string cmsFeeToken1Raw       = &quot;CASH ADVANCE/ CASH AT POS / CASH OUT TRANSACTION FEE&quot;;&#xA;const string cmsTaxToken1Raw       = &quot;SERVICE TAX/TAX ON INCOME&quot;;&#xA;string[] cmsPrincipalExclusions    = new[] { &quot;REVERSAL&quot;, &quot;REFUND&quot;, &quot;CHARGEBACK&quot;, &quot;REV-&quot;, &quot;REV &quot;, &quot;REV.&quot; };&#xA;&#xA;// ---------- Helpers ----------&#xA;Func&lt;string, string&gt; NormalizeDashes = s =&gt;&#xA;{&#xA;    if (string.IsNullOrEmpty(s)) return &quot;&quot;;&#xA;    return s.Replace('\u2010','-').Replace('\u2011','-').Replace('\u2012','-')&#xA;            .Replace('\u2013','-').Replace('\u2014','-').Replace('\u2015','-');&#xA;};&#xA;Func&lt;string, string&gt; CleanText = input =&gt;&#xA;{&#xA;    var s = NormalizeDashes((input ?? &quot;&quot;).Trim());&#xA;    s = System.Text.RegularExpressions.Regex.Replace(s, @&quot;[^\w\s/\-]&quot;, &quot;&quot;);&#xA;    s = s.ToUpperInvariant();&#xA;    while (s.Contains(&quot;  &quot;)) s = s.Replace(&quot;  &quot;, &quot; &quot;);&#xA;    return s;&#xA;};&#xA;Func&lt;object, decimal&gt; ParseAmount = val =&gt;&#xA;{&#xA;    if (val == null || val == DBNull.Value) return 0m;&#xA;    string s = val.ToString().Replace(&quot;,&quot;, &quot;&quot;).Trim();&#xA;    if (s.StartsWith(&quot;(&quot;) &amp;&amp; s.EndsWith(&quot;)&quot;)) s = &quot;-&quot; + s.Substring(1, s.Length - 2);&#xA;    decimal d;&#xA;    return decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out d) ? d : 0m;&#xA;};&#xA;Func&lt;string, string&gt; NormalizePan = panRaw =&gt;&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(panRaw)) return &quot;&quot;;&#xA;    return panRaw.Trim().ToUpperInvariant().Replace(&quot;*&quot;, &quot;X&quot;);&#xA;};&#xA;Func&lt;string, string&gt; NormalizeRrn = rrnRaw =&gt;&#xA;{&#xA;    if (string.IsNullOrWhiteSpace(rrnRaw)) return &quot;&quot;;&#xA;    return rrnRaw.Trim().ToUpperInvariant();&#xA;};&#xA;Func&lt;System.Data.DataRow, bool&gt; IsGlUmjpRow = r =&gt;&#xA;{&#xA;    string refNo = r.Table.Columns.Contains(&quot;Transaction Ref No:&quot;) ? (r[&quot;Transaction Ref No:&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;    return refNo.ToUpperInvariant().Contains(&quot;UMJP&quot;) || refNo.ToUpperInvariant().Contains(&quot;AWPU&quot;);&#xA;};&#xA;Func&lt;System.Data.DataRow, bool&gt; IsCmsFeeOrTax = r =&gt;&#xA;{&#xA;    var ct = CleanText(r[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;);&#xA;    return ct.StartsWith(CleanText(cmsFeeToken1Raw)) || ct.StartsWith(CleanText(cmsTaxToken1Raw));&#xA;};&#xA;Func&lt;System.Data.DataRow, bool&gt; IsCmsPrincipal = r =&gt;&#xA;{&#xA;    var ct = CleanText(r[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;);&#xA;    if (!ct.StartsWith(CleanText(cmsPrincipalPrefixRaw))) return false;&#xA;    if (IsCmsFeeOrTax(r)) return false;&#xA;    for (int i = 0; i &lt; cmsPrincipalExclusions.Length; i++)&#xA;        if (ct.Contains(cmsPrincipalExclusions[i])) return false;&#xA;    return true;&#xA;};&#xA;Func&lt;string, string, string&gt; KeyBoth = (pan, rrn) =&gt; (NormalizePan(pan) + &quot;|&quot; + NormalizeRrn(rrn)).ToUpperInvariant();&#xA;&#xA;Func&lt;System.Data.DataRow, decimal&gt; GetDebit = r =&gt;&#xA;{&#xA;    string col = $&quot;Debit ({currency})&quot;;&#xA;    return r.Table.Columns.Contains(col) ? ParseAmount(r[col]) : 0m;&#xA;};&#xA;Func&lt;System.Data.DataRow, decimal&gt; GetCredit = r =&gt;&#xA;{&#xA;    string col = $&quot;Credit ({currency})&quot;;&#xA;    return r.Table.Columns.Contains(col) ? ParseAmount(r[col]) : 0m;&#xA;};&#xA;Func&lt;System.Data.DataRow, decimal&gt; GetCmsAmt = r =&gt;&#xA;{&#xA;    var cr = GetCredit(r);&#xA;    var dr = GetDebit(r);&#xA;    return (cr &gt; dr ? cr : dr);&#xA;};&#xA;Func&lt;System.Data.DataRow, string&gt; GetNarr = r =&gt;&#xA;{&#xA;    return r.Table.Columns.Contains(&quot;Narration&quot;) ? (r[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;};&#xA;Func&lt;string, string&gt; ExtractGLPanFromNarr = narr =&gt;&#xA;{&#xA;    var m = System.Text.RegularExpressions.Regex.Match(narr ?? &quot;&quot;, @&quot;\b\d{6}(?:\*{6}|X{6})\d{4}\b&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;    return m.Success ? NormalizePan(m.Value) : &quot;&quot;;&#xA;};&#xA;Func&lt;string, string&gt; ExtractGLRrnFromNarr = narr =&gt;&#xA;{&#xA;    var m = System.Text.RegularExpressions.Regex.Match(narr ?? &quot;&quot;, @&quot;\b[0-9A-Z]{12}\b&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase);&#xA;    return m.Success ? NormalizeRrn(m.Value) : &quot;&quot;;&#xA;};&#xA;Func&lt;System.Data.DataRow, string&gt; GetKeyFromNarr = r =&gt;&#xA;{&#xA;    var narr = GetNarr(r);&#xA;    var pan = ExtractGLPanFromNarr(narr);&#xA;    var rrn = ExtractGLRrnFromNarr(narr);&#xA;    if (pan.Length == 0 || rrn.Length == 0) return &quot;&quot;;&#xA;    return KeyBoth(pan, rrn);&#xA;};&#xA;&#xA;// Classification helper (GL only)&#xA;void EnsureUMJP_ForGL(System.Data.DataRow row)&#xA;{&#xA;    if (!row.Table.Columns.Contains(&quot;Source&quot;)) return;&#xA;    string src = row[&quot;Source&quot;]?.ToString() ?? &quot;&quot;;&#xA;    if (src.Equals(&quot;GL&quot;, System.StringComparison.OrdinalIgnoreCase))&#xA;        if (row.Table.Columns.Contains(&quot;Classification&quot;))&#xA;            row[&quot;Classification&quot;] = &quot;UMJP&quot;;&#xA;}&#xA;&#xA;// Force-label with UBX config message (no late-post skipping; we MUST set these when principal matched but charges don't tally)&#xA;void LabelUBX_Force(System.Data.DataRow row)&#xA;{&#xA;    if (row.Table.Columns.Contains(&quot;UMJP Charges Mismatch&quot;))&#xA;        row[&quot;UMJP Charges Mismatch&quot;] = true;&#xA;&#xA;    EnsureUMJP_ForGL(row);&#xA;&#xA;    row[&quot;Root Cause&quot;]          = &quot;Wrong configuration of UBX ATM charges&quot;;&#xA;    row[&quot;Root Cause Category&quot;] = &quot;People&quot;;&#xA;    row[&quot;Recommended Action&quot;]  = &quot;Reverse the charges and correctly configure CBS to pass the right charges&quot;;&#xA;    row[&quot;Action Owner&quot;]        = &quot;Card Settlement &amp; Stephen Jilala&quot;;&#xA;}&#xA;&#xA;// ---------- Pre totals ----------&#xA;decimal preDebit = 0m, preCredit = 0m;&#xA;{&#xA;    string dc = $&quot;Debit ({currency})&quot;;&#xA;    string cc = $&quot;Credit ({currency})&quot;;&#xA;    bool hasD = dtHistoricalReconTransactionsReport.Columns.Contains(dc);&#xA;    bool hasC = dtHistoricalReconTransactionsReport.Columns.Contains(cc);&#xA;    for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;    {&#xA;        var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;        if (hasD) preDebit += ParseAmount(r[dc]);&#xA;        if (hasC) preCredit += ParseAmount(r[cc]);&#xA;    }&#xA;}&#xA;decimal removedDebit = 0m, removedCredit = 0m;&#xA;&#xA;// ---------- Partition ----------&#xA;var allRows = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;(dtHistoricalReconTransactionsReport.Rows.Count);&#xA;for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++) allRows.Add(dtHistoricalReconTransactionsReport.Rows[i]);&#xA;&#xA;var glUmjpRows   = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;var cmsPrincipal = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;var cmsCharges   = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;int cmsFeeOrTaxCount = 0, cmsExcludedCount = 0;&#xA;&#xA;for (int i = 0; i &lt; allRows.Count; i++)&#xA;{&#xA;    var r = allRows[i];&#xA;    if (IsGlUmjpRow(r)) { EnsureUMJP_ForGL(r); glUmjpRows.Add(r); continue; }&#xA;    if (IsCmsFeeOrTax(r)) { cmsCharges.Add(r); cmsFeeOrTaxCount++; continue; }&#xA;    if (IsCmsPrincipal(r)) cmsPrincipal.Add(r);&#xA;    else&#xA;    {&#xA;        var ct = CleanText(r[&quot;Narration&quot;]?.ToString() ?? &quot;&quot;);&#xA;        if (ct.StartsWith(CleanText(cmsPrincipalPrefixRaw))) cmsExcludedCount++;&#xA;    }&#xA;}&#xA;System.Console.WriteLine($&quot;🔎 Diagnostics: CMS fee/tax rows={cmsFeeOrTaxCount}, CMS principal-like but excluded={cmsExcludedCount}&quot;);&#xA;&#xA;// ---------- CMS indexes by BOTH ----------&#xA;var cmsPrincipalByKey = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;var cmsChargesByKey   = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;int cmsPKeyed = 0, cmsPDiscard = 0, cmsCKeyed = 0, cmsCDiscard = 0;&#xA;&#xA;for (int i = 0; i &lt; cmsPrincipal.Count; i++)&#xA;{&#xA;    var r = cmsPrincipal[i];&#xA;    string pan = r.Table.Columns.Contains(&quot;C_PAN&quot;) ? NormalizePan(r[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;    string rrn = r.Table.Columns.Contains(&quot;RRN&quot;)   ? NormalizeRrn(r[&quot;RRN&quot;]?.ToString() ?? &quot;&quot;)   : &quot;&quot;;&#xA;    if (pan.Length == 0 || rrn.Length == 0) { cmsPDiscard++; continue; }&#xA;    string kb = KeyBoth(pan, rrn);&#xA;    if (!cmsPrincipalByKey.TryGetValue(kb, out var list)) { list = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;(); cmsPrincipalByKey[kb] = list; }&#xA;    list.Add(r); cmsPKeyed++;&#xA;}&#xA;for (int i = 0; i &lt; cmsCharges.Count; i++)&#xA;{&#xA;    var r = cmsCharges[i];&#xA;    string pan = r.Table.Columns.Contains(&quot;C_PAN&quot;) ? NormalizePan(r[&quot;C_PAN&quot;]?.ToString() ?? &quot;&quot;) : &quot;&quot;;&#xA;    string rrn = r.Table.Columns.Contains(&quot;RRN&quot;)   ? NormalizeRrn(r[&quot;RRN&quot;]?.ToString() ?? &quot;&quot;)   : &quot;&quot;;&#xA;    if (pan.Length == 0 || rrn.Length == 0) { cmsCDiscard++; continue; }&#xA;    string kb = KeyBoth(pan, rrn);&#xA;    if (!cmsChargesByKey.TryGetValue(kb, out var list)) { list = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;(); cmsChargesByKey[kb] = list; }&#xA;    list.Add(r); cmsCKeyed++;&#xA;}&#xA;&#xA;// ---------- Group GL by BOTH ----------&#xA;var glByKey = new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.List&lt;System.Data.DataRow&gt;&gt;();&#xA;for (int i = 0; i &lt; glUmjpRows.Count; i++)&#xA;{&#xA;    var r = glUmjpRows[i];&#xA;    var key = GetKeyFromNarr(r);&#xA;    if (string.IsNullOrEmpty(key)) continue;&#xA;    if (!glByKey.TryGetValue(key, out var list)) { list = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;(); glByKey[key] = list; }&#xA;    list.Add(r);&#xA;}&#xA;&#xA;System.Console.WriteLine();&#xA;System.Console.WriteLine(&quot;🧮 UMJP reconciliation: remove principal pair; label non-tally charges&quot;);&#xA;&#xA;var rowsToRemove = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;var cmsConsumed  = new System.Collections.Generic.HashSet&lt;System.Data.DataRow&gt;();&#xA;&#xA;int matchedPrincipalPairs = 0;&#xA;int matchedChargeGroups   = 0;&#xA;int labeledChargeSets     = 0;&#xA;decimal sumMatchedPrincipal = 0m;&#xA;decimal sumMatchedChargesGL = 0m;&#xA;decimal sumMatchedChargesCMS = 0m;&#xA;&#xA;foreach (var kv in glByKey)&#xA;{&#xA;    var key = kv.Key;&#xA;    var glRows = kv.Value;&#xA;&#xA;    // GL principal = largest Debit per key&#xA;    System.Data.DataRow glPrincipal = null;&#xA;    decimal glPrincipalAmt = 0m;&#xA;    for (int i = 0; i &lt; glRows.Count; i++)&#xA;    {&#xA;        var r = glRows[i];&#xA;        decimal d = GetDebit(r);&#xA;        if (d &gt; glPrincipalAmt) { glPrincipalAmt = d; glPrincipal = r; }&#xA;    }&#xA;    if (glPrincipal == null || glPrincipalAmt &lt;= 0) continue;&#xA;&#xA;    // Unique CMS principal with exact same amount&#xA;    System.Data.DataRow cmsPrincipalChosen = null;&#xA;    if (cmsPrincipalByKey.TryGetValue(key, out var cmsPList))&#xA;    {&#xA;        for (int i = 0; i &lt; cmsPList.Count; i++)&#xA;        {&#xA;            var r = cmsPList[i];&#xA;            if (cmsConsumed.Contains(r)) continue;&#xA;            if (GetCmsAmt(r) == glPrincipalAmt)&#xA;            {&#xA;                if (cmsPrincipalChosen == null) cmsPrincipalChosen = r;&#xA;                else { cmsPrincipalChosen = null; break; } // ambiguous → skip this key&#xA;            }&#xA;        }&#xA;    }&#xA;    if (cmsPrincipalChosen == null) continue;&#xA;&#xA;    // ===== Stage A: move principal pair to Matched =====&#xA;    int idx1 = dtHistoricalReconTransactionsReportMatched.Rows.Count;&#xA;    dtHistoricalReconTransactionsReportMatched.ImportRow(glPrincipal);&#xA;    dtHistoricalReconTransactionsReportMatched.Rows[idx1][&quot;Classification&quot;] = &quot;UMJP&quot;;&#xA;&#xA;    int idx2 = dtHistoricalReconTransactionsReportMatched.Rows.Count;&#xA;    dtHistoricalReconTransactionsReportMatched.ImportRow(cmsPrincipalChosen);&#xA;    dtHistoricalReconTransactionsReportMatched.Rows[idx2][&quot;Classification&quot;] = &quot;UMJP&quot;;&#xA;&#xA;    removedDebit  += GetDebit(glPrincipal);&#xA;    removedCredit += GetCredit(glPrincipal);&#xA;    removedDebit  += GetDebit(cmsPrincipalChosen);&#xA;    removedCredit += GetCredit(cmsPrincipalChosen);&#xA;&#xA;    rowsToRemove.Add(glPrincipal);&#xA;    rowsToRemove.Add(cmsPrincipalChosen);&#xA;    cmsConsumed.Add(cmsPrincipalChosen);&#xA;&#xA;    matchedPrincipalPairs++;&#xA;    sumMatchedPrincipal += glPrincipalAmt;&#xA;    System.Console.WriteLine($&quot;✅ Principal matched &amp; removed (UMJP) {key} | Amount {glPrincipalAmt:N2}&quot;);&#xA;&#xA;    // ===== Stage B: charges for this key =====&#xA;    // GL charges = ALL other GL debits (exclude reversals/chargebacks)&#xA;    decimal glChargeSum = 0m;&#xA;    var glChargeRows = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;    for (int i = 0; i &lt; glRows.Count; i++)&#xA;    {&#xA;        var r = glRows[i];&#xA;        if (object.ReferenceEquals(r, glPrincipal)) continue;&#xA;        decimal d = GetDebit(r);&#xA;        if (d &lt;= 0) continue;&#xA;&#xA;        var ct = CleanText(GetNarr(r));&#xA;        bool isExcluded = false;&#xA;        for (int j = 0; j &lt; cmsPrincipalExclusions.Length; j++)&#xA;            if (ct.Contains(cmsPrincipalExclusions[j])) { isExcluded = true; break; }&#xA;        if (isExcluded) continue;&#xA;&#xA;        glChargeRows.Add(r);&#xA;        glChargeSum += d;&#xA;    }&#xA;&#xA;    // CMS charges for key&#xA;    decimal cmsChargeSum = 0m;&#xA;    var cmsChargeRowsChosen = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;();&#xA;    if (cmsChargesByKey.TryGetValue(key, out var cmsCList))&#xA;    {&#xA;        for (int i = 0; i &lt; cmsCList.Count; i++)&#xA;        {&#xA;            var r = cmsCList[i];&#xA;            if (cmsConsumed.Contains(r)) continue;&#xA;            cmsChargeRowsChosen.Add(r);&#xA;            cmsChargeSum += GetCmsAmt(r);&#xA;        }&#xA;    }&#xA;&#xA;    if (glChargeRows.Count &gt; 0 &amp;&amp; cmsChargeRowsChosen.Count &gt; 0)&#xA;    {&#xA;        decimal diff = System.Math.Abs(glChargeSum - cmsChargeSum);&#xA;        if (diff &lt;= chargeTol)&#xA;        {&#xA;            // Move *all* charges (GL + CMS) to Matched&#xA;            for (int i = 0; i &lt; glChargeRows.Count; i++)&#xA;            {&#xA;                var r = glChargeRows[i];&#xA;                int ix = dtHistoricalReconTransactionsReportMatched.Rows.Count;&#xA;                dtHistoricalReconTransactionsReportMatched.ImportRow(r);&#xA;                dtHistoricalReconTransactionsReportMatched.Rows[ix][&quot;Classification&quot;] = &quot;UMJP&quot;;&#xA;                rowsToRemove.Add(r);&#xA;                removedDebit  += GetDebit(r);&#xA;                removedCredit += GetCredit(r);&#xA;            }&#xA;            for (int i = 0; i &lt; cmsChargeRowsChosen.Count; i++)&#xA;            {&#xA;                var r = cmsChargeRowsChosen[i];&#xA;                int ix = dtHistoricalReconTransactionsReportMatched.Rows.Count;&#xA;                dtHistoricalReconTransactionsReportMatched.ImportRow(r);&#xA;                dtHistoricalReconTransactionsReportMatched.Rows[ix][&quot;Classification&quot;] = &quot;UMJP&quot;;&#xA;                rowsToRemove.Add(r);&#xA;                cmsConsumed.Add(r);&#xA;                removedDebit  += GetDebit(r);&#xA;                removedCredit += GetCredit(r);&#xA;            }&#xA;&#xA;            matchedChargeGroups++;&#xA;            sumMatchedChargesGL  += glChargeSum;&#xA;            sumMatchedChargesCMS += cmsChargeSum;&#xA;&#xA;            System.Console.WriteLine($&quot;✅ Charges moved (compound) {key} | GL={glChargeSum:N2} ≈ CMS={cmsChargeSum:N2} (Δ≤{chargeTol:N2})&quot;);&#xA;        }&#xA;        else&#xA;        {&#xA;            // Leave them in working table and LABEL *both sides*&#xA;            for (int i = 0; i &lt; glChargeRows.Count; i++) LabelUBX_Force(glChargeRows[i]);&#xA;            for (int i = 0; i &lt; cmsChargeRowsChosen.Count; i++) LabelUBX_Force(cmsChargeRowsChosen[i]);&#xA;&#xA;            labeledChargeSets++;&#xA;            System.Console.WriteLine($&quot;⚠️ Charges DO NOT tally — left &amp; labeled {key} | GL={glChargeSum:N2} vs CMS={cmsChargeSum:N2}&quot;);&#xA;        }&#xA;    }&#xA;    else&#xA;    {&#xA;        // One-sided charge presence after principal matched → also a non-tally case: label what's present&#xA;        if (glChargeRows.Count &gt; 0)&#xA;        {&#xA;            for (int i = 0; i &lt; glChargeRows.Count; i++) LabelUBX_Force(glChargeRows[i]);&#xA;            labeledChargeSets++;&#xA;            System.Console.WriteLine($&quot;ℹ️ No CMS charges; GL charges labeled for {key} (principal already removed).&quot;);&#xA;        }&#xA;        if (cmsChargeRowsChosen.Count &gt; 0)&#xA;        {&#xA;            for (int i = 0; i &lt; cmsChargeRowsChosen.Count; i++) LabelUBX_Force(cmsChargeRowsChosen[i]);&#xA;            labeledChargeSets++;&#xA;            System.Console.WriteLine($&quot;ℹ️ No GL charges; CMS charges labeled for {key} (principal already removed).&quot;);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// ---------- Physical removal of matched rows (principal + any matched charges) ----------&#xA;if (rowsToRemove.Count &gt; 0)&#xA;{&#xA;    var toRemove = new System.Collections.Generic.List&lt;System.Data.DataRow&gt;(rowsToRemove);&#xA;    for (int i = 0; i &lt; toRemove.Count; i++)&#xA;    {&#xA;        var row = toRemove[i];&#xA;        if (row != null &amp;&amp; row.Table == dtHistoricalReconTransactionsReport &amp;&amp; row.RowState != System.Data.DataRowState.Detached)&#xA;            dtHistoricalReconTransactionsReport.Rows.Remove(row);&#xA;    }&#xA;}&#xA;&#xA;// ---------- Post totals &amp; summary ----------&#xA;decimal postDebit = 0m, postCredit = 0m;&#xA;{&#xA;    string dc = $&quot;Debit ({currency})&quot;;&#xA;    string cc = $&quot;Credit ({currency})&quot;;&#xA;    bool hasD = dtHistoricalReconTransactionsReport.Columns.Contains(dc);&#xA;    bool hasC = dtHistoricalReconTransactionsReport.Columns.Contains(cc);&#xA;    for (int i = 0; i &lt; dtHistoricalReconTransactionsReport.Rows.Count; i++)&#xA;    {&#xA;        var r = dtHistoricalReconTransactionsReport.Rows[i];&#xA;        if (hasD) postDebit += ParseAmount(r[dc]);&#xA;        if (hasC) postCredit += ParseAmount(r[cc]);&#xA;    }&#xA;}&#xA;&#xA;System.Console.WriteLine();&#xA;System.Console.WriteLine(&quot;📝 UMJP Summary&quot;);&#xA;System.Console.WriteLine($&quot;GL UMJP keys: {glByKey.Count}&quot;);&#xA;System.Console.WriteLine($&quot;CMS principal keyed: {cmsPKeyed} (discarded no key: {cmsPDiscard})&quot;);&#xA;System.Console.WriteLine($&quot;CMS fee/tax keyed : {cmsCKeyed} (discarded no key: {cmsCDiscard})&quot;);&#xA;System.Console.WriteLine($&quot;Matched principal pairs: {matchedPrincipalPairs} | Tota
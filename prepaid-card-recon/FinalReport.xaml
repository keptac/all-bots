            <ui:InvokeCode ContinueOnError="{x:Null}" Code="try&#xA;{&#xA;    if (!File.Exists(prepaidCardFileName))&#xA;        throw new FileNotFoundException($&quot;The file '{prepaidCardFileName}' does not exist.&quot;);&#xA;&#xA;    var summaryDict = new Dictionary&lt;string, (decimal Debit, decimal Credit)&gt;();&#xA;&#xA;    foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;    {&#xA;        string rootCause = row[&quot;Root Cause&quot;]?.ToString()?.Trim();&#xA;        if (string.IsNullOrWhiteSpace(rootCause)) rootCause = &quot;UNKNOWN&quot;;&#xA;&#xA;        decimal debit = 0m, credit = 0m;&#xA;&#xA;        if (decimal.TryParse(row[&quot;Debit (TZS)&quot;]?.ToString(), out var d))&#xA;            debit = d;&#xA;&#xA;        if (decimal.TryParse(row[&quot;Credit (TZS)&quot;]?.ToString(), out var c))&#xA;            credit = c;&#xA;&#xA;        if (summaryDict.ContainsKey(rootCause))&#xA;        {&#xA;            var existing = summaryDict[rootCause];&#xA;            summaryDict[rootCause] = (existing.Debit + debit, existing.Credit + credit);&#xA;        }&#xA;        else&#xA;        {&#xA;            summaryDict[rootCause] = (debit, credit);&#xA;        }&#xA;    }&#xA;&#xA;    using (var workbook = new XLWorkbook(prepaidCardFileName))&#xA;    {&#xA;        var worksheet = workbook.Worksheets.FirstOrDefault(ws =&gt; ws.Name == &quot;Root Cause Summary&quot;)&#xA;                        ?? workbook.AddWorksheet(&quot;Root Cause Summary&quot;);&#xA;&#xA;        // Headers&#xA;        worksheet.Cell(1, 1).Value = &quot;Row Labels&quot;;&#xA;        worksheet.Cell(1, 2).Value = &quot;Sum of Debit&quot;;&#xA;        worksheet.Cell(1, 3).Value = &quot;Sum of Credit&quot;;&#xA;        worksheet.Range(1, 1, 1, 3).Style.Font.Bold = true;&#xA;&#xA;        int currentRow = 2;&#xA;        decimal grandDebit = 0, grandCredit = 0;&#xA;&#xA;        foreach (var kvp in summaryDict)&#xA;        {&#xA;            worksheet.Cell(currentRow, 1).Value = kvp.Key;&#xA;            worksheet.Cell(currentRow, 2).Value = Math.Round(kvp.Value.Debit, 2);&#xA;            worksheet.Cell(currentRow, 3).Value = Math.Round(kvp.Value.Credit, 2);&#xA;&#xA;            grandDebit += kvp.Value.Debit;&#xA;            grandCredit += kvp.Value.Credit;&#xA;            currentRow++;&#xA;        }&#xA;&#xA;        // Grand total&#xA;        worksheet.Cell(currentRow, 1).Value = &quot;Grand Total&quot;;&#xA;        worksheet.Cell(currentRow, 2).Value = Math.Round(grandDebit, 2);&#xA;        worksheet.Cell(currentRow, 3).Value = Math.Round(grandCredit, 2);&#xA;        worksheet.Range(currentRow, 1, currentRow, 3).Style.Font.Bold = true;&#xA;&#xA;        // Formatting&#xA;        worksheet.Range(2, 2, currentRow, 3).Style.NumberFormat.Format = &quot;#,##0.00&quot;;&#xA;&#xA;        // Borders&#xA;        worksheet.Range(1, 1, currentRow, 3).Style.Border.OutsideBorder = XLBorderStyleValues.Thin;&#xA;        worksheet.Range(1, 1, currentRow, 3).Style.Border.InsideBorder = XLBorderStyleValues.Thin;&#xA;&#xA;        // Column widths&#xA;        worksheet.Column(1).Width = 30;&#xA;        worksheet.Column(2).Width = 20;&#xA;        worksheet.Column(3).Width = 20;&#xA;&#xA;        workbook.Save();&#xA;    }&#xA;}&#xA;catch (Exception ex)&#xA;{&#xA;    Console.WriteLine(&quot;❌ An error occurred: &quot; + ex.Message);&#xA;}&#xA;" DisplayName="Excel write &quot;Root Cause Summary&quot;" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_105" Language="CSharp">

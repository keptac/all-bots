        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Inputs:&#xA;// dtHistoricalReconTransactionsReport (DataTable)&#xA;// dtHistoricalReconTransactionsReportMatched (DataTable)&#xA;&#xA;var feeDirectionMap = new Dictionary&lt;string, bool&gt;(StringComparer.OrdinalIgnoreCase)&#xA;{&#xA;    [&quot;CARD FEES&quot;] = true,&#xA;    [&quot;CASH ADVANCE/ CASH AT POS / CASH OUT TRANSACTION FEE&quot;] = true,&#xA;    [&quot;PURCHASE/AUTH COMPLETION TRANSACTION FEE&quot;] = true,&#xA;    [&quot;CASH WITHDRAWAL TRANSACTION FEE&quot;] = true,&#xA;    [&quot;BALANCE INQUIRY TRANSACTION FEE&quot;] = true,&#xA;    [&quot;RECURRING TRANSACTION TRANSACTION FEE&quot;] = true,&#xA;    [&quot;MINI STATEMENT TRANSACTION FEE&quot;] = true,&#xA;    [&quot;SERVICE TAX/TAX ON INCOME&quot;] = true&#xA;};&#xA;&#xA;var dateRangeRegex = new System.Text.RegularExpressions.Regex(@&quot;(\d{6})\s*(?:[Tt][Oo]|-|\/)?\s*(\d{6})&quot;);&#xA;string[] allowedFormats = { &quot;MM/dd/yyyy HH:mm:ss&quot;, &quot;dd-MMM-yyyy&quot;, &quot;M/d/yyyy&quot; };&#xA;&#xA;// === Step 1: Force string → DateTime for all rows ===&#xA;foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;{&#xA;    foreach (string col in new[] { &quot;Booking Date&quot;, &quot;Value Date&quot; })&#xA;    {&#xA;        if (!dtHistoricalReconTransactionsReport.Columns.Contains(col)) continue;&#xA;&#xA;        var val = row[col];&#xA;        if (val == null || val == DBNull.Value) continue;&#xA;&#xA;        if (val is string s)&#xA;        {&#xA;            s = s.Trim();&#xA;            if (DateTime.TryParseExact(s, allowedFormats, null, System.Globalization.DateTimeStyles.None, out var parsed))&#xA;            {&#xA;                row[col] = parsed;&#xA;            }&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Step 2: Helpers ===&#xA;DateTime ParseBookingDate(object value)&#xA;{&#xA;    if (value == null || value == DBNull.Value) return DateTime.MinValue;&#xA;    if (value is DateTime dt) return dt;&#xA;&#xA;    string str = value.ToString().Trim();&#xA;    if (DateTime.TryParseExact(str, allowedFormats, null, System.Globalization.DateTimeStyles.None, out var parsed))&#xA;        return parsed;&#xA;&#xA;    return DateTime.MinValue;&#xA;}&#xA;&#xA;DateTime ParseCompactDate(string val)&#xA;{&#xA;    return DateTime.TryParseExact(val, &quot;ddMMyy&quot;, null, System.Globalization.DateTimeStyles.None, out var parsed)&#xA;        ? parsed&#xA;        : DateTime.MinValue;&#xA;}&#xA;&#xA;decimal TryParseDecimal(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return 0m;&#xA;    string s = val.ToString().Replace(&quot;,&quot;, &quot;&quot;).Replace(&quot;(&quot;, &quot;-&quot;).Replace(&quot;)&quot;, &quot;&quot;).Trim();&#xA;    return decimal.TryParse(s, out var result) ? result : 0m;&#xA;}&#xA;&#xA;// === Step 3: Matching ===&#xA;Console.WriteLine(&quot;===== GL Narration Matching Against Historical Totals =====&quot;);&#xA;&#xA;var glCandidates = dtHistoricalReconTransactionsReport.AsEnumerable().ToList();&#xA;var rowsToRemove = new List&lt;DataRow&gt;();&#xA;bool anyMatches = false;&#xA;&#xA;foreach (DataRow row in glCandidates)&#xA;{&#xA;    string narration = row[&quot;Narration&quot;]?.ToString()?.Trim().ToUpperInvariant() ?? &quot;&quot;;&#xA;    if (!narration.Contains(&quot;JOURNAL&quot;)) continue;&#xA;&#xA;    var match = dateRangeRegex.Match(narration);&#xA;    if (!match.Success) continue;&#xA;&#xA;    DateTime fromDate = ParseCompactDate(match.Groups[1].Value);&#xA;    DateTime toDate = ParseCompactDate(match.Groups[2].Value);&#xA;    if (fromDate == DateTime.MinValue || toDate == DateTime.MinValue) continue;&#xA;&#xA;    var rule = feeDirectionMap.Keys.FirstOrDefault(k =&gt; narration.Contains(k.ToUpperInvariant()));&#xA;    if (string.IsNullOrEmpty(rule)) continue;&#xA;&#xA;    bool useCredit = feeDirectionMap[rule];&#xA;    string amountCol = useCredit ? &quot;Credit (TZS)&quot; : &quot;Debit (TZS)&quot;;&#xA;    decimal glAmount = TryParseDecimal(row[&quot;Debit (TZS)&quot;]);&#xA;&#xA;    var matchedRows = dtHistoricalReconTransactionsReport.AsEnumerable()&#xA;        .Where(r =&gt;&#xA;        {&#xA;            string histNarr = r[&quot;Narration&quot;]?.ToString()?.Trim().ToUpperInvariant() ?? &quot;&quot;;&#xA;            DateTime bookDate = ParseBookingDate(r[&quot;Booking Date&quot;]);&#xA;&#xA;            if (histNarr.Contains(rule.ToUpperInvariant()))&#xA;            {&#xA;                if (bookDate &gt;= fromDate &amp;&amp; bookDate &lt;= toDate)&#xA;                {&#xA;                    // Console.WriteLine($&quot;🔎 Matched fee row: {histNarr} | Booking: {bookDate:dd-MMM-yyyy}&quot;);&#xA;                    return true;&#xA;                }&#xA;            }&#xA;            return false;&#xA;        })&#xA;        .ToList();&#xA;&#xA;    decimal matchedTotal = matchedRows.Sum(r =&gt; TryParseDecimal(r[amountCol]));&#xA;&#xA;    Console.WriteLine($&quot;🧾 NARRATION: {narration}&quot;);&#xA;    Console.WriteLine($&quot;📅 RANGE: {fromDate:dd-MMM-yyyy} to {toDate:dd-MMM-yyyy}&quot;);&#xA;    Console.WriteLine($&quot;💳 GL Amount: {glAmount:N2}&quot;);&#xA;    Console.WriteLine($&quot;📊 Matched {rule} Total: {matchedTotal:N2}&quot;);&#xA;&#xA;    if (glAmount == matchedTotal)&#xA;    {&#xA;        Console.WriteLine(&quot;✅ MATCH – moving rows to Matched table&quot;);&#xA;        anyMatches = true;&#xA;&#xA;        dtHistoricalReconTransactionsReportMatched.ImportRow(row);&#xA;        rowsToRemove.Add(row);&#xA;&#xA;        foreach (var histRow in matchedRows)&#xA;        {&#xA;            dtHistoricalReconTransactionsReportMatched.ImportRow(histRow);&#xA;            rowsToRemove.Add(histRow);&#xA;        }&#xA;    }&#xA;    else&#xA;    {&#xA;        Console.WriteLine(&quot;❌ MISMATCH – totals do not match&quot;);&#xA;    }&#xA;&#xA;    Console.WriteLine(&quot;----------------------------------------------------&quot;);&#xA;}&#xA;&#xA;// === Step 4: Final Cleanup ===&#xA;foreach (var r in rowsToRemove.Distinct().ToList())&#xA;{&#xA;    if (r.Table == dtHistoricalReconTransactionsReport &amp;&amp; r.RowState != DataRowState.Detached)&#xA;    {&#xA;        dtHistoricalReconTransactionsReport.Rows.Remove(r);&#xA;    }&#xA;}&#xA;&#xA;if (!anyMatches)&#xA;{&#xA;    Console.WriteLine(&quot;❌ No matching groups were found in the dataset.&quot;);&#xA;}&#xA;else&#xA;{&#xA;    Console.WriteLine(&quot;✅ Matching completed. One or more groups were matched.&quot;);&#xA;}&#xA;" DisplayName=" REMOVE GL date Range Fees/Income" sap:VirtualizedContainerService.HintSize="518.4,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_84" Language="CSharp">

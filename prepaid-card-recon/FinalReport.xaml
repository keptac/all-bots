            <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Helper to clean narration&#xA;string CleanText(string input)&#xA;{&#xA;    if (string.IsNullOrEmpty(input)) return string.Empty;&#xA;    return Regex.Replace(input, @&quot;[^a-zA-Z0-9\s]&quot;, &quot;&quot;).Trim().ToUpper();&#xA;}&#xA;&#xA;// Calculate reconDate&#xA;DateTime reconDateParsed = DateTime.ParseExact(toDate, &quot;dd-MM-yyyy&quot;, System.Globalization.CultureInfo.InvariantCulture).AddDays(-1);&#xA;&#xA;// Find last SNO&#xA;int lastSNO = dtHistoricalReconTransactionsReportMatched.AsEnumerable()&#xA;    .Where(row =&gt; row[&quot;SNO&quot;] != DBNull.Value &amp;&amp; int.TryParse(row[&quot;SNO&quot;].ToString(), out _))&#xA;    .Select(row =&gt; Convert.ToInt32(row[&quot;SNO&quot;]))&#xA;    .DefaultIfEmpty(0)&#xA;    .Max();&#xA;&#xA;// Find unmatched rows&#xA;var rowsToMove = dtGlStatementMatched.AsEnumerable()&#xA;    .ToList();&#xA;&#xA;// Process each row&#xA;foreach (DataRow row in rowsToMove)&#xA;{&#xA;    DataRow newRow = dtHistoricalReconTransactionsReportMatched.NewRow();&#xA;    int reportRowNumber = dtHistoricalReconTransactionsReportMatched.Rows.Count + 2;&#xA;    &#xA;    newRow[&quot;SNO&quot;] = ++lastSNO;&#xA;&#xA;&#xA;    var formats = new[] { &quot;dd-MM-yyyy&quot;, &quot;dd/MM/yyyy&quot;, &quot;yyyy-MM-dd&quot; };&#xA;    var culture = System.Globalization.CultureInfo.InvariantCulture;&#xA;&#xA;    string valueDateStr = row[&quot;Value Date&quot;]?.ToString();&#xA;    string bookingDateStr = row[&quot;Booking Date&quot;]?.ToString();&#xA;&#xA;    DateTime valueDateParsed = DateTime.TryParseExact(valueDateStr, formats, culture, System.Globalization.DateTimeStyles.None, out var vdt) ? vdt : DateTime.MinValue;&#xA;    DateTime bookingDateParsed = DateTime.TryParseExact(bookingDateStr, formats, culture, System.Globalization.DateTimeStyles.None, out var bdt) ? bdt : DateTime.MinValue;&#xA;&#xA;    newRow[&quot;Value Date&quot;] = valueDateParsed != DateTime.MinValue ? valueDateParsed.ToString(&quot;dd-MMM-yyyy&quot;) : valueDateStr;&#xA;    newRow[&quot;Booking Date&quot;] = bookingDateParsed != DateTime.MinValue ? bookingDateParsed.ToString(&quot;dd-MMM-yyyy&quot;) : bookingDateStr;&#xA;&#xA;    newRow[&quot;Transaction Ref No:&quot;] = row[&quot;Transaction Ref No:&quot;];&#xA;    newRow[&quot;Narration&quot;] = row[&quot;Narration&quot;];&#xA;    newRow[&quot;Debit (TZS)&quot;] = row[&quot;Debit (TZS)&quot;];&#xA;    newRow[&quot;Credit (TZS)&quot;] = row[&quot;Credit (TZS)&quot;];&#xA;&#xA;    // Additional fields&#xA;    newRow[&quot;STAN&quot;] = row[&quot;STAN&quot;];&#xA;    newRow[&quot;RRN&quot;] = row[&quot;RRN&quot;];&#xA;    newRow[&quot;EXTRACTED_TERMINAL_ID&quot;] = row[&quot;EXTRACTED_TERMINAL_ID&quot;];&#xA;    newRow[&quot;AUTHORIZATION_NUMBER&quot;] = row[&quot;AUTHORIZATION_NUMBER&quot;];&#xA;    newRow[&quot;C_PAN&quot;] = row[&quot;C_PAN&quot;];&#xA;&#x9;newRow[&quot;C_PAN_AMOUNT&quot;] = row[&quot;C_PAN_AMOUNT&quot;];&#xA;&#x9;newRow[&quot;source&quot;] = row[&quot;source&quot;];&#xA;    newRow[&quot;Search Key&quot;] = row[&quot;Search Key&quot;];&#xA;    dtHistoricalReconTransactionsReportMatched.Rows.Add(newRow);&#xA;}&#xA;&#xA;// Summary&#xA;Console.WriteLine($&quot;Final dtGlStatementMatched count: {dtGlStatementMatched.Rows.Count}&quot;);&#xA;Console.WriteLine($&quot;Final dtHistoricalReconTransactionsReportMatched count: {dtHistoricalReconTransactionsReportMatched.Rows.Count}&quot;);&#xA;" DisplayName="dtGlStatementMatched items to dtHisto" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_25" Language="CSharp">

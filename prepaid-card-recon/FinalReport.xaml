        <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Language: C#&#xA;// In/Out: dtHistoricalReconTransactionsReport (DataTable)&#xA;// In/Out: dtHistoricalReconTransactionsReportMatched (DataTable)&#xA;&#xA;// === Helpers ===&#xA;string Normalize(string input) =&gt; (input ?? &quot;&quot;).Trim().ToUpperInvariant();&#xA;string NormalizeRRN(string rrn) =&gt; (rrn ?? &quot;&quot;).Trim().PadLeft(12, '0');&#xA;&#xA;// === Ensure MATCH column exists ===&#xA;if (!dtHistoricalReconTransactionsReport.Columns.Contains(&quot;MATCH&quot;))&#xA;{&#xA;    dtHistoricalReconTransactionsReport.Columns.Add(&quot;MATCH&quot;, typeof(bool));&#xA;    foreach (DataRow row in dtHistoricalReconTransactionsReport.Rows)&#xA;        row[&quot;MATCH&quot;] = false;&#xA;}&#xA;&#xA;// === Track skipped rows ===&#xA;int skipped = 0;&#xA;&#xA;// === Group rows by RRN + C_PAN ===&#xA;var grouped = dtHistoricalReconTransactionsReport.AsEnumerable()&#xA;    .Where(r =&gt;&#xA;    {&#xA;        bool hasRRN = r[&quot;RRN&quot;] != DBNull.Value &amp;&amp; !string.IsNullOrWhiteSpace(r[&quot;RRN&quot;].ToString());&#xA;        bool hasPAN = r[&quot;C_PAN&quot;] != DBNull.Value &amp;&amp; !string.IsNullOrWhiteSpace(r[&quot;C_PAN&quot;].ToString());&#xA;        if (!hasRRN || !hasPAN) skipped++;&#xA;        return hasRRN &amp;&amp; hasPAN;&#xA;    })&#xA;    .GroupBy(r =&gt; NormalizeRRN(r[&quot;RRN&quot;].ToString()) + Normalize(r[&quot;C_PAN&quot;].ToString()));&#xA;&#xA;// === Track matched rows ===&#xA;var matchedRows = new HashSet&lt;DataRow&gt;();&#xA;&#xA;foreach (var group in grouped)&#xA;{&#xA;    decimal totalDebit = group.Sum(r =&gt;&#xA;        decimal.TryParse(r[&quot;Debit (TZS)&quot;]?.ToString(), out var d) ? d : 0m);&#xA;&#xA;    decimal totalCredit = group.Sum(r =&gt;&#xA;        decimal.TryParse(r[&quot;Credit (TZS)&quot;]?.ToString(), out var c) ? c : 0m);&#xA;&#xA;    if (totalDebit == totalCredit)&#xA;    {&#xA;        foreach (var row in group)&#xA;        {&#xA;            row[&quot;MATCH&quot;] = true;&#xA;            matchedRows.Add(row);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// === Move matched rows ===&#xA;foreach (var row in matchedRows)&#xA;{&#xA;    dtHistoricalReconTransactionsReportMatched.ImportRow(row);&#xA;}&#xA;&#xA;// === Remove matched rows from source ===&#xA;int removed = 0;&#xA;for (int i = dtHistoricalReconTransactionsReport.Rows.Count - 1; i &gt;= 0; i--)&#xA;{&#xA;    var row = dtHistoricalReconTransactionsReport.Rows[i];&#xA;    if (matchedRows.Contains(row))&#xA;    {&#xA;        dtHistoricalReconTransactionsReport.Rows.RemoveAt(i);&#xA;        removed++;&#xA;    }&#xA;}&#xA;&#xA;// === Summary Logs ===&#xA;Console.WriteLine($&quot;✅ MATCHED: {matchedRows.Count} rows&quot;);&#xA;Console.WriteLine($&quot;🧹 REMOVED from source: {removed} rows&quot;);&#xA;Console.WriteLine($&quot;📊 REMAINING in source: {dtHistoricalReconTransactionsReport.Rows.Count} rows&quot;);&#xA;Console.WriteLine($&quot;⚠️ SKIPPED due to missing RRN or C_PAN: {skipped}&quot;);&#xA;" DisplayName="SELF MATCHING" sap:VirtualizedContainerService.HintSize="518.4,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_69" Language="CSharp">

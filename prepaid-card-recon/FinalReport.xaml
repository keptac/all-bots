            <ui:InvokeCode ContinueOnError="{x:Null}" Code="// EPPlus License Context (required in automation)&#xA;OfficeOpenXml.ExcelPackage.LicenseContext = OfficeOpenXml.LicenseContext.NonCommercial;&#xA;&#xA;try&#xA;{&#xA;    if (dtHistoricalReconTransactionsReport == null || dtHistoricalReconTransactionsReport.Rows.Count == 0)&#xA;        throw new Exception(&quot;The DataTable 'dtHistoricalReconTransactionsReport' is either null or empty.&quot;);&#xA;&#xA;    if (!File.Exists(prepaidCardWorkingsFileName))&#xA;        throw new FileNotFoundException($&quot;The file '{prepaidCardWorkingsFileName}' does not exist.&quot;);&#xA;&#xA;    if (!DateTime.TryParseExact(fromDate, &quot;dd-MM-yyyy&quot;, null, System.Globalization.DateTimeStyles.None, out DateTime fromDateParsed))&#xA;        throw new Exception($&quot;Invalid fromDate value: '{fromDate}'. Expected format: dd-MM-yyyy&quot;);&#xA;&#xA;    using var excelPackage = new ExcelPackage(new FileInfo(prepaidCardWorkingsFileName));&#xA;    var ws = excelPackage.Workbook.Worksheets.FirstOrDefault(s =&gt; s.Name == &quot;UNMATCHED&quot;)&#xA;             ?? excelPackage.Workbook.Worksheets.Add(&quot;UNMATCHED&quot;);&#xA;&#xA;    string[] headers = new[]&#xA;    {&#xA;        &quot;SNO&quot;, &quot;Branch code&quot;, &quot;GL_Code&quot;, &quot;GL Description&quot;, &quot;Booking Date&quot;, &quot;Value Date&quot;,&#xA;        &quot;Transaction Ref No:&quot;, &quot;Narration&quot;, &quot;Debit (TZS)&quot;, &quot;Credit (TZS)&quot;, &quot;RRN&quot;, &quot;Search Key&quot;&#xA;    };&#xA;&#xA;    int totalCols = headers.Length;&#xA;    var filteredRows = dtHistoricalReconTransactionsReport.AsEnumerable()&#xA;        .Where(dr =&gt; DateTime.TryParse(dr[&quot;Booking Date&quot;]?.ToString(), out var bd) &amp;&amp; bd &gt; fromDateParsed)&#xA;        .ToList();&#xA;&#xA;    int rowCount = filteredRows.Count;&#xA;    if (rowCount == 0)&#xA;    {&#xA;        Console.WriteLine(&quot;✅ No records after filtering by date.&quot;);&#xA;        return;&#xA;    }&#xA;&#xA;    // === Write headers ===&#xA;    for (int i = 0; i &lt; totalCols; i++)&#xA;    {&#xA;        ws.Cells[1, i + 2].Value = headers[i];&#xA;        ws.Cells[1, i + 2].Style.Font.Bold = true;&#xA;    }&#xA;&#xA;    // === Prepare data buffer ===&#xA;    object[,] buffer = new object[rowCount, totalCols];&#xA;&#xA;    for (int i = 0; i &lt; rowCount; i++)&#xA;    {&#xA;        var dr = filteredRows[i];&#xA;        int col = 0;&#xA;&#xA;        buffer[i, col++] = dr[&quot;SNO&quot;];&#xA;        buffer[i, col++] = dr[&quot;Branch code&quot;];&#xA;        buffer[i, col++] = dr[&quot;GL_Code&quot;];&#xA;        buffer[i, col++] = dr[&quot;GL Description&quot;];&#xA;&#xA;        buffer[i, col++] = SafeParseDate(dr[&quot;Booking Date&quot;]);&#xA;        buffer[i, col++] = SafeParseDate(dr[&quot;Value Date&quot;]);&#xA;&#xA;        buffer[i, col++] = dr[&quot;Transaction Ref No:&quot;];&#xA;        buffer[i, col++] = dr[&quot;Narration&quot;];&#xA;        buffer[i, col++] = Math.Round(ParseDecimal(dr[&quot;Debit (TZS)&quot;]), 2);&#xA;        buffer[i, col++] = Math.Round(ParseDecimal(dr[&quot;Credit (TZS)&quot;]), 2);&#xA;        buffer[i, col++] = dr[&quot;RRN&quot;];&#xA;        buffer[i, col++] = dr[&quot;Search Key&quot;];&#xA;    }&#xA;&#xA;    // === Bulk write from buffer ===&#xA;    ws.Cells[2, 2].LoadFromArrays(ToJagged(buffer));&#xA;&#xA;    // === Number formatting for Debit/Credit ===&#xA;    ws.Column(10).Style.Numberformat.Format = &quot;#,##0.00;[Red]-#,##0.00&quot;;&#xA;    ws.Column(11).Style.Numberformat.Format = &quot;#,##0.00;[Red]-#,##0.00&quot;;&#xA;&#xA;    // === Date formatting for Booking/Value Date ===&#xA;    ws.Column(6).Style.Numberformat.Format = &quot;dd-mmm-yyyy&quot;;&#xA;    ws.Column(7).Style.Numberformat.Format = &quot;dd-mmm-yyyy&quot;;&#xA;&#xA;    // AutoFit only for headers&#xA;    for (int i = 2; i &lt; 2 + totalCols; i++)&#xA;    {&#xA;        ws.Column(i).AutoFit(1, 1);&#xA;    }&#xA;&#xA;    excelPackage.Save();&#xA;    Console.WriteLine($&quot;✅ Total filtered prepaid rows written: {rowCount}&quot;);&#xA;}&#xA;catch (Exception ex)&#xA;{&#xA;    Console.WriteLine($&quot;❌ ERROR: {ex.Message}&quot;);&#xA;}&#xA;&#xA;// === Helpers ===&#xA;decimal ParseDecimal(object value)&#xA;{&#xA;    if (value == null || value == DBNull.Value) return 0m;&#xA;    return decimal.TryParse(value.ToString(), out var result) ? result : 0m;&#xA;}&#xA;&#xA;object SafeParseDate(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return DBNull.Value;&#xA;    return DateTime.TryParse(val.ToString(), out var dt) ? dt : DBNull.Value;&#xA;}&#xA;&#xA;object[][] ToJagged(object[,] data)&#xA;{&#xA;    int rows = data.GetLength(0), cols = data.GetLength(1);&#xA;    object[][] jagged = new object[rows][];&#xA;    for (int i = 0; i &lt; rows; i++)&#xA;    {&#xA;        jagged[i] = new object[cols];&#xA;        for (int j = 0; j &lt; cols; j++)&#xA;            jagged[i][j] = data[i, j];&#xA;    }&#xA;    return jagged;&#xA;}&#xA;" DisplayName="UNMATCHED dtHistoricalReconTransactionsReport" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_79" Language="CSharp">

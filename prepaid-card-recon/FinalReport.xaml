ey(rawKey);&#xA;    }&#xA;    catch (Exception ex)&#xA;    {&#xA;        // Optional error handling&#xA;        // Console.WriteLine($&quot;Search Key Error: {ex.Message}&quot;);&#xA;        row[&quot;Search Key&quot;] = DBNull.Value;&#xA;    }&#xA;}" DisplayName="add Search Key dtHistoricalReconTransactionsReport" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_82" Language="CSharp">

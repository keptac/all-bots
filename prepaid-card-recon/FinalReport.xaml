            <ui:InvokeCode ContinueOnError="{x:Null}" Code="try&#xA;{&#xA;    if (!File.Exists(prepaidCardWorkingsFileName))&#xA;        throw new FileNotFoundException($&quot;The file '{prepaidCardWorkingsFileName}' does not exist.&quot;);&#xA;&#xA;    // === Step 1: Remove unwanted columns ===&#xA;    var columnsToRemove = new HashSet&lt;string&gt;(StringComparer.OrdinalIgnoreCase)&#xA;    {&#xA;        &quot;Aging&quot;, &quot;Aging Group&quot;, &quot;BOT Classification&quot;, &quot;Root Cause&quot;, &quot;Root Cause Category&quot;,&#xA;        &quot;Recommended Action&quot;, &quot;Action Owner&quot;, &quot;Column19&quot;, &quot;Column20&quot;, &quot;Column21&quot;, &quot;Column22&quot;,&#xA;        &quot;Column23&quot;, &quot;Column24&quot;, &quot;Column25&quot;, &quot;Column26&quot;, &quot;SNO&quot;, &quot;Branch code&quot;, &quot;GL_Code&quot;,&#xA;        &quot;GL Description&quot;, &quot;Balance&quot;, &quot;Related Account&quot;, &quot;Instr No&quot;&#xA;    };&#xA;&#xA;    for (int i = dtHistoricalReconTransactionsReportMatched.Columns.Count - 1; i &gt;= 0; i--)&#xA;    {&#xA;        var col = dtHistoricalReconTransactionsReportMatched.Columns[i];&#xA;        if (columnsToRemove.Contains(col.ColumnName))&#xA;            dtHistoricalReconTransactionsReportMatched.Columns.RemoveAt(i);&#xA;    }&#xA;&#xA;    // === Step 2: Group by C_PAN and calculate totals ===&#xA;    var panTotals = new Dictionary&lt;string, (decimal debit, decimal credit)&gt;(capacity: 1000000);&#xA;    var rowGroups = new Dictionary&lt;string, List&lt;DataRow&gt;&gt;(capacity: 1000000);&#xA;    foreach (DataRow row in dtHistoricalReconTransactionsReportMatched.Rows)&#xA;    {&#xA;        string cpan = row[&quot;C_PAN&quot;]?.ToString();&#xA;        if (string.IsNullOrWhiteSpace(cpan) || cpan == &quot;MISSING_PAN&quot;)&#xA;            continue;&#xA;&#xA;        decimal debit = ParseDecimal(row[&quot;Debit (TZS)&quot;]);&#xA;        decimal credit = ParseDecimal(row[&quot;Credit (TZS)&quot;]);&#xA;&#xA;        if (panTotals.TryGetValue(cpan, out var totals))&#xA;        {&#xA;            panTotals[cpan] = (totals.debit + debit, totals.credit + credit);&#xA;            rowGroups[cpan].Add(row);&#xA;        }&#xA;        else&#xA;        {&#xA;            panTotals[cpan] = (debit, credit);&#xA;            rowGroups[cpan] = new List&lt;DataRow&gt; { row };&#xA;        }&#xA;    }&#xA;&#xA;    // === Step 3: Find unmatched ===&#xA;    var unmatched = new List&lt;DataRow&gt;(100000);&#xA;    foreach (var kv in panTotals)&#xA;    {&#xA;        if (Math.Round(kv.Value.debit, 2) != Math.Round(kv.Value.credit, 2))&#xA;            unmatched.AddRange(rowGroups[kv.Key]);&#xA;    }&#xA;&#xA;    if (unmatched.Count == 0)&#xA;    {&#xA;        Console.WriteLine(&quot;✅ No unmatched C_PAN found.&quot;);&#xA;        return;&#xA;    }&#xA;&#xA;    // === Step 4: Prepare export table ===&#xA;    string[] headers = {&#xA;        &quot;Booking Date&quot;, &quot;Value Date&quot;, &quot;C_PAN&quot;, &quot;RRN&quot;, &quot;STAN&quot;,&#xA;        &quot;Debit (TZS)&quot;, &quot;Credit (TZS)&quot;, &quot;Narration&quot;, &quot;Transaction Ref No:&quot;,&#xA;        &quot;EXTRACTED_TERMINAL_ID&quot;, &quot;AUTHORIZATION_NUMBER&quot;, &quot;C_PAN_AMOUNT&quot;, &quot;source&quot;, &quot;Search Key&quot;&#xA;    };&#xA;&#xA;    var exportTable = new DataTable();&#xA;    foreach (var col in headers)&#xA;        exportTable.Columns.Add(col);&#xA;&#xA;    foreach (var row in unmatched)&#xA;    {&#xA;        var newRow = exportTable.NewRow();&#xA;&#xA;        newRow[&quot;Booking Date&quot;] = SafeParseDate(row[&quot;Booking Date&quot;]);&#xA;        newRow[&quot;Value Date&quot;] = SafeParseDate(row[&quot;Value Date&quot;]);&#xA;        newRow[&quot;C_PAN&quot;] = row[&quot;C_PAN&quot;];&#xA;        newRow[&quot;RRN&quot;] = row[&quot;RRN&quot;];&#xA;        newRow[&quot;STAN&quot;] = row[&quot;STAN&quot;];&#xA;&#xA;        decimal credit = ParseDecimal(row[&quot;Credit (TZS)&quot;]);&#xA;        decimal debit = ParseDecimal(row[&quot;Debit (TZS)&quot;]);&#xA;&#xA;        if (credit &lt; 0)&#xA;        {&#xA;            debit += Math.Abs(credit);&#xA;            credit = 0.00m;&#xA;        }&#xA;        if (debit &lt; 0) debit = Math.Abs(debit);&#xA;&#xA;        newRow[&quot;Debit (TZS)&quot;] = debit;&#xA;        newRow[&quot;Credit (TZS)&quot;] = credit;&#xA;&#xA;        newRow[&quot;Narration&quot;] = row[&quot;Narration&quot;];&#xA;        newRow[&quot;Transaction Ref No:&quot;] = row[&quot;Transaction Ref No:&quot;];&#xA;&#xA;        newRow[&quot;EXTRACTED_TERMINAL_ID&quot;] = row.Table.Columns.Contains(&quot;EXTRACTED_TERMINAL_ID&quot;) ? row[&quot;EXTRACTED_TERMINAL_ID&quot;] : &quot;&quot;;&#xA;        newRow[&quot;AUTHORIZATION_NUMBER&quot;] = row.Table.Columns.Contains(&quot;AUTHORIZATION_NUMBER&quot;) ? row[&quot;AUTHORIZATION_NUMBER&quot;] : &quot;&quot;;&#xA;        newRow[&quot;C_PAN_AMOUNT&quot;] = row.Table.Columns.Contains(&quot;C_PAN_AMOUNT&quot;) ? row[&quot;C_PAN_AMOUNT&quot;] : &quot;&quot;;&#xA;        newRow[&quot;source&quot;] = row.Table.Columns.Contains(&quot;source&quot;) ? row[&quot;source&quot;] : &quot;&quot;;&#xA;        newRow[&quot;Search Key&quot;] = row.Table.Columns.Contains(&quot;Search Key&quot;) ? row[&quot;Search Key&quot;] : &quot;&quot;;&#xA;&#xA;        exportTable.Rows.Add(newRow);&#xA;    }&#xA;&#xA;    // === Step 5: Export to Excel using ClosedXML ===&#xA;    using var workbook = new XLWorkbook(prepaidCardWorkingsFileName);&#xA;    var worksheet = workbook.Worksheets.FirstOrDefault(ws =&gt; ws.Name == &quot;ALL MATCHED&quot;)&#xA;                     ?? workbook.AddWorksheet(&quot;ALL MATCHED&quot;);&#xA;&#xA;    worksheet.Cell(1, 1).InsertTable(exportTable, &quot;UnmatchedReport&quot;, true);&#xA;&#xA;    // Bulk formatting&#xA;    worksheet.Column(6).Style.NumberFormat.Format = &quot;#,##0.00&quot;; // Debit&#xA;    worksheet.Column(7).Style.NumberFormat.Format = &quot;#,##0.00&quot;; // Credit&#xA;    worksheet.Column(1).Style.DateFormat.Format = &quot;dd-MMM-yyyy&quot;; // Booking Date&#xA;    worksheet.Column(2).Style.DateFormat.Format = &quot;dd-MMM-yyyy&quot;; // Value Date&#xA;&#xA;    // Autofit headers only (avoids autofitting 1 million rows)&#xA;    for (int i = 1; i &lt;= headers.Length; i++)&#xA;        worksheet.Column(i).AdjustToContents(1, 1); // Only fit header row&#xA;&#xA;    workbook.Save();&#xA;&#xA;    Console.WriteLine($&quot;✅ Unmatched C_PAN report generated: {unmatched.Count} rows.&quot;);&#xA;}&#xA;catch (Exception ex)&#xA;{&#xA;    Console.WriteLine(&quot;❌ Error: &quot; + ex.Message);&#xA;}&#xA;&#xA;// === Helpers ===&#xA;decimal ParseDecimal(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return 0m;&#xA;    return decimal.TryParse(val.ToString(), out var d) ? d : 0m;&#xA;}&#xA;&#xA;object SafeParseDate(object val)&#xA;{&#xA;    if (val == null || val == DBNull.Value) return DBNull.Value;&#xA;    return DateTime.TryParse(val.ToString(), out var dt) ? dt : DBNull.Value;&#xA;}&#xA;" DisplayName="Excel write &quot;ALL MATCHED&quot;" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_27" Language="CSharp">

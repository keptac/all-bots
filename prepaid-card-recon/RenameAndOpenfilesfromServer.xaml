              <ui:InvokeCode ContinueOnError="{x:Null}" Code="try&#xD;&#xA;{&#xD;&#xA;    // === Register encoding provider (safe for UiPath) ===&#xD;&#xA;    var providerType = Type.GetType(&quot;System.Text.CodePagesEncodingProvider, System.Text.Encoding.CodePages&quot;);&#xD;&#xA;    if (providerType != null)&#xD;&#xA;    {&#xD;&#xA;        var instanceProp = providerType.GetProperty(&quot;Instance&quot;);&#xD;&#xA;        var instance = instanceProp.GetValue(null);&#xD;&#xA;        var registerMethod = typeof(System.Text.Encoding).GetMethod(&quot;RegisterProvider&quot;);&#xD;&#xA;        registerMethod.Invoke(null, new[] { instance });&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    string fileNameOnly = currentFile.Name.ToLower();&#xD;&#xA;    classification = &quot;&quot;; // OUT result&#xD;&#xA;&#xD;&#xA;    // === Step 0: Rename single sheet to &quot;Data sheet1&quot; ===&#xD;&#xA;    using (var package = new OfficeOpenXml.ExcelPackage(new FileInfo(currentFile.FullName)))&#xD;&#xA;    {&#xD;&#xA;        if (package.Workbook.Worksheets.Count == 1)&#xD;&#xA;        {&#xD;&#xA;            var ws = package.Workbook.Worksheets[0];&#xD;&#xA;            ws.Name = &quot;Data sheet1&quot;;&#xD;&#xA;            package.Save();&#xD;&#xA;            Console.WriteLine($&quot;🔁 Renamed single sheet to 'Data sheet1': {currentFile.Name}&quot;);&#xD;&#xA;&#xD;&#xA;            // === Classification logic (same as merged path) ===&#xD;&#xA;            var dt = new DataTable();&#xD;&#xA;            var cells = ws.Cells;&#xD;&#xA;            bool hasHeader = true;&#xD;&#xA;&#xD;&#xA;            for (int col = ws.Dimension.Start.Column; col &lt;= ws.Dimension.End.Column; col++)&#xD;&#xA;                dt.Columns.Add(hasHeader ? cells[1, col].Text : $&quot;Column{col}&quot;);&#xD;&#xA;&#xD;&#xA;            for (int row = 2; row &lt;= ws.Dimension.End.Row; row++)&#xD;&#xA;            {&#xD;&#xA;                var dataRow = dt.NewRow();&#xD;&#xA;                for (int col = ws.Dimension.Start.Column; col &lt;= ws.Dimension.End.Column; col++)&#xD;&#xA;                    dataRow[col - 1] = cells[row, col].Text;&#xD;&#xA;&#xD;&#xA;                dt.Rows.Add(dataRow);&#xD;&#xA;            }&#xD;&#xA;&#xD;&#xA;            int rowCount = dt.Rows.Count;&#xD;&#xA;&#xD;&#xA;            if (fileNameOnly.Contains(&quot;posted transaction details&quot;) || fileNameOnly.Contains(&quot;transaction report&quot;))&#xD;&#xA;            {&#xD;&#xA;                if (dt.Columns.Contains(&quot;Product Type&quot;))&#xD;&#xA;                {&#xD;&#xA;                    for (int i = 0; i &lt; Math.Min(rowCount, 10); i++)&#xD;&#xA;                    {&#xD;&#xA;                        string value = dt.Rows[i][&quot;Product Type&quot;]?.ToString().Trim().ToUpper();&#xD;&#xA;                        if (value == &quot;CREDIT&quot;) { classification = &quot;CREDIT&quot;; break; }&#xD;&#xA;                        else if (!string.IsNullOrWhiteSpace(value)) { classification = &quot;PREPAID&quot;; break; }&#xD;&#xA;                    }&#xD;&#xA;                }&#xD;&#xA;            }&#xD;&#xA;            else if (fileNameOnly.Contains(&quot;account balance and status report&quot;))&#xD;&#xA;            {&#xD;&#xA;                if (dt.Columns.Contains(&quot;Device Number&quot;))&#xD;&#xA;                {&#xD;&#xA;                    for (int i = 0; i &lt; Math.Min(rowCount, 10); i++)&#xD;&#xA;                    {&#xD;&#xA;                        string value = dt.Rows[i][&quot;Device Number&quot;]?.ToString().Trim();&#xD;&#xA;                        if (value.StartsWith(&quot;550558&quot;)) { classification = &quot;PREPAID&quot;; break; }&#xD;&#xA;                        else if (!string.IsNullOrWhiteSpace(value)) { classification = &quot;CREDIT&quot;; break; }&#xD;&#xA;                    }&#xD;&#xA;                }&#xD;&#xA;            }&#xD;&#xA;&#xD;&#xA;            if (string.IsNullOrEmpty(classification))&#xD;&#xA;            {&#xD;&#xA;                Console.W
      <ui:InvokeCode ContinueOnError="{x:Null}" Code="&#xA;&#xA;Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);&#xA;&#xA;string today = DateTime.Today.ToString(&quot;yyyy-MM-dd&quot;);&#xA;&#xA;// Create working directory e.g., UNSORTED/yyyy-MM-dd&#xA;string workingPath = Path.Combine(targetWorking, today);&#xA;Directory.CreateDirectory(workingPath);&#xA;&#xA;// Update targetWorking so that caller can pick up final folder&#xA;targetWorking = workingPath;&#xA;&#xA;string[] prefixes = new[] { &quot;TT2H4T0&quot;, &quot;TT2L2T0&quot;, &quot;TT2P2T0&quot; };&#xA;&#xA;foreach (string prefix in prefixes)&#xA;{&#xA;    var matchingFiles = Directory.GetFiles(sourceDirectory, prefix + &quot;*&quot;, SearchOption.TopDirectoryOnly)&#xA;        .OrderByDescending(f =&gt; File.GetLastWriteTime(f))&#xA;        .Take(2)&#xA;        .ToList();&#xA;&#xA;    foreach (var originalFile in matchingFiles)&#xA;    {&#xA;        string file = originalFile;&#xA;        string fileName = Path.GetFileName(file);&#xA;&#xA;        // Rename to .xlsx if needed&#xA;        if (!file.EndsWith(&quot;.xlsx&quot;, StringComparison.OrdinalIgnoreCase))&#xA;        {&#xA;            string newFilePath = Path.Combine(Path.GetDirectoryName(file), Path.GetFileNameWithoutExtension(file) + &quot;.xlsx&quot;);&#xA;&#xA;            try&#xA;            {&#xA;                File.Move(file, newFilePath, true);&#xA;                file = newFilePath;&#xA;                fileName = Path.GetFileName(file);&#xA;                Console.WriteLine($&quot;🔁 Renamed extension: {fileName}&quot;);&#xA;            }&#xA;            catch (Exception ex)&#xA;            {&#xA;                Console.WriteLine($&quot;❌ Rename failed for {file}: {ex.Message}&quot;);&#xA;                continue;&#xA;            }&#xA;        }&#xA;&#xA;        // Determine final name&#xA;        string renamedFileName;&#xA;        if (fileName.ToUpper().StartsWith(&quot;TT2P2T0&quot;))&#xA;            renamedFileName = &quot;Posted Transaction Details.xlsx&quot;;&#xA;        else if (fileName.ToUpper().StartsWith(&quot;TT2L2T0&quot;))&#xA;            renamedFileName = &quot;Transaction Report.xlsx&quot;;&#xA;        else if (fileName.ToUpper().StartsWith(&quot;TT2H4T0&quot;))&#xA;            renamedFileName = &quot;Account Balance And Status Report.xlsx&quot;;&#xA;        else&#xA;            renamedFileName = fileName; // fallback&#xA;&#xA;        string workingDestPath = Path.Combine(workingPath, renamedFileName);&#xA;&#xA;        // If file already exists, append _TWO before extension&#xA;        if (File.Exists(workingDestPath))&#xA;        {&#xA;            string nameOnly = Path.GetFileNameWithoutExtension(renamedFileName);&#xA;            string ext = Path.GetExtension(renamedFileName);&#xA;            string altName = nameOnly + &quot;_TWO&quot; + ext;&#xA;            workingDestPath = Path.Combine(workingPath, altName);&#xA;            Console.WriteLine($&quot;⚠️ File exists — saving second copy as: {altName}&quot;);&#xA;        }&#xA;&#xA;        try&#xA;        {&#xA;            File.Copy(file, workingDestPath, true);&#xA;            Console.WriteLine($&quot;✅ Copied to working folder as: {Path.GetFileName(workingDestPath)}&quot;);&#xA;        }&#xA;        catch (Exception ex)&#xA;        {&#xA;            Console.WriteLine($&quot;❌ Failed to copy to working folder: {ex.Message}&quot;);&#xA;        }&#xA;    }&#xA;}&#xA;" DisplayName="Copy Files" sap:VirtualizedContainerService.HintSize="483.2,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_4" Language="CSharp">

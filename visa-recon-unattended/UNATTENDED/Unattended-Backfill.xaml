    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Each process (name|currency) keeps its own last balanced date, so a day lost to&#xA;' one missing statement no longer holds the others back. A scheduled run (no&#xA;' RangeStart) starts the day after the furthest-behind process; a process already&#xA;' past a day is held on it rather than re-run. No dates on record = run as before.&#xA;Dim ci = System.Globalization.CultureInfo.InvariantCulture&#xA;markerPath = System.IO.Path.GetFullPath(&quot;Templates\last_balanced_dates.txt&quot;)&#xA;Dim legacyPath As String = System.IO.Path.GetFullPath(&quot;Templates\last_balanced_date.txt&quot;)&#xA;' The rows Unattended-Entry.xaml puts in the tracker for every date.&#xA;processKeys = New List(Of String) From {&quot;visaPosClearing|840&quot;, &quot;visaPosClearing|834&quot;, &quot;visaAtmClearing|TZS&quot;}&#xA;lastBalanced = New Dictionary(Of String, DateTime)&#xA;stalled = New List(Of String)&#xA;resumeMode = False&#xA;Dim readNote As String = &quot;&quot;&#xA;Try&#xA;    If System.IO.File.Exists(markerPath) Then&#xA;        For Each ln As String In System.IO.File.ReadAllLines(markerPath)&#xA;            Dim eq As Integer = ln.LastIndexOf(&quot;=&quot;c)&#xA;            Dim lb As DateTime&#xA;            If eq &gt; 0 AndAlso DateTime.TryParseExact(ln.Substring(eq + 1).Trim(), &quot;yyyy-MM-dd&quot;, ci, System.Globalization.DateTimeStyles.None, lb) Then&#xA;                lastBalanced(ln.Substring(0, eq).Trim()) = lb&#xA;            ElseIf ln.Trim() &lt;&gt; &quot;&quot; Then&#xA;                readNote = readNote &amp; &quot; unreadable line '&quot; &amp; ln &amp; &quot;';&quot;&#xA;            End If&#xA;        Next&#xA;    ElseIf System.IO.File.Exists(legacyPath) Then&#xA;        ' One-off upgrade from the single shared marker.&#xA;        Dim txt As String = System.IO.File.ReadAllText(legacyPath).Trim()&#xA;        Dim lb As DateTime&#xA;        If DateTime.TryParseExact(txt, &quot;yyyy-MM-dd&quot;, ci, System.Globalization.DateTimeStyles.None, lb) Then&#xA;            For Each k As String In processKeys&#xA;                lastBalanced(k) = lb&#xA;            Next&#xA;            readNote = &quot; every process seeded from &quot; &amp; legacyPath &amp; &quot;;&quot;&#xA;        Else&#xA;            readNote = &quot; &quot; &amp; legacyPath &amp; &quot; unreadable ('&quot; &amp; txt &amp; &quot;');&quot;&#xA;        End If&#xA;    End If&#xA;Catch ex As Exception&#xA;    lastBalanced.Clear()&#xA;    readNote = &quot; could not be read (&quot; &amp; ex.Message &amp; &quot;);&quot;&#xA;End Try&#xA;For Each k As String In lastBalanced.Keys.ToList()&#xA;    If Not processKeys.Contains(k) Then processKeys.Add(k)&#xA;    ' Too stale to replay safely; forget it so the next balanced day re-seeds it.&#xA;    If (endD - lastBalanced(k)).TotalDays &gt; 31 Then&#xA;        readNote = readNote &amp; &quot; &quot; &amp; k &amp; &quot; &quot; &amp; lastBalanced(k).ToString(&quot;yyyy-MM-dd&quot;) &amp; &quot; is more than 31 days back - dropped;&quot;&#xA;        lastBalanced.Remove(k)&#xA;    End If&#xA;Next&#xA;resumeNote = &quot;last balanced &quot; &amp; If(lastBalanced.Count = 0, &quot;(none)&quot;, String.Join(&quot;, &quot;, lastBalanced.Select(Function(kv) kv.Key &amp; &quot;=&quot; &amp; kv.Value.ToString(&quot;yyyy-MM-dd&quot;)))) &amp; &quot; |&quot; &amp; readNote&#xA;If Not String.IsNullOrWhiteSpace(RangeStart) Then&#xA;    resumeNote = &quot;explicit RangeStart given - not resuming | &quot; &amp; resumeNote&#xA;ElseIf lastBalanced.Count = 0 Then&#xA;    resumeNote = resumeNote &amp; &quot; nothing on record (&quot; &amp; markerPath &amp; &quot;) - running as before&quot;&#xA;Else&#xA;    Dim earliest As DateTime = lastBalanced.Values.Min()&#xA;    If earliest &lt; endD Then&#xA;        d = earliest.AddDays(1)&#xA;        resumeMode = True&#xA;        resumeNote = resumeNote &amp; &quot; resuming from &quot; &amp; d.ToString(&quot;yyyy-MM-dd&quot;) &amp; &quot; (&quot; &amp; (CInt((endD - d).TotalDays) + 1).ToString() &amp; &quot; day(s)); a process already past a day is held on it&quot;&#xA;    Else&#xA;        resumeNote = resumeNote &amp; &quot; nothing to catch up&quot;&#xA;    End If&#xA;End If" DisplayName="Resume from last balanced date" sap:VirtualizedContainerService.HintSize="496.6666666666667,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_110">

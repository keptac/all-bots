        <ui:InvokeCode ContinueOnError="{x:Null}" Code="' A process sits this day out when it is already balanced past it, or when an&#xA;' earlier day of this catch-up left it unbalanced (it must not jump that gap).&#xA;Dim held As New List(Of String)&#xA;If resumeMode Then&#xA;    For Each k As String In processKeys&#xA;        If (lastBalanced.ContainsKey(k) AndAlso lastBalanced(k) &gt;= d) OrElse stalled.Contains(k) Then held.Add(k)&#xA;    Next&#xA;End If&#xA;heldKeys = String.Join(&quot;;&quot;, held)&#xA;skipDay = resumeMode AndAlso processKeys.All(Function(k) held.Contains(k))" DisplayName="Which processes sit this day out" sap:VirtualizedContainerService.HintSize="416,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_112">

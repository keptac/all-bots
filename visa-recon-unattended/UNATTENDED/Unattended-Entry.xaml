    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim ci = System.Globalization.CultureInfo.InvariantCulture&#xA;Dim tDate As Date = Date.ParseExact(trackerDate, &quot;dd/MMM/yyyy&quot;, ci)&#xA;&#xA;If dtProcessTracker Is Nothing OrElse dtProcessTracker.Columns.Count = 0 Then&#xA;    dtProcessTracker = dtTempProcessTracker.Copy()&#xA;Else&#xA;    ' a new month starts the tracker over&#xA;    Dim doomed As New List(Of System.Data.DataRow)&#xA;    For Each r As System.Data.DataRow In dtProcessTracker.Rows&#xA;        Dim rd As Date&#xA;        If Date.TryParseExact(r(&quot;Date&quot;).ToString().Trim(), &quot;dd/MMM/yyyy&quot;, ci, System.Globalization.DateTimeStyles.None, rd) Then&#xA;            If rd.Year &lt;&gt; tDate.Year OrElse rd.Month &lt;&gt; tDate.Month Then&#xA;                doomed.Add(r)&#xA;            End If&#xA;        Else&#xA;            doomed.Add(r)&#xA;        End If&#xA;    Next&#xA;    For Each r As System.Data.DataRow In doomed&#xA;        dtProcessTracker.Rows.Remove(r)&#xA;    Next&#xA;&#xA;    ' add this date's rows only if they are not already there&#xA;    Dim alreadyHere As Integer = 0&#xA;    For Each r As System.Data.DataRow In dtProcessTracker.Rows&#xA;        If r(&quot;Date&quot;).ToString().Trim() = trackerDate Then&#xA;            alreadyHere = alreadyHere + 1&#xA;        End If&#xA;    Next&#xA;    If alreadyHere = 0 Then&#xA;        For Each src As System.Data.DataRow In dtTempProcessTracker.Rows&#xA;            Dim nr As System.Data.DataRow = dtProcessTracker.NewRow()&#xA;            For Each c As System.Data.DataColumn In dtTempProcessTracker.Columns&#xA;                If dtProcessTracker.Columns.Contains(c.ColumnName) Then&#xA;                    nr(c.ColumnName) = src(c.ColumnName)&#xA;                End If&#xA;            Next&#xA;            dtProcessTracker.Rows.Add(nr)&#xA;        Next&#xA;    End If&#xA;End If" DisplayName="Tracker - month reset and ensure rows" sap:VirtualizedContainerService.HintSize="536.666666
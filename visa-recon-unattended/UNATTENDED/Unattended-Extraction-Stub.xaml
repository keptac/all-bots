              <ui:ExecuteQuery ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="change back to -1" CommandType="Text" DataTable="[dtCbsStatementResult]" DisplayName="Run query" ExistingDbConnection="[DBConnectionString]" sap:VirtualizedContainerService.HintSize="432.6666666666667,151.33333333333334" sap2010:WorkflowViewState.IdRef="ExecuteQuery_1" Sql="[&quot;SELECT *&#xA;FROM OPENQUERY(CBS,'&#xA;WITH PARAMS AS&#xA;(&#xA;    SELECT&#xA;       ''&quot;+currency+&quot;''  CURRENCY,&#xA;        ''&quot;+glCode+&quot;''      GL_CODE,&#xA;        TO_DATE(''&quot;+glFromDate+&quot;'', ''YYYYMMDD'') AS P_FROM_DATE,&#xA;        TO_DATE(''&quot;+glToDate+&quot;'', ''YYYYMMDD'') AS P_TO_DATE&#xA;    FROM DUAL&#xA;),&#xA;OPENING_BAL AS&#xA;(&#xA;    SELECT&#xA;        0 ROWNUMBERKB,&#xA;        P.P_FROM_DATE BOOKINGDATE,&#xA;        NULL TRN_REF_NO,&#xA;        NULL VALUEDATE,&#xA;        NULL TRN_CODE,&#xA;        ''SYSTEM'' TRANSACTIONMAKER,&#xA;        ''OPENING BALANCE'' NARRATION,&#xA;        NULL REL_ACCT,&#xA;        0 DEBIT,&#xA;        0 CREDIT,&#xA;        NULL INSTR_NO,&#xA;        NVL(SUM(DECODE(H.DRCR_IND,''D'',-1,1)*DECODE(H.AC_CCY,''TZS'',H.LCY_AMOUNT,H.FCY_AMOUNT)),0) BALANCE,&#xA;        NULL AUTHSATUS,&#xA;        NULL BRANCH_CODE,&#xA;        NULL BRANCH_NAME,&#xA;        NULL ADDRESS,&#xA;        NULL ACCOUNT_NO,&#xA;        NULL GL_DESC,&#xA;        NULL ACCOUNT_CCY,&#xA;        NULL P_FROM_DATE,&#xA;        NULL P_TO_DATE,&#xA;        NULL OWNER_ID&#xA;    FROM PARAMS P,FCUBS147.ACZB_HISTORY H&#xA;    WHERE H.AC_NO = P.GL_CODE&#xA;      AND H.AC_CCY = P.CURRENCY&#xA;      AND H.TRN_DT &lt; P.P_FROM_DATE&#xA;    GROUP BY&#xA;        P.P_FROM_DATE&#xA;),&#xA; &#xA;TXNS AS&#xA;(&#xA; &#xA;SELECT ROW_NUMBER() OVER (PARTITION BY A.AC_NO ORDER BY A.AC_ENTRY_SR_NO) ROW_NUM,&#xA;       A.TRN_DT     BKG_DATE,&#xA;       A.VALUE_DT   VALUE_DATE,&#xA;       A.TRN_REF_NO,&#xA;       A.TRN_CODE,&#xA;       A.USER_ID || '' - '' || SU.USER_NAME TRANSACTIONMAKER,&#xA;      TRN_DESC||'' - ''|| (SELECT   fcubs147.ACPKS_STMT_NARRATION_CUSTOM.FN_GET_NARRATIVE( A.AC_ENTRY_SR_NO) from dual) NARRATION,&#xA;       A.INSTRUMENT_CODE INSTR_NO,&#xA;       NVL(A.RELATED_ACCOUNT, A.RELATED_REFERENCE) RELATED_ACCOUNT,&#xA;       DECODE(A.DRCR_IND, ''D'',DECODE(A.AC_CCY, ''TZS'', A.LCY_AMOUNT, A.FCY_AMOUNT), 0) DEBIT,&#xA;       DECODE(A.DRCR_IND,''C'',DECODE(A.AC_CCY, ''TZS'', A.LCY_AMOUNT, A.FCY_AMOUNT), 0) CREDIT,&#xA;       DECODE(A.DRCR_IND, ''D'',  -DECODE(A.AC_CCY, ''TZS'', A.LCY_AMOUNT, A.FCY_AMOUNT), &#xA;       DECODE(A.AC_CCY, ''TZS'', A.LCY_AMOUNT, A.FCY_AMOUNT)) MOVEMENT,&#xA;       DECODE(A.AUTH_STAT, ''A'', NULL, ''*'') AUTH_STAT,&#xA;       A.AC_BRANCH BRANCH_CODE,&#xA;       A.AC_CCY,&#xA;       SB.BRANCH_NAME&#xA;FROM FCUBS147.ACVW_ALL_AC_ENTRIES A&#xA;  LEFT JOIN FCUBS147.SMTB_USER SU&#xA;    ON SU.USER_ID = A.USER_ID&#xA;  LEFT JOIN FCUBS147.STTM_TRN_CODE TC&#xA;    ON TC.TRN_CODE = A.TRN_CODE&#xA;  LEFT JOIN FCUBS147.STZM_BRANCH SB&#xA;    ON SB.BRANCH_CODE = A.AC_BRANCH&#xA;CROSS JOIN PARAMS P&#xA; &#xA;WHERE A.AC_NO = P.GL_CODE&#xA;   AND A.AC_CCY = P.CURRENCY&#xA;   AND A.CUST_GL = ''G''&#xA;   AND A.TRN_DT BETWEEN P.P_FROM_DATE AND P.P_TO_DATE),&#xA; &#xA;CLOSING_BAL AS&#xA;(&#xA;    SELECT&#xA;        999999 ROWNUMBERKB,&#xA;        P.P_TO_DATE BOOKINGDATE,&#xA;        NULL TRN_REF_NO,&#xA;        NULL VALUEDATE,&#xA;        NULL TRN_CODE,&#xA;        ''SYSTEM'' TRANSACTIONMAKER,&#xA;        ''CLOSING BALANCE'' NARRATION,&#xA;        NULL REL_ACCT,&#xA;        0 DEBIT,&#xA;        0 CREDIT,&#xA;        NULL INSTR_NO,&#xA;        NVL(SUM(DECODE(H.DRCR_IND,''D'',-1,1)*DECODE(H.AC_CCY,''TZS'',H.LCY_AMOUNT,H.FCY_AMOUNT)),0) BALANCE,&#xA;        NULL  AUTHSATUS,&#xA;        NULL BRANCH_CODE,&#xA;        NULL BRANCH_NAME,&#xA;        NULL ADDRESS,&#xA;        NULL ACCOUNT_NO,&#xA;        NULL GL_DESC,&#xA;        NULL ACCOUNT_CCY,&#xA;        NULL P_FROM_DATE,&#xA;        NULL P_TO_DATE,&#xA;        NULL OWNER_ID&#xA;    FROM PARAMS P,&#xA;         FCUBS147.ACZB_HISTORY H&#xA;    WHERE H.AC_NO = P.GL_CODE&#xA;      AND H.AC_CCY = P.CURRENCY&#xA;      AND H.TRN_DT &lt;  (P.P_TO_DATE+1)&#xA;    GROUP BY&#xA;        P.P_TO_DATE&#xA;),&#xA; &#xA; &#xA;TXN_SD AS &#xA;(&#xA;SELECT&#xA;    A.ROW_NUM ROWNUMBERKB,&#xA;    A.BKG_DATE BOOKINGDATE,&#xA;    A.TRN_REF_NO,&#xA;    A.VALUE_DATE VALUEDATE,&#xA;    A.TRN_CODE,&#xA;    A.TRANSACTIONMAKER,&#xA;    A.NARRATION,&#xA;    A.RELATED_ACCOUNT REL_ACCT,&#xA;    A.DEBIT,&#xA;    A.CREDIT,&#xA;    A.INSTR_NO,&#xA;    SUM(A.MOVEMENT) OVER (PARTITION BY A.BRANCH_CODE ORDER BY A.ROW_NUM) BALANCE,&#xA;    A.AUTH_STAT AUTHSATUS,&#xA;    A.BRANCH_CODE,&#xA;    A.BRANCH_NAME,&#xA;    A.BRANCH_NAME ADDRESS,&#xA;    P.GL_CODE ACCOUNT_NO,&#xA;    GM.GL_DESC,&#xA;    AC_CCY ACCOUNT_CCY,&#xA;    P.P_FROM_DATE,&#xA;    P.P_TO_DATE,&#xA;    NULL OWNER_ID&#xA;&#xA;&#xA;FROM TXNS A&#xA;CROSS JOIN PARAMS P&#xA;LEFT JOIN FCUBS147.GLTM_GLMASTER GM&#xA;       ON GM.GL_CODE = P.GL_CODE ORDER BY  A.ROW_NUM&#xA;)&#xA; &#xA; &#xA;SELECT &#xA;    BOOKINGDATE,&#xA;    VALUEDATE,&#xA;    TRN_REF_NO, &#xA;    INSTR_NO,&#xA;    NARRATION,&#xA;    REL_ACCT,&#xA;    DEBIT,&#xA;    CREDIT,&#xA;    BALANCE&#xA;FROM &#xA;(&#xA;   SELECT * FROM OPENING_BAL&#xA;    UNION ALL&#xA;     SELECT * FROM TXN_SD&#xA;    UNION ALL&#xA;    SELECT * FROM CLOSING_BAL&#xA;) ORDER BY 1')&#xA; &quot;]" TimeoutMS="200000">

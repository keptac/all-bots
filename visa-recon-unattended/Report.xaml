    <ui:InvokeCode ContinueOnError="{x:Null}" Code="dtOutstandingGlFinal.Columns.Add(&quot;SNO&quot;)&#xA;dtOutstandingGlFinal.Columns.Add(&quot;Branch_Code&quot;)&#xA;dtOutstandingGlFinal.Columns.Add(&quot;GL_Code&quot;)&#xA;dtOutstandingGlFinal.Columns.Add(&quot;GL_Description&quot;)&#xA;dtOutstandingGlFinal.Columns.Add(&quot;Aging&quot;)&#xA;dtOutstandingGlFinal.Columns.Add(&quot;Aging Group&quot;)&#xA;dtOutstandingGlFinal.Columns.Add(&quot;BOT Classification&quot;)&#xA;dtOutstandingGlFinal.Columns.Add(&quot;Root Cause&quot;)&#xA;dtOutstandingGlFinal.Columns.Add(&quot;Root Cause Category&quot;)&#xA;dtOutstandingGlFinal.Columns.Add(&quot;Recommended Action&quot;)&#xA;dtOutstandingGlFinal.Columns.Add(&quot;Action Owner&quot;)&#xA;&#xA;&#xA;dtMissingFields.Columns.Add(&quot;SNO&quot;)&#xA;dtMissingFields.Columns.Add(&quot;Branch_Code&quot;)&#xA;dtMissingFields.Columns.Add(&quot;GL_Code&quot;)&#xA;dtMissingFields.Columns.Add(&quot;GL_Description&quot;)&#xA;dtMissingFields.Columns.Add(&quot;Aging&quot;)&#xA;dtMissingFields.Columns.Add(&quot;Aging Group&quot;)&#xA;dtMissingFields.Columns.Add(&quot;BOT Classification&quot;)&#xA;dtMissingFields.Columns.Add(&quot;Root Cause&quot;)&#xA;dtMissingFields.Columns.Add(&quot;Root Cause Category&quot;)&#xA;dtMissingFields.Columns.Add(&quot;Recommended Action&quot;)&#xA;dtMissingFields.Columns.Add(&quot;Action Owner&quot;)&#xA;&#xA;'Change the gl_code and description&#xA;&#xA;Dim branchCode = &quot;101&quot;&#xA;Dim glCode = &quot;&quot;&#xA;Dim glDescription = &quot;&quot;&#xA;Dim counter = 0&#xA;Dim ageCount As Double = 0&#xA;&#xA;If reconResultsPath.Contains(&quot;VISA ATM Clearing&quot;) Then&#xA;&#x9;branchCode = &quot;101&quot;&#xA; &#x9;glCode = &quot;122020002&quot;&#xA;&#x9;glDescription = &quot;VISA ATM Clearing&quot;&#xA;&#x9;&#xA;Else If reconResultsPath.Contains(&quot;VISA POS Clearing&quot;) Then&#xA;&#x9;branchCode = &quot;101&quot;&#xA;&#x9;glCode = &quot;122020011&quot;&#xA; &#x9;glDescription = &quot;VISA POS Clearing Account&quot;&#xA;End If&#xA;&#xA;' Smart Vista card postings (&quot;Journal Posting-Miscellaneous ... VIS POS PURCHASE&quot;)&#xA;' are cleared by the VISA settlement whatever their age, so Card Reconciliation&#xA;' wants them classed that way instead of &quot;Current exception&quot; / &quot;Need further investigation&quot;.&#xA;Dim smartVista As New System.Text.RegularExpressions.Regex(&quot;VIS\s+POS\s+PURCHASE&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;' Manual journal postings of the settlement itself (&quot;VISA POS Clearing Settlement 11 Oct 2026 USD&quot;)&#xA;' wait for the expected settlement rather than needing investigation.&#xA;Dim postedSettlement As New System.Text.RegularExpressions.Regex(&quot;VISA\s+POS\s+Clearing\s+Settlement&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;Dim tagSmartVista As Action(Of DataRow, String) = Sub(r As DataRow, narrCol As String)&#xA;&#x9;If smartVista.IsMatch(r(narrCol).ToString()) Then&#xA;&#x9;&#x9;r(&quot;Root Cause&quot;) = &quot;Smart vista transaction&quot;&#xA;&#x9;&#x9;r(&quot;Root Cause Category&quot;) = &quot;System&quot;&#xA;&#x9;&#x9;r(&quot;Recommended Action&quot;) = &quot;To be matched with settlement&quot;&#xA;&#x9;&#x9;r(&quot;Action Owner&quot;) = &quot;Card Reconciliation&quot;&#xA;&#x9;Else If postedSettlement.IsMatch(r(narrCol).ToString()) Then&#xA;&#x9;&#x9;r(&quot;Root Cause&quot;) = &quot;Posted settlement&quot;&#xA;&#x9;&#x9;r(&quot;Root Cause Category&quot;) = &quot;System&quot;&#xA;&#x9;&#x9;r(&quot;Recommended Action&quot;) = &quot;To be matched with the expected settlement&quot;&#xA;&#x9;&#x9;r(&quot;Action Owner&quot;) = &quot;Card Reconciliation&quot;&#xA;&#x9;End If&#xA;End Sub&#xA;&#xA;' Rows carried forward from earlier reports still show the GL code as their&#xA;' Transaction Ref No. Take the reference from the narration, as GL prep now does.&#xA;Dim glCodeShape As New System.Text.RegularExpressions.Regex(&quot;^12\d{7}$&quot;)&#xA;Dim narrRef As New System.Text.RegularExpressions.Regex(&quot;Reference\s*[:.]\s*(\d+)&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;Dim uploadRef As New System.Text.RegularExpressions.Regex(&quot;via\s+UPLOAD\s+(\w+)&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;For Each r As DataRow In dtPreviousRealExceptions.Rows&#xA;&#x9;tagSmartVista(r, &quot;Narration&quot;)&#xA;&#x9;Dim ref As String = r(&quot;Transaction Ref No:&quot;).ToString().Trim()&#xA;&#x9;If ref &lt;&gt; &quot;&quot; AndAlso Not glCodeShape.IsMatch(ref) Then Continue For&#xA;&#x9;Dim m As System.Text.RegularExpressions.Match = narrRef.Match(r(&quot;Narration&quot;).ToString())&#xA;&#x9;If Not m.Success Then m = uploadRef.Match(r(&quot;Narration&quot;).ToString())&#xA;&#x9;If m.Success Then r(&quot;Transaction Ref No:&quot;) = m.Groups(1).Value&#xA;Next&#xA;&#xA;&#xA;dtPreviousRealExceptions.AsEnumerable().ToList().ForEach(Sub(row)&#xA;&#x9;Try&#xA;&#x9;&#x9;Try&#xA;&#x9;&#x9;&#x9;ageCount = (DateTime.Parse(fileDate) - DateTime.Parse(row(&quot;Value Date&quot;).ToString)).TotalDays&#xA;&#x9;&#x9;Catch inEx As Exception&#xA;&#x9;&#x9;&#x9;Try&#xA;&#x9;&#x9;&#x9;&#x9;ageCount = (DateTime.Parse(fileDate) -  DateTime.FromOADate(Double.Parse(row(&quot;Value Date&quot;).ToString))).TotalDays&#xA;&#x9;&#x9;&#x9;Catch oaEx As Exception&#xA;&#x9;&#x9;&#x9;&#x9;ageCount = 0&#xA;&#x9;&#x9;&#x9;&#x9;ageCount = 0 : System.Console.WriteLine(oaEx)&#xA;&#x9;&#x9;&#x9;End Try&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;End Try &#xA;&#x9;&#x9;&#xA;&#x9;&#x9;row(&quot;Aging&quot;) = ageCount&#xA;&#x9;&#x9;row(&quot;SNO&quot;) = counter.ToString()&#xA;&#x9;&#x9;counter = counter +1&#xA;&#x9;&#xA;&#x9;&#x9;If ageCount&lt;4 Then&#xA;&#x9;&#x9;&#x9;row(&quot;Aging Group&quot;) = &quot;0-3 Days&quot;&#xA;&#x9;&#x9;Else If ageCount&lt; 31 Then&#xA;&#x9;&#x9;&#x9;row(&quot;Aging Group&quot;) = &quot;4-30 Days&quot;&#xA;&#x9;&#x9;Else If ageCount&lt; 61 Then&#xA;&#x9;&#x9;&#x9;row(&quot;Aging Group&quot;
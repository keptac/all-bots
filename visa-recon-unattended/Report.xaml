    <ui:InvokeCode ContinueOnError="{x:Null}" Code="If dtPreviousRealExceptions IsNot Nothing AndAlso dtPreviousRealExceptions.Rows.Count &gt; 0 Then&#xA;    Dim ci = System.Globalization.CultureInfo.InvariantCulture&#xA;    Dim names As String() = {&quot;debit&quot;,&quot;credit&quot;,&quot;amount&quot;,&quot;balance&quot;,&quot;lcy_amount&quot;,&quot;fcy_amount&quot;,&quot;dr&quot;,&quot;cr&quot;}&#xA;    Dim targets As New List(Of Integer)&#xA;&#xA;    For i As Integer = 0 To dtPreviousRealExceptions.Columns.Count - 1&#xA;        Dim col As System.Data.DataColumn = dtPreviousRealExceptions.Columns(i)&#xA;        If col.DataType Is GetType(Double) OrElse col.DataType Is GetType(Decimal) Then Continue For&#xA;        Dim nm As String = col.ColumnName.Trim().ToLowerInvariant()&#xA;        Dim looksLikeMoney As Boolean = False&#xA;        For Each n As String In names&#xA;            If nm = n OrElse nm.EndsWith(&quot;_&quot; &amp; n) OrElse nm.EndsWith(&quot; &quot; &amp; n) Then looksLikeMoney = True&#xA;        Next&#xA;        If Not looksLikeMoney Then Continue For&#xA;&#xA;        Dim allParse As Boolean = True&#xA;        For Each r As System.Data.DataRow In dtPreviousRealExceptions.Rows&#xA;            Dim v As Object = r(i)&#xA;            If v Is Nothing OrElse IsDBNull(v) Then Continue For&#xA;            Dim s As String = v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;)&#xA;            If s = &quot;&quot; Then Continue For&#xA;            If s.StartsWith(&quot;(&quot;) AndAlso s.EndsWith(&quot;)&quot;) Then s = &quot;-&quot; &amp; s.Substring(1, s.Length - 2)&#xA;            Dim d As Double&#xA;            If Not Double.TryParse(s, System.Globalization.NumberStyles.Any, ci, d) Then&#xA;                allParse = False&#xA;                Exit For&#xA;            End If&#xA;        Next&#xA;        If allParse Then targets.Add(i)&#xA;    Next&#xA;&#xA;    If targets.Count &gt; 0 Then&#xA;        Dim outT As New System.Data.DataTable()&#xA;        For i As Integer = 0 To dtPreviousRealExceptions.Columns.Count - 1&#xA;            If targets.Contains(i) Then&#xA;                outT.Columns.Add(dtPreviousRealExceptions.Columns(i).ColumnName, GetType(Double))&#xA;            Else&#xA;                outT.Columns.Add(dtPreviousRealExceptions.Columns(i).ColumnName, dtPreviousRealExceptions.Columns(i).DataType)&#xA;            End If&#xA;        Next&#xA;        For Each r As System.Data.DataRow In dtPreviousRealExceptions.Rows&#xA;            Dim nr As System.Data.DataRow = outT.NewRow()&#xA;            For i As Integer = 0 To dtPreviousRealExceptions.Columns.Count - 1&#xA;                Dim v As Object = r(i)&#xA;                If targets.Contains(i) Then&#xA;                    Dim d As Double = 0&#xA;                    If v IsNot Nothing AndAlso Not IsDBNull(v) Then&#xA;                        Dim s As String = v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;)&#xA;                        If s.StartsWith(&quot;(&quot;) AndAlso s.EndsWith(&quot;)&quot;) Then s = &quot;-&quot; &amp; s.Substring(1, s.Length - 2)&#xA;                        If s &lt;&gt; &quot;&quot; Then Double.TryParse(s, System.Globalization.NumberStyles.Any, ci, d)&#xA;                    End If&#xA;                    nr(i) = d&#xA;                Else&#xA;                    nr(i) = v&#xA;                End If&#xA;            Next&#xA;            outT.Rows.Add(nr)&#xA;        Next&#xA;        dtPreviousRealExceptions = outT&#xA;    End If&#xA;End If" DisplayName="Numeric amounts - dtPreviousRealExceptions" sap2010:WorkflowViewState.IdRef="InvokeCode_203">

    <TryCatch DisplayName="Try Catch - Root cause Analysis pivot" sap2010:WorkflowViewState.IdRef="TryCatch_RCA">
      <TryCatch.Try>
        <Sequence DisplayName="Build Root cause Analysis pivot" sap2010:WorkflowViewState.IdRef="Sequence_RCA">
          <ui:InvokeCode ContinueOnError="{x:Null}" Code="' --- Root cause Analysis pivot -------------------------------------------&#xA;' Adds the &quot;Root cause Analysis&quot; pivot table the manual report carries, built&#xA;' on the Report sheet's detail block (header row 14 down to the last item):&#xA;' rows Root Cause &gt; Recommended Action &gt; Aging Group in tabular form, values&#xA;' Count, Sum of Debit and Sum of Credit, with a Grand Total. ClosedXML writes&#xA;' the pivot definition only; Excel fills it in when the workbook is opened&#xA;' (refresh on open). The totals logged below equal the Report sheet's J9/K9.&#xA;Dim wb As New XLWorkbook(reconResultsPath)&#xA;Dim ws As IXLWorksheet = wb.Worksheet(&quot;Report&quot;)&#xA;&#xA;Dim hdr As New Dictionary(Of String, Integer)(StringComparer.OrdinalIgnoreCase)&#xA;Dim firstCol As Integer = Integer.MaxValue&#xA;Dim lastCol As Integer = 0&#xA;For Each c As IXLCell In ws.Row(14).CellsUsed()&#xA;    Dim h As String = c.GetString().Trim()&#xA;    If h = &quot;&quot; Then Continue For&#xA;    If hdr.ContainsKey(h) Then Throw New Exception(&quot;Root cause Analysis: header '&quot; &amp; h &amp; &quot;' appears twice on Report row 14&quot;)&#xA;    hdr.Add(h, c.Address.ColumnNumber)&#xA;    firstCol = Math.Min(firstCol, c.Address.ColumnNumber)&#xA;    lastCol = Math.Max(lastCol, c.Address.ColumnNumber)&#xA;Next&#xA;For Each need As String In New String() {&quot;Root Cause&quot;, &quot;Recommended Action&quot;, &quot;Aging Group&quot;, &quot;Debit&quot;, &quot;Credit&quot;}&#xA;    If Not hdr.ContainsKey(need) Then Throw New Exception(&quot;Root cause Analysis: header '&quot; &amp; need &amp; &quot;' not found on Report row 14&quot;)&#xA;Next&#xA;' A pivot source may not have a blank header inside it.&#xA;For c As Integer = firstCol To lastCol&#xA;    If ws.Cell(14, c).GetString().Trim() = &quot;&quot; Then Throw New Exception(&quot;Root cause Analysis: blank header in Report row 14, column &quot; &amp; c.ToString())&#xA;Next&#xA;&#xA;Dim lastUsed As IXLRow = ws.LastRowUsed()&#xA;Dim lastRow As Integer = If(lastUsed Is Nothing, 14, lastUsed.RowNumber())&#xA;If lastRow &lt; 15 Then&#xA;    wb.Dispose()&#xA;    rcaMsg = &quot;RCA | no outstanding items on the Report sheet - pivot not added&quot;&#xA;    Return&#xA;End If&#xA;&#xA;' Totals for the log line only; the pivot does its own arithmetic in Excel.&#xA;Dim ci As System.Globalization.CultureInfo = System.Globalization.CultureInfo.InvariantCulture&#xA;Dim num As Func(Of IXLCell, Double) = Function(cell As IXLCell)&#xA;    Dim d As Double = 0&#xA;    If cell.TryGetValue(Of Double)(d) Then Return d&#xA;    Dim s As String = cell.GetString().Trim().Replace(&quot;,&quot;, &quot;&quot;)&#xA;    If s.StartsWith(&quot;(&quot;) AndAlso s.EndsWith(&quot;)&quot;) Then s = &quot;-&quot; &amp; s.Substring(1, s.Length - 2)&#xA;    Double.TryParse(s, System.Globalization.NumberStyles.Any, ci, d)&#xA;    Return d&#xA;End Function&#xA;Dim totCnt As Integer = 0&#xA;Dim totDr As Double = 0&#xA;Dim totCr As Double = 0&#xA;For r As Integer = 15 To lastRow&#xA;    If ws.Cell(r, hdr(&quot;Aging Group&quot;)).IsEmpty() Then Continue For&#xA;    totCnt = totCnt + 1&#xA;    totDr = totDr + num(ws.Cell(r, hdr(&quot;Debit&quot;)))&#xA;    totCr = totCr + num(ws.Cell(r, hdr(&quot;Credit&quot;)))&#xA;Next&#xA;&#xA;' Rebuild on every run, first in the workbook as in the manual report.&#xA;If wb.Worksheets.Contains(&quot;Root cause Analysis&quot;) Then wb.Worksheets.Delete(&quot;Root cause Analysis&quot;)&#xA;Dim rca As IXLWorksheet = wb.Worksheets.Add(&quot;Root cause Analysis&quot;, 1)&#xA;&#xA;Dim source As IXLRange = ws.Range(14, firstCol, lastRow, lastCol)&#xA;Dim pt As IXLPivotTable = rca.PivotTables.Add(&quot;Root cause Analysis&quot;, rca.Cell(&quot;B2&quot;), source)&#xA;pt.RowLabels.Add(&quot;Root Cause&quot;)&#xA;pt.RowLabels.Add(&quot;Recommended Action&quot;)&#xA;pt.RowLabels.Add(&quot;Aging Group&quot;)&#xA;pt.Values.Add(&quot;Aging Group&quot;, &quot;Count&quot;).SetSummaryFormula(XLPivotSummary.Count)&#xA;pt.Values.Add(&quot;Debit&quot;, &quot;Sum of Debit&quot;).SetSummaryFormula(XLPivotSummary.Sum).NumberFormat.Format = &quot;#,##0.00&quot;&#xA;pt.Values.Add(&quot;Credit&quot;, &quot;Sum of Credit&quot;).SetSummaryFormula(XLPivotSummary.Sum).NumberFormat.Format = &quot;#,##0.00&quot;&#xA;pt.SetLayout(XLPivotLayout.Tabular)&#xA;pt.RepeatRowLabels = False&#xA;pt.ShowGrandTotalsRows = True&#xA;pt.ShowGrandTotalsColumns = True&#xA;pt.RefreshDataOnOpen = True&#xA;pt.Theme = XLPivotTableTheme.PivotStyleLight16&#xA;&#xA;rca.Column(1).Width = 3.4&#xA;rca.Column(2).Width = 42&#xA;rca.Column(3).Width = 36&#xA;rca.Column(4).Width = 14&#xA;rca.Column(5).Width = 9&#xA;rca.Column(6).Width = 20&#xA;rca.Column(7).Width = 20&#xA;&#xA;' Keep Report as the sheet the workbook opens on, with only it selected.&#xA;For Each sh As IXLWorksheet In wb.Worksheets&#xA;    sh.TabSelected = False&#xA;Next&#xA;ws.SetTabActive()&#xA;ws.TabSelected = True&#xA;&#xA;wb.Save()&#xA;wb.Dispose()&#xA;&#xA;' ClosedXML 0.95 does not write the tabular layout into the file and lists the&#xA;' aging groups in the order they first appear (oldest first). Patch the saved&#xA;' pivot definition directly: every field non-compact / non-outline, as in the&#xA;' manual report, and Aging Group ordered youngest to oldest.&#xA;Dim nsMain As System.Xml.Linq.XNamespace = &quot;http://schemas.openxmlformats.org/spreadsheetml/2006/main&quot;&#xA;Dim nsRel As System.Xml.Linq.XNamespace = &quot;http://schemas.openxmlformats.org/package/2006/relationships&quot;&#xA;Dim ageOrder As String() = {&quot;0-3 Days&quot;, &quot;4-30 Days&quot;, &quot;31-60 Days&quot;, &quot;61-90 Days&quot;, &quot;Above 90 Days&quot;}&#xA;Dim patched As Boolean = False&#xA;Using fs As New System.IO.FileStream(reconResultsPath, System.IO.FileMode.Open, System.IO.FileAccess.ReadWrite)&#xA;    Using zip As New System.IO.Compression.ZipArchive(fs, System.IO.Compression.ZipArchiveMode.Update)&#xA;        Dim readXml As Func(Of System.IO.Compression.ZipArchiveEntry, System.Xml.Linq.XDocument) = Function(e As System.IO.Compression.ZipArchiveEntry)&#xA;            Using st As System.IO.Stream = e.Open()&#xA;                Return System.Xml.Linq.XDocument.Load(st)&#xA;            End Using&#xA;        End Function&#xA;        Dim writeXml As Action(Of System.IO.Compression.ZipArchiveEntry, System.Xml.Linq.XDocument) = Sub(e As System.IO.Compression.ZipArchiveEntry, d As System.Xml.Linq.XDocument)&#xA;            Using st As System.IO.Stream = e.Open()&#xA;                st.SetLength(0)&#xA;                d.Save(st)&#xA;            End Using&#xA;        End Sub&#xA;&#xA;        For Each entry As System.IO.Compression.ZipArchiveEntry In zip.Entries.ToList()&#xA;            If Not entry.FullName.Contains(&quot;pivotTables/&quot;) OrElse entry.FullName.Contains(&quot;_rels/&quot;) Then Continue For&#xA;            Dim def As System.Xml.Linq.XDocument = readXml(entry)&#xA;            If def.Root Is Nothing OrElse def.Root.Name &lt;&gt; nsMain + &quot;pivotTableDefinition&quot; Then Continue For&#xA;            If CStr(def.Root.Attribute(&quot;name&quot;)) &lt;&gt; &quot;Root cause Analysis&quot; Then Continue For&#xA;&#xA;            def.Root.SetAttributeValue(&quot;compact&quot;, &quot;0&quot;)&#xA;            def.Root.SetAttributeValue(&quot;compactData&quot;, &quot;0&quot;)&#xA;            def.Root.SetAttributeValue(&quot;indent&quot;, &quot;0&quot;)&#xA;            Dim fields As List(Of System.Xml.Linq.XElement) = def.Root.Element(nsMain + &quot;pivotFields&quot;).Elements(nsMain + &quot;pivotField&quot;).ToList()&#xA;            For Each pf As System.Xml.Linq.XElement In fields&#xA;                pf.SetAttributeValue(&quot;compact&quot;, &quot;0&quot;)&#xA;                pf.SetAttributeValue(&quot;outline&quot;, &quot;0&quot;)&#xA;            Next&#xA;&#xA;            ' Map the Aging Group items to their text through the pivot cache.&#xA;            Dim ageIdx As Integer = fields.FindIndex(Function(pf As System.Xml.Linq.XElement) CStr(pf.Attribute(&quot;name&quot;)) = &quot;Aging Group&quot;)&#xA;            Dim relName As String = entry.FullName.Substring(0, entry.FullName.LastIndexOf(&quot;/&quot;) + 1) &amp; &quot;_rels/&quot; &amp; entry.Name &amp; &quot;.rels&quot;&#xA;            Dim relEntry As System.IO.Compression.ZipArchiveEntry = zip.GetEntry(relName)&#xA;            If ageIdx &gt;= 0 AndAlso relEntry IsNot Nothing Then&#xA;                Dim target As String = &quot;&quot;&#xA;                For Each rel As System.Xml.Linq.XElement In readXml(relEntry).Root.Elements(nsRel + &quot;Relationship&quot;)&#xA;                    If CStr(rel.Attribute(&quot;Type&quot;)).EndsWith(&quot;/pivotCacheDefinition&quot;) Then target = CStr(rel.Attribute(&quot;Target&quot;))&#xA;                Next&#xA;                If target.StartsWith(&quot;/&quot;) Then&#xA;                    target = target.Substring(1)&#xA;                ElseIf target &lt;&gt; &quot;&quot; Then&#xA;                    target = New Uri(New Uri(&quot;http://x/&quot; &amp; entry.FullName), target).AbsolutePath.Substring(1)&#xA;                End If&#xA;                Dim cacheEntry As System.IO.Compression.ZipArchiveEntry = If(target = &quot;&quot;, Nothing, zip.GetEntry(target))&#xA;                If cacheEntry IsNot Nothing Then&#xA;                    Dim cacheFields As List(Of System.Xml.Linq.XElement) = readXml(cacheEntry).Root.Element(nsMain + &quot;cacheFields&quot;).Elements(nsMain + &quot;cacheField&quot;).ToList()&#xA;                    Dim sharedTexts As List(Of String) = cacheFields(ageIdx).Element(nsMain + &quot;sharedItems&quot;).Elements().Select(Function(si As System.Xml.Linq.XElement) CStr(si.Attribute(&quot;v&quot;))).ToList()&#xA;                    Dim itemsEl As System.Xml.Linq.XElement = fields(ageIdx).Element(nsMain + &quot;items&quot;)&#xA;                    If itemsEl IsNot Nothing Then&#xA;                        Dim rank As Func(Of System.Xml.Linq.XElement, Integer) = Function(it As System.Xml.Linq.XElement)&#xA;                            Dim xa As System.Xml.Linq.XAttribute = it.Attribute(&quot;x&quot;)&#xA;                            If xa Is Nothing Then Return 1000&#xA;                            Dim x As Integer = CInt(xa.Value)&#xA;                            Dim pos As Integer = If(x &lt; sharedTexts.Count, Array.IndexOf(ageOrder, sharedTexts(x)), -1)&#xA;                            Return If(pos &lt; 0, 100 + x, pos)&#xA;                        End Function&#xA;                        Dim ordered As List(Of System.Xml.Linq.XElement) = itemsEl.Elements(nsMain + &quot;item&quot;).OrderBy(rank).ToList()&#xA;                        itemsEl.RemoveNodes()&#xA;                        For Each it As System.Xml.Linq.XElement In ordered&#xA;                            itemsEl.Add(it)&#xA;                        Next&#xA;                    End If&#xA;                End If&#xA;            End If&#xA;&#xA;            ' Excel rebuilds the row and column items on the refresh-on-open.&#xA;            If def.Root.Element(nsMain + &quot;rowItems&quot;) IsNot Nothing Then def.Root.Element(nsMain + &quot;rowItems&quot;).Remove()&#xA;            If def.Root.Element(nsMain + &quot;colItems&quot;) IsNot Nothing Then def.Root.Element(nsMain + &quot;colItems&quot;).Remove()&#xA;            writeXml(entry, def)&#xA;            patched = True&#xA;        Next&#xA;    End Using&#xA;End Using&#xA;If Not patched Then Throw New Exception(&quot;Root cause Analysis: pivot saved but its definition was not found to set the tabular layout&quot;)&#xA;&#xA;rcaMsg = &quot;RCA | Root cause Analysis pivot added | source=Report!&quot; &amp; source.RangeAddress.ToStringRelative() &amp; &quot; | items=&quot; &amp; totCnt.ToString() &amp; &quot; | DR=&quot; &amp; totDr.ToString(&quot;N2&quot;) &amp; &quot; | CR=&quot; &amp; totCr.ToString(&quot;N2&quot;)" DisplayName="Build Root cause Analysis pivot" sap2010:WorkflowViewState.IdRef="InvokeCode_RCA">
            <ui:InvokeCode.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="reconResultsPath">[reconResultsPath]</InArgument>
              <OutArgument x:TypeArguments="x:String" x:Key="rcaMsg">[rcaMsg]</OutArgument>
            </ui:InvokeCode.Arguments>
          </ui:InvokeCode>
          <ui:LogMessage DisplayName="Log - Root cause Analysis" sap2010:WorkflowViewState.IdRef="LogMessage_RCA" Level="Info" Message="[rcaMsg]" />
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_RCA">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="rcaException" />
            </ActivityAction.Argument>
            <ui:LogMessage DisplayName="Log - Root cause Analysis failed" sap2010:WorkflowViewState.IdRef="LogMessage_RCAFailed" Level="Warn" Message="[&quot;RCA | Root cause Analysis pivot NOT built (report is otherwise unaffected) | &quot; + rcaException.Message]" />
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>
    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' --- Balance self-check ------------------------------------------------&#xA;' J9/K9/&lt;bal&gt;10/&lt;bal&gt;12 are template formulas. ClosedXML saves no cached&#xA;' value for them, so an unattended run could never see its own Difference&#xA;' and a broken reconciliation shipped silently. Recompute the totals here and&#xA;' fail the run when it does not balance. The workbook is NOT modified.&#xA;Dim balCol As String = &quot;K&quot;&#xA;If Not amountColumn.Equals(&quot;CREDIT&quot;) Then&#xA;&#x9;balCol = &quot;J&quot;&#xA;End If&#xA;&#xA;Dim wbChk As New XLWorkbook(reconResultsPath)&#xA;Dim wsChk As IXLWorksheet = wbChk.Worksheet(&quot;Report&quot;)&#xA;&#xA;Dim lastUsed As IXLRow = wsChk.LastRowUsed()&#xA;Dim lastRow As Integer = 14&#xA;If lastUsed IsNot Nothing Then&#xA;&#x9;lastRow = lastUsed.RowNumber()&#xA;End If&#xA;&#xA;Dim totalDr As Double = 0&#xA;Dim totalCr As Double = 0&#xA;Dim dv As Double&#xA;Dim cv As Double&#xA;Dim r As Integer&#xA;For r = 15 To lastRow&#xA;&#x9;dv = 0&#xA;&#x9;cv = 0&#xA;&#x9;wsChk.Cell(&quot;J&quot; &amp; r.ToString()).TryGetValue(Of Double)(dv)&#xA;&#x9;wsChk.Cell(&quot;K&quot; &amp; r.ToString()).TryGetValue(Of Double)(cv)&#xA;&#x9;totalDr = totalDr + dv&#xA;&#x9;totalCr = totalCr + cv&#xA;Next&#xA;&#xA;Dim netOutstanding As Double = totalDr - totalCr&#xA;Dim glCutOff As Double = 0&#xA;wsChk.Cell(balCol &amp; &quot;11&quot;).TryGetValue(Of Double)(glCutOff)&#xA;Dim difference As Double = netOutstanding + glCutOff&#xA;&#xA;&#x27; Read-only: the template formulas in J9/K9/{J|K}10/{J|K}12 are left intact so&#xA;&#x27; Excel recalculates them on open. Nothing downstream reads those cells.&#xA;wbChk.Dispose()&#xA;&#xA;Dim summary As String = fileDate &amp; &quot; | DR=&quot; &amp; totalDr.ToString(&quot;N2&quot;) &amp; &quot; | CR=&quot; &amp; totalCr.ToString(&quot;N2&quot;) &amp; &quot; | NET OUTSTANDING=&quot; &amp; netOutstanding.ToString(&quot;N2&quot;) &amp; &quot; | GL CUT-OFF=&quot; &amp; glCutOff.ToString(&quot;N2&quot;) &amp; &quot; | DIFFERENCE=&quot; &amp; difference.ToString(&quot;N2&quot;) &amp; &quot; | detail rows=&quot; &amp; (lastRow - 14).ToString()&#xA;&#xA;balanceOk = Not (Math.Abs(difference) &gt; 0.01)&#xA;&#xA;If balanceOk Then&#xA;&#x9;balanceMsg = &quot;RECON BALANCE OK | &quot; &amp; summary&#xA;Else&#xA;&#x9;balanceMsg = &quot;RECON OUT OF BALANCE | &quot; &amp; summary &amp; &quot; | report=&quot; &amp; reconResultsPath&#xA;End If" DisplayName="Balance Self-Check" sap:VirtualizedContainerService.HintSize="435.2,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_900">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="reconResultsPath">[reconResultsPath]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="amountColumn">[amountColumn]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="fileDate">[fileDate]</InArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="balanceMsg">[balanceMsg]</OutArgument>
        <OutArgument x:TypeArguments="x:Boolean" x:Key="balanceOk">[balanceOk]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:LogMessage DisplayName="Log - balance check" sap:VirtualizedContainerService.HintSize="435.2,112" sap2010:WorkflowViewState.IdRef="LogMessage_900" Level="Info" Message="[balanceMsg]" />
    <If Condition="[Not balanceOk]" DisplayName="If - out of balance" sap:VirtualizedContainerService.HintSize="435.2,260" sap2010:WorkflowViewState.IdRef="If_900">
      <If.Then>
        <Throw DisplayName="Throw - out of balance" Exception="[New System.Exception(balanceMsg)]" sap:VirtualizedContainerService.HintSize="416,114.66666666666667" sap2010:WorkflowViewState.IdRef="Throw_900" />
      </If.Then>
    </If>
    <ui:ReportStatus DisplayName="Report Status" sap:VirtualizedContainerService.HintSize="435.2,90.4" sap2010:WorkflowViewState.IdRef="ReportStatus_4" StatusText="[&quot;100% - &quot;+reportType.ToUpper()+&quot; RECON COMPLETE&quot;]" />
  </Sequence>
</Activity>
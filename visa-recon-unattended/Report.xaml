        <ui:InvokeCode ContinueOnError="{x:Null}" Code="dtOutstandingStatement.Columns.Add(&quot;SNO&quot;)&#xA;dtOutstandingStatement.Columns.Add(&quot;Transaction Ref No:&quot;)&#xA;dtOutstandingStatement.Columns.Add(&quot;Narration&quot;)&#xA;&#xA;dtOutstandingStatement.Columns.Add(&quot;Debit&quot;, GetType(Double))&#xA;dtOutstandingStatement.Columns.Add(&quot;Credit&quot;, GetType(Double))&#xA;&#xA;dtOutstandingStatement.Columns.Add(&quot;Branch_Code&quot;)&#xA;dtOutstandingStatement.Columns.Add(&quot;GL_Code&quot;)&#xA;dtOutstandingStatement.Columns.Add(&quot;GL_Description&quot;)&#xA;dtOutstandingStatement.Columns.Add(&quot;Aging&quot;)&#xA;dtOutstandingStatement.Columns.Add(&quot;Aging Group&quot;)&#xA;dtOutstandingStatement.Columns.Add(&quot;BOT Classification&quot;)&#xA;dtOutstandingStatement.Columns.Add(&quot;Root Cause&quot;)&#xA;dtOutstandingStatement.Columns.Add(&quot;Root Cause Category&quot;)&#xA;dtOutstandingStatement.Columns.Add(&quot;Recommended Action&quot;)&#xA;dtOutstandingStatement.Columns.Add(&quot;Action Owner&quot;)&#xA;dtOutstandingStatement.Columns.Add(&quot;BKG_DATE&quot;)&#xA;dtOutstandingStatement.Columns(&quot;Date&quot;).ColumnName = &quot;VALUE_DATE&quot;&#xA;&#xA;'Change the gl_code and description&#xA;Dim branchCode = &quot;101&quot;&#xA;Dim glCode = &quot;&quot;&#xA;Dim glDescription = &quot;&quot;&#xA;Dim counter = 0&#xA;Dim ageCount As Double = 0&#xA;&#xA;If reconResultsPath.Contains(&quot;VISA ATM Clearing&quot;) Then&#xA;&#x9;branchCode = &quot;101&quot;&#xA; &#x9;glCode = &quot;122020002&quot;&#xA;&#x9;glDescription = &quot;VISA ATM Clearing&quot;&#xA;&#x9;&#xA;Else If reconResultsPath.Contains(&quot;VISA POS Clearing&quot;) Then&#xA;&#x9;branchCode = &quot;101&quot;&#xA;&#x9;glCode = &quot;122020011&quot;&#xA; &#x9;glDescription = &quot;VISA POS Clearing Account&quot;&#xA;End If&#xA;&#xA;dtOutstandingStatement.AsEnumerable().ToList().ForEach(Sub(row)&#xA;&#xA;Try&#xA;&#x9;Dim ci2 = System.Globalization.CultureInfo.InvariantCulture&#xA;&#x9;Dim rawDate As String = row(&quot;VALUE_DATE&quot;).ToString().Trim()&#xA;&#x9;Dim vd As DateTime&#xA;&#x9;If DateTime.TryParseExact(rawDate, New String() {&quot;dMMMyyyy&quot;,&quot;ddMMMyyyy&quot;,&quot;d MMM yyyy&quot;,&quot;dd MMM yyyy&quot;,&quot;yyyy-MM-dd&quot;,&quot;MM/dd/yyyy&quot;}, ci2, System.Globalization.DateTimeStyles.None, vd) Then&#xA;&#x9;&#x9;row(&quot;VALUE_DATE&quot;) = vd.ToString(&quot;MM/dd/yyyy&quot;)&#xA;&#x9;Else&#xA;&#x9;&#x9;' The VISA outgoing file carries day and month only (&quot;09SEP&quot;), so &quot;dMMMyyyy&quot;&#xA;&#x9;&#x9;' never matches and the aging fallback below hands &quot;09SEP&quot; to DateTime.Parse,&#xA;&#x9;&#x9;' which reads it as 1 Sep 2009 - 6,218 days old, filed under &quot;Above 90 Days&quot;&#xA;&#x9;&#x9;' and BOT-classified &quot;Loss&quot;. Anchor the missing year on the report date.&#xA;&#x9;&#x9;If DateTime.TryParseExact(rawDate, New String() {&quot;dMMM&quot;,&quot;ddMMM&quot;}, ci2, System.Globalization.DateTimeStyles.None, vd) Then&#xA;&#x9;&#x9;&#x9;Dim anchor As DateTime = DateTime.Parse(fileDate, ci2)&#xA;&#x9;&#x9;&#x9;Dim y As Integer = anchor.Year&#xA;&#x9;&#x9;&#x9;If vd.Month = 2 AndAlso vd.Day = 29 AndAlso Not DateTime.IsLeapYear(y) Then y = y - 1&#xA;&#x9;&#x9;&#x9;Dim stamped As New DateTime(y, vd.Month, vd.Day)&#xA;&#x9;&#x9;&#x9;' A December row seen in an early-January run belongs to the year before.&#xA;&#x9;&#x9;&#x9;If stamped &gt; anchor.AddDays(1) Then stamped = stamped.AddYears(-1)&#xA;&#x9;&#x9;&#x9;row(&quot;VALUE_DATE&quot;) = stamped.ToString(&quot;MM/dd/yyyy&quot;)&#xA;&#x9;&#x9;End If&#xA;&#x9;End If&#xA;Catch ex2 As Exception&#xA;End Try&#xA;&#xA;&#x9;row(&quot;BKG_DATE&quot;) = row(&quot;VALUE_DATE&quot;).ToString&#xA;&#x9;&#xA;&#x9;row(&quot;Branch_Code&quot;) = branchCode&#xA;&#x9;row(&quot;GL_Code&quot;) = glCode&#xA;&#x9;row(&quot;GL_Description&quot;) = glDescription&#xA;&#x9;row(&quot;Narration&quot;) = &quot;EP745 TRANS  - -  &quot;+row(&quot;PAN&quot;).ToString+&quot; - &quot;+row(&quot;Trace&quot;).ToString+&quot; - &quot;+row(&quot;RRN&quot;).ToString+&quot; - &quot;+row(&quot;Terminal ID&quot;).ToString&#xA;&#x9;&#x9;&#xA;&#x9;If amountColumn.Equals(&quot;DEBIT&quot;) Then&#xA;&#x9;&#x9;row(&quot;Credit&quot;) = Convert.ToDouble( Math.Round(Convert.ToDecimal(row(&quot;Transaction Amount&quot;).ToString.Replace(&quot;,&quot;,&quot;&quot;)),2).ToString )&#xA;&#x9;&#x9;row(&quot;Debit&quot;) = Convert.ToDouble( Convert.ToDecimal(0) )&#xA;&#x9;Else&#xA;&#x9;&#x9;row(&quot;Debit&quot;) = Convert.ToDouble( Math.Round(Convert.ToDecimal(row(&quot;Transaction Amount&quot;).ToString.Replace(&quot;,&quot;,&quot;&quot;)),2).ToString )&#xA;&#x9;&#x9;row(&quot;Credit&quot;) = Convert.ToDouble( Convert.ToDecimal(0) )&#xA;&#x9;End If&#xA;&#x9;&#xA;&#x9;Try&#xA;&#x9;&#x9;Try&#xA;&#x9;&#x9;&#x9;ageCount = (DateTime.Parse(fileDate) - DateTime.Parse(row(&quot;VALUE_DATE&quot;).ToString)).TotalDays&#xA;&#x9;&#x9;Catch inEx As Exception&#xA;&#x9;&#x9;&#x9;Try&#xA;&#x9;&#x9;&#x9;&#x9;ageCount = (DateTime.Parse(fileDate) -  DateTime.FromOADate(Double.Parse(row(&quot;VALUE_DATE&quot;).ToString))).TotalDays&#xA;&#x9;&#x9;&#x9;Catch oaEx As Exception&#xA;&#x9;&#x9;&#x9;&#x9;ageCount = 0 : System.Console.WriteLine(oaEx)&#xA;&#x9;&#x9;&#x9;End Try&#xA;&#x9;&#x9;End Try &#xA;&#x9;&#xA;&#x9;&#x9;row(&quot;Aging&quot;) = ageCount.ToString&#xA;&#x9;&#x9;row(&quot;SNO&quot;) = counter&#xA;&#x9;&#x9;counter = counter +1&#xA;&#x9;&#xA;&#x9;&#x9;If ageCount&lt;4 Then&#xA;&#x9;&#x9;&#x9;row(&quot;Aging Group&quot;) = &quot;0-3 Days&quot;&#xA;&#x9;&#x9;Else If ageCount&lt; 31 Then&#xA;&#x9;&#x9;&#x9;row(&quot;Aging Group&quot;) = &quot;4-30 Days&quot;&#xA;&#x9;&#x9;Else If ageCount&lt; 61 Then&#xA;&#x9;&#x9;&#x9;row(&quot;Aging Group&quot;) = &quot;31-60 Days&quot;&#xA;&#x9;&#x9;Else If  ageCount&lt; 90 Then&#xA;&#x9;&#x9;&#x9;row(&quot;Aging Group&quot;) = &quot;61-90 Days&quot;&#xA;&#x9;&#x9;Else&#xA;&#x9;&#x9;&#x9;row(&quot;Aging Group&quot;) = &quot;Above 90 Days&quot;&#xA;&#x9;&#x9;End If&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;If ageCount&lt;30 Then&#xA;&#x9;&#x9;&#x9;row(&quot;BOT Classification&quot;) = &quot;Not Applicable&quot;&#xA;&#x9;&#x9;Else If ageCount&lt; 60 Then&#xA;&#x9;&#x9;&#x9;row(&quot;BOT Classification&quot;) = &quot;Not Applicable&quot;&#xA;&#x9;&#x9;Else If ageCount&lt; 90 Then&#xA;&#x9;&#x9;&#x9;row(&quot;BOT Classification&quot;) = &quot;Not Applicable&quot;&#xA;&#x9;&#x9;Else If  ageCount&lt; 180 Then&#xA;&#x9;&#x9;&#x9;row(&quot;BOT Classification&quot;) = &quot;Not Applicable&quot;&#xA;&#x9;&#x9;Else&#xA;&#x9;&#x9;&#x9;row(&quot;BOT Classification&quot;) = &quot;Not Applicable&quot;&#xA;&#x9;&#x9;End If&#xA;&#x9;&#xA;Catch ex As Exception&#xA;&#x9;System.Console.WriteLine(&quot;Can't assign age: &quot; &amp; vbCrLf &amp; ex.Message)&#xA;End Try&#xA;&#x9;&#xA;&#x9;If row(&quot;Narration&quot;).ToString().Contains(&quot;CA&quot;) Then&#xA;&#x9;&#x9;row(&quot;Root Cause&quot;) = &quot;Reversal Transaction&quot;&#xA;&#x9;&#x9;row(&quot;Root Cause Category&quot;) = &quot;System&quot;&#xA;&#x9;&#x9;row(&quot;Recommended Action&quot;) = &quot;To be rectified with settlement amount&quot;&#xA;&#x9;&#x9;row(&quot;Action Owner&quot;) = &quot;Card Reconciliation&quot;&#xA;&#x9;Else&#xA;&#x9;&#x9;row(&quot;Root Cause&quot;) = &quot;Amount that did not hit the GL but were settled&quot;&#xA;&#x9;&#x9;row(&quot;Root Cause Category&quot;) = &quot;System&quot;&#xA;&#x9;&#x9;row(&quot;Recommended Action&quot;) = &quot;Under investigation&quot;&#xA;&#x9;&#x9;row(&quot;Action Owner&quot;) = &quot;Card Reconciliation&quot;&#xA;&#x9;End If&#xA;&#x9;&#xA;&#x9;&#xA;&#xA;End Sub)&#xA;&#xA;&#xA;" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="433.6,164.8" sap2010:WorkflowViewState.IdRef="InvokeCode_3">

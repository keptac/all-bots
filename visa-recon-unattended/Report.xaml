    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim src As System.Data.DataTable = dtFinalGl&#xA;If src IsNot Nothing AndAlso src.Rows.Count &gt; 0 Then&#xA;    Dim ci = System.Globalization.CultureInfo.InvariantCulture&#xA;    Dim debitIx As Integer = -1&#xA;    Dim creditIx As Integer = -1&#xA;    Dim narrIx As Integer = -1&#xA;    Dim droppedBal As Integer = 0&#xA;&#xA;    For i As Integer = 0 To src.Columns.Count - 1&#xA;        Dim nm As String = src.Columns(i).ColumnName.Trim().ToLowerInvariant()&#xA;        If nm = &quot;debit&quot; Then debitIx = i&#xA;        If nm = &quot;credit&quot; Then creditIx = i&#xA;        If nm = &quot;narration&quot; Then narrIx = i&#xA;    Next&#xA;    If debitIx &lt; 0 AndAlso src.Columns.Count &gt; 8 Then debitIx = 8&#xA;    If creditIx &lt; 0 AndAlso src.Columns.Count &gt; 9 Then creditIx = 9&#xA;    If narrIx &lt; 0 AndAlso src.Columns.Count &gt; 7 Then narrIx = 7&#xA;&#xA;    Dim outT As New System.Data.DataTable()&#xA;    For i As Integer = 0 To src.Columns.Count - 1&#xA;        If i = debitIx OrElse i = creditIx Then&#xA;            outT.Columns.Add(src.Columns(i).ColumnName, GetType(Double))&#xA;        Else&#xA;            outT.Columns.Add(src.Columns(i).ColumnName, src.Columns(i).DataType)&#xA;        End If&#xA;    Next&#xA;&#xA;    For Each r As System.Data.DataRow In src.Rows&#xA;        If narrIx &gt;= 0 Then&#xA;            Dim nTxt As String = &quot;&quot;&#xA;            If r(narrIx) IsNot Nothing AndAlso Not IsDBNull(r(narrIx)) Then nTxt = r(narrIx).ToString().Trim().ToLowerInvariant()&#xA;            If nTxt.Contains(&quot;opening balance&quot;) OrElse nTxt.Contains(&quot;closing balance&quot;) Then&#xA;                droppedBal = droppedBal + 1&#xA;                Continue For&#xA;            End If&#xA;        End If&#xA;        Dim nr As System.Data.DataRow = outT.NewRow()&#xA;        For i As Integer = 0 To src.Columns.Count - 1&#xA;            Dim v As Object = r(i)&#xA;            If i = debitIx OrElse i = creditIx Then&#xA;                Dim d As Double = 0&#xA;                If v IsNot Nothing AndAlso Not IsDBNull(v) Then&#xA;                    Dim s As String = v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;)&#xA;                    If s.StartsWith(&quot;(&quot;) AndAlso s.EndsWith(&quot;)&quot;) Then&#xA;                        s = &quot;-&quot; &amp; s.Substring(1, s.Length - 2)&#xA;                    End If&#xA;                    If Not Double.TryParse(s, System.Globalization.NumberStyles.Any, ci, d) Then&#xA;                        d = 0&#xA;                    End If&#xA;                End If&#xA;                nr(i) = d&#xA;            Else&#xA;                nr(i) = v&#xA;            End If&#xA;        Next&#xA;        outT.Rows.Add(nr)&#xA;    Next&#xA;&#xA;    amountsFixed = &quot;debit col=&quot; &amp; debitIx.ToString() &amp; &quot; credit col=&quot; &amp; creditIx.ToString() &amp; &quot; rows=&quot; &amp; outT.Rows.Count.ToString() &amp; &quot; balRowsDropped=&quot; &amp; droppedBal.ToString()&#xA;    dtFinalGl = outT&#xA;End If" DisplayName="Force Debit/Credit to numbers" sap2010:WorkflowViewState.IdRef="InvokeCode_90">

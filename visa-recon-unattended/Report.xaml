    <ui:InvokeCode ContinueOnError="{x:Null}" Code="If dtFinalGl IsNot Nothing AndAlso dtFinalGl.Rows.Count &gt; 1 Then&#xA;    Dim ci = System.Globalization.CultureInfo.InvariantCulture&#xA;    Dim fmts As String() = {&quot;dd-MMM-yyyy&quot;, &quot;d-MMM-yyyy&quot;, &quot;dd MMM yyyy&quot;, &quot;d MMM yyyy&quot;, &quot;dd-MMM-yy&quot;, &quot;MM/dd/yyyy HH:mm:ss&quot;, &quot;M/d/yyyy H:mm:ss&quot;, &quot;M/d/yyyy h:mm:ss tt&quot;, &quot;MM/dd/yyyy&quot;, &quot;M/d/yyyy&quot;, &quot;yyyy-MM-dd HH:mm:ss&quot;, &quot;yyyy-MM-dd&quot;}&#xA;    Dim vdIx As Integer = -1&#xA;    Dim bdIx As Integer = -1&#xA;    Dim snoIx As Integer = -1&#xA;    For i As Integer = 0 To dtFinalGl.Columns.Count - 1&#xA;        Dim nm As String = dtFinalGl.Columns(i).ColumnName.Trim().ToLowerInvariant()&#xA;        If nm = &quot;value date&quot; OrElse nm = &quot;value_date&quot; Then vdIx = i&#xA;        If nm = &quot;booking date&quot; OrElse nm = &quot;bkg_date&quot; Then bdIx = i&#xA;        If nm = &quot;sno&quot; Then snoIx = i&#xA;    Next&#xA;    If vdIx &lt; 0 AndAlso dtFinalGl.Columns.Count &gt; 5 Then vdIx = 5&#xA;    If bdIx &lt; 0 AndAlso dtFinalGl.Columns.Count &gt; 4 Then bdIx = 4&#xA;&#xA;    ' Value Date arrives in three shapes: OADate numbers (carried forward),&#xA;    ' dd-MMM-yyyy text (statement side) and MM/dd/yyyy HH:mm:ss text (GL side).&#xA;    Dim toDate As Func(Of Object, DateTime) = Function(v As Object) As DateTime&#xA;        If v Is Nothing OrElse IsDBNull(v) Then Return DateTime.MaxValue&#xA;        If TypeOf v Is DateTime Then Return CType(v, DateTime).Date&#xA;        Dim s As String = v.ToString().Trim()&#xA;        If s = &quot;&quot; Then Return DateTime.MaxValue&#xA;        Dim d As Double&#xA;        If Double.TryParse(s, System.Globalization.NumberStyles.Float, ci, d) AndAlso d &gt; 20000 AndAlso d &lt; 80000 Then Return DateTime.FromOADate(d).Date&#xA;        Dim dt As DateTime&#xA;        If DateTime.TryParseExact(s, fmts, ci, System.Globalization.DateTimeStyles.AllowWhiteSpaces, dt) Then Return dt.Date&#xA;        If DateTime.TryParse(s, ci, System.Globalization.DateTimeStyles.AllowWhiteSpaces, dt) Then Return dt.Date&#xA;        Return DateTime.MaxValue&#xA;    End Function&#xA;&#xA;    ' Stable sort: oldest value date first, current day last. Rows with the&#xA;    ' same value date keep their existing order (settlement, GL, statement).&#xA;    Dim keyed As New List(Of Tuple(Of DateTime, Integer))&#xA;    Dim unparsed As Integer = 0&#xA;    For i As Integer = 0 To dtFinalGl.Rows.Count - 1&#xA;        Dim vd As DateTime = toDate(dtFinalGl.Rows(i)(vdIx))&#xA;        If vd = DateTime.MaxValue Then unparsed = unparsed + 1&#xA;        keyed.Add(Tuple.Create(vd, i))&#xA;    Next&#xA;    Dim ordered As List(Of Tuple(Of DateTime, Integer)) = keyed.OrderBy(Function(k) k.Item1).ThenBy(Function(k) k.Item2).ToList()&#xA;&#xA;    ' Both date columns are written as OADate numbers, the shape carried-forward&#xA;    ' rows already have: the template formats F:G as d-mmm-yy, and the next&#xA;    ' run's Aging falls back to FromOADate. Unparseable text is kept as is.&#xA;    Dim outT As System.Data.DataTable = dtFinalGl.Clone()&#xA;    If snoIx &gt;= 0 Then outT.Columns(snoIx).DataType = GetType(Integer)&#xA;    outT.Columns(vdIx).DataType = GetType(Object)&#xA;    If bdIx &gt;= 0 Then outT.Columns(bdIx).DataType = GetType(Object)&#xA;    Dim n As Integer = 0&#xA;    Dim converted As Integer = 0&#xA;    For Each k As Tuple(Of DateTime, Integer) In ordered&#xA;        n = n + 1&#xA;        Dim srcRow As System.Data.DataRow = dtFinalGl.Rows(k.Item2)&#xA;        Dim nr As System.Data.DataRow = outT.NewRow()&#xA;        For i As Integer = 0 To dtFinalGl.Columns.Count - 1&#xA;            If i = snoIx Then&#xA;                nr(i) = n&#xA;            ElseIf i = vdIx OrElse i = bdIx Then&#xA;                Dim dd As DateTime = toDate(srcRow(i))&#xA;                If dd = DateTime.MaxValue Then&#xA;                    nr(i) = srcRow(i)&#xA;                Else&#xA;                    nr(i) = dd.ToOADate()&#xA;                    converted = converted + 1&#xA;                End If&#xA;            Else&#xA;                nr(i) = srcRow(i)&#xA;            End If&#xA;        Next&#xA;        outT.Rows.Add(nr)&#xA;    Next&#xA;    dtFinalGl = outT&#xA;    sortMsg = &quot;SORT | Report rows ordered by Value Date | rows=&quot; &amp; n.ToString() &amp; &quot; vdCol=&quot; &amp; vdIx.ToString() &amp; &quot; unparsedDates=&quot; &amp; unparsed.ToString() &amp; &quot; datesConverted=&quot; &amp; converted.ToString()&#xA;End If" DisplayName="Sort outstanding by Value Date" sap2010:WorkflowViewState.IdRef="InvokeCode_SortVD">

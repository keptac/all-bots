      <ui:InvokeCode ContinueOnError="{x:Null}" Code="' --- Arrange matched GL and statement rows as pairs -----------------------&#xA;' Each GL row is written directly above the statement row it matched on&#xA;' (PAN last 4 + RRN + amount), so the sheet reads pair by pair. A statement&#xA;' row is used once. GL rows with no statement partner (auto reversals and the&#xA;' like) and any unpaired statement rows follow the pairs. Columns are copied&#xA;' by position, as the old pair of AppendRanges did.&#xA;Dim ci As System.Globalization.CultureInfo = System.Globalization.CultureInfo.InvariantCulture&#xA;Dim ns As System.Globalization.NumberStyles = System.Globalization.NumberStyles.Any&#xA;Dim amt As Func(Of Object, String) = Function(v As Object)&#xA;    Dim d As Decimal = 0&#xA;    If v IsNot Nothing AndAlso Not IsDBNull(v) Then Decimal.TryParse(v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;), ns, ci, d)&#xA;    Return Math.Round(d, 2).ToString(&quot;F2&quot;, ci)&#xA;End Function&#xA;Dim idOf As Func(Of System.Data.DataRow, String) = Function(r As System.Data.DataRow)&#xA;    Dim pan As String = If(IsDBNull(r(&quot;PAN&quot;)), &quot;&quot;, r(&quot;PAN&quot;).ToString().Trim())&#xA;    Dim rrn As String = If(IsDBNull(r(&quot;RRN&quot;)), &quot;&quot;, r(&quot;RRN&quot;).ToString().Trim())&#xA;    Return If(pan.Length &gt;= 4, pan.Substring(pan.Length - 4), pan) &amp; &quot;|&quot; &amp; rrn &amp; &quot;|&quot;&#xA;End Function&#xA;&#xA;Dim g As System.Data.DataTable = If(dtMatchedGl, New System.Data.DataTable())&#xA;Dim st As System.Data.DataTable = If(dtMatchedStatement, New System.Data.DataTable())&#xA;&#xA;Dim outT As New System.Data.DataTable()&#xA;Dim width As Integer = Math.Max(g.Columns.Count, st.Columns.Count)&#xA;For c As Integer = 0 To width - 1&#xA;    outT.Columns.Add(&quot;C&quot; &amp; c.ToString(), GetType(Object))&#xA;Next&#xA;&#xA;Dim addRow As Action(Of System.Data.DataRow) = Sub(src As System.Data.DataRow)&#xA;    Dim nr As System.Data.DataRow = outT.NewRow()&#xA;    For c As Integer = 0 To src.Table.Columns.Count - 1&#xA;        nr(c) = src(c)&#xA;    Next&#xA;    outT.Rows.Add(nr)&#xA;End Sub&#xA;&#xA;Dim canPair As Boolean = g.Columns.Contains(&quot;PAN&quot;) AndAlso g.Columns.Contains(&quot;RRN&quot;) AndAlso g.Columns.Contains(&quot;DEBIT&quot;) AndAlso g.Columns.Contains(&quot;CREDIT&quot;) AndAlso st.Columns.Contains(&quot;PAN&quot;) AndAlso st.Columns.Contains(&quot;RRN&quot;) AndAlso st.Columns.Contains(&quot;Transaction Amount&quot;)&#xA;Dim queues As New Dictionary(Of String, Queue(Of System.Data.DataRow))&#xA;If canPair Then&#xA;    For Each r As System.Data.DataRow In st.Rows&#xA;        Dim k As String = idOf(r) &amp; amt(r(&quot;Transaction Amount&quot;))&#xA;        If Not queues.ContainsKey(k) Then queues.Add(k, New Queue(Of System.Data.DataRow))&#xA;        queues(k).Enqueue(r)&#xA;    Next&#xA;End If&#xA;&#xA;pairCount = 0&#xA;Dim used As New HashSet(Of System.Data.DataRow)&#xA;Dim leftovers As New List(Of System.Data.DataRow)&#xA;For Each r As System.Data.DataRow In g.Rows&#xA;    Dim partner As System.Data.DataRow = Nothing&#xA;    If canPair Then&#xA;        Dim kDr As String = idOf(r) &amp; amt(r(&quot;DEBIT&quot;))&#xA;        Dim kCr As String = idOf(r) &amp; amt(r(&quot;CREDIT&quot;))&#xA;        If queues.ContainsKey(kDr) AndAlso queues(kDr).Count &gt; 0 Then&#xA;            partner = queues(kDr).Dequeue()&#xA;        ElseIf queues.ContainsKey(kCr) AndAlso queues(kCr).Count &gt; 0 Then&#xA;            partner = queues(kCr).Dequeue()&#xA;        End If&#xA;    End If&#xA;    If partner IsNot Nothing Then&#xA;        addRow(r)&#xA;        addRow(partner)&#xA;        used.Add(partner)&#xA;        pairCount = pairCount + 1&#xA;    Else&#xA;        leftovers.Add(r)&#xA;    End If&#xA;Next&#xA;For Each r As System.Data.DataRow In leftovers&#xA;    addRow(r)&#xA;Next&#xA;For Each r As System.Data.DataRow In st.Rows&#xA;    If Not used.Contains(r) Then addRow(r)&#xA;Next&#xA;&#xA;dtMatchedPairs = outT" DisplayName="Arrange matched rows as pairs" sap2010:WorkflowViewState.IdRef="InvokeCode_PairsMatch">
        <ui:InvokeCode.Arguments>
          <InArgument x:TypeArguments="sd:DataTable" x:Key="dtMatchedGl">[dtMatchedGl]</InArgument>
          <InArgument x:TypeArguments="sd:DataTable" x:Key="dtMatchedStatement">[dtMatchedStatement]</InArgument>
          <OutArgument x:TypeArguments="sd:DataTable" x:Key="dtMatchedPairs">[dtMatchedPairs]</OutArgument>
          <OutArgument x:TypeArguments="x:Int32" x:Key="pairCount">[matchedPairCount]</OutArgument>
        </ui:InvokeCode.Arguments>
      </ui:InvokeCode>
      <ui:AppendRange DataTable="[dtMatchedPairs]" DisplayName="Append Range Workbook" sap:VirtualizedContainerService.HintSize="538.6666666666666,148" sap2010:WorkflowViewState.IdRef="AppendRange_2" SheetName="MATCHED TRANSACTIONS" WorkbookPath="[reconResultsPath]" />
      <ui:InvokeCode ContinueOnError="{x:Null}" Code="' --- Colour the matched pairs just written --------------------------------&#xA;' The block written last ends at the sheet's last used row and opens with&#xA;' pairCount pairs: the first leg of each pair in red, its counterpart on the&#xA;' row directly below in blue. Unpaired rows after the pairs keep the default.&#xA;If pairCount &gt; 0 AndAlso blockRows &gt; 0 Then&#xA;    Using wb As New XLWorkbook(reconResultsPath)&#xA;        Dim ws As IXLWorksheet = wb.Worksheet(&quot;MATCHED TRANSACTIONS&quot;)&#xA;        Dim lastRow As Integer = ws.LastRowUsed().RowNumber()&#xA;        Dim lastCol As Integer = ws.LastColumnUsed().ColumnNumber()&#xA;        Dim firstRow As Integer = lastRow - blockRows + 1&#xA;        For p As Integer = 0 To pairCount - 1&#xA;            Dim top As Integer = firstRow + 2 * p&#xA;            ws.Range(top, 1, top, lastCol).Style.Font.FontColor = XLColor.Red&#xA;            ws.Range(top + 1, 1, top + 1, lastCol).Style.Font.FontColor = XLColor.Blue&#xA;        Next&#xA;        wb.Save()&#xA;    End Using&#xA;End If" DisplayName="Colour matched pairs (red / blue)" sap2010:WorkflowViewState.IdRef="InvokeCode_ColourPairs_Match">
        <ui:InvokeCode.Arguments>
          <InArgument x:TypeArguments="x:String" x:Key="reconResultsPath">[reconResultsPath]</InArgument>
          <InArgument x:TypeArguments="x:Int32" x:Key="pairCount">[matchedPairCount]</InArgument>
          <InArgument x:TypeArguments="x:Int32" x:Key="blockRows">[dtMatchedPairs.Rows.Count]</InArgument>
        </ui:InvokeCode.Arguments>
      </ui:InvokeCode>
      <ui:ReportStatus DisplayName="Report Status" sap:VirtualizedContainerService.HintSize="538.6666666666666,92" sap2010:WorkflowViewState.IdRef="ReportStatus_3" StatusText="[&quot;90% - MATCHING IN COMPLETED&quot;]" />

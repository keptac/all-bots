rrn.StartsWith(&quot;NA&quot;) OrElse pan = &quot;&quot; OrElse pan.StartsWith(&quot;NA&quot;) Then&#xA;&#x9;&#x9;&#x9;bogus.Add(r)&#xA;&#x9;&#x9;End If&#xA;&#x9;Next&#xA;&#xA;&#x9;If bogus.Count &gt; 0 Then&#xA;&#x9;&#x9;Dim returnedDr As Double = 0&#xA;&#x9;&#x9;Dim returnedCr As Double = 0&#xA;&#x9;&#x9;For Each r As System.Data.DataRow In bogus&#xA;&#x9;&#x9;&#x9;Dim nr As System.Data.DataRow = dtOutstandingGl.NewRow()&#xA;&#x9;&#x9;&#x9;For Each c As System.Data.DataColumn In dtOutstandingGl.Columns&#xA;&#x9;&#x9;&#x9;&#x9;If dtMatchedGl.Columns.Contains(c.ColumnName) AndAlso Not IsDBNull(r(c.ColumnName)) Then&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;nr(c.ColumnName) = r(c.ColumnName)&#xA;&#x9;&#x9;&#x9;&#x9;End If&#xA;&#x9;&#x9;&#x9;Next&#xA;&#x9;&#x9;&#x9;dtOutstandingGl.Rows.Add(nr)&#xA;&#x9;&#x9;&#x9;If dtMatchedGl.Columns.Contains(&quot;DEBIT&quot;) AndAlso Not IsDBNull(r(&quot;DEBIT&quot;)) Then&#xA;&#x9;&#x9;&#x9;&#x9;Dim d As Double = 0&#xA;&#x9;&#x9;&#x9;&#x9;Double.TryParse(r(&quot;DEBIT&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;), d)&#xA;&#x9;&#x9;&#x9;&#x9;returnedDr = returnedDr + d&#xA;&#x9;&#x9;&#x9;End If&#xA;&#x9;&#x9;&#x9;If dtMatchedGl.Columns.Contains(&quot;CREDIT&quot;) AndAlso Not IsDBNull(r(&quot;CREDIT&quot;)) Then&#xA;&#x9;&#x9;&#x9;&#x9;Dim c2 As Double = 0&#xA;&#x9;&#x9;&#x9;&#x9;Double.TryParse(r(&quot;CREDIT&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;), c2)&#xA;&#x9;&#x9;&#x9;&#x9;returnedCr = returnedCr + c2&#xA;&#x9;&#x9;&#x9;End If&#xA;&#x9;&#x9;&#x9;dtMatchedGl.Rows.Remove(r)&#xA;&#x9;&#x9;Next&#xA;&#x9;&#x9;guardMsg = &quot;GUARD | unmatchable-identifier | RETURNED &quot; &amp; bogus.Count.ToString() &amp; &quot; row(s) to outstanding (synthetic or blank RRN/PAN) | DR=&quot; &amp; returnedDr.ToString(&quot;N2&quot;) &amp; &quot; | CR=&quot; &amp; returnedCr.ToString(&quot;N2&quot;)&#xA;&#x9;End If&#xA;&#xA;End If" DisplayName="Unmatchable-Identifier Guard" sap:VirtualizedContainerService.HintSize="468.6666666666667,188
        <ui:InvokeCode ContinueOnError="{x:Null}" Code="' --- GL debit/credit contra pairing (1:1) --------------------------------&#xA;' An on-us card purchase is debited to the GL with the card narration&#xA;' (&quot;PUMA SURVEY DSM DATZ - - 431331******6457 - 273746 - 000653750663 - ...&quot;)&#xA;' and relieved later by the merchant payment credit (&quot;... using&#xA;' 431331******6457 - 273746 - X2410009. Reference: 000653750663&quot;). Neither&#xA;' leg is in the Visa file and the two carry different TRN_REF_NOs, so both&#xA;' stayed outstanding. Pair a debit-only row with a credit-only row on&#xA;' PAN last 4 + RRN + amount, one credit per debit, and move both legs to&#xA;' matched. Rows on synthetic &quot;NA...&quot; or blank identifiers never pair.&#xA;contraMsg = &quot;CONTRA | GL debit/credit pairing | pairs=0&quot;&#xA;&#xA;If dtOutstandingGl IsNot Nothing AndAlso dtOutstandingGl.Rows.Count &gt; 0 AndAlso dtOutstandingGl.Columns.Contains(&quot;PAN&quot;) AndAlso dtOutstandingGl.Columns.Contains(&quot;RRN&quot;) Then&#xA;&#xA;&#x9;Dim ci As System.Globalization.CultureInfo = System.Globalization.CultureInfo.InvariantCulture&#xA;&#x9;Dim ns As System.Globalization.NumberStyles = System.Globalization.NumberStyles.Any&#xA;&#x9;Dim amt As Func(Of Object, Decimal) = Function(v As Object)&#xA;&#x9;&#x9;Dim d As Decimal = 0&#xA;&#x9;&#x9;If v IsNot Nothing AndAlso Not IsDBNull(v) Then&#xA;&#x9;&#x9;&#x9;Dim s As String = v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;)&#xA;&#x9;&#x9;&#x9;If s.StartsWith(&quot;(&quot;) AndAlso s.EndsWith(&quot;)&quot;) Then s = &quot;-&quot; &amp; s.Substring(1, s.Length - 2)&#xA;&#x9;&#x9;&#x9;Decimal.TryParse(s, ns, ci, d)&#xA;&#x9;&#x9;End If&#xA;&#x9;&#x9;Return Math.Round(d, 2)&#xA;&#x9;End Function&#xA;&#x9;Dim idOf As Func(Of System.Data.DataRow, String) = Function(r As System.Data.DataRow)&#xA;&#x9;&#x9;Dim pan As String = If(IsDBNull(r(&quot;PAN&quot;)), &quot;&quot;, r(&quot;PAN&quot;).ToString().Trim())&#xA;&#x9;&#x9;Dim rrn As String = If(IsDBNull(r(&quot;RRN&quot;)), &quot;&quot;, r(&quot;RRN&quot;).ToString().Trim())&#xA;&#x9;&#x9;If rrn = &quot;&quot; OrElse rrn.StartsWith(&quot;NA&quot;) OrElse pan.Length &lt; 4 OrElse pan.StartsWith(&quot;NA&quot;) Then Return &quot;&quot;&#xA;&#x9;&#x9;Return pan.Substring(pan.Length - 4) &amp; &quot;|&quot; &amp; rrn &amp; &quot;|&quot;&#xA;&#x9;End Function&#xA;&#xA;&#x9;Dim credits As New Dictionary(Of String, Queue(Of System.Data.DataRow))&#xA;&#x9;For Each r As System.Data.DataRow In dtOutstandingGl.Rows&#xA;&#x9;&#x9;Dim id As String = idOf(r)&#xA;&#x9;&#x9;If id = &quot;&quot; Then Continue For&#xA;&#x9;&#x9;Dim cr As Decimal = amt(r(&quot;CREDIT&quot;))&#xA;&#x9;&#x9;If cr &gt; 0 AndAlso amt(r(&quot;DEBIT&quot;)) = 0 Then&#xA;&#x9;&#x9;&#x9;Dim k As String = id &amp; cr.ToString(&quot;F2&quot;, ci)&#xA;&#x9;&#x9;&#x9;If Not credits.ContainsKey(k) Then credits.Add(k, New Queue(Of System.Data.DataRow))&#xA;&#x9;&#x9;&#x9;credits(k).Enqueue(r)&#xA;&#x9;&#x9;End If&#xA;&#x9;Next&#xA;&#xA;&#x9;Dim pairs As New List(Of System.Data.DataRow())&#xA;&#x9;Dim total As Decimal = 0&#xA;&#x9;For Each r As System.Data.DataRow In dtOutstandingGl.Rows&#xA;&#x9;&#x9;Dim id As String = idOf(r)&#xA;&#x9;&#x9;If id = &quot;&quot; Then Continue For&#xA;&#x9;&#x9;Dim dr As Decimal = amt(r(&quot;DEBIT&quot;))&#xA;&#x9;&#x9;If dr &lt;= 0 OrElse amt(r(&quot;CREDIT&quot;)) &lt;&gt; 0 Then Continue For&#xA;&#x9;&#x9;Dim k As String = id &amp; dr.ToString(&quot;F2&quot;, ci)&#xA;&#x9;&#x9;If credits.ContainsKey(k) AndAlso credits(k).Count &gt; 0 Then&#xA;&#x9;&#x9;&#x9;pairs.Add(New System.Data.DataRow() {r, credits(k).Dequeue()})&#xA;&#x9;&#x9;&#x9;total = total + dr&#xA;&#x9;&#x9;End If&#xA;&#x9;Next&#xA;&#xA;&#x9;If pairs.Count &gt; 0 Then&#xA;&#x9;&#x9;If dtMatchedGl Is Nothing Then dtMatchedGl = dtOutstandingGl.Clone()&#xA;&#x9;&#x9;' Debit leg directly above its credit leg.&#xA;&#x9;&#x9;For Each p As System.Data.DataRow() In pairs&#xA;&#x9;&#x9;&#x9;dtMatchedGl.ImportRow(p(0))&#xA;&#x9;&#x9;&#x9;dtMatchedGl.ImportRow(p(1))&#xA;&#x9;&#x9;Next&#xA;&#x9;&#x9;For Each p As System.Data.DataRow() In pairs&#xA;&#x9;&#x9;&#x9;dtOutstandingGl.Rows.Remove(p(0))&#xA;&#x9;&#x9;&#x9;dtOutstandingGl.Rows.Remove(p(1))&#xA;&#x9;&#x9;Next&#xA;&#x9;&#x9;contraMsg = &quot;CONTRA | GL debit/credit pairing | pairs=&quot; &amp; pairs.Count.ToString() &amp; &quot; | legs moved to matched=&quot; &amp; (pairs.Count * 2).ToString() &amp; &quot; | amount=&quot; &amp; total.ToString(&quot;N2&quot;, ci) &amp; &quot; | outstanding rows left=&quot; &amp; dtOutstandingGl.Rows.Count.ToString()&#xA;&#x9;End If&#xA;&#xA;End If" DisplayName="Pair GL Debit/Credit Contras (1:1)" sap:VirtualizedContainerService.HintSize="504.6666666666667,188" sap2010:WorkflowViewState.IdRef="InvokeCode_903">

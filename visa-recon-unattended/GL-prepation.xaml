      <ui:InvokeCode ContinueOnError="{x:Null}" Code="' --- Colour the matched pairs just written --------------------------------&#xA;' The block written last ends at the sheet's last used row and opens with&#xA;' pairCount pairs: the first leg of each pair in red, its counterpart on the&#xA;' row directly below in blue. Unpaired rows after the pairs keep the default.&#xA;If pairCount &gt; 0 AndAlso blockRows &gt; 0 Then&#xA;    Using wb As New XLWorkbook(reconResultsPath)&#xA;        Dim ws As IXLWorksheet = wb.Worksheet(&quot;MATCHED TRANSACTIONS&quot;)&#xA;        Dim lastRow As Integer = ws.LastRowUsed().RowNumber()&#xA;        Dim lastCol As Integer = ws.LastColumnUsed().ColumnNumber()&#xA;        Dim firstRow As Integer = lastRow - blockRows + 1&#xA;        For p As Integer = 0 To pairCount - 1&#xA;            Dim top As Integer = firstRow + 2 * p&#xA;            ws.Range(top, 1, top, lastCol).Style.Font.FontColor = XLColor.Red&#xA;            ws.Range(top + 1, 1, top + 1, lastCol).Style.Font.FontColor = XLColor.Blue&#xA;        Next&#xA;        wb.Save()&#xA;    End Using&#xA;End If" DisplayName="Colour matched pairs (red / blue)" sap2010:WorkflowViewState.IdRef="InvokeCode_ColourPairs_Gl">

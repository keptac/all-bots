    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' --- Transaction reference + auto-reversal pairing ----------------------&#xA;' 1) For card postings CBS hands back the GL code (e.g. 122020011) as&#xA;'    TRN_REF_NO, so every row shared one &quot;reference&quot; and the report showed&#xA;'    the GL number. Where that happens, take the real reference from the&#xA;'    narration: &quot;Reference: 000651565666&quot; for merchant payments, otherwise&#xA;'    the &quot;via UPLOAD 101zvax262820066&quot; upload reference of journal postings.&#xA;' 2) Auto-reversals repeat the original under the same reference with the&#xA;'    amount negated (DEBIT 250,000 then DEBIT -250,000). Pair +x with -x&#xA;'    per reference and column, 1:1, and move both legs to GL REVERSALS.&#xA;'    The old step required a whole TRN_REF_NO group to sum to zero, which&#xA;'    never happened while that group was the entire GL.&#xA;Dim ci As System.Globalization.CultureInfo = System.Globalization.CultureInfo.InvariantCulture&#xA;Dim ns As System.Globalization.NumberStyles = System.Globalization.NumberStyles.Any&#xA;Dim glCodeShape As New System.Text.RegularExpressions.Regex(&quot;^12\d{7}$&quot;)&#xA;Dim narrRef As New System.Text.RegularExpressions.Regex(&quot;Reference\s*[:.]\s*(\d+)&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;Dim uploadRef As New System.Text.RegularExpressions.Regex(&quot;via\s+UPLOAD\s+(\w+)&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;&#xA;Dim amt As Func(Of Object, Decimal) = Function(v As Object)&#xA;    Dim d As Decimal = 0&#xA;    If v IsNot Nothing AndAlso Not IsDBNull(v) Then&#xA;        Dim s As String = v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;)&#xA;        If s.StartsWith(&quot;(&quot;) AndAlso s.EndsWith(&quot;)&quot;) Then s = &quot;-&quot; &amp; s.Substring(1, s.Length - 2)&#xA;        Decimal.TryParse(s, ns, ci, d)&#xA;    End If&#xA;    Return Math.Round(d, 2)&#xA;End Function&#xA;&#xA;Dim refFixed As Integer = 0&#xA;For Each r As System.Data.DataRow In dtProcessedGl.Rows&#xA;    Dim ref As String = If(IsDBNull(r(&quot;TRN_REF_NO&quot;)), &quot;&quot;, r(&quot;TRN_REF_NO&quot;).ToString().Trim())&#xA;    If ref &lt;&gt; &quot;&quot; AndAlso Not glCodeShape.IsMatch(ref) Then Continue For&#xA;    Dim narr As String = If(IsDBNull(r(&quot;NARRATION&quot;)), &quot;&quot;, r(&quot;NARRATION&quot;).ToString())&#xA;    Dim m As System.Text.RegularExpressions.Match = narrRef.Match(narr)&#xA;    If Not m.Success Then m = uploadRef.Match(narr)&#xA;    If m.Success Then&#xA;        r(&quot;TRN_REF_NO&quot;) = m.Groups(1).Value&#xA;        refFixed = refFixed + 1&#xA;    End If&#xA;Next&#xA;&#xA;' Rows still carrying a blank or GL-code reference cannot be told apart, so&#xA;' they never take part in reversal pairing.&#xA;Dim pairedRows As New HashSet(Of System.Data.DataRow)&#xA;Dim partnerOf As New Dictionary(Of System.Data.DataRow, System.Data.DataRow)&#xA;For Each col As String In New String() {&quot;DEBIT&quot;, &quot;CREDIT&quot;}&#xA;    Dim positives As New Dictionary(Of String, Queue(Of System.Data.DataRow))&#xA;    Dim negatives As New List(Of System.Data.DataRow)&#xA;    For Each r As System.Data.DataRow In dtProcessedGl.Rows&#xA;        Dim ref As String = If(IsDBNull(r(&quot;TRN_REF_NO&quot;)), &quot;&quot;, r(&quot;TRN_REF_NO&quot;).ToString().Trim())&#xA;        If ref = &quot;&quot; OrElse glCodeShape.IsMatch(ref) Then Continue For&#xA;        Dim a As Decimal = amt(r(col))&#xA;        If a &gt; 0 Then&#xA;            Dim k As String = ref &amp; &quot;|&quot; &amp; a.ToString(&quot;F2&quot;, ci)&#xA;            If Not positives.ContainsKey(k) Then positives.Add(k, New Queue(Of System.Data.DataRow))&#xA;            positives(k).Enqueue(r)&#xA;        ElseIf a &lt; 0 Then&#xA;            negatives.Add(r)&#xA;        End If&#xA;    Next&#xA;    For Each r As System.Data.DataRow In negatives&#xA;        If pairedRows.Contains(r) Then Continue For&#xA;        Dim k As String = r(&quot;TRN_REF_NO&quot;).ToString().Trim() &amp; &quot;|&quot; &amp; (-amt(r(col))).ToString(&quot;F2&quot;, ci)&#xA;        If Not positives.ContainsKey(k) Then Continue For&#xA;        While positives(k).Count &gt; 0&#xA;            Dim original As System.Data.DataRow = positives(k).Dequeue()&#xA;            If pairedRows.Contains(original) Then Continue While&#xA;            pairedRows.Add(original)&#xA;            pairedRows.Add(r)&#xA;            partnerOf.Add(original, r)&#xA;            Exit While&#xA;        End While&#xA;    Next&#xA;Next&#xA;&#xA;' Original first, its reversal directly below, in GL order.&#xA;dtReversalsGl = dtProcessedGl.Clone()&#xA;For Each r As System.Data.DataRow In dtProcessedGl.Rows&#xA;    If Not partnerOf.ContainsKey(r) Then Continue For&#xA;    dtReversalsGl.ImportRow(r)&#xA;    dtReversalsGl.ImportRow(partnerOf(r))&#xA;Next&#xA;&#xA;Dim kept As System.Data.DataTable = dtProcessedGl.Clone()&#xA;For Each r As System.Data.DataRow In dtProcessedGl.Rows&#xA;    If Not pairedRows.Contains(r) Then kept.ImportRow(r)&#xA;Next&#xA;Console.WriteLine(&quot;GL PREP | reference + auto-reversals | references taken from narration=&quot; &amp; refFixed.ToString() &amp; &quot; | reversal legs removed=&quot; &amp; pairedRows.Count.ToString() &amp; &quot; | rows left=&quot; &amp; kept.Rows.Count.ToString())&#xA;dtProcessedGl = kept&#xA;" DisplayName="Pair Auto-Reversals By Reference (1:1)" sap:VirtualizedContainerService.HintSize="502.6666666666667,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_14">
      <ui:InvokeCode.Arguments>
        <InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtProcessedGl">[dtProcessedGl]</InOutArgument>
        <OutArgument x:TypeArguments="sd:DataTable" x:Key="dtReversalsGl">[dtReversalsGl]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:InvokeCode ContinueOnError="{x:Null}" Code="If dtProcessedGl IsNot Nothing AndAlso dtProcessedGl.Rows.Count &gt; 0 Then&#xA;    Dim ci = System.Globalization.CultureInfo.InvariantCulture&#xA;    Dim names As String() = {&quot;debit&quot;,&quot;credit&quot;,&quot;amount&quot;,&quot;balance&quot;,&quot;lcy_amount&quot;,&quot;fcy_amount&quot;,&quot;dr&quot;,&quot;cr&quot;}&#xA;    Dim targets As New List(Of Integer)&#xA;&#xA;    For i As Integer = 0 To dtProcessedGl.Columns.Count - 1&#xA;        Dim col As System.Data.DataColumn = dtProcessedGl.Columns(i)&#xA;        If col.DataType Is GetType(Double) OrElse col.DataType Is GetType(Decimal) Then Continue For&#xA;        Dim nm As String = col.ColumnName.Trim().ToLowerInvariant()&#xA;        Dim looksLikeMoney As Boolean = False&#xA;        For Each n As String In names&#xA;            If nm = n OrElse nm.EndsWith(&quot;_&quot; &amp; n) OrElse nm.EndsWith(&quot; &quot; &amp; n) Then looksLikeMoney = True&#xA;        Next&#xA;        If Not looksLikeMoney Then Continue For&#xA;&#xA;        Dim allParse As Boolean = True&#xA;        For Each r As System.Data.DataRow In dtProcessedGl.Rows&#xA;            Dim v As Object = r(i)&#xA;            If v Is Nothing OrElse IsDBNull(v) Then Continue For&#xA;            Dim s As String = v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;)&#xA;            If s = &quot;&quot; Then Continue For&#xA;            If s.StartsWith(&quot;(&quot;) AndAlso s.EndsWith(&quot;)&quot;) Then s = &quot;-&quot; &amp; s.Substring(1, s.Length - 2)&#xA;            Dim d As Double&#xA;            If Not Double.TryParse(s, System.Globalization.NumberStyles.Any, ci, d) Then&#xA;                allParse = False&#xA;                Exit For&#xA;            End If&#xA;        Next&#xA;        If allParse Then targets.Add(i)&#xA;    Next&#xA;&#xA;    If targets.Count &gt; 0 Then&#xA;        Dim outT As New System.Data.DataTable()&#xA;        For i As Integer = 0 To dtProcessedGl.Columns.Count - 1&#xA;            If targets.Contains(i) Then&#xA;                outT.Columns.Add(dtProcessedGl.Columns(i).ColumnName, GetType(Double))&#xA;            Else&#xA;                outT.Columns.Add(dtProcessedGl.Columns(i).ColumnName, dtProcessedGl.Columns(i).DataType)&#xA;            End If&#xA;        Next&#xA;        For Each r As System.Data.DataRow In dtProcessedGl.Rows&#xA;            Dim nr As System.Data.DataRow = outT.NewRow()&#xA;            For i As Integer = 0 To dtProcessedGl.Columns.Count - 1&#xA;                Dim v As Object = r(i)&#xA;                If targets.Contains(i) Then&#xA;                    Dim d As Double = 0&#xA;                    If v IsNot Nothing AndAlso Not IsDBNull(v) Then&#xA;                        Dim s As String = v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;)&#xA;                        If s.StartsWith(&quot;(&quot;) AndAlso s.EndsWith(&quot;)&quot;) Then s = &quot;-&quot; &amp; s.Substring(1, s.Length - 2)&#xA;                        If s &lt;&gt; &quot;&quot; Then Double.TryParse(s, System.Globalization.NumberStyles.Any, ci, d)&#xA;                    End If&#xA;                    nr(i) = d&#xA;                Else&#xA;                    nr(i) = v&#xA;                End If&#xA;            Next&#xA;            outT.Rows.Add(nr)&#xA;        Next&#xA;        dtProcessedGl = outT&#xA;    End If&#xA;End If" DisplayName="Numeric amounts - dtProcessedGl" sap:VirtualizedContainerService.HintSize="502.6666666666667,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_200">
      <ui:InvokeCode.Arguments>
        <InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtProcessedGl">[dtProcessedGl]</InOutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' --- VISA POS USD: drop FX revaluation noise ----------------------------&#xA;' &quot;Realized FX Revaluation Profit and Loss -&quot; postings are accrual entries&#xA;' carrying no debit or credit. They reconcile nothing, but they sit in the&#xA;' outstanding list forever and inflate the row count (37 of them in the USD&#xA;' baseline). Strip them from both the current GL and the carried-forward&#xA;' exceptions so they never enter matching or the report.&#xA;Const FX_MARKER As String = &quot;Realized FX Revaluation Profit and Loss -&quot;&#xA;fxDropped = 0&#xA;&#xA;Dim tables As New List(Of System.Data.DataTable)&#xA;If dtProcessedGl IsNot Nothing Then tables.Add(dtProcessedGl)&#xA;If dtPreviousRealExceptions IsNot Nothing Then tables.Add(dtPreviousRealExceptions)&#xA;&#xA;If reconResultsPath.IndexOf(&quot;VISA POS Clearing - USD&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0 Then&#xA;&#xA;&#x9;For Each tbl As System.Data.DataTable In tables&#xA;&#xA;&#x9;&#x9;Dim narrCol As String = &quot;&quot;&#xA;&#x9;&#x9;For Each c As System.Data.DataColumn In tbl.Columns&#xA;&#x9;&#x9;&#x9;If c.ColumnName.Trim().ToUpperInvariant() = &quot;NARRATION&quot; Then narrCol = c.ColumnName&#xA;&#x9;&#x9;Next&#xA;&#x9;&#x9;If narrCol = &quot;&quot; Then Continue For&#xA;&#xA;&#x9;&#x9;Dim doomed As New List(Of System.Data.DataRow)&#xA;&#x9;&#x9;For Each r As System.Data.DataRow In tbl.Rows&#xA;&#x9;&#x9;&#x9;If Not IsDBNull(r(narrCol)) Then&#xA;&#x9;&#x9;&#x9;&#x9;If r(narrCol).ToString().IndexOf(FX_MARKER, StringComparison.OrdinalIgnoreCase) &gt;= 0 Then&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;doomed.Add(r)&#xA;&#x9;&#x9;&#x9;&#x9;End If&#xA;&#x9;&#x9;&#x9;End If&#xA;&#x9;&#x9;Next&#xA;&#xA;&#x9;&#x9;For Each r As System.Data.DataRow In doomed&#xA;&#x9;&#x9;&#x9;tbl.Rows.Remove(r)&#xA;&#x9;&#x9;Next&#xA;&#x9;&#x9;fxDropped = fxDropped + doomed.Count&#xA;&#xA;&#x9;Next&#xA;&#xA;End If&#xA;&#xA;fxDroppedMsg = &quot;GL PREP | FX revaluation filter | process=&quot; &amp; If(reconResultsPath.IndexOf(&quot;VISA POS Clearing - USD&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0, &quot;VISA POS USD (applied)&quot;, &quot;not USD (skipped)&quot;) &amp; &quot; | rows removed=&quot; &amp; fxDropped.ToString()" DisplayName="Drop FX Revaluation Rows (USD)" sap:VirtualizedContainerService.HintSize="502.6666666666667,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_902">

      <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Retain previous-report &quot;Current Exceptions&quot; that are older than 0-3 Days.&#xA;' The &quot;Additional logic to check age grouping&quot; filter below keeps only 0-3 Day&#xA;' rows in dtProcessedHistorical_CurrentGl for re-matching, while the filter&#xA;' above has already removed every Current Exception from dtPreviousRealExceptions.&#xA;' Without this step aged Current Exceptions belong to neither table, drop out of&#xA;' the report entirely and leave the reconciliation short by their value.&#xA;If dtHistorical IsNot Nothing AndAlso dtHistorical.Rows.Count &gt; 0 Then&#xA;&#xA;&#x9;If Not dtHistorical.Columns.Contains(&quot;Root Cause&quot;) OrElse Not dtHistorical.Columns.Contains(&quot;Aging Group&quot;) Then&#xA;&#x9;&#x9;Throw New Exception(&quot;Retain aged Current Exceptions: previous report is missing the 'Root Cause' or 'Aging Group' column.&quot;)&#xA;&#x9;End If&#xA;&#xA;&#x9;Dim variants As String() = {&quot;current exception&quot;, &quot;current exeption&quot;, &quot;curent exeption&quot;}&#xA;&#xA;&#x9;Dim aged = dtHistorical.AsEnumerable().Where(Function(r) _&#xA;&#x9;&#x9;Not String.IsNullOrWhiteSpace(r(&quot;Booking Date&quot;).ToString()) AndAlso _&#xA;&#x9;&#x9;Not String.IsNullOrWhiteSpace(r(&quot;Root Cause&quot;).ToString()) AndAlso _&#xA;&#x9;&#x9;variants.Any(Function(v) r(&quot;Root Cause&quot;).ToString().Trim().ToLowerInvariant().Contains(v)) AndAlso _&#xA;&#x9;&#x9;r(&quot;Aging Group&quot;).ToString().Trim() &lt;&gt; &quot;0-3 Days&quot;).ToList()&#xA;&#xA;&#x9;If aged.Count &gt; 0 Then&#xA;&#x9;&#x9;dtPrevious.Merge(aged.CopyToDataTable())&#xA;&#x9;End If&#xA;&#xA;End If" DisplayName="Retain aged Current Exceptions" sap:VirtualizedContainerService.HintSize="452,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_310">

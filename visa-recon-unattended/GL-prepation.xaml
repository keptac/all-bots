          <OutArgument x:TypeArguments="sd:DataTable" x:Key="dtMatchedPairs">[dtMatchedPairs]</OutArgument>
          <OutArgument x:TypeArguments="x:Int32" x:Key="pairCount">[matchedPairCount]</OutArgument>

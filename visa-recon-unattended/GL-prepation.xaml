      <ui:InvokeCode ContinueOnError="{x:Null}" Code="' --- Settlement &lt;-&gt; journal-posting pairing (1:1) ------------------------&#xA;' A settlement leg may relieve AT MOST ONE journal posting of the same&#xA;' amount, and vice versa. The previous logic asked only &quot;does a counterpart&#xA;' of this amount exist?&quot;, so a single credit of e.g. 64,000 flagged every&#xA;' 64,000 debit as matched and the recon went short by the surplus.&#xA;' Greedy first-come pairing on (credit|debit), carrying row indices.&#xA;matchedSettlementIdx = New HashSet(Of Int32)()&#xA;matchedJournalIdx = New HashSet(Of Int32)()&#xA;pairMsg = &quot;PAIRING | no settlement or journal-posting rows | pairs=0&quot;&#xA;&#xA;If dtSettlements IsNot Nothing AndAlso dtJournalPostings IsNot Nothing Then&#xA;&#xA;    Dim ci As System.Globalization.CultureInfo = System.Globalization.CultureInfo.InvariantCulture&#xA;    Dim ns As System.Globalization.NumberStyles = System.Globalization.NumberStyles.Number&#xA;&#xA;    ' One queue of settlement row indices per (CREDIT|DEBIT) amount pair.&#xA;    ' The queue length is the number of journal postings that amount can relieve.&#xA;    Dim capacity As New Dictionary(Of String, Queue(Of Int32))&#xA;&#xA;    For i As Int32 = 0 To dtSettlements.Rows.Count - 1&#xA;        Dim sCr As Decimal = 0&#xA;        Dim sDr As Decimal = 0&#xA;        Decimal.TryParse(dtSettlements.Rows(i)(&quot;CREDIT&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;), ns, ci, sCr)&#xA;        Decimal.TryParse(dtSettlements.Rows(i)(&quot;DEBIT&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;), ns, ci, sDr)&#xA;        Dim k As String = Math.Round(sCr, 2).ToString(&quot;F2&quot;, ci) &amp; &quot;|&quot; &amp; Math.Round(sDr, 2).ToString(&quot;F2&quot;, ci)&#xA;        If Not capacity.ContainsKey(k) Then capacity.Add(k, New Queue(Of Int32))&#xA;        capacity(k).Enqueue(i)&#xA;    Next&#xA;&#xA;    For j As Int32 = 0 To dtJournalPostings.Rows.Count - 1&#xA;        Dim jDr As Decimal = 0&#xA;        Dim jCr As Decimal = 0&#xA;        Decimal.TryParse(dtJournalPostings.Rows(j)(&quot;Debit&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;), ns, ci, jDr)&#xA;        Decimal.TryParse(dtJournalPostings.Rows(j)(&quot;Credit&quot;).ToString().Replace(&quot;,&quot;, &quot;&quot;), ns, ci, jCr)&#xA;        Dim k As String = Math.Round(jDr, 2).ToString(&quot;F2&quot;, ci) &amp; &quot;|&quot; &amp; Math.Round(jCr, 2).ToString(&quot;F2&quot;, ci)&#xA;        If capacity.ContainsKey(k) AndAlso capacity(k).Count &gt; 0 Then&#xA;            matchedSettlementIdx.Add(capacity(k).Dequeue())&#xA;            matchedJournalIdx.Add(j)&#xA;        End If&#xA;    Next&#xA;&#xA;    pairMsg = &quot;PAIRING | settlements=&quot; &amp; dtSettlements.Rows.Count.ToString() &amp;&#xA;              &quot; | journals=&quot; &amp; dtJournalPostings.Rows.Count.ToString() &amp;&#xA;              &quot; | pairs=&quot; &amp; matchedJournalIdx.Count.ToString() &amp;&#xA;              &quot; | settlements still pending=&quot; &amp; (dtSettlements.Rows.Count - matchedSettlementIdx.Count).ToString() &amp;&#xA;              &quot; | journals still pending=&quot; &amp; (dtJournalPostings.Rows.Count - matchedJournalIdx.Count).ToString()&#xA;&#xA;End If" DisplayName="Pair Settlements To Journal Postings (1:1)" sap:VirtualizedContainerService.HintSize="468.6666666666667,188" sap2010:WorkflowViewState.IdRef="InvokeCode_902">

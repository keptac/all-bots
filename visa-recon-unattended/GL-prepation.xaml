    <ui:InvokeCode ContinueOnError="{x:Null}" Code="// in:  dtProcessedHistorical_CurrentGl (DataTable), dtProcessedGl (DataTable)&#xA;// out: dtResult (DataTable)&#xA;&#xA;var dtResult = dtProcessedHistorical_CurrentGl.Copy();   // copy target schema AND its existing rows (carried-forward current exceptions)&#xA;&#xA;// Unattended-Entry can widen the GL query span to roll in skipped days. When it does,&#xA;// entries the previous report is already carrying forward come back from the GL as&#xA;// well, and appending them unconditionally writes every one of them twice - which is&#xA;// what left 10 Sep 2026 out by 275,111,500. Key the carried-forward rows on narration&#xA;// plus amount and skip a GL row that is already accounted for. Counting makes it a&#xA;// multiset, so an entry that genuinely repeats on the same day still survives.&#xA;Func&lt;DataRow, string&gt; dupKey = r =&gt;&#xA;{&#xA;    var t = r.Table;&#xA;    string n = t.Columns.Contains(&quot;NARRATION&quot;) &amp;&amp; r[&quot;NARRATION&quot;] != DBNull.Value ? r[&quot;NARRATION&quot;].ToString().Trim() : &quot;&quot;;&#xA;    if (n.Length == 0) return &quot;&quot;;&#xA;    string dr = &quot;0&quot;;&#xA;    string cr = &quot;0&quot;;&#xA;    decimal amt;&#xA;    if (t.Columns.Contains(&quot;DEBIT&quot;) &amp;&amp; r[&quot;DEBIT&quot;] != DBNull.Value &amp;&amp; decimal.TryParse(r[&quot;DEBIT&quot;].ToString().Replace(&quot;,&quot;, &quot;&quot;), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out amt))&#xA;        dr = amt.ToString(&quot;F2&quot;, System.Globalization.CultureInfo.InvariantCulture);&#xA;    if (t.Columns.Contains(&quot;CREDIT&quot;) &amp;&amp; r[&quot;CREDIT&quot;] != DBNull.Value &amp;&amp; decimal.TryParse(r[&quot;CREDIT&quot;].ToString().Replace(&quot;,&quot;, &quot;&quot;), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out amt))&#xA;        cr = amt.ToString(&quot;F2&quot;, System.Globalization.CultureInfo.InvariantCulture);&#xA;    return n + &quot;|&quot; + dr + &quot;|&quot; + cr;&#xA;};&#xA;&#xA;var carriedForward = new System.Collections.Generic.Dictionary&lt;string, int&gt;();&#xA;foreach (DataRow prev in dtResult.Rows)&#xA;{&#xA;    string pk = dupKey(prev);&#xA;    if (pk.Length == 0) continue;&#xA;    carriedForward[pk] = carriedForward.ContainsKey(pk) ? carriedForward[pk] + 1 : 1;&#xA;}&#xA;int carriedCount = dtResult.Rows.Count;&#xA;int skippedAsDuplicate = 0;&#xA;&#xA;foreach (DataRow src in dtProcessedGl.Rows)&#xA;{&#xA;    string sk = dupKey(src);&#xA;    int seen;&#xA;    if (sk.Length &gt; 0 &amp;&amp; carriedForward.TryGetValue(sk, out seen) &amp;&amp; seen &gt; 0)&#xA;    {&#xA;        carriedForward[sk] = seen - 1;&#xA;        skippedAsDuplicate++;&#xA;        continue;&#xA;    }&#xA;&#xA;    var newRow = dtResult.NewRow();&#xA;&#xA;    foreach (DataColumn tCol in dtResult.Columns)&#xA;    {&#xA;        if (!dtProcessedGl.Columns.Contains(tCol.ColumnName))&#xA;            continue;&#xA;&#xA;        var val = src[tCol.ColumnName];&#xA;        if (val == null || val == DBNull.Value)&#xA;        {&#xA;            newRow[tCol.ColumnName] = DBNull.Value;&#xA;            continue;&#xA;        }&#xA;&#xA;        // Already the right type? assign directly&#xA;        if (val.GetType() == tCol.DataType)&#xA;        {&#xA;            newRow[tCol.ColumnName] = val;&#xA;        }&#xA;        else if (tCol.DataType == typeof(DateTime))&#xA;        {&#xA;            newRow[tCol.ColumnName] =&#xA;                DateTime.TryParse(val.ToString().Trim(), out var d) ? (Object)d : DBNull.Value;&#xA;        }&#xA;        else if (tCol.DataType == typeof(String))&#xA;        {&#xA;            newRow[tCol.ColumnName] = val.ToString();&#xA;        }&#xA;        else&#xA;        {&#xA;            try   { newRow[tCol.ColumnName] = Convert.ChangeType(val, tCol.DataType); }&#xA;            catch { newRow[tCol.ColumnName] = DBNull.Value; }&#xA;        }&#xA;    }&#xA;&#xA;    dtResult.Rows.Add(newRow);&#xA;}&#xA;Console.WriteLine(&quot;GL merge | carriedForward=&quot; + carriedCount + &quot; glRows=&quot; + dtProcessedGl.Rows.Count + &quot; skippedAsDuplicate=&quot; + skippedAsDuplicate + &quot; total=&quot; + dtResult.Rows.Count);&#xA;dtProcessedHistorical_CurrentGl = dtResult;" DisplayName="Invoke Code - Merge" sap:VirtualizedContainerService.HintSize="502.6666666666667,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_23" Language="CSharp">

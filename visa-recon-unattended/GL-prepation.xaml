;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;    cardnumber = subParts[0];&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;stan = subParts[1];&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;termId = subParts[3];&#xA;&#x9;                }&#xA;&#x9;&#x9;&#x9;&#x9;}&#xA;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;}else{&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var parts = transactionType.Split(&quot;--&quot;);&#xA;&#x9;                if (parts.Length &gt; 1)&#xA;&#x9;                   rrn = parts[1].Substring(0, Math.Min(parts[1].Length, 6));&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;   cardnumber = parts[0];&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;}&#xA;&#x9;&#x9;&#x9;}&#xA;&#x9;&#x9;&#x9;else if (transactionType.Contains(&quot;payableoncommandfees&quot;))&#xA;&#x9;&#x9;&#x9;{&#xA;&#x9;&#x9;&#x9;&#x9;var parts = transactionType.Split(&quot;--&quot;);&#xA;&#x9;&#x9;&#x9;&#x9;if (parts.Length &gt; 1)&#xA;&#x9;&#x9;&#x9;&#x9;{&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var subParts = parts[1].Split(&quot;-&quot;);&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;if (subParts.Length &gt; 2)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;rrn = subParts[2];&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;cardnumber = subParts[0];&#xA;&#x9;&#x9;&#x9;&#x9;}&#xA;&#x9;&#x9;&#x9;}&#xA;        }&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;if(String.IsNullOrEmpty(cardnumber.Replace(&quot; &quot;,&quot;&quot;))){&#xA;&#x9;&#x9;&#x9;cardnumber = &quot;NA00000&quot; + counter.ToString();&#xA;&#x9;&#x9;}&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;if(String.IsNullOrEmpty(rrn.Replace(&quot; &quot;,&quot;&quot;))){&#xA;&#x9;&#x9;&#x9;rrn = &quot;NA00000&quot; + counter.ToString();&#xA;&#x9;&#x9;}&#xA;&#xA;        // Return the result with extracted fields&#xA;        return new { Row = cRow, RRN = rrn, PAN = cardnumber, STAN = stan, TERM_ID = termId, PAYER_REF = payerRef };&#xA;    })&#xA;    .ToList();&#xA;&#xA;// Assign the processed data back to the DataTable columns&#xA;foreach (var result in processedData)&#xA;{&#xA;    result.Row.SetField(&quot;RRN&quot;, result.RRN);&#xA;&#x9;result.Row.SetField(&quot;PAN&quot;, result.PAN);&
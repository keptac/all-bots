      <ui:InvokeCode ContinueOnError="{x:Null}" Code="' --- Arrange matched settlements and journal postings as pairs ------------&#xA;' Each settlement is written directly above the journal posting it relieved&#xA;' so the sheet reads pair by pair. The key is the same (credit|debit) amount&#xA;' key the 1:1 pairing step used, and per key both tables hold the same number&#xA;' of rows, so every row finds its partner. Anything left over follows the&#xA;' pairs, unpaired. Columns are copied by position, as the old&#xA;' WriteRange + AppendRange did.&#xA;Dim ci As System.Globalization.CultureInfo = System.Globalization.CultureInfo.InvariantCulture&#xA;Dim ns As System.Globalization.NumberStyles = System.Globalization.NumberStyles.Any&#xA;Dim amt As Func(Of Object, String) = Function(v As Object)&#xA;    Dim d As Decimal = 0&#xA;    If v IsNot Nothing AndAlso Not IsDBNull(v) Then Decimal.TryParse(v.ToString().Trim().Replace(&quot;,&quot;, &quot;&quot;), ns, ci, d)&#xA;    Return Math.Round(d, 2).ToString(&quot;F2&quot;, ci)&#xA;End Function&#xA;&#xA;Dim s As System.Data.DataTable = If(dtMatchedSettlements, New System.Data.DataTable())&#xA;Dim j As System.Data.DataTable = If(dtMatchedJournalPostings, New System.Data.DataTable())&#xA;&#xA;Dim outT As New System.Data.DataTable()&#xA;Dim width As Integer = Math.Max(s.Columns.Count, j.Columns.Count)&#xA;For c As Integer = 0 To width - 1&#xA;    Dim nm As String = If(c &lt; s.Columns.Count, s.Columns(c).ColumnName, j.Columns(c).ColumnName)&#xA;    Dim u As String = nm&#xA;    Dim n As Integer = 1&#xA;    While outT.Columns.Contains(u)&#xA;        n = n + 1&#xA;        u = nm &amp; &quot;_&quot; &amp; n.ToString()&#xA;    End While&#xA;    outT.Columns.Add(u, GetType(Object))&#xA;Next&#xA;&#xA;Dim addRow As Action(Of System.Data.DataRow) = Sub(src As System.Data.DataRow)&#xA;    Dim nr As System.Data.DataRow = outT.NewRow()&#xA;    For c As Integer = 0 To src.Table.Columns.Count - 1&#xA;        nr(c) = src(c)&#xA;    Next&#xA;    outT.Rows.Add(nr)&#xA;End Sub&#xA;&#xA;Dim canPair As Boolean = s.Columns.Contains(&quot;CREDIT&quot;) AndAlso s.Columns.Contains(&quot;DEBIT&quot;) AndAlso j.Columns.Contains(&quot;Debit&quot;) AndAlso j.Columns.Contains(&quot;Credit&quot;)&#xA;Dim queues As New Dictionary(Of String, Queue(Of System.Data.DataRow))&#xA;If canPair Then&#xA;    For Each r As System.Data.DataRow In j.Rows&#xA;        Dim k As String = amt(r(&quot;Debit&quot;)) &amp; &quot;|&quot; &amp; amt(r(&quot;Credit&quot;))&#xA;        If Not queues.ContainsKey(k) Then queues.Add(k, New Queue(Of System.Data.DataRow))&#xA;        queues(k).Enqueue(r)&#xA;    Next&#xA;End If&#xA;&#xA;pairCount = 0&#xA;Dim used As New HashSet(Of System.Data.DataRow)&#xA;Dim leftovers As New List(Of System.Data.DataRow)&#xA;For Each r As System.Data.DataRow In s.Rows&#xA;    Dim k As String = &quot;&quot;&#xA;    If canPair Then k = amt(r(&quot;CREDIT&quot;)) &amp; &quot;|&quot; &amp; amt(r(&quot;DEBIT&quot;))&#xA;    If canPair AndAlso queues.ContainsKey(k) AndAlso queues(k).Count &gt; 0 Then&#xA;        Dim partner As System.Data.DataRow = queues(k).Dequeue()&#xA;        addRow(r)&#xA;        addRow(partner)&#xA;        used.Add(partner)&#xA;        pairCount = pairCount + 1&#xA;    Else&#xA;        leftovers.Add(r)&#xA;    End If&#xA;Next&#xA;For Each r As System.Data.DataRow In leftovers&#xA;    addRow(r)&#xA;Next&#xA;For Each r As System.Data.DataRow In j.Rows&#xA;    If Not used.Contains(r) Then addRow(r)&#xA;Next&#xA;&#xA;dtMatchedPairs = outT" DisplayName="Arrange matched rows as pairs" sap2010:WorkflowViewState.IdRef="InvokeCode_PairsGl">

A;&#x9;            Continue For&#xA;&#x9;        End If&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;Dim settlementCurrency As String = &quot;&quot;&#xA;&#x9;&#x9;&#x9;  ' Extract the Settlement Currency from the line containing &quot;(USD)&quot; or similar&#xA;&#x9;&#x9;&#x9; Dim settlementCurrencyIndex As Integer = transactionBatch.Replace(&quot; &quot;,&quot;&quot;).IndexOf(&quot;AMOUNT(&quot;)&#xA;&#x9;&#x9;&#x9;  If settlementCurrencyIndex &lt;&gt; -1 Then&#xA;&#x9;&#x9;&#x9;       settlementCurrency = transactionBatch.Replace(&quot; &quot;,&quot;&quot;).Substring(settlementCurrencyIndex + 1, 3).Trim()&#xA;&#x9;&#x9;&#x9;  End If&#xA;&#x9;&#x9;&#x9;  &#xA;&#x9;&#x9;&#x9;  settlementCurrency = System.Text.RegularExpressions.Regex.Match(transactionBatch, &quot;\b(USD|TZS)\b&quot;).Value&#xA;&#x9;&#x9;&#x9;  &#xA;&#x9;&#x9;&#x9;  &#xA;&#x9;&#x9;&#x9;  Dim lines As String() = transactionBatch.Split(New String() { vbCrLf }, StringSplitOptions.RemoveEmptyEntries)&#xA;&#x9;&#x9;&#x9;  &#x9;&#x9;&#x9;Dim batchNumber As String = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Dim transactionDate As String = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Dim transactionTime As String = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Dim pan As String = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Dim rrn As String = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Dim trace As String = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Dim issuerID As String = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Dim transactionType As String = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Dim processingCode As String = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Dim entryMode As String = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Dim responseCode As String = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Dim transactionAmount As String = &quot;0.00&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Dim currency As String = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Dim debitSettlement As String = &quot;0.00&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Dim creditSettlement As String = &quot;0.00&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Dim terminalID As String = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Dim branchName As String = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Dim settlementAmount As String = &quot;0.00&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'Console.WriteLine(transactionBatch)&#xA;&#x9;&#x9;&#x9;  &#xA;&#x9;&#x9;&#x9;      ' Loop through each line to extract data&#xA;&#x9;&#x9;&#x9;    For Each line In lines&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;line = line.Trim()&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Dim lineSplits As String() = line.Split(New String() { &quot; &quot; }, StringSplitOptions.RemoveEmptyEntries)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;        ' If in the transaction section, process the transaction lines&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;        If lineSplits.Count &gt; 10 AndAlso IsNumeric(lineSplits(0)) Then&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            ' Adjust these indices and lengths based on your actual data format&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            batchNumber = lineSplits(0)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            transactionDate = lineSplits(1)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            transactionTime = lineSplits(2)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            pan = lineSplits(3)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            ' Mask PAN when the statement supplies it unmasked: first 6 + ****** + last 4&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            Dim rawPan As String = pan.Trim()&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            If rawPan.Length &gt;= 10 AndAlso System.Text.RegularExpressions.Regex.IsMatch(rawPan, &quot;^\d+$&quot;) Then&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;                pan = rawPan.Substring(0, 6) &amp; &quot;******&quot; &amp; rawPan.Substring(rawPan.Length - 4)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            End If&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            rrn = lineSplits(4)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            trace = lineSplits(5)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            issuerID = lineSplits(6)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            transactionType = lineSplits(7)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;    processingCode = lineSplits(8)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            entryMode = lineSplits(9)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;responseCode = lineSplits(11)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            transactionAmount = lineSplits(12)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            currency =lineSplits(13)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; settlementAmount  = lineSplits(14)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;If  lineSplits.Count&gt;15 Then&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;responseCode = lineSplits(12)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;            transactionAmount = lineSplits(13)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;            currency = lineSplits(14)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; settlementAmount  = lineSplits(15)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;End If&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            If settlementAmount.Contains(&quot;CR&quot;) Then&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;                creditSettlement = settlementAmount.Replace(&quot;CR&quot;, &quot;&quot;).Trim()&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;                debitSettlement = &quot;0.00&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            ElseIf settlementAmount.Contains(&quot;DR&quot;) Then&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;                debitSettlement = settlementAmount.Replace(&quot;DR&quot;, &quot;&quot;).Trim()&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;                creditSettlement = &quot;0.00&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;            End If&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;End If&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;' Extract Terminal ID from 'CA ID:' line&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;        If line.Contains(&quot;CA ID:&quot;) Then&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;            terminalID = lineSplits(2)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;branchName = lineSplits(4).Replace(&quot;25/&quot;,&quot;&quot;).Replace(&quot;45/&quot;,&quot;&quot;)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;' Add extracted data to DataTable&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;        If Not String.IsNullOrEmpty(batchNumber) Then&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;            dt.Rows.Add(batchNumber, transactionDate, transactionTime, pan, rrn, trace, issuerID, transactionType, processingCode, entryMode, responseCode, transactionAmount, currency, settlementCurrency, debitSettlement, creditSettlement, terminalID, branchName)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;    batchNumber = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;transactionDate  = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;transactionTime  = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;pan  = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;rrn  = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;trace  = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;issuerID  = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;transactionType  = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;processingCode  = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;entryMode  = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;responseCode  = &quot;&quot;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;
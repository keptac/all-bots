        <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Create HashSets to store references with corresponding debit and credit amounts&#xA;Dim debitAmounts As New HashSet(Of String)()&#xA;Dim creditAmounts As New HashSet(Of String)()&#xA; &#xA;' Process the DataTable to populate HashSets&#xA;For Each row As DataRow In dtProcessedReportStatementTemp.Rows&#xA;    Dim reference = row.Field(Of String)(&quot;RRN&quot;)&#xA;    Dim debitAmount = Convert.ToDouble(row(&quot;Debit Settlement&quot;).ToString.Replace(&quot;,&quot;,&quot;&quot;).Replace(&quot;.00&quot;,&quot;&quot;))&#xA;    Dim creditAmount = Convert.ToDouble(row(&quot;Credit Settlement&quot;).ToString.Replace(&quot;,&quot;,&quot;&quot;).Replace(&quot;.00&quot;,&quot;&quot;))&#xA;    If debitAmount &gt; 0 Then&#xA;        debitAmounts.Add($&quot;{reference}|{debitAmount}&quot;)&#xA;    End If&#xA; &#xA;    If creditAmount &gt; 0 Then&#xA;        creditAmounts.Add($&quot;{reference}|{creditAmount}&quot;)&#xA;    End If&#xA;Next&#xA; &#xA;' Filter out rows where debit and credit amounts are matched&#xA;Dim filteredRows = dtProcessedReportStatementTemp.AsEnumerable().Where(Function(row)&#xA;    Dim reference = row.Field(Of String)(&quot;RRN&quot;)&#xA;    Dim debitAmount = Convert.ToDouble(row(&quot;Debit Settlement&quot;).ToString.Replace(&quot;,&quot;,&quot;&quot;).Replace(&quot;.00&quot;,&quot;&quot;))&#xA;    Dim creditAmount = Convert.ToDouble(row(&quot;Credit Settlement&quot;).ToString.Replace(&quot;,&quot;,&quot;&quot;).Replace(&quot;.00&quot;,&quot;&quot;))&#xA;    ' Check if a corresponding opposite transaction exists&#xA;    If debitAmount &gt; 0 Then&#xA;        Return Not creditAmounts.Contains($&quot;{reference}|{debitAmount}&quot;)&#xA;    ElseIf creditAmount &gt; 0 Then&#xA;        Return Not debitAmounts.Contains($&quot;{reference}|{creditAmount}&quot;)&#xA;    End If&#xA;    Return True&#xA;End Function).CopyToDataTable()&#xA; &#xA;' Assign the filtered DataTable to a variable&#xA;dtProcessedR
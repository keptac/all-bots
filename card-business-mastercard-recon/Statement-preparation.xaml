le(Math.Round(Convert.ToDecimal((Convert.ToDecimal(amountInDollars.ToString)).ToString),2).ToString).ToString                    &#xA;                End If&#xA;            End If&#xA;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;If field.Item1 = &quot;DESCRIPTION2&quot; Then&#xA;&#x9;&#x9;&#x9;&#x9;fieldValue = &quot;MAESTRO&quot;&#xA;&#x9;&#x9;&#x9;End If&#xA;&#x9;&#x9;&#x9;&#xA;            dataRow(field.Item1) = fieldValue&#xA;        Else&#xA;&#x9;&#x9;&#x9;Dim fieldValue = &quot;&quot;&#xA;&#x9;&#xA;&#x9;&#x9;&#x9;If field.Item1 = &quot;DESCRIPTION2&quot; Then&#xA;&#x9;&#x9;&#x9;&#x9;fieldValue = &quot;MAESTRO&quot;&#xA;&#x9;&#x9;&#x9;End If&#xA;&#x9;&#x9;&#x9;&#xA;            dataRow(field.Item1) = fieldValue ' Empty value if field exceeds the line length&#xA;        End If&#xA;    Next&#xA;&#xA;    ' Add the DataRow to the DataTable&#xA;    dataTable.Rows.Add(dataRow)&#xA;Next&#xA;&#xA;&#xA;If currencyCode = &quot;840&quot;  Then&#xA;&#x9;dataTable.AsEnumerable.where(Function(r) r(&quot;Product Code&quot;).ToString.Contains(&quot;1&quot;) ).ToList.ForEach(Sub(row) row(&quot;Billing Amount&quot;) =      Convert.ToDouble(row(&quot;Settlement Amount&quot;).ToString) )&#xA;Else&#xA;&#x9;dataTable.AsEnumerable.where(Function(r) r(&quot;Product Code&quot;).ToString.Contains(&quot;1&quot;) ).ToList.ForEach(Sub(row) row(&quot;Billing Amount&quot;) = Convert.ToDouble(Math.Round(Convert.ToDecimal((Convert.ToDecimal(row(&quot;Billing Amount&quot;).ToString)).ToString),2).ToString).ToString    )&#xA;End If&#xA;&#xA;&#xA;dtT464Statement = dataTable&#xA;" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="449.6,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_8">

, 166, 1),&#xA;    Tuple.Create(&quot;Conversion Rate-Settlement&quot;, 167, 8),&#xA;    Tuple.Create(&quot;Settlement Amount&quot;, 175, 12),&#xA;    Tuple.Create(&quot;Billing Amount Indicator&quot;, 187, 1),&#xA;    Tuple.Create(&quot;Interchange Fee&quot;, 188, 10),&#xA;    Tuple.Create(&quot;Interchange Fee Indicator&quot;, 198, 1),&#xA;    Tuple.Create(&quot;Filler&quot;, 199, 15),&#xA;    Tuple.Create(&quot;Positive ID Indicator&quot;, 214, 1),&#xA;    Tuple.Create(&quot;Filler2&quot;, 215, 1),&#xA;    Tuple.Create(&quot;Cross Border Indicator&quot;, 216, 1),&#xA;    Tuple.Create(&quot;Cross Border Currency Indicator&quot;, 217, 1),&#xA;    Tuple.Create(&quot;VISA ISA Fee Indicator&quot;, 218, 1),&#xA;    Tuple.Create(&quot;DESCRIPTION2&quot;, 219, 31)&#xA;}&#xA;&#xA;Dim inputString As String = t464Statement&#xA;Dim lines As String() = inputString.Split(New String() {Environment.NewLine}, StringSplitOptions.RemoveEmptyEntries)&#xA;Dim parsedRecords As New List(Of Dictionary(Of String, String))&#xA;&#xA;' Create a new DataTable&#xA;Dim dataTable As New DataTable()&#xA;&#xA;' Add columns to DataTable based on field definitions&#xA;For Each field In fieldDefinitions&#xA;    dataTable.Columns.Add(field.Item1, GetType(String))&#xA;Next&#xA;&#xA;' Parse the lines and fill DataTable&#xA;For Each line As String In lines&#xA;    Dim parsedRecord As New Dictionary(Of String, String)&#xA;    Dim dataRow As DataRow = dataTable.NewRow()&#xA;&#x9;Dim cardLength As Int32 = 16&#xA;    &#xA;    For Each field In fieldDefinitions&#xA;        If field.Item2 + field.Item3 &lt;= line.Length Then&#xA;&#x9;&#x9;&#x9;&#xA;            Dim fieldValue  = line.Substring(field.Item2, field.Item3).Trim()&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;Try&#xA;&#x9;&#x9;&#x9;&#x9;If field.Item1 = &quot;PAN Length&quot; Then&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;cardLength = Convert.ToInt32(fieldValue)&#xA;&#x9;&#x9;&#x9;&#x9;End If&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;Catch ex As Exception&#xA;&#x9;&#x9;&